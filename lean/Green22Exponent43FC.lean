    have h2 : (p₂ : ℝ) ≤ 2 * D.P₂' := by
      have : (p₂ : ℝ) ≤ 2 * ((∏ ℓ, a₂ ℓ : ℕ) : ℝ) := by
        exact_mod_cast (good5_mem D hG₂ p₂ hp₂).2
      linarith
    push_cast
    exact c2_real hτ0 (Nat.cast_nonneg _) (Nat.cast_nonneg _) hx0 h1 h2 (Nat.cast_nonneg _)
      (Nat.cast_nonneg _) hT₁x hT₂x hτP hKL
  have hbox12 : (τ / 2) ^ 4 ≤ box12 (restr ψ X) X
      ((almostPrimes a₁ b₁).image fun s : ℕ => (s : ℤ))
      ((almostPrimes a₂ b₂).image fun s : ℕ => (s : ℤ)) (Tpar τ X (∏ ℓ, a₁ ℓ))
      (Tpar τ X (∏ ℓ, a₂ ℓ)) :=
    h5c f₁ (restr ψ X) hf₁ (restr_abs hψ X) _ _ (good5_ne D hG₁) (good5_ne D hG₂) ρ hρ D.lam X
      u L _ _ hX1' hL1 hT₁1 hT₂1 τ hτ0 hc1 hc2 (by rwa [lhs14_restr])
  /- Step 2: Lemma 2.6* with `δ = σ = (τ/2)⁴`, `H₁ = H₂ = H`. -/
  obtain ⟨hl1pos, hl1a, hl1b⟩ := lev1 hτ0 hτ
  obtain ⟨hl2pos, hl2a, hl2b⟩ := lev2 hτ0
  have hH : 1 ≤ τ ^ 64 * X := (Y_facts hP2R hY₁1 hY₁P hbig).2.2
  have hH1 : 1 ≤ Hpar τ X := (floor_facts hH).1
  have hHu : (Hpar τ X : ℝ) ≤ τ ^ 64 * X := (floor_facts hH).2.1
  have hHl : τ ^ 64 * X / 2 ≤ (Hpar τ X : ℝ) := (floor_facts hH).2.2
  have hbox20 : (((τ / 2) ^ 4) ^ 3 / 3200) ^ 3 / 800 ≤
      box20 (restr ψ X) X (Hpar τ X) (Hpar τ X) :=
    L26.lemma26_one (restr_abs hψ X) ((good5_ne D hG₁).image (fun s : ℕ => (s : ℤ)))
      ((good5_ne D hG₂).image (fun s : ℕ => (s : ℤ))) hX1' hH1 hH1 (good5_SD D hG₁)
      (good5_SD D hG₂) (pow_pos (half_pos hτ0) 4)
      (hF₁ _ hl1pos hl1a hl1b) (hF₂ _ hl2pos hl2a hl2b)
      (num_TDX1 hτ0 hτ hx0 hT₁u)
      (num_HW hτ0 hτ hx0 hHu (one_div_nonneg.mpr (Real.sqrt_nonneg _))
        (W_le hτ0 hl1pos hl1b) hT₁l)
      (num_HQ1 hτ0 hτ hx0 hHu hT₁l)
      (num_TDX2 hτ0 hτ hx0 hT₂u)
      (num_HW hτ0 hτ hx0 hHu (one_div_nonneg.mpr (Real.sqrt_nonneg _))
        (W_le hτ0 hl2pos hl2b) hT₂l)
