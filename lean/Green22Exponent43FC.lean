  /- Step 1: P5c for `ψ̃ = restr ψ X`. -/
  have hL1 := one_le_L D hN hL
  have hKL := key_L D hN hX1 hX2 hL
  have hc1 : ∀ p₁ ∈ almostPrimes a₁ b₁, ∀ p₂ ∈ almostPrimes a₂ b₂,
