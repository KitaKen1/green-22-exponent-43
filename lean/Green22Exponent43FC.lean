  P51.prop51_of_leaves P51.stepProdAvg P51.stepBoxes (fun _ => P51.stepP0a) P51.stepP0b
    P51.stepP1 P51.stepP2 P51.stepP3 P51.stepP5a P51.stepP5b P51.stepP5c P51.stepP5d
    P51.stepP6a P51.stepP6b P51.stepP6c P51.stepP6d P51.stepP6e P51.stepP6f P51.stepP6g
