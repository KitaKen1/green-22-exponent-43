import FormalConjectures.GreensOpenProblems.«22»
import Mathlib

/-!
# Green's Problem 22: an improved bound for monochromatic `{x + y, xy}`

This file proves the `research open` theorem `Green22.green_22` of Formal Conjectures with the
answer `r ↦ ⌈exp (exp (r ^ 43))⌉`: for all large `r`, every `r`-colouring of `{1, …, N}` with
`N = ⌈exp (exp (r ^ 43))⌉` contains `x, y ≥ 3` with `x + y` and `xy` of the same colour, and
`⌈exp (exp (r ^ 43))⌉ = o(exp (exp (r ^ 50)))` (the Green–Sawhney bound).  The definitions
`HasMonochromaticSumProduct`, `N₀` and `GreenSawhneyBound` are the ones imported from Formal
Conjectures.

The development lives in the namespace `G22`.  It consists of the modules of the original
multi-file development, concatenated in dependency order (each in its own `section`):

* `Basic` … `Main`: the colour-summed argument, reducing the statement to GS Proposition 5.1
  (GS = B. Green and M. Sawhney, arXiv:2511.09365v2);
* `ElementaryAux` … `Reduced`: GS Lemmas A.2, A.5, 6.4, (6.4) and Mertens' theorem;
* `FPD` … `BT`: tools for GS Proposition 5.1 (Lemma 2.4*, 2.6*, the FPD toolkit, GS Lemma 4.1,
  Brun–Titchmarsh in progressions);
* `Prop51Steps` … `P51P7G6`: GS Proposition 5.1, cut into 22 steps.
-/

/- ## Section: `Basic` -/

section

/-
# Averages used in the Green 22 argument

Everything is real-valued and finitary:

* `wavg s w f` : weighted average of `f` over the finset `s` with weights `w`;
* `logAvg N f` : logarithmic average `E^log_{n ∈ [N]} f(n)` of `f : ℤ → ℝ`;
* `lavg S f`   : logarithmic average over a finite set `S` of positive integers;
* `uavg H f`   : uniform average over `h ∈ [1, H]`;
* `iterAvg`    : iterated logarithmic averages over several finite sets (GS's
  shorthand `E^log_{p₁ ∈ S₁, …, p_k ∈ S_k}` for `E^log_{p₁ ∈ S₁} ⋯ E^log_{p_k ∈ S_k}`);
* `proj q H f` : GS Definition 6.1, `Π_{q,H} f(n) = E_{h,h' ∈ [H]} f(n + q(h - h'))`;
* `U1logSq N q H f` : GS Definition 2.3, `‖f‖²_{U¹_log[N;q,H]}`.
-/

open Finset

namespace G22

/- ### Weighted averages over finite sets -/

section wavg
variable {α : Type*}

/-- Weighted average of `f` over `s` with weights `w`. -/
noncomputable def wavg (s : Finset α) (w : α → ℝ) (f : α → ℝ) : ℝ :=
  (∑ x ∈ s, w x * f x) / ∑ x ∈ s, w x

/-- Standing hypothesis for weighted averages: positive weights, nonempty support. -/
structure GoodWeights (s : Finset α) (w : α → ℝ) : Prop where
  pos : ∀ x ∈ s, 0 < w x
  ne : s.Nonempty

variable {s : Finset α} {w : α → ℝ}

lemma GoodWeights.sum_pos (h : GoodWeights s w) : 0 < ∑ x ∈ s, w x :=
  Finset.sum_pos h.pos h.ne

lemma wavg_congr {f g : α → ℝ} (hfg : ∀ x ∈ s, f x = g x) : wavg s w f = wavg s w g := by
  unfold wavg
  congr 1
  exact Finset.sum_congr rfl fun x hx => by rw [hfg x hx]

lemma wavg_add (f g : α → ℝ) :
    wavg s w (fun x => f x + g x) = wavg s w f + wavg s w g := by
  simp only [wavg, mul_add, Finset.sum_add_distrib, add_div]

lemma wavg_sub (f g : α → ℝ) :
    wavg s w (fun x => f x - g x) = wavg s w f - wavg s w g := by
  simp only [wavg, mul_sub, Finset.sum_sub_distrib, sub_div]

lemma wavg_smul (c : ℝ) (f : α → ℝ) : wavg s w (fun x => c * f x) = c * wavg s w f := by
  simp only [wavg, mul_left_comm _ c, ← Finset.mul_sum, mul_div_assoc]

lemma wavg_neg (f : α → ℝ) : wavg s w (fun x => -f x) = -wavg s w f := by
  have := wavg_smul (s := s) (w := w) (-1) f
  simpa using this

lemma wavg_sum {ι : Type*} (t : Finset ι) (f : ι → α → ℝ) :
    wavg s w (fun x => ∑ i ∈ t, f i x) = ∑ i ∈ t, wavg s w (f i) := by
  simp only [wavg, Finset.mul_sum, ← Finset.sum_div]
  rw [Finset.sum_comm]

lemma wavg_const (h : GoodWeights s w) (c : ℝ) : wavg s w (fun _ => c) = c := by
  have := h.sum_pos
  simp only [wavg, ← Finset.sum_mul]
  field_simp

lemma wavg_mono (h : GoodWeights s w) {f g : α → ℝ} (hfg : ∀ x ∈ s, f x ≤ g x) :
    wavg s w f ≤ wavg s w g := by
  unfold wavg
  apply div_le_div_of_nonneg_right _ h.sum_pos.le
  exact Finset.sum_le_sum fun x hx => mul_le_mul_of_nonneg_left (hfg x hx) (h.pos x hx).le

lemma wavg_nonneg (h : GoodWeights s w) {f : α → ℝ} (hf : ∀ x ∈ s, 0 ≤ f x) :
    0 ≤ wavg s w f := by
  simpa [wavg_const h] using wavg_mono h (f := fun _ => 0) hf

lemma wavg_le_of_le (h : GoodWeights s w) {f : α → ℝ} {c : ℝ} (hf : ∀ x ∈ s, f x ≤ c) :
    wavg s w f ≤ c := by
  simpa [wavg_const h] using wavg_mono h (g := fun _ => c) hf

lemma le_wavg_of_le (h : GoodWeights s w) {f : α → ℝ} {c : ℝ} (hf : ∀ x ∈ s, c ≤ f x) :
    c ≤ wavg s w f := by
  simpa [wavg_const h] using wavg_mono h (f := fun _ => c) hf

lemma abs_wavg_le (h : GoodWeights s w) (f : α → ℝ) :
    |wavg s w f| ≤ wavg s w (fun x => |f x|) := by
  rw [abs_le]
  refine ⟨?_, wavg_mono h fun x _ => le_abs_self _⟩
  have h1 := wavg_mono h (f := fun x => -|f x|) (g := f) (fun x _ => neg_abs_le _)
  rw [wavg_neg] at h1
  linarith

lemma abs_wavg_le_of_abs_le (h : GoodWeights s w) {f : α → ℝ} {c : ℝ}
    (hf : ∀ x ∈ s, |f x| ≤ c) : |wavg s w f| ≤ c :=
  (abs_wavg_le h f).trans (wavg_le_of_le h hf)

/-- Cauchy–Schwarz for weighted averages. -/
lemma wavg_mul_sq_le (h : GoodWeights s w) (f g : α → ℝ) :
    (wavg s w (fun x => f x * g x)) ^ 2 ≤
      wavg s w (fun x => f x ^ 2) * wavg s w (fun x => g x ^ 2) := by
  have hS := h.sum_pos
  have key : (∑ x ∈ s, w x * (f x * g x)) ^ 2 ≤
      (∑ x ∈ s, w x * f x ^ 2) * (∑ x ∈ s, w x * g x ^ 2) := by
    have := Finset.sum_mul_sq_le_sq_mul_sq s (fun x => Real.sqrt (w x) * f x)
      (fun x => Real.sqrt (w x) * g x)
    have hw : ∀ x ∈ s, Real.sqrt (w x) ^ 2 = w x := fun x hx =>
      Real.sq_sqrt (h.pos x hx).le
    calc (∑ x ∈ s, w x * (f x * g x)) ^ 2
        = (∑ x ∈ s, Real.sqrt (w x) * f x * (Real.sqrt (w x) * g x)) ^ 2 := by
          congr 1
          refine Finset.sum_congr rfl fun x hx => ?_
          calc w x * (f x * g x) = Real.sqrt (w x) ^ 2 * (f x * g x) := by rw [hw x hx]
            _ = Real.sqrt (w x) * f x * (Real.sqrt (w x) * g x) := by ring
      _ ≤ (∑ x ∈ s, (Real.sqrt (w x) * f x) ^ 2) * ∑ x ∈ s, (Real.sqrt (w x) * g x) ^ 2 :=
          this
      _ = (∑ x ∈ s, w x * f x ^ 2) * (∑ x ∈ s, w x * g x ^ 2) := by
          congr 1 <;> refine Finset.sum_congr rfl fun x hx => ?_ <;> rw [mul_pow, hw x hx]
  unfold wavg
  rw [div_pow, div_mul_div_comm, ← sq]
  exact div_le_div_of_nonneg_right key (sq_nonneg _)

/-- `|E[fg]| ≤ √(E f²) √(E g²)`. -/
lemma abs_wavg_mul_le (h : GoodWeights s w) (f g : α → ℝ) :
    |wavg s w (fun x => f x * g x)| ≤
      Real.sqrt (wavg s w (fun x => f x ^ 2)) * Real.sqrt (wavg s w (fun x => g x ^ 2)) := by
  rw [← Real.sqrt_mul (wavg_nonneg h fun x _ => sq_nonneg (f x)), ← Real.sqrt_sq_eq_abs]
  exact Real.sqrt_le_sqrt (wavg_mul_sq_le h f g)

end wavg

/- ### Logarithmic and uniform averages -/

/-- Logarithmic average `E^log_{n ∈ [N]} f(n)` of a function on `ℤ`. -/
noncomputable def logAvg (N : ℕ) (f : ℤ → ℝ) : ℝ :=
  wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun n => f n)

/-- Logarithmic average over a finite set `S` of positive integers. -/
noncomputable def lavg (S : Finset ℕ) (f : ℕ → ℝ) : ℝ :=
  wavg S (fun p => 1 / (p : ℝ)) f

/-- Uniform average over `h ∈ [1, H]`. -/
noncomputable def uavg (H : ℕ) (f : ℕ → ℝ) : ℝ :=
  wavg (Icc 1 H) (fun _ => 1) f

lemma goodWeights_logAvg {N : ℕ} (hN : 1 ≤ N) :
    GoodWeights (Icc 1 N) (fun n : ℕ => 1 / (n : ℝ)) where
  pos n hn := by
    have : (1 : ℝ) ≤ n := by exact_mod_cast (Finset.mem_Icc.mp hn).1
    positivity
  ne := ⟨1, Finset.mem_Icc.mpr ⟨le_rfl, hN⟩⟩

lemma goodWeights_lavg {S : Finset ℕ} (hS : S.Nonempty) (h0 : ∀ p ∈ S, 0 < p) :
    GoodWeights S (fun p : ℕ => 1 / (p : ℝ)) where
  pos p hp := by
    have : (0 : ℝ) < p := by exact_mod_cast h0 p hp
    positivity
  ne := hS

lemma goodWeights_uavg {H : ℕ} (hH : 1 ≤ H) : GoodWeights (Icc 1 H) (fun _ : ℕ => (1 : ℝ)) where
  pos _ _ := one_pos
  ne := ⟨1, Finset.mem_Icc.mpr ⟨le_rfl, hH⟩⟩

/- ### Iterated logarithmic averages over tuples of primes -/

/-- Iterated logarithmic average `E^log_{p₀ ∈ S 0} E^log_{p₁ ∈ S 1} ⋯` of a function of the tuple. -/
noncomputable def iterAvg : (k : ℕ) → (Fin k → Finset ℕ) → ((Fin k → ℕ) → ℝ) → ℝ
  | 0, _, F => F Fin.elim0
  | k + 1, S, F => lavg (S 0) (fun p => iterAvg k (fun i => S i.succ) (fun q => F (Fin.cons p q)))

/-- Admissible data for iterated averages: every set nonempty and made of positive integers. -/
def GoodSets {k : ℕ} (S : Fin k → Finset ℕ) : Prop :=
  ∀ i, (S i).Nonempty ∧ ∀ p ∈ S i, 0 < p

lemma GoodSets.tail {k : ℕ} {S : Fin (k + 1) → Finset ℕ} (h : GoodSets S) :
    GoodSets (fun i : Fin k => S i.succ) := fun i => h i.succ

lemma iterAvg_mono {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S) {F G : (Fin k → ℕ) → ℝ}
    (hFG : ∀ p, F p ≤ G p) : iterAvg k S F ≤ iterAvg k S G := by
  induction k with
  | zero => exact hFG _
  | succ k ih =>
    exact wavg_mono (goodWeights_lavg (hS 0).1 (hS 0).2) fun p _ =>
      ih hS.tail fun q => hFG _

lemma iterAvg_const {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S) (c : ℝ) :
    iterAvg k S (fun _ => c) = c := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterAvg]
    rw [show (fun p => iterAvg k (fun i => S i.succ) (fun _ => c)) = fun _ => c from
      funext fun _ => ih hS.tail]
    exact wavg_const (goodWeights_lavg (hS 0).1 (hS 0).2) c

lemma iterAvg_add {k : ℕ} (S : Fin k → Finset ℕ) (F G : (Fin k → ℕ) → ℝ) :
    iterAvg k S (fun p => F p + G p) = iterAvg k S F + iterAvg k S G := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterAvg, lavg]
    rw [← wavg_add]
    exact wavg_congr fun p _ => ih _ _ _

lemma iterAvg_smul {k : ℕ} (S : Fin k → Finset ℕ) (c : ℝ) (F : (Fin k → ℕ) → ℝ) :
    iterAvg k S (fun p => c * F p) = c * iterAvg k S F := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterAvg, lavg]
    rw [← wavg_smul]
    exact wavg_congr fun p _ => ih _ _

lemma iterAvg_sub {k : ℕ} (S : Fin k → Finset ℕ) (F G : (Fin k → ℕ) → ℝ) :
    iterAvg k S (fun p => F p - G p) = iterAvg k S F - iterAvg k S G := by
  have h1 := iterAvg_add S F (fun p => -G p)
  have h2 := iterAvg_smul S (-1) G
  simp only [neg_one_mul] at h2
  simp only [← sub_eq_add_neg] at h1
  rw [h1, h2]; ring

lemma iterAvg_zero {k : ℕ} (S : Fin k → Finset ℕ) : iterAvg k S (fun _ => 0) = 0 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterAvg, lavg]
    rw [show (fun p => iterAvg k (fun i => S i.succ) (fun _ => (0 : ℝ))) = fun _ => 0 from
      funext fun _ => ih _]
    simp [wavg]

lemma iterAvg_sum {k : ℕ} (S : Fin k → Finset ℕ) {ι : Type*} (t : Finset ι)
    (F : ι → (Fin k → ℕ) → ℝ) :
    iterAvg k S (fun p => ∑ i ∈ t, F i p) = ∑ i ∈ t, iterAvg k S (F i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simpa using iterAvg_zero S
  | insert a t ha ih =>
    simp only [Finset.sum_insert ha]
    rw [iterAvg_add, ih]

lemma abs_iterAvg_le {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S) (F : (Fin k → ℕ) → ℝ) :
    |iterAvg k S F| ≤ iterAvg k S (fun p => |F p|) := by
  rw [abs_le]
  refine ⟨?_, iterAvg_mono hS fun p => le_abs_self _⟩
  have h1 := iterAvg_mono hS (F := fun p => -|F p|) (G := F) (fun p => neg_abs_le _)
  have h2 := iterAvg_smul S (-1) (fun p => |F p|)
  simp only [neg_one_mul] at h2
  linarith

lemma abs_iterAvg_le_of_abs_le {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S)
    {F : (Fin k → ℕ) → ℝ} {c : ℝ} (hF : ∀ p, |F p| ≤ c) : |iterAvg k S F| ≤ c :=
  (abs_iterAvg_le hS F).trans ((iterAvg_mono hS hF).trans_eq (iterAvg_const hS c))

/- ### The projections `Π_{q,H}` and the norms `U¹_log` -/

/-- GS Definition 6.1: `Π_{q,H} f (n) = E_{h,h' ∈ [H]} f(n + q(h - h'))`. -/
noncomputable def proj (q H : ℕ) (f : ℤ → ℝ) (n : ℤ) : ℝ :=
  uavg H (fun h => uavg H (fun h' => f (n + q * ((h : ℤ) - h'))))

/-- GS Definition 2.3 (real-valued): `‖f‖²_{U¹_log[N;q,H]} = E^log_{n∈[N]} (E_{h∈[H]} f(n+hq))²`. -/
noncomputable def U1logSq (N q H : ℕ) (f : ℤ → ℝ) : ℝ :=
  logAvg N (fun n => (uavg H (fun h => f (n + q * h))) ^ 2)

/-- The `L²` "norm" squared used in GS Lemma 6.4: `‖g‖² = E^log_{n∈[N]} g(n)²`. -/
noncomputable def normSq (N : ℕ) (g : ℤ → ℝ) : ℝ := logAvg N (fun n => g n ^ 2)

/-- Primes in the half-open interval `[A, B)`. -/
def primesIn (A B : ℕ) : Finset ℕ := (Ico A B).filter Nat.Prime

end G22

end

/- ## Section: `Interface` -/

section

/-
# The Green–Sawhney inputs, stated as hypotheses

B. Green and M. Sawhney, *Bounds for monochromatic solutions to {x+y, xy}*,
arXiv:2511.09365v2 (19 Nov 2025), cited below as **GS**.

This file is the trust boundary of the conditional development. Every `Prop` below is a
statement that follows from a result of GS, specialised in harmless ways:

* functions are real-valued rather than complex-valued (a special case);
* "`≪`" and "`≫ δ^{O(1)}`" are written with explicit existential constants;
* conditions of the form `x ≤ exp((log N)^{1/4})` are written without real powers,
  e.g. `(log x)^4 ≤ log N` (equivalent for `x ≥ 1`);
* the width condition `kδ^{-4.1}` of Proposition 5.1 is *strengthened* to `kδ^{-5}`
  (for `δ ≤ 1` this is a stronger hypothesis, so the resulting statement is weaker);
* Proposition 5.1 additionally assumes `P₂ ≥ 4P₁` (again a stronger hypothesis); this lets the
  elementary proof use Chebyshev's bounds instead of the prime number theorem in step (5.4);
* the almost-prime average `E^log_{p' ∈ 𝒫'}` over `𝒫' = {p₁⋯p_k : p_ℓ ∈ I_ℓ}` is written as the
  iterated average over the factors, exactly as GS do in §7 ("every element of 𝒫' has just one
  representation in this product ... so `E^log_{p_{i,j'+1}, …, p_{i,j-1}}` is the same thing as
  `E^log_{p' ∈ 𝒫'}`"), and GS's iterated-average notation `E^log_{n₁ ∈ N₁, n₂ ∈ N₂}` is used
  throughout (GS §1.2).

Nothing here is proved; the point of the development is that *only* these statements
(and nothing else) are assumed.
-/

open Finset Real

namespace G22

/-- **GS Lemma A.1, (A.2).** Shifting a 1-bounded function changes its logarithmic average by
`O((1 + log|h|)/log N)`. -/
def LemmaA2With (C : ℝ) : Prop :=
  ∀ (N : ℕ), 2 ≤ N → ∀ (f : ℤ → ℝ), (∀ n, |f n| ≤ 1) →
    ∀ h : ℤ, h ≠ 0 →
      |logAvg N f - logAvg N (fun n => f (n + h))| ≤ C * (1 + Real.log |(h : ℝ)|) / Real.log N

/-- `LemmaA2With` for some constant. -/
def LemmaA2 : Prop := ∃ C : ℝ, 0 ≤ C ∧ LemmaA2With C

/-- **GS Lemma A.5** (logarithmic Elliott inequality). For a finite set of primes `𝒫 ⊆ [1, P]`,
`|E^log_{n∈[N]} f(n) - E^log_{n∈[N], p∈𝒫} f(pn)| ≪ log P / log N + (∑_{p∈𝒫} 1/p)^{-1/2}`. -/
def LemmaA5With (C : ℝ) : Prop :=
  ∀ (N P : ℕ), 2 ≤ N → 2 ≤ P → ∀ (S : Finset ℕ), S.Nonempty →
    (∀ p ∈ S, p.Prime ∧ p ≤ P) → ∀ (f : ℤ → ℝ), (∀ n, |f n| ≤ 1) →
      |logAvg N f - lavg S (fun p => logAvg N (fun n => f (p * n)))| ≤
        C * (Real.log P / Real.log N) + C / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p)

/-- `LemmaA5With` for some constant. -/
def LemmaA5 : Prop := ∃ C : ℝ, 0 ≤ C ∧ LemmaA5With C

/-- **GS Lemma 6.4** (approximate Pythagoras). If `q ∣ q'` (with `q' ≥ 1`: GS's parameters are
positive integers; without it the statement is false in Lean since `q' = 0` is allowed and
`log 0 = 0`, see `G22.Elem.not_lemma64With`) and `H' ≤ H` then
`‖Π_{q',H'}f - Π_{q,H}f‖² ≤ ‖Π_{q',H'}f‖² - ‖Π_{q,H}f‖² + O(log(q'H)/log N + q'H'/(qH))`. -/
def Lemma64With (C : ℝ) : Prop :=
  ∀ (N q q' H H' : ℕ), 2 ≤ N → 1 ≤ q → q ∣ q' → 1 ≤ q' → 1 ≤ H' → H' ≤ H →
    ∀ (f : ℤ → ℝ), (∀ n, |f n| ≤ 1) →
      normSq N (fun n => proj q' H' f n - proj q H f n) ≤
        normSq N (proj q' H' f) - normSq N (proj q H f) +
          C * (Real.log ((q' : ℝ) * H) / Real.log N + (q' : ℝ) * H' / ((q : ℝ) * H))

/-- `Lemma64With` for some constant. -/
def Lemma64 : Prop := ∃ C : ℝ, 0 ≤ C ∧ Lemma64With C

/-- **GS (6.4)**, the corollary of Lemma 6.5. For non-negative 1-bounded `f, g` and `η`, if
`log(Hq)/log N < c η²` (with the absolute `c` of Lemma 6.5) then
`E^log (Π_{q,H} f) g ≥ (η/8) E^log f g - η²/8`.
(GS state (6.4) "for any η"; we only use `0 < η ≤ 1/64`.) -/
def Cor64With (c : ℝ) : Prop :=
  ∀ (N q H : ℕ), 2 ≤ N → 1 ≤ q → 1 ≤ H → ∀ (η : ℝ), 0 < η → η ≤ 1 / 64 →
    Real.log ((H : ℝ) * q) / Real.log N < c * η ^ 2 →
    ∀ (f g : ℤ → ℝ), (∀ n, 0 ≤ f n ∧ f n ≤ 1) → (∀ n, 0 ≤ g n ∧ g n ≤ 1) →
      η / 8 * logAvg N (fun n => f n * g n) - η ^ 2 / 8 ≤
        logAvg N (fun n => proj q H f n * g n)

/-- `Cor64With` for some constant. -/
def Cor64 : Prop := ∃ c : ℝ, 0 < c ∧ Cor64With c

/-- **GS Proposition 5.1** (the inverse theorem), real-valued form.

GS: there is an absolute `C ∈ ℕ` such that for `δ` sufficiently small, `k ∈ ℕ`,
`max(k, 1/δ) ≤ log log N`, `k ≤ δ^{-10}`,
`exp exp((log log N)^{1/10}) ≤ P'₁ < P'₂ < P₁ < P₂ < exp((log N)^{1/4})`, `P₁ ≥ (P'₂)^{10}`,
`λ ≤ exp((log N)^{1/4})` with all prime factors `< P'₁`, `𝒫` = primes in `[P₁, P₂)`,
`𝒫' ⊂ [P'₁, P'₂)` the products `p₁⋯p_k` with `p_ℓ` prime in disjoint intervals
`I_ℓ ⊂ [P'₁, P'₂)` of log-log width `≥ kδ^{-4.1}`, `V = ⌊δ^{-C}⌋!`: if
`|E^log_{n∈[N], p∈𝒫, p'∈𝒫'} f₁(n + λpp') f₂(λnpp')| ≥ δ` then
`‖f₁‖_{U¹_log[N; λV, H]} ≫ δ^{O(1)}` for every `H ≤ P₁^{1/8}`.

Here the tuple `pp : Fin (k+1) → ℕ` lists `p₁, …, p_k` (coordinates `castSucc ℓ`) and then `p`
(coordinate `last k`); `pp ℓ` ranges over the primes in `[lo ℓ, hi ℓ)`, so
`P₁ = lo (last k)` and `P₂ = hi (last k)`. The product `∏ ℓ, pp ℓ` is `pp'`. -/
def Prop51With (C : ℕ) (c : ℝ) (C' : ℕ) (δ₀ : ℝ) (N₀ : ℕ) : Prop :=
  ∀ (δ : ℝ), 0 < δ → δ ≤ δ₀ →
  ∀ (N k : ℕ), N₀ ≤ N → 1 ≤ k →
    (k : ℝ) ≤ Real.log (Real.log N) → 1 / δ ≤ Real.log (Real.log N) → (k : ℝ) ≤ (1 / δ) ^ 10 →
  ∀ (P₁' P₂' : ℕ) (lo hi : Fin (k + 1) → ℕ),
    -- `exp exp((log log N)^{1/10}) ≤ P'₁`
    3 ≤ P₁' → Real.log (Real.log N) ≤ (Real.log (Real.log P₁')) ^ 10 →
    -- `P'₁ < P'₂ < P₁ < P₂ < exp((log N)^{1/4})` and `P₁ ≥ (P'₂)^{10}`
    P₁' < P₂' → P₂' < lo (Fin.last k) → lo (Fin.last k) < hi (Fin.last k) →
    -- `P₂ ≥ 4P₁` (added: lets (5.4) use Chebyshev bounds instead of the prime number theorem)
    4 * lo (Fin.last k) ≤ hi (Fin.last k) →
    (Real.log (hi (Fin.last k))) ^ 4 < Real.log N → P₂' ^ 10 ≤ lo (Fin.last k) →
    -- the intervals `I_ℓ = [lo ℓ, hi ℓ)` for `ℓ < k`: inside `[P'₁, P'₂)`, disjoint, wide,
    -- and with all products `p₁⋯p_k` in `[P'₁, P'₂)`
    (∀ ℓ : Fin k, P₁' ≤ lo ℓ.castSucc ∧ lo ℓ.castSucc < hi ℓ.castSucc ∧ hi ℓ.castSucc ≤ P₂') →
    (∀ ℓ ℓ' : Fin k, ℓ ≠ ℓ' → hi ℓ.castSucc ≤ lo ℓ'.castSucc ∨ hi ℓ'.castSucc ≤ lo ℓ.castSucc) →
    (∏ ℓ : Fin k, hi ℓ.castSucc) ≤ P₂' →
    (∀ ℓ : Fin k, Real.log (Real.log (lo ℓ.castSucc)) + k * (1 / δ) ^ 5 ≤
      Real.log (Real.log ((hi ℓ.castSucc : ℝ) - 1))) →
  ∀ (lam : ℕ), 1 ≤ lam → (Real.log lam) ^ 4 ≤ Real.log N →
    (∀ p : ℕ, p.Prime → p ∣ lam → p < P₁') →
  ∀ (f₁ f₂ : ℤ → ℝ), (∀ n, |f₁ n| ≤ 1) → (∀ n, |f₂ n| ≤ 1) →
    δ ≤ |iterAvg (k + 1) (fun ℓ => primesIn (lo ℓ) (hi ℓ))
          (fun pp => logAvg N (fun n =>
            f₁ (n + (lam : ℤ) * ∏ ℓ, (pp ℓ : ℤ)) * f₂ ((lam : ℤ) * n * ∏ ℓ, (pp ℓ : ℤ))))| →
    ∀ H : ℕ, 1 ≤ H → H ^ 8 ≤ lo (Fin.last k) →
      c * δ ^ C' ≤ Real.sqrt (U1logSq N (lam * (⌊(1 / δ) ^ C⌋₊).factorial) H f₁)

/-- Proposition 5.1 with its absolute constants. GS take `C = 2C₂`, so `C ≥ 1`
(GS's `ℕ` is the positive integers). -/
def Prop51 : Prop :=
  ∃ C : ℕ, 1 ≤ C ∧ ∃ c : ℝ, 0 < c ∧ ∃ C' : ℕ, ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ,
    Prop51With C c C' δ₀ N₀

/-- **Mertens' second theorem**, in the form used for the prime sets (GS use it via
[Koukoulopoulos, Thm 5.4]; the draft uses it in (6)). -/
def MertensLowerWith (C : ℝ) : Prop :=
  ∀ A B : ℕ, 3 ≤ A → A ≤ B →
    Real.log (Real.log B) - Real.log (Real.log A) - C ≤ ∑ p ∈ primesIn A B, (1 : ℝ) / p

/-- `MertensLowerWith` for some constant. -/
def MertensLower : Prop := ∃ C : ℝ, 0 ≤ C ∧ MertensLowerWith C

/-- All external inputs of the conditional proof. -/
structure GSInputs : Prop where
  prop51 : Prop51
  lemA2 : LemmaA2
  lemA5 : LemmaA5
  lem64 : Lemma64
  cor64 : Cor64
  mertens : MertensLower

end G22

end

/- ## Section: `Setup` -/

section

/-
# Parameters and the objects of the argument

We follow the exponent-31 draft (`round87_green22_exponent31_proof.md`), but — since the
Formal Conjectures statement only needs *some* exponent below `50` — every parameter is an
integer power of `r`, which removes all real powers from the bookkeeping:

| draft                        | here            |
|------------------------------|-----------------|
| `K = 2⁵⁰ r⁶`, `t = K`         | `K = t = r⁷`     |
| `d = ⌈r^{3.01}⌉`, `δ = 1/d`   | `d = r⁴`         |
| width `L = r^{18.5}`         | `L = r²⁸`        |
| `M = ⌈exp exp(r³¹)⌉`          | `M = ⌈exp exp(r⁴³)⌉` |

The constraints of the draft still hold with room: `L ≥ K d⁵ + 1` (width condition of
Prop 5.1 in the strengthened form `kδ^{-5}`), `K ≫ r⁶` (energy step),
`δ = o(r⁻³)` (inverse-theorem step), and `log log M ≈ r⁴³ ≫ 4KtL = 4r⁴²`.
-/

open Finset

namespace G22

/-- The parameters depend on the number of colours `r` and on the constant `C` of Prop 5.1. -/
structure Par where
  r : ℕ
  C : ℕ

namespace Par
variable (P : Par)

/-- Number of levels `K = r⁷`. -/
def K : ℕ := P.r ^ 7
/-- Number of rows `t = r⁷`. -/
def T : ℕ := P.r ^ 7
/-- `d = 1/δ = r⁴`. -/
def d : ℕ := P.r ^ 4
/-- `δ = r⁻⁴`. -/
noncomputable def δ : ℝ := 1 / (P.d : ℝ)
/-- `V = ⌊δ^{-C}⌋! = (d^C)!`. -/
def V : ℕ := (P.d ^ P.C).factorial
/-- `b_j = V^{4^j}`. -/
def b (j : ℕ) : ℕ := P.V ^ (4 ^ j)
/-- `λ_{a,j} = b_j / b_a² = V^{4^j - 2·4^a}`. -/
def lam (a j : ℕ) : ℕ := P.V ^ (4 ^ j - 2 * 4 ^ a)
/-- `q_{a,j} = λ_{a,j} V`. -/
def q (a j : ℕ) : ℕ := P.lam a j * P.V
/-- Log-log width of each prime interval, `L = r²⁸`. -/
def L : ℕ := P.r ^ 28
/-- Scales `H_{i,j} = ⌊exp exp(L(4Ki + j))⌋`. -/
noncomputable def H (i j : ℕ) : ℕ :=
  ⌊Real.exp (Real.exp ((P.L : ℝ) * (4 * P.K * i + j)))⌋₊
/-- `𝒫_{i,h}` = primes in `[H_{i,2h-1}, H_{i,2h})`. -/
noncomputable def Pr (i h : ℕ) : Finset ℕ := primesIn (P.H i (2 * h - 1)) (P.H i (2 * h))
/-- Window of prime sets for the pair `(a, j)`, `j = a + k + 1`, in row `i`:
levels `a+1, …, a+k+1` (the last one is the level `j` of the prime `p` of Prop 5.1). -/
noncomputable def win (i a k : ℕ) : Fin (k + 1) → Finset ℕ := fun ℓ => P.Pr i (a + 1 + ℓ)
/-- Admissible triples `(i, a, k)`: `1 ≤ i ≤ t - 1`, `1 ≤ a`, `1 ≤ k`, `a + k + 1 ≤ K`
(so `j = a + k + 1 ≥ a + 2`). -/
def triples : Finset (ℕ × ℕ × ℕ) :=
  ((Icc 1 (P.T - 1)) ×ˢ ((Icc 1 P.K) ×ˢ (Icc 1 P.K))).filter
    (fun x => x.2.1 + x.2.2 + 1 ≤ P.K)

end Par

/-- The size of the coloured interval: `M = ⌈exp exp(r⁴³)⌉`. This is the answer supplied to
Formal Conjectures. -/
noncomputable def Mval (r : ℕ) : ℕ := ⌈Real.exp (Real.exp ((r : ℝ) ^ 43))⌉₊

-- ### Colour classes as real-valued indicators on `ℤ`

section colouring
variable {N r : ℕ} (χ : Finset.Icc 1 N → Fin r)

lemma toNat_mem_Icc {m : ℤ} (h : 1 ≤ m ∧ m ≤ N) : m.toNat ∈ Finset.Icc 1 N := by
  rw [Finset.mem_Icc]; omega

/-- `1_{A_c}(m)`, extended by zero outside `[1, N]`. -/
noncomputable def ind (c : Fin r) (m : ℤ) : ℝ :=
  if h : 1 ≤ m ∧ m ≤ N then (if χ ⟨m.toNat, toNat_mem_Icc h⟩ = c then 1 else 0) else 0

lemma ind_nonneg (c : Fin r) (m : ℤ) : 0 ≤ ind χ c m := by
  unfold ind; split_ifs <;> norm_num

lemma ind_le_one (c : Fin r) (m : ℤ) : ind χ c m ≤ 1 := by
  unfold ind; split_ifs <;> norm_num

lemma abs_ind_le_one (c : Fin r) (m : ℤ) : |ind χ c m| ≤ 1 := by
  rw [abs_le]; exact ⟨by linarith [ind_nonneg χ c m], ind_le_one χ c m⟩

/-- The colour classes form a partition of `[1, N]`: `∑_c 1_{A_c}(m) = 1_{[1,N]}(m) ≤ 1`. -/
lemma sum_ind_le_one (m : ℤ) : ∑ c, ind χ c m ≤ 1 := by
  unfold ind
  split_ifs with h
  · rw [Finset.sum_ite_eq]; simp
  · simp

lemma ind_eq_zero_of_not_mem {m : ℤ} (h : ¬ (1 ≤ m ∧ m ≤ N)) (c : Fin r) : ind χ c m = 0 := by
  unfold ind; rw [dif_neg h]

end colouring

-- ### The functions and averages of the argument

section objects
variable (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r)

/-- `f_{a,c}(n) = 1_{A_c}(b_a n)`. -/
noncomputable def fa (a : ℕ) (c : Fin P.r) (n : ℤ) : ℝ := ind χ c (P.b a * n)

/-- `1_{A_c}(b_j T n)`, the "`xy`" factor. -/
noncomputable def gT (j : ℕ) (c : Fin P.r) (T n : ℤ) : ℝ := ind χ c (P.b j * T * n)

/-- Window expectation `E^log_{p_{a+1}, …, p_j} E^log_{n ∈ [M]} Φ(n, T)` with
`T = p_{a+1} ⋯ p_j`. -/
noncomputable def Wexp (i a k : ℕ) (Φ : ℤ → ℤ → ℝ) : ℝ :=
  iterAvg (k + 1) (P.win i a k) (fun pp => logAvg (Mval P.r) (fun n => Φ n (∏ ℓ, (pp ℓ : ℤ))))

/-- `∑_c E[φ_c(n + λT) · 1_{A_c}(b_j T n)]` for the triple `(i, a, k)` (with `j = a + k + 1`,
`λ = λ_{a,j}`). -/
noncomputable def corr (i a k : ℕ) (φ : Fin P.r → ℤ → ℝ) : ℝ :=
  ∑ c, Wexp P i a k
    (fun n T => φ c (n + (P.lam a (a + k + 1) : ℤ) * T) * gT P χ (a + k + 1) c T n)

/-- Small projection `P^s_{i,a,j} = Π_{q_{a,j-1}, H_{i+1,0}}` applied to `f_{a,c}`. -/
noncomputable def fS (i a k : ℕ) (c : Fin P.r) : ℤ → ℝ :=
  proj (P.q a (a + k)) (P.H (i + 1) 0) (fa P χ a c)

/-- Large projection `P^ℓ_{i,a,j} = Π_{q_{a,j}, H_{i,0}}` applied to `f_{a,c}`. -/
noncomputable def fL (i a k : ℕ) (c : Fin P.r) : ℤ → ℝ :=
  proj (P.q a (a + k + 1)) (P.H i 0) (fa P χ a c)

/-- The quantity that vanishes when there is no monochromatic pair (draft (26)). -/
noncomputable def Zsum : ℝ :=
  ∑ x ∈ P.triples, corr P χ x.1 x.2.1 x.2.2 (fun c => fa P χ x.2.1 c)

/-- With small projections (draft `𝒮`, (15)). -/
noncomputable def Ssml : ℝ :=
  ∑ x ∈ P.triples, corr P χ x.1 x.2.1 x.2.2 (fS P χ x.1 x.2.1 x.2.2)

/-- With large projections. -/
noncomputable def Slrg : ℝ :=
  ∑ x ∈ P.triples, corr P χ x.1 x.2.1 x.2.2 (fL P χ x.1 x.2.1 x.2.2)

end objects

end G22

end

/- ## Section: `C1` -/

section

/-
# Claim C1: without a monochromatic pair, `𝒵 = 0`

Every summand of `Zsum` has the form `1_{A_c}(b_a(n + λT)) · 1_{A_c}(b_j T n)` with `n ≥ 1`,
`T ≥ 0`. For `T = 0` the second factor is `1_{A_c}(0) = 0`. For `T ≥ 1` put `x = b_a n` and
`y = V^{4^j - 4^a} T`; then `x + y = b_a(n + λT)`, `xy = b_j T n`, and `x, y ≥ V ≥ 3`, so a nonzero
summand would be a monochromatic pair.
-/

open Finset

namespace G22.C1

open G22

variable (P : Par)

lemma V_ge_three (hC : 1 ≤ P.C) (hr : 2 ≤ P.r) : 3 ≤ P.V := by
  unfold Par.V Par.d
  have h1 : 16 ≤ P.r ^ 4 := by
    calc 16 = 2 ^ 4 := by norm_num
      _ ≤ P.r ^ 4 := Nat.pow_le_pow_left hr 4
  have h2 : P.r ^ 4 ≤ (P.r ^ 4) ^ P.C := by
    calc P.r ^ 4 = (P.r ^ 4) ^ 1 := (pow_one _).symm
      _ ≤ (P.r ^ 4) ^ P.C := Nat.pow_le_pow_right (by omega) hC
  have h3 : 3 ≤ (P.r ^ 4) ^ P.C := by omega
  calc 3 ≤ (P.r ^ 4) ^ P.C := h3
    _ ≤ ((P.r ^ 4) ^ P.C).factorial := Nat.self_le_factorial _

/-- `b_a · λ_{a,j} = V^{4^j - 4^a}` for `a < j`. -/
lemma b_mul_lam {a j : ℕ} (haj : a < j) :
    P.b a * P.lam a j = P.V ^ (4 ^ j - 4 ^ a) := by
  unfold Par.b Par.lam
  rw [← pow_add]
  congr 1
  have h : 4 * 4 ^ a ≤ 4 ^ j := by
    calc 4 * 4 ^ a = 4 ^ (a + 1) := by ring
      _ ≤ 4 ^ j := Nat.pow_le_pow_right (by norm_num) haj
  omega

/-- `b_a · V^{4^j - 4^a} = b_j` for `a < j`. -/
lemma b_mul_pow {a j : ℕ} (haj : a < j) : P.b a * P.V ^ (4 ^ j - 4 ^ a) = P.b j := by
  unfold Par.b
  rw [← pow_add]
  congr 1
  have : 4 ^ a ≤ 4 ^ j := Nat.pow_le_pow_right (by norm_num) haj.le
  omega

lemma V_pos (hC : 1 ≤ P.C) (hr : 2 ≤ P.r) : 0 < P.V := by
  have := V_ge_three P hC hr; omega

/-- The key pointwise vanishing. -/
lemma summand_eq_zero (hC : 1 ≤ P.C) (hr : 2 ≤ P.r)
    (χ : Finset.Icc 1 (Mval P.r) → Fin P.r)
    (hχ : ¬ Green22.HasMonochromaticSumProduct (Mval P.r) P.r χ)
    {a j : ℕ} (haj : a < j) (c : Fin P.r) {n T : ℤ} (hn : 1 ≤ n) (hT : 0 ≤ T) :
    fa P χ a c (n + (P.lam a j : ℤ) * T) * gT P χ j c T n = 0 := by
  rcases hT.eq_or_lt with hT0 | hT0
  · -- `T = 0`: the second factor is `1_{A_c}(0) = 0`.
    subst hT0
    have : gT P χ j c 0 n = 0 := by
      unfold gT
      apply ind_eq_zero_of_not_mem
      simp
    rw [this, mul_zero]
  · -- `T ≥ 1`
    have hV3 := V_ge_three P hC hr
    set x : ℕ := P.b a * n.toNat with hx
    set y : ℕ := P.V ^ (4 ^ j - 4 ^ a) * T.toNat with hy
    have hn' : (n.toNat : ℤ) = n := Int.toNat_of_nonneg (by omega)
    have hT' : (T.toNat : ℤ) = T := Int.toNat_of_nonneg hT
    have hbpos : 1 ≤ P.b a := by
      unfold Par.b; exact Nat.one_le_pow _ _ (V_pos P hC hr)
    have hexp : 1 ≤ 4 ^ j - 4 ^ a := by
      have : 4 * 4 ^ a ≤ 4 ^ j := by
        calc 4 * 4 ^ a = 4 ^ (a + 1) := by ring
          _ ≤ 4 ^ j := Nat.pow_le_pow_right (by norm_num) haj
      have : 1 ≤ 4 ^ a := Nat.one_le_pow _ _ (by norm_num)
      omega
    have hx3 : 3 ≤ x := by
      have h1 : 1 ≤ n.toNat := by omega
      have h2 : 3 ≤ P.b a := by
        unfold Par.b
        calc 3 ≤ P.V := hV3
          _ = P.V ^ 1 := (pow_one _).symm
          _ ≤ P.V ^ (4 ^ a) := Nat.pow_le_pow_right (by omega) (Nat.one_le_pow _ _ (by norm_num))
      calc 3 ≤ P.b a := h2
        _ = P.b a * 1 := (mul_one _).symm
        _ ≤ P.b a * n.toNat := Nat.mul_le_mul_left _ h1
    have hy3 : 3 ≤ y := by
      have h1 : 1 ≤ T.toNat := by omega
      have h2 : 3 ≤ P.V ^ (4 ^ j - 4 ^ a) :=
        calc 3 ≤ P.V := hV3
          _ = P.V ^ 1 := (pow_one _).symm
          _ ≤ P.V ^ (4 ^ j - 4 ^ a) := Nat.pow_le_pow_right (by omega) hexp
      calc 3 ≤ P.V ^ (4 ^ j - 4 ^ a) := h2
        _ = P.V ^ (4 ^ j - 4 ^ a) * 1 := (mul_one _).symm
        _ ≤ P.V ^ (4 ^ j - 4 ^ a) * T.toNat := Nat.mul_le_mul_left _ h1
    -- the arguments are `x + y` and `x * y`
    have hsum : (P.b a : ℤ) * (n + (P.lam a j : ℤ) * T) = ((x + y : ℕ) : ℤ) := by
      have hbl := b_mul_lam P haj
      push_cast [hx, hy, hn', hT']
      have : ((P.b a : ℕ) : ℤ) * (P.lam a j : ℤ) = ((P.V ^ (4 ^ j - 4 ^ a) : ℕ) : ℤ) := by
        rw [← Nat.cast_mul, hbl]
      push_cast at this
      linear_combination T * this
    have hprod : (P.b j : ℤ) * T * n = ((x * y : ℕ) : ℤ) := by
      have hbp := b_mul_pow P haj
      push_cast [hx, hy, hn', hT']
      have : ((P.b a : ℕ) : ℤ) * ((P.V ^ (4 ^ j - 4 ^ a) : ℕ) : ℤ) = ((P.b j : ℕ) : ℤ) := by
        rw [← Nat.cast_mul, hbp]
      push_cast at this
      linear_combination (-(T * n)) * this
    unfold fa gT
    rw [hsum, hprod]
    -- If both indicators are `1` we get a monochromatic pair.
    by_contra hne
    have h1 : ind χ c ((x + y : ℕ) : ℤ) ≠ 0 := left_ne_zero_of_mul hne
    have h2 : ind χ c ((x * y : ℕ) : ℤ) ≠ 0 := right_ne_zero_of_mul hne
    unfold ind at h1 h2
    split_ifs at h1 with hr1 hc1 <;> try exact h1 rfl
    split_ifs at h2 with hr2 hc2 <;> try exact h2 rfl
    apply hχ
    refine ⟨x, y, hx3, hy3, ?_, ?_, ?_⟩
    · rw [Finset.mem_Icc]; push_cast at hr1; omega
    · rw [Finset.mem_Icc]; push_cast at hr2; omega
    · have e1 : (((x + y : ℕ) : ℤ)).toNat = x + y := Int.toNat_natCast _
      have e2 : (((x * y : ℕ) : ℤ)).toNat = x * y := Int.toNat_natCast _
      simp only [e1, e2] at hc1 hc2
      rw [hc1, hc2]

/-- **C1.** If there is no monochromatic pair then `𝒵 = 0`. -/
theorem zsum_eq_zero' (hC : 1 ≤ P.C) (hr : 2 ≤ P.r)
    (χ : Finset.Icc 1 (Mval P.r) → Fin P.r)
    (hχ : ¬ Green22.HasMonochromaticSumProduct (Mval P.r) P.r χ) : Zsum P χ = 0 := by
  unfold Zsum
  apply Finset.sum_eq_zero
  intro x hx
  unfold corr
  apply Finset.sum_eq_zero
  intro c _
  unfold Wexp
  have hzero : ∀ pp : Fin (x.2.2 + 1) → ℕ,
      logAvg (Mval P.r) (fun n => fa P χ x.2.1 c (n + (P.lam x.2.1 (x.2.1 + x.2.2 + 1) : ℤ) *
        ∏ ℓ, (pp ℓ : ℤ)) * gT P χ (x.2.1 + x.2.2 + 1) c (∏ ℓ, (pp ℓ : ℤ)) n) = 0 := by
    intro pp
    unfold logAvg
    rw [wavg_congr (g := fun _ => 0)]
    · simp [wavg]
    intro n hn
    have hn1 : 1 ≤ (n : ℤ) := by exact_mod_cast (Finset.mem_Icc.mp hn).1
    exact summand_eq_zero P hC hr χ hχ (by omega) c hn1
      (Finset.prod_nonneg fun ℓ _ => by positivity)
  rw [show (fun pp : Fin (x.2.2 + 1) → ℕ => logAvg (Mval P.r) (fun n =>
      fa P χ x.2.1 c (n + (P.lam x.2.1 (x.2.1 + x.2.2 + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ)) *
        gT P χ (x.2.1 + x.2.2 + 1) c (∏ ℓ, (pp ℓ : ℤ)) n)) = fun _ => 0 from funext hzero]
  exact iterAvg_zero _

end G22.C1

end

/- ## Section: `C2Aux` -/

section

/-
# Generic lemmas for claim C2

* membership versions of the monotonicity / congruence lemmas for `iterAvg`;
* Fubini for `lavg` and `iterAvg`;
* the iterated logarithmic Elliott inequality (`peel`): dilating by the product of the first
  `a` coordinates of a tuple of primes costs at most `a·ε` in an iterated average;
* marginalisation (`marg`): an iterated average of a function of the product of a block of
  consecutive coordinates is the iterated average over that block only;
* harmonic sums (`half_le_logAvg_ind`);
* the colour Cauchy–Schwarz inequality (`colour_cs`);
* GS Lemma 6.2 (`proj_shift`).
-/

open Finset

namespace G22.C2

/- ### Averages: membership versions and Fubini -/

lemma iterAvg_congr_mem {k : ℕ} (S : Fin k → Finset ℕ) {F G : (Fin k → ℕ) → ℝ}
    (h : ∀ p : Fin k → ℕ, (∀ i, p i ∈ S i) → F p = G p) : iterAvg k S F = iterAvg k S G := by
  induction k with
  | zero => exact h _ (fun i => i.elim0)
  | succ k ih =>
    simp only [iterAvg, lavg]
    refine wavg_congr fun x hx => ih _ fun q hq => h _ fun i => ?_
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using hx
    · simpa using hq j

lemma iterAvg_mono_mem {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S) {F G : (Fin k → ℕ) → ℝ}
    (h : ∀ p : Fin k → ℕ, (∀ i, p i ∈ S i) → F p ≤ G p) : iterAvg k S F ≤ iterAvg k S G := by
  induction k with
  | zero => exact h _ (fun i => i.elim0)
  | succ k ih =>
    simp only [iterAvg, lavg]
    refine wavg_mono (goodWeights_lavg (hS 0).1 (hS 0).2) fun x hx =>
      ih hS.tail fun q hq => h _ fun i => ?_
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using hx
    · simpa using hq j

lemma abs_iterAvg_le_mem {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S)
    {F : (Fin k → ℕ) → ℝ} {c : ℝ}
    (h : ∀ p : Fin k → ℕ, (∀ i, p i ∈ S i) → |F p| ≤ c) : |iterAvg k S F| ≤ c := by
  rw [abs_le]
  constructor
  · have h1 := iterAvg_mono_mem hS (F := fun _ => -c) (G := F)
      (fun p hp => by linarith [(abs_le.mp (h p hp)).1])
    rwa [iterAvg_const hS] at h1
  · have h1 := iterAvg_mono_mem hS (F := F) (G := fun _ => c) (fun p hp => (abs_le.mp (h p hp)).2)
    rwa [iterAvg_const hS] at h1

lemma lavg_eq_sum (A : Finset ℕ) (f : ℕ → ℝ) :
    lavg A f = ∑ x ∈ A, (1 / (x : ℝ) / ∑ y ∈ A, 1 / (y : ℝ)) * f x := by
  simp only [lavg, wavg, Finset.sum_div]
  exact Finset.sum_congr rfl fun x _ => by ring

lemma lavg_lavg_comm (A B : Finset ℕ) (F : ℕ → ℕ → ℝ) :
    lavg A (fun x => lavg B (fun y => F x y)) = lavg B (fun y => lavg A (fun x => F x y)) := by
  simp only [lavg_eq_sum, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x _ => by ring

lemma lavg_iterAvg_comm (A : Finset ℕ) {k : ℕ} (S : Fin k → Finset ℕ)
    (F : ℕ → (Fin k → ℕ) → ℝ) :
    lavg A (fun x => iterAvg k S (F x)) = iterAvg k S (fun q => lavg A (fun x => F x q)) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterAvg]
    rw [lavg_lavg_comm]
    congr 1
    funext p
    exact ih (fun i => S i.succ) (fun x q => F x (Fin.cons p q))

lemma lavg_const {A : Finset ℕ} (hA : A.Nonempty) (h0 : ∀ p ∈ A, 0 < p) (c : ℝ) :
    lavg A (fun _ => c) = c :=
  wavg_const (goodWeights_lavg hA h0) c

lemma lavg_sub (A : Finset ℕ) (f g : ℕ → ℝ) :
    lavg A (fun x => f x - g x) = lavg A f - lavg A g := wavg_sub f g

/- ### Prefix products and the iterated Elliott inequality -/

/-- The conclusion of GS Lemma A.5 for one set `S`, with error `ε`. -/
def ElliottOK (N : ℕ) (ε : ℝ) (S : Finset ℕ) : Prop :=
  ∀ f : ℤ → ℝ, (∀ n, |f n| ≤ 1) →
    |logAvg N f - lavg S (fun p => logAvg N (fun n => f (p * n)))| ≤ ε

/-- Product of the first `a` coordinates of a tuple. -/
def pre {K : ℕ} (a : ℕ) (p : Fin K → ℕ) : ℕ := ∏ h : Fin K, if (h : ℕ) < a then p h else 1

lemma pre_zero {K : ℕ} (p : Fin K → ℕ) : pre 0 p = 1 := by simp [pre]

lemma pre_cons_succ {K : ℕ} (a x : ℕ) (q : Fin K → ℕ) :
    pre (a + 1) (Fin.cons x q : Fin (K + 1) → ℕ) = x * pre a q := by
  simp only [pre, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ, Fin.val_zero, Fin.val_succ]
  simp

/-- **Iterated logarithmic Elliott inequality.** If `Γ p` depends only on the coordinates of `p`
of index `≥ a`, then replacing `n` by `(p₀ ⋯ p_{a-1}) n` changes the iterated average by at most
`a ε`. -/
theorem peel (N : ℕ) (ε : ℝ) (a : ℕ) : ∀ (K : ℕ) (S : Fin K → Finset ℕ), GoodSets S →
    (∀ h, ElliottOK N ε (S h)) → a ≤ K →
    ∀ (Γ : (Fin K → ℕ) → ℤ → ℝ), (∀ p m, |Γ p m| ≤ 1) →
    (∀ p p' : Fin K → ℕ, (∀ h : Fin K, a ≤ (h : ℕ) → p h = p' h) → Γ p = Γ p') →
    |iterAvg K S (fun p => logAvg N (fun n => Γ p ((pre a p : ℤ) * n))) -
      iterAvg K S (fun p => logAvg N (Γ p))| ≤ a * ε := by
  induction a with
  | zero =>
    intro K S _ _ _ Γ _ _
    simp [pre_zero]
  | succ a ih =>
    intro K S hS hE ha Γ hΓ hdep
    obtain ⟨K, rfl⟩ : ∃ K', K = K' + 1 := ⟨K - 1, by omega⟩
    set S' : Fin K → Finset ℕ := fun i => S i.succ with hS'
    have hGS' : GoodSets S' := hS.tail
    have hG0 : GoodWeights (S 0) (fun p : ℕ => 1 / (p : ℝ)) := goodWeights_lavg (hS 0).1 (hS 0).2
    set Γ₀ : (Fin K → ℕ) → ℤ → ℝ := fun q => Γ (Fin.cons 0 q) with hΓ₀
    have hcons : ∀ x q, Γ (Fin.cons x q) = Γ₀ q := by
      intro x q
      apply hdep
      intro h hh
      cases h using Fin.cases with
      | zero => simp at hh
      | succ j => simp
    have hdep₀ : ∀ q q' : Fin K → ℕ, (∀ h : Fin K, a ≤ (h : ℕ) → q h = q' h) → Γ₀ q = Γ₀ q' := by
      intro q q' hqq'
      apply hdep
      intro h hh
      cases h using Fin.cases with
      | zero => simp at hh
      | succ j =>
        simp only [Fin.cons_succ]
        exact hqq' j (by simp only [Fin.val_succ] at hh; omega)
    -- rewrite the three quantities
    have eL : iterAvg (K + 1) S (fun p => logAvg N (fun n => Γ p ((pre (a + 1) p : ℤ) * n))) =
        lavg (S 0) (fun x => iterAvg K S' (fun q =>
          logAvg N (fun n => Γ₀ q ((x : ℤ) * ((pre a q : ℤ) * n))))) := by
      simp only [iterAvg]
      congr 1; funext x; congr 1; funext q; congr 1; funext n
      rw [pre_cons_succ, hcons]
      congr 1; push_cast; ring
    have eR : iterAvg (K + 1) S (fun p => logAvg N (Γ p)) =
        iterAvg K S' (fun q => logAvg N (Γ₀ q)) := by
      simp only [iterAvg]
      simp only [hcons]
      exact wavg_const hG0 _
    set Mid := lavg (S 0) (fun x => iterAvg K S' (fun q => logAvg N (fun n => Γ₀ q ((x : ℤ) * n))))
      with hMid
    have b1 : |lavg (S 0) (fun x => iterAvg K S' (fun q =>
          logAvg N (fun n => Γ₀ q ((x : ℤ) * ((pre a q : ℤ) * n))))) - Mid| ≤ a * ε := by
      rw [hMid, ← lavg_sub]
      refine abs_wavg_le_of_abs_le hG0 fun x _ => ?_
      have := ih K S' hGS' (fun h => hE h.succ) (by omega) (fun q m => Γ₀ q ((x : ℤ) * m))
        (fun q m => hΓ _ _) (by
          intro q q' hqq'
          simp only [hdep₀ q q' hqq'])
      exact this
    have b2 : |Mid - iterAvg K S' (fun q => logAvg N (Γ₀ q))| ≤ ε := by
      rw [hMid, lavg_iterAvg_comm, ← iterAvg_sub]
      refine abs_iterAvg_le_of_abs_le hGS' fun q => ?_
      rw [abs_sub_comm]
      exact hE 0 (Γ₀ q) (fun m => hΓ _ _)
    rw [eL, eR]
    calc _ ≤ |lavg (S 0) (fun x => iterAvg K S' (fun q =>
          logAvg N (fun n => Γ₀ q ((x : ℤ) * ((pre a q : ℤ) * n))))) - Mid| +
          |Mid - iterAvg K S' (fun q => logAvg N (Γ₀ q))| := abs_sub_le _ _ _
      _ ≤ a * ε + ε := add_le_add b1 b2
      _ = ((a + 1 : ℕ) : ℝ) * ε := by push_cast; ring

/- ### Marginalisation -/

/-- Product of the coordinates of index in `[a, a + len)`. -/
def mid {K : ℕ} (a len : ℕ) (p : Fin K → ℕ) : ℕ :=
  ∏ h : Fin K, if a ≤ (h : ℕ) ∧ (h : ℕ) < a + len then p h else 1

lemma mid_len_zero {K : ℕ} (a : ℕ) (p : Fin K → ℕ) : mid a 0 p = 1 := by
  simp only [mid]
  apply Finset.prod_eq_one
  intro h _
  rw [if_neg]; omega

lemma mid_cons_succ {K : ℕ} (a len x : ℕ) (q : Fin K → ℕ) :
    mid (a + 1) len (Fin.cons x q : Fin (K + 1) → ℕ) = mid a len q := by
  simp only [mid, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ, Fin.val_zero, Fin.val_succ]
  have h0 : ¬ (a + 1 ≤ 0 ∧ 0 < a + 1 + len) := by omega
  rw [if_neg h0, one_mul]
  refine Finset.prod_congr rfl fun h _ => ?_
  by_cases hh : a ≤ (h : ℕ) ∧ (h : ℕ) < a + len
  · rw [if_pos hh, if_pos (by omega)]
  · rw [if_neg hh, if_neg (by omega)]

lemma mid_cons_zero {K : ℕ} (len x : ℕ) (q : Fin K → ℕ) :
    mid 0 (len + 1) (Fin.cons x q : Fin (K + 1) → ℕ) = x * mid 0 len q := by
  simp only [mid, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ, Fin.val_zero, Fin.val_succ]
  have h0 : (0 ≤ 0 ∧ 0 < 0 + (len + 1)) := by omega
  rw [if_pos h0]
  congr 1
  refine Finset.prod_congr rfl fun h _ => ?_
  by_cases hh : 0 ≤ (h : ℕ) ∧ (h : ℕ) < 0 + len
  · rw [if_pos hh, if_pos (by omega)]
  · rw [if_neg hh, if_neg (by omega)]

lemma pre_add {K : ℕ} (a len : ℕ) (p : Fin K → ℕ) : pre (a + len) p = pre a p * mid a len p := by
  simp only [pre, mid, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun h _ => ?_
  by_cases h1 : (h : ℕ) < a
  · rw [if_pos (by omega), if_pos h1, if_neg (by omega), mul_one]
  · by_cases h2 : (h : ℕ) < a + len
    · rw [if_pos h2, if_neg h1, if_pos ⟨by omega, h2⟩, one_mul]
    · rw [if_neg h2, if_neg h1, if_neg (by omega), one_mul]

lemma mid_congr {K : ℕ} (a len : ℕ) (p p' : Fin K → ℕ) (h : ∀ i : Fin K, a ≤ (i : ℕ) → p i = p' i) :
    mid a len p = mid a len p' := by
  simp only [mid]
  refine Finset.prod_congr rfl fun i _ => ?_
  by_cases hi : a ≤ (i : ℕ) ∧ (i : ℕ) < a + len
  · rw [if_pos hi, if_pos hi, h i hi.1]
  · rw [if_neg hi, if_neg hi]

/-- **Marginalisation.** An iterated average of a function of the product of the coordinates
of index in `[a, a + len)` is the iterated average over those coordinates only. -/
theorem marg : ∀ (K a len : ℕ) (S : Fin K → Finset ℕ) (S' : Fin len → Finset ℕ), GoodSets S →
    a + len ≤ K → (∀ (ℓ : Fin len) (h : Fin K), (h : ℕ) = a + ℓ → S' ℓ = S h) → ∀ Ψ : ℕ → ℝ,
    iterAvg K S (fun p => Ψ (mid a len p)) = iterAvg len S' (fun w => Ψ (∏ ℓ, w ℓ)) := by
  intro K
  induction K with
  | zero =>
    intro a len S S' _ hle _ Ψ
    obtain rfl : a = 0 := by omega
    obtain rfl : len = 0 := by omega
    simp [iterAvg, mid]
  | succ K ih =>
    intro a len S S' hS hle hSS' Ψ
    have hG0 : GoodWeights (S 0) (fun p : ℕ => 1 / (p : ℝ)) :=
      goodWeights_lavg (hS 0).1 (hS 0).2
    cases a with
    | succ a =>
      simp only [iterAvg, mid_cons_succ]
      rw [ih a len (fun i => S i.succ) S' hS.tail (by omega)
        (fun ℓ h hh => hSS' ℓ h.succ (by simp only [Fin.val_succ]; omega)) Ψ]
      exact wavg_const hG0 _
    | zero =>
      cases len with
      | zero =>
        simp only [mid_len_zero]
        rw [iterAvg_const hS]
        simp [iterAvg]
      | succ len =>
        simp only [iterAvg, mid_cons_zero, Fin.prod_cons]
        have h0 : S' 0 = S 0 := hSS' 0 0 (by simp)
        rw [h0]
        congr 1
        funext x
        exact ih 0 len (fun i => S i.succ) (fun ℓ => S' ℓ.succ) hS.tail (by omega)
          (fun ℓ h hh => hSS' ℓ.succ h.succ (by simp only [Fin.val_succ]; omega))
          (fun T => Ψ (x * T))

/- ### Harmonic sums -/

lemma sum_Icc_inv (m : ℕ) : ∑ n ∈ Icc 1 m, 1 / (n : ℝ) = (harmonic m : ℝ) := by
  rw [harmonic_eq_sum_Icc]
  push_cast
  simp [one_div]

/-- If `1 + log N ≤ 2 log (Y + 1)`, then at least half of the logarithmic mass of `[1, N]`
lies in `[1, Y]`. -/
lemma half_le_logAvg_ind (N Y : ℕ) (hYN : Y ≤ N)
    (hlog : 1 + Real.log N ≤ 2 * Real.log (Y + 1)) :
    1 / 2 ≤ logAvg N (fun n : ℤ => if n ≤ (Y : ℤ) then 1 else 0) := by
  unfold logAvg wavg
  have hnum : ∑ n ∈ Icc 1 N, 1 / (n : ℝ) * (if ((n : ℤ) ≤ (Y : ℤ)) then (1 : ℝ) else 0) =
      ∑ n ∈ Icc 1 Y, 1 / (n : ℝ) := by
    have : ∀ n ∈ Icc 1 N, 1 / (n : ℝ) * (if ((n : ℤ) ≤ (Y : ℤ)) then (1 : ℝ) else 0) =
        if n ≤ Y then 1 / (n : ℝ) else 0 := by
      intro n _
      simp only [Nat.cast_le]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl this, ← Finset.sum_filter]
    congr 1
    ext n
    simp only [mem_filter, mem_Icc]
    omega
  rw [hnum, sum_Icc_inv, sum_Icc_inv]
  have h1 : Real.log ((Y : ℝ) + 1) ≤ harmonic Y := by
    have := log_add_one_le_harmonic Y
    push_cast at this
    exact this
  have h2 : (harmonic N : ℝ) ≤ 1 + Real.log N := harmonic_le_one_add_log N
  have hY0 : 0 ≤ Real.log ((Y : ℝ) + 1) := Real.log_nonneg (by linarith [(Nat.cast_nonneg Y : (0:ℝ) ≤ Y)])
  have hN1 : 1 ≤ N := by
    by_contra hN
    obtain rfl : N = 0 := by omega
    obtain rfl : Y = 0 := by omega
    norm_num at hlog
  have h3 : 0 < (harmonic N : ℝ) := by
    have := harmonic_pos (n := N) (by omega)
    exact_mod_cast this
  rw [le_div_iff₀ h3]
  linarith

/- ### Colour Cauchy–Schwarz -/

/-- The pairs `(a, k)` with `a, k ≥ 1`, `a + k + 1 ≤ K` (so `j = a + k + 1 ≥ a + 2`). -/
def pairs (K : ℕ) : Finset (ℕ × ℕ) := (Icc 1 K ×ˢ Icc 1 K).filter (fun x => x.1 + x.2 + 1 ≤ K)

lemma mem_pairs {K : ℕ} {x : ℕ × ℕ} : x ∈ pairs K ↔ 1 ≤ x.1 ∧ 1 ≤ x.2 ∧ x.1 + x.2 + 1 ≤ K := by
  simp only [pairs, mem_filter, mem_product, mem_Icc]
  omega

lemma card_pairs_le (K : ℕ) : ((pairs K).card : ℝ) ≤ (K : ℝ) ^ 2 := by
  have : (pairs K).card ≤ K * K := by
    calc (pairs K).card ≤ (Icc 1 K ×ˢ Icc 1 K).card := card_filter_le _ _
      _ = K * K := by rw [card_product, Nat.card_Icc]; simp
  calc ((pairs K).card : ℝ) ≤ ((K * K : ℕ) : ℝ) := by exact_mod_cast this
    _ = (K : ℝ) ^ 2 := by push_cast; ring

lemma sum_pairs {M : Type*} [AddCommMonoid M] (K : ℕ) (g : ℕ → ℕ → M) :
    ∑ x ∈ pairs K, g x.1 x.2 =
      ∑ a ∈ Icc 1 K, ∑ k ∈ (Icc 1 K).filter (fun k => a + k + 1 ≤ K), g a k := by
  rw [pairs, Finset.sum_filter, Finset.sum_product]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_filter]

/-- **Colour Cauchy–Schwarz.** If `y c j ≥ 0`, `∑_c y c j ≤ 1` for all `j` and `= 1` for
`j ∈ [1, K]`, then `∑_{(a,k)} ∑_c y c a · y c (a+k+1) ≥ (K²/r - 3K)/2`. -/
theorem colour_cs (r K : ℕ) (hr : 1 ≤ r) (y : Fin r → ℕ → ℝ) (hy0 : ∀ c j, 0 ≤ y c j)
    (hy1 : ∀ j, ∑ c, y c j ≤ 1) (hyK : ∀ j ∈ Icc 1 K, ∑ c, y c j = 1) :
    ((K : ℝ) ^ 2 / r - 3 * K) / 2 ≤ ∑ x ∈ pairs K, ∑ c, y c x.1 * y c (x.1 + x.2 + 1) := by
  obtain ⟨B, hB⟩ : ∃ B : ℕ → ℕ → ℝ, B = fun j j' => ∑ c, y c j * y c j' := ⟨_, rfl⟩
  have hBe : ∀ j j', B j j' = ∑ c, y c j * y c j' := fun j j' => by rw [hB]
  have hyle : ∀ c j, y c j ≤ 1 := fun c j =>
    (Finset.single_le_sum (fun c _ => hy0 c j) (mem_univ c)).trans (hy1 j)
  have hB0 : ∀ j j', 0 ≤ B j j' := fun j j' => by
    rw [hBe]; exact Finset.sum_nonneg fun c _ => mul_nonneg (hy0 c j) (hy0 c j')
  have hB1 : ∀ j j', B j j' ≤ 1 := by
    intro j j'
    rw [hBe]
    calc ∑ c, y c j * y c j' ≤ ∑ c, y c j * 1 :=
          Finset.sum_le_sum fun c _ => mul_le_mul_of_nonneg_left (hyle c j') (hy0 c j)
      _ ≤ 1 := by simpa using hy1 j
  have hBs : ∀ j j', B j j' = B j' j := fun j j' => by
    rw [hBe, hBe]; exact Finset.sum_congr rfl fun c _ => mul_comm _ _
  -- (1) the total
  have htot : (K : ℝ) ^ 2 / r ≤ ∑ j ∈ Icc 1 K, ∑ j' ∈ Icc 1 K, B j j' := by
    have h1 : ∑ c : Fin r, ∑ j ∈ Icc 1 K, y c j = K := by
      rw [Finset.sum_comm, Finset.sum_congr rfl hyK]
      simp
    have h2 := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (Fin r)))
      (f := fun c => ∑ j ∈ Icc 1 K, y c j)
    have h3 : ∑ c : Fin r, (∑ j ∈ Icc 1 K, y c j) ^ 2 =
        ∑ j ∈ Icc 1 K, ∑ j' ∈ Icc 1 K, B j j' := by
      simp only [sq, Finset.sum_mul_sum, hBe]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.sum_comm]
    rw [h1, card_univ, Fintype.card_fin, h3] at h2
    have hr' : (0 : ℝ) < r := by exact_mod_cast hr
    rw [div_le_iff₀ hr']
    linarith
  -- (2) splitting off the near-diagonal terms
  have hrow : ∀ j ∈ Icc 1 K, ∑ j' ∈ Icc 1 K, B j j' ≤
      ∑ j' ∈ (Icc 1 K).filter (fun j' => j + 2 ≤ j'), B j j' +
        ∑ j' ∈ (Icc 1 K).filter (fun j' => j' + 2 ≤ j), B j j' + 3 := by
    intro j hj
    have hj1 : 1 ≤ j := (mem_Icc.mp hj).1
    rw [← Finset.sum_filter_add_sum_filter_not (Icc 1 K) (fun j' => j + 2 ≤ j')]
    rw [← Finset.sum_filter_add_sum_filter_not ((Icc 1 K).filter fun j' => ¬ j + 2 ≤ j')
      (fun j' => j' + 2 ≤ j)]
    have e1 : ∑ j' ∈ ((Icc 1 K).filter fun j' => ¬ j + 2 ≤ j').filter (fun j' => j' + 2 ≤ j),
        B j j' ≤ ∑ j' ∈ (Icc 1 K).filter (fun j' => j' + 2 ≤ j), B j j' := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro x hx
        simp only [mem_filter] at hx ⊢
        exact ⟨hx.1.1, hx.2⟩
      · intro x _ _; exact hB0 _ _
    have e2 : ∑ j' ∈ ((Icc 1 K).filter fun j' => ¬ j + 2 ≤ j').filter
        (fun j' => ¬ j' + 2 ≤ j), B j j' ≤ 3 := by
      calc _ ≤ ∑ j' ∈ Icc (j - 1) (j + 1), B j j' := by
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · intro x hx
              simp only [mem_filter, mem_Icc] at hx ⊢
              omega
            · intro x _ _; exact hB0 _ _
        _ ≤ ∑ j' ∈ Icc (j - 1) (j + 1), (1 : ℝ) := Finset.sum_le_sum fun x _ => hB1 _ _
        _ = 3 := by
            rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, mul_one]
            have : j + 1 + 1 - (j - 1) = 3 := by omega
            rw [this]; norm_num
    linarith
  have hsplit : ∑ j ∈ Icc 1 K, ∑ j' ∈ Icc 1 K, B j j' ≤
      ∑ j ∈ Icc 1 K, ∑ j' ∈ (Icc 1 K).filter (fun j' => j + 2 ≤ j'), B j j' +
        ∑ j ∈ Icc 1 K, ∑ j' ∈ (Icc 1 K).filter (fun j' => j' + 2 ≤ j), B j j' + 3 * K := by
    have h3K : ∑ j ∈ Icc 1 K, (3 : ℝ) = 3 * K := by
      rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul]
      simp only [Nat.add_sub_cancel]
      ring
    rw [← h3K, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_le_sum hrow
  -- (3) the two far parts are equal
  have hX : ∑ j ∈ Icc 1 K, ∑ j' ∈ (Icc 1 K).filter (fun j' => j' + 2 ≤ j), B j j' =
      ∑ j ∈ Icc 1 K, ∑ j' ∈ (Icc 1 K).filter (fun j' => j + 2 ≤ j'), B j j' := by
    rw [Finset.sum_comm' (t' := Icc 1 K) (s' := fun j' => (Icc 1 K).filter (fun j => j' + 2 ≤ j))]
    · exact Finset.sum_congr rfl fun j' _ => Finset.sum_congr rfl fun j _ => hBs _ _
    · intro j j'
      simp only [mem_filter]
      tauto
  -- (4) the far part is the sum over pairs
  have hF : ∑ j ∈ Icc 1 K, ∑ j' ∈ (Icc 1 K).filter (fun j' => j + 2 ≤ j'), B j j' =
      ∑ x ∈ pairs K, ∑ c, y c x.1 * y c (x.1 + x.2 + 1) := by
    rw [sum_pairs K (fun a k => ∑ c, y c a * y c (a + k + 1))]
    refine Finset.sum_congr rfl fun a ha => ?_
    symm
    apply Finset.sum_nbij' (fun k => a + k + 1) (fun j' => j' - a - 1)
    · intro k hk
      simp only [mem_filter, mem_Icc] at hk ⊢
      omega
    · intro j' hj'
      simp only [mem_filter, mem_Icc] at hj' ⊢
      omega
    · intro k hk
      omega
    · intro j' hj'
      simp only [mem_filter, mem_Icc] at hj'
      omega
    · intro k _
      rw [hBe]
  linarith [htot, hsplit, hX, hF]

/- ### GS Lemma 6.2 -/

lemma sum_range_shift_sub (g : ℕ → ℝ) (hg : ∀ t, |g t| ≤ 1) (H m : ℕ) :
    |∑ k ∈ range H, (g (k + m) - g k)| ≤ 2 * m := by
  induction m with
  | zero => simp
  | succ m ih =>
    have h1 : ∑ k ∈ range H, (g (k + (m + 1)) - g k) =
        (g (H + m) - g m) + ∑ k ∈ range H, (g (k + m) - g k) := by
      have := Finset.sum_range_sub (fun k => g (k + m)) H
      simp only [zero_add] at this
      rw [← this, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [show k + 1 + m = k + (m + 1) by ring]
      ring
    rw [h1]
    have h2 : |g (H + m) - g m| ≤ 2 := by
      calc |g (H + m) - g m| ≤ |g (H + m)| + |g m| := abs_sub _ _
        _ ≤ 1 + 1 := add_le_add (hg _) (hg _)
        _ = 2 := by norm_num
    calc |g (H + m) - g m + ∑ k ∈ range H, (g (k + m) - g k)|
        ≤ |g (H + m) - g m| + |∑ k ∈ range H, (g (k + m) - g k)| := abs_add_le _ _
      _ ≤ 2 + 2 * m := add_le_add h2 ih
      _ = 2 * ((m + 1 : ℕ) : ℝ) := by push_cast; ring

lemma uavg_eq_sum (H : ℕ) (φ : ℕ → ℝ) : uavg H φ = (∑ k ∈ range H, φ (k + 1)) / H := by
  unfold uavg wavg
  have e : ∑ k ∈ range H, φ (k + 1) = ∑ h ∈ Icc 1 H, φ h := by
    rw [Finset.range_eq_Ico, Finset.sum_Ico_add' φ 0 H 1, zero_add,
      Finset.Ico_add_one_right_eq_Icc]
  rw [e]
  simp [Nat.card_Icc]

/-- **GS Lemma 6.2** (for shifts by multiples of `q`): shifting `Π_{q,H} f` by `q m` changes it
by at most `2m/H`. -/
lemma proj_shift (q H : ℕ) (hH : 1 ≤ H) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (n : ℤ) (m : ℕ) :
    |proj q H f (n + q * m) - proj q H f n| ≤ 2 * m / H := by
  set g : ℕ → ℝ := fun t => uavg H (fun h' => f (n + q * ((t : ℤ) - h'))) with hg
  have hgb : ∀ t, |g t| ≤ 1 := fun t =>
    abs_wavg_le_of_abs_le (goodWeights_uavg hH) (fun h' _ => hf _)
  have e1 : proj q H f n = uavg H g := rfl
  have e2 : proj q H f (n + q * m) = uavg H (fun h => g (h + m)) := by
    unfold proj
    congr 1; funext h
    simp only [hg]
    congr 1; funext h'
    congr 1
    push_cast; ring
  rw [e1, e2, uavg_eq_sum, uavg_eq_sum, ← sub_div, ← Finset.sum_sub_distrib]
  have hHpos : (0 : ℝ) < H := by exact_mod_cast hH
  rw [abs_div, abs_of_pos hHpos]
  apply div_le_div_of_nonneg_right _ hHpos.le
  calc |∑ k ∈ range H, (g (k + 1 + m) - g (k + 1))|
      = |∑ k ∈ range H, ((fun k => g (k + 1)) (k + m) - (fun k => g (k + 1)) k)| := by
        congr 1
        refine Finset.sum_congr rfl fun k _ => ?_
        simp only
        rw [Nat.add_right_comm]
    _ ≤ 2 * m := sum_range_shift_sub _ (fun t => hgb _) H m

end G22.C2

end

/- ## Section: `C2` -/

section

/-
# Claim C2: positivity after the small projections

We prove `ssml_lower'`, i.e. claim **C2** of `Claims.lean` (draft §§3–4):
for all large `r` and every `r`-colouring `χ` of `[1, M]`,
`𝒮 = Ssml ≥ (t - 1) K² / (2¹⁵ r³)`.

Structure of the proof (for a fixed row `i ∈ [1, t - 1]`):

1. `row_sigma`: colour Cauchy–Schwarz over the whole row (`colour_cs`), the harmonic-sum bound for
   the exceptional `n` (`half_le_logAvg_ind`), the iterated Elliott inequality (`peel`) and
   marginalisation (`marg`) give
   `Σ_row := ∑_{(a,k)} ∑_c E_W[f_{a,c}(n) 1_{A_c}(b_j T n)] ≥ (K²/r - 3K)/4 - K³ ε`.
2. `row_corr`: GS (6.4) (`Cor64With`) and GS Lemma 6.2 (`proj_shift`) give
   `∑_{(a,k)} corr(P^s f) ≥ (η/8) Σ_row - #pairs · r (η²/8 + ε_sh)`.
3. `row_main`: the parameter estimates (`NumFacts`) make the right-hand side
   `≥ K² / (2¹⁵ r³)`.

Summing over the `t - 1` rows gives the claim (`ssml_lower'`).

Choices of the auxiliary quantities (with `R = r`, `K = t = R⁷`, `L = R²⁸`):
* the Elliott error per prime set is `ε = (2 C_{A5} + 1)/R¹⁴` (Mertens gives
  `∑_{p ∈ 𝒫_{i,h}} 1/p ≥ L - 1 - C_M ≥ R²⁸/4`, and `log H_{i,2K} / log M` is tiny);
* the exceptional `n` are those `> Y = ⌊exp(exp(R⁴³)/2 + 1)⌋`; at least half of the logarithmic
  mass of `[1, M]` lies in `[1, Y]`, and `b_K H_{i,2K}^K Y ≤ M`;
* `η = 1/(64 R²)` in GS (6.4), and the shift error is `ε_sh = 1/(8192 R⁴)`.
The numerical inequalities needed (`NumFacts`) are proved for large `r` in
`numFacts_eventually`, by reducing them to polynomial inequalities `A r^m ≤ r^n` (`m < n`).
-/

open Finset Filter

namespace G22.C2

/- ## Elementary facts about the objects -/

section objects

lemma logAvg_sum (N : ℕ) {ι : Type*} (s : Finset ι) (f : ι → ℤ → ℝ) :
    logAvg N (fun n => ∑ x ∈ s, f x n) = ∑ x ∈ s, logAvg N (f x) := by
  unfold logAvg
  exact wavg_sum s (fun x (n : ℕ) => f x n)

lemma logAvg_sub (N : ℕ) (f g : ℤ → ℝ) :
    logAvg N (fun n => f n - g n) = logAvg N f - logAvg N g := by
  unfold logAvg
  exact wavg_sub (fun n : ℕ => f n) (fun n : ℕ => g n)

lemma Wexp_sum (P : Par) (i a k : ℕ) {ι : Type*} (s : Finset ι) (Φ : ι → ℤ → ℤ → ℝ) :
    Wexp P i a k (fun n T => ∑ c ∈ s, Φ c n T) = ∑ c ∈ s, Wexp P i a k (Φ c) := by
  unfold Wexp
  rw [← iterAvg_sum]
  congr 1
  funext pp
  exact logAvg_sum _ s (fun c n => Φ c n (∏ ℓ, (pp ℓ : ℤ)))

lemma sum_ind_eq_one {N r : ℕ} (χ : Finset.Icc 1 N → Fin r) {m : ℤ} (h : 1 ≤ m ∧ m ≤ N) :
    ∑ c, ind χ c m = 1 := by
  unfold ind
  simp only [dif_pos h]
  rw [Finset.sum_ite_eq]
  simp

lemma sum_ind_mul_nonneg {N r : ℕ} (χ : Finset.Icc 1 N → Fin r) (u v : ℤ) :
    0 ≤ ∑ c, ind χ c u * ind χ c v :=
  Finset.sum_nonneg fun c _ => mul_nonneg (ind_nonneg χ c u) (ind_nonneg χ c v)

lemma sum_ind_mul_le_one {N r : ℕ} (χ : Finset.Icc 1 N → Fin r) (u v : ℤ) :
    ∑ c, ind χ c u * ind χ c v ≤ 1 := by
  calc ∑ c, ind χ c u * ind χ c v ≤ ∑ c, ind χ c u * 1 :=
        Finset.sum_le_sum fun c _ =>
          mul_le_mul_of_nonneg_left (ind_le_one χ c v) (ind_nonneg χ c u)
    _ ≤ 1 := by simpa using sum_ind_le_one χ u

lemma abs_sum_ind_mul_le {N r : ℕ} (χ : Finset.Icc 1 N → Fin r) (u v : ℤ) :
    |∑ c, ind χ c u * ind χ c v| ≤ 1 := by
  rw [abs_le]
  constructor
  · linarith [sum_ind_mul_nonneg χ u v]
  · exact sum_ind_mul_le_one χ u v

variable (P : Par)

lemma V_pos : 0 < P.V := Nat.factorial_pos _

lemma one_le_b (j : ℕ) : 1 ≤ P.b j := Nat.one_le_pow _ _ (V_pos P)

lemma b_mono {j j' : ℕ} (h : j ≤ j') : P.b j ≤ P.b j' :=
  Nat.pow_le_pow_right (V_pos P) (Nat.pow_le_pow_right (by norm_num) h)

lemma one_le_q (a j : ℕ) : 1 ≤ P.q a j :=
  Nat.mul_le_mul (Nat.one_le_pow _ _ (V_pos P)) (V_pos P)

/-- `λ_{a,a+k+1} = q_{a,a+k} · V^{3·4^{a+k} - 1}`, so that `λ T` is a multiple of `q`. -/
lemma lam_eq (a k : ℕ) (hk : 1 ≤ k) :
    P.lam a (a + k + 1) = P.q a (a + k) * P.V ^ (3 * 4 ^ (a + k) - 1) := by
  simp only [Par.lam, Par.q]
  rw [← pow_succ, ← pow_add]
  congr 1
  have h1 : 4 ^ (a + k + 1) = 4 * 4 ^ (a + k) := by rw [pow_succ]; ring
  have h2 : 4 * 4 ^ a ≤ 4 ^ (a + k) := by
    calc 4 * 4 ^ a = 4 ^ (a + 1) := by rw [pow_succ]; ring
      _ ≤ 4 ^ (a + k) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have h3 : 1 ≤ 4 ^ a := Nat.one_le_pow _ _ (by norm_num)
  omega

lemma four_pow_lt {a k K : ℕ} (hak : a + k + 1 ≤ K) : 4 * 4 ^ (a + k) ≤ 4 ^ K := by
  calc 4 * 4 ^ (a + k) = 4 ^ (a + k + 1) := by rw [pow_succ]; ring
    _ ≤ 4 ^ K := Nat.pow_le_pow_right (by norm_num) hak

lemma q_le_bK {a k : ℕ} (hak : a + k + 1 ≤ P.K) : P.q a (a + k) ≤ P.b P.K := by
  simp only [Par.q, Par.lam, Par.b]
  rw [← pow_succ]
  apply Nat.pow_le_pow_right (V_pos P)
  have := four_pow_lt hak
  have h3 : 1 ≤ 4 ^ (a + k) := Nat.one_le_pow _ _ (by norm_num)
  omega

lemma m0_le_bK {a k : ℕ} (hak : a + k + 1 ≤ P.K) : P.V ^ (3 * 4 ^ (a + k) - 1) ≤ P.b P.K := by
  simp only [Par.b]
  apply Nat.pow_le_pow_right (V_pos P)
  have := four_pow_lt hak
  omega

lemma pre_bounds {K : ℕ} (a : ℕ) (p : Fin K → ℕ) (Pb : ℕ) (hPb : 1 ≤ Pb)
    (hp : ∀ h, 1 ≤ p h ∧ p h ≤ Pb) : 1 ≤ pre a p ∧ pre a p ≤ Pb ^ K := by
  constructor
  · apply Finset.one_le_prod''
    intro h
    split_ifs
    · exact (hp h).1
    · exact le_refl 1
  · calc pre a p ≤ Pb ^ (univ : Finset (Fin K)).card :=
          Finset.prod_le_pow_card _ _ _ fun h _ => by
            split_ifs
            · exact (hp h).2
            · exact hPb
      _ = Pb ^ K := by rw [card_univ, Fintype.card_fin]

lemma prod_le_pow {n : ℕ} (w : Fin n → ℕ) (Pb : ℕ) (hw : ∀ ℓ, w ℓ ≤ Pb) :
    ∏ ℓ, w ℓ ≤ Pb ^ n := by
  calc ∏ ℓ, w ℓ ≤ Pb ^ (univ : Finset (Fin n)).card :=
        Finset.prod_le_pow_card _ _ _ fun ℓ _ => hw ℓ
    _ = Pb ^ n := by rw [card_univ, Fintype.card_fin]

end objects

/- ## Step 1: the lower bound for `Σ_row` -/

/-- `x_{c,j}(p, n) = 1_{A_c}(b_j T_j(p) n)`, with `T_j(p)` the product of the first `j`
coordinates of `p`. -/
noncomputable def xv (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (c : Fin P.r) (j : ℕ)
    {K : ℕ} (p : Fin K → ℕ) (n : ℤ) : ℝ :=
  ind χ c ((P.b j : ℤ) * ((pre j p : ℤ) * n))

/-- **Row bound, part 1** (colour Cauchy–Schwarz + iterated Elliott + marginalisation). -/
theorem row_sigma (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i : ℕ) (ε : ℝ) (Y Pb : ℕ)
    (hr : 1 ≤ P.r) (hε : 0 ≤ ε) (hPb : 1 ≤ Pb) (hM1 : 1 ≤ Mval P.r)
    (hS : ∀ h : Fin P.K, (P.Pr i (h + 1)).Nonempty ∧ ∀ p ∈ P.Pr i (h + 1), 1 ≤ p ∧ p ≤ Pb)
    (hE : ∀ h : Fin P.K, ElliottOK (Mval P.r) ε (P.Pr i (h + 1)))
    (hY : P.b P.K * Pb ^ P.K * Y ≤ Mval P.r)
    (hYlog : 1 + Real.log (Mval P.r) ≤ 2 * Real.log (Y + 1))
    (hc0 : 0 ≤ (P.K : ℝ) ^ 2 / P.r - 3 * P.K) :
    ((P.K : ℝ) ^ 2 / P.r - 3 * P.K) / 4 - (P.K : ℝ) ^ 3 * ε ≤
      ∑ x ∈ pairs P.K, ∑ c, Wexp P i x.1 x.2
        (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n) := by
  have hGS : GoodSets (fun h : Fin P.K => P.Pr i (h + 1)) :=
    fun h => ⟨(hS h).1, fun p hp => ((hS h).2 p hp).1⟩
  have hYM : Y ≤ Mval P.r := by
    calc Y = 1 * 1 * Y := by ring
      _ ≤ P.b P.K * Pb ^ P.K * Y :=
          Nat.mul_le_mul (Nat.mul_le_mul (one_le_b P _) (Nat.one_le_pow _ _ hPb)) le_rfl
      _ ≤ Mval P.r := hY
  -- Step 1: each pair, by `peel` and `marg`
  have step1 : ∀ x ∈ pairs P.K,
      |iterAvg P.K (fun h : Fin P.K => P.Pr i (h + 1)) (fun p => logAvg (Mval P.r) (fun n =>
          ∑ c, xv P χ c x.1 p n * xv P χ c (x.1 + x.2 + 1) p n)) -
        ∑ c, Wexp P i x.1 x.2 (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n)| ≤
        (x.1 : ℝ) * ε := by
    rintro ⟨a, k⟩ hx
    rw [mem_pairs] at hx
    obtain ⟨ha, hk, hak⟩ := hx
    dsimp only
    set Γ : (Fin P.K → ℕ) → ℤ → ℝ := fun p m => ∑ c, ind χ c ((P.b a : ℤ) * m) *
      ind χ c ((P.b (a + k + 1) : ℤ) * (mid a (k + 1) p : ℤ) * m) with hΓ
    have e1 : (fun p : Fin P.K → ℕ => logAvg (Mval P.r) (fun n =>
        ∑ c, xv P χ c a p n * xv P χ c (a + k + 1) p n)) =
        fun p => logAvg (Mval P.r) (fun n => Γ p ((pre a p : ℤ) * n)) := by
      funext p
      congr 1
      funext n
      simp only [hΓ, xv]
      refine Finset.sum_congr rfl fun c _ => ?_
      have hpre : pre (a + k + 1) p = pre a p * mid a (k + 1) p := pre_add a (k + 1) p
      rw [hpre]
      push_cast
      congr 2
      ring
    have hΓ1 : ∀ p m, |Γ p m| ≤ 1 := fun p m => abs_sum_ind_mul_le χ _ _
    have hΓdep : ∀ p p' : Fin P.K → ℕ, (∀ h : Fin P.K, a ≤ (h : ℕ) → p h = p' h) →
        Γ p = Γ p' := by
      intro p p' hpp'
      simp only [hΓ, mid_congr a (k + 1) p p' hpp']
    have hpeel := peel (Mval P.r) ε a P.K _ hGS hE (by omega) Γ hΓ1 hΓdep
    set Ψ : ℕ → ℝ := fun T => logAvg (Mval P.r) (fun m => ∑ c, ind χ c ((P.b a : ℤ) * m) *
      ind χ c ((P.b (a + k + 1) : ℤ) * (T : ℤ) * m)) with hΨ
    have e2 : iterAvg P.K (fun h : Fin P.K => P.Pr i (h + 1)) (fun p => logAvg (Mval P.r) (Γ p)) =
        iterAvg (k + 1) (P.win i a k) (fun w => Ψ (∏ ℓ, w ℓ)) :=
      marg P.K a (k + 1) _ (P.win i a k) hGS (by omega)
        (fun ℓ h hh => by simp only [Par.win]; congr 1; omega) Ψ
    have e3 : ∑ c, Wexp P i a k (fun n T => fa P χ a c n * gT P χ (a + k + 1) c T n) =
        iterAvg (k + 1) (P.win i a k) (fun w => Ψ (∏ ℓ, w ℓ)) := by
      rw [← Wexp_sum]
      simp only [Wexp, hΨ, fa, gT, Nat.cast_prod]
    rw [e1, e3, ← e2]
    exact hpeel
  -- Steps 2–3: Cauchy–Schwarz over the colours, pointwise in `(p, n)`
  set c₀ : ℝ := ((P.K : ℝ) ^ 2 / P.r - 3 * P.K) / 2 with hc₀def
  have hc₀ : 0 ≤ c₀ := by rw [hc₀def]; linarith
  have step2 : c₀ * (1 / 2) ≤
      ∑ x ∈ pairs P.K, iterAvg P.K (fun h : Fin P.K => P.Pr i (h + 1)) (fun p =>
        logAvg (Mval P.r) (fun n => ∑ c, xv P χ c x.1 p n * xv P χ c (x.1 + x.2 + 1) p n)) := by
    rw [← iterAvg_sum]
    refine le_trans (le_of_eq (iterAvg_const hGS _).symm) (iterAvg_mono_mem hGS fun p hp => ?_)
    rw [← logAvg_sum]
    have hθ := half_le_logAvg_ind (Mval P.r) Y hYM hYlog
    have hp' : ∀ h, 1 ≤ p h ∧ p h ≤ Pb := fun h => (hS h).2 (p h) (hp h)
    calc c₀ * (1 / 2) ≤ c₀ * logAvg (Mval P.r) (fun n : ℤ => if n ≤ (Y : ℤ) then 1 else 0) :=
          mul_le_mul_of_nonneg_left hθ hc₀
      _ = logAvg (Mval P.r) (fun n : ℤ => c₀ * (if n ≤ (Y : ℤ) then 1 else 0)) :=
          (wavg_smul _ _).symm
      _ ≤ _ := by
          apply wavg_mono (goodWeights_logAvg hM1)
          intro n hn
          have hn1 : 1 ≤ n := (mem_Icc.mp hn).1
          by_cases hnY : ((n : ℕ) : ℤ) ≤ (Y : ℤ)
          · simp only [if_pos hnY, mul_one]
            rw [hc₀def]
            apply colour_cs P.r P.K hr (fun c j => xv P χ c j p n)
            · intro c j; exact ind_nonneg χ c _
            · intro j; exact sum_ind_le_one χ _
            · intro j hj
              apply sum_ind_eq_one
              have hjK : j ≤ P.K := (mem_Icc.mp hj).2
              have hnY' : n ≤ Y := by exact_mod_cast hnY
              have hpre := pre_bounds j p Pb hPb hp'
              have hlo : 1 ≤ P.b j * (pre j p * n) :=
                calc 1 = 1 * (1 * 1) := by ring
                  _ ≤ P.b j * (pre j p * n) :=
                    Nat.mul_le_mul (one_le_b P j) (Nat.mul_le_mul hpre.1 hn1)
              have hhi : P.b j * (pre j p * n) ≤ Mval P.r :=
                calc P.b j * (pre j p * n) ≤ P.b P.K * (Pb ^ P.K * Y) :=
                      Nat.mul_le_mul (b_mono P hjK) (Nat.mul_le_mul hpre.2 hnY')
                  _ = P.b P.K * Pb ^ P.K * Y := by ring
                  _ ≤ Mval P.r := hY
              constructor
              · exact_mod_cast hlo
              · exact_mod_cast hhi
          · simp only [if_neg hnY, mul_zero]
            exact Finset.sum_nonneg fun x _ => sum_ind_mul_nonneg χ _ _
  -- Step 4: combine
  have hsum1 : ∑ x ∈ pairs P.K, (iterAvg P.K (fun h : Fin P.K => P.Pr i (h + 1)) (fun p =>
        logAvg (Mval P.r) (fun n => ∑ c, xv P χ c x.1 p n * xv P χ c (x.1 + x.2 + 1) p n)) -
        (x.1 : ℝ) * ε) ≤
      ∑ x ∈ pairs P.K, ∑ c, Wexp P i x.1 x.2
        (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n) :=
    Finset.sum_le_sum fun x hx => by
      have := abs_le.mp (step1 x hx)
      linarith [this.2]
  rw [Finset.sum_sub_distrib] at hsum1
  have hsum2 : ∑ x ∈ pairs P.K, (x.1 : ℝ) * ε ≤ (P.K : ℝ) ^ 3 * ε := by
    calc ∑ x ∈ pairs P.K, (x.1 : ℝ) * ε ≤ ∑ x ∈ pairs P.K, (P.K : ℝ) * ε :=
          Finset.sum_le_sum fun x hx => by
            have h1 : x.1 ≤ P.K := by rw [mem_pairs] at hx; omega
            exact mul_le_mul_of_nonneg_right (by exact_mod_cast h1) hε
      _ = ((pairs P.K).card : ℝ) * ((P.K : ℝ) * ε) := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (P.K : ℝ) ^ 2 * ((P.K : ℝ) * ε) :=
          mul_le_mul_of_nonneg_right (card_pairs_le P.K) (by positivity)
      _ = (P.K : ℝ) ^ 3 * ε := by ring
  have : c₀ * (1 / 2) = ((P.K : ℝ) ^ 2 / P.r - 3 * P.K) / 4 := by rw [hc₀def]; ring
  linarith

/- ## Step 2: the small projections (GS (6.4) and Lemma 6.2) -/

/-- **Row bound, part 2.** -/
theorem row_corr (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i : ℕ) (η εsh c64 : ℝ)
    (hCor : Cor64With c64) (Pb : ℕ) (hPb : 1 ≤ Pb)
    (hM : 2 ≤ Mval P.r) (hη0 : 0 < η) (hη1 : η ≤ 1 / 64)
    (hwin : ∀ x ∈ pairs P.K, GoodSets (P.win i x.1 x.2))
    (hwinb : ∀ x ∈ pairs P.K, ∀ ℓ, ∀ p ∈ P.win i x.1 x.2 ℓ, p ≤ Pb)
    (hH1 : 1 ≤ P.H (i + 1) 0)
    (hcond : ∀ x ∈ pairs P.K, Real.log ((P.H (i + 1) 0 : ℝ) * (P.q x.1 (x.1 + x.2) : ℝ)) /
      Real.log (Mval P.r) < c64 * η ^ 2)
    (hsh : 2 * ((P.b P.K * Pb ^ P.K : ℕ) : ℝ) / P.H (i + 1) 0 ≤ εsh) :
    η / 8 * (∑ x ∈ pairs P.K, ∑ c, Wexp P i x.1 x.2
        (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n)) -
      ((pairs P.K).card : ℝ) * (P.r * (η ^ 2 / 8 + εsh)) ≤
      ∑ x ∈ pairs P.K, corr P χ i x.1 x.2 (fS P χ i x.1 x.2) := by
  have hM1 : 1 ≤ Mval P.r := by omega
  have hpair : ∀ x ∈ pairs P.K, η / 8 * (∑ c, Wexp P i x.1 x.2
        (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n)) -
      (P.r * (η ^ 2 / 8 + εsh)) ≤ corr P χ i x.1 x.2 (fS P χ i x.1 x.2) := by
    rintro ⟨a, k⟩ hx
    have hGSw := hwin _ hx
    have hwb := hwinb _ hx
    rw [mem_pairs] at hx
    obtain ⟨ha, hk, hak⟩ := hx
    dsimp only at hGSw hwb ⊢
    unfold corr
    have hc : ∀ c : Fin P.r, η / 8 * Wexp P i a k
        (fun n T => fa P χ a c n * gT P χ (a + k + 1) c T n) - (η ^ 2 / 8 + εsh) ≤
        Wexp P i a k (fun n T => fS P χ i a k c (n + (P.lam a (a + k + 1) : ℤ) * T) *
          gT P χ (a + k + 1) c T n) := by
      intro c
      -- GS (6.4)
      have hA : η / 8 * Wexp P i a k (fun n T => fa P χ a c n * gT P χ (a + k + 1) c T n) -
          η ^ 2 / 8 ≤ Wexp P i a k (fun n T => fS P χ i a k c n * gT P χ (a + k + 1) c T n) := by
        simp only [Wexp]
        have e : iterAvg (k + 1) (P.win i a k) (fun pp => η / 8 * logAvg (Mval P.r)
            (fun n => fa P χ a c n * gT P χ (a + k + 1) c (∏ ℓ, (pp ℓ : ℤ)) n) - η ^ 2 / 8) =
            η / 8 * iterAvg (k + 1) (P.win i a k) (fun pp => logAvg (Mval P.r)
            (fun n => fa P χ a c n * gT P χ (a + k + 1) c (∏ ℓ, (pp ℓ : ℤ)) n)) - η ^ 2 / 8 := by
          rw [iterAvg_sub, iterAvg_smul, iterAvg_const hGSw]
        rw [← e]
        apply iterAvg_mono hGSw
        intro pp
        exact hCor (Mval P.r) (P.q a (a + k)) (P.H (i + 1) 0) hM (one_le_q P _ _) hH1 η hη0 hη1
          (hcond (a, k) (by rw [mem_pairs]; omega)) (fa P χ a c)
          (fun n => gT P χ (a + k + 1) c (∏ ℓ, (pp ℓ : ℤ)) n)
          (fun n => ⟨ind_nonneg χ c _, ind_le_one χ c _⟩)
          (fun n => ⟨ind_nonneg χ c _, ind_le_one χ c _⟩)
      -- GS Lemma 6.2
      have hB : |Wexp P i a k (fun n T => fS P χ i a k c (n + (P.lam a (a + k + 1) : ℤ) * T) *
            gT P χ (a + k + 1) c T n) -
          Wexp P i a k (fun n T => fS P χ i a k c n * gT P χ (a + k + 1) c T n)| ≤ εsh := by
        simp only [Wexp]
        rw [← iterAvg_sub]
        apply abs_iterAvg_le_mem hGSw
        intro pp hpp
        rw [← logAvg_sub]
        apply abs_wavg_le_of_abs_le (goodWeights_logAvg hM1)
        intro n _
        beta_reduce
        rw [← sub_mul, abs_mul]
        set m : ℕ := P.V ^ (3 * 4 ^ (a + k) - 1) * ∏ ℓ, pp ℓ with hm
        have hshift := proj_shift (P.q a (a + k)) (P.H (i + 1) 0) hH1 (fa P χ a c)
          (fun n => abs_ind_le_one χ c _) (n : ℤ) m
        have hnm : ((n : ℕ) : ℤ) + (P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ) =
            (n : ℤ) + (P.q a (a + k) : ℤ) * (m : ℤ) := by
          rw [hm, lam_eq P a k hk]
          push_cast
          ring
        have hmle : (m : ℝ) ≤ ((P.b P.K * Pb ^ P.K : ℕ) : ℝ) := by
          have h1 : ∏ ℓ, pp ℓ ≤ Pb ^ (k + 1) := prod_le_pow pp Pb (fun ℓ => hwb ℓ _ (hpp ℓ))
          have h2 : Pb ^ (k + 1) ≤ Pb ^ P.K := Nat.pow_le_pow_right hPb (by omega)
          have : m ≤ P.b P.K * Pb ^ P.K := Nat.mul_le_mul (m0_le_bK P hak) (h1.trans h2)
          exact_mod_cast this
        have hHpos : (0 : ℝ) < P.H (i + 1) 0 := by exact_mod_cast hH1
        have hg : |gT P χ (a + k + 1) c (∏ ℓ, (pp ℓ : ℤ)) n| ≤ 1 := abs_ind_le_one χ c _
        calc |fS P χ i a k c ((n : ℤ) + (P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ)) -
              fS P χ i a k c n| * |gT P χ (a + k + 1) c (∏ ℓ, (pp ℓ : ℤ)) n|
            ≤ (2 * m / P.H (i + 1) 0) * 1 := by
              apply mul_le_mul _ hg (abs_nonneg _) (by positivity)
              rw [hnm]
              exact hshift
          _ ≤ εsh := by
              rw [mul_one]
              refine le_trans ?_ hsh
              apply div_le_div_of_nonneg_right _ hHpos.le
              linarith
      have := abs_le.mp hB
      linarith [this.1]
    calc η / 8 * ∑ c, Wexp P i a k (fun n T => fa P χ a c n * gT P χ (a + k + 1) c T n) -
          P.r * (η ^ 2 / 8 + εsh)
        = ∑ c : Fin P.r, (η / 8 * Wexp P i a k
            (fun n T => fa P χ a c n * gT P χ (a + k + 1) c T n) - (η ^ 2 / 8 + εsh)) := by
          rw [Finset.sum_sub_distrib, Finset.mul_sum, Finset.sum_const, card_univ,
            Fintype.card_fin, nsmul_eq_mul]
      _ ≤ _ := Finset.sum_le_sum fun c _ => hc c
  calc η / 8 * (∑ x ∈ pairs P.K, ∑ c, Wexp P i x.1 x.2
        (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n)) -
      ((pairs P.K).card : ℝ) * (P.r * (η ^ 2 / 8 + εsh))
      = ∑ x ∈ pairs P.K, (η / 8 * (∑ c, Wexp P i x.1 x.2
        (fun n T => fa P χ x.1 c n * gT P χ (x.1 + x.2 + 1) c T n)) -
        (P.r * (η ^ 2 / 8 + εsh))) := by
        rw [Finset.sum_sub_distrib, Finset.mul_sum, Finset.sum_const, nsmul_eq_mul]
    _ ≤ _ := Finset.sum_le_sum hpair

/- ## Step 3: parameter estimates -/

section numeric

/-- `H(x) = ⌊exp exp x⌋`, so that `H_{i,j} = H(L (4Ki + j))`. -/
noncomputable def HH (x : ℝ) : ℕ := ⌊Real.exp (Real.exp x)⌋₊

lemma H_eq (P : Par) (i j : ℕ) : P.H i j = HH ((P.L : ℝ) * (4 * P.K * i + j)) := rfl

lemma exp_sub_one_le (t : ℝ) (ht : 1 ≤ t) : Real.exp (t - 1) ≤ Real.exp t - 1 := by
  have h1 : Real.exp t = Real.exp (t - 1) * Real.exp 1 := by rw [← Real.exp_add]; ring_nf
  have h2 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have h3 : 1 ≤ Real.exp (t - 1) := Real.one_le_exp (by linarith)
  nlinarith

lemma HH_le (x : ℝ) : (HH x : ℝ) ≤ Real.exp (Real.exp x) := Nat.floor_le (Real.exp_pos _).le

lemma HH_gt (x : ℝ) : Real.exp (Real.exp x) - 1 < HH x := by
  have := Nat.lt_floor_add_one (Real.exp (Real.exp x))
  unfold HH
  linarith

lemma HH_mono {x y : ℝ} (h : x ≤ y) : HH x ≤ HH y :=
  Nat.floor_le_floor (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr h))

lemma exp_le_HH (x : ℝ) (hx : 0 ≤ x) : Real.exp (Real.exp x - 1) ≤ HH x := by
  have h1 : 1 ≤ Real.exp x := Real.one_le_exp hx
  have := exp_sub_one_le (Real.exp x) h1
  linarith [HH_gt x]

lemma HH_pos (x : ℝ) (hx : 0 ≤ x) : (0 : ℝ) < HH x :=
  lt_of_lt_of_le (Real.exp_pos _) (exp_le_HH x hx)

lemma log_HH_le (x : ℝ) (hx : 0 ≤ x) : Real.log (HH x) ≤ Real.exp x := by
  rw [Real.log_le_iff_le_exp (HH_pos x hx)]
  exact HH_le x

lemma log_HH_ge (x : ℝ) (hx : 0 ≤ x) : Real.exp x - 1 ≤ Real.log (HH x) := by
  rw [Real.le_log_iff_exp_le (HH_pos x hx)]
  exact exp_le_HH x hx

lemma loglog_HH_le (x : ℝ) (hx : 1 ≤ x) : Real.log (Real.log (HH x)) ≤ x := by
  have h1 : Real.exp (x - 1) ≤ Real.exp x - 1 := exp_sub_one_le x hx
  have h2 := log_HH_ge x (by linarith)
  have h3 : 0 < Real.log (HH x) := lt_of_lt_of_le (Real.exp_pos _) (h1.trans h2)
  rw [Real.log_le_iff_le_exp h3]
  exact log_HH_le x (by linarith)

lemma loglog_HH_ge (x : ℝ) (hx : 1 ≤ x) : x - 1 ≤ Real.log (Real.log (HH x)) := by
  have h1 : Real.exp (x - 1) ≤ Real.exp x - 1 := exp_sub_one_le x hx
  have h2 := log_HH_ge x (by linarith)
  rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) (h1.trans h2))]
  exact h1.trans h2

lemma HH_ge_three (x : ℝ) (hx : 1 ≤ x) : 3 ≤ HH x := by
  have h1 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have h2 : Real.exp 1 ≤ Real.exp x := Real.exp_le_exp.mpr hx
  have h3 : Real.exp 2 ≤ Real.exp (Real.exp x) := Real.exp_le_exp.mpr (by linarith)
  have h4 : 5 ≤ Real.exp 2 := by
    have := Real.quadratic_le_exp_of_nonneg (x := 2) (by norm_num)
    linarith
  have h5 := HH_gt x
  have h6 : (2 : ℝ) < HH x := by linarith
  have h7 : 2 < HH x := by exact_mod_cast h6
  omega

lemma K_real (P : Par) : (P.K : ℝ) = (P.r : ℝ) ^ 7 := by simp [Par.K]
lemma T_real (P : Par) : (P.T : ℝ) = (P.r : ℝ) ^ 7 := by simp [Par.T]
lemma L_real (P : Par) : (P.L : ℝ) = (P.r : ℝ) ^ 28 := by simp [Par.L]

/-- `Λ = 4^K (d^C)²`, an upper bound for `log b_K`. -/
noncomputable def Lam (P : Par) : ℝ := (4 : ℝ) ^ P.K * ((P.d : ℝ) ^ P.C) ^ 2

lemma V_le_exp (P : Par) : (P.V : ℝ) ≤ Real.exp (((P.d : ℝ) ^ P.C) ^ 2) := by
  set D : ℕ := P.d ^ P.C with hD
  have h1 : P.V ≤ D ^ D := Nat.factorial_le_pow D
  have h3 : (D : ℝ) ≤ Real.exp D := by linarith [Real.add_one_le_exp (D : ℝ)]
  have hD' : ((P.d : ℝ) ^ P.C) = (D : ℝ) := by rw [hD]; push_cast; ring
  rw [hD']
  calc (P.V : ℝ) ≤ ((D ^ D : ℕ) : ℝ) := by exact_mod_cast h1
    _ = (D : ℝ) ^ D := by push_cast; ring
    _ ≤ (Real.exp D) ^ D := pow_le_pow_left₀ (Nat.cast_nonneg _) h3 D
    _ = Real.exp ((D : ℝ) ^ 2) := by rw [← Real.exp_nat_mul]; ring_nf

lemma bK_le_exp (P : Par) : (P.b P.K : ℝ) ≤ Real.exp (Lam P) := by
  unfold Par.b Lam
  push_cast
  calc (P.V : ℝ) ^ (4 ^ P.K) ≤ (Real.exp (((P.d : ℝ) ^ P.C) ^ 2)) ^ (4 ^ P.K) :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) (V_le_exp P) _
    _ = Real.exp ((4 : ℝ) ^ P.K * ((P.d : ℝ) ^ P.C) ^ 2) := by
        rw [← Real.exp_nat_mul]; push_cast; ring_nf

lemma Lam_nonneg (P : Par) : 0 ≤ Lam P := by unfold Lam; positivity

lemma Mval_ge (r : ℕ) : Real.exp (Real.exp ((r : ℝ) ^ 43)) ≤ Mval r := Nat.le_ceil _

lemma two_le_Mval (r : ℕ) : 2 ≤ Mval r := by
  have h1 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have h2 : 1 ≤ Real.exp ((r : ℝ) ^ 43) := Real.one_le_exp (by positivity)
  have h3 : Real.exp 1 ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) := Real.exp_le_exp.mpr h2
  have h4 : (2 : ℝ) ≤ Mval r := by linarith [Mval_ge r]
  exact_mod_cast h4

lemma log_Mval_ge (r : ℕ) : Real.exp ((r : ℝ) ^ 43) ≤ Real.log (Mval r) := by
  have hpos : (0 : ℝ) < Mval r := by have := two_le_Mval r; positivity
  rw [Real.le_log_iff_exp_le hpos]
  exact Mval_ge r

lemma log_Mval_le (r : ℕ) : Real.log (Mval r) ≤ Real.exp ((r : ℝ) ^ 43) + 1 := by
  have hpos : (0 : ℝ) < Mval r := by have := two_le_Mval r; positivity
  rw [Real.log_le_iff_le_exp hpos, Real.exp_add]
  have h1 : (Mval r : ℝ) < Real.exp (Real.exp ((r : ℝ) ^ 43)) + 1 :=
    Nat.ceil_lt_add_one (Real.exp_pos _).le
  have h2 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have h3 : 1 ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) := Real.one_le_exp (Real.exp_pos _).le
  nlinarith

/-- The Mertens lower bound for the prime sets `𝒫_{i,h}`, `h ≥ 1`. -/
lemma Pr_sum_ge (P : Par) (CM : ℝ) (hM : MertensLowerWith CM) (hr : 1 ≤ P.r) (i h : ℕ)
    (hh : 1 ≤ h) : (P.L : ℝ) - 1 - CM ≤ ∑ p ∈ P.Pr i h, (1 : ℝ) / p := by
  have hL1 : (1 : ℝ) ≤ P.L := by
    rw [L_real]; exact one_le_pow₀ (by exact_mod_cast hr)
  have hK0 : (0 : ℝ) ≤ P.K := Nat.cast_nonneg _
  have hi0 : (0 : ℝ) ≤ i := Nat.cast_nonneg _
  have hc : ((2 * h - 1 : ℕ) : ℝ) = 2 * h - 1 := by
    rw [Nat.cast_sub (by omega)]; push_cast; ring
  have hc2 : ((2 * h : ℕ) : ℝ) = 2 * h := by push_cast; ring
  have hh1 : (1 : ℝ) ≤ h := by exact_mod_cast hh
  have hA : P.H i (2 * h - 1) = HH ((P.L : ℝ) * (4 * P.K * i + ((2 * h - 1 : ℕ) : ℝ))) := rfl
  have hB : P.H i (2 * h) = HH ((P.L : ℝ) * (4 * P.K * i + ((2 * h : ℕ) : ℝ))) := rfl
  have h4 : (1 : ℝ) ≤ 4 * P.K * i + (2 * h - 1) := by nlinarith [mul_nonneg hK0 hi0]
  have hxA1 : 1 ≤ (P.L : ℝ) * (4 * P.K * i + ((2 * h - 1 : ℕ) : ℝ)) := by
    rw [hc]
    calc (1 : ℝ) = 1 * 1 := by ring
      _ ≤ (P.L : ℝ) * (4 * P.K * i + (2 * h - 1)) := mul_le_mul hL1 h4 zero_le_one (by linarith)
  have hxAB : (P.L : ℝ) * (4 * P.K * i + ((2 * h : ℕ) : ℝ)) =
      (P.L : ℝ) * (4 * P.K * i + ((2 * h - 1 : ℕ) : ℝ)) + P.L := by
    rw [hc, hc2]; ring
  have h3 : 3 ≤ P.H i (2 * h - 1) := by rw [hA]; exact HH_ge_three _ hxA1
  have hAB : P.H i (2 * h - 1) ≤ P.H i (2 * h) := by
    rw [hA, hB]; exact HH_mono (by rw [hxAB]; linarith)
  have hmert := hM _ _ h3 hAB
  have e1 : Real.log (Real.log (P.H i (2 * h - 1))) ≤
      (P.L : ℝ) * (4 * P.K * i + ((2 * h - 1 : ℕ) : ℝ)) := by
    rw [hA]; exact loglog_HH_le _ hxA1
  have e2 : (P.L : ℝ) * (4 * P.K * i + ((2 * h : ℕ) : ℝ)) - 1 ≤
      Real.log (Real.log (P.H i (2 * h))) := by
    rw [hB]; exact loglog_HH_ge _ (by rw [hxAB]; linarith)
  unfold Par.Pr
  linarith

lemma Pr_sub (P : Par) (i h : ℕ) (hhK : h ≤ P.K) :
    ∀ p ∈ P.Pr i h, p.Prime ∧ p ≤ P.H i (2 * P.K) := by
  intro p hp
  unfold Par.Pr primesIn at hp
  rw [mem_filter, mem_Ico] at hp
  refine ⟨hp.2, ?_⟩
  have : P.H i (2 * h) ≤ P.H i (2 * P.K) := HH_mono (by
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
    have : ((2 * h : ℕ) : ℝ) ≤ ((2 * P.K : ℕ) : ℝ) := by exact_mod_cast (by omega)
    linarith)
  omega

/-- The numerical facts about `r` used in the row bound (all true for large `r`). -/
structure NumFacts (P : Par) (CA5 c64 CM : ℝ) : Prop where
  r2 : 2 ≤ P.r
  f1 : 14 + 16 * CA5 ≤ (P.r : ℝ) ^ 6
  f2 : 4 * (1 + CM) ≤ 3 * (P.r : ℝ) ^ 28
  f3 : Lam P + (P.r : ℝ) ^ 7 * Real.exp (4 * (P.r : ℝ) ^ 42) + 1 ≤
    Real.exp ((P.r : ℝ) ^ 43) / 2
  f4 : 16384 * (P.r : ℝ) ^ 4 + Lam P + 1 + (P.r : ℝ) ^ 7 ≤ Real.exp (2 * (P.r : ℝ) ^ 35)
  f5 : 4096 * (P.r : ℝ) ^ 4 * (Real.exp (4 * (P.r : ℝ) ^ 42) + Lam P) <
    c64 * Real.exp ((P.r : ℝ) ^ 43)
  f6 : CA5 * (P.r : ℝ) ^ 14 * Real.exp (4 * (P.r : ℝ) ^ 42) ≤ Real.exp ((P.r : ℝ) ^ 43)

end numeric

/- ## Numerical lemmas for one row -/

/-- `x_{i,j} = L (4Ki + j)`, so that `H_{i,j} = ⌊exp exp x_{i,j}⌋`. -/
noncomputable def xH (P : Par) (i j : ℕ) : ℝ := (P.L : ℝ) * (4 * P.K * i + j)

lemma H_eq' (P : Par) (i j : ℕ) : P.H i j = HH (xH P i j) := rfl

lemma x_bounds (R i : ℝ) (hR : 1 ≤ R) (hi1 : 1 ≤ i) (hi : i + 1 ≤ R ^ 7) :
    1 ≤ R ^ 28 * (4 * R ^ 7 * i + 2 * R ^ 7) ∧ R ^ 28 * (4 * R ^ 7 * i + 2 * R ^ 7) ≤ 4 * R ^ 42 ∧
    R ^ 28 * (4 * R ^ 7 * (i + 1)) ≤ 4 * R ^ 42 := by
  have h7 : 1 ≤ R ^ 7 := one_le_pow₀ hR
  have h28 : 1 ≤ R ^ 28 := one_le_pow₀ hR
  have h4 : 4 * R ^ 7 * (i + 1) ≤ 4 * R ^ 7 * R ^ 7 :=
    mul_le_mul_of_nonneg_left hi (by positivity)
  refine ⟨?_, ?_, ?_⟩
  · have h1 : 1 ≤ 4 * R ^ 7 * i + 2 * R ^ 7 := by nlinarith
    nlinarith
  · have h1 : 4 * R ^ 7 * i + 2 * R ^ 7 ≤ 4 * R ^ 7 * R ^ 7 := by nlinarith
    calc R ^ 28 * (4 * R ^ 7 * i + 2 * R ^ 7) ≤ R ^ 28 * (4 * R ^ 7 * R ^ 7) :=
          mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = 4 * R ^ 42 := by ring
  · calc R ^ 28 * (4 * R ^ 7 * (i + 1)) ≤ R ^ 28 * (4 * R ^ 7 * R ^ 7) :=
          mul_le_mul_of_nonneg_left h4 (by positivity)
      _ = 4 * R ^ 42 := by ring

lemma xH_facts (P : Par) (hr : 1 ≤ P.r) (i : ℕ) (hi1 : 1 ≤ i) (hiT : i + 1 ≤ P.T) :
    1 ≤ xH P i (2 * P.K) ∧ xH P i (2 * P.K) ≤ 4 * (P.r : ℝ) ^ 42 ∧
    xH P (i + 1) 0 = xH P i (2 * P.K) + 2 * (P.r : ℝ) ^ 35 ∧
    xH P (i + 1) 0 ≤ 4 * (P.r : ℝ) ^ 42 := by
  have hR : (1 : ℝ) ≤ P.r := by exact_mod_cast hr
  have hi : (i : ℝ) + 1 ≤ (P.r : ℝ) ^ 7 := by rw [← T_real P]; exact_mod_cast hiT
  have hi1' : (1 : ℝ) ≤ i := by exact_mod_cast hi1
  have e1 : xH P i (2 * P.K) = (P.r : ℝ) ^ 28 * (4 * (P.r : ℝ) ^ 7 * i + 2 * (P.r : ℝ) ^ 7) := by
    unfold xH; push_cast; simp only [L_real, K_real]; try ring
  have e2 : xH P (i + 1) 0 = (P.r : ℝ) ^ 28 * (4 * (P.r : ℝ) ^ 7 * (i + 1)) := by
    unfold xH; push_cast; simp only [L_real, K_real]; try ring
  obtain ⟨b1, b2, b3⟩ := x_bounds (P.r : ℝ) i hR hi1' hi
  refine ⟨by linarith, by linarith, ?_, by linarith⟩
  rw [e1, e2]; ring

/-- The row sets: Mertens, non-emptiness, and the bound `p ≤ H_{i,2K}`. -/
lemma row_sets (P : Par) (CM : ℝ) (hr : 1 ≤ P.r) (hM : MertensLowerWith CM)
    (hf2 : 4 * (1 + CM) ≤ 3 * (P.r : ℝ) ^ 28) (i : ℕ) (h : Fin P.K) :
    (P.r : ℝ) ^ 28 / 4 ≤ ∑ p ∈ P.Pr i (h + 1), (1 : ℝ) / p ∧ (P.Pr i (h + 1)).Nonempty ∧
    ∀ p ∈ P.Pr i (h + 1), p.Prime ∧ 1 ≤ p ∧ p ≤ P.H i (2 * P.K) := by
  have h1 := Pr_sum_ge P CM hM hr i (h + 1) (by omega)
  rw [L_real] at h1
  have hs : (P.r : ℝ) ^ 28 / 4 ≤ ∑ p ∈ P.Pr i (h + 1), (1 : ℝ) / p := by linarith
  refine ⟨hs, ?_, ?_⟩
  · by_contra hne
    rw [Finset.not_nonempty_iff_eq_empty] at hne
    rw [hne, Finset.sum_empty] at hs
    have hR0 : (0 : ℝ) < P.r := by exact_mod_cast hr
    have : (0 : ℝ) < (P.r : ℝ) ^ 28 / 4 := by positivity
    linarith
  · intro p hp
    have := Pr_sub P i (h + 1) (by omega) p hp
    exact ⟨this.1, this.1.one_lt.le, this.2⟩

/-- The Elliott error for one row set. -/
lemma row_elliott (P : Par) (CA5 : ℝ) (hr : 1 ≤ P.r) (hCA5 : 0 ≤ CA5)
    (hA5 : LemmaA5With CA5)
    (hf6 : CA5 * (P.r : ℝ) ^ 14 * Real.exp (4 * (P.r : ℝ) ^ 42) ≤ Real.exp ((P.r : ℝ) ^ 43))
    (S : Finset ℕ) (Pb : ℕ) (hPb : 2 ≤ Pb) (hS : S.Nonempty) (hSp : ∀ p ∈ S, p.Prime ∧ p ≤ Pb)
    (hs : (P.r : ℝ) ^ 28 / 4 ≤ ∑ p ∈ S, (1 : ℝ) / p)
    (hlogPb : Real.log Pb ≤ Real.exp (4 * (P.r : ℝ) ^ 42)) :
    ElliottOK (Mval P.r) ((2 * CA5 + 1) / (P.r : ℝ) ^ 14) S := by
  intro f hf
  have hlogM := log_Mval_ge P.r
  have hA := hA5 (Mval P.r) Pb (two_le_Mval P.r) hPb S hS hSp f hf
  refine hA.trans ?_
  have hR0 : (0 : ℝ) < P.r := by exact_mod_cast hr
  generalize (P.r : ℝ) = R at hR0 hf6 hs hlogPb hlogM ⊢
  have hs0 : 0 ≤ ∑ p ∈ S, (1 : ℝ) / p := le_trans (by positivity) hs
  have hsqrt : R ^ 14 / 2 ≤ Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) := by
    rw [Real.le_sqrt (by positivity) hs0]
    calc (R ^ 14 / 2) ^ 2 = R ^ 28 / 4 := by ring
      _ ≤ _ := hs
  have t1 : CA5 * (Real.log Pb / Real.log (Mval P.r)) ≤ 1 / R ^ 14 := by
    have h1 : Real.log Pb / Real.log (Mval P.r) ≤ Real.exp (4 * R ^ 42) / Real.exp (R ^ 43) :=
      div_le_div₀ (Real.exp_pos _).le hlogPb (Real.exp_pos _) hlogM
    have h2 : CA5 * (Real.exp (4 * R ^ 42) / Real.exp (R ^ 43)) ≤ 1 / R ^ 14 := by
      rw [mul_div_assoc', div_le_div_iff₀ (Real.exp_pos _) (by positivity)]
      linarith
    exact (mul_le_mul_of_nonneg_left h1 hCA5).trans h2
  have t2 : CA5 / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) ≤ 2 * CA5 / R ^ 14 := by
    calc CA5 / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) ≤ CA5 / (R ^ 14 / 2) :=
          div_le_div_of_nonneg_left hCA5 (by positivity) hsqrt
      _ = 2 * CA5 / R ^ 14 := by field_simp
  calc _ ≤ 1 / R ^ 14 + 2 * CA5 / R ^ 14 := add_le_add t1 t2
    _ = (2 * CA5 + 1) / R ^ 14 := by ring

/-- The threshold `Y` for the exceptional `n`. -/
lemma row_Y (P : Par) (Pb : ℕ)
    (hPbexp : (Pb : ℝ) ≤ Real.exp (Real.exp (4 * (P.r : ℝ) ^ 42)))
    (hf3 : Lam P + (P.r : ℝ) ^ 7 * Real.exp (4 * (P.r : ℝ) ^ 42) + 1 ≤
      Real.exp ((P.r : ℝ) ^ 43) / 2) :
    P.b P.K * Pb ^ P.K * ⌊Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1)⌋₊ ≤ Mval P.r ∧
    1 + Real.log (Mval P.r) ≤
      2 * Real.log ((⌊Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1)⌋₊ : ℕ) + 1) := by
  have hlogM' := log_Mval_le P.r
  have hMge := Mval_ge P.r
  have hb := bK_le_exp P
  have hK := K_real P
  have hYle : ((⌊Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1)⌋₊ : ℕ) : ℝ) ≤
      Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1) := Nat.floor_le (Real.exp_pos _).le
  have hYgt : Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1) <
      ((⌊Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1)⌋₊ : ℕ) : ℝ) + 1 := Nat.lt_floor_add_one _
  generalize ⌊Real.exp (Real.exp ((P.r : ℝ) ^ 43) / 2 + 1)⌋₊ = Y at hYle hYgt ⊢
  generalize (P.r : ℝ) = R at hPbexp hf3 hlogM' hMge hK hYle hYgt ⊢
  constructor
  · have h2 : (Pb : ℝ) ^ P.K ≤ Real.exp (R ^ 7 * Real.exp (4 * R ^ 42)) := by
      calc (Pb : ℝ) ^ P.K ≤ (Real.exp (Real.exp (4 * R ^ 42))) ^ P.K :=
            pow_le_pow_left₀ (Nat.cast_nonneg _) hPbexp _
        _ = Real.exp (R ^ 7 * Real.exp (4 * R ^ 42)) := by rw [← Real.exp_nat_mul, hK]
    have h3 : ((P.b P.K * Pb ^ P.K * Y : ℕ) : ℝ) ≤ Real.exp (Real.exp (R ^ 43)) := by
      push_cast
      calc (P.b P.K : ℝ) * (Pb : ℝ) ^ P.K * (Y : ℝ) ≤ Real.exp (Lam P) *
            Real.exp (R ^ 7 * Real.exp (4 * R ^ 42)) * Real.exp (Real.exp (R ^ 43) / 2 + 1) := by
            gcongr
        _ = Real.exp (Lam P + R ^ 7 * Real.exp (4 * R ^ 42) + (Real.exp (R ^ 43) / 2 + 1)) := by
            rw [Real.exp_add (Lam P + R ^ 7 * Real.exp (4 * R ^ 42)), Real.exp_add (Lam P)]
        _ ≤ Real.exp (Real.exp (R ^ 43)) := Real.exp_le_exp.mpr (by linarith)
    exact_mod_cast h3.trans hMge
  · have : Real.exp (R ^ 43) / 2 + 1 ≤ Real.log ((Y : ℝ) + 1) := by
      rw [Real.le_log_iff_exp_le (by positivity)]
      exact hYgt.le
    linarith

/-- The condition `log(H q)/log M < c η²` of GS (6.4). -/
lemma row_cond (P : Par) (c64 : ℝ) (hr : 1 ≤ P.r) (i a k : ℕ) (hak : a + k + 1 ≤ P.K)
    (hHq1 : 1 ≤ P.H (i + 1) 0)
    (hlogH : Real.log (P.H (i + 1) 0) ≤ Real.exp (4 * (P.r : ℝ) ^ 42))
    (hf5 : 4096 * (P.r : ℝ) ^ 4 * (Real.exp (4 * (P.r : ℝ) ^ 42) + Lam P) <
      c64 * Real.exp ((P.r : ℝ) ^ 43)) :
    Real.log ((P.H (i + 1) 0 : ℝ) * (P.q a (a + k) : ℝ)) / Real.log (Mval P.r) <
      c64 * (1 / (64 * (P.r : ℝ) ^ 2)) ^ 2 := by
  have hlogM := log_Mval_ge P.r
  have hq1 : (1 : ℝ) ≤ P.q a (a + k) := by exact_mod_cast one_le_q P _ _
  have hHq1' : (1 : ℝ) ≤ P.H (i + 1) 0 := by exact_mod_cast hHq1
  have hlogq : Real.log (P.q a (a + k)) ≤ Lam P := by
    rw [Real.log_le_iff_le_exp (by linarith)]
    calc (P.q a (a + k) : ℝ) ≤ P.b P.K := by exact_mod_cast q_le_bK P hak
      _ ≤ Real.exp (Lam P) := bK_le_exp P
  have hnum : Real.log ((P.H (i + 1) 0 : ℝ) * (P.q a (a + k) : ℝ)) ≤
      Real.exp (4 * (P.r : ℝ) ^ 42) + Lam P := by
    have := Real.log_mul (x := (P.H (i + 1) 0 : ℝ)) (y := (P.q a (a + k) : ℝ))
      (ne_of_gt (by linarith)) (ne_of_gt (by linarith))
    linarith
  have hnum0 : 0 ≤ Real.log ((P.H (i + 1) 0 : ℝ) * (P.q a (a + k) : ℝ)) :=
    Real.log_nonneg (by nlinarith)
  have hR0 : (0 : ℝ) < P.r := by exact_mod_cast hr
  generalize (P.r : ℝ) = R at hR0 hf5 hnum hlogM ⊢
  calc Real.log ((P.H (i + 1) 0 : ℝ) * (P.q a (a + k) : ℝ)) / Real.log (Mval P.r)
      ≤ (Real.exp (4 * R ^ 42) + Lam P) / Real.exp (R ^ 43) :=
        div_le_div₀ (by linarith) hnum (Real.exp_pos _) hlogM
    _ < c64 * (1 / (64 * R ^ 2)) ^ 2 := by
        rw [div_lt_iff₀ (Real.exp_pos _)]
        have e : c64 * (1 / (64 * R ^ 2)) ^ 2 * Real.exp (R ^ 43) =
            c64 * Real.exp (R ^ 43) / (4096 * R ^ 4) := by
          field_simp; ring
        rw [e, lt_div_iff₀ (by positivity)]
        linarith

/-- The shift error `2 m / H_{i+1,0}`. -/
lemma row_shift (P : Par) (Pb Hq : ℕ) (hr : 1 ≤ P.r) (u : ℝ) (hu1 : 1 ≤ u)
    (hPbexp : (Pb : ℝ) ≤ Real.exp u)
    (hHq : Real.exp (u * Real.exp (2 * (P.r : ℝ) ^ 35) - 1) ≤ Hq)
    (hf4 : 16384 * (P.r : ℝ) ^ 4 + Lam P + 1 + (P.r : ℝ) ^ 7 ≤ Real.exp (2 * (P.r : ℝ) ^ 35)) :
    2 * ((P.b P.K * Pb ^ P.K : ℕ) : ℝ) / Hq ≤ 1 / (8192 * (P.r : ℝ) ^ 4) := by
  have hb := bK_le_exp P
  have hK := K_real P
  have hLam0 := Lam_nonneg P
  have hR0 : (0 : ℝ) < P.r := by exact_mod_cast hr
  generalize (P.r : ℝ) = R at hR0 hHq hf4 hK ⊢
  have hHqpos : (0 : ℝ) < Hq := lt_of_lt_of_le (Real.exp_pos _) hHq
  have hnum : 16384 * R ^ 4 * ((P.b P.K * Pb ^ P.K : ℕ) : ℝ) ≤
      Real.exp (16384 * R ^ 4 + Lam P + R ^ 7 * u) := by
    push_cast
    have h1 : 16384 * R ^ 4 ≤ Real.exp (16384 * R ^ 4) := by
      linarith [Real.add_one_le_exp (16384 * R ^ 4)]
    have h3 : (Pb : ℝ) ^ P.K ≤ Real.exp (R ^ 7 * u) := by
      calc (Pb : ℝ) ^ P.K ≤ (Real.exp u) ^ P.K := pow_le_pow_left₀ (Nat.cast_nonneg _) hPbexp _
        _ = Real.exp (R ^ 7 * u) := by rw [← Real.exp_nat_mul, hK]
    calc 16384 * R ^ 4 * ((P.b P.K : ℝ) * (Pb : ℝ) ^ P.K) ≤
          Real.exp (16384 * R ^ 4) * (Real.exp (Lam P) * Real.exp (R ^ 7 * u)) := by
          gcongr
      _ = Real.exp (16384 * R ^ 4 + Lam P + R ^ 7 * u) := by
          rw [Real.exp_add (16384 * R ^ 4 + Lam P), Real.exp_add (16384 * R ^ 4)]; ring
  have hexp : 16384 * R ^ 4 + Lam P + R ^ 7 * u ≤ u * Real.exp (2 * R ^ 35) - 1 := by
    have hR4 : 0 ≤ R ^ 4 := by positivity
    have h7 : 0 ≤ Real.exp (2 * R ^ 35) - R ^ 7 := by linarith
    nlinarith [mul_le_mul_of_nonneg_left hu1 h7]
  have key : 16384 * R ^ 4 * ((P.b P.K * Pb ^ P.K : ℕ) : ℝ) ≤ Hq :=
    hnum.trans ((Real.exp_le_exp.mpr hexp).trans hHq)
  rw [div_le_div_iff₀ hHqpos (by positivity)]
  linarith

lemma sigma_arith (R KK CA5 ε Sg : ℝ) (hR : 0 < R) (hK : KK = R ^ 7)
    (hε : ε = (2 * CA5 + 1) / R ^ 14) (hf1 : 14 + 16 * CA5 ≤ R ^ 6)
    (hSg : (KK ^ 2 / R - 3 * KK) / 4 - KK ^ 3 * ε ≤ Sg) : R ^ 13 / 8 ≤ Sg := by
  have e1 : KK ^ 2 / R - 3 * KK = R ^ 13 - 3 * R ^ 7 := by
    rw [hK]; field_simp; try ring
  have e2 : KK ^ 3 * ε = (2 * CA5 + 1) * R ^ 7 := by
    rw [hK, hε]; field_simp; try ring
  have e3 : (14 + 16 * CA5) * R ^ 7 ≤ R ^ 13 := by
    calc (14 + 16 * CA5) * R ^ 7 ≤ R ^ 6 * R ^ 7 :=
          mul_le_mul_of_nonneg_right hf1 (by positivity)
      _ = R ^ 13 := by ring
  rw [e1, e2] at hSg
  linarith

lemma c0_nonneg (R KK : ℝ) (hR : 0 < R) (hK : KK = R ^ 7) (h6 : 3 ≤ R ^ 6) :
    0 ≤ KK ^ 2 / R - 3 * KK := by
  have e1 : KK ^ 2 / R - 3 * KK = R ^ 7 * (R ^ 6 - 3) := by
    rw [hK]; field_simp; try ring
  rw [e1]
  have : 0 ≤ R ^ 6 - 3 := by linarith
  positivity

lemma final_row_arith (R KK Sg cardp Cr : ℝ) (hR : 0 < R) (hK : KK = R ^ 7)
    (hSg : R ^ 13 / 8 ≤ Sg) (hcard : cardp ≤ KK ^ 2)
    (hC : 1 / (64 * R ^ 2) / 8 * Sg -
      cardp * (R * ((1 / (64 * R ^ 2)) ^ 2 / 8 + 1 / (8192 * R ^ 4))) ≤ Cr) :
    KK ^ 2 / (2 ^ 15 * R ^ 3) ≤ Cr := by
  have e4 : R * ((1 / (64 * R ^ 2)) ^ 2 / 8 + 1 / (8192 * R ^ 4)) = 5 / (32768 * R ^ 3) := by
    field_simp; ring
  have e5 : KK ^ 2 / (2 ^ 15 * R ^ 3) = R ^ 11 / 32768 := by
    rw [hK]; field_simp; try ring
  have e6 : 1 / (64 * R ^ 2) / 8 * (R ^ 13 / 8) = R ^ 11 / 4096 := by
    field_simp; ring
  have e7 : KK ^ 2 * (5 / (32768 * R ^ 3)) = 5 * R ^ 11 / 32768 := by
    rw [hK]; field_simp; try ring
  have h1 : 1 / (64 * R ^ 2) / 8 * (R ^ 13 / 8) ≤ 1 / (64 * R ^ 2) / 8 * Sg :=
    mul_le_mul_of_nonneg_left hSg (by positivity)
  have h2 : cardp * (5 / (32768 * R ^ 3)) ≤ KK ^ 2 * (5 / (32768 * R ^ 3)) :=
    mul_le_mul_of_nonneg_right hcard (by positivity)
  rw [e4] at hC
  rw [e6] at h1
  rw [e7] at h2
  rw [e5]
  have hR11 : 0 ≤ R ^ 11 := by positivity
  linarith

/- ## The row bound -/

/-- **The row bound (★)**: for a row `i ∈ [1, t - 1]`,
`∑_{(a,k)} corr_{(i,a,k)}(P^s f) ≥ K² / (2¹⁵ r³)`. -/
theorem row_main (P : Par) (CA5 : ℝ) (hCA5 : 0 ≤ CA5) (hA5 : LemmaA5With CA5)
    (c64 : ℝ) (hCor : Cor64With c64) (CM : ℝ)
    (hM : MertensLowerWith CM) (hN : NumFacts P CA5 c64 CM)
    (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i : ℕ) (hi1 : 1 ≤ i) (hiT : i + 1 ≤ P.T) :
    (P.K : ℝ) ^ 2 / (2 ^ 15 * (P.r : ℝ) ^ 3) ≤
      ∑ x ∈ pairs P.K, corr P χ i x.1 x.2 (fS P χ i x.1 x.2) := by
  have hr : 1 ≤ P.r := by have := hN.r2; omega
  have hR0 : (0 : ℝ) < P.r := by exact_mod_cast hr
  have hM2 := two_le_Mval P.r
  obtain ⟨hx1, hx2, hx3, hx4⟩ := xH_facts P hr i hi1 hiT
  -- the prime bound `Pb = H_{i,2K}`
  have hPbHH : P.H i (2 * P.K) = HH (xH P i (2 * P.K)) := rfl
  have hPb3 : 3 ≤ P.H i (2 * P.K) := le_of_le_of_eq (HH_ge_three _ hx1) hPbHH.symm
  have hlogPb : Real.log (P.H i (2 * P.K)) ≤ Real.exp (4 * (P.r : ℝ) ^ 42) := by
    have h1 : Real.log (P.H i (2 * P.K)) ≤ Real.exp (xH P i (2 * P.K)) := by
      have := log_HH_le (xH P i (2 * P.K)) (by linarith)
      exact le_of_eq_of_le (by rw [hPbHH]) this
    exact h1.trans (Real.exp_le_exp.mpr hx2)
  have hPbexp : (P.H i (2 * P.K) : ℝ) ≤ Real.exp (Real.exp (xH P i (2 * P.K))) :=
    le_of_eq_of_le (by rw [hPbHH]) (HH_le _)
  have hPbexp' : (P.H i (2 * P.K) : ℝ) ≤ Real.exp (Real.exp (4 * (P.r : ℝ) ^ 42)) :=
    hPbexp.trans (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr hx2))
  -- the row sets and the Elliott error
  have hrs := row_sets P CM hr hM hN.f2 i
  have hSets : ∀ h : Fin P.K, (P.Pr i (h + 1)).Nonempty ∧
      ∀ p ∈ P.Pr i (h + 1), 1 ≤ p ∧ p ≤ P.H i (2 * P.K) :=
    fun h => ⟨(hrs h).2.1, fun p hp => ((hrs h).2.2 p hp).2⟩
  have hEll : ∀ h : Fin P.K,
      ElliottOK (Mval P.r) ((2 * CA5 + 1) / (P.r : ℝ) ^ 14) (P.Pr i (h + 1)) := fun h =>
    row_elliott P CA5 hr hCA5 hA5 hN.f6 _ (P.H i (2 * P.K)) (by omega) (hrs h).2.1
      (fun p hp => ⟨((hrs h).2.2 p hp).1, ((hrs h).2.2 p hp).2.2⟩) (hrs h).1 hlogPb
  -- the threshold `Y`
  obtain ⟨hY, hYlog⟩ := row_Y P (P.H i (2 * P.K)) hPbexp' hN.f3
  -- the lower bound for `Σ_row`
  have hc0 := c0_nonneg (P.r : ℝ) (P.K : ℝ) hR0 (K_real P) (by linarith [hN.f1])
  have hSg := row_sigma P χ i ((2 * CA5 + 1) / (P.r : ℝ) ^ 14) _ (P.H i (2 * P.K)) hr
    (by positivity) (by omega) (by omega) hSets hEll hY hYlog hc0
  have hSg' := sigma_arith (P.r : ℝ) (P.K : ℝ) CA5 _ _ hR0 (K_real P) rfl hN.f1 hSg
  -- the scale `H_{i+1,0}`
  have hHq : P.H (i + 1) 0 = HH (xH P (i + 1) 0) := rfl
  have hR35 : (0 : ℝ) ≤ (P.r : ℝ) ^ 35 := by positivity
  have hxq1 : 1 ≤ xH P (i + 1) 0 := by linarith
  have hHq3 : 3 ≤ P.H (i + 1) 0 := le_of_le_of_eq (HH_ge_three _ hxq1) hHq.symm
  have hHq1 : 1 ≤ P.H (i + 1) 0 := by omega
  have hlogH : Real.log (P.H (i + 1) 0) ≤ Real.exp (4 * (P.r : ℝ) ^ 42) := by
    have h1 : Real.log (P.H (i + 1) 0) ≤ Real.exp (xH P (i + 1) 0) :=
      le_of_eq_of_le (by rw [hHq]) (log_HH_le _ (by linarith [hxq1]))
    exact h1.trans (Real.exp_le_exp.mpr hx4)
  have hHqlow : Real.exp (Real.exp (xH P i (2 * P.K)) * Real.exp (2 * (P.r : ℝ) ^ 35) - 1) ≤
      P.H (i + 1) 0 := by
    have h1 := exp_le_HH (xH P (i + 1) 0) (by linarith [hxq1])
    rw [hx3, Real.exp_add] at h1
    exact le_of_le_of_eq h1 (by rw [hHq, hx3])
  -- the windows
  have hwinS : ∀ x ∈ pairs P.K, ∀ ℓ : Fin (x.2 + 1), ∃ h : Fin P.K,
      P.win i x.1 x.2 ℓ = P.Pr i (h + 1) := by
    intro x hx ℓ
    rw [mem_pairs] at hx
    refine ⟨⟨x.1 + ℓ, by have := ℓ.isLt; omega⟩, ?_⟩
    simp only [Par.win]
    congr 1
    omega
  have hwin : ∀ x ∈ pairs P.K, GoodSets (P.win i x.1 x.2) := by
    intro x hx ℓ
    obtain ⟨h, hh⟩ := hwinS x hx ℓ
    rw [hh]
    exact ⟨(hSets h).1, fun p hp => ((hSets h).2 p hp).1⟩
  have hwinb : ∀ x ∈ pairs P.K, ∀ ℓ, ∀ p ∈ P.win i x.1 x.2 ℓ, p ≤ P.H i (2 * P.K) := by
    intro x hx ℓ p hp
    obtain ⟨h, hh⟩ := hwinS x hx ℓ
    rw [hh] at hp
    exact ((hSets h).2 p hp).2
  -- GS (6.4) and Lemma 6.2
  have hη0 : 0 < 1 / (64 * (P.r : ℝ) ^ 2) := by positivity
  have hη1 : 1 / (64 * (P.r : ℝ) ^ 2) ≤ 1 / 64 := by
    apply div_le_div_of_nonneg_left (by norm_num) (by norm_num)
    have : (1 : ℝ) ≤ (P.r : ℝ) ^ 2 := one_le_pow₀ (by exact_mod_cast hr)
    linarith
  have hcond : ∀ x ∈ pairs P.K, Real.log ((P.H (i + 1) 0 : ℝ) * (P.q x.1 (x.1 + x.2) : ℝ)) /
      Real.log (Mval P.r) < c64 * (1 / (64 * (P.r : ℝ) ^ 2)) ^ 2 := by
    intro x hx
    rw [mem_pairs] at hx
    exact row_cond P c64 hr i x.1 x.2 (by omega) hHq1 hlogH hN.f5
  have hsh := row_shift P (P.H i (2 * P.K)) (P.H (i + 1) 0) hr (Real.exp (xH P i (2 * P.K)))
    (Real.one_le_exp (by linarith)) hPbexp hHqlow hN.f4
  have hC := row_corr P χ i (1 / (64 * (P.r : ℝ) ^ 2)) (1 / (8192 * (P.r : ℝ) ^ 4)) c64 hCor
    (P.H i (2 * P.K)) (by omega) hM2 hη0 hη1 hwin hwinb hHq1 hcond hsh
  exact final_row_arith (P.r : ℝ) (P.K : ℝ) _ _ _ hR0 (K_real P) hSg' (card_pairs_le P.K) hC

/- ## The numerical facts hold for large `r` -/

lemma eventually_poly (A : ℝ) (m n : ℕ) (hmn : m < n) :
    ∀ᶠ r : ℕ in atTop, A * (r : ℝ) ^ m ≤ (r : ℝ) ^ n := by
  filter_upwards [eventually_ge_atTop (⌈|A|⌉₊ + 1)] with r hr
  have hr1 : ((⌈|A|⌉₊ + 1 : ℕ) : ℝ) ≤ r := by exact_mod_cast hr
  push_cast at hr1
  have hA : |A| ≤ ⌈|A|⌉₊ := Nat.le_ceil _
  have hc0 : (0 : ℝ) ≤ ⌈|A|⌉₊ := Nat.cast_nonneg _
  have hR1 : (1 : ℝ) ≤ r := by linarith
  have hRA : A ≤ r := by linarith [le_abs_self A]
  calc A * (r : ℝ) ^ m ≤ (r : ℝ) * (r : ℝ) ^ m :=
        mul_le_mul_of_nonneg_right hRA (by positivity)
    _ = (r : ℝ) ^ (m + 1) := by ring
    _ ≤ (r : ℝ) ^ n := pow_le_pow_right₀ hR1 hmn

lemma exp_neg_inv_lt (c : ℝ) (hc : 0 < c) : Real.exp (-(1 / c)) < c := by
  have h1 : 1 / c < Real.exp (1 / c) := by linarith [Real.add_one_le_exp (1 / c)]
  rw [Real.exp_neg, inv_lt_comm₀ (Real.exp_pos _) hc]
  simpa [one_div] using h1

lemma Lam_le (r C : ℕ) (hr : 1 ≤ r) (h8 : 8 * (C : ℝ) * r ≤ (r : ℝ) ^ 7) :
    Lam ⟨r, C⟩ ≤ Real.exp (3 * (r : ℝ) ^ 7) := by
  unfold Lam
  simp only [Par.K, Par.d]
  push_cast
  have hR1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hR0 : (0 : ℝ) ≤ r := by linarith
  have h4 : (4 : ℝ) ^ (r ^ 7) ≤ Real.exp (2 * (r : ℝ) ^ 7) := by
    have h42 : (4 : ℝ) ≤ Real.exp 2 := by
      have := Real.quadratic_le_exp_of_nonneg (x := 2) (by norm_num)
      linarith
    calc (4 : ℝ) ^ (r ^ 7) ≤ (Real.exp 2) ^ (r ^ 7) := pow_le_pow_left₀ (by norm_num) h42 _
      _ = Real.exp (2 * (r : ℝ) ^ 7) := by rw [← Real.exp_nat_mul]; push_cast; ring_nf
  have hd : (((r : ℝ) ^ 4) ^ C) ^ 2 ≤ Real.exp (8 * C * r) := by
    have hRe : (r : ℝ) ≤ Real.exp r := by linarith [Real.add_one_le_exp (r : ℝ)]
    calc (((r : ℝ) ^ 4) ^ C) ^ 2 = (r : ℝ) ^ (8 * C) := by ring
      _ ≤ (Real.exp r) ^ (8 * C) := pow_le_pow_left₀ hR0 hRe _
      _ = Real.exp (8 * C * r) := by rw [← Real.exp_nat_mul]; push_cast; ring_nf
  calc (4 : ℝ) ^ (r ^ 7) * (((r : ℝ) ^ 4) ^ C) ^ 2 ≤
        Real.exp (2 * (r : ℝ) ^ 7) * Real.exp (8 * C * r) :=
        mul_le_mul h4 hd (by positivity) (Real.exp_pos _).le
    _ = Real.exp (2 * (r : ℝ) ^ 7 + 8 * C * r) := by rw [Real.exp_add]
    _ ≤ Real.exp (3 * (r : ℝ) ^ 7) := Real.exp_le_exp.mpr (by linarith)

lemma nf3 (R Lam : ℝ) (hR : 1 ≤ R) (hLam : Lam ≤ Real.exp (3 * R ^ 7))
    (p4 : 8 * R ^ 42 ≤ R ^ 43) :
    Lam + R ^ 7 * Real.exp (4 * R ^ 42) + 1 ≤ Real.exp (R ^ 43) / 2 := by
  have h7 : R ^ 7 ≤ R ^ 42 := pow_le_pow_right₀ hR (by norm_num)
  have h42 : 1 ≤ R ^ 42 := one_le_pow₀ hR
  have h70 : 0 ≤ R ^ 7 := by positivity
  have hX0 : 0 < Real.exp (R ^ 7 + 4 * R ^ 42) := Real.exp_pos _
  have h1 : Real.exp (3 * R ^ 7) ≤ Real.exp (R ^ 7 + 4 * R ^ 42) :=
    Real.exp_le_exp.mpr (by linarith)
  have h2 : R ^ 7 * Real.exp (4 * R ^ 42) ≤ Real.exp (R ^ 7 + 4 * R ^ 42) := by
    calc R ^ 7 * Real.exp (4 * R ^ 42) ≤ Real.exp (R ^ 7) * Real.exp (4 * R ^ 42) :=
          mul_le_mul_of_nonneg_right (by linarith [Real.add_one_le_exp (R ^ 7)])
            (Real.exp_pos _).le
      _ = Real.exp (R ^ 7 + 4 * R ^ 42) := (Real.exp_add _ _).symm
  have h3 : 1 ≤ Real.exp (R ^ 7 + 4 * R ^ 42) := Real.one_le_exp (by positivity)
  have e1 : (3 : ℝ) ≤ Real.exp 2 := by
    have := Real.quadratic_le_exp_of_nonneg (x := 2) (by norm_num)
    linarith
  have e2 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have e3 : Real.exp (R ^ 7 + 4 * R ^ 42) * Real.exp 2 ≤ Real.exp (R ^ 43 - 1) := by
    rw [← Real.exp_add]; exact Real.exp_le_exp.mpr (by linarith)
  have e4 : Real.exp (R ^ 43 - 1) * Real.exp 1 = Real.exp (R ^ 43) := by
    rw [← Real.exp_add]; ring_nf
  have e5 : 0 < Real.exp (R ^ 43 - 1) := Real.exp_pos _
  nlinarith [mul_le_mul_of_nonneg_left e1 hX0.le, mul_le_mul_of_nonneg_left e2 e5.le]

lemma nf4 (R Lam : ℝ) (hR : 1 ≤ R) (hLam : Lam ≤ Real.exp (3 * R ^ 7))
    (p5 : 16386 * R ^ 7 ≤ R ^ 8) :
    16384 * R ^ 4 + Lam + 1 + R ^ 7 ≤ Real.exp (2 * R ^ 35) := by
  have h47 : R ^ 4 ≤ R ^ 7 := pow_le_pow_right₀ hR (by norm_num)
  have h7 : 1 ≤ R ^ 7 := one_le_pow₀ hR
  have h835 : R ^ 8 ≤ R ^ 35 := pow_le_pow_right₀ hR (by norm_num)
  have h35 : 1 ≤ R ^ 35 := one_le_pow₀ hR
  have h1 : 16384 * R ^ 4 + 1 + R ^ 7 ≤ R ^ 8 := by linarith
  have h2 : R ^ 8 ≤ Real.exp (R ^ 8) := by linarith [Real.add_one_le_exp (R ^ 8)]
  have h3 : Lam ≤ Real.exp (R ^ 8) := hLam.trans (Real.exp_le_exp.mpr (by linarith))
  have e2 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have h4 : Real.exp (R ^ 8) * Real.exp 1 ≤ Real.exp (2 * R ^ 35) := by
    rw [← Real.exp_add]; exact Real.exp_le_exp.mpr (by linarith)
  have h5 : 0 < Real.exp (R ^ 8) := Real.exp_pos _
  nlinarith [mul_le_mul_of_nonneg_left e2 h5.le]

lemma nf5 (R Lam c : ℝ) (hR : 1 ≤ R) (hc : 0 < c) (hLam : Lam ≤ Real.exp (3 * R ^ 7))
    (p6 : (8196 + 1 / c) * R ^ 42 ≤ R ^ 43) :
    4096 * R ^ 4 * (Real.exp (4 * R ^ 42) + Lam) < c * Real.exp (R ^ 43) := by
  have h4 : R ^ 4 ≤ R ^ 42 := pow_le_pow_right₀ hR (by norm_num)
  have h7 : R ^ 7 ≤ R ^ 42 := pow_le_pow_right₀ hR (by norm_num)
  have h42 : 1 ≤ R ^ 42 := one_le_pow₀ hR
  have hc1 : 0 < 1 / c := by positivity
  have hLam' : Lam ≤ Real.exp (4 * R ^ 42) := hLam.trans (Real.exp_le_exp.mpr (by linarith))
  have hR4 : 0 ≤ R ^ 4 := by positivity
  have h1 : 4096 * R ^ 4 * (Real.exp (4 * R ^ 42) + Lam) ≤
      8192 * R ^ 4 * Real.exp (4 * R ^ 42) := by
    have := mul_le_mul_of_nonneg_left hLam' (by positivity : (0 : ℝ) ≤ 4096 * R ^ 4)
    nlinarith
  have h2 : 8192 * R ^ 4 ≤ Real.exp (8192 * R ^ 4) := by
    linarith [Real.add_one_le_exp (8192 * R ^ 4)]
  have h3 : 8192 * R ^ 4 * Real.exp (4 * R ^ 42) ≤ Real.exp (8192 * R ^ 4 + 4 * R ^ 42) := by
    calc 8192 * R ^ 4 * Real.exp (4 * R ^ 42) ≤ Real.exp (8192 * R ^ 4) * Real.exp (4 * R ^ 42) :=
          mul_le_mul_of_nonneg_right h2 (Real.exp_pos _).le
      _ = Real.exp (8192 * R ^ 4 + 4 * R ^ 42) := (Real.exp_add _ _).symm
  have p6' : 8196 * R ^ 42 + (1 / c) * R ^ 42 ≤ R ^ 43 := by
    calc 8196 * R ^ 42 + (1 / c) * R ^ 42 = (8196 + 1 / c) * R ^ 42 := by ring
      _ ≤ R ^ 43 := p6
  have h5 : (1 / c) ≤ (1 / c) * R ^ 42 := by
    have := mul_le_mul_of_nonneg_left h42 hc1.le
    linarith
  have h6 : 8192 * R ^ 4 + 4 * R ^ 42 ≤ R ^ 43 + -(1 / c) := by linarith
  have h7' : Real.exp (8192 * R ^ 4 + 4 * R ^ 42) ≤ Real.exp (R ^ 43 + -(1 / c)) :=
    Real.exp_le_exp.mpr h6
  have h8 : Real.exp (R ^ 43 + -(1 / c)) = Real.exp (R ^ 43) * Real.exp (-(1 / c)) :=
    Real.exp_add _ _
  have h9 : Real.exp (-(1 / c)) < c := exp_neg_inv_lt c hc
  have h10 : Real.exp (R ^ 43) * Real.exp (-(1 / c)) < Real.exp (R ^ 43) * c :=
    mul_lt_mul_of_pos_left h9 (Real.exp_pos _)
  linarith

lemma nf6 (R CA5 : ℝ) (hR : 1 ≤ R) (hCA5 : 0 ≤ CA5) (p7 : (CA5 + 5) * R ^ 42 ≤ R ^ 43) :
    CA5 * R ^ 14 * Real.exp (4 * R ^ 42) ≤ Real.exp (R ^ 43) := by
  have h14 : R ^ 14 ≤ R ^ 42 := pow_le_pow_right₀ hR (by norm_num)
  have h42 : 1 ≤ R ^ 42 := one_le_pow₀ hR
  have hc1 : CA5 ≤ Real.exp CA5 := by linarith [Real.add_one_le_exp CA5]
  have hr1 : R ^ 14 ≤ Real.exp (R ^ 14) := by linarith [Real.add_one_le_exp (R ^ 14)]
  have h1 : CA5 * R ^ 14 ≤ Real.exp CA5 * Real.exp (R ^ 14) :=
    mul_le_mul hc1 hr1 (by positivity) (Real.exp_pos _).le
  have h2 : CA5 * R ^ 14 * Real.exp (4 * R ^ 42) ≤
      Real.exp CA5 * Real.exp (R ^ 14) * Real.exp (4 * R ^ 42) :=
    mul_le_mul_of_nonneg_right h1 (Real.exp_pos _).le
  have h3 : Real.exp CA5 * Real.exp (R ^ 14) * Real.exp (4 * R ^ 42) =
      Real.exp (CA5 + R ^ 14 + 4 * R ^ 42) := by
    rw [Real.exp_add, Real.exp_add]
  have p7' : CA5 * R ^ 42 + 5 * R ^ 42 ≤ R ^ 43 := by
    calc CA5 * R ^ 42 + 5 * R ^ 42 = (CA5 + 5) * R ^ 42 := by ring
      _ ≤ R ^ 43 := p7
  have h4 : CA5 ≤ CA5 * R ^ 42 := by
    have := mul_le_mul_of_nonneg_left h42 hCA5
    linarith
  have h5 : CA5 + R ^ 14 + 4 * R ^ 42 ≤ R ^ 43 := by linarith
  calc CA5 * R ^ 14 * Real.exp (4 * R ^ 42) ≤ _ := h2
    _ = _ := h3
    _ ≤ Real.exp (R ^ 43) := Real.exp_le_exp.mpr h5

theorem numFacts_eventually (C : ℕ) (CA5 : ℝ) (hCA5 : 0 ≤ CA5) (c64 : ℝ) (hc64 : 0 < c64)
    (CM : ℝ) : ∀ᶠ r in atTop, NumFacts ⟨r, C⟩ CA5 c64 CM := by
  filter_upwards [eventually_ge_atTop 2,
    eventually_poly (14 + 16 * CA5) 0 6 (by norm_num),
    eventually_poly (4 * (1 + CM)) 0 28 (by norm_num),
    eventually_poly (8 * (C : ℝ)) 1 7 (by norm_num),
    eventually_poly 8 42 43 (by norm_num),
    eventually_poly 16386 7 8 (by norm_num),
    eventually_poly (8196 + 1 / c64) 42 43 (by norm_num),
    eventually_poly (CA5 + 5) 42 43 (by norm_num)] with r hr2 p1 p2 p3 p4 p5 p6 p7
  have hR1 : (1 : ℝ) ≤ r := by exact_mod_cast (show 1 ≤ r by omega)
  simp only [pow_zero, mul_one, pow_one] at p1 p2 p3
  have hLam := Lam_le r C (by omega) p3
  have h28 : 0 ≤ (r : ℝ) ^ 28 := by positivity
  exact ⟨hr2, p1, (show 4 * (1 + CM) ≤ 3 * (r : ℝ) ^ 28 by linarith), nf3 _ _ hR1 hLam p4,
    nf4 _ _ hR1 hLam p5, nf5 _ _ _ hR1 hc64 hLam p6, nf6 _ _ hR1 hCA5 p7⟩

/- ## Summing over the rows -/

lemma Ssml_eq (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) :
    Ssml P χ = ∑ i ∈ Icc 1 (P.T - 1), ∑ x ∈ pairs P.K, corr P χ i x.1 x.2 (fS P χ i x.1 x.2) := by
  unfold Ssml Par.triples
  rw [Finset.sum_filter, Finset.sum_product]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [pairs, Finset.sum_filter]

/-- **Claim C2** (draft §§3–4): positivity after the small projections. -/
theorem ssml_lower' (C : ℕ) (hC : 1 ≤ C) (CA5 : ℝ) (hCA5 : 0 ≤ CA5) (hA5 : LemmaA5With CA5)
    (c64 : ℝ) (hc64 : 0 < c64) (hCor : Cor64With c64) (CM : ℝ) (hCM : 0 ≤ CM)
    (hM : MertensLowerWith CM) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r,
      (((⟨r, C⟩ : Par).T : ℝ) - 1) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) ≤
        Ssml ⟨r, C⟩ χ := by
  filter_upwards [numFacts_eventually C CA5 hCA5 c64 hc64 CM] with r hN χ
  rw [Ssml_eq]
  have hT1 : 1 ≤ (⟨r, C⟩ : Par).T := by
    have : 2 ≤ r := hN.r2
    show 1 ≤ r ^ 7
    exact Nat.one_le_pow _ _ (by omega)
  have hrow : ∀ i ∈ Icc 1 ((⟨r, C⟩ : Par).T - 1),
      ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) ≤
        ∑ x ∈ pairs (⟨r, C⟩ : Par).K, corr ⟨r, C⟩ χ i x.1 x.2 (fS ⟨r, C⟩ χ i x.1 x.2) := by
    intro i hi
    rw [mem_Icc] at hi
    exact row_main ⟨r, C⟩ CA5 hCA5 hA5 c64 hCor CM hM hN χ i hi.1 (by omega)
  calc (((⟨r, C⟩ : Par).T : ℝ) - 1) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3)
      = ∑ i ∈ Icc 1 ((⟨r, C⟩ : Par).T - 1),
          ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) := by
        rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel, Nat.cast_sub hT1]
        push_cast
        ring
    _ ≤ _ := Finset.sum_le_sum hrow

end G22.C2

end

/- ## Section: `C3` -/

section

/-
# Claim C3 (draft §5, (16)–(19)): replacing the small projections by the large ones

We prove `G22.C3.ssml_sub_slrg'`: for all large `r` and every `r`-colouring `χ` of `[1, M]`,
`|𝒮 - 𝒮'| ≤ √(tK²) · √(3K²) + 1`, assuming GS Lemma A.1 (A.2) (`LemmaA2With`) and
GS Lemma 6.4 (`Lemma64With`).

## Structure of the proof

1. *Linearity* (`corr_sub`): `corr(P^s f) - corr(P^ℓ f)` is the window expectation of
   `∑_c Δ_c(n + λT) 1_{A_c}(b_j T n)` with `Δ_c = P^s f_c - P^ℓ f_c`.
2. *Pointwise bound* (`pointwise_bound`): for a fixed prime tuple, shift invariance
   (Lemma A.2) and Cauchy–Schwarz (over the colours and then over `n`) give
   `|E^log_n ∑_c Δ_c(n+h) g_c(n)| ≤ √(∑_c ‖Δ_c‖²) + C_{A2}(1 + log|h|)/log M`.
   Averaging over the window of primes gives `triple_bound`.
3. *Energy* (`energy_step`, `energy_sum`): Lemma 6.4 bounds `E_x = ∑_c ‖Δ_c‖²` by a difference
   `Y_a(i, j) - Y_a(i+1, j-1)` plus an error term, and these differences telescope over the
   rectangle of pairs `(i, k)` (`rect_telescope`, `telescope_triples`) because `0 ≤ Y ≤ 1`
   (`Y_le_one`: the colour classes form a partition).
4. *Cauchy–Schwarz over triples* (`sum_sqrt_le`) and the *parameter asymptotics*
   (`ev_eps`, `ev_err`) finish the proof (`main_bound`, `ssml_sub_slrg'`).

The hypothesis `1 ≤ C` of `ssml_sub_slrg'` is not needed (it is kept so that the statement
matches `G22.ssml_sub_slrg` in `Claims.lean` verbatim).
-/

open Finset Filter

namespace G22.C3

/- ### 1. Weighted averages with nonnegative weights (no nonemptiness needed) -/

section wavg
variable {α : Type*} {s : Finset α} {w : α → ℝ}

lemma wavg_nonneg' (hw : ∀ x ∈ s, 0 ≤ w x) {f : α → ℝ} (hf : ∀ x ∈ s, 0 ≤ f x) :
    0 ≤ wavg s w f :=
  div_nonneg (Finset.sum_nonneg fun x hx => mul_nonneg (hw x hx) (hf x hx))
    (Finset.sum_nonneg hw)

lemma wavg_le_one' (hw : ∀ x ∈ s, 0 ≤ w x) {f : α → ℝ} (hf : ∀ x ∈ s, f x ≤ 1) :
    wavg s w f ≤ 1 := by
  unfold wavg
  refine div_le_one_of_le₀ (Finset.sum_le_sum fun x hx => ?_) (Finset.sum_nonneg hw)
  have := mul_le_mul_of_nonneg_left (hf x hx) (hw x hx)
  linarith

lemma abs_wavg_le' (hw : ∀ x ∈ s, 0 ≤ w x) {f : α → ℝ} {c : ℝ} (hc : 0 ≤ c)
    (hf : ∀ x ∈ s, |f x| ≤ c) : |wavg s w f| ≤ c := by
  unfold wavg
  rcases (Finset.sum_nonneg hw).eq_or_lt with h0 | hpos
  · rw [← h0, div_zero, abs_zero]; exact hc
  · rw [abs_div, abs_of_pos hpos, div_le_iff₀ hpos]
    calc |∑ x ∈ s, w x * f x| ≤ ∑ x ∈ s, |w x * f x| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ x ∈ s, c * w x := Finset.sum_le_sum fun x hx => by
          rw [abs_mul, abs_of_nonneg (hw x hx), mul_comm]
          exact mul_le_mul_of_nonneg_right (hf x hx) (hw x hx)
      _ = c * ∑ x ∈ s, w x := by rw [Finset.mul_sum]

end wavg

/- ### 2. Iterated averages bounded on their support -/

/-- An iterated logarithmic average is bounded by any bound of the integrand on the support
(no nonemptiness of the sets is needed, since empty averages are `0`). -/
lemma abs_iterAvg_le_mem {k : ℕ} (S : Fin k → Finset ℕ) (F : (Fin k → ℕ) → ℝ) {c : ℝ}
    (hc : 0 ≤ c) (hF : ∀ pp : Fin k → ℕ, (∀ ℓ, pp ℓ ∈ S ℓ) → |F pp| ≤ c) :
    |iterAvg k S F| ≤ c := by
  induction k with
  | zero => exact hF _ fun ℓ => ℓ.elim0
  | succ k ih =>
    simp only [iterAvg, lavg]
    refine abs_wavg_le' (fun p _ => by positivity) hc fun p hp => ?_
    refine ih (fun i => S i.succ) _ fun q hq => hF _ fun ℓ => ?_
    refine Fin.cases ?_ (fun i => ?_) ℓ
    · simpa using hp
    · simpa using hq i

/- ### 3. Linearity -/

lemma logAvg_sub (N : ℕ) (f g : ℤ → ℝ) :
    logAvg N (fun n => f n - g n) = logAvg N f - logAvg N g :=
  wavg_sub _ _

lemma logAvg_sum {ι : Type*} (t : Finset ι) (N : ℕ) (f : ι → ℤ → ℝ) :
    logAvg N (fun n => ∑ i ∈ t, f i n) = ∑ i ∈ t, logAvg N (f i) :=
  wavg_sum t _

lemma Wexp_sub (P : Par) (i a k : ℕ) (Φ₁ Φ₂ : ℤ → ℤ → ℝ) :
    Wexp P i a k Φ₁ - Wexp P i a k Φ₂ = Wexp P i a k (fun n T => Φ₁ n T - Φ₂ n T) := by
  unfold Wexp
  rw [← iterAvg_sub]
  congr 1
  funext pp
  exact (logAvg_sub _ _ _).symm

lemma Wexp_sum (P : Par) (i a k : ℕ) {ι : Type*} (t : Finset ι) (Φ : ι → ℤ → ℤ → ℝ) :
    Wexp P i a k (fun n T => ∑ c ∈ t, Φ c n T) = ∑ c ∈ t, Wexp P i a k (Φ c) := by
  unfold Wexp
  rw [← iterAvg_sum]
  congr 1
  funext pp
  exact logAvg_sum _ _ _

/-- `corr φ - corr ψ` is the window expectation of `∑_c (φ_c - ψ_c)(n + λT) 1_{A_c}(b_j T n)`. -/
lemma corr_sub (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i a k : ℕ)
    (φ ψ : Fin P.r → ℤ → ℝ) :
    corr P χ i a k φ - corr P χ i a k ψ =
      Wexp P i a k (fun n T => ∑ c, (φ c (n + (P.lam a (a + k + 1) : ℤ) * T) -
        ψ c (n + (P.lam a (a + k + 1) : ℤ) * T)) * gT P χ (a + k + 1) c T n) := by
  unfold corr
  rw [Wexp_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [Wexp_sub]
  congr 1
  funext n T
  ring

/- ### 4. The pointwise estimate (shift invariance + Cauchy–Schwarz) -/

/-- For a fixed shift `h ≠ 0`: if `|Δ_c| ≤ 1`, `g_c ≥ 0`, `∑_c g_c ≤ 1`, then
`|E^log_{n ≤ N} ∑_c Δ_c(n + h) g_c(n)| ≤ √(∑_c ‖Δ_c‖²) + C_{A2} (1 + log|h|)/log N`. -/
lemma pointwise_bound {ι : Type*} (s : Finset ι) {CA2 : ℝ} (hA2 : LemmaA2With CA2) {N : ℕ}
    (hN : 2 ≤ N) (Δ g : ι → ℤ → ℝ) (hΔ : ∀ c m, |Δ c m| ≤ 1) (hg0 : ∀ c m, 0 ≤ g c m)
    (hg1 : ∀ c m, g c m ≤ 1) (hgs : ∀ m, ∑ c ∈ s, g c m ≤ 1) (h : ℤ) (hh : h ≠ 0) :
    |logAvg N (fun n => ∑ c ∈ s, Δ c (n + h) * g c n)| ≤
      Real.sqrt (∑ c ∈ s, normSq N (Δ c)) + CA2 * (1 + Real.log |(h : ℝ)|) / Real.log N := by
  set Ψ : ℤ → ℝ := fun m => ∑ c ∈ s, Δ c m * g c (m - h) with hΨdef
  have hGW : GoodWeights (Icc 1 N) (fun n : ℕ => 1 / (n : ℝ)) := goodWeights_logAvg (by omega)
  have hΨ1 : ∀ m, |Ψ m| ≤ 1 := by
    intro m
    calc |Ψ m| ≤ ∑ c ∈ s, |Δ c m * g c (m - h)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ c ∈ s, g c (m - h) := Finset.sum_le_sum fun c _ => by
          rw [abs_mul, abs_of_nonneg (hg0 c _)]
          exact mul_le_of_le_one_left (hg0 c _) (hΔ c m)
      _ ≤ 1 := hgs _
  have hS0 : ∀ m, 0 ≤ ∑ c ∈ s, Δ c m ^ 2 := fun m => Finset.sum_nonneg fun c _ => sq_nonneg _
  have hΨsq : ∀ m, |Ψ m| ≤ Real.sqrt (∑ c ∈ s, Δ c m ^ 2) := by
    intro m
    have hcs := Finset.sum_mul_sq_le_sq_mul_sq s (fun c => Δ c m) (fun c => g c (m - h))
    have hg2 : ∑ c ∈ s, g c (m - h) ^ 2 ≤ 1 := by
      calc ∑ c ∈ s, g c (m - h) ^ 2 ≤ ∑ c ∈ s, g c (m - h) := Finset.sum_le_sum fun c _ => by
            have h0 := hg0 c (m - h); have h1 := hg1 c (m - h); nlinarith
        _ ≤ 1 := hgs _
    rw [← Real.sqrt_sq_eq_abs]
    apply Real.sqrt_le_sqrt
    calc Ψ m ^ 2 ≤ (∑ c ∈ s, Δ c m ^ 2) * ∑ c ∈ s, g c (m - h) ^ 2 := hcs
      _ ≤ (∑ c ∈ s, Δ c m ^ 2) * 1 := mul_le_mul_of_nonneg_left hg2 (hS0 m)
      _ = ∑ c ∈ s, Δ c m ^ 2 := mul_one _
  have hmain : |logAvg N Ψ| ≤ Real.sqrt (∑ c ∈ s, normSq N (Δ c)) := by
    have e1 : ∑ c ∈ s, normSq N (Δ c) = logAvg N (fun m => ∑ c ∈ s, Δ c m ^ 2) := by
      unfold normSq; rw [logAvg_sum]
    have e2 : logAvg N (fun _ => (1 : ℝ) ^ 2) = 1 := by
      simp only [one_pow]; exact wavg_const hGW 1
    calc |logAvg N Ψ| ≤ logAvg N (fun m => |Ψ m|) := abs_wavg_le hGW _
      _ ≤ logAvg N (fun m => Real.sqrt (∑ c ∈ s, Δ c m ^ 2) * 1) :=
          wavg_mono hGW fun n _ => by simp only [mul_one]; exact hΨsq _
      _ ≤ |logAvg N (fun m => Real.sqrt (∑ c ∈ s, Δ c m ^ 2) * 1)| := le_abs_self _
      _ ≤ Real.sqrt (logAvg N (fun m => Real.sqrt (∑ c ∈ s, Δ c m ^ 2) ^ 2)) *
            Real.sqrt (logAvg N (fun _ => (1 : ℝ) ^ 2)) :=
          abs_wavg_mul_le hGW (fun n : ℕ => Real.sqrt (∑ c ∈ s, Δ c n ^ 2)) (fun _ => 1)
      _ = Real.sqrt (∑ c ∈ s, normSq N (Δ c)) := by
          rw [e2, Real.sqrt_one, mul_one, e1]
          congr 1
          exact wavg_congr fun n _ => Real.sq_sqrt (hS0 n)
  have hA := hA2 N hN Ψ hΨ1 h hh
  have hshift : (fun n => ∑ c ∈ s, Δ c (n + h) * g c n) = fun n => Ψ (n + h) := by
    funext n; simp only [hΨdef, add_sub_cancel_right]
  rw [hshift]
  have h3 := abs_sub_abs_le_abs_sub (logAvg N fun n => Ψ (n + h)) (logAvg N Ψ)
  rw [abs_sub_comm] at h3
  linarith

/- ### 5. Projections -/

lemma proj_nonneg {q H : ℕ} {f : ℤ → ℝ} (hf : ∀ n, 0 ≤ f n) (n : ℤ) : 0 ≤ proj q H f n :=
  wavg_nonneg' (fun _ _ => zero_le_one) fun _ _ =>
    wavg_nonneg' (fun _ _ => zero_le_one) fun _ _ => hf _

lemma proj_le_one {q H : ℕ} {f : ℤ → ℝ} (hf : ∀ n, f n ≤ 1) (n : ℤ) : proj q H f n ≤ 1 :=
  wavg_le_one' (fun _ _ => zero_le_one) fun _ _ =>
    wavg_le_one' (fun _ _ => zero_le_one) fun _ _ => hf _

lemma proj_sum {ι : Type*} (t : Finset ι) (q H : ℕ) (f : ι → ℤ → ℝ) (n : ℤ) :
    proj q H (fun m => ∑ c ∈ t, f c m) n = ∑ c ∈ t, proj q H (f c) n := by
  unfold proj uavg
  rw [← wavg_sum]
  exact wavg_congr fun h _ => wavg_sum _ _

lemma normSq_nonneg (N : ℕ) (g : ℤ → ℝ) : 0 ≤ normSq N g :=
  wavg_nonneg' (fun n _ => by positivity) fun n _ => sq_nonneg _

/-- `Y_a(i, j) = ∑_c ‖Π_{q_{a,j}, H_{i,0}} f_{a,c}‖²`. -/
noncomputable def Y (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (a i j : ℕ) : ℝ :=
  ∑ c, normSq (Mval P.r) (proj (P.q a j) (P.H i 0) (fa P χ a c))

lemma Y_nonneg (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (a i j : ℕ) :
    0 ≤ Y P χ a i j :=
  Finset.sum_nonneg fun _ _ => normSq_nonneg _ _

/-- Subpartition: `∑_c ‖Π f_{a,c}‖² ≤ 1`. -/
lemma Y_le_one (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (a i j : ℕ) :
    Y P χ a i j ≤ 1 := by
  unfold Y normSq
  rw [← logAvg_sum]
  refine wavg_le_one' (fun n _ => by positivity) fun n _ => ?_
  calc ∑ c, proj (P.q a j) (P.H i 0) (fa P χ a c) n ^ 2
      ≤ ∑ c, proj (P.q a j) (P.H i 0) (fa P χ a c) n := Finset.sum_le_sum fun c _ => by
        have h0 := proj_nonneg (q := P.q a j) (H := P.H i 0) (f := fa P χ a c)
          (fun m => ind_nonneg χ c _) (n : ℤ)
        have h1 := proj_le_one (q := P.q a j) (H := P.H i 0) (f := fa P χ a c)
          (fun m => ind_le_one χ c _) (n : ℤ)
        nlinarith
    _ = proj (P.q a j) (P.H i 0) (fun m => ∑ c, fa P χ a c m) n := (proj_sum _ _ _ _ _).symm
    _ ≤ 1 := proj_le_one (fun m => sum_ind_le_one χ _) _

/- ### 6. Parameter facts -/

section params
variable (P : Par)

lemma V_pos : 0 < P.V := Nat.factorial_pos _

lemma lam_pos (a j : ℕ) : 0 < P.lam a j := pow_pos (V_pos P) _

lemma q_pos (a j : ℕ) : 1 ≤ P.q a j := Nat.mul_pos (lam_pos P a j) (V_pos P)

lemma lam_le_q (a j : ℕ) : P.lam a j ≤ P.q a j := Nat.le_mul_of_pos_right _ (V_pos P)

lemma q_dvd (a k : ℕ) : P.q a (a + k) ∣ P.q a (a + k + 1) := by
  unfold Par.q Par.lam
  refine Nat.mul_dvd_mul_right (pow_dvd_pow _ (Nat.sub_le_sub_right ?_ _)) _
  exact Nat.pow_le_pow_right (by norm_num) (by omega)

lemma H_pos (i j : ℕ) : 1 ≤ P.H i j := by
  unfold Par.H
  rw [Nat.one_le_floor_iff]
  exact Real.one_le_exp (Real.exp_pos _).le

lemma H_mono (i : ℕ) : P.H i 0 ≤ P.H (i + 1) 0 := by
  unfold Par.H
  apply Nat.floor_le_floor
  apply Real.exp_le_exp.mpr
  apply Real.exp_le_exp.mpr
  push_cast
  have : (0 : ℝ) ≤ P.L := Nat.cast_nonneg _
  have : (0 : ℝ) ≤ P.K := Nat.cast_nonneg _
  nlinarith

lemma H_le (i j : ℕ) :
    (P.H i j : ℝ) ≤ Real.exp (Real.exp ((P.L : ℝ) * (4 * P.K * i + j))) :=
  Nat.floor_le (Real.exp_pos _).le

lemma H_ge (i j : ℕ) :
    Real.exp (Real.exp ((P.L : ℝ) * (4 * P.K * i + j))) ≤ 2 * P.H i j := by
  have h1 : Real.exp (Real.exp ((P.L : ℝ) * (4 * P.K * i + j))) < P.H i j + 1 :=
    Nat.lt_floor_add_one _
  have h2 : (1 : ℝ) ≤ P.H i j := by exact_mod_cast H_pos P i j
  linarith

/-- `V = D!` with `D = d^C`, so `V ≤ D^D ≤ exp(D²)`. -/
lemma V_le : (P.V : ℝ) ≤ Real.exp (((P.d ^ P.C : ℕ) : ℝ) ^ 2) := by
  have h1 : P.V ≤ (P.d ^ P.C) ^ (P.d ^ P.C) := Nat.factorial_le_pow _
  have h2 : (P.V : ℝ) ≤ ((P.d ^ P.C : ℕ) : ℝ) ^ (P.d ^ P.C) := by exact_mod_cast h1
  have h3 : ((P.d ^ P.C : ℕ) : ℝ) ≤ Real.exp ((P.d ^ P.C : ℕ) : ℝ) := by
    linarith [Real.add_one_le_exp ((P.d ^ P.C : ℕ) : ℝ)]
  calc (P.V : ℝ) ≤ ((P.d ^ P.C : ℕ) : ℝ) ^ (P.d ^ P.C) := h2
    _ ≤ Real.exp ((P.d ^ P.C : ℕ) : ℝ) ^ (P.d ^ P.C) :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) h3 _
    _ = Real.exp (((P.d ^ P.C : ℕ) : ℝ) ^ 2) := by rw [← Real.exp_nat_mul, sq]

lemma four_pow_le {j : ℕ} (hj : j ≤ P.K) : (4 : ℝ) ^ j ≤ Real.exp (3 * P.K) := by
  have h4 : (4 : ℝ) ≤ Real.exp 3 := by linarith [Real.add_one_le_exp (3 : ℝ)]
  calc (4 : ℝ) ^ j ≤ 4 ^ P.K := pow_le_pow_right₀ (by norm_num) hj
    _ ≤ Real.exp 3 ^ P.K := pow_le_pow_left₀ (by norm_num) h4 _
    _ = Real.exp (3 * P.K) := by rw [← Real.exp_nat_mul, mul_comm]

/-- Bound for `log q_{a,j}` and `log λ_{a,j}` (for `j ≤ K`). -/
noncomputable def Qb : ℝ := ((P.d ^ P.C : ℕ) : ℝ) ^ 2 * (Real.exp (3 * P.K) + 1)

/-- Bound for `log H_{i,j}` when `4Ki + j ≤ 4Kt`. -/
noncomputable def Wb : ℝ := Real.exp (4 * P.L * P.K * P.T)

lemma Qb_nonneg : 0 ≤ Qb P := by unfold Qb; positivity

lemma Wb_nonneg : 0 ≤ Wb P := (Real.exp_pos _).le

lemma q_le {a j : ℕ} (hj : j ≤ P.K) : (P.q a j : ℝ) ≤ Real.exp (Qb P) := by
  have hV1 : (1 : ℝ) ≤ P.V := by exact_mod_cast V_pos P
  have hVe := V_le P
  have h4 := four_pow_le P hj
  unfold Par.q Par.lam
  push_cast
  calc (P.V : ℝ) ^ (4 ^ j - 2 * 4 ^ a) * P.V ≤ (P.V : ℝ) ^ (4 ^ j) * P.V :=
        mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hV1 (Nat.sub_le _ _)) (by positivity)
    _ = (P.V : ℝ) ^ (4 ^ j + 1) := by rw [pow_succ]
    _ ≤ Real.exp (((P.d ^ P.C : ℕ) : ℝ) ^ 2) ^ (4 ^ j + 1) :=
        pow_le_pow_left₀ (by positivity) hVe _
    _ = Real.exp (((4 ^ j + 1 : ℕ) : ℝ) * ((P.d ^ P.C : ℕ) : ℝ) ^ 2) := by
        rw [Real.exp_nat_mul]
    _ ≤ Real.exp (Qb P) := by
        apply Real.exp_le_exp.mpr
        unfold Qb
        have hD : (0 : ℝ) ≤ ((P.d ^ P.C : ℕ) : ℝ) ^ 2 := by positivity
        have : ((4 ^ j + 1 : ℕ) : ℝ) ≤ Real.exp (3 * P.K) + 1 := by push_cast; linarith
        nlinarith

lemma lam_le {a j : ℕ} (hj : j ≤ P.K) : (P.lam a j : ℝ) ≤ Real.exp (Qb P) :=
  (by exact_mod_cast lam_le_q P a j : (P.lam a j : ℝ) ≤ P.q a j).trans (q_le P hj)

lemma H_le_W {i j : ℕ} (h : 4 * P.K * i + j ≤ 4 * P.K * P.T) :
    (P.H i j : ℝ) ≤ Real.exp (Wb P) := by
  refine (H_le P i j).trans (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr ?_))
  have h' : ((4 * P.K * i + j : ℕ) : ℝ) ≤ ((4 * P.K * P.T : ℕ) : ℝ) := by exact_mod_cast h
  push_cast at h'
  have hL : (0 : ℝ) ≤ P.L := Nat.cast_nonneg _
  nlinarith

/-- `q' H' / (q H)` is tiny: `V^{O(4^K)} · H_{i,0} / H_{i+1,0}`. -/
lemma ratio_le {a k : ℕ} (i : ℕ) (hj : a + k + 1 ≤ P.K) :
    (P.q a (a + k + 1) : ℝ) * P.H i 0 / ((P.q a (a + k) : ℝ) * P.H (i + 1) 0) ≤
      Real.exp (Qb P + 2 - Real.exp (4 * P.L * P.K)) := by
  set y : ℝ := (P.L : ℝ) * (4 * P.K * i + ((0 : ℕ) : ℝ)) with hy
  set E : ℝ := Real.exp (4 * P.L * P.K) with hE
  have hq' : (P.q a (a + k + 1) : ℝ) ≤ Real.exp (Qb P) := q_le P hj
  have hq1 : (1 : ℝ) ≤ P.q a (a + k) := by exact_mod_cast q_pos P a (a + k)
  have hH1 : (P.H i 0 : ℝ) ≤ Real.exp (Real.exp y) := H_le P i 0
  have hH2 : Real.exp (Real.exp (y + 4 * P.L * P.K)) ≤ 2 * P.H (i + 1) 0 := by
    have e : y + 4 * (P.L : ℝ) * P.K =
        (P.L : ℝ) * (4 * P.K * ((i + 1 : ℕ) : ℝ) + ((0 : ℕ) : ℝ)) := by
      rw [hy]; push_cast; ring
    rw [e]; exact H_ge P (i + 1) 0
  have hy0 : 0 ≤ y := by rw [hy]; positivity
  have hgap : Real.exp y + (E - 1) ≤ Real.exp (y + 4 * P.L * P.K) := by
    rw [Real.exp_add, ← hE]
    have h1 : 1 ≤ Real.exp y := Real.one_le_exp hy0
    have h2 : 1 ≤ E := Real.one_le_exp (by positivity)
    nlinarith
  have hHpos : (0 : ℝ) < P.H (i + 1) 0 := by exact_mod_cast H_pos P (i + 1) 0
  have hq'0 : (0 : ℝ) ≤ P.q a (a + k + 1) := Nat.cast_nonneg _
  have hHi0 : (0 : ℝ) ≤ P.H i 0 := Nat.cast_nonneg _
  have he1 : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
  calc (P.q a (a + k + 1) : ℝ) * P.H i 0 / ((P.q a (a + k) : ℝ) * P.H (i + 1) 0)
      ≤ (P.q a (a + k + 1) : ℝ) * P.H i 0 / P.H (i + 1) 0 := by
        apply div_le_div_of_nonneg_left (mul_nonneg hq'0 hHi0) hHpos
        nlinarith
    _ ≤ Real.exp (Qb P + 2 - E) := by
        rw [div_le_iff₀ hHpos]
        calc (P.q a (a + k + 1) : ℝ) * P.H i 0 ≤ Real.exp (Qb P) * Real.exp (Real.exp y) :=
              mul_le_mul hq' hH1 hHi0 (Real.exp_pos _).le
          _ = Real.exp (Qb P + Real.exp y) := (Real.exp_add _ _).symm
          _ ≤ Real.exp (Qb P + Real.exp y) * (Real.exp 1 / 2) := by
              apply le_mul_of_one_le_right (Real.exp_pos _).le; linarith
          _ = Real.exp ((Qb P + 2 - E) + (Real.exp y + (E - 1))) / 2 := by
              rw [show (Qb P + 2 - E) + (Real.exp y + (E - 1)) = (Qb P + Real.exp y) + 1 by ring,
                Real.exp_add (Qb P + Real.exp y) 1]
              ring
          _ ≤ Real.exp ((Qb P + 2 - E) + Real.exp (y + 4 * P.L * P.K)) / 2 := by
              gcongr
          _ = Real.exp (Qb P + 2 - E) * Real.exp (Real.exp (y + 4 * P.L * P.K)) / 2 := by
              rw [Real.exp_add]
          _ ≤ Real.exp (Qb P + 2 - E) * P.H (i + 1) 0 := by
              have := mul_le_mul_of_nonneg_left hH2 (Real.exp_pos (Qb P + 2 - E)).le
              linarith

end params

/-- `M ≥ exp exp(r⁴³)`. -/
lemma Mval_ge (r : ℕ) : Real.exp (Real.exp ((r : ℝ) ^ 43)) ≤ Mval r := Nat.le_ceil _

lemma two_le_Mval (r : ℕ) : 2 ≤ Mval r := by
  have h := Mval_ge r
  have h1 : (1 : ℝ) ≤ Real.exp ((r : ℝ) ^ 43) := Real.one_le_exp (by positivity)
  have h2 : (2 : ℝ) ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) := by
    linarith [Real.add_one_le_exp (Real.exp ((r : ℝ) ^ 43))]
  exact_mod_cast h2.trans h

lemma log_Mval_ge (r : ℕ) : Real.exp ((r : ℝ) ^ 43) ≤ Real.log (Mval r) := by
  calc Real.exp ((r : ℝ) ^ 43) = Real.log (Real.exp (Real.exp ((r : ℝ) ^ 43))) :=
        (Real.log_exp _).symm
    _ ≤ Real.log (Mval r) := Real.log_le_log (Real.exp_pos _) (Mval_ge r)

lemma mem_triples {P : Par} {i a k : ℕ} (hx : (i, a, k) ∈ P.triples) :
    1 ≤ i ∧ i + 1 ≤ P.T ∧ 1 ≤ a ∧ 1 ≤ k ∧ a + k + 1 ≤ P.K := by
  simp only [Par.triples, Finset.mem_filter, Finset.mem_product, Finset.mem_Icc] at hx
  omega

lemma card_triples_le (P : Par) : (P.triples.card : ℝ) ≤ (P.T : ℝ) * (P.K : ℝ) ^ 2 := by
  have h : P.triples.card ≤ P.T * P.K ^ 2 := by
    unfold Par.triples
    calc _ ≤ ((Icc 1 (P.T - 1)) ×ˢ ((Icc 1 P.K) ×ˢ (Icc 1 P.K))).card :=
          Finset.card_filter_le _ _
      _ = (P.T - 1) * (P.K * P.K) := by simp [Finset.card_product]
      _ ≤ P.T * P.K ^ 2 := by rw [sq]; exact Nat.mul_le_mul_right _ (Nat.sub_le _ _)
  exact_mod_cast h

/- ### 7. The window: size of the shift `λT` -/

/-- For a prime tuple `pp` in the window of a triple, `T = ∏ pp ℓ > 0` and
`log |λ_{a,j} T| ≤ Qb + K·Wb`. -/
lemma window_log_le (P : Par) {i a k : ℕ} (hx : (i, a, k) ∈ P.triples)
    (pp : Fin (k + 1) → ℕ) (hpp : ∀ ℓ, pp ℓ ∈ P.win i a k ℓ) :
    0 < ∏ ℓ, (pp ℓ : ℤ) ∧
      Real.log |((((P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ) : ℤ)) : ℝ)| ≤
        Qb P + P.K * Wb P := by
  obtain ⟨hi1, hiT, ha1, hk1, hj⟩ := mem_triples hx
  have hmem : ∀ ℓ : Fin (k + 1), 2 ≤ pp ℓ ∧ (pp ℓ : ℝ) ≤ Real.exp (Wb P) := by
    intro ℓ
    have h := hpp ℓ
    simp only [Par.win, Par.Pr, primesIn, Finset.mem_filter, Finset.mem_Ico] at h
    refine ⟨h.2.two_le, ?_⟩
    have hℓ : (ℓ : ℕ) ≤ k := Nat.lt_succ_iff.mp ℓ.isLt
    have hle : 4 * P.K * i + 2 * (a + 1 + ℓ) ≤ 4 * P.K * P.T := by
      have h1 : 2 * (a + 1 + ℓ) ≤ 4 * P.K := by omega
      have h2 : 4 * P.K * (i + 1) ≤ 4 * P.K * P.T := Nat.mul_le_mul_left _ hiT
      have h3 : 4 * P.K * (i + 1) = 4 * P.K * i + 4 * P.K := by ring
      omega
    have h4 := H_le_W P hle
    have h5 : (pp ℓ : ℝ) ≤ P.H i (2 * (a + 1 + ℓ)) := by exact_mod_cast h.1.2.le
    linarith
  have hprod_pos : 0 < ∏ ℓ, (pp ℓ : ℤ) := Finset.prod_pos fun ℓ _ => by
    have := (hmem ℓ).1; omega
  refine ⟨hprod_pos, ?_⟩
  have hlamR : (P.lam a (a + k + 1) : ℝ) ≤ Real.exp (Qb P) := lam_le P hj
  have hcast : ((((P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ) : ℤ)) : ℝ) =
      (P.lam a (a + k + 1) : ℝ) * ∏ ℓ, (pp ℓ : ℝ) := by push_cast; ring
  rw [hcast]
  have hprodR : ∏ ℓ, (pp ℓ : ℝ) ≤ Real.exp (Wb P) ^ (k + 1) := by
    calc ∏ ℓ, (pp ℓ : ℝ) ≤ ∏ _ℓ : Fin (k + 1), Real.exp (Wb P) :=
          Finset.prod_le_prod (fun ℓ _ => Nat.cast_nonneg _) fun ℓ _ => (hmem ℓ).2
      _ = Real.exp (Wb P) ^ (k + 1) := by rw [Finset.prod_const, Finset.card_fin]
  have hpos : 0 < (P.lam a (a + k + 1) : ℝ) * ∏ ℓ, (pp ℓ : ℝ) := by
    apply mul_pos (by exact_mod_cast lam_pos P _ _)
    exact Finset.prod_pos fun ℓ _ => by
      have := (hmem ℓ).1
      exact_mod_cast (by omega : 0 < pp ℓ)
  rw [abs_of_pos hpos, Real.log_le_iff_le_exp hpos]
  calc (P.lam a (a + k + 1) : ℝ) * ∏ ℓ, (pp ℓ : ℝ)
      ≤ Real.exp (Qb P) * Real.exp (Wb P) ^ (k + 1) :=
        mul_le_mul hlamR hprodR (Finset.prod_nonneg fun _ _ => Nat.cast_nonneg _)
          (Real.exp_pos _).le
    _ = Real.exp (Qb P + ((k + 1 : ℕ) : ℝ) * Wb P) := by rw [Real.exp_add, Real.exp_nat_mul]
    _ ≤ Real.exp (Qb P + P.K * Wb P) := by
        apply Real.exp_le_exp.mpr
        have : ((k + 1 : ℕ) : ℝ) ≤ P.K := by exact_mod_cast (by omega : k + 1 ≤ P.K)
        nlinarith [Wb_nonneg P]

/- ### 8. The bound for one triple -/

/-- `E_x = ∑_c ‖P^s f_c - P^ℓ f_c‖²` for the triple `x = (i, a, k)`. -/
noncomputable def Ex (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i a k : ℕ) : ℝ :=
  ∑ c, normSq (Mval P.r) (fun n => fS P χ i a k c n - fL P χ i a k c n)

lemma Ex_nonneg (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i a k : ℕ) :
    0 ≤ Ex P χ i a k :=
  Finset.sum_nonneg fun _ _ => normSq_nonneg _ _

/-- The uniform bound for the shift error `C_{A2}(1 + log(λT))/log M`. -/
noncomputable def epsB (P : Par) (CA2 : ℝ) : ℝ :=
  CA2 * (1 + Qb P + P.K * Wb P) / Real.exp ((P.r : ℝ) ^ 43)

lemma epsB_nonneg (P : Par) {CA2 : ℝ} (hCA2 : 0 ≤ CA2) : 0 ≤ epsB P CA2 := by
  unfold epsB
  have := Qb_nonneg P
  have := Wb_nonneg P
  positivity

/-- The bound for one triple: `|corr(P^s f) - corr(P^ℓ f)| ≤ √E_x + ε`. -/
lemma triple_bound (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) {CA2 : ℝ}
    (hCA2 : 0 ≤ CA2) (hA2 : LemmaA2With CA2) {i a k : ℕ} (hx : (i, a, k) ∈ P.triples) :
    |corr P χ i a k (fS P χ i a k) - corr P χ i a k (fL P χ i a k)| ≤
      Real.sqrt (Ex P χ i a k) + epsB P CA2 := by
  have hM := two_le_Mval P.r
  have hLM := log_Mval_ge P.r
  rw [corr_sub]
  unfold Wexp
  refine abs_iterAvg_le_mem _ _ (add_nonneg (Real.sqrt_nonneg _) (epsB_nonneg P hCA2))
    fun pp hpp => ?_
  obtain ⟨hTpos, hlog⟩ := window_log_le P hx pp hpp
  have hh : ((P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ)) ≠ 0 := by
    have : (0 : ℤ) < P.lam a (a + k + 1) := by exact_mod_cast lam_pos P _ _
    positivity
  refine (pointwise_bound univ hA2 hM (fun c m => fS P χ i a k c m - fL P χ i a k c m)
    (fun c n => gT P χ (a + k + 1) c (∏ ℓ, (pp ℓ : ℤ)) n) ?_ ?_ ?_ ?_ _ hh).trans ?_
  · intro c m
    have h1 := proj_nonneg (q := P.q a (a + k)) (H := P.H (i + 1) 0) (f := fa P χ a c)
      (fun n => ind_nonneg χ c _) m
    have h2 := proj_le_one (q := P.q a (a + k)) (H := P.H (i + 1) 0) (f := fa P χ a c)
      (fun n => ind_le_one χ c _) m
    have h3 := proj_nonneg (q := P.q a (a + k + 1)) (H := P.H i 0) (f := fa P χ a c)
      (fun n => ind_nonneg χ c _) m
    have h4 := proj_le_one (q := P.q a (a + k + 1)) (H := P.H i 0) (f := fa P χ a c)
      (fun n => ind_le_one χ c _) m
    simp only [fS, fL]
    rw [abs_le]; constructor <;> linarith
  · intro c n; exact ind_nonneg χ c _
  · intro c n; exact ind_le_one χ c _
  · intro n; exact sum_ind_le_one χ _
  · refine add_le_add le_rfl ?_
    unfold epsB
    have hlog0 : 0 ≤ Real.log |((((P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ) : ℤ)) : ℝ)| := by
      apply Real.log_nonneg
      have : (1 : ℤ) ≤ |(P.lam a (a + k + 1) : ℤ) * ∏ ℓ, (pp ℓ : ℤ)| := by
        exact Int.one_le_abs hh
      exact_mod_cast this
    apply div_le_div₀ (by have := Qb_nonneg P; have := Wb_nonneg P; positivity) _
      (Real.exp_pos _) hLM
    exact mul_le_mul_of_nonneg_left (by linarith) hCA2

/- ### 9. The energy increment (GS Lemma 6.4) and telescoping -/

/-- The error term of Lemma 6.4 for the triple `(i, a, k)`. -/
noncomputable def errE (P : Par) (C64 : ℝ) (i a k : ℕ) : ℝ :=
  C64 * (Real.log ((P.q a (a + k + 1) : ℝ) * (P.H (i + 1) 0 : ℝ)) / Real.log (Mval P.r) +
    (P.q a (a + k + 1) : ℝ) * (P.H i 0 : ℝ) / ((P.q a (a + k) : ℝ) * (P.H (i + 1) 0 : ℝ)))

/-- Uniform bound for `errE`. -/
noncomputable def errMax (P : Par) (C64 : ℝ) : ℝ :=
  C64 * ((Qb P + Wb P) / Real.exp ((P.r : ℝ) ^ 43) +
    Real.exp (Qb P + 2 - Real.exp (4 * P.L * P.K)))

lemma errMax_nonneg (P : Par) {C64 : ℝ} (hC64 : 0 ≤ C64) : 0 ≤ errMax P C64 := by
  unfold errMax
  have := Qb_nonneg P
  have := Wb_nonneg P
  positivity

/-- GS Lemma 6.4 with `q = q_{a,j-1}`, `q' = q_{a,j}`, `H = H_{i+1,0}`, `H' = H_{i,0}`,
summed over the colours. -/
lemma energy_step (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) {C64 : ℝ}
    (h64 : Lemma64With C64) (i a k : ℕ) :
    Ex P χ i a k ≤ Y P χ a i (a + k + 1) - Y P χ a (i + 1) (a + k) + P.r * errE P C64 i a k := by
  have key : ∀ c, normSq (Mval P.r) (fun n => fS P χ i a k c n - fL P χ i a k c n) ≤
      normSq (Mval P.r) (proj (P.q a (a + k + 1)) (P.H i 0) (fa P χ a c)) -
        normSq (Mval P.r) (proj (P.q a (a + k)) (P.H (i + 1) 0) (fa P χ a c)) +
          errE P C64 i a k := by
    intro c
    have h := h64 (Mval P.r) (P.q a (a + k)) (P.q a (a + k + 1)) (P.H (i + 1) 0) (P.H i 0)
      (two_le_Mval P.r) (q_pos P a (a + k)) (q_dvd P a k) (q_pos P a (a + k + 1))
      (H_pos P i 0) (H_mono P i)
      (fa P χ a c) (fun n => abs_ind_le_one χ c _)
    have e : normSq (Mval P.r) (fun n => fS P χ i a k c n - fL P χ i a k c n) =
        normSq (Mval P.r) (fun n => proj (P.q a (a + k + 1)) (P.H i 0) (fa P χ a c) n -
          proj (P.q a (a + k)) (P.H (i + 1) 0) (fa P χ a c) n) :=
      wavg_congr fun n _ => by simp only [fS, fL]; ring
    rw [e]
    exact h
  unfold Ex Y
  calc ∑ c, normSq (Mval P.r) (fun n => fS P χ i a k c n - fL P χ i a k c n)
      ≤ ∑ c, (normSq (Mval P.r) (proj (P.q a (a + k + 1)) (P.H i 0) (fa P χ a c)) -
          normSq (Mval P.r) (proj (P.q a (a + k)) (P.H (i + 1) 0) (fa P χ a c)) +
            errE P C64 i a k) := Finset.sum_le_sum fun c _ => key c
    _ = _ := by
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_fin,
        nsmul_eq_mul]

/-- On the admissible triples the error of Lemma 6.4 is uniformly bounded by `errMax`. -/
lemma errE_le (P : Par) {C64 : ℝ} (hC64 : 0 ≤ C64) {i a k : ℕ} (hx : (i, a, k) ∈ P.triples) :
    errE P C64 i a k ≤ errMax P C64 := by
  obtain ⟨hi1, hiT, ha1, hk1, hj⟩ := mem_triples hx
  unfold errE errMax
  refine mul_le_mul_of_nonneg_left (add_le_add ?_ (ratio_le P i hj)) hC64
  have hq' := q_le P (a := a) hj
  have hH : (P.H (i + 1) 0 : ℝ) ≤ Real.exp (Wb P) :=
    H_le_W P (by rw [add_zero]; exact Nat.mul_le_mul_left _ hiT)
  have hpos : (0 : ℝ) < (P.q a (a + k + 1) : ℝ) * P.H (i + 1) 0 := by
    have := q_pos P a (a + k + 1)
    have := H_pos P (i + 1) 0
    positivity
  have hlog : Real.log ((P.q a (a + k + 1) : ℝ) * P.H (i + 1) 0) ≤ Qb P + Wb P := by
    rw [Real.log_le_iff_le_exp hpos, Real.exp_add]
    exact mul_le_mul hq' hH (Nat.cast_nonneg _) (Real.exp_pos _).le
  exact div_le_div₀ (add_nonneg (Qb_nonneg P) (Wb_nonneg P)) hlog (Real.exp_pos _)
    (log_Mval_ge P.r)

lemma telescope_down (f : ℕ → ℝ) (n : ℕ) :
    ∑ i ∈ Icc 1 n, (f i - f (i + 1)) = f 1 - f (n + 1) := by
  induction n with
  | zero => simp
  | succ n ih => rw [Finset.sum_Icc_succ_top (by omega), ih]; ring

lemma telescope_up (f : ℕ → ℝ) (m : ℕ) :
    ∑ k ∈ Icc 1 m, (f k - f (k - 1)) = f m - f 0 := by
  induction m with
  | zero => simp
  | succ m ih => rw [Finset.sum_Icc_succ_top (by omega), ih, Nat.add_sub_cancel]; ring

/-- Telescoping over a rectangle along the diagonal direction `(i, k) ↦ (i + 1, k - 1)`. -/
lemma rect_telescope (Z : ℕ → ℕ → ℝ) (h0 : ∀ i k, 0 ≤ Z i k) (h1 : ∀ i k, Z i k ≤ 1)
    (n m : ℕ) :
    ∑ i ∈ Icc 1 n, ∑ k ∈ Icc 1 m, (Z i k - Z (i + 1) (k - 1)) ≤ (m : ℝ) + n := by
  have split : ∀ i k, Z i k - Z (i + 1) (k - 1) =
      (Z i k - Z (i + 1) k) + (Z (i + 1) k - Z (i + 1) (k - 1)) := by intros; ring
  simp_rw [split, Finset.sum_add_distrib]
  have hA : ∑ i ∈ Icc 1 n, ∑ k ∈ Icc 1 m, (Z i k - Z (i + 1) k) ≤ m := by
    rw [Finset.sum_comm]
    calc ∑ k ∈ Icc 1 m, ∑ i ∈ Icc 1 n, (Z i k - Z (i + 1) k)
        = ∑ k ∈ Icc 1 m, (Z 1 k - Z (n + 1) k) :=
          Finset.sum_congr rfl fun k _ => telescope_down (fun i => Z i k) n
      _ ≤ ∑ _k ∈ Icc 1 m, (1 : ℝ) :=
          Finset.sum_le_sum fun k _ => by linarith [h1 1 k, h0 (n + 1) k]
      _ = m := by simp
  have hB : ∑ i ∈ Icc 1 n, ∑ k ∈ Icc 1 m, (Z (i + 1) k - Z (i + 1) (k - 1)) ≤ n := by
    calc ∑ i ∈ Icc 1 n, ∑ k ∈ Icc 1 m, (Z (i + 1) k - Z (i + 1) (k - 1))
        = ∑ i ∈ Icc 1 n, (Z (i + 1) m - Z (i + 1) 0) :=
          Finset.sum_congr rfl fun i _ => telescope_up (fun k => Z (i + 1) k) m
      _ ≤ ∑ _i ∈ Icc 1 n, (1 : ℝ) :=
          Finset.sum_le_sum fun i _ => by linarith [h1 (i + 1) m, h0 (i + 1) 0]
      _ = n := by simp
  linarith

/-- Rewriting a sum over `triples` as `∑_a ∑_i ∑_{k ≤ K-a-1}`. -/
lemma sum_triples (P : Par) (G : ℕ → ℕ → ℕ → ℝ) :
    ∑ x ∈ P.triples, G x.1 x.2.1 x.2.2 =
      ∑ a ∈ Icc 1 P.K, ∑ i ∈ Icc 1 (P.T - 1), ∑ k ∈ Icc 1 (P.K - a - 1), G i a k := by
  unfold Par.triples
  rw [Finset.sum_filter, Finset.sum_product]
  simp only [Finset.sum_product]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun i _ => ?_
  rw [← Finset.sum_filter]
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext k
  simp only [Finset.mem_filter, Finset.mem_Icc]
  omega

/-- The energy differences telescope: for each `a` the sum over the rectangle
`i ∈ [1, t-1]`, `k ∈ [1, K-a-1]` is at most `K + t`. -/
lemma telescope_triples (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) :
    ∑ x ∈ P.triples, (Y P χ x.2.1 x.1 (x.2.1 + x.2.2 + 1) - Y P χ x.2.1 (x.1 + 1) (x.2.1 + x.2.2))
      ≤ (P.K : ℝ) * (P.K + P.T) := by
  rw [sum_triples P (fun i a k => Y P χ a i (a + k + 1) - Y P χ a (i + 1) (a + k))]
  calc ∑ a ∈ Icc 1 P.K, ∑ i ∈ Icc 1 (P.T - 1), ∑ k ∈ Icc 1 (P.K - a - 1),
        (Y P χ a i (a + k + 1) - Y P χ a (i + 1) (a + k))
      ≤ ∑ a ∈ Icc 1 P.K, (((P.K - a - 1 : ℕ) : ℝ) + ((P.T - 1 : ℕ) : ℝ)) := by
        refine Finset.sum_le_sum fun a _ => ?_
        have := rect_telescope (fun i k => Y P χ a i (a + k + 1))
          (fun i k => Y_nonneg P χ a i _) (fun i k => Y_le_one P χ a i _) (P.T - 1) (P.K - a - 1)
        refine le_trans (le_of_eq ?_) this
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun k hk => ?_
        have hk1 : 1 ≤ k := (Finset.mem_Icc.mp hk).1
        have e : a + (k - 1) + 1 = a + k := by omega
        rw [e]
    _ ≤ ∑ _a ∈ Icc 1 P.K, ((P.K : ℝ) + P.T) := by
        refine Finset.sum_le_sum fun a _ => ?_
        have h1 : ((P.K - a - 1 : ℕ) : ℝ) ≤ P.K := by exact_mod_cast (by omega : P.K - a - 1 ≤ P.K)
        have h2 : ((P.T - 1 : ℕ) : ℝ) ≤ P.T := by exact_mod_cast Nat.sub_le _ _
        linarith
    _ = (P.K : ℝ) * (P.K + P.T) := by
        rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel]

/-- `∑_x E_x ≤ K(K + t) + #triples · r · errMax`. -/
lemma energy_sum (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) {C64 : ℝ} (hC64 : 0 ≤ C64)
    (h64 : Lemma64With C64) :
    ∑ x ∈ P.triples, Ex P χ x.1 x.2.1 x.2.2 ≤
      (P.K : ℝ) * (P.K + P.T) + P.triples.card * (P.r * errMax P C64) := by
  calc ∑ x ∈ P.triples, Ex P χ x.1 x.2.1 x.2.2
      ≤ ∑ x ∈ P.triples, ((Y P χ x.2.1 x.1 (x.2.1 + x.2.2 + 1) -
          Y P χ x.2.1 (x.1 + 1) (x.2.1 + x.2.2)) + P.r * errMax P C64) :=
        Finset.sum_le_sum fun x hx => by
          have h1 := energy_step P χ h64 x.1 x.2.1 x.2.2
          have h2 := errE_le P hC64 (i := x.1) (a := x.2.1) (k := x.2.2) hx
          have h3 : (0 : ℝ) ≤ P.r := Nat.cast_nonneg _
          nlinarith
    _ = ∑ x ∈ P.triples, (Y P χ x.2.1 x.1 (x.2.1 + x.2.2 + 1) -
          Y P χ x.2.1 (x.1 + 1) (x.2.1 + x.2.2)) + P.triples.card * (P.r * errMax P C64) := by
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
    _ ≤ (P.K : ℝ) * (P.K + P.T) + P.triples.card * (P.r * errMax P C64) := by
        linarith [telescope_triples P χ]

/- ### 10. Cauchy–Schwarz over the triples and the deterministic bound -/

/-- Cauchy–Schwarz: `∑_x √E_x ≤ √(#s) √(∑_x E_x)`. -/
lemma sum_sqrt_le {ι : Type*} (s : Finset ι) (E : ι → ℝ) (hE : ∀ x ∈ s, 0 ≤ E x) :
    ∑ x ∈ s, Real.sqrt (E x) ≤ Real.sqrt (s.card : ℝ) * Real.sqrt (∑ x ∈ s, E x) := by
  have h := Finset.sum_mul_sq_le_sq_mul_sq s (fun _ => (1 : ℝ)) (fun x => Real.sqrt (E x))
  have h2 : ∑ x ∈ s, Real.sqrt (E x) ^ 2 = ∑ x ∈ s, E x :=
    Finset.sum_congr rfl fun x hx => Real.sq_sqrt (hE x hx)
  simp only [one_mul, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one, h2] at h
  rw [← Real.sqrt_mul (Nat.cast_nonneg _)]
  exact (Real.le_sqrt (Finset.sum_nonneg fun x _ => Real.sqrt_nonneg _)
    (mul_nonneg (Nat.cast_nonneg _) (Finset.sum_nonneg hE))).mpr h

/-- The deterministic form of C3: the two smallness conditions on the parameters imply the
bound. -/
theorem main_bound (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) {CA2 C64 : ℝ}
    (hCA2 : 0 ≤ CA2) (hA2 : LemmaA2With CA2) (hC64 : 0 ≤ C64) (h64 : Lemma64With C64)
    (hTK : P.T = P.K)
    (h1 : (P.T : ℝ) * (P.K : ℝ) ^ 2 * epsB P CA2 ≤ 1)
    (h2 : (P.T : ℝ) * (P.K : ℝ) ^ 2 * (P.r * errMax P C64) ≤ (P.K : ℝ) ^ 2) :
    |Ssml P χ - Slrg P χ| ≤
      Real.sqrt ((P.T : ℝ) * (P.K : ℝ) ^ 2) * Real.sqrt (3 * (P.K : ℝ) ^ 2) + 1 := by
  have hcard := card_triples_le P
  have heps0 := epsB_nonneg P hCA2
  have herr0 : 0 ≤ (P.r : ℝ) * errMax P C64 :=
    mul_nonneg (Nat.cast_nonneg _) (errMax_nonneg P hC64)
  have hE0 : ∀ x ∈ P.triples, 0 ≤ Ex P χ x.1 x.2.1 x.2.2 := fun x _ => Ex_nonneg P χ _ _ _
  have hEsum : ∑ x ∈ P.triples, Ex P χ x.1 x.2.1 x.2.2 ≤ 3 * (P.K : ℝ) ^ 2 := by
    have h3 := energy_sum P χ hC64 h64
    have h4 : (P.triples.card : ℝ) * (P.r * errMax P C64) ≤ (P.K : ℝ) ^ 2 :=
      (mul_le_mul_of_nonneg_right hcard herr0).trans h2
    have hT : (P.T : ℝ) = P.K := by rw [hTK]
    rw [hT] at h3
    nlinarith
  have heps : (P.triples.card : ℝ) * epsB P CA2 ≤ 1 :=
    (mul_le_mul_of_nonneg_right hcard heps0).trans h1
  calc |Ssml P χ - Slrg P χ|
      = |∑ x ∈ P.triples, (corr P χ x.1 x.2.1 x.2.2 (fS P χ x.1 x.2.1 x.2.2) -
          corr P χ x.1 x.2.1 x.2.2 (fL P χ x.1 x.2.1 x.2.2))| := by
        unfold Ssml Slrg; rw [Finset.sum_sub_distrib]
    _ ≤ ∑ x ∈ P.triples, |corr P χ x.1 x.2.1 x.2.2 (fS P χ x.1 x.2.1 x.2.2) -
          corr P χ x.1 x.2.1 x.2.2 (fL P χ x.1 x.2.1 x.2.2)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ x ∈ P.triples, (Real.sqrt (Ex P χ x.1 x.2.1 x.2.2) + epsB P CA2) :=
        Finset.sum_le_sum fun x hx => triple_bound P χ hCA2 hA2 hx
    _ = ∑ x ∈ P.triples, Real.sqrt (Ex P χ x.1 x.2.1 x.2.2) + P.triples.card * epsB P CA2 := by
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
    _ ≤ Real.sqrt (P.triples.card : ℝ) * Real.sqrt (∑ x ∈ P.triples, Ex P χ x.1 x.2.1 x.2.2) + 1 :=
        add_le_add (sum_sqrt_le _ _ hE0) heps
    _ ≤ Real.sqrt ((P.T : ℝ) * (P.K : ℝ) ^ 2) * Real.sqrt (3 * (P.K : ℝ) ^ 2) + 1 := by
        gcongr

/- ### 11. Asymptotics of the parameters -/

lemma mul_pow_le_exp (A : ℝ) (m : ℕ) {x : ℝ} (hx0 : 0 ≤ x)
    (hx : (|A| + 1) * ((m + 1).factorial : ℝ) ≤ x) : A * x ^ m ≤ Real.exp x := by
  have h1 := Real.pow_div_factorial_le_exp x hx0 (m + 1)
  have hf : (0 : ℝ) < ((m + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have hxm : 0 ≤ x ^ m := pow_nonneg hx0 m
  have hA : A ≤ |A| + 1 := by linarith [le_abs_self A]
  have hx' : |A| + 1 ≤ x / ((m + 1).factorial : ℝ) := by rw [le_div_iff₀ hf]; exact hx
  calc A * x ^ m ≤ (|A| + 1) * x ^ m := mul_le_mul_of_nonneg_right hA hxm
    _ ≤ x / ((m + 1).factorial : ℝ) * x ^ m := mul_le_mul_of_nonneg_right hx' hxm
    _ = x ^ (m + 1) / ((m + 1).factorial : ℝ) := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h1

/-- Polynomials are eventually dominated by `exp`. -/
lemma eventually_mul_pow_le_exp (A : ℝ) (m : ℕ) :
    ∀ᶠ r : ℕ in atTop, A * (r : ℝ) ^ m ≤ Real.exp r := by
  obtain ⟨N, hN⟩ := exists_nat_ge ((|A| + 1) * ((m + 1).factorial : ℝ))
  filter_upwards [eventually_ge_atTop N] with r hr
  exact mul_pow_le_exp A m (Nat.cast_nonneg r) (hN.trans (by exact_mod_cast hr))

/-- Elementary inequalities between powers of `r ≥ 5`. -/
lemma pow_poly_facts (r : ℕ) (hr : 5 ≤ r) :
    (r : ℝ) + 4 * (r : ℝ) ^ 42 ≤ (r : ℝ) ^ 43 ∧ 3 * (r : ℝ) ^ 7 ≤ 4 * (r : ℝ) ^ 42 ∧
      (r : ℝ) ≤ (r : ℝ) ^ 7 ∧ 4 * (r : ℝ) ^ 7 + 2 ≤ 4 * (r : ℝ) ^ 35 := by
  have hR : (5 : ℝ) ≤ r := by exact_mod_cast hr
  have hR1 : (1 : ℝ) ≤ r := by linarith
  have h7 : (r : ℝ) ≤ (r : ℝ) ^ 7 := by
    simpa using pow_le_pow_right₀ hR1 (show 1 ≤ 7 by norm_num)
  have h42 : (r : ℝ) ≤ (r : ℝ) ^ 42 := by
    simpa using pow_le_pow_right₀ hR1 (show 1 ≤ 42 by norm_num)
  have h742 : (r : ℝ) ^ 7 ≤ (r : ℝ) ^ 42 := pow_le_pow_right₀ hR1 (by norm_num)
  have h28 : (r : ℝ) ≤ (r : ℝ) ^ 28 := by
    simpa using pow_le_pow_right₀ hR1 (show 1 ≤ 28 by norm_num)
  have e43 : (r : ℝ) ^ 43 = (r : ℝ) * (r : ℝ) ^ 42 := by ring
  have e35 : (r : ℝ) ^ 35 = (r : ℝ) ^ 7 * (r : ℝ) ^ 28 := by ring
  have hr7 : (1 : ℝ) ≤ (r : ℝ) ^ 7 := one_le_pow₀ hR1
  refine ⟨by nlinarith, by nlinarith, h7, by nlinarith⟩

/-- Smallness of the shift errors: `t K² ε ≤ 1` eventually. -/
lemma real_eps_bound (r C : ℕ) {A : ℝ} (hr : 5 ≤ r) (hA : 0 ≤ A)
    (h1 : 4 * A * (r : ℝ) ^ (28 + 8 * C) ≤ Real.exp r) :
    (r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2 * (A * (1 + (r : ℝ) ^ (8 * C) *
      (Real.exp (3 * (r : ℝ) ^ 7) + 1) + (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42)) /
        Real.exp ((r : ℝ) ^ 43)) ≤ 1 := by
  obtain ⟨hp43, hp3, -, -⟩ := pow_poly_facts r hr
  have hR : (5 : ℝ) ≤ r := by exact_mod_cast hr
  have hR1 : (1 : ℝ) ≤ r := by linarith
  have hD2 : (1 : ℝ) ≤ (r : ℝ) ^ (8 * C) := one_le_pow₀ hR1
  have hR7 : (1 : ℝ) ≤ (r : ℝ) ^ 7 := one_le_pow₀ hR1
  have hW1 : (1 : ℝ) ≤ Real.exp (4 * (r : ℝ) ^ 42) := Real.one_le_exp (by positivity)
  have hE3W : Real.exp (3 * (r : ℝ) ^ 7) ≤ Real.exp (4 * (r : ℝ) ^ 42) :=
    Real.exp_le_exp.mpr hp3
  have key1 : 1 + (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
      (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42) ≤
      4 * ((r : ℝ) ^ (8 * C) * (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42)) := by
    have a0 : 1 ≤ (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42) :=
      one_le_mul_of_one_le_of_one_le hR7 hW1
    have a1 : (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42) ≤
        (r : ℝ) ^ (8 * C) * ((r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42)) :=
      le_mul_of_one_le_left (by positivity) hD2
    have a2 : Real.exp (3 * (r : ℝ) ^ 7) + 1 ≤
        2 * ((r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42)) := by
      have : Real.exp (4 * (r : ℝ) ^ 42) ≤ (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42) :=
        le_mul_of_one_le_left (by positivity) hR7
      linarith
    have a3 : (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) ≤
        (r : ℝ) ^ (8 * C) * (2 * ((r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42))) :=
      mul_le_mul_of_nonneg_left a2 (by positivity)
    nlinarith
  rw [← mul_div_assoc, div_le_one (Real.exp_pos _)]
  calc (r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2 * (A * (1 + (r : ℝ) ^ (8 * C) *
        (Real.exp (3 * (r : ℝ) ^ 7) + 1) + (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42)))
      ≤ (r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2 *
          (A * (4 * ((r : ℝ) ^ (8 * C) * (r : ℝ) ^ 7 * Real.exp (4 * (r : ℝ) ^ 42)))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left key1 hA) (by positivity)
    _ = (4 * A * (r : ℝ) ^ (28 + 8 * C)) * Real.exp (4 * (r : ℝ) ^ 42) := by ring
    _ ≤ Real.exp r * Real.exp (4 * (r : ℝ) ^ 42) :=
        mul_le_mul_of_nonneg_right h1 (Real.exp_pos _).le
    _ = Real.exp ((r : ℝ) + 4 * (r : ℝ) ^ 42) := by rw [Real.exp_add]
    _ ≤ Real.exp ((r : ℝ) ^ 43) := Real.exp_le_exp.mpr hp43

/-- Smallness of the energy errors: `t K² · r · errMax ≤ K²` eventually. -/
lemma real_err_bound (r C : ℕ) {B : ℝ} (hr : 5 ≤ r) (hB : 0 ≤ B)
    (h1 : 6 * B * (r : ℝ) ^ (8 + 8 * C) ≤ Real.exp r)
    (h2 : 2 * B * (r : ℝ) ^ 8 ≤ Real.exp r)
    (h3 : 1 * (r : ℝ) ^ (8 * C) ≤ Real.exp r) :
    (r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2 * ((r : ℝ) * (B *
      (((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + Real.exp (4 * (r : ℝ) ^ 42)) /
          Real.exp ((r : ℝ) ^ 43) +
        Real.exp ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + 2 -
          Real.exp (4 * (r : ℝ) ^ 35))))) ≤ ((r : ℝ) ^ 7) ^ 2 := by
  obtain ⟨hp43, hp3, hp7, hp35⟩ := pow_poly_facts r hr
  have hR : (5 : ℝ) ≤ r := by exact_mod_cast hr
  have hR1 : (1 : ℝ) ≤ r := by linarith
  have hD2 : (1 : ℝ) ≤ (r : ℝ) ^ (8 * C) := one_le_pow₀ hR1
  have hW1 : (1 : ℝ) ≤ Real.exp (4 * (r : ℝ) ^ 42) := Real.one_le_exp (by positivity)
  have hE31 : (1 : ℝ) ≤ Real.exp (3 * (r : ℝ) ^ 7) := Real.one_le_exp (by positivity)
  have hE3W : Real.exp (3 * (r : ℝ) ^ 7) ≤ Real.exp (4 * (r : ℝ) ^ 42) :=
    Real.exp_le_exp.mpr hp3
  have hE43 : 0 < Real.exp ((r : ℝ) ^ 43) := Real.exp_pos _
  -- part (a): the `log(q'H)/log M` terms
  have hQW : (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + Real.exp (4 * (r : ℝ) ^ 42) ≤
      3 * ((r : ℝ) ^ (8 * C) * Real.exp (4 * (r : ℝ) ^ 42)) := by
    have a1 : Real.exp (3 * (r : ℝ) ^ 7) + 1 ≤ 2 * Real.exp (4 * (r : ℝ) ^ 42) := by linarith
    have a2 := mul_le_mul_of_nonneg_left a1 (by positivity : (0 : ℝ) ≤ (r : ℝ) ^ (8 * C))
    have a3 : Real.exp (4 * (r : ℝ) ^ 42) ≤ (r : ℝ) ^ (8 * C) * Real.exp (4 * (r : ℝ) ^ 42) :=
      le_mul_of_one_le_left (by positivity) hD2
    linarith
  have hA : 2 * ((r : ℝ) ^ 8 * (B * ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
      Real.exp (4 * (r : ℝ) ^ 42)))) ≤ Real.exp ((r : ℝ) ^ 43) := by
    calc 2 * ((r : ℝ) ^ 8 * (B * ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
          Real.exp (4 * (r : ℝ) ^ 42))))
        ≤ 2 * ((r : ℝ) ^ 8 * (B * (3 * ((r : ℝ) ^ (8 * C) * Real.exp (4 * (r : ℝ) ^ 42))))) := by
          have := mul_le_mul_of_nonneg_left hQW hB
          have h8 : (0 : ℝ) ≤ (r : ℝ) ^ 8 := by positivity
          have := mul_le_mul_of_nonneg_left this h8
          linarith
      _ = (6 * B * (r : ℝ) ^ (8 + 8 * C)) * Real.exp (4 * (r : ℝ) ^ 42) := by ring
      _ ≤ Real.exp r * Real.exp (4 * (r : ℝ) ^ 42) :=
          mul_le_mul_of_nonneg_right h1 (Real.exp_pos _).le
      _ = Real.exp ((r : ℝ) + 4 * (r : ℝ) ^ 42) := by rw [Real.exp_add]
      _ ≤ Real.exp ((r : ℝ) ^ 43) := Real.exp_le_exp.mpr hp43
  have hA' : (r : ℝ) ^ 8 * (B * ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
      Real.exp (4 * (r : ℝ) ^ 42))) / Real.exp ((r : ℝ) ^ 43) ≤ 1 / 2 := by
    rw [div_le_iff₀ hE43]; linarith
  -- part (b): the `q'H'/(qH)` terms
  have hQ : (r : ℝ) + (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + 2 ≤
      Real.exp (4 * (r : ℝ) ^ 35) := by
    have b1 : (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) ≤
        Real.exp r * (2 * Real.exp (3 * (r : ℝ) ^ 7)) :=
      mul_le_mul (by linarith) (by linarith) (by positivity) (Real.exp_pos _).le
    have b2 : Real.exp r * Real.exp (3 * (r : ℝ) ^ 7) ≤ Real.exp (4 * (r : ℝ) ^ 7) := by
      rw [← Real.exp_add]; apply Real.exp_le_exp.mpr; linarith
    have b3 : (r : ℝ) + 2 ≤ Real.exp (4 * (r : ℝ) ^ 7) := by
      have := Real.add_one_le_exp (4 * (r : ℝ) ^ 7)
      have : (1 : ℝ) ≤ (r : ℝ) ^ 7 := one_le_pow₀ hR1
      linarith
    have b4 : 3 * Real.exp (4 * (r : ℝ) ^ 7) ≤ Real.exp (4 * (r : ℝ) ^ 35) := by
      have e2 : (3 : ℝ) ≤ Real.exp 2 := by linarith [Real.add_one_le_exp (2 : ℝ)]
      calc 3 * Real.exp (4 * (r : ℝ) ^ 7) ≤ Real.exp 2 * Real.exp (4 * (r : ℝ) ^ 7) :=
            mul_le_mul_of_nonneg_right e2 (Real.exp_pos _).le
        _ = Real.exp (4 * (r : ℝ) ^ 7 + 2) := by rw [← Real.exp_add]; ring_nf
        _ ≤ Real.exp (4 * (r : ℝ) ^ 35) := Real.exp_le_exp.mpr hp35
    linarith
  have hB' : (r : ℝ) ^ 8 * (B * Real.exp ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
      2 - Real.exp (4 * (r : ℝ) ^ 35))) ≤ 1 / 2 := by
    have hle : Real.exp r * Real.exp ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + 2 -
        Real.exp (4 * (r : ℝ) ^ 35)) ≤ 1 := by
      rw [← Real.exp_add, Real.exp_le_one_iff]; linarith
    have := mul_le_mul_of_nonneg_right h2 (Real.exp_pos ((r : ℝ) ^ (8 * C) *
      (Real.exp (3 * (r : ℝ) ^ 7) + 1) + 2 - Real.exp (4 * (r : ℝ) ^ 35))).le
    nlinarith
  have e : (r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2 * ((r : ℝ) * (B *
      (((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + Real.exp (4 * (r : ℝ) ^ 42)) /
          Real.exp ((r : ℝ) ^ 43) +
        Real.exp ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) + 2 -
          Real.exp (4 * (r : ℝ) ^ 35))))) =
      ((r : ℝ) ^ 7) ^ 2 * ((r : ℝ) ^ 8 * (B * ((r : ℝ) ^ (8 * C) *
        (Real.exp (3 * (r : ℝ) ^ 7) + 1) + Real.exp (4 * (r : ℝ) ^ 42))) /
          Real.exp ((r : ℝ) ^ 43) +
        (r : ℝ) ^ 8 * (B * Real.exp ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
          2 - Real.exp (4 * (r : ℝ) ^ 35)))) := by
    ring
  rw [e]
  calc ((r : ℝ) ^ 7) ^ 2 * ((r : ℝ) ^ 8 * (B * ((r : ℝ) ^ (8 * C) *
        (Real.exp (3 * (r : ℝ) ^ 7) + 1) + Real.exp (4 * (r : ℝ) ^ 42))) /
          Real.exp ((r : ℝ) ^ 43) +
        (r : ℝ) ^ 8 * (B * Real.exp ((r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) +
          2 - Real.exp (4 * (r : ℝ) ^ 35))))
      ≤ ((r : ℝ) ^ 7) ^ 2 * 1 :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    _ = ((r : ℝ) ^ 7) ^ 2 := mul_one _

/-- Eventually `t K² ε ≤ 1`. -/
lemma ev_eps (C : ℕ) {CA2 : ℝ} (hCA2 : 0 ≤ CA2) :
    ∀ᶠ r : ℕ in atTop,
      ((⟨r, C⟩ : Par).T : ℝ) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 * epsB ⟨r, C⟩ CA2 ≤ 1 := by
  filter_upwards [eventually_mul_pow_le_exp (4 * CA2) (28 + 8 * C), eventually_ge_atTop 5]
    with r h1 hr
  have eQ : Qb ⟨r, C⟩ = (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) := by
    simp only [Qb, Par.d, Par.K]; push_cast; ring
  have eW : Wb ⟨r, C⟩ = Real.exp (4 * (r : ℝ) ^ 42) := by
    simp only [Wb, Par.L, Par.K, Par.T]; push_cast; ring_nf
  have := real_eps_bound r C hr hCA2 h1
  simp only [epsB, eQ, eW, Par.T, Par.K]
  push_cast
  convert this using 2

/-- Eventually `t K² · r · errMax ≤ K²`. -/
lemma ev_err (C : ℕ) {C64 : ℝ} (hC64 : 0 ≤ C64) :
    ∀ᶠ r : ℕ in atTop,
      ((⟨r, C⟩ : Par).T : ℝ) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 * (r * errMax ⟨r, C⟩ C64) ≤
        ((⟨r, C⟩ : Par).K : ℝ) ^ 2 := by
  filter_upwards [eventually_mul_pow_le_exp (6 * C64) (8 + 8 * C),
    eventually_mul_pow_le_exp (2 * C64) 8, eventually_mul_pow_le_exp 1 (8 * C),
    eventually_ge_atTop 5] with r h1 h2 h3 hr
  have eQ : Qb ⟨r, C⟩ = (r : ℝ) ^ (8 * C) * (Real.exp (3 * (r : ℝ) ^ 7) + 1) := by
    simp only [Qb, Par.d, Par.K]; push_cast; ring
  have eW : Wb ⟨r, C⟩ = Real.exp (4 * (r : ℝ) ^ 42) := by
    simp only [Wb, Par.L, Par.K, Par.T]; push_cast; ring_nf
  have := real_err_bound r C hr hC64 h1 h2 h3
  simp only [errMax, eQ, eW, Par.T, Par.K, Par.L]
  push_cast
  rw [show (4 : ℝ) * (r : ℝ) ^ 28 * (r : ℝ) ^ 7 = 4 * (r : ℝ) ^ 35 by ring]
  convert this using 2

/- ### 12. The claim -/

/-- **C3** (draft §5, (16)–(19)): replacing the small projections by the large ones. -/
theorem ssml_sub_slrg' (C : ℕ) (hC : 1 ≤ C) (CA2 : ℝ) (hCA2 : 0 ≤ CA2) (hA2 : LemmaA2With CA2)
    (C64 : ℝ) (hC64 : 0 ≤ C64) (h64 : Lemma64With C64) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r,
      |Ssml ⟨r, C⟩ χ - Slrg ⟨r, C⟩ χ| ≤
        Real.sqrt (((⟨r, C⟩ : Par).T : ℝ) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) *
          Real.sqrt (3 * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) + 1 := by
  filter_upwards [ev_eps C hCA2, ev_err C hC64] with r h1 h2 χ
  exact main_bound ⟨r, C⟩ χ hCA2 hA2 hC64 h64 rfl h1 h2

end G22.C3

end

/- ## Section: `C4` -/

section

/-
# Claim C4: `|corr(P^ℓ f) - corr(f)| ≤ 2δ` for every triple

This is the draft's §6 ((20)–(24)). Fix a triple `(i, a, k)`, `j = a + k + 1`, `λ = λ_{a,j}`,
`q = q_{a,j} = λV` and `P = Π_{q, H_{i,0}}` (so `fL c = P (fa c)`). Write
`R = corr(P f) - corr(f) = ∑_c E[(P f_c - f_c)(n + λT) 1_{A_c}(b_j T n)]`.

1. **Random signs** (`sum_Y`, `abs_corr_sub_le`). For `σ : Fin r → Bool` with signs
   `s(σ c) = ±1`, put `u_σ = ∑_c s(σ c) f_c`, `f₁ = (P u_σ - u_σ)/2` and
   `f₂ = ∑_c s(σ c) 1_{A_c}(b_a² ·)`. Since `b_a² λ = b_j` and `E_σ s(σ c) s(σ d) = [c = d]`,
   `2 ∑_σ Y_σ = 2^r R` where `Y_σ = E[f₁(n + λT) f₂(λnT)]` (`Y` below). Hence it suffices to show
   `|Y_σ| ≤ δ` for every `σ`.
2. **Proposition 5.1** (`abs_Y_lt`). `f₁, f₂` are 1-bounded; if `|Y_σ| ≥ δ` then GS Prop. 5.1
   (with the window of prime intervals `[H_{i,2h-1}, H_{i,2h})`, `P'₁ = H_{i,2a+1}`,
   `P'₂ = H_{i,2(a+k)}²`, the dilation `λ` and `H = H_{i,0}²`) gives
   `c δ^{C'} ≤ ‖f₁‖_{U¹_log[M; λV, H_{i,0}²]}`.
3. **GS Lemma 6.3** (`sqrt_U1logSq_le`, proved here):
   `‖(Π_{q,H'} u - u)/2‖_{U¹_log[N; q, H'²]} ≤ 1/H'` for 1-bounded `u`, because shifting a
   uniform average over `[1, H'²]` by `|s| < H'` costs at most `2H'/H'²`.
4. **Parameters** (`small_cond` and the other `*_cond` lemmas): for large `r` all the
   hypotheses of Prop. 5.1 hold uniformly over the triples, and `1/H_{i,0} < c δ^{C'}`,
   a contradiction.
-/

open Finset Filter

namespace G22
namespace C4

/- ### Uniform averages -/

lemma uavg_eq (H : ℕ) (f : ℕ → ℝ) : uavg H f = (∑ h ∈ Icc 1 H, f h) / H := by
  simp [uavg, wavg]

lemma uavg_comm (A B : ℕ) (F : ℕ → ℕ → ℝ) :
    uavg A (fun x => uavg B (fun y => F x y)) = uavg B (fun y => uavg A (fun x => F x y)) := by
  simp only [uavg_eq, ← Finset.sum_div]
  rw [Finset.sum_comm]
  ring

lemma abs_uavg_le {H : ℕ} (hH : 1 ≤ H) {f : ℕ → ℝ} {c : ℝ} (hf : ∀ h ∈ Icc 1 H, |f h| ≤ c) :
    |uavg H f| ≤ c :=
  abs_wavg_le_of_abs_le (goodWeights_uavg hH) hf

lemma uavg_sub_const {H : ℕ} (hH : 1 ≤ H) (f : ℕ → ℝ) (c : ℝ) :
    uavg H (fun x => f x - c) = uavg H f - c := by
  unfold uavg
  rw [wavg_sub, wavg_const (goodWeights_uavg hH)]

/- ### Shifting a uniform average -/

lemma sum_shift_succ (g : ℤ → ℝ) (t : ℤ) : ∀ H : ℕ,
    ∑ h ∈ Icc 1 H, g ((h : ℤ) + (t + 1)) - ∑ h ∈ Icc 1 H, g ((h : ℤ) + t) =
      g ((H : ℤ) + 1 + t) - g (1 + t)
  | 0 => by simp
  | H + 1 => by
    rw [Finset.sum_Icc_succ_top (by omega), Finset.sum_Icc_succ_top (by omega)]
    have ih := sum_shift_succ g t H
    have e1 : ((H + 1 : ℕ) : ℤ) + (t + 1) = ((H : ℤ) + 1 + 1 + t) := by push_cast; ring
    have e2 : ((H + 1 : ℕ) : ℤ) + t = (H : ℤ) + 1 + t := by push_cast; ring
    have e3 : (((H + 1 : ℕ) : ℤ) + 1 + t) = ((H : ℤ) + 1 + 1 + t) := by push_cast; ring
    rw [e1, e2, e3]
    linarith

lemma abs_sum_shift (g : ℤ → ℝ) (hg : ∀ m, |g m| ≤ 1) (H : ℕ) (s : ℤ) :
    |∑ h ∈ Icc 1 H, g ((h : ℤ) + s) - ∑ h ∈ Icc 1 H, g ((h : ℤ) + 0)| ≤ 2 * |(s : ℝ)| := by
  set A : ℤ → ℝ := fun t => ∑ h ∈ Icc 1 H, g ((h : ℤ) + t) with hA
  have step : ∀ t : ℤ, |A (t + 1) - A t| ≤ 2 := by
    intro t
    simp only [hA]
    rw [sum_shift_succ g t H]
    have h1 := hg ((H : ℤ) + 1 + t)
    have h2 := hg (1 + t)
    calc _ ≤ |g ((H : ℤ) + 1 + t)| + |g (1 + t)| := abs_sub _ _
      _ ≤ 2 := by linarith
  show |A s - A 0| ≤ 2 * |(s : ℝ)|
  refine Int.induction_on s ?_ ?_ ?_
  · simp
  · intro i ih
    have hs := step (i : ℤ)
    calc |A ((i : ℤ) + 1) - A 0| ≤ |A ((i : ℤ) + 1) - A i| + |A i - A 0| := abs_sub_le _ _ _
      _ ≤ 2 + 2 * |(((i : ℤ)) : ℝ)| := by linarith
      _ = 2 * |((((i : ℤ) + 1 : ℤ)) : ℝ)| := by
          push_cast
          rw [abs_of_nonneg (by positivity), abs_of_nonneg (by positivity)]
          ring
  · intro i ih
    have hs := step (-(i : ℤ) - 1)
    rw [show -(i : ℤ) - 1 + 1 = -(i : ℤ) by ring, abs_sub_comm] at hs
    calc |A (-(i : ℤ) - 1) - A 0| ≤ |A (-(i : ℤ) - 1) - A (-(i : ℤ))| + |A (-(i : ℤ)) - A 0| :=
          abs_sub_le _ _ _
      _ ≤ 2 + 2 * |((-(i : ℤ) : ℤ) : ℝ)| := by linarith
      _ = 2 * |((-(i : ℤ) - 1 : ℤ) : ℝ)| := by
          push_cast
          rw [abs_neg, abs_of_nonneg (by positivity),
            abs_of_nonpos (by linarith [(i.cast_nonneg : (0 : ℝ) ≤ i)])]
          ring

/-- Shifting the uniform average over `[1, H]` of a 1-bounded function by `s` changes it by at
most `2|s|/H`. -/
lemma abs_uavg_shift (g : ℤ → ℝ) (hg : ∀ m, |g m| ≤ 1) {H : ℕ} (hH : 1 ≤ H) (s : ℤ) :
    |uavg H (fun h => g ((h : ℤ) + s) - g h)| ≤ 2 * |(s : ℝ)| / H := by
  rw [uavg_eq, Finset.sum_sub_distrib, abs_div]
  have hH' : (0 : ℝ) < H := by exact_mod_cast hH
  rw [abs_of_pos hH']
  apply div_le_div_of_nonneg_right _ hH'.le
  simpa using abs_sum_shift g hg H s

/- ### GS Lemma 6.3 -/

/-- Pointwise form of GS Lemma 6.3. -/
lemma abs_uavg_proj_sub (u : ℤ → ℝ) (hu : ∀ m, |u m| ≤ 1) (q H' Hh : ℕ) (hH' : 1 ≤ H')
    (hHh : 1 ≤ Hh) (n : ℤ) :
    |uavg Hh (fun h => proj q H' u (n + q * h) - u (n + q * h))| ≤ 2 * H' / Hh := by
  have h1 : ∀ h : ℕ, proj q H' u (n + q * h) - u (n + q * h) =
      uavg H' (fun h1 => uavg H' (fun h2 =>
        u (n + q * h + q * ((h1 : ℤ) - h2)) - u (n + q * h))) := by
    intro h
    unfold proj
    rw [show (fun h1 : ℕ => uavg H' (fun h2 : ℕ =>
        u (n + q * h + q * ((h1 : ℤ) - h2)) - u (n + q * h))) =
        fun h1 : ℕ => uavg H' (fun h2 : ℕ => u (n + q * h + q * ((h1 : ℤ) - h2))) - u (n + q * h)
        from funext fun h1 => uavg_sub_const hH' _ _]
    rw [uavg_sub_const hH']
  simp_rw [h1]
  rw [uavg_comm]
  simp_rw [uavg_comm Hh H']
  apply abs_uavg_le hH'
  intro h1 hh1
  apply abs_uavg_le hH'
  intro h2 hh2
  rw [Finset.mem_Icc] at hh1 hh2
  have key := abs_uavg_shift (fun m : ℤ => u (n + q * m)) (fun m => hu _) hHh ((h1 : ℤ) - h2)
  have e : (fun h : ℕ => u (n + q * h + q * ((h1 : ℤ) - h2)) - u (n + q * h)) =
      fun h : ℕ => (fun m : ℤ => u (n + q * m)) ((h : ℤ) + ((h1 : ℤ) - h2)) -
        (fun m : ℤ => u (n + q * m)) h := by
    funext h
    simp only
    congr 2
    ring
  rw [e]
  refine key.trans ?_
  have hHh' : (0 : ℝ) < Hh := by exact_mod_cast hHh
  apply div_le_div_of_nonneg_right _ hHh'.le
  have : |(((h1 : ℤ) - h2 : ℤ) : ℝ)| ≤ H' := by
    push_cast
    rw [abs_le]
    have a1 : (1 : ℝ) ≤ h1 := by exact_mod_cast hh1.1
    have a2 : (h1 : ℝ) ≤ H' := by exact_mod_cast hh1.2
    have a3 : (1 : ℝ) ≤ h2 := by exact_mod_cast hh2.1
    have a4 : (h2 : ℝ) ≤ H' := by exact_mod_cast hh2.2
    constructor <;> linarith
  linarith

/-- GS Lemma 6.3 in the form needed: `‖(Π_{q,H'} u - u)/2‖_{U¹_log[N; q, H'^2]} ≤ 1/H'`. -/
lemma sqrt_U1logSq_le (u : ℤ → ℝ) (hu : ∀ m, |u m| ≤ 1) (N q H' : ℕ) (hN : 1 ≤ N)
    (hH' : 1 ≤ H') :
    Real.sqrt (U1logSq N q (H' ^ 2) (fun n => (proj q H' u n - u n) / 2)) ≤ 1 / H' := by
  have hH'0 : (0 : ℝ) < H' := by exact_mod_cast hH'
  have hpt : ∀ n : ℤ,
      |uavg (H' ^ 2) (fun h => (proj q H' u (n + q * h) - u (n + q * h)) / 2)| ≤ 1 / H' := by
    intro n
    have := abs_uavg_proj_sub u hu q H' (H' ^ 2) hH' (Nat.one_le_pow _ _ hH') n
    have e : uavg (H' ^ 2) (fun h => (proj q H' u (n + q * h) - u (n + q * h)) / 2) =
        (1 / 2) * uavg (H' ^ 2) (fun h => proj q H' u (n + q * h) - u (n + q * h)) := by
      unfold uavg
      rw [← wavg_smul]
      exact wavg_congr fun h _ => by ring
    rw [e, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    have e2 : (2 : ℝ) * H' / ((H' ^ 2 : ℕ) : ℝ) = 2 * (1 / H') := by
      push_cast
      field_simp
    rw [e2] at this
    linarith
  unfold U1logSq
  have hb : logAvg N (fun n => (uavg (H' ^ 2)
      (fun h => (proj q H' u (n + q * h) - u (n + q * h)) / 2)) ^ 2) ≤ (1 / (H' : ℝ)) ^ 2 := by
    unfold logAvg
    apply wavg_le_of_le (goodWeights_logAvg hN)
    intro n _
    have := pow_le_pow_left₀ (abs_nonneg _) (hpt n) 2
    rwa [sq_abs] at this
  calc Real.sqrt _ ≤ Real.sqrt ((1 / (H' : ℝ)) ^ 2) := Real.sqrt_le_sqrt hb
    _ = 1 / H' := Real.sqrt_sq (by positivity)

/- ### Linearity -/

lemma proj_sum (q H : ℕ) {ι : Type*} (t : Finset ι) (w : ι → ℝ) (F : ι → ℤ → ℝ) (n : ℤ) :
    proj q H (fun m => ∑ x ∈ t, w x * F x m) n = ∑ x ∈ t, w x * proj q H (F x) n := by
  unfold proj uavg
  simp only [wavg_sum, wavg_smul]

lemma abs_proj_le (q H : ℕ) (hH : 1 ≤ H) (f : ℤ → ℝ) (hf : ∀ m, |f m| ≤ 1) (n : ℤ) :
    |proj q H f n| ≤ 1 :=
  abs_uavg_le hH fun _ _ => abs_uavg_le hH fun _ _ => hf _

lemma Wexp_sum (P : Par) (i a k : ℕ) {ι : Type*} (t : Finset ι) (Φ : ι → ℤ → ℤ → ℝ) :
    Wexp P i a k (fun n T => ∑ x ∈ t, Φ x n T) = ∑ x ∈ t, Wexp P i a k (Φ x) := by
  unfold Wexp logAvg
  simp only [wavg_sum]
  exact iterAvg_sum _ _ _

lemma Wexp_smul (P : Par) (i a k : ℕ) (c : ℝ) (Φ : ℤ → ℤ → ℝ) :
    Wexp P i a k (fun n T => c * Φ n T) = c * Wexp P i a k Φ := by
  unfold Wexp logAvg
  simp only [wavg_smul]
  exact iterAvg_smul _ _ _

lemma Wexp_sub (P : Par) (i a k : ℕ) (Φ Ψ : ℤ → ℤ → ℝ) :
    Wexp P i a k (fun n T => Φ n T - Ψ n T) = Wexp P i a k Φ - Wexp P i a k Ψ := by
  unfold Wexp logAvg
  simp only [wavg_sub]
  exact iterAvg_sub _ _ _

lemma Wexp_congr (P : Par) (i a k : ℕ) {Φ Ψ : ℤ → ℤ → ℝ} (h : ∀ n T, Φ n T = Ψ n T) :
    Wexp P i a k Φ = Wexp P i a k Ψ := by
  have : Φ = Ψ := funext fun n => funext fun T => h n T
  rw [this]

/- ### Random signs -/

/-- `s(true) = 1`, `s(false) = -1`. -/
def sgn (b : Bool) : ℝ := if b then 1 else -1

lemma sgn_mul_self (b : Bool) : sgn b * sgn b = 1 := by cases b <;> norm_num [sgn]

lemma abs_sgn (b : Bool) : |sgn b| = 1 := by cases b <;> norm_num [sgn]

/-- `E_σ s(σ c) s(σ d) = [c = d]`. -/
lemma sum_sgn_mul_sgn {r : ℕ} (c d : Fin r) :
    ∑ σ : Fin r → Bool, sgn (σ c) * sgn (σ d) = if c = d then (2 : ℝ) ^ r else 0 := by
  split_ifs with h
  · subst h
    simp [sgn_mul_self]
  · let e : (Fin r → Bool) → (Fin r → Bool) := fun σ => Function.update σ c (!σ c)
    have he : Function.Involutive e := by
      intro σ
      funext x
      by_cases hx : x = c
      · subst hx; simp [e]
      · simp [e, hx]
    have key : ∑ σ : Fin r → Bool, sgn (σ c) * sgn (σ d) =
        ∑ σ : Fin r → Bool, sgn (e σ c) * sgn (e σ d) :=
      (Equiv.sum_comp (he.toPerm e) (fun σ => sgn (σ c) * sgn (σ d))).symm
    have hflip : ∀ σ : Fin r → Bool, sgn (e σ c) * sgn (e σ d) = -(sgn (σ c) * sgn (σ d)) := by
      intro σ
      have hd : e σ d = σ d := by simp [e, Function.update_of_ne (Ne.symm h)]
      have hc : e σ c = !σ c := by simp [e]
      rw [hd, hc]
      cases σ c <;> cases σ d <;> norm_num [sgn]
    rw [Finset.sum_congr rfl (fun σ _ => hflip σ), Finset.sum_neg_distrib] at key
    linarith

/- ### The random-sign decomposition -/

section core
variable (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r)

/-- `u_σ = ∑_c s(σ c) f_{a,c}`. -/
noncomputable def uσ (a : ℕ) (σ : Fin P.r → Bool) (n : ℤ) : ℝ := ∑ c, sgn (σ c) * fa P χ a c n

/-- `f₁ = (Π_{q_{a,j}, H_{i,0}} u_σ - u_σ) / 2`. -/
noncomputable def f1 (i a k : ℕ) (σ : Fin P.r → Bool) (n : ℤ) : ℝ :=
  (proj (P.q a (a + k + 1)) (P.H i 0) (uσ P χ a σ) n - uσ P χ a σ n) / 2

/-- `f₂ = ∑_c s(σ c) 1_{A_c}(b_a² ·)`. -/
noncomputable def f2 (a : ℕ) (σ : Fin P.r → Bool) (m : ℤ) : ℝ :=
  ∑ c, sgn (σ c) * ind χ c ((P.b a : ℤ) ^ 2 * m)

/-- The average to which Proposition 5.1 is applied. -/
noncomputable def Y (i a k : ℕ) (σ : Fin P.r → Bool) : ℝ :=
  Wexp P i a k (fun n T => f1 P χ i a k σ (n + (P.lam a (a + k + 1) : ℤ) * T) *
    f2 P χ a σ ((P.lam a (a + k + 1) : ℤ) * n * T))

/-- `W_{c,d} = E[(P^ℓ f_c - f_c)(n + λT) 1_{A_d}(b_j T n)]`. -/
noncomputable def W (i a k : ℕ) (c d : Fin P.r) : ℝ :=
  Wexp P i a k (fun n T => (fL P χ i a k c (n + (P.lam a (a + k + 1) : ℤ) * T) -
    fa P χ a c (n + (P.lam a (a + k + 1) : ℤ) * T)) * gT P χ (a + k + 1) d T n)

omit χ in
lemma b_sq_mul_lam (a j : ℕ) (h : a < j) : P.b a ^ 2 * P.lam a j = P.b j := by
  unfold Par.b Par.lam
  rw [← pow_mul, ← pow_add]
  congr 1
  have : 2 * 4 ^ a ≤ 4 ^ j := by
    calc 2 * 4 ^ a ≤ 4 * 4 ^ a := by omega
      _ = 4 ^ (a + 1) := by ring
      _ ≤ 4 ^ j := Nat.pow_le_pow_right (by norm_num) h
  rw [mul_comm]
  exact Nat.add_sub_cancel' this

lemma corr_sub_eq (i a k : ℕ) :
    corr P χ i a k (fL P χ i a k) - corr P χ i a k (fun c => fa P χ a c) =
      ∑ c, W P χ i a k c c := by
  unfold corr
  rw [← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [← Wexp_sub]
  unfold W
  exact Wexp_congr _ _ _ _ fun n T => by ring

lemma f1_eq (i a k : ℕ) (σ : Fin P.r → Bool) (m : ℤ) :
    f1 P χ i a k σ m = (1 / 2) * ∑ c, sgn (σ c) * (fL P χ i a k c m - fa P χ a c m) := by
  unfold f1 uσ fL
  rw [proj_sum, ← Finset.sum_sub_distrib]
  simp only [mul_sub]
  ring

lemma f2_eq (a k : ℕ) (σ : Fin P.r → Bool) (n T : ℤ) :
    f2 P χ a σ ((P.lam a (a + k + 1) : ℤ) * n * T) =
      ∑ d, sgn (σ d) * gT P χ (a + k + 1) d T n := by
  unfold f2 gT
  have hb : ((P.b a : ℤ)) ^ 2 * (P.lam a (a + k + 1) : ℤ) = (P.b (a + k + 1) : ℤ) := by
    exact_mod_cast b_sq_mul_lam P a (a + k + 1) (by omega)
  have e : ((P.b a : ℤ)) ^ 2 * ((P.lam a (a + k + 1) : ℤ) * n * T) =
      (P.b (a + k + 1) : ℤ) * T * n := by
    rw [← hb]; ring
  rw [e]

lemma Y_eq (i a k : ℕ) (σ : Fin P.r → Bool) :
    Y P χ i a k σ = (1 / 2) * ∑ c, ∑ d, (sgn (σ c) * sgn (σ d)) * W P χ i a k c d := by
  unfold Y
  rw [Wexp_congr P i a k (Ψ := fun n T => (1 / 2) * ∑ c, ∑ d, (sgn (σ c) * sgn (σ d)) *
      ((fL P χ i a k c (n + (P.lam a (a + k + 1) : ℤ) * T) -
        fa P χ a c (n + (P.lam a (a + k + 1) : ℤ) * T)) * gT P χ (a + k + 1) d T n)) ?_]
  · rw [Wexp_smul, Wexp_sum]
    congr 1
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [Wexp_sum]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [Wexp_smul]
    rfl
  · intro n T
    rw [f1_eq, f2_eq, mul_assoc, Finset.sum_mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    ring

lemma sum_Y (i a k : ℕ) :
    2 * ∑ σ, Y P χ i a k σ =
      2 ^ P.r * (corr P χ i a k (fL P χ i a k) - corr P χ i a k (fun c => fa P χ a c)) := by
  rw [corr_sub_eq]
  simp_rw [Y_eq]
  rw [← Finset.mul_sum]
  have : ∑ σ : Fin P.r → Bool, ∑ c, ∑ d, (sgn (σ c) * sgn (σ d)) * W P χ i a k c d =
      ∑ c, ∑ d, (∑ σ : Fin P.r → Bool, sgn (σ c) * sgn (σ d)) * W P χ i a k c d := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [Finset.sum_mul]
  rw [this]
  simp only [sum_sgn_mul_sgn, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [← Finset.mul_sum]
  ring

lemma abs_corr_sub_le (i a k : ℕ) {ε : ℝ} (hY : ∀ σ, |Y P χ i a k σ| ≤ ε) :
    |corr P χ i a k (fL P χ i a k) - corr P χ i a k (fun c => fa P χ a c)| ≤ 2 * ε := by
  have h := sum_Y P χ i a k
  have hpos : (0 : ℝ) < 2 ^ P.r := by positivity
  have hsum : |∑ σ, Y P χ i a k σ| ≤ 2 ^ P.r * ε := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum fun σ _ => hY σ).trans ?_
    simp
  have key : 2 ^ P.r * |corr P χ i a k (fL P χ i a k) - corr P χ i a k (fun c => fa P χ a c)| ≤
      2 ^ P.r * (2 * ε) := by
    calc 2 ^ P.r * |corr P χ i a k (fL P χ i a k) - corr P χ i a k (fun c => fa P χ a c)|
        = |2 * ∑ σ, Y P χ i a k σ| := by rw [h, abs_mul, abs_of_pos hpos]
      _ = 2 * |∑ σ, Y P χ i a k σ| := by rw [abs_mul, abs_two]
      _ ≤ 2 * (2 ^ P.r * ε) := by linarith
      _ = 2 ^ P.r * (2 * ε) := by ring
  exact le_of_mul_le_mul_left key hpos

lemma abs_uσ_le (a : ℕ) (σ : Fin P.r → Bool) (n : ℤ) : |uσ P χ a σ n| ≤ 1 := by
  unfold uσ
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  simp only [abs_mul, abs_sgn, one_mul]
  calc ∑ c, |fa P χ a c n| = ∑ c, ind χ c (P.b a * n) :=
        Finset.sum_congr rfl fun c _ => abs_of_nonneg (ind_nonneg χ c _)
    _ ≤ 1 := sum_ind_le_one χ _

lemma abs_f2_le (a : ℕ) (σ : Fin P.r → Bool) (m : ℤ) : |f2 P χ a σ m| ≤ 1 := by
  unfold f2
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  simp only [abs_mul, abs_sgn, one_mul]
  calc ∑ c, |ind χ c ((P.b a : ℤ) ^ 2 * m)| = ∑ c, ind χ c ((P.b a : ℤ) ^ 2 * m) :=
        Finset.sum_congr rfl fun c _ => abs_of_nonneg (ind_nonneg χ c _)
    _ ≤ 1 := sum_ind_le_one χ _

lemma abs_f1_le (i a k : ℕ) (σ : Fin P.r → Bool) (hH : 1 ≤ P.H i 0) (n : ℤ) :
    |f1 P χ i a k σ n| ≤ 1 := by
  unfold f1
  have h1 := abs_proj_le (P.q a (a + k + 1)) (P.H i 0) hH (uσ P χ a σ) (abs_uσ_le P χ a σ) n
  have h2 := abs_uσ_le P χ a σ n
  have h3 := abs_sub (proj (P.q a (a + k + 1)) (P.H i 0) (uσ P χ a σ) n) (uσ P χ a σ n)
  rw [abs_div, abs_two]
  linarith

end core

/- ### The scales `⌊exp exp x⌋₊` -/

/-- `EE x = ⌊exp (exp x)⌋₊`, so that `H_{i,j} = EE (L (4Ki + j))`. -/
noncomputable def EE (x : ℝ) : ℕ := ⌊Real.exp (Real.exp x)⌋₊

lemma two_le_exp_one : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]

lemma four_le_exp_two : (4 : ℝ) ≤ Real.exp 2 := by
  have h : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
  have := two_le_exp_one
  nlinarith

lemma one_le_EE (x : ℝ) : 1 ≤ EE x := by
  unfold EE
  apply Nat.le_floor
  push_cast
  exact Real.one_le_exp (Real.exp_pos x).le

lemma EE_mono {x y : ℝ} (h : x ≤ y) : EE x ≤ EE y :=
  Nat.floor_le_floor (Real.exp_le_exp.mpr (Real.exp_le_exp.mpr h))

lemma three_le_EE {x : ℝ} (hx : 1 ≤ x) : 3 ≤ EE x := by
  unfold EE
  apply Nat.le_floor
  have h1 := Real.add_one_le_exp x
  have h2 := Real.add_one_le_exp (Real.exp x)
  push_cast
  linarith

lemma EE_le (x : ℝ) : (EE x : ℝ) ≤ Real.exp (Real.exp x) := Nat.floor_le (Real.exp_pos _).le

lemma EE_gt (x : ℝ) : Real.exp (Real.exp x) - 1 < EE x := Nat.sub_one_lt_floor _

lemma exp_lt_EE (x : ℝ) : Real.exp x < EE x := by
  have := EE_gt x
  have := Real.add_one_le_exp (Real.exp x)
  linarith

/-- Growth of the scales: `EE x ^ m < EE y` as soon as `y ≥ x + m`. -/
lemma EE_pow_lt {x y : ℝ} {m : ℕ} (hx : 0 ≤ x) (hxy : (m : ℝ) ≤ y - x) : EE x ^ m < EE y := by
  have h1 : (EE x : ℝ) ^ m ≤ Real.exp (m * Real.exp x) := by
    rw [Real.exp_nat_mul]
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) (EE_le x) m
  have hex : 1 ≤ Real.exp x := Real.one_le_exp hx
  have hy : ((m : ℝ) + 1) * Real.exp x ≤ Real.exp y := by
    have e : Real.exp y = Real.exp x * Real.exp (y - x) := by rw [← Real.exp_add]; ring_nf
    rw [e]
    have := Real.add_one_le_exp (y - x)
    nlinarith [Real.exp_pos x]
  have hA : 1 ≤ Real.exp (m * Real.exp x) := Real.one_le_exp (by positivity)
  have h2 : Real.exp (m * Real.exp x) + 1 ≤ Real.exp (Real.exp y) := by
    calc Real.exp (m * Real.exp x) + 1 ≤ Real.exp (m * Real.exp x) * (1 + Real.exp x) := by
          nlinarith
      _ ≤ Real.exp (m * Real.exp x) * Real.exp (Real.exp x) := by
          gcongr
          linarith [Real.add_one_le_exp (Real.exp x)]
      _ = Real.exp ((m + 1) * Real.exp x) := by rw [← Real.exp_add]; ring_nf
      _ ≤ Real.exp (Real.exp y) := Real.exp_le_exp.mpr hy
  have h3 := EE_gt y
  have : ((EE x ^ m : ℕ) : ℝ) < EE y := by push_cast; linarith
  exact_mod_cast this

lemma log_EE_le (x : ℝ) : Real.log (EE x) ≤ Real.exp x := by
  have h0 : (0 : ℝ) < EE x := by exact_mod_cast one_le_EE x
  calc Real.log (EE x) ≤ Real.log (Real.exp (Real.exp x)) := Real.log_le_log h0 (EE_le x)
    _ = Real.exp x := Real.log_exp _

lemma loglog_EE_le {x : ℝ} (hx : 0 ≤ x) : Real.log (Real.log (EE x)) ≤ x := by
  have h2 : (2 : ℝ) ≤ EE x := by
    have : 2 ≤ EE x := by
      unfold EE
      apply Nat.le_floor
      have := Real.add_one_le_exp (Real.exp x)
      have := Real.one_le_exp hx
      push_cast
      linarith
    exact_mod_cast this
  have hlog : 0 < Real.log (EE x) := Real.log_pos (by linarith)
  calc Real.log (Real.log (EE x)) ≤ Real.log (Real.exp x) := Real.log_le_log hlog (log_EE_le x)
    _ = x := Real.log_exp x

lemma loglog_EE_sub_one {x : ℝ} (hx : 1 ≤ x) :
    x - 1 ≤ Real.log (Real.log ((EE x : ℝ) - 1)) := by
  have he1 := two_le_exp_one
  have hex : Real.exp 1 ≤ Real.exp x := Real.exp_le_exp.mpr hx
  have hZ4 : 4 ≤ Real.exp (Real.exp x) := by
    have h1 : Real.exp 2 ≤ Real.exp (Real.exp x) := Real.exp_le_exp.mpr (by linarith)
    linarith [four_le_exp_two]
  have hfl := EE_gt x
  have h1 : Real.exp (Real.exp x - 1) ≤ (EE x : ℝ) - 1 := by
    have e : Real.exp (Real.exp x - 1) = Real.exp (Real.exp x) / Real.exp 1 := by
      rw [Real.exp_sub]
    rw [e, div_le_iff₀ (Real.exp_pos 1)]
    nlinarith [mul_le_mul_of_nonneg_left he1 (show (0 : ℝ) ≤ (EE x : ℝ) - 1 by linarith)]
  have h2 : Real.exp x - 1 ≤ Real.log ((EE x : ℝ) - 1) := by
    calc Real.exp x - 1 = Real.log (Real.exp (Real.exp x - 1)) := (Real.log_exp _).symm
      _ ≤ Real.log ((EE x : ℝ) - 1) := Real.log_le_log (Real.exp_pos _) h1
  have h3 : Real.exp (x - 1) ≤ Real.exp x - 1 := by
    have e : Real.exp x = Real.exp (x - 1) * Real.exp 1 := by rw [← Real.exp_add]; ring_nf
    have : 1 ≤ Real.exp (x - 1) := Real.one_le_exp (by linarith)
    nlinarith [mul_le_mul_of_nonneg_left he1 (Real.exp_pos (x - 1)).le]
  calc x - 1 = Real.log (Real.exp (x - 1)) := (Real.log_exp _).symm
    _ ≤ Real.log (Real.log ((EE x : ℝ) - 1)) := Real.log_le_log (Real.exp_pos _) (h3.trans h2)

lemma loglog_EE_ge {x : ℝ} (hx : 1 ≤ x) : x - 1 ≤ Real.log (Real.log (EE x)) := by
  have h := loglog_EE_sub_one hx
  have h3 : (3 : ℝ) ≤ EE x := by exact_mod_cast three_le_EE hx
  have hpos : 0 < Real.log ((EE x : ℝ) - 1) := Real.log_pos (by linarith)
  have hle : Real.log ((EE x : ℝ) - 1) ≤ Real.log (EE x) :=
    Real.log_le_log (by linarith) (by linarith)
  exact h.trans (Real.log_le_log hpos hle)

/-- `ρ^n ≤ exp(n ρ)`. -/
lemma pow_le_exp_mul {ρ : ℝ} (hρ : 0 < ρ) (n : ℕ) : ρ ^ n ≤ Real.exp (n * ρ) := by
  calc ρ ^ n = Real.exp (Real.log ρ) ^ n := by rw [Real.exp_log hρ]
    _ = Real.exp (n * Real.log ρ) := (Real.exp_nat_mul _ _).symm
    _ ≤ Real.exp (n * ρ) := Real.exp_le_exp.mpr
        (mul_le_mul_of_nonneg_left (by linarith [Real.log_le_sub_one_of_pos hρ])
          (Nat.cast_nonneg n))

/- ### The scales `H_{i,m}` -/

/-- `x(i, m) = L (4Ki + m)`, so that `H_{i,m} = EE (x(i,m))`. -/
noncomputable def xx (P : Par) (i m : ℕ) : ℝ := (P.L : ℝ) * (4 * (P.K : ℝ) * (i : ℝ) + (m : ℝ))

lemma H_eq (P : Par) (i m : ℕ) : P.H i m = EE (xx P i m) := rfl

lemma xx_nonneg (P : Par) (i m : ℕ) : 0 ≤ xx P i m := by unfold xx; positivity

lemma xx_mono (P : Par) (i : ℕ) {m m' : ℕ} (h : m ≤ m') : xx P i m ≤ xx P i m' := by
  unfold xx
  have : (m : ℝ) ≤ m' := by exact_mod_cast h
  gcongr

lemma H_mono (P : Par) (i : ℕ) {m m' : ℕ} (h : m ≤ m') : P.H i m ≤ P.H i m' :=
  EE_mono (xx_mono P i h)

lemma one_le_H (P : Par) (i m : ℕ) : 1 ≤ P.H i m := one_le_EE _

lemma H_pow_lt (P : Par) (i : ℕ) {m m' M : ℕ} (h : m < m') (hM : M ≤ P.L) :
    P.H i m ^ M < P.H i m' := by
  rw [H_eq P i m, H_eq P i m']
  apply EE_pow_lt (xx_nonneg P i m)
  have e : xx P i m' - xx P i m = (P.L : ℝ) * ((m' : ℝ) - m) := by unfold xx; ring
  rw [e]
  have h1 : (1 : ℝ) ≤ (m' : ℝ) - m := by
    have : (m : ℝ) + 1 ≤ m' := by exact_mod_cast h
    linarith
  have h2 : (M : ℝ) ≤ P.L := by exact_mod_cast hM
  have h3 : (0 : ℝ) ≤ P.L := Nat.cast_nonneg _
  nlinarith

lemma xx_ge (P : Par) {i : ℕ} (hi : 1 ≤ i) (m : ℕ) : 4 * (P.r : ℝ) ^ 35 ≤ xx P i m := by
  unfold xx Par.L Par.K
  push_cast
  have hi' : (1 : ℝ) ≤ i := by exact_mod_cast hi
  have hr : (0 : ℝ) ≤ P.r := Nat.cast_nonneg _
  calc 4 * (P.r : ℝ) ^ 35 = (P.r : ℝ) ^ 28 * (4 * (P.r : ℝ) ^ 7 * 1 + 0) := by ring
    _ ≤ (P.r : ℝ) ^ 28 * (4 * (P.r : ℝ) ^ 7 * i + m) := by gcongr; positivity

lemma xx_le (P : Par) (hr : 1 ≤ P.r) {i m : ℕ} (hi : i ≤ P.r ^ 7) (hm : m ≤ 2 * P.r ^ 7) :
    xx P i m ≤ 6 * (P.r : ℝ) ^ 42 := by
  unfold xx Par.L Par.K
  push_cast
  have hr' : (1 : ℝ) ≤ P.r := by exact_mod_cast hr
  have hi' : (i : ℝ) ≤ (P.r : ℝ) ^ 7 := by exact_mod_cast hi
  have hm' : (m : ℝ) ≤ 2 * (P.r : ℝ) ^ 7 := by exact_mod_cast hm
  have h714 : (P.r : ℝ) ^ 7 ≤ (P.r : ℝ) ^ 14 := pow_le_pow_right₀ hr' (by norm_num)
  have h7 : (0 : ℝ) ≤ (P.r : ℝ) ^ 7 := by positivity
  calc (P.r : ℝ) ^ 28 * (4 * (P.r : ℝ) ^ 7 * i + m)
      ≤ (P.r : ℝ) ^ 28 * (4 * (P.r : ℝ) ^ 7 * (P.r : ℝ) ^ 7 + 2 * (P.r : ℝ) ^ 14) := by
        gcongr
        linarith
    _ = 6 * (P.r : ℝ) ^ 42 := by ring

/- ### The size `M` of the interval -/

lemma Mval_ge (r : ℕ) : Real.exp (Real.exp ((r : ℝ) ^ 43)) ≤ Mval r := Nat.le_ceil _

lemma one_le_Mval (r : ℕ) : 1 ≤ Mval r := by
  have h := Mval_ge r
  have : (1 : ℝ) ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) := Real.one_le_exp (Real.exp_pos _).le
  exact_mod_cast this.trans h

lemma log_Mval_ge (r : ℕ) : Real.exp ((r : ℝ) ^ 43) ≤ Real.log (Mval r) := by
  calc Real.exp ((r : ℝ) ^ 43) = Real.log (Real.exp (Real.exp ((r : ℝ) ^ 43))) :=
        (Real.log_exp _).symm
    _ ≤ Real.log (Mval r) := Real.log_le_log (Real.exp_pos _) (Mval_ge r)

lemma loglog_Mval_ge (r : ℕ) : (r : ℝ) ^ 43 ≤ Real.log (Real.log (Mval r)) := by
  calc (r : ℝ) ^ 43 = Real.log (Real.exp ((r : ℝ) ^ 43)) := (Real.log_exp _).symm
    _ ≤ Real.log (Real.log (Mval r)) := Real.log_le_log (Real.exp_pos _) (log_Mval_ge r)

lemma loglog_Mval_le (r : ℕ) : Real.log (Real.log (Mval r)) ≤ (r : ℝ) ^ 43 + 1 := by
  set y := (r : ℝ) ^ 43
  have hZ1 : (1 : ℝ) ≤ Real.exp (Real.exp y) := Real.one_le_exp (Real.exp_pos _).le
  have hM : (Mval r : ℝ) ≤ 2 * Real.exp (Real.exp y) := by
    have := Nat.ceil_lt_add_one (Real.exp_pos (Real.exp y)).le
    unfold Mval
    linarith
  have hlog2 : Real.log 2 ≤ 1 := by
    have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    linarith
  have hM0 : (0 : ℝ) < Mval r := by exact_mod_cast one_le_Mval r
  have h1 : Real.log (Mval r) ≤ 2 * Real.exp y := by
    calc Real.log (Mval r) ≤ Real.log (2 * Real.exp (Real.exp y)) := Real.log_le_log hM0 hM
      _ = Real.log 2 + Real.exp y := by
          rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]
      _ ≤ 2 * Real.exp y := by linarith [Real.one_le_exp (show (0 : ℝ) ≤ y by positivity)]
  have hpos : 0 < Real.log (Mval r) := lt_of_lt_of_le (Real.exp_pos _) (log_Mval_ge r)
  calc Real.log (Real.log (Mval r)) ≤ Real.log (2 * Real.exp y) := Real.log_le_log hpos h1
    _ = Real.log 2 + y := by rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]
    _ ≤ y + 1 := by linarith

/- ### The dilation `λ_{a,j}` -/

lemma one_le_lam (P : Par) (a j : ℕ) : 1 ≤ P.lam a j :=
  Nat.one_le_pow _ _ (Nat.factorial_pos _)

lemma prime_dvd_lam (P : Par) (a j p : ℕ) (hp : p.Prime) (h : p ∣ P.lam a j) :
    p ≤ P.d ^ P.C := by
  unfold Par.lam Par.V at h
  exact (hp.dvd_factorial).mp (hp.dvd_of_dvd_pow h)

lemma log_lam_le (P : Par) (a j : ℕ) :
    Real.log (P.lam a j) ≤ (4 : ℝ) ^ j * ((P.d ^ P.C : ℕ) : ℝ) ^ 2 := by
  set D : ℕ := P.d ^ P.C with hD
  have hV1 : (1 : ℝ) ≤ P.V := by exact_mod_cast Nat.factorial_pos _
  have hlogV0 : 0 ≤ Real.log P.V := Real.log_nonneg hV1
  have hlogV : Real.log P.V ≤ (D : ℝ) ^ 2 := by
    have h1 : (P.V : ℝ) ≤ (D : ℝ) ^ D := by exact_mod_cast Nat.factorial_le_pow D
    calc Real.log P.V ≤ Real.log ((D : ℝ) ^ D) := Real.log_le_log (by linarith) h1
      _ = D * Real.log D := Real.log_pow _ _
      _ ≤ D * D := by
          gcongr
          exact Real.log_le_self (Nat.cast_nonneg _)
      _ = (D : ℝ) ^ 2 := by ring
  have he : ((4 ^ j - 2 * 4 ^ a : ℕ) : ℝ) ≤ (4 : ℝ) ^ j := by
    have : 4 ^ j - 2 * 4 ^ a ≤ 4 ^ j := Nat.sub_le _ _
    exact_mod_cast this
  unfold Par.lam
  push_cast
  rw [Real.log_pow]
  calc ((4 ^ j - 2 * 4 ^ a : ℕ) : ℝ) * Real.log P.V ≤ (4 : ℝ) ^ j * (D : ℝ) ^ 2 := by
        gcongr

/- ### The parameters `δ`, `1/δ` -/

lemma delta_eq (P : Par) : P.δ = 1 / (P.r : ℝ) ^ 4 := by
  simp [Par.δ, Par.d]

lemma one_div_delta (P : Par) : 1 / P.δ = (P.r : ℝ) ^ 4 := by
  rw [delta_eq, one_div_one_div]

lemma floor_eq (P : Par) : ⌊(1 / P.δ) ^ P.C⌋₊ = P.d ^ P.C := by
  rw [one_div_delta]
  have : ((P.r : ℝ) ^ 4) ^ P.C = ((P.d ^ P.C : ℕ) : ℝ) := by simp [Par.d]
  rw [this, Nat.floor_natCast]

lemma delta_pos (P : Par) (hr : 1 ≤ P.r) : 0 < P.δ := by
  rw [delta_eq]
  have : (0 : ℝ) < P.r := by exact_mod_cast hr
  positivity

lemma delta_le (P : Par) (hr : 1 ≤ P.r) {δ₀ : ℝ} (hδ₀ : 0 < δ₀) (h : 1 / δ₀ ≤ (P.r : ℝ)) :
    P.δ ≤ δ₀ := by
  rw [delta_eq]
  have hr' : (1 : ℝ) ≤ P.r := by exact_mod_cast hr
  have h1 : 1 / (P.r : ℝ) ≤ δ₀ := by
    rw [one_div_le (by linarith) hδ₀]
    exact h
  have h2 : 1 / (P.r : ℝ) ^ 4 ≤ 1 / (P.r : ℝ) := by
    apply one_div_le_one_div_of_le (by linarith)
    calc (P.r : ℝ) = (P.r : ℝ) ^ 1 := (pow_one _).symm
      _ ≤ (P.r : ℝ) ^ 4 := pow_le_pow_right₀ hr' (by norm_num)
  linarith

/- ### The conditions of Proposition 5.1 involving `M` -/

lemma N₀_le_Mval (r N₀ : ℕ) (h : N₀ ≤ r) (hr : 1 ≤ r) : N₀ ≤ Mval r := by
  have hr' : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have h1 : (r : ℝ) ≤ (r : ℝ) ^ 43 := le_self_pow₀ hr' (by norm_num)
  have h2 := Real.add_one_le_exp ((r : ℝ) ^ 43)
  have h3 := Real.add_one_le_exp (Real.exp ((r : ℝ) ^ 43))
  have h4 := Mval_ge r
  have h5 : (N₀ : ℝ) ≤ r := by exact_mod_cast h
  have : (N₀ : ℝ) ≤ Mval r := by linarith
  exact_mod_cast this

lemma k_le_loglog (r k : ℕ) (hr : 1 ≤ r) (hk : k ≤ r ^ 7) :
    (k : ℝ) ≤ Real.log (Real.log (Mval r)) := by
  have hr' : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have h1 : (k : ℝ) ≤ (r : ℝ) ^ 7 := by exact_mod_cast hk
  have h2 : (r : ℝ) ^ 7 ≤ (r : ℝ) ^ 43 := pow_le_pow_right₀ hr' (by norm_num)
  linarith [loglog_Mval_ge r]

lemma invδ_le_loglog (P : Par) (hr : 1 ≤ P.r) : 1 / P.δ ≤ Real.log (Real.log (Mval P.r)) := by
  rw [one_div_delta]
  have hr' : (1 : ℝ) ≤ P.r := by exact_mod_cast hr
  have h2 : (P.r : ℝ) ^ 4 ≤ (P.r : ℝ) ^ 43 := pow_le_pow_right₀ hr' (by norm_num)
  linarith [loglog_Mval_ge P.r]

lemma k_le_invδ_pow (P : Par) (hr : 1 ≤ P.r) {k : ℕ} (hk : k ≤ P.r ^ 7) :
    (k : ℝ) ≤ (1 / P.δ) ^ 10 := by
  rw [one_div_delta, ← pow_mul]
  have hr' : (1 : ℝ) ≤ P.r := by exact_mod_cast hr
  have h1 : (k : ℝ) ≤ (P.r : ℝ) ^ 7 := by exact_mod_cast hk
  have h2 : (P.r : ℝ) ^ 7 ≤ (P.r : ℝ) ^ (4 * 10) := pow_le_pow_right₀ hr' (by norm_num)
  linarith

lemma xx_ge_one (P : Par) (hr : 1 ≤ P.r) {i : ℕ} (hi : 1 ≤ i) (m : ℕ) : 1 ≤ xx P i m := by
  have h := xx_ge P hi m
  have hr' : (1 : ℝ) ≤ P.r := by exact_mod_cast hr
  have : (1 : ℝ) ≤ (P.r : ℝ) ^ 35 := one_le_pow₀ hr'
  linarith

lemma three_le_H (P : Par) (hr : 1 ≤ P.r) {i : ℕ} (hi : 1 ≤ i) (m : ℕ) : 3 ≤ P.H i m :=
  three_le_EE (xx_ge_one P hr hi m)

lemma loglog_Mval_le_P1 (P : Par) (hr : 2 ≤ P.r) {i : ℕ} (hi : 1 ≤ i) (m : ℕ) :
    Real.log (Real.log (Mval P.r)) ≤ (Real.log (Real.log (P.H i m))) ^ 10 := by
  have hr' : (2 : ℝ) ≤ P.r := by exact_mod_cast hr
  have h1 := loglog_Mval_le P.r
  have h2 := loglog_EE_ge (xx_ge_one P (by omega) hi m)
  have h3 := xx_ge P hi m
  rw [H_eq]
  have h35 : (1 : ℝ) ≤ (P.r : ℝ) ^ 35 := one_le_pow₀ (by linarith)
  have h4 : (P.r : ℝ) ^ 35 ≤ Real.log (Real.log (EE (xx P i m))) := by linarith
  have h5 : ((P.r : ℝ) ^ 35) ^ 10 ≤ (Real.log (Real.log (EE (xx P i m)))) ^ 10 :=
    pow_le_pow_left₀ (by positivity) h4 10
  have h6 : (P.r : ℝ) ^ 43 + 1 ≤ ((P.r : ℝ) ^ 35) ^ 10 := by
    rw [← pow_mul]
    have h44 : (P.r : ℝ) ^ 44 ≤ (P.r : ℝ) ^ (35 * 10) :=
      pow_le_pow_right₀ (by linarith) (by norm_num)
    have h43 : (1 : ℝ) ≤ (P.r : ℝ) ^ 43 := one_le_pow₀ (by linarith)
    have e : (P.r : ℝ) ^ 44 = P.r * (P.r : ℝ) ^ 43 := by ring
    nlinarith
  linarith

lemma log_H_pow_lt (P : Par) (hr : 25 ≤ P.r) {i m : ℕ} (hi : i ≤ P.r ^ 7)
    (hm : m ≤ 2 * P.r ^ 7) : (Real.log (P.H i m)) ^ 4 < Real.log (Mval P.r) := by
  have hr' : (25 : ℝ) ≤ P.r := by exact_mod_cast hr
  have h1 := log_EE_le (xx P i m)
  have h2 := xx_le P (by omega) hi hm
  have h0 : 0 ≤ Real.log (P.H i m) := Real.log_nonneg (by exact_mod_cast one_le_H P i m)
  rw [H_eq] at h0 ⊢
  have h3 : Real.log (EE (xx P i m)) ≤ Real.exp (6 * (P.r : ℝ) ^ 42) :=
    h1.trans (Real.exp_le_exp.mpr h2)
  have h4 : (Real.log (EE (xx P i m))) ^ 4 ≤ Real.exp (6 * (P.r : ℝ) ^ 42) ^ 4 :=
    pow_le_pow_left₀ h0 h3 4
  rw [← Real.exp_nat_mul] at h4
  have h5 : Real.exp (((4 : ℕ) : ℝ) * (6 * (P.r : ℝ) ^ 42)) < Real.exp ((P.r : ℝ) ^ 43) := by
    apply Real.exp_lt_exp.mpr
    have : (0 : ℝ) < (P.r : ℝ) ^ 42 := by positivity
    have e : (P.r : ℝ) ^ 43 = P.r * (P.r : ℝ) ^ 42 := by ring
    push_cast
    nlinarith
  linarith [log_Mval_ge P.r]

lemma width_cond (P : Par) (hr : 25 ≤ P.r) {i k : ℕ} (hi : 1 ≤ i) (hk : k ≤ P.r ^ 7) {m : ℕ}
    (hm : 1 ≤ m) :
    Real.log (Real.log (P.H i (m - 1))) + k * (1 / P.δ) ^ 5 ≤
      Real.log (Real.log ((P.H i m : ℝ) - 1)) := by
  have hr' : (25 : ℝ) ≤ P.r := by exact_mod_cast hr
  rw [H_eq, H_eq, one_div_delta]
  have h1 := loglog_EE_le (xx_nonneg P i (m - 1))
  have h2 := loglog_EE_sub_one (xx_ge_one P (by omega) hi m)
  have e : xx P i m = xx P i (m - 1) + (P.r : ℝ) ^ 28 := by
    unfold xx Par.L
    have : ((m - 1 : ℕ) : ℝ) = (m : ℝ) - 1 := by
      rw [Nat.cast_sub hm]
      simp
    rw [this]
    push_cast
    ring
  have hk' : (k : ℝ) ≤ (P.r : ℝ) ^ 7 := by exact_mod_cast hk
  have h3 : (k : ℝ) * ((P.r : ℝ) ^ 4) ^ 5 ≤ (P.r : ℝ) ^ 28 - 1 := by
    have h4 : (k : ℝ) * ((P.r : ℝ) ^ 4) ^ 5 ≤ (P.r : ℝ) ^ 7 * ((P.r : ℝ) ^ 4) ^ 5 := by
      gcongr
    have h27 : (1 : ℝ) ≤ (P.r : ℝ) ^ 27 := one_le_pow₀ (by linarith)
    have e2 : (P.r : ℝ) ^ 7 * ((P.r : ℝ) ^ 4) ^ 5 = (P.r : ℝ) ^ 27 := by ring
    have e3 : (P.r : ℝ) ^ 28 = P.r * (P.r : ℝ) ^ 27 := by ring
    nlinarith
  linarith

lemma log_lam_pow_le (P : Par) (hr : 1 ≤ P.r) (hrC : 32 * P.C + 8 ≤ P.r) {a j : ℕ}
    (hj : j ≤ P.r ^ 7) : (Real.log (P.lam a j)) ^ 4 ≤ Real.log (Mval P.r) := by
  have hρ1 : (1 : ℝ) ≤ (P.r : ℝ) := by exact_mod_cast hr
  have hρ0 : (0 : ℝ) < (P.r : ℝ) := by linarith
  have h0 : 0 ≤ Real.log (P.lam a j) := Real.log_nonneg (by exact_mod_cast one_le_lam P a j)
  have h1 := log_lam_le P a j
  have h4 : (4 : ℝ) ^ j ≤ Real.exp (2 * (P.r : ℝ) ^ 7) := by
    calc (4 : ℝ) ^ j ≤ (4 : ℝ) ^ (P.r ^ 7) := pow_le_pow_right₀ (by norm_num) hj
      _ ≤ Real.exp 2 ^ (P.r ^ 7) := pow_le_pow_left₀ (by norm_num) four_le_exp_two _
      _ = Real.exp (((P.r ^ 7 : ℕ) : ℝ) * 2) := (Real.exp_nat_mul _ _).symm
      _ = Real.exp (2 * (P.r : ℝ) ^ 7) := by push_cast; ring_nf
  have hD : ((P.d ^ P.C : ℕ) : ℝ) ≤ Real.exp ((4 * P.C : ℕ) * (P.r : ℝ)) := by
    have e : ((P.d ^ P.C : ℕ) : ℝ) = (P.r : ℝ) ^ (4 * P.C) := by simp [Par.d, pow_mul]
    rw [e]
    exact pow_le_exp_mul hρ0 _
  have hD0 : (0 : ℝ) ≤ ((P.d ^ P.C : ℕ) : ℝ) := Nat.cast_nonneg _
  have h5 : Real.log (P.lam a j) ≤
      Real.exp (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ))) := by
    calc Real.log (P.lam a j) ≤ (4 : ℝ) ^ j * ((P.d ^ P.C : ℕ) : ℝ) ^ 2 := h1
      _ ≤ Real.exp (2 * (P.r : ℝ) ^ 7) * Real.exp ((4 * P.C : ℕ) * (P.r : ℝ)) ^ 2 := by gcongr
      _ = Real.exp (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ))) := by
          rw [← Real.exp_nat_mul, ← Real.exp_add]
          push_cast
          ring_nf
  have h6 : (Real.log (P.lam a j)) ^ 4 ≤
      Real.exp (4 * (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ)))) := by
    calc (Real.log (P.lam a j)) ^ 4
        ≤ Real.exp (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ))) ^ 4 :=
          pow_le_pow_left₀ h0 h5 4
      _ = Real.exp (4 * (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ)))) := by
          rw [← Real.exp_nat_mul]
          push_cast
          ring_nf
  have h7 : 4 * (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ))) ≤ (P.r : ℝ) ^ 43 := by
    push_cast
    have hC : (32 * (P.C : ℝ) + 8) ≤ (P.r : ℝ) := by exact_mod_cast hrC
    have h7 : (P.r : ℝ) ≤ (P.r : ℝ) ^ 7 := le_self_pow₀ hρ1 (by norm_num)
    have h8 : (P.r : ℝ) ^ 8 ≤ (P.r : ℝ) ^ 43 := pow_le_pow_right₀ hρ1 (by norm_num)
    have e : (P.r : ℝ) ^ 8 = (P.r : ℝ) * (P.r : ℝ) ^ 7 := by ring
    have hC0 : (0 : ℝ) ≤ P.C := Nat.cast_nonneg _
    have p1 := mul_le_mul_of_nonneg_right hC (by positivity : (0 : ℝ) ≤ (P.r : ℝ) ^ 7)
    have p2 := mul_le_mul_of_nonneg_left h7 hC0
    nlinarith
  calc (Real.log (P.lam a j)) ^ 4
      ≤ Real.exp (4 * (2 * (P.r : ℝ) ^ 7 + 2 * ((4 * P.C : ℕ) * (P.r : ℝ)))) := h6
    _ ≤ Real.exp ((P.r : ℝ) ^ 43) := Real.exp_le_exp.mpr h7
    _ ≤ Real.log (Mval P.r) := log_Mval_ge P.r

lemma lam_prime_lt (P : Par) (hr : 1 ≤ P.r) (hrC : 32 * P.C + 8 ≤ P.r) {i : ℕ} (hi : 1 ≤ i)
    (a j m : ℕ) : ∀ p : ℕ, p.Prime → p ∣ P.lam a j → p < P.H i m := by
  intro p hp hdvd
  have h1 := prime_dvd_lam P a j p hp hdvd
  have key : ((P.d ^ P.C : ℕ) : ℝ) < P.H i m := by
    have hρ1 : (1 : ℝ) ≤ (P.r : ℝ) := by exact_mod_cast hr
    have e : ((P.d ^ P.C : ℕ) : ℝ) = (P.r : ℝ) ^ (4 * P.C) := by simp [Par.d, pow_mul]
    rw [e, H_eq]
    calc (P.r : ℝ) ^ (4 * P.C) ≤ Real.exp ((4 * P.C : ℕ) * (P.r : ℝ)) :=
          pow_le_exp_mul (by linarith) _
      _ ≤ Real.exp (xx P i m) := by
          apply Real.exp_le_exp.mpr
          have h2 := xx_ge P hi m
          have hC : (P.C : ℝ) ≤ (P.r : ℝ) := by
            have : P.C ≤ P.r := by omega
            exact_mod_cast this
          have h35 : (P.r : ℝ) ^ 2 ≤ (P.r : ℝ) ^ 35 := pow_le_pow_right₀ hρ1 (by norm_num)
          have hCρ : (P.C : ℝ) * (P.r : ℝ) ≤ (P.r : ℝ) ^ 2 := by nlinarith
          push_cast
          nlinarith
      _ < EE (xx P i m) := exp_lt_EE _
  have : P.d ^ P.C < P.H i m := by exact_mod_cast key
  omega

lemma small_cond (P : Par) (hr : 1 ≤ P.r) {C' : ℕ} (hrC' : 4 * C' + 1 ≤ P.r) {c : ℝ}
    (hc : 0 < c) (hrc : 1 / c ≤ (P.r : ℝ)) {i : ℕ} (hi : 1 ≤ i) :
    1 / (P.H i 0 : ℝ) < c * P.δ ^ C' := by
  have hρ1 : (1 : ℝ) ≤ (P.r : ℝ) := by exact_mod_cast hr
  have hρ0 : (0 : ℝ) < (P.r : ℝ) := by linarith
  have hH : (P.r : ℝ) ^ (4 * C' + 1) < P.H i 0 := by
    rw [H_eq]
    calc (P.r : ℝ) ^ (4 * C' + 1) ≤ Real.exp ((4 * C' + 1 : ℕ) * (P.r : ℝ)) := pow_le_exp_mul hρ0 _
      _ ≤ Real.exp (xx P i 0) := by
          apply Real.exp_le_exp.mpr
          have h2 := xx_ge P hi 0
          have hC : ((4 * C' + 1 : ℕ) : ℝ) ≤ (P.r : ℝ) := by exact_mod_cast hrC'
          have h35 : (P.r : ℝ) ^ 2 ≤ (P.r : ℝ) ^ 35 := pow_le_pow_right₀ hρ1 (by norm_num)
          have : ((4 * C' + 1 : ℕ) : ℝ) * (P.r : ℝ) ≤ (P.r : ℝ) ^ 2 := by nlinarith
          nlinarith
      _ < EE (xx P i 0) := exp_lt_EE _
  have hcρ : 1 ≤ c * (P.r : ℝ) := by
    rw [div_le_iff₀ hc] at hrc
    linarith
  rw [delta_eq, div_pow, one_pow, ← pow_mul]
  have hX : 0 < (P.r : ℝ) ^ (4 * C') := by positivity
  have hH0 : (0 : ℝ) < P.H i 0 := by exact_mod_cast one_le_H P i 0
  rw [mul_one_div, div_lt_div_iff₀ hH0 hX]
  have e : (P.r : ℝ) ^ (4 * C' + 1) = (P.r : ℝ) ^ (4 * C') * (P.r : ℝ) := pow_succ _ _
  rw [e] at hH
  have p1 := mul_lt_mul_of_pos_left hH hc
  have p2 := mul_le_mul_of_nonneg_left hcρ hX.le
  nlinarith

/- ### The windows -/

/-- Left end points of the prime intervals of the window. -/
noncomputable def lo (P : Par) (i a k : ℕ) : Fin (k + 1) → ℕ :=
  fun ℓ => P.H i (2 * (a + 1 + ℓ) - 1)

/-- Right end points of the prime intervals of the window. -/
noncomputable def hi (P : Par) (i a k : ℕ) : Fin (k + 1) → ℕ := fun ℓ => P.H i (2 * (a + 1 + ℓ))

lemma L_ge (P : Par) (h : 25 ≤ P.r) : 20 ≤ P.L := by
  unfold Par.L
  calc 20 ≤ P.r := by omega
    _ ≤ P.r ^ 28 := Nat.le_self_pow (by norm_num) _

lemma P1_lt_P2 (P : Par) (hL : 1 ≤ P.L) (i a k : ℕ) (hk : 1 ≤ k) :
    P.H i (2 * a + 1) < P.H i (2 * (a + k)) ^ 2 := by
  have h := H_pow_lt P i (m := 2 * a + 1) (m' := 2 * (a + k)) (M := 1) (by omega) hL
  rw [pow_one] at h
  exact h.trans_le (Nat.le_self_pow (by norm_num) _)

lemma P2_lt_lo (P : Par) (hL : 2 ≤ P.L) (i a k : ℕ) :
    P.H i (2 * (a + k)) ^ 2 < lo P i a k (Fin.last k) := by
  show P.H i (2 * (a + k)) ^ 2 < P.H i (2 * (a + 1 + k) - 1)
  exact H_pow_lt P i (by omega) hL

lemma lo_lt_hi (P : Par) (hL : 1 ≤ P.L) (i a k : ℕ) (ℓ : Fin (k + 1)) :
    lo P i a k ℓ < hi P i a k ℓ := by
  have h := H_pow_lt P i (m := 2 * (a + 1 + ℓ) - 1) (m' := 2 * (a + 1 + ℓ)) (M := 1)
    (by omega) hL
  rw [pow_one] at h
  exact h

/-- `P₂ ≥ 4P₁` for the last prime interval of the window. -/
lemma four_lo_le_hi (P : Par) (hr : 1 ≤ P.r) {i : ℕ} (hi1 : 1 ≤ i) (hL : 3 ≤ P.L) (a k : ℕ) :
    4 * lo P i a k (Fin.last k) ≤ hi P i a k (Fin.last k) := by
  have h := H_pow_lt P i (m := 2 * (a + 1 + (Fin.last k : ℕ)) - 1)
    (m' := 2 * (a + 1 + (Fin.last k : ℕ))) (M := 3) (by omega) hL
  have h3 : 3 ≤ P.H i (2 * (a + 1 + (Fin.last k : ℕ)) - 1) := three_le_H P hr hi1 _
  show 4 * P.H i (2 * (a + 1 + (Fin.last k : ℕ)) - 1) ≤ P.H i (2 * (a + 1 + (Fin.last k : ℕ)))
  set x := P.H i (2 * (a + 1 + (Fin.last k : ℕ)) - 1)
  have h9 : 9 ≤ x ^ 2 := by nlinarith
  have hcube : 4 * x ≤ x ^ 3 :=
    calc 4 * x ≤ 9 * x := by omega
      _ ≤ x ^ 2 * x := Nat.mul_le_mul_right _ h9
      _ = x ^ 3 := by ring
  omega

lemma P2pow_le_lo (P : Par) (hL : 20 ≤ P.L) (i a k : ℕ) :
    (P.H i (2 * (a + k)) ^ 2) ^ 10 ≤ lo P i a k (Fin.last k) := by
  rw [← pow_mul]
  show P.H i (2 * (a + k)) ^ (2 * 10) ≤ P.H i (2 * (a + 1 + k) - 1)
  exact (H_pow_lt P i (by omega) hL).le

lemma win_cond (P : Par) (hL : 1 ≤ P.L) (i a k : ℕ) (ℓ : Fin k) :
    P.H i (2 * a + 1) ≤ lo P i a k ℓ.castSucc ∧ lo P i a k ℓ.castSucc < hi P i a k ℓ.castSucc ∧
      hi P i a k ℓ.castSucc ≤ P.H i (2 * (a + k)) ^ 2 := by
  refine ⟨?_, lo_lt_hi P hL i a k _, ?_⟩
  · show P.H i (2 * a + 1) ≤ P.H i (2 * (a + 1 + (ℓ : ℕ)) - 1)
    exact H_mono P i (by omega)
  · show P.H i (2 * (a + 1 + (ℓ : ℕ))) ≤ P.H i (2 * (a + k)) ^ 2
    have := ℓ.isLt
    exact (H_mono P i (by omega)).trans (Nat.le_self_pow (by norm_num) _)

lemma disj_cond (P : Par) (i a k : ℕ) (ℓ ℓ' : Fin k) (h : ℓ ≠ ℓ') :
    hi P i a k ℓ.castSucc ≤ lo P i a k ℓ'.castSucc ∨
      hi P i a k ℓ'.castSucc ≤ lo P i a k ℓ.castSucc := by
  show P.H i (2 * (a + 1 + (ℓ : ℕ))) ≤ P.H i (2 * (a + 1 + (ℓ' : ℕ)) - 1) ∨
    P.H i (2 * (a + 1 + (ℓ' : ℕ))) ≤ P.H i (2 * (a + 1 + (ℓ : ℕ)) - 1)
  rcases lt_or_gt_of_ne h with h' | h'
  · left
    have : (ℓ : ℕ) < ℓ' := h'
    exact H_mono P i (by omega)
  · right
    have : (ℓ' : ℕ) < ℓ := h'
    exact H_mono P i (by omega)

lemma prod_le_sq (g : ℕ → ℕ) (hg : ∀ m, g m ^ 2 ≤ g (m + 1)) :
    ∀ k, 1 ≤ k → ∏ ℓ : Fin k, g ℓ ≤ g (k - 1) ^ 2
  | 0, h => absurd h (by norm_num)
  | 1, _ => by
    simp only [Finset.univ_unique, Fin.default_eq_zero, Fin.val_zero, Finset.prod_singleton,
      Nat.sub_self]
    exact Nat.le_self_pow (by norm_num) _
  | k + 2, _ => by
    rw [Fin.prod_univ_castSucc]
    have ih := prod_le_sq g hg (k + 1) (by omega)
    simp only [Fin.val_castSucc, Fin.val_last, Nat.add_sub_cancel] at ih ⊢
    calc (∏ ℓ : Fin (k + 1), g ℓ) * g (k + 1) ≤ g k ^ 2 * g (k + 1) :=
          Nat.mul_le_mul_right _ ih
      _ ≤ g (k + 1) * g (k + 1) := Nat.mul_le_mul_right _ (hg k)
      _ = g (k + 1) ^ 2 := (sq _).symm

lemma prod_cond (P : Par) (hL : 2 ≤ P.L) (i a k : ℕ) (hk : 1 ≤ k) :
    (∏ ℓ : Fin k, hi P i a k ℓ.castSucc) ≤ P.H i (2 * (a + k)) ^ 2 := by
  have h := prod_le_sq (fun m => P.H i (2 * (a + 1 + m)))
    (fun m => (H_pow_lt P i (by omega) hL).le) k hk
  have e : 2 * (a + 1 + (k - 1)) = 2 * (a + k) := by omega
  simp only [e] at h
  exact h

lemma Hh_cond (P : Par) (hL : 16 ≤ P.L) (i a k : ℕ) :
    (P.H i 0 ^ 2) ^ 8 ≤ lo P i a k (Fin.last k) := by
  rw [← pow_mul]
  show P.H i 0 ^ (2 * 8) ≤ P.H i (2 * (a + 1 + k) - 1)
  exact (H_pow_lt P i (by omega) hL).le

lemma mem_triples {P : Par} {i a k : ℕ} (h : (i, a, k) ∈ P.triples) :
    1 ≤ i ∧ i ≤ P.r ^ 7 ∧ 1 ≤ a ∧ 1 ≤ k ∧ a + k + 1 ≤ P.r ^ 7 := by
  unfold Par.triples at h
  rw [Finset.mem_filter, Finset.mem_product, Finset.mem_product, Finset.mem_Icc, Finset.mem_Icc,
    Finset.mem_Icc] at h
  simp only [Par.T, Par.K] at h
  obtain ⟨⟨⟨h1, h2⟩, ⟨h3, h4⟩, ⟨h5, h6⟩⟩, h7⟩ := h
  exact ⟨h1, h2.trans (Nat.sub_le _ _), h3, h5, h7⟩

theorem abs_Y_lt {C : ℕ} {c : ℝ} {C' : ℕ} {δ₀ : ℝ} {N₀ : ℕ} (h51 : Prop51With C c C' δ₀ N₀)
    (P : Par) (χ : Finset.Icc 1 (Mval P.r) → Fin P.r) (i a k : ℕ)
    (hδ : 0 < P.δ) (hδ₀ : P.δ ≤ δ₀) (hN₀ : N₀ ≤ Mval P.r) (hk : 1 ≤ k)
    (hkN : (k : ℝ) ≤ Real.log (Real.log (Mval P.r)))
    (hδN : 1 / P.δ ≤ Real.log (Real.log (Mval P.r)))
    (hkδ : (k : ℝ) ≤ (1 / P.δ) ^ 10)
    (h3 : 3 ≤ P.H i (2 * a + 1))
    (hP1 : Real.log (Real.log (Mval P.r)) ≤ (Real.log (Real.log (P.H i (2 * a + 1)))) ^ 10)
    (hP12 : P.H i (2 * a + 1) < P.H i (2 * (a + k)) ^ 2)
    (hP2lo : P.H i (2 * (a + k)) ^ 2 < lo P i a k (Fin.last k))
    (hlohi : lo P i a k (Fin.last k) < hi P i a k (Fin.last k))
    (h4lohi : 4 * lo P i a k (Fin.last k) ≤ hi P i a k (Fin.last k))
    (hlog4 : (Real.log (hi P i a k (Fin.last k))) ^ 4 < Real.log (Mval P.r))
    (hP2pow : (P.H i (2 * (a + k)) ^ 2) ^ 10 ≤ lo P i a k (Fin.last k))
    (hwin : ∀ ℓ : Fin k, P.H i (2 * a + 1) ≤ lo P i a k ℓ.castSucc ∧
      lo P i a k ℓ.castSucc < hi P i a k ℓ.castSucc ∧
      hi P i a k ℓ.castSucc ≤ P.H i (2 * (a + k)) ^ 2)
    (hdisj : ∀ ℓ ℓ' : Fin k, ℓ ≠ ℓ' → hi P i a k ℓ.castSucc ≤ lo P i a k ℓ'.castSucc ∨
      hi P i a k ℓ'.castSucc ≤ lo P i a k ℓ.castSucc)
    (hprod : (∏ ℓ : Fin k, hi P i a k ℓ.castSucc) ≤ P.H i (2 * (a + k)) ^ 2)
    (hwidth : ∀ ℓ : Fin k, Real.log (Real.log (lo P i a k ℓ.castSucc)) + k * (1 / P.δ) ^ 5 ≤
      Real.log (Real.log ((hi P i a k ℓ.castSucc : ℝ) - 1)))
    (hlam1 : 1 ≤ P.lam a (a + k + 1))
    (hlamlog : (Real.log (P.lam a (a + k + 1))) ^ 4 ≤ Real.log (Mval P.r))
    (hlamp : ∀ p : ℕ, p.Prime → p ∣ P.lam a (a + k + 1) → p < P.H i (2 * a + 1))
    (hH0 : 1 ≤ P.H i 0)
    (hHh : (P.H i 0 ^ 2) ^ 8 ≤ lo P i a k (Fin.last k))
    (hN1 : 1 ≤ Mval P.r)
    (hfloor : ⌊(1 / P.δ) ^ C⌋₊ = P.d ^ P.C)
    (hsmall : 1 / (P.H i 0 : ℝ) < c * P.δ ^ C')
    (σ : Fin P.r → Bool) : |Y P χ i a k σ| < P.δ := by
  by_contra hcon
  push Not at hcon
  have h := h51 P.δ hδ hδ₀ (Mval P.r) k hN₀ hk hkN hδN hkδ (P.H i (2 * a + 1))
    (P.H i (2 * (a + k)) ^ 2) (lo P i a k) (hi P i a k) h3 hP1 hP12 hP2lo hlohi h4lohi hlog4 hP2pow
    hwin hdisj hprod hwidth (P.lam a (a + k + 1)) hlam1 hlamlog hlamp (f1 P χ i a k σ)
    (f2 P χ a σ) (abs_f1_le P χ i a k σ hH0) (abs_f2_le P χ a σ) hcon (P.H i 0 ^ 2)
    (Nat.one_le_pow _ _ hH0) hHh
  rw [hfloor] at h
  have h63 := sqrt_U1logSq_le (uσ P χ a σ) (abs_uσ_le P χ a σ) (Mval P.r) (P.q a (a + k + 1))
    (P.H i 0) hN1 hH0
  have : c * P.δ ^ C' ≤ 1 / (P.H i 0 : ℝ) := h.trans h63
  linarith

/- ### Largeness of `r` and the main theorem -/

/-- The conditions on `r` used in the proof. -/
structure Big (r C C' N₀ : ℕ) (c δ₀ : ℝ) : Prop where
  r25 : 25 ≤ r
  rC : 32 * C + 8 ≤ r
  rC' : 4 * C' + 1 ≤ r
  rN₀ : N₀ ≤ r
  rδ₀ : 1 / δ₀ ≤ (r : ℝ)
  rc : 1 / c ≤ (r : ℝ)

lemma eventually_big (C C' N₀ : ℕ) (c δ₀ : ℝ) : ∀ᶠ r in atTop, Big r C C' N₀ c δ₀ := by
  have h5 : ∀ᶠ r : ℕ in atTop, 1 / δ₀ ≤ (r : ℝ) :=
    tendsto_natCast_atTop_atTop.eventually_ge_atTop _
  have h6 : ∀ᶠ r : ℕ in atTop, 1 / c ≤ (r : ℝ) :=
    tendsto_natCast_atTop_atTop.eventually_ge_atTop _
  filter_upwards [eventually_ge_atTop 25, eventually_ge_atTop (32 * C + 8),
    eventually_ge_atTop (4 * C' + 1), eventually_ge_atTop N₀, h5, h6] with r a1 a2 a3 a4 a5 a6
  exact ⟨a1, a2, a3, a4, a5, a6⟩

set_option linter.unusedVariables false in
/-- **C4** (draft §6, (20)–(24)): the inverse theorem, applied through random signs.
(The hypothesis `1 ≤ C` is not needed here; it is kept so that the statement matches `Claims`.) -/
theorem corr_lrg_sub_corr' (C : ℕ) (hC : 1 ≤ C) (c : ℝ) (hc : 0 < c) (C' : ℕ) (δ₀ : ℝ)
    (hδ₀ : 0 < δ₀) (N₀ : ℕ) (h51 : Prop51With C c C' δ₀ N₀) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r, ∀ x ∈ (⟨r, C⟩ : Par).triples,
      |corr ⟨r, C⟩ χ x.1 x.2.1 x.2.2 (fL ⟨r, C⟩ χ x.1 x.2.1 x.2.2) -
        corr ⟨r, C⟩ χ x.1 x.2.1 x.2.2 (fun c => fa ⟨r, C⟩ χ x.2.1 c)| ≤
          2 * (⟨r, C⟩ : Par).δ := by
  filter_upwards [eventually_big C C' N₀ c δ₀] with r hB χ x hx
  obtain ⟨i, a, k⟩ := x
  obtain ⟨hi1, hiT, ha1, hk1, hj⟩ := mem_triples hx
  set P : Par := ⟨r, C⟩ with hP
  have hr : 25 ≤ P.r := hB.r25
  have hr1 : 1 ≤ P.r := by omega
  have hrC : 32 * P.C + 8 ≤ P.r := hB.rC
  have hL : 20 ≤ P.L := L_ge P hr
  have hk7 : k ≤ P.r ^ 7 := by omega
  have hj7 : a + k + 1 ≤ P.r ^ 7 := hj
  have hm7 : 2 * (a + 1 + k) ≤ 2 * P.r ^ 7 := by omega
  refine abs_corr_sub_le P χ i a k (fun σ => (abs_Y_lt h51 P χ i a k (delta_pos P hr1)
    (delta_le P hr1 hδ₀ hB.rδ₀) (N₀_le_Mval r N₀ hB.rN₀ hr1) hk1 (k_le_loglog r k hr1 hk7)
    (invδ_le_loglog P hr1) (k_le_invδ_pow P hr1 hk7) (three_le_H P hr1 hi1 _)
    (loglog_Mval_le_P1 P (by omega) hi1 _) (P1_lt_P2 P (by omega) i a k hk1)
    (P2_lt_lo P (by omega) i a k) (lo_lt_hi P (by omega) i a k _)
    (four_lo_le_hi P hr1 hi1 (by omega) a k)
    (log_H_pow_lt P hr (m := 2 * (a + 1 + k)) hiT hm7) (P2pow_le_lo P hL i a k)
    (win_cond P (by omega) i a k) (disj_cond P i a k) (prod_cond P (by omega) i a k hk1)
    (fun ℓ => width_cond P hr hi1 hk7 (m := 2 * (a + 1 + (ℓ : ℕ))) (by omega))
    (one_le_lam P a _) (log_lam_pow_le P hr1 hrC hj7) (lam_prime_lt P hr1 hrC hi1 a _ _)
    (one_le_H P i 0) (Hh_cond P (by omega) i a k) (one_le_Mval _) (floor_eq P)
    (small_cond P hr1 hB.rC' hc hB.rc hi1) σ).le)

end C4
end G22

end

/- ## Section: `Arith` -/

section

/-
# The final arithmetic

With `T = K = r⁷`, `δ = r⁻⁴` and `#triples ≤ T K²`:
`√(TK²)·√(3K²) + 1 + #triples·2δ ≤ r¹⁸/2¹⁷ + 1 + 2r¹⁷ < (r¹⁸ - r¹¹)/2¹⁵ = (T-1)K²/(2¹⁵ r³)`
as soon as `r ≥ 3·2³⁴`.
-/

open Finset Filter

namespace G22.Arith

open G22

lemma card_triples_le (P : Par) : (P.triples.card : ℝ) ≤ (P.r : ℝ) ^ 21 := by
  have h1 : P.triples.card ≤ (P.T - 1) * (P.K * P.K) := by
    unfold Par.triples
    refine (Finset.card_filter_le _ _).trans ?_
    simp [Finset.card_product]
  have h2 : (P.T - 1) * (P.K * P.K) ≤ P.r ^ 21 := by
    unfold Par.T Par.K
    calc (P.r ^ 7 - 1) * (P.r ^ 7 * P.r ^ 7) ≤ P.r ^ 7 * (P.r ^ 7 * P.r ^ 7) :=
          Nat.mul_le_mul_right _ (Nat.sub_le _ _)
      _ = P.r ^ 21 := by ring
  exact_mod_cast h1.trans h2

theorem final_arith' (C : ℕ) :
    ∀ᶠ r in atTop,
      Real.sqrt (((⟨r, C⟩ : Par).T : ℝ) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) *
          Real.sqrt (3 * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) + 1 +
        ((⟨r, C⟩ : Par).triples.card : ℝ) * (2 * (⟨r, C⟩ : Par).δ) <
      (((⟨r, C⟩ : Par).T : ℝ) - 1) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) := by
  filter_upwards [eventually_ge_atTop (3 * 2 ^ 34)] with r hr
  set P : Par := ⟨r, C⟩ with hP
  have hR : (3 * 2 ^ 34 : ℝ) ≤ (r : ℝ) := by exact_mod_cast hr
  have hR1 : (1 : ℝ) ≤ (r : ℝ) := by linarith
  have hRpos : (0 : ℝ) < (r : ℝ) := by linarith
  have hT : (P.T : ℝ) = (r : ℝ) ^ 7 := by simp [hP, Par.T]
  have hK : (P.K : ℝ) = (r : ℝ) ^ 7 := by simp [hP, Par.K]
  have hδ : P.δ = 1 / (r : ℝ) ^ 4 := by simp [hP, Par.δ, Par.d]
  have hcard : (P.triples.card : ℝ) ≤ (r : ℝ) ^ 21 := card_triples_le P
  rw [hT, hK, hδ]
  -- the square-root term
  have hsq : Real.sqrt ((r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2) * Real.sqrt (3 * ((r : ℝ) ^ 7) ^ 2) ≤
      (r : ℝ) ^ 18 / 2 ^ 17 := by
    rw [← Real.sqrt_mul (by positivity)]
    have hb : 0 ≤ (r : ℝ) ^ 18 / 2 ^ 17 := by positivity
    rw [show (r : ℝ) ^ 18 / 2 ^ 17 = Real.sqrt (((r : ℝ) ^ 18 / 2 ^ 17) ^ 2) from
      (Real.sqrt_sq hb).symm]
    apply Real.sqrt_le_sqrt
    have h35 : (r : ℝ) ^ 7 * ((r : ℝ) ^ 7) ^ 2 * (3 * ((r : ℝ) ^ 7) ^ 2) = 3 * (r : ℝ) ^ 35 := by
      ring
    have h36 : ((r : ℝ) ^ 18 / 2 ^ 17) ^ 2 = (r : ℝ) ^ 36 / 2 ^ 34 := by ring
    rw [h35, h36, le_div_iff₀ (by positivity)]
    have : (r : ℝ) ^ 36 = (r : ℝ) ^ 35 * (r : ℝ) := by ring
    rw [this]
    have h35pos : 0 ≤ (r : ℝ) ^ 35 := by positivity
    nlinarith
  -- the triples term
  have htrip : (P.triples.card : ℝ) * (2 * (1 / (r : ℝ) ^ 4)) ≤ 2 * (r : ℝ) ^ 17 := by
    have h4 : (0 : ℝ) < (r : ℝ) ^ 4 := by positivity
    calc (P.triples.card : ℝ) * (2 * (1 / (r : ℝ) ^ 4))
        ≤ (r : ℝ) ^ 21 * (2 * (1 / (r : ℝ) ^ 4)) :=
          mul_le_mul_of_nonneg_right hcard (by positivity)
      _ = 2 * (r : ℝ) ^ 17 := by field_simp
  -- the right-hand side
  have hrhs : ((r : ℝ) ^ 7 - 1) * ((r : ℝ) ^ 7) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) =
      ((r : ℝ) ^ 18 - (r : ℝ) ^ 11) / 2 ^ 15 := by
    field_simp
  rw [hrhs]
  -- compare
  have h17 : (0 : ℝ) ≤ (r : ℝ) ^ 17 := by positivity
  have h11le : (r : ℝ) ^ 11 ≤ (r : ℝ) ^ 17 := pow_le_pow_right₀ hR1 (by norm_num)
  have h18 : (r : ℝ) ^ 18 = (r : ℝ) ^ 17 * (r : ℝ) := by ring
  have hbig : (2 ^ 17 : ℝ) * (r : ℝ) ^ 17 ≤ (r : ℝ) ^ 18 := by
    rw [h18]; nlinarith
  have h1le : (1 : ℝ) ≤ (r : ℝ) ^ 17 := one_le_pow₀ hR1
  have key : (r : ℝ) ^ 18 / 2 ^ 17 + 1 + 2 * (r : ℝ) ^ 17 <
      ((r : ℝ) ^ 18 - (r : ℝ) ^ 11) / 2 ^ 15 := by
    rw [div_add' _ _ _ (by norm_num), div_add' _ _ _ (by norm_num), div_lt_div_iff₀
      (by norm_num) (by norm_num)]
    nlinarith
  linarith

end G22.Arith

end

/- ## Section: `Claims` -/

section

/-
# The four claims of the argument and their assembly

Write `𝒵 = Zsum`, `𝒮 = Ssml`, `𝒮' = Slrg` (see `Setup.lean`). The draft's proof is:

* **C1** (§7): no monochromatic pair ⟹ `𝒵 = 0`;
* **C2** (§§3–4): `𝒮 ≥ B := (t-1)K²/(2¹⁵ r³)` — positivity summed over *all* colours;
* **C3** (§5): `|𝒮 - 𝒮'| ≤ √(tK²)·√(3K²) + 1` — energy summed over *all* colours;
* **C4** (§6): each triple contributes `|corr(P^ℓ f) - corr(f)| ≤ 2δ` — random signs and
  GS Proposition 5.1, with no loss of a factor `r`;
* **final arithmetic**: `√(tK²)√(3K²) + 1 + #triples·2δ < B`.

Then `0 = 𝒵 ≥ 𝒮' - #triples·2δ ≥ 𝒮 - (√(tK²)√(3K²) + 1) - #triples·2δ > 0`, a contradiction.
Only the assembly is proved in this file; the claims are proved in separate files.
-/

open Finset Filter

namespace G22

/-- **C1** (draft §7). If there is no monochromatic pair then `𝒵 = 0`. -/
theorem zsum_eq_zero (P : Par) (hC : 1 ≤ P.C) (hr : 2 ≤ P.r)
    (χ : Finset.Icc 1 (Mval P.r) → Fin P.r)
    (hχ : ¬ Green22.HasMonochromaticSumProduct (Mval P.r) P.r χ) : Zsum P χ = 0 :=
  C1.zsum_eq_zero' P hC hr χ hχ

/-- **C2** (draft §§3–4, (11)–(15)): positivity after the small projections. -/
theorem ssml_lower (C : ℕ) (hC : 1 ≤ C) (CA5 : ℝ) (hCA5 : 0 ≤ CA5) (hA5 : LemmaA5With CA5)
    (c64 : ℝ) (hc64 : 0 < c64) (hCor : Cor64With c64) (CM : ℝ) (hCM : 0 ≤ CM)
    (hM : MertensLowerWith CM) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r,
      (((⟨r, C⟩ : Par).T : ℝ) - 1) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) ≤
        Ssml ⟨r, C⟩ χ :=
  C2.ssml_lower' C hC CA5 hCA5 hA5 c64 hc64 hCor CM hCM hM

/-- **C3** (draft §5, (16)–(19)): replacing the small projections by the large ones. -/
theorem ssml_sub_slrg (C : ℕ) (hC : 1 ≤ C) (CA2 : ℝ) (hCA2 : 0 ≤ CA2) (hA2 : LemmaA2With CA2)
    (C64 : ℝ) (hC64 : 0 ≤ C64) (h64 : Lemma64With C64) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r,
      |Ssml ⟨r, C⟩ χ - Slrg ⟨r, C⟩ χ| ≤
        Real.sqrt (((⟨r, C⟩ : Par).T : ℝ) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) *
          Real.sqrt (3 * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) + 1 :=
  C3.ssml_sub_slrg' C hC CA2 hCA2 hA2 C64 hC64 h64

/-- **C4** (draft §6, (20)–(24)): the inverse theorem, applied through random signs. -/
theorem corr_lrg_sub_corr (C : ℕ) (hC : 1 ≤ C) (c : ℝ) (hc : 0 < c) (C' : ℕ) (δ₀ : ℝ)
    (hδ₀ : 0 < δ₀) (N₀ : ℕ) (h51 : Prop51With C c C' δ₀ N₀) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r, ∀ x ∈ (⟨r, C⟩ : Par).triples,
      |corr ⟨r, C⟩ χ x.1 x.2.1 x.2.2 (fL ⟨r, C⟩ χ x.1 x.2.1 x.2.2) -
        corr ⟨r, C⟩ χ x.1 x.2.1 x.2.2 (fun c => fa ⟨r, C⟩ χ x.2.1 c)| ≤
          2 * (⟨r, C⟩ : Par).δ :=
  C4.corr_lrg_sub_corr' C hC c hc C' δ₀ hδ₀ N₀ h51

/-- **Final arithmetic.** -/
theorem final_arith (C : ℕ) :
    ∀ᶠ r in atTop,
      Real.sqrt (((⟨r, C⟩ : Par).T : ℝ) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) *
          Real.sqrt (3 * ((⟨r, C⟩ : Par).K : ℝ) ^ 2) + 1 +
        ((⟨r, C⟩ : Par).triples.card : ℝ) * (2 * (⟨r, C⟩ : Par).δ) <
      (((⟨r, C⟩ : Par).T : ℝ) - 1) * ((⟨r, C⟩ : Par).K : ℝ) ^ 2 / (2 ^ 15 * (r : ℝ) ^ 3) :=
  Arith.final_arith' C

/-- **Assembly.** Under the GS inputs, for all large `r`, every `r`-colouring of `[1, M]`
has `x, y ≥ 3` with `x + y` and `xy` of the same colour. -/
theorem mono_pair_of_GS (h : GSInputs) :
    ∀ᶠ r in atTop, ∀ χ : Finset.Icc 1 (Mval r) → Fin r,
      Green22.HasMonochromaticSumProduct (Mval r) r χ := by
  obtain ⟨C, hC, c, hc, C', δ₀, hδ₀, N₀, h51⟩ := h.prop51
  obtain ⟨CA2, hCA2, hA2⟩ := h.lemA2
  obtain ⟨CA5, hCA5, hA5⟩ := h.lemA5
  obtain ⟨C64, hC64, h64⟩ := h.lem64
  obtain ⟨c64, hc64, hCor⟩ := h.cor64
  obtain ⟨CM, hCM, hM⟩ := h.mertens
  filter_upwards [ssml_lower C hC CA5 hCA5 hA5 c64 hc64 hCor CM hCM hM,
    ssml_sub_slrg C hC CA2 hCA2 hA2 C64 hC64 h64, corr_lrg_sub_corr C hC c hc C' δ₀ hδ₀ N₀ h51,
    final_arith C, eventually_ge_atTop 2] with r h2 h3 h4 h5 hr χ
  by_contra hχ
  have hZ := zsum_eq_zero ⟨r, C⟩ hC hr χ hχ
  have hsplit : Slrg ⟨r, C⟩ χ - Zsum ⟨r, C⟩ χ =
      ∑ x ∈ (⟨r, C⟩ : Par).triples,
        (corr ⟨r, C⟩ χ x.1 x.2.1 x.2.2 (fL ⟨r, C⟩ χ x.1 x.2.1 x.2.2) -
          corr ⟨r, C⟩ χ x.1 x.2.1 x.2.2 (fun c => fa ⟨r, C⟩ χ x.2.1 c)) := by
    simp only [Slrg, Zsum, Finset.sum_sub_distrib]
  have hdiff : |Slrg ⟨r, C⟩ χ - Zsum ⟨r, C⟩ χ| ≤
      ((⟨r, C⟩ : Par).triples.card : ℝ) * (2 * (⟨r, C⟩ : Par).δ) := by
    rw [hsplit]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum fun x hx => h4 χ x hx).trans ?_
    simp
  have h2' := h2 χ
  have h3' := abs_le.mp (h3 χ)
  have hdiff' := abs_le.mp hdiff
  linarith

end G22

end

/- ## Section: `Main` -/

section

/-
# Conditional solution of `Green22.green_22`

The Formal Conjectures statement (`FormalConjectures/GreensOpenProblems/22.lean`) is

```
theorem green_22 :
    let ans := (answer(⋯) : ℕ → ℝ)
    ∀ᶠ r in atTop, N₀ r ≤ ans r ∧ ans =o[atTop] GreenSawhneyBound
```

We supply the answer `ans r = ⌈exp exp(r⁴³)⌉` and prove the resulting statement from the
Green–Sawhney inputs `GSInputs` (see `Interface.lean`).
-/

open Filter Asymptotics

namespace G22

/-- `N₀(r) ≤ M(r)` for all large `r`, under the GS inputs. -/
theorem N0_le_Mval (h : GSInputs) : ∀ᶠ r in atTop, Green22.N₀ r ≤ Mval r := by
  filter_upwards [mono_pair_of_GS h] with r hr
  exact Nat.sInf_le hr

/-- `exp(r⁵⁰) - exp(r⁴³) → ∞`. -/
lemma tendsto_exp_sub_exp :
    Tendsto (fun r : ℕ => Real.exp ((r : ℝ) ^ 50) - Real.exp ((r : ℝ) ^ 43)) atTop atTop := by
  have key : ∀ r : ℕ, 1 ≤ r → (r : ℝ) - 1 ≤ Real.exp ((r : ℝ) ^ 50) - Real.exp ((r : ℝ) ^ 43) := by
    intro r hr
    have hr' : (1 : ℝ) ≤ r := by exact_mod_cast hr
    have h43 : (r : ℝ) ^ 43 ≤ (r : ℝ) ^ 50 := pow_le_pow_right₀ hr' (by norm_num)
    -- `exp y - exp x = exp x (exp (y - x) - 1) ≥ y - x` for `0 ≤ x ≤ y`
    have h1 : Real.exp ((r : ℝ) ^ 50) - Real.exp ((r : ℝ) ^ 43) =
        Real.exp ((r : ℝ) ^ 43) * (Real.exp ((r : ℝ) ^ 50 - (r : ℝ) ^ 43) - 1) := by
      rw [mul_sub, ← Real.exp_add]; ring_nf
    have h2 : (r : ℝ) ^ 50 - (r : ℝ) ^ 43 ≤ Real.exp ((r : ℝ) ^ 50 - (r : ℝ) ^ 43) - 1 := by
      linarith [Real.add_one_le_exp ((r : ℝ) ^ 50 - (r : ℝ) ^ 43)]
    have h3 : 1 ≤ Real.exp ((r : ℝ) ^ 43) := Real.one_le_exp (by positivity)
    have h4 : (r : ℝ) - 1 ≤ (r : ℝ) ^ 50 - (r : ℝ) ^ 43 := by
      have h7 : (r : ℝ) ≤ (r : ℝ) ^ 7 := by
        calc (r : ℝ) = (r : ℝ) ^ 1 := (pow_one _).symm
          _ ≤ (r : ℝ) ^ 7 := pow_le_pow_right₀ hr' (by norm_num)
      have h43' : (1 : ℝ) ≤ (r : ℝ) ^ 43 := one_le_pow₀ hr'
      have h7' : (0 : ℝ) ≤ (r : ℝ) ^ 7 - 1 := by linarith
      have hsplit : (r : ℝ) ^ 50 - (r : ℝ) ^ 43 = (r : ℝ) ^ 43 * ((r : ℝ) ^ 7 - 1) := by ring
      rw [hsplit]
      have := mul_le_mul_of_nonneg_right h43' h7'
      linarith
    rw [h1]
    have h5 : 0 ≤ (r : ℝ) ^ 50 - (r : ℝ) ^ 43 := by linarith
    nlinarith
  refine tendsto_atTop_mono' atTop ?_ (tendsto_natCast_atTop_atTop.atTop_add
    (tendsto_const_nhds (x := (-1 : ℝ))))
  filter_upwards [eventually_ge_atTop 1] with r hr
  have := key r hr
  linarith

/-- The answer `M(r) = ⌈exp exp(r⁴³)⌉` is `o(exp exp(r⁵⁰))`. -/
theorem Mval_isLittleO : (fun r => (Mval r : ℝ)) =o[atTop] Green22.GreenSawhneyBound := by
  -- `M(r) ≤ 2 exp exp(r⁴³)`
  have hO : (fun r => (Mval r : ℝ)) =O[atTop] fun r : ℕ => Real.exp (Real.exp ((r : ℝ) ^ 43)) := by
    refine IsBigO.of_bound 2 (Eventually.of_forall fun r => ?_)
    have hpos : 0 ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) := (Real.exp_pos _).le
    have h1 : (1 : ℝ) ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) := Real.one_le_exp (Real.exp_pos _).le
    have hceil : (Mval r : ℝ) ≤ Real.exp (Real.exp ((r : ℝ) ^ 43)) + 1 :=
      (Nat.ceil_lt_add_one hpos).le
    rw [Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg hpos]
    linarith
  have ho : (fun r : ℕ => Real.exp (Real.exp ((r : ℝ) ^ 43))) =o[atTop]
      Green22.GreenSawhneyBound := by
    unfold Green22.GreenSawhneyBound
    have := Real.isLittleO_exp_comp_exp_comp.mpr tendsto_exp_sub_exp
    simpa using this
  exact hO.trans_isLittleO ho

/-- **Conditional solution of `Green22.green_22`.** The Formal Conjectures statement, with the
answer `r ↦ ⌈exp exp(r⁴³)⌉` substituted, follows from the Green–Sawhney inputs. -/
theorem green_22_of_GS (h : GSInputs) :
    ∀ᶠ r in atTop, (Green22.N₀ r : ℝ) ≤ (fun r => (Mval r : ℝ)) r ∧
      (fun r => (Mval r : ℝ)) =o[atTop] Green22.GreenSawhneyBound := by
  filter_upwards [N0_le_Mval h] with r hr
  exact ⟨by exact_mod_cast hr, Mval_isLittleO⟩

/-- The same statement in the literal shape of `Green22.green_22`, whose type is
`have ans := answer(⋯); ∀ᶠ r in atTop, ↑(N₀ r) ≤ ans r ∧ ans =o[atTop] GreenSawhneyBound`. -/
theorem green_22_of_GS' (h : GSInputs) :
    have ans : ℕ → ℝ := fun r => (Mval r : ℝ)
    ∀ᶠ r in atTop, (Green22.N₀ r : ℝ) ≤ ans r ∧ ans =o[atTop] Green22.GreenSawhneyBound :=
  green_22_of_GS h

end G22

end

/- ## Section: `ElementaryAux` -/

section

/-
# Elementary Green–Sawhney inputs: auxiliary lemmas

GS = B. Green and M. Sawhney, arXiv:2511.09365v2.

* GS (A.3)/(A.2): shifting inside logarithmic averages (`core_shift`, `logAvg_shift_le`,
  `lemmaA2With_two`);
* GS (A.1) and Lemma 6.2: shifting inside uniform averages (`uavg_shift_le`, `proj_shift_le`,
  `uavg_uavg_dvd_le`);
* the averaging operators `sAvg r H u n = E_{h ∈ [H]} u(n + r h)` (so `Π_{q,H} = P_{q,H} P_{-q,H}`),
  their approximate adjointness for logarithmic averages (`adjoint`), and the steps of GS
  Lemma 6.4 (`lemma64_aux`).
-/

open Finset

namespace G22.Elem

/- ### Generic facts about weighted averages -/

section wavgFacts
variable {α β : Type*}

/-- Fubini for weighted averages. -/
lemma wavg_comm (s : Finset α) (w : α → ℝ) (t : Finset β) (v : β → ℝ) (F : α → β → ℝ) :
    wavg s w (fun x => wavg t v (fun y => F x y)) =
      wavg t v (fun y => wavg s w (fun x => F x y)) := by
  unfold wavg
  simp only [div_eq_mul_inv, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x _ => by ring

lemma wavg_mul_const (s : Finset α) (w : α → ℝ) (f : α → ℝ) (c : ℝ) :
    wavg s w f * c = wavg s w (fun x => f x * c) := by
  rw [mul_comm, ← wavg_smul]
  exact wavg_congr fun x _ => by ring

lemma const_mul_wavg (s : Finset α) (w : α → ℝ) (f : α → ℝ) (c : ℝ) :
    c * wavg s w f = wavg s w (fun x => c * f x) := (wavg_smul c f).symm

lemma abs_wavg_sub_le {s : Finset α} {w : α → ℝ} (h : GoodWeights s w) {f g : α → ℝ} {ε : ℝ}
    (hfg : ∀ x ∈ s, |f x - g x| ≤ ε) : |wavg s w f - wavg s w g| ≤ ε := by
  rw [← wavg_sub]
  exact abs_wavg_le_of_abs_le h hfg

/-- Jensen: `(E f)² ≤ E f²`. -/
lemma wavg_sq_le {s : Finset α} {w : α → ℝ} (h : GoodWeights s w) (f : α → ℝ) :
    (wavg s w f) ^ 2 ≤ wavg s w (fun x => f x ^ 2) := by
  have := wavg_mul_sq_le h f (fun _ => 1)
  simp only [mul_one, one_pow] at this
  rwa [wavg_const h, mul_one] at this

end wavgFacts

lemma abs_sum_weighted_le {ι : Type*} (s : Finset ι) (w : ι → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i)
    (a : ι → ℝ) (ha : ∀ i ∈ s, |a i| ≤ 1) : |∑ i ∈ s, w i * a i| ≤ ∑ i ∈ s, w i := by
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i hi => ?_)
  rw [abs_mul, abs_of_nonneg (hw i hi)]
  exact mul_le_of_le_one_right (hw i hi) (ha i hi)

lemma abs_sum_le_card {ι : Type*} (s : Finset ι) (a : ι → ℝ) (ha : ∀ i ∈ s, |a i| ≤ 1) :
    |∑ i ∈ s, a i| ≤ s.card := by
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  calc ∑ i ∈ s, |a i| ≤ ∑ _i ∈ s, (1 : ℝ) := Finset.sum_le_sum ha
    _ = s.card := by simp

/- ### Harmonic sums -/

/-- `∑_{n ∈ [1,N]} g n = ∑_{i < N} g (i + 1)`. -/
lemma sum_Icc_one_eq_sum_range {M : Type*} [AddCommMonoid M] (g : ℕ → M) (N : ℕ) :
    ∑ n ∈ Icc 1 N, g n = ∑ i ∈ range N, g (i + 1) := by
  induction N with
  | zero => simp
  | succ N ih => rw [Finset.sum_Icc_succ_top (by omega), ih, Finset.sum_range_succ]

/-- The harmonic number `H_k = ∑_{i<k} 1/(i+1)`, as a real number. -/
noncomputable def hR (k : ℕ) : ℝ := ∑ i ∈ range k, 1 / ((i : ℝ) + 1)

lemma hR_eq_harmonic (k : ℕ) : hR k = (harmonic k : ℝ) := by
  unfold hR harmonic
  push_cast
  simp [one_div]

lemma hR_le (k : ℕ) : hR k ≤ 1 + Real.log k := by
  rw [hR_eq_harmonic]; exact harmonic_le_one_add_log k

lemma log_le_hR (k : ℕ) : Real.log k ≤ hR k := by
  rw [hR_eq_harmonic]
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp
  · refine (Real.log_le_log (by exact_mod_cast hk) ?_).trans (log_add_one_le_harmonic k)
    push_cast; linarith

lemma hR_nonneg (k : ℕ) : 0 ≤ hR k := Finset.sum_nonneg fun i _ => by positivity

lemma hR_mono {a b : ℕ} (hab : a ≤ b) : hR a ≤ hR b :=
  Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hab) (fun i _ _ => by positivity)

lemma sum_inv_Icc (N : ℕ) : ∑ n ∈ Icc 1 N, 1 / (n : ℝ) = hR N := by
  rw [sum_Icc_one_eq_sum_range]; unfold hR; push_cast; rfl

/- ### The core estimate GS (A.3) -/

/-- Core of GS (A.3): `|∑_{i<N} F(i+1+k)/(i+1) - ∑_{i<N} F(i+1)/(i+1)| ≤ 2 H_k`. -/
lemma core_shift (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (k N : ℕ) :
    |∑ i ∈ range N, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1 + k) -
      ∑ i ∈ range N, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1)| ≤ 2 * hR k := by
  rcases le_or_gt k N with hkN | hNk
  · obtain ⟨M, rfl⟩ := Nat.exists_eq_add_of_le hkN
    have hA : ∑ i ∈ range (k + M), 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1 + k) =
        ∑ i ∈ range M, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1 + k) +
        ∑ i ∈ range k, 1 / (((M + i : ℕ) : ℝ) + 1) * F (((M + i : ℕ) : ℤ) + 1 + k) := by
      rw [add_comm k M, Finset.sum_range_add]
    have hB : ∑ i ∈ range (k + M), 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1) =
        ∑ i ∈ range k, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1) +
        ∑ i ∈ range M, 1 / (((k + i : ℕ) : ℝ) + 1) * F (((k + i : ℕ) : ℤ) + 1) := by
      rw [Finset.sum_range_add]
    have hH : hR (k + M) = hR k + ∑ i ∈ range M, 1 / (((k + i : ℕ) : ℝ) + 1) := by
      unfold hR; rw [Finset.sum_range_add]
    have hH' : hR (k + M) = hR M + ∑ i ∈ range k, 1 / (((M + i : ℕ) : ℝ) + 1) := by
      unfold hR; rw [add_comm k M, Finset.sum_range_add]
    have h1 : |∑ i ∈ range M, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1 + k) -
        ∑ i ∈ range M, 1 / (((k + i : ℕ) : ℝ) + 1) * F (((k + i : ℕ) : ℤ) + 1)| ≤
        hR M - ∑ i ∈ range M, 1 / (((k + i : ℕ) : ℝ) + 1) := by
      unfold hR
      rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      have e : ∀ i ∈ range M, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1 + k) -
          1 / (((k + i : ℕ) : ℝ) + 1) * F (((k + i : ℕ) : ℤ) + 1) =
          (1 / ((i : ℝ) + 1) - 1 / (((k + i : ℕ) : ℝ) + 1)) * F ((i : ℤ) + 1 + k) := by
        intro i _
        have : (((k + i : ℕ) : ℤ) + 1) = (i : ℤ) + 1 + k := by push_cast; ring
        rw [this]; ring
      rw [Finset.sum_congr rfl e]
      refine abs_sum_weighted_le _ _ (fun i _ => ?_) _ (fun i _ => hF _)
      rw [sub_nonneg]
      apply one_div_le_one_div_of_le (by positivity)
      push_cast; linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
    have h2 : |∑ i ∈ range k, 1 / (((M + i : ℕ) : ℝ) + 1) * F (((M + i : ℕ) : ℤ) + 1 + k)| ≤
        ∑ i ∈ range k, 1 / (((M + i : ℕ) : ℝ) + 1) :=
      abs_sum_weighted_le _ _ (fun i _ => by positivity) _ (fun i _ => hF _)
    have h3 : |∑ i ∈ range k, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1)| ≤ hR k :=
      abs_sum_weighted_le _ _ (fun i _ => by positivity) _ (fun i _ => hF _)
    rw [hA, hB]
    rw [abs_le] at h1 h2 h3 ⊢
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]
  · have hA : |∑ i ∈ range N, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1 + k)| ≤ hR N :=
      abs_sum_weighted_le _ _ (fun i _ => by positivity) _ (fun i _ => hF _)
    have hB : |∑ i ∈ range N, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1)| ≤ hR N :=
      abs_sum_weighted_le _ _ (fun i _ => by positivity) _ (fun i _ => hF _)
    have := hR_mono hNk.le
    rw [abs_le] at hA hB ⊢
    constructor <;> linarith [hA.1, hA.2, hB.1, hB.2]

/- ### GS Lemma A.1, (A.2) -/

lemma logAvg_eq_range (N : ℕ) (F : ℤ → ℝ) :
    logAvg N F = (∑ i ∈ range N, 1 / ((i : ℝ) + 1) * F ((i : ℤ) + 1)) / hR N := by
  unfold logAvg wavg
  rw [sum_inv_Icc, sum_Icc_one_eq_sum_range]
  push_cast
  rfl

lemma log_pos_of_two_le {N : ℕ} (hN : 2 ≤ N) : 0 < Real.log N :=
  Real.log_pos (by exact_mod_cast (show 1 < N by omega))

/-- (A.2) for a shift by a natural number `k`, with the sharp constant `2 H_k`. -/
lemma logAvg_shift_nat (N : ℕ) (hN : 2 ≤ N) (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (k : ℕ) :
    |logAvg N (fun n => F (n + k)) - logAvg N F| ≤ 2 * hR k / Real.log N := by
  have hlogN := log_pos_of_two_le hN
  have hden : Real.log N ≤ hR N := log_le_hR N
  have hden_pos : 0 < hR N := lt_of_lt_of_le hlogN hden
  rw [logAvg_eq_range, logAvg_eq_range, ← sub_div, abs_div, abs_of_pos hden_pos]
  calc _ ≤ 2 * hR k / hR N := div_le_div_of_nonneg_right (core_shift F hF k N) hden_pos.le
    _ ≤ 2 * hR k / Real.log N :=
      div_le_div_of_nonneg_left (by have := hR_nonneg k; positivity) hlogN hden

/-- (A.2) for an integer shift `s` with `|s| ≤ K`. -/
lemma logAvg_shift_le (N : ℕ) (hN : 2 ≤ N) (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (s : ℤ) (K : ℕ)
    (hK : s.natAbs ≤ K) :
    |logAvg N (fun n => F (n + s)) - logAvg N F| ≤ 2 * hR K / Real.log N := by
  have hlogN := log_pos_of_two_le hN
  have hmono : 2 * hR s.natAbs / Real.log N ≤ 2 * hR K / Real.log N := by
    have := hR_mono hK
    apply div_le_div_of_nonneg_right _ hlogN.le
    linarith
  refine le_trans ?_ hmono
  obtain ⟨k, rfl | rfl⟩ := Int.eq_nat_or_neg s
  · simpa using logAvg_shift_nat N hN F hF k
  · have key := logAvg_shift_nat N hN (fun n => F (n - k)) (fun n => hF _) k
    have e1 : (fun n : ℤ => F (n + -(k : ℤ))) = fun n => F (n - k) := by
      ext n; rw [sub_eq_add_neg]
    have e2 : logAvg N F = logAvg N (fun n : ℤ => F (n + k - k)) := by
      congr 1; ext n; rw [add_sub_cancel_right]
    rw [e1, Int.natAbs_neg, Int.natAbs_natCast, abs_sub_comm, e2]
    exact key

lemma logAvg_shift_le' (N : ℕ) (hN : 2 ≤ N) (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (s : ℤ) (K : ℕ)
    (hK : s.natAbs ≤ K) :
    |logAvg N (fun n => F (n + s)) - logAvg N F| ≤ 2 * (1 + Real.log K) / Real.log N := by
  refine (logAvg_shift_le N hN F hF s K hK).trans ?_
  apply div_le_div_of_nonneg_right _ (log_pos_of_two_le hN).le
  linarith [hR_le K]

/-- **GS Lemma A.1, (A.2)** with the constant `2`. -/
theorem lemmaA2With_two : LemmaA2With 2 := by
  intro N hN f hf h _
  rw [abs_sub_comm]
  have := logAvg_shift_le' N hN f hf h h.natAbs le_rfl
  rwa [Nat.cast_natAbs, Int.cast_abs] at this

/- ### Uniform averages: GS (A.1) and GS Lemma 6.2 -/

lemma uavg_eq_range (H : ℕ) (g : ℕ → ℝ) : uavg H g = (∑ i ∈ range H, g (i + 1)) / H := by
  unfold uavg wavg
  simp only [one_mul, Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, mul_one, Nat.add_sub_cancel]
  rw [sum_Icc_one_eq_sum_range]

lemma sum_range_shift (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (H t : ℕ) :
    |∑ i ∈ range H, F ((i : ℤ) + 1 + t) - ∑ i ∈ range H, F ((i : ℤ) + 1)| ≤ 2 * t := by
  have e1 : ∑ i ∈ range (H + t), F ((i : ℤ) + 1) =
      ∑ i ∈ range t, F ((i : ℤ) + 1) + ∑ i ∈ range H, F (((t + i : ℕ) : ℤ) + 1) := by
    rw [add_comm H t, Finset.sum_range_add]
  have e2 : ∑ i ∈ range (H + t), F ((i : ℤ) + 1) =
      ∑ i ∈ range H, F ((i : ℤ) + 1) + ∑ i ∈ range t, F (((H + i : ℕ) : ℤ) + 1) := by
    rw [Finset.sum_range_add]
  have h1 : ∑ i ∈ range H, F ((i : ℤ) + 1 + t) = ∑ i ∈ range H, F (((t + i : ℕ) : ℤ) + 1) :=
    Finset.sum_congr rfl fun i _ => by congr 1; push_cast; ring
  have b1 : |∑ i ∈ range t, F (((H + i : ℕ) : ℤ) + 1)| ≤ t := by
    have := abs_sum_le_card (range t) (fun i => F (((H + i : ℕ) : ℤ) + 1)) (fun i _ => hF _)
    rwa [Finset.card_range] at this
  have b2 : |∑ i ∈ range t, F ((i : ℤ) + 1)| ≤ t := by
    have := abs_sum_le_card (range t) (fun i => F ((i : ℤ) + 1)) (fun i _ => hF _)
    rwa [Finset.card_range] at this
  rw [h1]
  rw [abs_le] at b1 b2 ⊢
  constructor <;> linarith [b1.1, b1.2, b2.1, b2.2]

lemma uavg_shift_nat (H : ℕ) (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (t : ℕ) :
    |uavg H (fun h => F ((h : ℤ) + t)) - uavg H (fun h => F h)| ≤ 2 * t / H := by
  rcases Nat.eq_zero_or_pos H with rfl | hH
  · simp [uavg_eq_range]
  have hHpos : (0 : ℝ) < H := by exact_mod_cast hH
  rw [uavg_eq_range, uavg_eq_range, ← sub_div, abs_div, abs_of_pos hHpos]
  apply div_le_div_of_nonneg_right _ hHpos.le
  have := sum_range_shift F hF H t
  push_cast
  exact this

/-- **GS (A.1)**: shifting a 1-bounded function by `s` changes its uniform average over `[H]`
by at most `2|s|/H`. -/
theorem uavg_shift_le (H : ℕ) (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) (s : ℤ) :
    |uavg H (fun h => F ((h : ℤ) + s)) - uavg H (fun h => F h)| ≤ 2 * |(s : ℝ)| / H := by
  obtain ⟨t, rfl | rfl⟩ := Int.eq_nat_or_neg s
  · simpa using uavg_shift_nat H F hF t
  · have key := uavg_shift_nat H (fun n => F (n - t)) (fun n => hF _) t
    have e1 : (fun h : ℕ => F ((h : ℤ) + -(t : ℤ))) = fun h : ℕ => F ((h : ℤ) - t) := by
      ext h; rw [sub_eq_add_neg]
    have e2 : (fun h : ℕ => F (h : ℤ)) = fun h : ℕ => F ((h : ℤ) + t - t) := by
      ext h; rw [add_sub_cancel_right]
    rw [e1, e2, abs_sub_comm]
    have e3 : |((-(t : ℤ) : ℤ) : ℝ)| = t := by push_cast; rw [abs_neg, Nat.abs_cast]
    rw [e3]
    exact key

/-- **GS Lemma 6.2**: `|Π_{q,H} f(n + qs) - Π_{q,H} f(n)| ≤ 2|s|/H` for 1-bounded `f`. -/
theorem proj_shift_le (q H : ℕ) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (n s : ℤ) :
    |proj q H f (n + q * s) - proj q H f n| ≤ 2 * |(s : ℝ)| / H := by
  rcases Nat.eq_zero_or_pos H with rfl | hH
  · simp [proj, uavg_eq_range]
  have hG : ∀ j : ℤ, |uavg H (fun h' => f (n + q * (j - h')))| ≤ 1 := fun j =>
    abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun _ _ => hf _
  have key := uavg_shift_le H (fun j => uavg H (fun h' => f (n + q * (j - h')))) hG s
  have e1 : proj q H f (n + q * s) =
      uavg H (fun h => (fun j : ℤ => uavg H (fun h' => f (n + q * (j - h')))) ((h : ℤ) + s)) := by
    unfold proj; congr 1; ext h; congr 1; ext h'; congr 1; ring
  rw [e1]
  exact key

/-- GS (A.1), second consequence: if `q ∣ q'` then
`|E_{h∈[H]} E_{h'∈[H']} f(n + qh - q'h') - E_{h∈[H]} f(n + qh)| ≤ 2 (q'/q) H'/H`. -/
theorem uavg_uavg_dvd_le {q q' : ℕ} (hqq' : q ∣ q') (hq : 1 ≤ q) {H H' : ℕ} (hH' : 1 ≤ H')
    (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (n : ℤ) :
    |uavg H (fun h => uavg H' (fun h' => f (n + q * h - q' * h'))) -
        uavg H (fun h => f (n + q * h))| ≤ 2 * ((q' : ℝ) / q) * H' / H := by
  obtain ⟨m, rfl⟩ := hqq'
  have hq0 : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                               exact this.ne'
  have em : ((q * m : ℕ) : ℝ) / q = m := by push_cast; field_simp
  rw [em]
  have e1 : uavg H (fun h => uavg H' (fun h' => f (n + q * h - ((q * m : ℕ) : ℤ) * h'))) =
      uavg H' (fun h' => uavg H (fun h => f (n + q * h - ((q * m : ℕ) : ℤ) * h'))) :=
    wavg_comm _ _ _ _ _
  have e2 : uavg H (fun h => f (n + q * h)) =
      uavg H' (fun _ => uavg H (fun h => f (n + q * h))) :=
    (wavg_const (goodWeights_uavg hH') _).symm
  rw [e1, e2]
  refine abs_wavg_sub_le (goodWeights_uavg hH') fun h' hh' => ?_
  have hh'H : (h' : ℝ) ≤ H' := by exact_mod_cast (Finset.mem_Icc.mp hh').2
  have key := uavg_shift_le H (fun j => f (n + q * j)) (fun _ => hf _) (-((m : ℤ) * h'))
  have e3 : uavg H (fun h => f (n + q * h - ((q * m : ℕ) : ℤ) * h')) =
      uavg H (fun h => (fun j : ℤ => f (n + q * j)) ((h : ℤ) + -((m : ℤ) * h'))) := by
    congr 1; ext h; congr 1; push_cast; ring
  rw [e3]
  refine key.trans ?_
  have e4 : |((-((m : ℤ) * h') : ℤ) : ℝ)| = (m : ℝ) * h' := by
    push_cast; rw [abs_neg, abs_of_nonneg (by positivity)]
  rw [e4]
  rcases Nat.eq_zero_or_pos H with rfl | hH
  · simp
  have hHpos : (0 : ℝ) < H := by exact_mod_cast hH
  apply div_le_div_of_nonneg_right _ hHpos.le
  have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  nlinarith

/- ### The averaging operators `P_{r,H} u (n) = E_{h ∈ [H]} u(n + r h)` -/

/-- `sAvg r H u n = E_{h ∈ [H]} u (n + r h)`. -/
noncomputable def sAvg (r : ℤ) (H : ℕ) (u : ℤ → ℝ) (n : ℤ) : ℝ := uavg H (fun h => u (n + r * h))

lemma sAvg_comm (r r' : ℤ) (H H' : ℕ) (u : ℤ → ℝ) (n : ℤ) :
    sAvg r H (sAvg r' H' u) n = sAvg r' H' (sAvg r H u) n := by
  unfold sAvg uavg
  rw [wavg_comm]
  refine wavg_congr fun h' _ => wavg_congr fun h _ => ?_
  congr 1; ring

lemma sAvg_comm_fun (r r' : ℤ) (H H' : ℕ) (u : ℤ → ℝ) :
    sAvg r H (sAvg r' H' u) = sAvg r' H' (sAvg r H u) := funext (sAvg_comm r r' H H' u)

lemma proj_eq_sAvg (q H : ℕ) (f : ℤ → ℝ) : proj q H f = sAvg q H (sAvg (-(q : ℤ)) H f) := by
  funext n
  unfold proj sAvg uavg
  refine wavg_congr fun h _ => wavg_congr fun h' _ => ?_
  congr 1; ring

lemma abs_sAvg_le {H : ℕ} (hH : 1 ≤ H) {u : ℤ → ℝ} (hu : ∀ n, |u n| ≤ 1) (r n : ℤ) :
    |sAvg r H u n| ≤ 1 :=
  abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun _ _ => hu _

lemma sAvg_nonneg {H : ℕ} (hH : 1 ≤ H) {u : ℤ → ℝ} (hu : ∀ n, 0 ≤ u n) (r n : ℤ) :
    0 ≤ sAvg r H u n :=
  wavg_nonneg (goodWeights_uavg hH) fun _ _ => hu _

lemma sAvg_le_one {H : ℕ} (hH : 1 ≤ H) {u : ℤ → ℝ} (hu : ∀ n, u n ≤ 1) (r n : ℤ) :
    sAvg r H u n ≤ 1 :=
  wavg_le_of_le (goodWeights_uavg hH) fun _ _ => hu _

lemma sAvg_mono {H : ℕ} (hH : 1 ≤ H) {u v : ℤ → ℝ} (huv : ∀ n, u n ≤ v n) (r n : ℤ) :
    sAvg r H u n ≤ sAvg r H v n :=
  wavg_mono (goodWeights_uavg hH) fun _ _ => huv _

lemma sAvg_sq_le {H : ℕ} (hH : 1 ≤ H) (u : ℤ → ℝ) (r n : ℤ) :
    (sAvg r H u n) ^ 2 ≤ sAvg r H (fun m => u m ^ 2) n :=
  wavg_sq_le (goodWeights_uavg hH) _

lemma sAvg_shift_le (q H : ℕ) (u : ℤ → ℝ) (hu : ∀ n, |u n| ≤ 1) (n s : ℤ) :
    |sAvg q H u (n + q * s) - sAvg q H u n| ≤ 2 * |(s : ℝ)| / H := by
  have key := uavg_shift_le H (fun j => u (n + q * j)) (fun _ => hu _) s
  have e1 : sAvg q H u (n + q * s) =
      uavg H (fun h => (fun j : ℤ => u (n + q * j)) ((h : ℤ) + s)) := by
    unfold sAvg; congr 1; ext h; congr 1; ring
  rw [e1]; exact key

lemma abs_mul_le_one {a b : ℝ} (ha : |a| ≤ 1) (hb : |b| ≤ 1) : |a * b| ≤ 1 := by
  rw [abs_mul]; nlinarith [abs_nonneg a, abs_nonneg b]

lemma sq_sub_sq_le {x y d : ℝ} (hx : |x| ≤ 1) (hy : |y| ≤ 1) (hxy : |x - y| ≤ d) :
    x ^ 2 - y ^ 2 ≤ 2 * d := by
  have h1 : x ^ 2 - y ^ 2 = (x - y) * (x + y) := by ring
  have h2 : |x + y| ≤ 2 := (abs_add_le x y).trans (by linarith)
  rw [h1]
  calc (x - y) * (x + y) ≤ |(x - y) * (x + y)| := le_abs_self _
    _ = |x - y| * |x + y| := abs_mul _ _
    _ ≤ d * 2 := mul_le_mul hxy h2 (abs_nonneg _) (le_trans (abs_nonneg _) hxy)
    _ = 2 * d := by ring

/- ### Shifting inside logarithmic averages -/

/-- The error term `2 H_K / log N` of (A.2). -/
noncomputable def eA (N K : ℕ) : ℝ := 2 * hR K / Real.log N

lemma eA_nonneg {N : ℕ} (hN : 2 ≤ N) (K : ℕ) : 0 ≤ eA N K := by
  unfold eA; have := hR_nonneg K; have := log_pos_of_two_le hN; positivity

lemma eA_mono {N : ℕ} (hN : 2 ≤ N) {K K' : ℕ} (h : K ≤ K') : eA N K ≤ eA N K' := by
  unfold eA; apply div_le_div_of_nonneg_right _ (log_pos_of_two_le hN).le; linarith [hR_mono h]

lemma eA_le {N : ℕ} (hN : 2 ≤ N) (K : ℕ) : eA N K ≤ 2 * (1 + Real.log K) / Real.log N := by
  unfold eA; apply div_le_div_of_nonneg_right _ (log_pos_of_two_le hN).le; linarith [hR_le K]

lemma logAvg_uavg_comm (N H : ℕ) (G : ℕ → ℤ → ℝ) :
    logAvg N (fun n => uavg H (fun h => G h n)) = uavg H (fun h => logAvg N (G h)) :=
  wavg_comm _ _ _ _ _

/-- Averaged shift: for 1-bounded `W h` and `|r| H ≤ K`,
`|E^log_n E_h W_h(n + r h) - E^log_n E_h W_h(n)| ≤ 2 H_K / log N`. -/
lemma logAvg_uavg_shift (N : ℕ) (hN : 2 ≤ N) {H : ℕ} (hH : 1 ≤ H) (W : ℕ → ℤ → ℝ)
    (hW : ∀ h n, |W h n| ≤ 1) (r : ℤ) (K : ℕ) (hK : r.natAbs * H ≤ K) :
    |logAvg N (fun n => uavg H (fun h => W h (n + r * h))) -
      logAvg N (fun n => uavg H (fun h => W h n))| ≤ eA N K := by
  have e1 : logAvg N (fun n => uavg H (fun h => W h (n + r * h))) =
      uavg H (fun h => logAvg N (fun n => W h (n + r * h))) := logAvg_uavg_comm N H _
  have e2 : logAvg N (fun n => uavg H (fun h => W h n)) = uavg H (fun h => logAvg N (W h)) :=
    logAvg_uavg_comm N H _
  rw [e1, e2]
  refine abs_wavg_sub_le (goodWeights_uavg hH) fun h hh => ?_
  have hhH : h ≤ H := (Finset.mem_Icc.mp hh).2
  have hK' : (r * (h : ℤ)).natAbs ≤ K := by
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    exact le_trans (Nat.mul_le_mul_left _ hhH) hK
  exact logAvg_shift_le N hN (W h) (hW h) (r * h) K hK'

/-- `|E^log P_{r,H} w - E^log w| ≤ 2 H_K / log N` for 1-bounded `w` and `|r| H ≤ K`. -/
lemma logAvg_sAvg_sub (N : ℕ) (hN : 2 ≤ N) {H : ℕ} (hH : 1 ≤ H) (w : ℤ → ℝ)
    (hw : ∀ n, |w n| ≤ 1) (r : ℤ) (K : ℕ) (hK : r.natAbs * H ≤ K) :
    |logAvg N (sAvg r H w) - logAvg N w| ≤ eA N K := by
  have e : logAvg N w = logAvg N (fun n => uavg H (fun _ => w n)) := by
    congr 1; funext n; exact (wavg_const (goodWeights_uavg hH) (w n)).symm
  rw [e]
  exact logAvg_uavg_shift N hN hH (fun _ m => w m) (fun _ m => hw m) r K hK

/-- Approximate adjointness: `|⟨P_{r,H} u, v⟩ - ⟨u, P_{-r,H} v⟩| ≤ 2 H_K / log N`. -/
lemma adjoint (N : ℕ) (hN : 2 ≤ N) {H : ℕ} (hH : 1 ≤ H) (u v : ℤ → ℝ) (hu : ∀ n, |u n| ≤ 1)
    (hv : ∀ n, |v n| ≤ 1) (r : ℤ) (K : ℕ) (hK : r.natAbs * H ≤ K) :
    |logAvg N (fun n => sAvg r H u n * v n) - logAvg N (fun n => u n * sAvg (-r) H v n)| ≤
      eA N K := by
  have hW : ∀ (h : ℕ) (m : ℤ), |u m * v (m - r * h)| ≤ 1 := fun h m => abs_mul_le_one (hu m) (hv _)
  have e1 : ∀ n, sAvg r H u n * v n = uavg H (fun h => u (n + r * h) * v (n + r * h - r * h)) := by
    intro n; unfold sAvg uavg; rw [wavg_mul_const]
    exact wavg_congr fun h _ => by rw [add_sub_cancel_right]
  have e2 : ∀ n, u n * sAvg (-r) H v n = uavg H (fun h => u n * v (n - r * h)) := by
    intro n; unfold sAvg uavg; rw [const_mul_wavg]
    exact wavg_congr fun h _ => by rw [neg_mul, ← sub_eq_add_neg]
  simp_rw [e1, e2]
  exact logAvg_uavg_shift N hN hH (fun h m => u m * v (m - r * h)) hW r K hK

/- ### GS Lemma 6.4 -/

/-- `‖a - b‖² = ‖a‖² - 2⟨a,b⟩ + ‖b‖²`. -/
lemma normSq_sub (N : ℕ) (a b : ℤ → ℝ) :
    normSq N (fun n => a n - b n) =
      normSq N a - 2 * logAvg N (fun n => a n * b n) + normSq N b := by
  unfold normSq logAvg
  rw [← wavg_smul, ← wavg_sub, ← wavg_add]
  exact wavg_congr fun n _ => by ring

/-- Steps 1–2 of GS Lemma 6.4: `⟨Π_{q',H'} f, Π_{q,H} f⟩ ≈ ‖P_{q,H} P_{-q',H'} f‖²`. -/
lemma step12 (N : ℕ) (hN : 2 ≤ N) (q m H H' : ℕ) (hH : 1 ≤ H) (hH' : 1 ≤ H') (f : ℤ → ℝ)
    (hf : ∀ n, |f n| ≤ 1) :
    |logAvg N (fun n => proj (q * m) H' f n * proj q H f n) -
      normSq N (sAvg q H (sAvg (-((q * m : ℕ) : ℤ)) H' f))| ≤
        eA N (q * m * H') + eA N (q * H) := by
  have hU : ∀ n, |sAvg (-((q * m : ℕ) : ℤ)) H' f n| ≤ 1 := abs_sAvg_le hH' hf _
  have hv : ∀ n, |sAvg q H f n| ≤ 1 := abs_sAvg_le hH hf _
  have hb : ∀ n, |proj q H f n| ≤ 1 := by
    rw [proj_eq_sAvg]; exact abs_sAvg_le hH (abs_sAvg_le hH hf _) _
  have hX : ∀ n, |sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f) n| ≤ 1 := abs_sAvg_le hH' hv _
  have A1 := adjoint N hN hH' (sAvg (-((q * m : ℕ) : ℤ)) H' f) (proj q H f) hU hb
    ((q * m : ℕ) : ℤ) (q * m * H') (by rw [Int.natAbs_natCast])
  have e1 : sAvg (-((q * m : ℕ) : ℤ)) H' (proj q H f) =
      sAvg (-(q : ℤ)) H (sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f)) := by
    rw [proj_eq_sAvg, sAvg_comm_fun (q : ℤ) (-(q : ℤ)),
      sAvg_comm_fun (-((q * m : ℕ) : ℤ)) (-(q : ℤ))]
  have A2 := adjoint N hN hH (sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f))
    (sAvg (-((q * m : ℕ) : ℤ)) H' f) hX hU (-(q : ℤ)) (q * H) (by simp)
  have e2 : sAvg (-(-(q : ℤ))) H (sAvg (-((q * m : ℕ) : ℤ)) H' f) =
      sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f) := by
    rw [neg_neg, sAvg_comm_fun]
  rw [e2] at A2
  rw [e1] at A1
  have e3 : sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f) =
      sAvg q H (sAvg (-((q * m : ℕ) : ℤ)) H' f) := sAvg_comm_fun _ _ _ _ _
  have e4 : proj (q * m) H' f = sAvg ((q * m : ℕ) : ℤ) H' (sAvg (-((q * m : ℕ) : ℤ)) H' f) :=
    proj_eq_sAvg _ _ _
  have e5 : logAvg N (fun n => sAvg (-((q * m : ℕ) : ℤ)) H' f n *
        sAvg (-(q : ℤ)) H (sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f)) n) =
      logAvg N (fun n => sAvg (-(q : ℤ)) H (sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f)) n *
        sAvg (-((q * m : ℕ) : ℤ)) H' f n) := by
    congr 1; funext n; ring
  have e6 : normSq N (sAvg q H (sAvg (-((q * m : ℕ) : ℤ)) H' f)) =
      logAvg N (fun n => sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f) n *
        sAvg (-((q * m : ℕ) : ℤ)) H' (sAvg q H f) n) := by
    rw [← e3]; unfold normSq; congr 1; funext n; ring
  rw [e4, e6]
  rw [e5] at A1
  calc _ ≤ _ := abs_sub_le _ _ _
    _ ≤ _ := add_le_add A1 A2

/-- Step 3 of GS Lemma 6.4 (pointwise): by (A.1) with `q ∣ q'`,
`|P_{q,H} P_{-q',H'} f(n) - P_{q,H} f(n)| ≤ 2 (q'/q) H'/H`. -/
lemma step3_pt {q m H H' : ℕ} (hH' : 1 ≤ H') (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (n : ℤ) :
    |sAvg q H (sAvg (-((q * m : ℕ) : ℤ)) H' f) n - sAvg q H f n| ≤ 2 * ((m : ℝ) * H') / H := by
  rw [sAvg_comm]
  have e : sAvg (q : ℤ) H f n = uavg H' (fun _ => sAvg q H f n) :=
    (wavg_const (goodWeights_uavg hH') _).symm
  rw [e]
  refine abs_wavg_sub_le (goodWeights_uavg hH') fun h' hh' => ?_
  have hh'H : (h' : ℝ) ≤ H' := by exact_mod_cast (Finset.mem_Icc.mp hh').2
  have key := sAvg_shift_le q H f hf n (-((m : ℤ) * h'))
  have e2 : n + -((q * m : ℕ) : ℤ) * h' = n + q * (-((m : ℤ) * h')) := by push_cast; ring
  show |sAvg q H f (n + -((q * m : ℕ) : ℤ) * h') - sAvg q H f n| ≤ _
  rw [e2]
  refine key.trans ?_
  have e4 : |((-((m : ℤ) * h') : ℤ) : ℝ)| = (m : ℝ) * h' := by
    push_cast; rw [abs_neg, abs_of_nonneg (by positivity)]
  rw [e4]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg H)
  have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  nlinarith

/-- Step 3 of GS Lemma 6.4. -/
lemma step3 (N : ℕ) (hN : 2 ≤ N) {q m H H' : ℕ} (hH : 1 ≤ H) (hH' : 1 ≤ H') (f : ℤ → ℝ)
    (hf : ∀ n, |f n| ≤ 1) :
    normSq N (sAvg q H f) - 4 * ((m : ℝ) * H' / H) ≤
      normSq N (sAvg q H (sAvg (-((q * m : ℕ) : ℤ)) H' f)) := by
  have hg := goodWeights_logAvg (show 1 ≤ N by omega)
  have hpt : ∀ n, sAvg q H f n ^ 2 - 4 * ((m : ℝ) * H' / H) ≤
      sAvg q H (sAvg (-((q * m : ℕ) : ℤ)) H' f) n ^ 2 := by
    intro n
    have h1 := step3_pt (q := q) (m := m) (H := H) hH' f hf n
    rw [abs_sub_comm] at h1
    have := sq_sub_sq_le (abs_sAvg_le hH hf _ n) (abs_sAvg_le hH (abs_sAvg_le hH' hf _) _ n) h1
    have e : 2 * (2 * ((m : ℝ) * H') / H) = 4 * ((m : ℝ) * H' / H) := by ring
    linarith
  unfold normSq logAvg
  rw [← wavg_const hg (4 * ((m : ℝ) * H' / H)), ← wavg_sub]
  exact wavg_mono hg fun n _ => hpt n

/-- Step 4 of GS Lemma 6.4: `‖Π_{q,H} f‖² ≤ ‖P_{q,H} f‖² + O(log(qH)/log N)`. -/
lemma step4 (N : ℕ) (hN : 2 ≤ N) {q H : ℕ} (hH : 1 ≤ H) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    normSq N (proj q H f) ≤ normSq N (sAvg q H f) + eA N (q * H) := by
  have hg := goodWeights_logAvg (show 1 ≤ N by omega)
  have hv : ∀ n, |sAvg q H f n| ≤ 1 := abs_sAvg_le hH hf _
  have hv2 : ∀ n, |sAvg q H f n ^ 2| ≤ 1 := fun n => by
    rw [abs_pow]; exact pow_le_one₀ (abs_nonneg _) (hv n)
  have e : proj q H f = sAvg (-(q : ℤ)) H (sAvg q H f) := by
    rw [proj_eq_sAvg, sAvg_comm_fun]
  have h1 : normSq N (proj q H f) ≤ logAvg N (sAvg (-(q : ℤ)) H (fun m => sAvg q H f m ^ 2)) := by
    rw [e]; unfold normSq logAvg
    exact wavg_mono hg fun n _ => sAvg_sq_le hH _ _ _
  have h2 := logAvg_sAvg_sub N hN hH (fun m => sAvg q H f m ^ 2) hv2 (-(q : ℤ)) (q * H) (by simp)
  have h3 := (abs_le.mp h2).2
  have h4 : normSq N (sAvg q H f) = logAvg N (fun m => sAvg q H f m ^ 2) := rfl
  linarith

/-- GS Lemma 6.4 with explicit error terms. -/
theorem lemma64_aux (N q q' H H' : ℕ) (hN : 2 ≤ N) (hq : 1 ≤ q) (hqq' : q ∣ q') (hH' : 1 ≤ H')
    (hHH : H' ≤ H) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    normSq N (fun n => proj q' H' f n - proj q H f n) ≤
      normSq N (proj q' H' f) - normSq N (proj q H f) +
        (4 * eA N (q * H) + 2 * eA N (q' * H') + 8 * ((q' : ℝ) * H' / ((q : ℝ) * H))) := by
  have hH : 1 ≤ H := le_trans hH' hHH
  obtain ⟨m, rfl⟩ := hqq'
  have s12 := step12 N hN q m H H' hH hH' f hf
  have s3 := step3 N hN (q := q) (m := m) hH hH' f hf
  have s4 := step4 N hN (q := q) hH f hf
  have ex := normSq_sub N (proj (q * m) H' f) (proj q H f)
  have hratio : (m : ℝ) * H' / H = ((q * m : ℕ) : ℝ) * H' / ((q : ℝ) * H) := by
    have : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                             exact this.ne'
    push_cast; field_simp
  rw [← hratio]
  have := (abs_le.mp s12).1
  linarith

end G22.Elem

end

/- ## Section: `Elementary` -/

section

/-
# The elementary Green–Sawhney inputs

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. Main results (namespace `G22.Elem`):

* `lemmaA2 : LemmaA2` — GS Lemma A.1, (A.2), with the constant `2` (`lemmaA2With_two`);
* `cor64 : Cor64` — GS (6.4), the corollary of GS Lemma 6.5, with `c = 1/1000`
  (`cor64With_c`; Lemma 6.5 itself is `lemma65`);
* `lemma64' : ∃ C, 0 ≤ C ∧ Lemma64PosWith C` — GS Lemma 6.4 with `C = 40`
  (`lemma64PosWith_forty`).

**Warning.** `Lemma64` as stated in `Interface.lean` is *false*: its hypothesis `q ∣ q'` allows
`q' = 0`, where `Π_{0,H'} f = f` and the error term `C (log(q'H)/log N + q'H'/(qH))` vanishes
(`Real.log 0 = 0`). See `not_lemma64ZeroWith` (explicit counterexample `N = 2, q = 1, q' = 0, H = 2,
H' = 1, f = 1_{0}`). `Lemma64PosWith` is `Lemma64With` with the extra hypothesis `1 ≤ q'`
inserted after `q ∣ q'`; this is what GS prove and what is proved here.

Reusable lemmas from `ElementaryAux.lean`: `uavg_shift_le` (GS (A.1)), `proj_shift_le`
(GS Lemma 6.2), `uavg_uavg_dvd_le` (GS (A.1) with `q ∣ q'`), `logAvg_shift_le'` ((A.2) for a
shift `s` with `|s| ≤ K`), `adjoint`, `logAvg_uavg_shift`.
-/

open Finset

namespace G22.Elem

/- ### GS Lemma A.1, (A.2) -/

/-- **GS Lemma A.1, (A.2)**, with the constant `2` (`LemmaA2With 2`). -/
theorem lemmaA2 : LemmaA2 := ⟨2, by norm_num, lemmaA2With_two⟩

/- ### GS Lemma 6.4 -/

/-- `Lemma64With` with the additional hypothesis `1 ≤ q'`. -/
def Lemma64PosWith (C : ℝ) : Prop :=
  ∀ (N q q' H H' : ℕ), 2 ≤ N → 1 ≤ q → q ∣ q' → 1 ≤ q' → 1 ≤ H' → H' ≤ H →
    ∀ (f : ℤ → ℝ), (∀ n, |f n| ≤ 1) →
      normSq N (fun n => proj q' H' f n - proj q H f n) ≤
        normSq N (proj q' H' f) - normSq N (proj q H f) +
          C * (Real.log ((q' : ℝ) * H) / Real.log N + (q' : ℝ) * H' / ((q : ℝ) * H))

/-- **GS Lemma 6.4** (for `q' ≥ 1`) with the constant `40`. -/
theorem lemma64PosWith_forty : Lemma64PosWith 40 := by
  intro N q q' H H' hN hq hqq' hq' hH' hHH f hf
  have hH : 1 ≤ H := le_trans hH' hHH
  have hlogN := log_pos_of_two_le hN
  have hqle : q ≤ q' := Nat.le_of_dvd hq' hqq'
  have main := lemma64_aux N q q' H H' hN hq hqq' hH' hHH f hf
  have hR0 : 0 ≤ (q' : ℝ) * H' / ((q : ℝ) * H) := by positivity
  rcases (show q' * H = 1 ∨ 2 ≤ q' * H by
      rcases Nat.lt_or_ge (q' * H) 2 with h | h
      · left; have : 1 ≤ q' * H := Nat.mul_le_mul hq' hH
        omega
      · right; exact h) with h1 | h2
  · have hq'1 : q' = 1 := Nat.eq_one_of_mul_eq_one_right h1
    have hH1 : H = 1 := by rw [hq'1, one_mul] at h1; exact h1
    have hq1 : q = 1 := by omega
    have hH'1 : H' = 1 := by omega
    subst hq'1 hH1 hq1 hH'1
    have e0 : normSq N (fun n => proj 1 1 f n - proj 1 1 f n) = 0 := by
      simp [normSq, logAvg, wavg]
    rw [e0]; norm_num
  · set L := Real.log ((q' : ℝ) * H) with hLdef
    have hL : (1 : ℝ) / 2 ≤ L := by
      have : Real.log 2 ≤ L := Real.log_le_log (by norm_num) (by exact_mod_cast h2)
      linarith [Real.log_two_gt_d9]
    have hbase : eA N (q' * H) ≤ 6 * (L / Real.log N) := by
      have := eA_le hN (q' * H)
      push_cast at this
      rw [← hLdef] at this
      refine this.trans ?_
      rw [mul_div_assoc']
      apply div_le_div_of_nonneg_right _ hlogN.le
      linarith
    have b1 : eA N (q * H) ≤ 6 * (L / Real.log N) :=
      (eA_mono hN (Nat.mul_le_mul_right H hqle)).trans hbase
    have b2 : eA N (q' * H') ≤ 6 * (L / Real.log N) :=
      (eA_mono hN (Nat.mul_le_mul_left q' hHH)).trans hbase
    have hLN : 0 ≤ L / Real.log N := by
      have : 0 ≤ L := by linarith
      positivity
    linarith

/-- **GS Lemma 6.4** for `q' ≥ 1`. -/
theorem lemma64' : ∃ C : ℝ, 0 ≤ C ∧ Lemma64PosWith C := ⟨40, by norm_num, lemma64PosWith_forty⟩

/-- **GS Lemma 6.4** in the (corrected) form of `Interface.lean`. -/
theorem lemma64 : Lemma64 := lemma64'

/-- The first transcription of GS Lemma 6.4 (without `1 ≤ q'`), kept to record why the
hypothesis was added to `Interface.lean`. -/
def Lemma64ZeroWith (C : ℝ) : Prop :=
  ∀ (N q q' H H' : ℕ), 2 ≤ N → 1 ≤ q → q ∣ q' → 1 ≤ H' → H' ≤ H →
    ∀ (f : ℤ → ℝ), (∀ n, |f n| ≤ 1) →
      normSq N (fun n => proj q' H' f n - proj q H f n) ≤
        normSq N (proj q' H' f) - normSq N (proj q H f) +
          C * (Real.log ((q' : ℝ) * H) / Real.log N + (q' : ℝ) * H' / ((q : ℝ) * H))

/-- The first transcription is false for every `C`: `q ∣ q'` allows `q' = 0`.
Counterexample: `N = 2`, `q = 1`, `q' = 0`, `H = 2`, `H' = 1`, `f = 1_{0}`. -/
theorem not_lemma64ZeroWith (C : ℝ) : ¬ Lemma64ZeroWith C := by
  intro h
  have hf : ∀ n : ℤ, |(if n = 0 then (1 : ℝ) else 0)| ≤ 1 := by
    intro n; split_ifs <;> norm_num
  have := h 2 1 0 2 1 le_rfl le_rfl (dvd_zero 1) le_rfl (by norm_num) _ hf
  have e2 : Finset.Icc 1 2 = ({1, 2} : Finset ℕ) := by decide
  have e1 : Finset.Icc 1 1 = ({1} : Finset ℕ) := by decide
  have hp : ∀ g : ℕ → ℝ, ∑ x ∈ ({1, 2} : Finset ℕ), g x = g 1 + g 2 :=
    fun g => Finset.sum_pair (by norm_num)
  simp only [normSq, logAvg, proj, uavg, wavg, e1, e2, hp, Finset.sum_singleton] at this
  norm_num at this

/- ### GS Lemma 6.5 and its corollary (6.4) -/

lemma proj_mono {q H : ℕ} (hH : 1 ≤ H) {u v : ℤ → ℝ} (huv : ∀ n, u n ≤ v n) (n : ℤ) :
    proj q H u n ≤ proj q H v n := by
  rw [proj_eq_sAvg, proj_eq_sAvg]
  exact sAvg_mono hH (fun m => sAvg_mono hH huv _ _) _ _

lemma proj_nonneg {q H : ℕ} (hH : 1 ≤ H) {u : ℤ → ℝ} (hu : ∀ n, 0 ≤ u n) (n : ℤ) :
    0 ≤ proj q H u n := by
  rw [proj_eq_sAvg]
  exact sAvg_nonneg hH (fun m => sAvg_nonneg hH hu _ _) _ _

/-- **GS Lemma 6.5**, with the smallness condition `3 · 2H_{qH}/log N ≤ (δ/4)²`:
if `0 ≤ f, g ≤ 1` and `E^log f g ≥ δ > 0` then `E^log (Π_{q,H} f) g ≥ δ²/8`. -/
theorem lemma65 (N q H : ℕ) (hN : 2 ≤ N) (hH : 1 ≤ H) (f g : ℤ → ℝ)
    (hf : ∀ n, 0 ≤ f n ∧ f n ≤ 1) (hg : ∀ n, 0 ≤ g n ∧ g n ≤ 1) (δ : ℝ) (hδ0 : 0 < δ)
    (hfg : δ ≤ logAvg N (fun n => f n * g n)) (herr : 3 * eA N (q * H) ≤ (δ / 4) ^ 2) :
    δ ^ 2 / 8 ≤ logAvg N (fun n => proj q H f n * g n) := by
  have hg1 := goodWeights_logAvg (show 1 ≤ N by omega)
  have hε0 : 0 < δ / 4 := by positivity
  obtain ⟨F, hFdef⟩ : ∃ F : ℤ → ℝ, F = fun n => if proj q H f n ≤ δ / 4 then f n else 0 :=
    ⟨_, rfl⟩
  have hFpos : ∀ n, proj q H f n ≤ δ / 4 → F n = f n := fun n hn => by rw [hFdef]; simp [hn]
  have hFneg : ∀ n, ¬ proj q H f n ≤ δ / 4 → F n = 0 := fun n hn => by rw [hFdef]; simp [hn]
  have hF0 : ∀ n, 0 ≤ F n := fun n => by
    by_cases hn : proj q H f n ≤ δ / 4
    · rw [hFpos n hn]; exact (hf n).1
    · rw [hFneg n hn]
  have hFf : ∀ n, F n ≤ f n := fun n => by
    by_cases hn : proj q H f n ≤ δ / 4
    · rw [hFpos n hn]
    · rw [hFneg n hn]; exact (hf n).1
  have hF1 : ∀ n, F n ≤ 1 := fun n => (hFf n).trans (hf n).2
  have hFabs : ∀ n, |F n| ≤ 1 := fun n => abs_le.mpr ⟨by linarith [hF0 n], hF1 n⟩
  -- `Π F · F ≤ ε F` pointwise
  have c1 : ∀ n, proj q H F n * F n ≤ δ / 4 * F n := by
    intro n
    by_cases hn : proj q H f n ≤ δ / 4
    · exact mul_le_mul_of_nonneg_right ((proj_mono hH hFf n).trans hn) (hF0 n)
    · rw [hFneg n hn]; simp
  have c1' : logAvg N (fun n => proj q H F n * F n) ≤ δ / 4 * logAvg N F :=
    calc logAvg N (fun n => proj q H F n * F n) ≤ logAvg N (fun n => δ / 4 * F n) :=
          wavg_mono hg1 fun n _ => c1 n
      _ = δ / 4 * logAvg N F := wavg_smul _ _
  -- `E(Π F · F) ≈ ‖P_{-q,H} F‖²`
  have hPabs : ∀ n, |sAvg (-(q : ℤ)) H F n| ≤ 1 := abs_sAvg_le hH hFabs _
  have A := adjoint N hN hH (sAvg (-(q : ℤ)) H F) F hPabs hFabs (q : ℤ) (q * H) (by simp)
  rw [← proj_eq_sAvg] at A
  -- Cauchy–Schwarz
  have J : (logAvg N (sAvg (-(q : ℤ)) H F)) ^ 2 ≤
      logAvg N (fun n => sAvg (-(q : ℤ)) H F n * sAvg (-(q : ℤ)) H F n) := by
    have := wavg_sq_le hg1 (fun n : ℕ => sAvg (-(q : ℤ)) H F n)
    refine this.trans (le_of_eq ?_)
    exact wavg_congr fun n _ => by ring
  -- `E P_{-q,H} F ≈ E F`
  have S := logAvg_sAvg_sub N hN hH F hFabs (-(q : ℤ)) (q * H) (by simp)
  have hEF0 : 0 ≤ logAvg N F := wavg_nonneg hg1 fun n _ => hF0 n
  have hEF1 : logAvg N F ≤ 1 := wavg_le_of_le hg1 fun n _ => hF1 n
  have hEP0 : 0 ≤ logAvg N (sAvg (-(q : ℤ)) H F) :=
    wavg_nonneg hg1 fun n _ => sAvg_nonneg hH hF0 _ _
  have hEP1 : logAvg N (sAvg (-(q : ℤ)) H F) ≤ 1 :=
    wavg_le_of_le hg1 fun n _ => sAvg_le_one hH hF1 _ _
  have hsq := sq_sub_sq_le (x := logAvg N F) (y := logAvg N (sAvg (-(q : ℤ)) H F))
    (d := eA N (q * H))
    (abs_le.mpr ⟨by linarith, hEF1⟩) (abs_le.mpr ⟨by linarith, hEP1⟩)
    (by rw [abs_sub_comm]; exact S)
  -- `(E F)² ≤ ε E F + ε²`, hence `E F ≤ 2ε`
  have key : (logAvg N F) ^ 2 ≤ δ / 4 * logAvg N F + (δ / 4) ^ 2 := by
    have hA := (abs_le.mp A).1
    linarith
  have hEF : logAvg N F ≤ 2 * (δ / 4) := by
    nlinarith [mul_pos hε0 hε0, key, hEF0]
  -- `Π f · g ≥ ε (f g - F)` pointwise
  have pt : ∀ n, δ / 4 * (f n * g n - F n) ≤ proj q H f n * g n := by
    intro n
    have hP0 : 0 ≤ proj q H f n := proj_nonneg hH (fun m => (hf m).1) n
    by_cases hn : proj q H f n ≤ δ / 4
    · rw [hFpos n hn]
      have h1 : f n * g n - f n ≤ 0 := by nlinarith [(hf n).1, (hg n).2]
      have h2 : δ / 4 * (f n * g n - f n) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hε0.le h1
      linarith [mul_nonneg hP0 (hg n).1]
    · rw [hFneg n hn, sub_zero]
      have hn' : δ / 4 < proj q H f n := not_le.mp hn
      have h1 : f n * g n ≤ g n := by nlinarith [(hf n).2, (hg n).1]
      nlinarith [mul_nonneg (sub_nonneg.mpr hn'.le) (hg n).1,
        mul_nonneg hε0.le (sub_nonneg.mpr h1)]
  have hmono : logAvg N (fun n => δ / 4 * (f n * g n - F n)) ≤
      logAvg N (fun n => proj q H f n * g n) := wavg_mono hg1 fun n _ => pt n
  have hlin : logAvg N (fun n => δ / 4 * (f n * g n - F n)) =
      δ / 4 * (logAvg N (fun n => f n * g n) - logAvg N F) := by
    unfold logAvg; rw [wavg_smul, wavg_sub]
  rw [hlin] at hmono
  have h5 := mul_le_mul_of_nonneg_left
    (show δ - 2 * (δ / 4) ≤ logAvg N (fun n => f n * g n) - logAvg N F by linarith) hε0.le
  have h6 : δ / 4 * (δ - 2 * (δ / 4)) = δ ^ 2 / 8 := by ring
  linarith

/-- **GS (6.4)**, the corollary of Lemma 6.5, with `c = 1/1000`. -/
theorem cor64With_c : Cor64With (1 / 1000) := by
  intro N q H hN hq hH η hη0 hη1 hlog f g hf hg
  have hg1 := goodWeights_logAvg (show 1 ≤ N by omega)
  have hD0 : 0 ≤ logAvg N (fun n => f n * g n) :=
    wavg_nonneg hg1 fun n _ => mul_nonneg (hf n).1 (hg n).1
  have hD1 : logAvg N (fun n => f n * g n) ≤ 1 :=
    wavg_le_of_le hg1 fun n _ => by nlinarith [hf n, hg n]
  have hP0 : 0 ≤ logAvg N (fun n => proj q H f n * g n) :=
    wavg_nonneg hg1 fun n _ => mul_nonneg (proj_nonneg hH (fun m => (hf m).1) n) (hg n).1
  rcases (show H = 1 ∨ 2 ≤ H by omega) with rfl | hH2
  · have e : ∀ n, proj q 1 f n = f n := fun n => by simp [proj, uavg, wavg]
    simp only [e]
    nlinarith [mul_nonneg hη0.le hD0, sq_nonneg η]
  · rcases le_or_gt (logAvg N (fun n => f n * g n)) η with hDη | hDη
    · nlinarith [mul_le_mul_of_nonneg_left hDη hη0.le]
    · have hlogN := log_pos_of_two_le hN
      have h2 : (2 : ℝ) ≤ (H : ℝ) * q := by
        have : (2 : ℝ) ≤ H := by exact_mod_cast hH2
        have : (1 : ℝ) ≤ q := by exact_mod_cast hq
        nlinarith
      have hL : (1 : ℝ) / 2 ≤ Real.log ((H : ℝ) * q) := by
        have : Real.log 2 ≤ Real.log ((H : ℝ) * q) := Real.log_le_log (by norm_num) h2
        linarith [Real.log_two_gt_d9]
      have herr : 3 * eA N (q * H) ≤ (logAvg N (fun n => f n * g n) / 4) ^ 2 := by
        have b := eA_le hN (q * H)
        push_cast at b
        rw [mul_comm (q : ℝ)] at b
        have b2 : 2 * (1 + Real.log ((H : ℝ) * q)) / Real.log N ≤
            6 * (Real.log ((H : ℝ) * q) / Real.log N) := by
          rw [mul_div_assoc']
          apply div_le_div_of_nonneg_right _ hlogN.le
          linarith
        have hηD : η ^ 2 ≤ (logAvg N (fun n => f n * g n)) ^ 2 := by nlinarith
        nlinarith
      have := lemma65 N q H hN hH f g hf hg _ (by linarith) le_rfl herr
      nlinarith [mul_nonneg hD0 (sub_pos.mpr hDη).le]

/-- **GS (6.4)**. -/
theorem cor64 : Cor64 := ⟨1 / 1000, by norm_num, cor64With_c⟩

end G22.Elem

end

/- ## Section: `MertensLower` -/

section

/-
# Mertens' theorems: an elementary proof (Mathlib only)

We prove Mertens' second theorem in the form `MertensLower` used by the Green–Sawhney argument,
and the upper bound `∑_{p ≤ Y} 1/p ≤ log log Y + cUp` used in `Lemma41Aux.lean`, with explicit
constants and using only Mathlib. Notation (sums over primes):
`S n = ∑_{p ≤ n} 1/p` and `T n = ∑_{p ≤ n} log p / p`.

* **Mertens' first theorem** (`T_le`, `T_ge`): for `n ≥ 1`,
  `log n - 3 ≤ T n ≤ log n + 2 log 2`.
  Legendre: `log n! = ∑_{p ≤ n} v_p(n!) log p` (`log_factorial_eq`) with `⌊n/p⌋ ≤ v_p(n!)` and
  `(p - 1) v_p(n!) ≤ n`; Chebyshev: `∏_{p ≤ n} p ≤ 4^n`; `n log n - n ≤ log n! ≤ n log n`; and
  `∑_{2 ≤ m ≤ n} log m / (m (m - 1)) ≤ 2` (telescoping with `(log m + 2)/m`).
* **Mertens' second theorem** (`S_le`, `S_ge`): for `n ≥ 2`,
  `log log n - cLow ≤ S n ≤ log log n + cUp`, with `cUp = 3 - log log 2 ≈ 3.37` and
  `cLow = log log 2 - 1 + 4/log 2 ≈ 4.40`.
  Partial summation with the weight `1/log`: `S (n+1) - T (n+1)/log (n+1) = S n - T n/log (n+1)`
  (`S_sub_T_div_succ`), together with `1 - a/b ≤ log b - log a ≤ b/a - 1` for
  `a = log n ≤ b = log (n+1)` (`step_upper`, `step_lower`).
* `mertensLowerWith`: for `3 ≤ A ≤ B`, `∑_{A ≤ p < B} 1/p ≥ log log B - log log A - C` with
  `C = log 2 + 2 (K₀ / log 2) = log 2 + cLow + cUp`, where `K₀ = log 2 + 2`;
  `sum_inv_primesLE_le'`: `∑_{p ≤ Y} 1/p ≤ log log Y + cUp` for `Y ≥ 2`.
-/

open Finset Real

namespace G22.MertensProof

/- ### The prime sums `S` and `T` -/

/-- `S(n) = ∑_{p ≤ n} 1/p`. -/
noncomputable def S (n : ℕ) : ℝ := ∑ p ∈ Ioc 0 n with p.Prime, (1 : ℝ) / p

/-- `T(n) = ∑_{p ≤ n} log p / p`. -/
noncomputable def T (n : ℕ) : ℝ := ∑ p ∈ Ioc 0 n with p.Prime, Real.log p / p

lemma sum_primes_succ (f : ℕ → ℝ) (n : ℕ) :
    ∑ p ∈ Ioc 0 (n + 1) with p.Prime, f p =
      ∑ p ∈ Ioc 0 n with p.Prime, f p + (if (n + 1).Prime then f (n + 1) else 0) := by
  rw [Finset.sum_filter, Finset.sum_filter, Finset.sum_Ioc_succ_top (Nat.zero_le n)]

lemma sum_primes_one (f : ℕ → ℝ) : ∑ p ∈ Ioc 0 1 with p.Prime, f p = 0 := by
  apply Finset.sum_eq_zero
  intro p hp
  rw [Finset.mem_filter, Finset.mem_Ioc] at hp
  obtain ⟨⟨h0, h1⟩, hpp⟩ := hp
  have hp1 : p = 1 := by omega
  rw [hp1] at hpp
  exact absurd hpp Nat.not_prime_one

lemma S_one : S 1 = 0 := by
  unfold S
  exact sum_primes_one _

lemma T_one : T 1 = 0 := by
  unfold T
  exact sum_primes_one _

lemma S_succ (n : ℕ) :
    S (n + 1) = S n + (if (n + 1).Prime then (1 : ℝ) / ((n + 1 : ℕ) : ℝ) else 0) := by
  unfold S
  exact sum_primes_succ (fun p => (1 : ℝ) / p) n

lemma T_succ (n : ℕ) :
    T (n + 1) = T n +
      (if (n + 1).Prime then Real.log ((n + 1 : ℕ) : ℝ) / ((n + 1 : ℕ) : ℝ) else 0) := by
  unfold T
  exact sum_primes_succ (fun p => Real.log p / p) n

/- ### Legendre's formula and `log n!` -/

/-- `log n! = ∑_{p ≤ n} v_p(n!) log p`. -/
lemma log_factorial_eq (n : ℕ) :
    Real.log (n.factorial : ℝ) =
      ∑ p ∈ Ioc 0 n with p.Prime, (n.factorial.factorization p : ℝ) * Real.log p := by
  rw [Real.log_nat_eq_sum_factorization]
  refine Finsupp.sum_of_support_subset _ ?_ _ ?_
  · intro p hp
    rw [Nat.support_factorization, Nat.mem_primeFactors] at hp
    rw [Finset.mem_filter, Finset.mem_Ioc]
    exact ⟨⟨hp.1.pos, (Nat.Prime.dvd_factorial hp.1).mp hp.2.1⟩, hp.1⟩
  · intro p _
    simp

/-- `⌊n/p⌋ ≤ v_p(n!)` (first term of Legendre's formula). -/
lemma div_le_factorization_factorial (n p : ℕ) (hp : p.Prime) :
    n / p ≤ n.factorial.factorization p := by
  rw [Nat.factorization_factorial hp (show Nat.log p n < Nat.log p n + 2 by omega)]
  have h1 : (1 : ℕ) ∈ Ico 1 (Nat.log p n + 2) := by
    rw [Finset.mem_Ico]
    omega
  calc n / p = n / p ^ 1 := by rw [pow_one]
    _ ≤ ∑ i ∈ Ico 1 (Nat.log p n + 2), n / p ^ i :=
        Finset.single_le_sum (f := fun i => n / p ^ i) (fun i _ => Nat.zero_le _) h1

/-- `(p - 1) v_p(n!) ≤ n`. -/
lemma sub_one_mul_factorization_factorial_le (n p : ℕ) (hp : p.Prime) :
    ((p : ℝ) - 1) * (n.factorial.factorization p : ℝ) ≤ n := by
  have h2 : (p - 1) * n.factorial.factorization p ≤ n := by
    rw [Nat.sub_one_mul_factorization_factorial hp]
    exact Nat.sub_le _ _
  have h3 : (((p - 1) * n.factorial.factorization p : ℕ) : ℝ) ≤ (n : ℝ) := by
    exact_mod_cast h2
  rw [Nat.cast_mul, Nat.cast_sub hp.one_le, Nat.cast_one] at h3
  exact h3

/-- `n/p - 1 ≤ ⌊n/p⌋`. -/
lemma sub_one_le_natCast_div (n p : ℕ) (hp : 0 < p) :
    (n : ℝ) / p - 1 ≤ ((n / p : ℕ) : ℝ) := by
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp
  have h1 : (p : ℝ) * ((n / p : ℕ) : ℝ) + ((n % p : ℕ) : ℝ) = n := by
    exact_mod_cast Nat.div_add_mod n p
  have h2 : ((n % p : ℕ) : ℝ) < p := by exact_mod_cast Nat.mod_lt n hp
  have h3 : (n : ℝ) / p ≤ ((n / p : ℕ) : ℝ) + 1 := by
    rw [div_le_iff₀ hpR]
    linarith
  linarith

/-- `n log n - n ≤ log n!` (from `nⁿ/n! ≤ eⁿ`). -/
lemma log_factorial_ge (n : ℕ) : n * Real.log n - n ≤ Real.log (n.factorial : ℝ) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hpos : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
  have h := Real.pow_div_factorial_le_exp (x := (n : ℝ)) hnR.le n
  have h2 : Real.log ((n : ℝ) ^ n / (n.factorial : ℝ)) ≤ n := by
    calc Real.log ((n : ℝ) ^ n / (n.factorial : ℝ)) ≤ Real.log (Real.exp n) :=
          Real.log_le_log (by positivity) h
      _ = n := Real.log_exp n
  rw [Real.log_div (by positivity) hpos.ne', Real.log_pow] at h2
  linarith

/-- `log n! ≤ n log n` (from `n! ≤ nⁿ`). -/
lemma log_factorial_le (n : ℕ) : Real.log (n.factorial : ℝ) ≤ n * Real.log n := by
  have hpos : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
  have h : (n.factorial : ℝ) ≤ (n : ℝ) ^ n := by exact_mod_cast Nat.factorial_le_pow n
  calc Real.log (n.factorial : ℝ) ≤ Real.log ((n : ℝ) ^ n) := Real.log_le_log hpos h
    _ = n * Real.log n := by rw [Real.log_pow]

/-- **Chebyshev**: `∑_{p ≤ n} log p ≤ n log 4` (from `∏_{p ≤ n} p ≤ 4^n`). -/
lemma sum_log_primes_le (n : ℕ) :
    ∑ p ∈ Ioc 0 n with p.Prime, Real.log p ≤ n * Real.log 4 := by
  have h5 : (0 : ℝ) < (primorial n : ℝ) := by exact_mod_cast primorial_pos n
  have h4 : (primorial n : ℝ) ≤ (4 : ℝ) ^ n := by exact_mod_cast primorial_le_four_pow n
  have h3 : Real.log (primorial n : ℝ) ≤ n * Real.log 4 := by
    calc Real.log (primorial n : ℝ) ≤ Real.log ((4 : ℝ) ^ n) := Real.log_le_log h5 h4
      _ = n * Real.log 4 := by rw [Real.log_pow]
  have h1 : ∑ p ∈ Ioc 0 n with p.Prime, Real.log p ≤ Real.log (primorial n : ℝ) := by
    unfold primorial
    rw [Nat.cast_prod, Real.log_prod]
    · apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro p hp
        rw [Finset.mem_filter, Finset.mem_Ioc] at hp
        obtain ⟨⟨_, hpn⟩, hpp⟩ := hp
        rw [Finset.mem_filter, Finset.mem_range]
        exact ⟨by omega, hpp⟩
      · intro p _ _
        exact Real.log_natCast_nonneg p
    · intro p hp
      rw [Finset.mem_filter] at hp
      exact_mod_cast hp.2.ne_zero
  linarith

/- ### Mertens' first theorem -/

lemma log_four : Real.log 4 = 2 * Real.log 2 := by
  have h : (4 : ℝ) = 2 ^ 2 := by norm_num
  rw [h, Real.log_pow]
  norm_num

/-- **Mertens' first theorem**, upper bound: `T n ≤ log n + 2 log 2` for `n ≥ 1`. -/
theorem T_le (n : ℕ) (hn : 1 ≤ n) : T n ≤ Real.log n + 2 * Real.log 2 := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hθ := sum_log_primes_le n
  rw [log_four] at hθ
  have h1 : ∑ p ∈ Ioc 0 n with p.Prime, ((n : ℝ) / p - 1) * Real.log p ≤
      Real.log (n.factorial : ℝ) := by
    rw [log_factorial_eq]
    apply Finset.sum_le_sum
    intro p hp
    have hpp : p.Prime := (Finset.mem_filter.mp hp).2
    refine mul_le_mul_of_nonneg_right ?_ (Real.log_natCast_nonneg p)
    calc (n : ℝ) / p - 1 ≤ ((n / p : ℕ) : ℝ) := sub_one_le_natCast_div n p hpp.pos
      _ ≤ (n.factorial.factorization p : ℝ) := by
          exact_mod_cast div_le_factorization_factorial n p hpp
  have h2 : ∑ p ∈ Ioc 0 n with p.Prime, ((n : ℝ) / p - 1) * Real.log p =
      n * T n - ∑ p ∈ Ioc 0 n with p.Prime, Real.log p := by
    unfold T
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro p _
    ring
  have h3 := log_factorial_le n
  have h4 : (n : ℝ) * T n ≤ n * (Real.log n + 2 * Real.log 2) := by linarith
  exact le_of_mul_le_mul_left h4 hnR

/-- `x (log (x+1) - log x) ≤ 1` for `x > 0`. -/
lemma mul_log_succ_sub_log_le (x : ℝ) (hx : 0 < x) :
    x * (Real.log (x + 1) - Real.log x) ≤ 1 := by
  have hx1 : 0 < x + 1 := by linarith
  have h1 : Real.log ((x + 1) / x) ≤ (x + 1) / x - 1 :=
    Real.log_le_sub_one_of_pos (div_pos hx1 hx)
  rw [Real.log_div hx1.ne' hx.ne'] at h1
  have h2 : x * ((x + 1) / x) = x + 1 := mul_div_cancel₀ (x + 1) hx.ne'
  have h3 := mul_le_mul_of_nonneg_left h1 hx.le
  linarith

/-- Telescoping: `∑_{1 < m ≤ n} log m / (m (m - 1)) ≤ 2 - (log n + 2)/n` for `n ≥ 1`. -/
lemma sum_log_div_le_aux (n : ℕ) (hn : 1 ≤ n) :
    ∑ m ∈ Ioc 1 n, Real.log m / ((m : ℝ) * ((m : ℝ) - 1)) ≤ 2 - (Real.log n + 2) / n := by
  induction n, hn using Nat.le_induction with
  | base => simp
  | succ k hk ih =>
    rw [Finset.sum_Ioc_succ_top hk]
    have hx : (1 : ℝ) ≤ k := by exact_mod_cast hk
    have hx0 : (0 : ℝ) < k := by linarith
    have hk0 : (k : ℝ) ≠ 0 := hx0.ne'
    have hk1 : (k : ℝ) + 1 ≠ 0 := by
      have : (0 : ℝ) < (k : ℝ) + 1 := by linarith
      exact this.ne'
    have hc : ((k + 1 : ℕ) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
    have h1 := mul_log_succ_sub_log_le (k : ℝ) hx0
    have hd : 0 ≤ Real.log ((k : ℝ) + 1) - Real.log k :=
      sub_nonneg.mpr (Real.log_le_log hx0 (by linarith))
    have h2 : Real.log ((k : ℝ) + 1) - Real.log k ≤ 1 := by
      have := mul_le_mul_of_nonneg_right hx hd
      linarith
    have key : Real.log ((k : ℝ) + 1) / (((k : ℝ) + 1) * k) ≤
        (Real.log k + 2) / k - (Real.log ((k : ℝ) + 1) + 2) / ((k : ℝ) + 1) := by
      have e : (Real.log k + 2) / k - (Real.log ((k : ℝ) + 1) + 2) / ((k : ℝ) + 1) -
          Real.log ((k : ℝ) + 1) / (((k : ℝ) + 1) * k) =
          (2 - ((k : ℝ) + 1) * (Real.log ((k : ℝ) + 1) - Real.log k)) /
            (((k : ℝ) + 1) * k) := by
        field_simp
        ring
      have hnum : 0 ≤ 2 - ((k : ℝ) + 1) * (Real.log ((k : ℝ) + 1) - Real.log k) := by
        linarith
      have hden : 0 < ((k : ℝ) + 1) * k := by positivity
      have := div_nonneg hnum hden.le
      linarith
    rw [hc, show (k : ℝ) + 1 - 1 = k by ring]
    linarith

/-- `∑_{p ≤ n} log p / (p (p - 1)) ≤ 2`. -/
lemma sum_primes_log_div_le (n : ℕ) :
    ∑ p ∈ Ioc 0 n with p.Prime, Real.log p / ((p : ℝ) * ((p : ℝ) - 1)) ≤ 2 := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  have hsub : ∑ p ∈ Ioc 0 n with p.Prime, Real.log p / ((p : ℝ) * ((p : ℝ) - 1)) ≤
      ∑ m ∈ Ioc 1 n, Real.log m / ((m : ℝ) * ((m : ℝ) - 1)) := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro p hp
      rw [Finset.mem_filter, Finset.mem_Ioc] at hp
      rw [Finset.mem_Ioc]
      exact ⟨hp.2.one_lt, hp.1.2⟩
    · intro m hm _
      rw [Finset.mem_Ioc] at hm
      obtain ⟨hm1, _⟩ := hm
      have hm2 : (2 : ℝ) ≤ m := by
        have : 2 ≤ m := by omega
        exact_mod_cast this
      apply div_nonneg (Real.log_natCast_nonneg m)
      apply mul_nonneg <;> linarith
  have h := sum_log_div_le_aux n hn
  have h' : 0 ≤ (Real.log n + 2) / n := by
    apply div_nonneg _ (Nat.cast_nonneg n)
    linarith [Real.log_natCast_nonneg n]
  linarith

/-- **Mertens' first theorem**, lower bound: `log n - 3 ≤ T n` for `n ≥ 1`. -/
theorem T_ge (n : ℕ) (hn : 1 ≤ n) : Real.log n - 3 ≤ T n := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have h1 : Real.log (n.factorial : ℝ) ≤
      ∑ p ∈ Ioc 0 n with p.Prime,
        ((n : ℝ) * (Real.log p / p) + n * (Real.log p / ((p : ℝ) * ((p : ℝ) - 1)))) := by
    rw [log_factorial_eq]
    apply Finset.sum_le_sum
    intro p hp
    have hpp : p.Prime := (Finset.mem_filter.mp hp).2
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hpp.two_le
    have hp0 : (p : ℝ) ≠ 0 := by
      have : (0 : ℝ) < p := by linarith
      exact this.ne'
    have hp1 : (p : ℝ) - 1 ≠ 0 := by
      have : (0 : ℝ) < (p : ℝ) - 1 := by linarith
      exact this.ne'
    have hv := sub_one_mul_factorization_factorial_le n p hpp
    have hlog : 0 ≤ Real.log p := Real.log_natCast_nonneg p
    have hv' : (n.factorial.factorization p : ℝ) ≤ n / ((p : ℝ) - 1) := by
      rw [le_div_iff₀ (by linarith)]
      linarith
    have e : (n : ℝ) * (Real.log p / p) + n * (Real.log p / ((p : ℝ) * ((p : ℝ) - 1))) =
        n / ((p : ℝ) - 1) * Real.log p := by
      field_simp
      ring
    rw [e]
    exact mul_le_mul_of_nonneg_right hv' hlog
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at h1
  have hT : ∑ p ∈ Ioc 0 n with p.Prime, Real.log p / p = T n := rfl
  rw [hT] at h1
  have h2 := sum_primes_log_div_le n
  have h3 := log_factorial_ge n
  have h4 : (n : ℝ) * ∑ p ∈ Ioc 0 n with p.Prime, Real.log p / ((p : ℝ) * ((p : ℝ) - 1)) ≤
      n * 2 := mul_le_mul_of_nonneg_left h2 hnR.le
  have h5 : (n : ℝ) * (Real.log n - 3) ≤ n * T n := by linarith
  exact le_of_mul_le_mul_left h5 hnR

/- ### Partial summation: Mertens' second theorem -/

/-- The partial-summation identity `S (n+1) - T (n+1)/log (n+1) = S n - T n/log (n+1)`. -/
lemma S_sub_T_div_succ (n : ℕ) (hn : 1 ≤ n) :
    S (n + 1) - T (n + 1) / Real.log ((n + 1 : ℕ) : ℝ) =
      S n - T n / Real.log ((n + 1 : ℕ) : ℝ) := by
  have h1 : (1 : ℝ) < ((n + 1 : ℕ) : ℝ) := by
    have h : 1 < n + 1 := by omega
    exact_mod_cast h
  have hlog : Real.log ((n + 1 : ℕ) : ℝ) ≠ 0 := (Real.log_pos h1).ne'
  rw [S_succ, T_succ]
  split_ifs with hp
  · rw [add_div, div_right_comm, div_self hlog]
    ring
  · rw [add_zero, add_zero]

lemma S_two_sub : S 2 - T 2 / Real.log ((2 : ℕ) : ℝ) = 0 := by
  have h := S_sub_T_div_succ 1 le_rfl
  rw [S_one, T_one, zero_div, sub_zero] at h
  exact h

/-- One step of the partial summation, upper bound (`a = log n`, `b = log (n+1)`, `t = T n`). -/
lemma step_upper {a b t K : ℝ} (ha : 0 < a) (hab : a ≤ b) (hT : t ≤ a + K) :
    t / a - t / b ≤ (Real.log b - Real.log a) + K * (1 / a - 1 / b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hw : 0 ≤ 1 / a - 1 / b := sub_nonneg.mpr (one_div_le_one_div_of_le ha hab)
  have h1 : t * (1 / a - 1 / b) ≤ (a + K) * (1 / a - 1 / b) :=
    mul_le_mul_of_nonneg_right hT hw
  have h2 : Real.log a - Real.log b ≤ a / b - 1 := by
    have h := Real.log_le_sub_one_of_pos (div_pos ha hb)
    rwa [Real.log_div ha.ne' hb.ne'] at h
  have e1 : t / a = t * (1 / a) := div_eq_mul_one_div t a
  have e2 : t / b = t * (1 / b) := div_eq_mul_one_div t b
  have e3 : a / b = a * (1 / b) := div_eq_mul_one_div a b
  have e4 : a * (1 / a) = 1 := mul_one_div_cancel ha.ne'
  linarith

/-- One step of the partial summation, lower bound (`a = log n`, `b = log (n+1)`, `t = T n`). -/
lemma step_lower {a b t K : ℝ} (ha : 0 < a) (hab : a ≤ b) (hba : b - a ≤ 1)
    (hT : a - K ≤ t) :
    (Real.log b - Real.log a) - (K + 1) * (1 / a - 1 / b) ≤ t / a - t / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hw : 0 ≤ 1 / a - 1 / b := sub_nonneg.mpr (one_div_le_one_div_of_le ha hab)
  have h1 : (a - K) * (1 / a - 1 / b) ≤ t * (1 / a - 1 / b) :=
    mul_le_mul_of_nonneg_right hT hw
  have h2 : Real.log b - Real.log a ≤ b / a - 1 := by
    have h := Real.log_le_sub_one_of_pos (div_pos hb ha)
    rwa [Real.log_div hb.ne' ha.ne'] at h
  have h3 : (b - a) * (1 / a - 1 / b) ≤ 1 * (1 / a - 1 / b) :=
    mul_le_mul_of_nonneg_right hba hw
  have e1 : t / a = t * (1 / a) := div_eq_mul_one_div t a
  have e2 : t / b = t * (1 / b) := div_eq_mul_one_div t b
  have e3 : b / a = b * (1 / a) := div_eq_mul_one_div b a
  have e4 : a * (1 / a) = 1 := mul_one_div_cancel ha.ne'
  have e5 : b * (1 / b) = 1 := mul_one_div_cancel hb.ne'
  linarith

/-- Partial summation, upper bound: for `n ≥ 2`,
`S n - T n/log n ≤ log log n - log log 2 + 2 log 2 (1/log 2 - 1/log n)`. -/
lemma G_le (n : ℕ) (hn : 2 ≤ n) :
    S n - T n / Real.log n ≤ Real.log (Real.log n) - Real.log (Real.log 2) +
      2 * Real.log 2 * (1 / Real.log 2 - 1 / Real.log n) := by
  induction n, hn using Nat.le_induction with
  | base =>
    rw [S_two_sub]
    simp
  | succ k hk ih =>
    have hk1 : 1 ≤ k := by omega
    have hid := S_sub_T_div_succ k hk1
    have hkR : (2 : ℝ) ≤ k := by exact_mod_cast hk
    have ha : 0 < Real.log (k : ℝ) := Real.log_pos (by linarith)
    have hab : Real.log (k : ℝ) ≤ Real.log ((k + 1 : ℕ) : ℝ) :=
      Real.log_le_log (by linarith) (by push_cast; linarith)
    have hstep := step_upper ha hab (T_le k hk1)
    linarith

/-- Partial summation, lower bound: for `n ≥ 2`,
`log log n - log log 2 - 4 (1/log 2 - 1/log n) ≤ S n - T n/log n`. -/
lemma G_ge (n : ℕ) (hn : 2 ≤ n) :
    Real.log (Real.log n) - Real.log (Real.log 2) - 4 * (1 / Real.log 2 - 1 / Real.log n) ≤
      S n - T n / Real.log n := by
  induction n, hn using Nat.le_induction with
  | base =>
    rw [S_two_sub]
    simp
  | succ k hk ih =>
    have hk1 : 1 ≤ k := by omega
    have hid := S_sub_T_div_succ k hk1
    have hkR : (2 : ℝ) ≤ k := by exact_mod_cast hk
    have hk0 : (0 : ℝ) < k := by linarith
    have hc : ((k + 1 : ℕ) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
    have ha : 0 < Real.log (k : ℝ) := Real.log_pos (by linarith)
    have hab : Real.log (k : ℝ) ≤ Real.log ((k + 1 : ℕ) : ℝ) :=
      Real.log_le_log hk0 (by rw [hc]; linarith)
    have hba : Real.log ((k + 1 : ℕ) : ℝ) - Real.log (k : ℝ) ≤ 1 := by
      have h := mul_log_succ_sub_log_le (k : ℝ) hk0
      rw [hc] at hab ⊢
      have hd : 0 ≤ Real.log ((k : ℝ) + 1) - Real.log k := sub_nonneg.mpr hab
      have := mul_le_mul_of_nonneg_right (show (1 : ℝ) ≤ k by linarith) hd
      linarith
    have hstep := step_lower ha hab hba (T_ge k hk1)
    linarith

/-- The constant of the upper bound `∑_{p ≤ n} 1/p ≤ log log n + cUp` (`≈ 3.37`). -/
noncomputable def cUp : ℝ := 3 - Real.log (Real.log 2)

/-- The constant of the lower bound `log log n - cLow ≤ ∑_{p ≤ n} 1/p` (`≈ 4.40`). -/
noncomputable def cLow : ℝ := Real.log (Real.log 2) - 1 + 4 / Real.log 2

/-- **Mertens' second theorem**, upper bound: `S n ≤ log log n + cUp` for `n ≥ 2`. -/
theorem S_le (n : ℕ) (hn : 2 ≤ n) : S n ≤ Real.log (Real.log n) + cUp := by
  have hG := G_le n hn
  have hT := T_le n (by omega)
  have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hL : 0 < Real.log (n : ℝ) := Real.log_pos (by linarith)
  have hL2 : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have h1 : T n * (1 / Real.log n) ≤ (Real.log n + 2 * Real.log 2) * (1 / Real.log n) :=
    mul_le_mul_of_nonneg_right hT (one_div_pos.mpr hL).le
  have e1 : T n / Real.log n = T n * (1 / Real.log n) := div_eq_mul_one_div _ _
  have e2 : Real.log n * (1 / Real.log n) = 1 := mul_one_div_cancel hL.ne'
  have e3 : Real.log 2 * (1 / Real.log 2) = 1 := mul_one_div_cancel hL2.ne'
  unfold cUp
  linarith

/-- **Mertens' second theorem**, lower bound: `log log n - cLow ≤ S n` for `n ≥ 2`. -/
theorem S_ge (n : ℕ) (hn : 2 ≤ n) : Real.log (Real.log n) - cLow ≤ S n := by
  have hG := G_ge n hn
  have hT := T_ge n (by omega)
  have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hL : 0 < Real.log (n : ℝ) := Real.log_pos (by linarith)
  have h1 : (Real.log n - 3) * (1 / Real.log n) ≤ T n * (1 / Real.log n) :=
    mul_le_mul_of_nonneg_right hT (one_div_pos.mpr hL).le
  have e1 : T n / Real.log n = T n * (1 / Real.log n) := div_eq_mul_one_div _ _
  have e2 : Real.log n * (1 / Real.log n) = 1 := mul_one_div_cancel hL.ne'
  have e3 : 4 / Real.log 2 = 4 * (1 / Real.log 2) := div_eq_mul_one_div _ _
  have h2 : 0 ≤ 1 / Real.log (n : ℝ) := (one_div_pos.mpr hL).le
  unfold cLow
  linarith

/-- **Mertens' second theorem**, upper bound, in the form used in `Lemma41Aux.lean`:
`∑_{p ≤ Y} 1/p ≤ log log Y + cUp` for `Y ≥ 2`. -/
theorem sum_inv_primesLE_le' (Y : ℕ) (hY : 2 ≤ Y) :
    ∑ p ∈ Ioc 0 Y with p.Prime, (1 : ℝ) / p ≤ Real.log (Real.log Y) + cUp :=
  S_le Y hY

/- ### The form `MertensLower` -/

/-- The constant `K₀`, chosen so that `log 2 + 2 (K₀ / log 2) = log 2 + cLow + cUp`
(`two_mul_K₀_div`). -/
noncomputable def K₀ : ℝ := Real.log 2 + 2

lemma K₀_nonneg : 0 ≤ K₀ := by
  unfold K₀
  have := Real.log_nonneg (show (1 : ℝ) ≤ 2 by norm_num)
  linarith

lemma two_mul_K₀_div : 2 * (K₀ / Real.log 2) = cLow + cUp := by
  have hL2 : Real.log 2 ≠ 0 := (Real.log_pos (by norm_num : (1 : ℝ) < 2)).ne'
  unfold K₀ cLow cUp
  rw [add_div, div_self hL2]
  ring

/-- The primes in `[A, B)` are those in `(0, B-1]` minus those in `(0, A-1]`. -/
lemma sum_primesIn_eq (A B : ℕ) (hA : 1 ≤ A) (hAB : A ≤ B) :
    ∑ p ∈ primesIn A B, (1 : ℝ) / p = S (B - 1) - S (A - 1) := by
  unfold S primesIn
  rw [eq_sub_iff_add_eq]
  rw [← Finset.sum_union]
  · congr 1
    ext p
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_Ico, Finset.mem_Ioc]
    constructor
    · rintro (⟨⟨h1, h2⟩, hp⟩ | ⟨⟨h1, h2⟩, hp⟩) <;> exact ⟨⟨by omega, by omega⟩, hp⟩
    · rintro ⟨⟨h1, h2⟩, hp⟩
      by_cases h : A ≤ p
      · exact Or.inl ⟨⟨h, by omega⟩, hp⟩
      · exact Or.inr ⟨⟨h1, by omega⟩, hp⟩
  · rw [Finset.disjoint_left]
    intro p h1 h2
    simp only [Finset.mem_filter, Finset.mem_Ico, Finset.mem_Ioc] at h1 h2
    omega

/-- `log log B ≤ log log (B - 1) + log 2` for `B ≥ 3` (since `B ≤ (B-1)²`). -/
lemma loglog_le_loglog_pred (B : ℕ) (hB : 3 ≤ B) :
    Real.log (Real.log B) ≤ Real.log (Real.log ((B - 1 : ℕ) : ℝ)) + Real.log 2 := by
  have hB1 : (2 : ℝ) ≤ ((B - 1 : ℕ) : ℝ) := by
    have : 2 ≤ B - 1 := by omega
    exact_mod_cast this
  have hBpos : (0 : ℝ) < B := by positivity
  have hlogB1 : 0 < Real.log ((B - 1 : ℕ) : ℝ) := Real.log_pos (by linarith)
  -- `log B ≤ 2 log (B-1)`
  have hsq : (B : ℝ) ≤ ((B - 1 : ℕ) : ℝ) ^ 2 := by
    have h : B ≤ (B - 1) ^ 2 := by
      have : B - 1 ≥ 2 := by omega
      nlinarith [Nat.sub_add_cancel (show 1 ≤ B by omega)]
    exact_mod_cast h
  have hlog : Real.log B ≤ 2 * Real.log ((B - 1 : ℕ) : ℝ) := by
    rw [← Real.log_rpow (by linarith) 2]
    apply Real.log_le_log hBpos
    rw [show ((B - 1 : ℕ) : ℝ) ^ (2 : ℝ) = ((B - 1 : ℕ) : ℝ) ^ 2 from by norm_cast]
    exact hsq
  have hlogBpos : 0 < Real.log B := Real.log_pos (by exact_mod_cast (by omega : 1 < B))
  calc Real.log (Real.log B) ≤ Real.log (2 * Real.log ((B - 1 : ℕ) : ℝ)) :=
        Real.log_le_log hlogBpos hlog
    _ = Real.log 2 + Real.log (Real.log ((B - 1 : ℕ) : ℝ)) :=
        Real.log_mul (by norm_num) hlogB1.ne'
    _ = _ := by ring

/-- `log log (A - 1) ≤ log log A` for `A ≥ 3`. -/
lemma loglog_pred_le (A : ℕ) (hA : 3 ≤ A) :
    Real.log (Real.log ((A - 1 : ℕ) : ℝ)) ≤ Real.log (Real.log A) := by
  have hA1 : (2 : ℝ) ≤ ((A - 1 : ℕ) : ℝ) := by
    have : 2 ≤ A - 1 := by omega
    exact_mod_cast this
  have hle : ((A - 1 : ℕ) : ℝ) ≤ A := by exact_mod_cast Nat.sub_le A 1
  have h1 : 0 < Real.log ((A - 1 : ℕ) : ℝ) := Real.log_pos (by linarith)
  exact Real.log_le_log h1 (Real.log_le_log (by linarith) hle)

/-- **Mertens' second theorem**, lower-bound form, with an explicit constant:
for `3 ≤ A ≤ B`, `log log B - log log A - (log 2 + 2 (K₀ / log 2)) ≤ ∑_{A ≤ p < B} 1/p`. -/
theorem mertensLowerWith :
    MertensLowerWith (Real.log 2 + 2 * (K₀ / Real.log 2)) := by
  intro A B hA hAB
  rw [sum_primesIn_eq A B (by omega) hAB, two_mul_K₀_div]
  have hB1 : 2 ≤ B - 1 := by omega
  have hA1 : 2 ≤ A - 1 := by omega
  have e1 := S_ge (B - 1) hB1
  have e2 := S_le (A - 1) hA1
  have l1 := loglog_le_loglog_pred B (by omega)
  have l2 := loglog_pred_le A hA
  linarith

theorem mertensLower : MertensLower := by
  refine ⟨Real.log 2 + 2 * (K₀ / Real.log 2), ?_, mertensLowerWith⟩
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have := K₀_nonneg
  positivity

end G22.MertensProof

end

/- ## Section: `Elliott` -/

section

/-
# GS Lemma A.5 (logarithmic Elliott inequality)

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, Appendix A.

Main result: `G22.Elliott.lemmaA5 : LemmaA5`, with the constant `C = 4`
(`lemmaA5With_four : LemmaA5With 4`).

Write `L = H_N = ∑_{n ≤ N} 1/n`, `W = ∑_{p ∈ S} 1/p`, `w(n) = 1/n`.

* **Trivial range.** If `P² > N` then `log P / log N > 1/2`, and the left-hand side is at most `2`.
* **Dilation (GS Lemma A.4).** `E^log_{n≤N} f(pn) = E^log_{m≤N} p 1_{p∣m} f(m) + O((1 + log p)/log N)`:
  the two numerators differ by `∑_{N/p < n ≤ N} f(pn)/n`, of size at most
  `H_N - H_{⌊N/p⌋} ≤ 1 + log p` (`dilation`).
* **Main term.** Averaging over `p ∈ S`,
  `E^log_n f(n) - E^log_{p∈S} E^log_m p 1_{p∣m} f(m) = E^log_n f(n) Y(n)` with
  `Y(n) = E^log_{p∈S}(1 - p 1_{p∣n})` (`main_identity`), so by Cauchy–Schwarz it is at most
  `(E^log_n Y(n)²)^{1/2}`.
* **Variance (Turán–Kubilius, log-averaged).** `W² L · E^log_n Y² = ∑_{p,p'∈S} c(p,p')` with
  `c(p,p') = ∑_{n≤N} (1/n)(1/p - 1_{p∣n})(1/p' - 1_{p'∣n})`. Using
  `∑_{n≤N, d∣n} 1/n = H_{⌊N/d⌋}/d` and `log(N/d) ≤ H_{⌊N/d⌋} ≤ 1 + log(N/d)` (for `d ≤ N`):
  `c(p,p) ≤ 2L/p` and, for `p ≠ p'` with `pp' ≤ P² ≤ N`, `c(p,p') ≤ 2/(pp')` (`cov_le`).
  Hence `E^log_n Y² ≤ 2/W + 2/L ≤ 4/W`, since `W ≤ H_P ≤ H_N = L` (`variance_le`).

No asymptotic for the harmonic numbers (Euler–Mascheroni) is needed: the crude bounds
`log(n+1) ≤ H_n ≤ 1 + log n` suffice, because the resulting `O(1/log N)` error in the variance is
dominated by `1/W`.
-/

open Finset

namespace G22.Elliott

open G22.Elem

/-- Indicator of `d ∣ m`, as a real number. -/
noncomputable def ind (d m : ℕ) : ℝ := if d ∣ m then 1 else 0

/- ### Sums over multiples -/

/-- Multiples of `d` in `[1, N]` are `d k` with `k ∈ [1, N/d]`. -/
lemma sum_Icc_dvd (N d : ℕ) (hd : 0 < d) (g : ℕ → ℝ) :
    ∑ m ∈ Icc 1 N, (if d ∣ m then g m else 0) = ∑ k ∈ Icc 1 (N / d), g (d * k) := by
  rw [← Finset.sum_filter]
  have himg : (Icc 1 N).filter (fun m => d ∣ m) = (Icc 1 (N / d)).image (fun k => d * k) := by
    ext m
    simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_image]
    constructor
    · rintro ⟨⟨h1, h2⟩, k, rfl⟩
      refine ⟨k, ⟨?_, ?_⟩, rfl⟩
      · rcases Nat.eq_zero_or_pos k with rfl | hk
        · simp at h1
        · exact hk
      · exact (Nat.le_div_iff_mul_le hd).mpr (by rw [mul_comm]; exact h2)
    · rintro ⟨k, ⟨h1, h2⟩, rfl⟩
      refine ⟨⟨Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero hd.ne' (by omega)), ?_⟩,
        dvd_mul_right d k⟩
      calc d * k ≤ d * (N / d) := Nat.mul_le_mul_left d h2
        _ ≤ N := Nat.mul_div_le N d
  rw [himg, Finset.sum_image]
  intro x _ y _ hxy
  exact Nat.eq_of_mul_eq_mul_left hd hxy

/-- `∑_{m ≤ N, d ∣ m} 1/m = H_{⌊N/d⌋}/d`. -/
lemma sum_inv_ind (N d : ℕ) (hd : 0 < d) :
    ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * ind d m = hR (N / d) / d := by
  have e : ∀ m ∈ Icc 1 N, 1 / (m : ℝ) * ind d m = if d ∣ m then 1 / (m : ℝ) else 0 := by
    intro m _; unfold ind; split_ifs <;> simp
  rw [Finset.sum_congr rfl e, sum_Icc_dvd N d hd, ← sum_inv_Icc, Finset.sum_div]
  refine Finset.sum_congr rfl fun k hk => ?_
  have hk : (0 : ℝ) < k := by exact_mod_cast (Finset.mem_Icc.mp hk).1
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  push_cast
  field_simp

/- ### Bounds for `H_{⌊N/d⌋}` -/

/-- `log N - log d ≤ H_{⌊N/d⌋}`. -/
lemma log_sub_le_hR_div {N d : ℕ} (hN : 1 ≤ N) (hd : 0 < d) :
    Real.log N - Real.log d ≤ hR (N / d) := by
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  have h1 : (N : ℝ) / d ≤ ((N / d + 1 : ℕ) : ℝ) := by
    rw [div_le_iff₀ hdr]
    have h := Nat.lt_mul_div_succ N hd
    have h' : (N : ℝ) < (d : ℝ) * ((N / d + 1 : ℕ) : ℝ) := by exact_mod_cast h
    linarith
  rw [← Real.log_div hNr.ne' hdr.ne', hR_eq_harmonic]
  exact (Real.log_le_log (by positivity) h1).trans (log_add_one_le_harmonic _)

/-- `H_{⌊N/d⌋} ≤ 1 + log N - log d` for `1 ≤ d ≤ N`. -/
lemma hR_div_le {N d : ℕ} (hd : 0 < d) (hdN : d ≤ N) :
    hR (N / d) ≤ 1 + Real.log N - Real.log d := by
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  have hNr : (0 : ℝ) < N := by exact_mod_cast (lt_of_lt_of_le hd hdN)
  have hq : (0 : ℝ) < ((N / d : ℕ) : ℝ) := by exact_mod_cast Nat.div_pos hdN hd
  have h1 : ((N / d : ℕ) : ℝ) ≤ (N : ℝ) / d := Nat.cast_div_le
  have h2 : Real.log ((N / d : ℕ) : ℝ) ≤ Real.log N - Real.log d := by
    rw [← Real.log_div hNr.ne' hdr.ne']
    exact Real.log_le_log hq h1
  linarith [hR_le (N / d)]

/- ### GS Lemma A.4 (dilation) -/

/-- **GS Lemma A.4**: `|E^log_{n≤N} f(pn) - E^log_{m≤N} p 1_{p∣m} f(m)| ≤ (1 + log p)/log N`. -/
lemma dilation {N p : ℕ} (hN : 2 ≤ N) (hp : 0 < p) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    |logAvg N (fun n => f (p * n)) -
      wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun m => (p : ℝ) * (ind p m * f m))| ≤
      (1 + Real.log p) / Real.log N := by
  have hlogN := log_pos_of_two_le hN
  have hL : Real.log N ≤ hR N := log_le_hR N
  have hLpos : 0 < hR N := lt_of_lt_of_le hlogN hL
  have hpr : (0 : ℝ) < p := by exact_mod_cast hp
  -- the numerator of the second average, reindexed
  have e2 : ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * ((p : ℝ) * (ind p m * f m)) =
      ∑ k ∈ Icc 1 (N / p), 1 / (k : ℝ) * f ((p : ℤ) * (k : ℤ)) := by
    have e : ∀ m ∈ Icc 1 N, 1 / (m : ℝ) * ((p : ℝ) * (ind p m * f m)) =
        if p ∣ m then (p : ℝ) / m * f m else 0 := by
      intro m _; unfold ind; split_ifs <;> ring
    rw [Finset.sum_congr rfl e, sum_Icc_dvd N p hp]
    refine Finset.sum_congr rfl fun k hk => ?_
    have hk : (0 : ℝ) < k := by exact_mod_cast (Finset.mem_Icc.mp hk).1
    push_cast
    field_simp
  have hsub : Icc 1 (N / p) ⊆ Icc 1 N := Finset.Icc_subset_Icc le_rfl (Nat.div_le_self N p)
  have e3 := Finset.sum_sdiff hsub (f := fun n : ℕ => 1 / (n : ℝ) * f ((p : ℤ) * (n : ℤ)))
  have e4 := Finset.sum_sdiff hsub (f := fun n : ℕ => 1 / (n : ℝ))
  rw [sum_inv_Icc, sum_inv_Icc] at e4
  have hbound : |∑ n ∈ Icc 1 N \ Icc 1 (N / p), 1 / (n : ℝ) * f ((p : ℤ) * (n : ℤ))| ≤
      ∑ n ∈ Icc 1 N \ Icc 1 (N / p), 1 / (n : ℝ) :=
    abs_sum_weighted_le _ _ (fun n _ => by positivity) _ (fun n _ => hf _)
  have hH : hR N - hR (N / p) ≤ 1 + Real.log p := by
    have h1 := log_sub_le_hR_div (show 1 ≤ N by omega) hp
    linarith [hR_le N]
  have hnum : |∑ n ∈ Icc 1 N, 1 / (n : ℝ) * f ((p : ℤ) * (n : ℤ)) -
      ∑ k ∈ Icc 1 (N / p), 1 / (k : ℝ) * f ((p : ℤ) * (k : ℤ))| ≤ 1 + Real.log p := by
    have : ∑ n ∈ Icc 1 N, 1 / (n : ℝ) * f ((p : ℤ) * (n : ℤ)) -
        ∑ k ∈ Icc 1 (N / p), 1 / (k : ℝ) * f ((p : ℤ) * (k : ℤ)) =
        ∑ n ∈ Icc 1 N \ Icc 1 (N / p), 1 / (n : ℝ) * f ((p : ℤ) * (n : ℤ)) := by
      rw [← e3]; ring
    rw [this]
    linarith
  have h1p : 0 ≤ 1 + Real.log p := by
    have : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast hp)
    linarith
  unfold logAvg wavg
  rw [sum_inv_Icc, e2, ← sub_div, abs_div, abs_of_pos hLpos]
  calc _ ≤ (1 + Real.log p) / hR N := div_le_div_of_nonneg_right hnum hLpos.le
    _ ≤ (1 + Real.log p) / Real.log N := div_le_div_of_nonneg_left h1p hlogN hL

/- ### The variance bound (log-averaged Turán–Kubilius) -/

/-- The covariances `c(p,p') = ∑_{m≤N} (1/m)(1/p - 1_{p∣m})(1/p' - 1_{p'∣m})`:
`c(p,p) ≤ 2 H_N/p`, and `c(p,p') ≤ 2/(pp')` for distinct primes with `pp' ≤ N`. -/
lemma cov_le {N P p p' : ℕ} (hN : 2 ≤ N) (hp : p.Prime) (hp' : p'.Prime) (hpP : p ≤ P)
    (hp'P : p' ≤ P) (hPN : P * P ≤ N) :
    ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * ((1 / (p : ℝ) - ind p m) * (1 / (p' : ℝ) - ind p' m)) ≤
      (if p = p' then 2 * hR N / p else 0) + 2 / ((p : ℝ) * p') := by
  have hp0 : 0 < p := hp.pos
  have hp0' : 0 < p' := hp'.pos
  have hpr : (0 : ℝ) < p := by exact_mod_cast hp0
  have hpr' : (0 : ℝ) < p' := by exact_mod_cast hp0'
  have hN1 : 1 ≤ N := by omega
  by_cases hpp : p = p'
  · subst hpp
    rw [if_pos rfl]
    have e : ∀ m ∈ Icc 1 N,
        1 / (m : ℝ) * ((1 / (p : ℝ) - ind p m) * (1 / (p : ℝ) - ind p m)) =
        (1 - 2 / p) * (1 / (m : ℝ) * ind p m) + 1 / (p : ℝ) ^ 2 * (1 / (m : ℝ)) := by
      intro m _; unfold ind; split_ifs <;> ring
    rw [Finset.sum_congr rfl e, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum,
      sum_inv_ind N p hp0, sum_inv_Icc]
    have h1 : hR (N / p) ≤ hR N := hR_mono (Nat.div_le_self N p)
    have h2 : 0 ≤ hR (N / p) := hR_nonneg _
    have h3 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
    have hL0 : 0 ≤ hR N := hR_nonneg _
    have a1 : (1 - 2 / (p : ℝ)) * (hR (N / p) / p) ≤ hR N / p := by
      have : 0 ≤ 2 / (p : ℝ) := by positivity
      have : (1 - 2 / (p : ℝ)) * (hR (N / p) / p) ≤ 1 * (hR (N / p) / p) := by
        apply mul_le_mul_of_nonneg_right _ (by positivity); linarith
      refine this.trans ?_
      rw [one_mul]
      exact div_le_div_of_nonneg_right h1 hpr.le
    have a2 : 1 / (p : ℝ) ^ 2 * hR N ≤ hR N / p := by
      rw [one_div_mul_eq_div]
      apply div_le_div_of_nonneg_left hL0 hpr
      nlinarith
    have a3 : 0 ≤ 2 / ((p : ℝ) * p) := by positivity
    have e5 : 2 * hR N / p = hR N / p + hR N / p := by ring
    linarith
  · rw [if_neg hpp]
    have hcop : Nat.Coprime p p' := (Nat.coprime_primes hp hp').mpr hpp
    have e : ∀ m ∈ Icc 1 N,
        1 / (m : ℝ) * ((1 / (p : ℝ) - ind p m) * (1 / (p' : ℝ) - ind p' m)) =
        1 / (m : ℝ) * ind (p * p') m - 1 / (p' : ℝ) * (1 / (m : ℝ) * ind p m)
          - 1 / (p : ℝ) * (1 / (m : ℝ) * ind p' m) + 1 / ((p : ℝ) * p') * (1 / (m : ℝ)) := by
      intro m _
      unfold ind
      by_cases h1 : p ∣ m <;> by_cases h2 : p' ∣ m
      · rw [if_pos h1, if_pos h2, if_pos (hcop.mul_dvd_of_dvd_of_dvd h1 h2)]
        field_simp
        ring
      · rw [if_pos h1, if_neg h2, if_neg (fun h => h2 (dvd_of_mul_left_dvd h))]
        field_simp
        ring
      · rw [if_neg h1, if_pos h2, if_neg (fun h => h1 (dvd_of_mul_right_dvd h))]
        field_simp
        ring
      · rw [if_neg h1, if_neg h2, if_neg (fun h => h1 (dvd_of_mul_right_dvd h))]
        field_simp
        ring
    rw [Finset.sum_congr rfl e, Finset.sum_add_distrib, Finset.sum_sub_distrib,
      Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum,
      sum_inv_ind N (p * p') (Nat.mul_pos hp0 hp0'), sum_inv_ind N p hp0, sum_inv_ind N p' hp0',
      sum_inv_Icc]
    have hppN : p * p' ≤ N := le_trans (Nat.mul_le_mul hpP hp'P) hPN
    have a1 := hR_div_le (Nat.mul_pos hp0 hp0') hppN
    have a2 := log_sub_le_hR_div hN1 hp0
    have a3 := log_sub_le_hR_div hN1 hp0'
    have a4 := hR_le N
    push_cast at a1
    rw [Real.log_mul hpr.ne' hpr'.ne'] at a1
    have key : hR (N / (p * p')) - hR (N / p) - hR (N / p') + hR N ≤ 2 := by linarith
    have e5 : hR (N / (p * p')) / ((p * p' : ℕ) : ℝ) - 1 / (p' : ℝ) * (hR (N / p) / p) -
        1 / (p : ℝ) * (hR (N / p') / p') + 1 / ((p : ℝ) * p') * hR N =
        (hR (N / (p * p')) - hR (N / p) - hR (N / p') + hR N) / ((p : ℝ) * p') := by
      push_cast
      field_simp
    rw [e5, zero_add]
    exact div_le_div_of_nonneg_right key (by positivity)

/-- **Variance bound**: `E^log_{m≤N} (E^log_{p∈S}(1 - p 1_{p∣m}))² ≤ 4/W` when `P² ≤ N`. -/
lemma variance_le {N P : ℕ} (hN : 2 ≤ N) (hPN : P * P ≤ N) {S : Finset ℕ} (hS : S.Nonempty)
    (hSP : ∀ p ∈ S, p.Prime ∧ p ≤ P) :
    wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun m => (lavg S (fun p => 1 - p * ind p m)) ^ 2) ≤
      4 / ∑ p ∈ S, (1 : ℝ) / p := by
  have h0 : ∀ p ∈ S, 0 < p := fun p hp => (hSP p hp).1.pos
  set W := ∑ p ∈ S, (1 : ℝ) / p with hW
  have hWpos : 0 < W := (goodWeights_lavg hS h0).sum_pos
  have hlogN := log_pos_of_two_le hN
  have hLpos : 0 < hR N := lt_of_lt_of_le hlogN (log_le_hR N)
  have hPN' : P ≤ N := le_trans (Nat.le_mul_self P) hPN
  have hWL : W ≤ hR N := by
    rw [← sum_inv_Icc]
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro p hp
      rw [Finset.mem_Icc]
      exact ⟨h0 p hp, le_trans (hSP p hp).2 hPN'⟩
    · intro _ _ _; positivity
  -- `Y m = (∑_p (1/p - 1_{p∣m})) / W`
  have hY : ∀ m, lavg S (fun p => 1 - p * ind p m) = (∑ p ∈ S, (1 / (p : ℝ) - ind p m)) / W := by
    intro m
    unfold lavg wavg
    congr 1
    refine Finset.sum_congr rfl fun p hp => ?_
    have : (0 : ℝ) < p := by exact_mod_cast h0 p hp
    field_simp
  -- expand the square
  have hQ : ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * (∑ p ∈ S, (1 / (p : ℝ) - ind p m)) ^ 2 =
      ∑ p ∈ S, ∑ p' ∈ S, ∑ m ∈ Icc 1 N,
        1 / (m : ℝ) * ((1 / (p : ℝ) - ind p m) * (1 / (p' : ℝ) - ind p' m)) := by
    simp_rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [Finset.sum_comm]
  have hQle : ∑ p ∈ S, ∑ p' ∈ S, ∑ m ∈ Icc 1 N,
        1 / (m : ℝ) * ((1 / (p : ℝ) - ind p m) * (1 / (p' : ℝ) - ind p' m)) ≤
      2 * hR N * W + 2 * W ^ 2 := by
    calc _ ≤ ∑ p ∈ S, ∑ p' ∈ S, ((if p = p' then 2 * hR N / p else 0) + 2 / ((p : ℝ) * p')) :=
          Finset.sum_le_sum fun p hp => Finset.sum_le_sum fun p' hp' =>
            cov_le hN (hSP p hp).1 (hSP p' hp').1 (hSP p hp).2 (hSP p' hp').2 hPN
      _ = 2 * hR N * W + 2 * W ^ 2 := by
          have h1 : ∀ p ∈ S, ∑ p' ∈ S, ((if p = p' then 2 * hR N / p else 0) +
              2 / ((p : ℝ) * p')) = 2 * hR N * (1 / p) + 2 * (1 / p) * W := by
            intro p hp
            rw [Finset.sum_add_distrib, Finset.sum_ite_eq, if_pos hp, hW, Finset.mul_sum]
            congr 1
            · ring
            · refine Finset.sum_congr rfl fun p' _ => ?_
              field_simp
          rw [Finset.sum_congr rfl h1, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul,
            ← Finset.mul_sum, ← hW]
          ring
  have hQ0 : 0 ≤ ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * (∑ p ∈ S, (1 / (p : ℝ) - ind p m)) ^ 2 :=
    Finset.sum_nonneg fun m _ => by positivity
  unfold wavg
  rw [sum_inv_Icc]
  simp_rw [hY]
  have e : ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * ((∑ p ∈ S, (1 / (p : ℝ) - ind p m)) / W) ^ 2 =
      (∑ m ∈ Icc 1 N, 1 / (m : ℝ) * (∑ p ∈ S, (1 / (p : ℝ) - ind p m)) ^ 2) / W ^ 2 := by
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun m _ => ?_
    ring
  rw [e, hQ]
  rw [hQ] at hQ0
  calc _ ≤ (2 * hR N * W + 2 * W ^ 2) / W ^ 2 / hR N := by gcongr
    _ = 2 / W + 2 / hR N := by field_simp
    _ ≤ 2 / W + 2 / W := by gcongr
    _ = 4 / W := by ring

/- ### The main identity -/

/-- `E^log_n f(n) - E^log_{p∈S} E^log_m p 1_{p∣m} f(m) = E^log_n f(n) E^log_{p∈S}(1 - p 1_{p∣n})`. -/
lemma main_identity (N : ℕ) {S : Finset ℕ} (hS : S.Nonempty) (h0 : ∀ p ∈ S, 0 < p)
    (f : ℤ → ℝ) :
    logAvg N f - lavg S (fun p => wavg (Icc 1 N) (fun n => 1 / (n : ℝ))
        (fun m => (p : ℝ) * (ind p m * f m))) =
      wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun m => f m * lavg S (fun p => 1 - p * ind p m)) := by
  have hg := goodWeights_lavg hS h0
  unfold lavg
  rw [wavg_comm]
  unfold logAvg
  rw [← wavg_sub]
  refine wavg_congr fun m _ => ?_
  have e1 : f m * wavg S (fun p => 1 / (p : ℝ)) (fun p => 1 - p * ind p m) =
      wavg S (fun p => 1 / (p : ℝ)) (fun p => f m * (1 - p * ind p m)) := (wavg_smul _ _).symm
  have e2 : wavg S (fun p => 1 / (p : ℝ)) (fun p => f m * (1 - p * ind p m)) =
      wavg S (fun p => 1 / (p : ℝ)) (fun p => f m - p * (ind p m * f m)) :=
    wavg_congr fun p _ => by ring
  have e3 : wavg S (fun p => 1 / (p : ℝ)) (fun p => f m - p * (ind p m * f m)) =
      wavg S (fun p => 1 / (p : ℝ)) (fun _ => f m) -
        wavg S (fun p => 1 / (p : ℝ)) (fun p => p * (ind p m * f m)) := wavg_sub _ _
  rw [e1, e2, e3, wavg_const hg]

/- ### GS Lemma A.5 -/

/-- The estimate in the range `P² ≤ N`. -/
theorem main_bound {N P : ℕ} (hN : 2 ≤ N) (hPN : P * P ≤ N) {S : Finset ℕ} (hS : S.Nonempty)
    (hSP : ∀ p ∈ S, p.Prime ∧ p ≤ P) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    |logAvg N f - lavg S (fun p => logAvg N (fun n => f (p * n)))| ≤
      (1 + Real.log P) / Real.log N + 2 / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) := by
  have h0 : ∀ p ∈ S, 0 < p := fun p hp => (hSP p hp).1.pos
  have hg := goodWeights_lavg hS h0
  have hgN := goodWeights_logAvg (show 1 ≤ N by omega)
  set W := ∑ p ∈ S, (1 : ℝ) / p with hW
  have hWpos : 0 < W := hg.sum_pos
  set M : ℕ → ℝ := fun p => wavg (Icc 1 N) (fun n => 1 / (n : ℝ))
    (fun m => (p : ℝ) * (ind p m * f m)) with hM
  -- dilation part
  have hdil : |lavg S (fun p => logAvg N (fun n => f (p * n))) - lavg S M| ≤
      (1 + Real.log P) / Real.log N := by
    refine abs_wavg_sub_le hg fun p hp => ?_
    refine (dilation hN (h0 p hp) f hf).trans ?_
    apply div_le_div_of_nonneg_right _ (log_pos_of_two_le hN).le
    have := Real.log_le_log (by exact_mod_cast h0 p hp)
      (show (p : ℝ) ≤ P by exact_mod_cast (hSP p hp).2)
    linarith
  -- main part
  have hmain : |logAvg N f - lavg S M| ≤ 2 / Real.sqrt W := by
    rw [hM, main_identity N hS h0 f]
    refine (abs_wavg_mul_le hgN _ _).trans ?_
    have hf2 : wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun m => f m ^ 2) ≤ 1 :=
      wavg_le_of_le hgN fun m _ => (sq_le_one_iff_abs_le_one _).mpr (hf _)
    have hV := variance_le hN hPN hS hSP
    have hs1 : Real.sqrt (wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun m => f m ^ 2)) ≤ 1 :=
      Real.sqrt_le_one.mpr hf2
    have hs2 : Real.sqrt (wavg (Icc 1 N) (fun n => 1 / (n : ℝ))
        (fun m => (lavg S (fun p => 1 - p * ind p m)) ^ 2)) ≤ Real.sqrt (4 / W) :=
      Real.sqrt_le_sqrt hV
    have e4 : Real.sqrt (4 / W) = 2 / Real.sqrt W := by
      rw [Real.sqrt_div (by norm_num)]
      congr 1
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
    calc _ ≤ 1 * Real.sqrt (4 / W) :=
          mul_le_mul hs1 hs2 (Real.sqrt_nonneg _) zero_le_one
      _ = 2 / Real.sqrt W := by rw [one_mul, e4]
  calc |logAvg N f - lavg S (fun p => logAvg N (fun n => f (p * n)))|
      ≤ |logAvg N f - lavg S M| + |lavg S M - lavg S (fun p => logAvg N (fun n => f (p * n)))| :=
        abs_sub_le _ _ _
    _ ≤ 2 / Real.sqrt W + (1 + Real.log P) / Real.log N := by
        rw [abs_sub_comm (lavg S M)]; linarith
    _ = _ := by ring

/-- **GS Lemma A.5** with the constant `4`. -/
theorem lemmaA5With_four : LemmaA5With 4 := by
  intro N P hN hP S hS hSP f hf
  have hlogN := log_pos_of_two_le hN
  have hlogP : Real.log 2 ≤ Real.log P :=
    Real.log_le_log (by norm_num) (by exact_mod_cast hP)
  have hl2 := Real.log_two_gt_d9
  have hsq : 0 ≤ 4 / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) := by positivity
  by_cases hPN : P * P ≤ N
  · have h := main_bound hN hPN hS hSP f hf
    have h1 : (1 + Real.log P) / Real.log N ≤ 4 * (Real.log P / Real.log N) := by
      rw [mul_div_assoc', div_le_div_iff_of_pos_right hlogN]; linarith
    have h2 : 2 / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) ≤ 4 / Real.sqrt (∑ p ∈ S, (1 : ℝ) / p) :=
      div_le_div_of_nonneg_right (by norm_num) (Real.sqrt_nonneg _)
    linarith
  · push Not at hPN
    have h1 : Real.log N < 2 * Real.log P := by
      have hlt : (N : ℝ) < (P : ℝ) * P := by exact_mod_cast hPN
      have hN0 : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
      have hP0 : (0 : ℝ) < P := by exact_mod_cast (show 0 < P by omega)
      have := Real.log_lt_log hN0 hlt
      rw [Real.log_mul hP0.ne' hP0.ne'] at this
      linarith
    have h2 : 2 ≤ 4 * (Real.log P / Real.log N) := by
      rw [mul_div_assoc', le_div_iff₀ hlogN]; linarith
    have hgN := goodWeights_logAvg (show 1 ≤ N by omega)
    have a : |logAvg N f| ≤ 1 := abs_wavg_le_of_abs_le hgN fun n _ => hf _
    have b : |lavg S (fun p => logAvg N (fun n => f (p * n)))| ≤ 1 :=
      abs_wavg_le_of_abs_le (goodWeights_lavg hS fun p hp => (hSP p hp).1.pos)
        fun p _ => abs_wavg_le_of_abs_le hgN fun n _ => hf _
    have h3 : |logAvg N f - lavg S (fun p => logAvg N (fun n => f (p * n)))| ≤ 2 :=
      (abs_sub _ _).trans (by linarith)
    linarith

/-- **GS Lemma A.5** (logarithmic Elliott inequality). -/
theorem lemmaA5 : LemmaA5 := ⟨4, by norm_num, lemmaA5With_four⟩

end G22.Elliott

