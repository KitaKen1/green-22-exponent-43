/- ## Section: `P51P6f` -/

section

/-
# Step P6f of GS Proposition 5.1: the FPD property of the squares of a `Good6` box

GS = B. Green and M. Sawhney, arXiv:2511.09365v2; review §9.1 (Lemma R + Lemma Q) and §9.4.6.

`stepP6f : StepP6f` with `A' = 108`, `δ₀ = 1/(2^72 C_R²)` (`C_R = FPDQ.CR = 2^{28673}` is never
evaluated) and `N₀` from `P6f.growth`.

For a `Good6` box `∏_ℓ [a ℓ, b ℓ)` we apply `FPDQ.lemmaRQ_FPD` (Lemma R + Lemma Q) with the
Brun–Titchmarsh input `L41.btWith : BTWith 40 2`, the rich factor `i₀ = ` the last factor
(`M = a i₀ ≥ P'₁`, `y = b i₀ - a i₀ ≥ M/(8k)`), and the parameters
* `ε = δ⁶`, `η = δ⁷`, `K_res = 8·40/ε`, `K_int = 64·40·k/ε`;
* `ρ = δ²⁷/(819200 k)` (so `4ρK_int = η³/80`);
* `V₀ = ⌈(2²⁵ C_R/δ³³)²⌉` (so `4 C_R K_res²/√V₀ ≤ η³/80`);
* `d₀ = ⌈Z¹⁵⁰⌉` with `Z = 2²⁰ C_R log N` (so the (Q4)-term is `≤ η³/32`, and `d₀ ≥ V₀²`).
The collision term is `≤ k/⌊√P'₁⌋ ≤ η³/80`. All "N large" conditions (`(8k)⁴ ≤ P'₁`,
`8k d₀^{10} ≤ P'₁`, `ρ⁴ P'₁ ≥ 1`, `80k/δ²¹ ≤ ⌊√P'₁⌋`) follow from `Z^{1512} ≤ P'₁`, which holds for
`N` large since `log log P'₁ ≥ (log log N)^{1/10}` (`P6f.growth`). The output
`FPD(S_c, T, 4Y², δ⁷, V₀, 2V₀/(ρ√(2δ⁷)))` is weakened to `Q₀ = W = δ^{-108}` for `δ ≤ δ₀`
(`P6f.fpd_mono`), and the sign `e = -1` follows from the evenness of the Fejér kernel
(`P6f.fejer_neg`, `P6f.fpd_image_neg`).
-/

open Finset Real

namespace G22.P51

namespace P6f

/- ## Sign and monotonicity of `FPDProp` -/

lemma ee_neg (x : ℝ) : FPD.ee (-x) = (starRingEnd ℂ) (FPD.ee x) := by
  unfold FPD.ee
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
  push_cast
  ring

/-- The Fejér kernel is even. -/
lemma fejer_neg (T : ℕ) (α : ℝ) : FPD.fejer T (-α) = FPD.fejer T α := by
  unfold FPD.fejer
  have h : (∑ t ∈ Icc 1 T, FPD.ee (-α * t)) / (T : ℂ) =
      (starRingEnd ℂ) ((∑ t ∈ Icc 1 T, FPD.ee (α * t)) / T) := by
    rw [map_div₀, map_sum, Complex.conj_natCast]
    congr 1
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [← ee_neg]
    congr 1
    ring
  rw [h, Complex.norm_conj]

/-- `FPDProp` is invariant under `S ↦ -S`. -/
lemma fpd_image_neg {S : Finset ℤ} {T D : ℕ} {η Q₀ W : ℝ} (h : FPDQ.FPDProp S T D η Q₀ W) :
    FPDQ.FPDProp (S.image (fun s => -s)) T D η Q₀ W := by
  intro θ hθ
  apply h θ
  have hinj : Set.InjOn (fun s : ℤ => -s) (S : Set ℤ) := fun x _ y _ hxy => neg_injective hxy
  rw [Finset.card_image_of_injOn hinj, Finset.sum_image hinj] at hθ
  convert hθ using 2
  refine Finset.sum_congr rfl fun s _ => ?_
  push_cast
  rw [mul_neg, fejer_neg]

/-- `FPDProp` is monotone in `Q₀` and `W`. -/
lemma fpd_mono {S : Finset ℤ} {T D : ℕ} {η Q₀ W Q₀' W' : ℝ} (h : FPDQ.FPDProp S T D η Q₀ W)
    (hQ : Q₀ ≤ Q₀') (hW : W ≤ W') : FPDQ.FPDProp S T D η Q₀' W' := by
  intro θ hθ
  obtain ⟨q, hq1, hqQ, hqd⟩ := h θ hθ
  exact ⟨q, hq1, hqQ.trans hQ, hqd.trans (div_le_div_of_nonneg_right hW (by positivity))⟩

/- ## Growth: `(C log N)^m ≤ P'₁` for `N` large -/

/-- For every `C ≥ 1` and `m`, `(C log N)^m ≤ P'₁` once `N` is large (from
`log log N ≤ (log log P'₁)^{10}`: with `u = log log P'₁`, `L = log log N`,
`e^u ≥ u^{20}/20! ≥ L²/20! ≥ m (log C + L)`). Also `log N ≥ 1`. -/
lemma growth (C : ℝ) (hC : 1 ≤ C) (m : ℕ) :
    ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N → 1 ≤ Real.log D.N ∧ (C * Real.log D.N) ^ m ≤ D.P₁' := by
  set F : ℝ := ((20 : ℕ).factorial : ℝ) with hFdef
  set L₀ : ℝ := max 1 (F * m * (Real.log C + 1)) with hL₀
  refine ⟨⌈Real.exp (Real.exp L₀)⌉₊, fun D hN => ?_⟩
  have hNR : Real.exp (Real.exp L₀) ≤ (D.N : ℝ) := (Nat.le_ceil _).trans (by exact_mod_cast hN)
  have hN0 : (0 : ℝ) < D.N := lt_of_lt_of_le (Real.exp_pos _) hNR
  have hΛ : Real.exp L₀ ≤ Real.log D.N := (Real.le_log_iff_exp_le hN0).mpr hNR
  have hΛ0 : 0 < Real.log D.N := lt_of_lt_of_le (Real.exp_pos _) hΛ
  have hL : L₀ ≤ Real.log (Real.log D.N) := (Real.le_log_iff_exp_le hΛ0).mpr hΛ
  have hL1 : 1 ≤ L₀ := le_max_left _ _
  have hΛ1 : 1 ≤ Real.log D.N := by
    have : 1 ≤ Real.exp L₀ := Real.one_le_exp (by linarith)
    linarith
  refine ⟨hΛ1, ?_⟩
  set L := Real.log (Real.log D.N) with hLdef
  set u := Real.log (Real.log D.P₁') with hu
  have hP3 : (3 : ℝ) ≤ D.P₁' := by exact_mod_cast D.hP₁'
  have hP0 : (0 : ℝ) < D.P₁' := by linarith
  have hlogP : 1 < Real.log D.P₁' := by
    rw [Real.lt_log_iff_exp_lt hP0]
    have := Real.exp_one_lt_d9
    norm_num at this
    linarith
  have hu0 : 0 < u := Real.log_pos hlogP
  have hLu : L ≤ u ^ 10 := D.hP₁'N
  have hL0 : 0 ≤ L := by linarith
  have hL2 : L ^ 2 ≤ u ^ 20 := by
    calc L ^ 2 ≤ (u ^ 10) ^ 2 := pow_le_pow_left₀ hL0 hLu 2
      _ = u ^ 20 := by ring
  have hexp : u ^ 20 / F ≤ Real.exp u := Real.pow_div_factorial_le_exp u hu0.le 20
  have hexpu : Real.exp u = Real.log D.P₁' := Real.exp_log (by linarith)
  have hlogC : 0 ≤ Real.log C := Real.log_nonneg hC
  have hF : (0 : ℝ) < F := by rw [hFdef]; exact_mod_cast Nat.factorial_pos _
  have hm : (0 : ℝ) ≤ m := Nat.cast_nonneg _
  have key : (m : ℝ) * (Real.log C + L) ≤ Real.log D.P₁' := by
    rw [← hexpu]
    refine le_trans ?_ hexp
    rw [le_div_iff₀ hF]
    have h1 : (m : ℝ) * (Real.log C + L) ≤ L * (m * (Real.log C + 1)) := by
      have : Real.log C ≤ L * Real.log C := le_mul_of_one_le_left hlogC (by linarith)
      nlinarith
    have h2 : F * (m * (Real.log C + 1)) ≤ L := by
      have : F * m * (Real.log C + 1) ≤ L₀ := le_max_right _ _
      calc F * (m * (Real.log C + 1)) = F * m * (Real.log C + 1) := by ring
        _ ≤ L₀ := this
        _ ≤ L := hL
    calc (m : ℝ) * (Real.log C + L) * F ≤ L * (m * (Real.log C + 1)) * F :=
          mul_le_mul_of_nonneg_right h1 hF.le
      _ = L * (F * (m * (Real.log C + 1))) := by ring
      _ ≤ L * L := mul_le_mul_of_nonneg_left h2 hL0
      _ = L ^ 2 := by ring
      _ ≤ u ^ 20 := hL2
  have hC0 : 0 < C := by linarith
  rw [← Real.log_le_log_iff (by positivity) hP0, Real.log_pow,
    Real.log_mul hC0.ne' hΛ0.ne']
  exact key

/- ## Lemma R + Lemma Q for a `Good6` box -/

/-- `4k(b - a) ≤ a` from `4kb ≤ (4k+1)a`. -/
lemma width_le {k a b : ℕ} (h : 4 * k * b ≤ (4 * k + 1) * a) : 4 * k * (b - a) ≤ a := by
  rw [Nat.mul_sub]
  have : (4 * k + 1) * a = 4 * k * a + a := by ring
  omega

/-- `a ≤ 8k(b - a)` from `(8k+1)a ≤ 8kb`. -/
lemma wide_le {k a b : ℕ} (h : (8 * k + 1) * a ≤ 8 * k * b) : a ≤ 8 * k * (b - a) := by
  rw [Nat.mul_sub]
  have : (8 * k + 1) * a = 8 * k * a + a := by ring
  omega

/-- `a³ ≤ y⁴` from `a ≤ 8ky` and `(8k)⁴ ≤ a`. -/
lemma cube_le {k a y : ℕ} (ha : a ≤ 8 * k * y) (hk : (8 * k) ^ 4 ≤ a) (ha0 : 0 < a) :
    a ^ 3 ≤ y ^ 4 := by
  have h1 : a ^ 4 ≤ (8 * k * y) ^ 4 := Nat.pow_le_pow_left ha 4
  have h2 : (8 * k * y) ^ 4 = (8 * k) ^ 4 * y ^ 4 := by ring
  have h3 : (8 * k) ^ 4 * y ^ 4 ≤ a * y ^ 4 := Nat.mul_le_mul_right _ hk
  have h4 : a * a ^ 3 ≤ a * y ^ 4 := by
    calc a * a ^ 3 = a ^ 4 := by ring
      _ ≤ (8 * k) ^ 4 * y ^ 4 := h2 ▸ h1
      _ ≤ a * y ^ 4 := h3
  exact Nat.le_of_mul_le_mul_left h4 ha0

/-- The collision term of (Q5): `∑ᵢ 1/|Pᵢ| ≤ k/s ≤ δ²¹/80` when every `|Pᵢ| ≥ s ≥ 80k/δ²¹`. -/
lemma T2_le {k s : ℕ} {δ : ℝ} (hδ : 0 < δ) (hk : 1 ≤ k) (P : Fin k → Finset ℕ)
    (hP : ∀ i, s ≤ (P i).card) (hs : 80 * (k : ℝ) / δ ^ 21 ≤ s) :
    ∑ i, 1 / ((P i).card : ℝ) ≤ δ ^ 21 / 80 := by
  have hk0 : (0 : ℝ) < k := by exact_mod_cast hk
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le (by positivity) hs
  calc ∑ i, 1 / ((P i).card : ℝ) ≤ ∑ _i : Fin k, 1 / (s : ℝ) := by
        apply Finset.sum_le_sum
        intro i _
        exact one_div_le_one_div_of_le hs0 (by exact_mod_cast hP i)
    _ = k / s := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
    _ ≤ δ ^ 21 / 80 := by
        rw [div_le_div_iff₀ hs0 (by norm_num)]
        have := (div_le_iff₀ (by positivity)).mp hs
        linarith

/-- The large-prime term of (Q5): `2 (8A/(δ⁶d₀)) B / log d₀ ≤ δ²¹/32` when `0 ≤ A ≤ Λ`,
`0 ≤ B ≤ 4Λ`, `d₀ ≥ 3` and `d₀ ≥ 2¹¹Λ²/δ²⁷`. -/
lemma T4_le {δ Λ A B : ℝ} {d₀ : ℕ} (hδ : 0 < δ) (hA0 : 0 ≤ A) (hA : A ≤ Λ) (hB0 : 0 ≤ B)
    (hB : B ≤ 4 * Λ) (hd₀3 : 3 ≤ d₀) (hd₀Λ : 2 ^ 11 * Λ ^ 2 / δ ^ 27 ≤ d₀) :
    2 * (8 * A / (δ ^ 6 * d₀)) * B / Real.log d₀ ≤ δ ^ 21 / 32 := by
  have hd₀R : (3 : ℝ) ≤ d₀ := by exact_mod_cast hd₀3
  have hld : 1 ≤ Real.log d₀ := by
    rw [Real.le_log_iff_exp_le (by linarith)]
    have := Real.exp_one_lt_d9
    norm_num at this
    linarith
  have hε : 0 < δ ^ 6 := by positivity
  have hd0 : (0 : ℝ) < d₀ := by linarith
  have hΛ0 : 0 ≤ Λ := hA0.trans hA
  have hnum : 0 ≤ 2 * (8 * A / (δ ^ 6 * d₀)) * B := by positivity
  have h27 : 2 ^ 11 * Λ ^ 2 ≤ d₀ * δ ^ 27 := (div_le_iff₀ (by positivity)).mp hd₀Λ
  have hAB : A * B ≤ Λ * (4 * Λ) := mul_le_mul hA hB hB0 hΛ0
  calc 2 * (8 * A / (δ ^ 6 * d₀)) * B / Real.log d₀ ≤ 2 * (8 * A / (δ ^ 6 * d₀)) * B :=
        div_le_self hnum hld
    _ = 16 * (A * B) / (δ ^ 6 * d₀) := by ring
    _ ≤ 16 * (Λ * (4 * Λ)) / (δ ^ 6 * d₀) := by gcongr
    _ ≤ δ ^ 21 / 32 := by
        rw [div_le_div_iff₀ (by positivity) (by norm_num)]
        have e : δ ^ 21 * (δ ^ 6 * d₀) = d₀ * δ ^ 27 := by ring
        rw [e]
        nlinarith

/-- `0 ≤ log(4Y²) ≤ 4Λ` for `1 ≤ Y ≤ P`, `log P ≤ Λ`, `Λ ≥ 1`. -/
lemma log_four_sq_le {Y P : ℕ} {Λ : ℝ} (hY : 1 ≤ Y) (hYP : Y ≤ P) (hPΛ : Real.log P ≤ Λ)
    (hΛ : 1 ≤ Λ) :
    0 ≤ Real.log (4 * (Y : ℝ) ^ 2) ∧ Real.log (4 * (Y : ℝ) ^ 2) ≤ 4 * Λ := by
  have hYR : (1 : ℝ) ≤ Y := by exact_mod_cast hY
  have hPR : (Y : ℝ) ≤ P := by exact_mod_cast hYP
  have hP0 : (0 : ℝ) < P := by linarith
  constructor
  · apply Real.log_nonneg; nlinarith
  · have h1 : Real.log (4 * (Y : ℝ) ^ 2) ≤ Real.log (4 * (P : ℝ) ^ 2) :=
      Real.log_le_log (by positivity) (by gcongr)
    have h2 : Real.log (4 * (P : ℝ) ^ 2) = Real.log 4 + 2 * Real.log P := by
      rw [Real.log_mul (by norm_num) (by positivity), Real.log_pow]; push_cast; ring
    have h3 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; ring
    have h4 := Real.log_two_lt_d9
    norm_num at h4
    linarith

/-- **Lemma R + Q for a `Good6` box** (rich factor = the last one), under explicit parameter
inequalities: `FPD({x² - c : x ∈ box}, T, 4Y², δ⁷, V₀, 2V₀/(ρ√(2δ⁷)))`, `Y = ∏ a ℓ`. -/
lemma core (D : Data) (a b : Fin D.k → ℕ) (hab : Good6 D a b)
    {ρ : ℝ} {V₀ d₀ : ℕ} {Λ : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ ≤ 1)
    (hV₀ : 1 ≤ V₀) (hVd : V₀ ^ 2 ≤ d₀) (hd₀3 : 3 ≤ d₀)
    (hΛ : 1 ≤ Λ) (hP₂Λ : Real.log D.P₂' ≤ Λ)
    (hd₀Λ : 2 ^ 11 * Λ ^ 2 / D.δ ^ 27 ≤ d₀)
    (hd₀P : 8 * D.k * d₀ ^ 10 ≤ D.P₁') (hkP : (8 * D.k) ^ 4 ≤ D.P₁')
    (hρP : 1 ≤ ρ ^ 4 * D.P₁')
    (hT1 : 4 * ρ * (64 * 40 * (D.k : ℝ) / D.δ ^ 6) ≤ D.δ ^ 21 / 80)
    (hT2 : 80 * (D.k : ℝ) / D.δ ^ 21 ≤ Nat.sqrt D.P₁')
    (hT3 : 4 * FPDQ.CR * (8 * 40 / D.δ ^ 6) ^ 2 / Real.sqrt V₀ ≤ D.δ ^ 21 / 80)
    (c : ℤ) {T : ℕ} (hT : 16 * ((∏ ℓ, a ℓ : ℕ) : ℝ) ^ 2 < T * Real.sqrt (2 * D.δ ^ 7)) :
    FPDQ.FPDProp ((almostPrimes a b).image (fun x : ℕ => (x : ℤ) ^ 2 - c))
      T (4 * (∏ ℓ, a ℓ) ^ 2) (D.δ ^ 7) V₀ (2 * V₀ / (ρ * Real.sqrt (2 * D.δ ^ 7))) := by
  obtain ⟨h5, h8, hrich⟩ := hab
  have hk1 : 1 ≤ D.k := D.hk
  have hδ := D.hδ
  have hP3 : 3 ≤ D.P₁' := D.hP₁'
  obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Fin D.k, i₀.val + 1 = D.k := ⟨⟨D.k - 1, by omega⟩, by simp; omega⟩
  have hloP : ∀ i : Fin D.k, D.P₁' ≤ a i := fun i => ((D.hI i).1).trans (h5 i).1
  have hlohi : ∀ i, a i ≤ b i := fun i => (h5 i).2.1.le
  have hwidth : ∀ i, 4 * D.k * (b i - a i) ≤ a i := fun i => width_le (h5 i).2.2.2.1
  have hdisj : ∀ i j, i ≠ j → b i ≤ a j ∨ b j ≤ a i := by
    intro i j hij
    rcases D.hdisj i j hij with h | h
    · left; have := (h5 i).2.2.1; have := (h5 j).1; omega
    · right; have := (h5 j).2.2.1; have := (h5 i).1; omega
  have hne : ∀ i, (primesIn (a i) (b i)).Nonempty := by
    intro i
    have hs : 1 ≤ Nat.sqrt D.P₁' := Nat.le_sqrt.mpr (by omega)
    exact Finset.card_pos.mp (by have := (h5 i).2.2.2.2; omega)
  have hd₀P' : d₀ < D.P₁' := by
    have h1 : d₀ ≤ d₀ ^ 10 := Nat.le_self_pow (by norm_num) d₀
    have h2 : 0 < d₀ ^ 10 := by positivity
    have h3 : d₀ ^ 10 < 8 * D.k * d₀ ^ 10 := by nlinarith
    omega
  have hd₀lo : ∀ i, d₀ < a i := fun i => lt_of_lt_of_le hd₀P' (hloP i)
  have ha3 : 3 ≤ a i₀ := hP3.trans (hloP i₀)
  have hM : 2 ≤ a i₀ := by omega
  have hwide : a i₀ ≤ 8 * D.k * (b i₀ - a i₀) := wide_le (h8 i₀)
  have hyM : a i₀ ^ 3 ≤ (b i₀ - a i₀) ^ 4 :=
    cube_le hwide (hkP.trans (hloP i₀)) (by omega)
  have hd₀y : d₀ ^ 10 ≤ b i₀ - a i₀ := by
    have h1 : 8 * D.k * d₀ ^ 10 ≤ 8 * D.k * (b i₀ - a i₀) :=
      (hd₀P.trans (hloP i₀)).trans hwide
    exact Nat.le_of_mul_le_mul_left h1 (by omega)
  have hy₀ : 2 ≤ b i₀ - a i₀ := by
    have : 2 ^ 10 ≤ d₀ ^ 10 := Nat.pow_le_pow_left (by omega) 10
    omega
  have haR : (D.P₁' : ℝ) ≤ a i₀ := by exact_mod_cast hloP i₀
  have hρM : 1 ≤ ρ ^ 4 * (a i₀ : ℝ) :=
    hρP.trans (mul_le_mul_of_nonneg_left haR (by positivity))
  have hy₀ρ : ((2 : ℕ) : ℝ) ≤ 2 * ρ * (a i₀ : ℝ) := by
    have h4 : ρ ^ 4 ≤ ρ := by
      calc ρ ^ 4 = ρ * ρ ^ 3 := by ring
        _ ≤ ρ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ hρ.le hρ1) hρ.le
        _ = ρ := by ring
    have : ρ ^ 4 * (a i₀ : ℝ) ≤ ρ * a i₀ := mul_le_mul_of_nonneg_right h4 (Nat.cast_nonneg _)
    push_cast
    linarith
  have ha3R : (3 : ℝ) ≤ a i₀ := by exact_mod_cast ha3
  have hlogM : 0 < Real.log (a i₀) := Real.log_pos (by linarith)
  have hrich' : D.δ ^ 6 * ((b i₀ - a i₀ : ℕ) : ℝ) / (4 * Real.log (a i₀)) ≤
      (primesIn (a i₀) (b i₀)).card := by
    have h := hrich i₀ hi₀
    rw [Nat.cast_sub (hlohi i₀), div_le_iff₀ (by positivity)]
    linarith
  -- the terms of (Q5)
  have hT2' : ∑ i, 1 / ((primesIn (a i) (b i)).card : ℝ) ≤ D.δ ^ 21 / 80 :=
    T2_le hδ hk1 (fun i => primesIn (a i) (b i)) (fun i => (h5 i).2.2.2.2) hT2
  have hY1 : 1 ≤ ∏ i, a i := by
    have : 0 < ∏ i, a i := Finset.prod_pos (fun i _ => by have := hloP i; omega)
    omega
  have hYP : ∏ i, a i ≤ D.P₂' :=
    (Finset.prod_le_prod (fun _ _ => Nat.zero_le _)
      (fun i _ => (hlohi i).trans (h5 i).2.2.1)).trans D.hprod
  have haY : a i₀ ≤ ∏ i, a i :=
    Nat.le_of_dvd (by omega) (Finset.dvd_prod_of_mem a (Finset.mem_univ i₀))
  have hA : Real.log (a i₀) ≤ Λ := by
    have hP₂'R : ((a i₀ : ℕ) : ℝ) ≤ D.P₂' := by exact_mod_cast haY.trans hYP
    exact (Real.log_le_log (by linarith) hP₂'R).trans hP₂Λ
  obtain ⟨hB0, hB⟩ := log_four_sq_le hY1 hYP hP₂Λ hΛ
  have hT4 := T4_le hδ hlogM.le hA hB0 hB hd₀3 hd₀Λ
  have hQ5 : 4 * ρ * (64 * 40 * (D.k : ℝ) / D.δ ^ 6) +
      ∑ i, 1 / ((primesIn (a i) (b i)).card : ℝ) +
      4 * FPDQ.CR * (8 * 40 / D.δ ^ 6) ^ 2 / Real.sqrt V₀ +
      2 * (8 * Real.log (a i₀) / (D.δ ^ 6 * d₀)) * Real.log (4 * ((∏ i, a i : ℕ) : ℝ) ^ 2) /
        Real.log d₀ < (D.δ ^ 7) ^ 3 / 8 := by
    have e : (D.δ ^ 7) ^ 3 = D.δ ^ 21 := by ring
    rw [e]
    have : 0 < D.δ ^ 21 := by positivity
    linarith [hT1, hT2', hT3, hT4]
  exact FPDQ.lemmaRQ_FPD (by simp) hlohi hwidth hdisj hne (by omega) hd₀lo i₀ L41.btWith
    (by positivity) hρ hM hwide hyM hd₀y hy₀ hρM hy₀ρ hrich' (by positivity) hV₀ hVd hQ5 c hT

/- ## The parameters -/

lemma CR_one_le : 1 ≤ FPDQ.CR := by
  rw [FPDQ.CR_eq]; exact one_le_pow₀ (by norm_num)

/-- `ρ = δ²⁷/(819200 k)`, so that `4ρ K_int = 4ρ · 64·40·k/δ⁶ = δ²¹/80`. -/
noncomputable def rhoP (δ : ℝ) (k : ℕ) : ℝ := δ ^ 27 / (819200 * k)

/-- `V₀ = ⌈(2²⁵ C_R/δ³³)²⌉`, so that `4 C_R K_res²/√V₀ ≤ δ²¹/80`. -/
noncomputable def V0P (δ : ℝ) : ℕ := ⌈(2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2⌉₊

/-- `Z = 2²⁰ C_R log N`: every "N large" quantity is a power of `Z`. -/
noncomputable def ZP (N : ℕ) : ℝ := 2 ^ 20 * FPDQ.CR * Real.log N

/-- `d₀ = ⌈Z¹⁵⁰⌉`. -/
noncomputable def d0P (N : ℕ) : ℕ := ⌈ZP N ^ 150⌉₊

lemma rhoP_pos {δ : ℝ} {k : ℕ} (hδ : 0 < δ) (hk : 1 ≤ k) : 0 < rhoP δ k := by
  unfold rhoP
  have : (0 : ℝ) < k := by exact_mod_cast hk
  positivity

lemma rhoP_le_one {δ : ℝ} {k : ℕ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hk : 1 ≤ k) : rhoP δ k ≤ 1 := by
  unfold rhoP
  have hk' : (1 : ℝ) ≤ k := by exact_mod_cast hk
  rw [div_le_one (by positivity)]
  have : δ ^ 27 ≤ 1 := pow_le_one₀ hδ.le hδ1
  nlinarith

lemma T1_eq {δ : ℝ} {k : ℕ} (hδ : 0 < δ) (hk : 1 ≤ k) :
    4 * rhoP δ k * (64 * 40 * (k : ℝ) / δ ^ 6) = δ ^ 21 / 80 := by
  unfold rhoP
  have : (k : ℝ) ≠ 0 := by
    have : (0 : ℝ) < k := by exact_mod_cast hk
    exact this.ne'
  field_simp
  ring

lemma V0P_ge (δ : ℝ) : (2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2 ≤ (V0P δ : ℝ) := Nat.le_ceil _

lemma V0P_lt (δ : ℝ) : (V0P δ : ℝ) < (2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2 + 1 :=
  Nat.ceil_lt_add_one (sq_nonneg _)

lemma V0P_pos {δ : ℝ} (hδ : 0 < δ) : 1 ≤ V0P δ := by
  have hR := FPDQ.CR_pos
  have h : 0 < (2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2 := by positivity
  unfold V0P
  exact Nat.one_le_iff_ne_zero.mpr (Nat.ceil_pos.mpr h).ne'

/-- The Rankin term of (Q5): `4 C_R (8·40/δ⁶)²/√V₀ ≤ δ²¹/80`. -/
lemma T3_le {δ : ℝ} (hδ : 0 < δ) :
    4 * FPDQ.CR * (8 * 40 / δ ^ 6) ^ 2 / Real.sqrt (V0P δ) ≤ δ ^ 21 / 80 := by
  have hR := FPDQ.CR_pos
  set X := 2 ^ 25 * FPDQ.CR / δ ^ 33 with hX
  have hX0 : 0 < X := by positivity
  have hsq : X ≤ Real.sqrt (V0P δ) :=
    (Real.le_sqrt hX0.le (Nat.cast_nonneg _)).mpr (V0P_ge δ)
  calc 4 * FPDQ.CR * (8 * 40 / δ ^ 6) ^ 2 / Real.sqrt (V0P δ) ≤
        4 * FPDQ.CR * (8 * 40 / δ ^ 6) ^ 2 / X := by gcongr
    _ = 409600 / 2 ^ 25 * δ ^ 21 := by
        rw [hX]; field_simp; ring
    _ ≤ δ ^ 21 / 80 := by
        have : 0 < δ ^ 21 := by positivity
        nlinarith

lemma loglog_le_log {N : ℕ} (hΛ : 1 ≤ Real.log N) : Real.log (Real.log N) ≤ Real.log N := by
  have := Real.log_le_sub_one_of_pos (by linarith : 0 < Real.log N)
  linarith

/-- `2²⁰, C_R, log N, 1/δ, k ≤ Z` (using `1/δ, k ≤ log log N ≤ log N`). -/
lemma ZP_facts (D : Data) (hΛ : 1 ≤ Real.log D.N) :
    2 ^ 20 ≤ ZP D.N ∧ FPDQ.CR ≤ ZP D.N ∧ Real.log D.N ≤ ZP D.N ∧ 1 / D.δ ≤ ZP D.N ∧
      (D.k : ℝ) ≤ ZP D.N := by
  have hR := CR_one_le
  have hL := loglog_le_log hΛ
  have h1 : 1 ≤ FPDQ.CR * Real.log D.N := one_le_mul_of_one_le_of_one_le hR hΛ
  have hΛZ : Real.log D.N ≤ ZP D.N := by
    unfold ZP
    have : 1 ≤ 2 ^ 20 * FPDQ.CR := by nlinarith
    nlinarith
  refine ⟨?_, ?_, hΛZ, ?_, ?_⟩
  · unfold ZP; nlinarith
  · unfold ZP; nlinarith
  · exact D.hδN.trans (hL.trans hΛZ)
  · exact D.hkN.trans (hL.trans hΛZ)

/-- `log P'₂ ≤ log N` (from `(log P₂)⁴ < log N`, `P'₂ < P₂`). -/
lemma logP₂'_le (D : Data) (hΛ : 1 ≤ Real.log D.N) : Real.log D.P₂' ≤ Real.log D.N := by
  have h1 := D.hP₁'
  have h2 := D.hP₁'P₂'
  have h3 := D.hP₂'P₁
  have h4 := D.hP₁P₂
  have hP₂'pos : (0 : ℝ) < D.P₂' := by exact_mod_cast (by omega : 0 < D.P₂')
  have hle : (D.P₂' : ℝ) ≤ D.hi (Fin.last D.k) := by
    exact_mod_cast (by omega : D.P₂' ≤ D.hi (Fin.last D.k))
  have hlog : Real.log D.P₂' ≤ Real.log (D.hi (Fin.last D.k)) := Real.log_le_log hP₂'pos hle
  have h5 := D.hP₂N
  by_cases hc : Real.log (D.hi (Fin.last D.k)) ≤ 1
  · linarith
  · push Not at hc
    have : Real.log (D.hi (Fin.last D.k)) ≤ Real.log (D.hi (Fin.last D.k)) ^ 4 := by
      calc Real.log (D.hi (Fin.last D.k)) = Real.log (D.hi (Fin.last D.k)) ^ 1 := (pow_one _).symm
        _ ≤ Real.log (D.hi (Fin.last D.k)) ^ 4 := pow_le_pow_right₀ hc.le (by norm_num)
    linarith

/-- `V₀ ≤ Z⁷³`. -/
lemma V0P_le_Z {δ Z : ℝ} (hδ : 0 < δ) (hZ : 2 ^ 20 ≤ Z) (hRZ : FPDQ.CR ≤ Z)
    (hδZ : 1 / δ ≤ Z) : (V0P δ : ℝ) ≤ Z ^ 73 := by
  have hZ0 : 0 ≤ Z := le_trans (by norm_num) hZ
  have hR := FPDQ.CR_pos
  have h25 : (2 : ℝ) ^ 25 ≤ Z ^ 2 := by
    calc (2 : ℝ) ^ 25 ≤ 2 ^ 20 * 2 ^ 20 := by norm_num
      _ ≤ Z * Z := mul_le_mul hZ hZ (by norm_num) hZ0
      _ = Z ^ 2 := by ring
  have h1 : 2 ^ 25 * FPDQ.CR / δ ^ 33 ≤ Z ^ 36 := by
    have e : 2 ^ 25 * FPDQ.CR / δ ^ 33 = 2 ^ 25 * FPDQ.CR * (1 / δ) ^ 33 := by
      rw [one_div_pow]; ring
    rw [e]
    calc 2 ^ 25 * FPDQ.CR * (1 / δ) ^ 33 ≤ Z ^ 2 * Z * Z ^ 33 := by gcongr
      _ = Z ^ 36 := by ring
  have h2 : (2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2 ≤ Z ^ 72 := by
    calc (2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2 ≤ (Z ^ 36) ^ 2 := pow_le_pow_left₀ (by positivity) h1 2
      _ = Z ^ 72 := by ring
  have h3 := V0P_lt δ
  have h4 : Z ^ 72 + 1 ≤ Z ^ 73 := by
    have : 1 ≤ Z ^ 72 := one_le_pow₀ (by linarith)
    have : Z ^ 73 = Z * Z ^ 72 := by ring
    nlinarith
  linarith

lemma d0P_ge (N : ℕ) : ZP N ^ 150 ≤ (d0P N : ℝ) := Nat.le_ceil _

lemma d0P_le {N : ℕ} (hZ : 2 ≤ ZP N) : (d0P N : ℝ) ≤ ZP N ^ 151 := by
  have h1 : (d0P N : ℝ) < ZP N ^ 150 + 1 := Nat.ceil_lt_add_one (by positivity)
  have h2 : 1 ≤ ZP N ^ 150 := one_le_pow₀ (by linarith)
  have h3 : ZP N ^ 151 = ZP N * ZP N ^ 150 := by ring
  nlinarith

/-- The "N large" conditions of Lemma R and (Q5), from `Z^{1512} ≤ P'₁`. -/
lemma large_facts (D : Data) (hΛ : 1 ≤ Real.log D.N) (hZP : ZP D.N ^ 1512 ≤ D.P₁') :
    V0P D.δ ^ 2 ≤ d0P D.N ∧ 3 ≤ d0P D.N ∧
    2 ^ 11 * Real.log D.N ^ 2 / D.δ ^ 27 ≤ d0P D.N ∧
    8 * D.k * d0P D.N ^ 10 ≤ D.P₁' ∧ (8 * D.k) ^ 4 ≤ D.P₁' ∧
    1 ≤ rhoP D.δ D.k ^ 4 * D.P₁' ∧
    80 * (D.k : ℝ) / D.δ ^ 21 ≤ Nat.sqrt D.P₁' := by
  obtain ⟨hZ20, hRZ, hΛZ, hδZ, hkZ⟩ := ZP_facts D hΛ
  set Z := ZP D.N with hZdef
  have hδ := D.hδ
  have hk := D.hk
  have hZ1 : 1 ≤ Z := le_trans (by norm_num) hZ20
  have hZ0 : 0 ≤ Z := le_trans (by norm_num) hZ20
  have hw0 : 0 ≤ 1 / D.δ := by positivity
  have hpow : ∀ m : ℕ, m ≤ 1512 → Z ^ m ≤ D.P₁' := fun m hm =>
    (pow_le_pow_right₀ hZ1 hm).trans hZP
  have h8k : (8 * D.k : ℝ) ≤ Z ^ 2 := by
    calc (8 * D.k : ℝ) ≤ Z * Z := mul_le_mul (by linarith) hkZ (Nat.cast_nonneg _) hZ0
      _ = Z ^ 2 := by ring
  have hV := V0P_le_Z hδ hZ20 hRZ hδZ
  have hdge := d0P_ge D.N
  have hdle := d0P_le (N := D.N) (by linarith)
  have hZ150 : Z ≤ Z ^ 150 := by
    calc Z = Z ^ 1 := (pow_one Z).symm
      _ ≤ Z ^ 150 := pow_le_pow_right₀ hZ1 (by norm_num)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `V₀² ≤ Z^{146} ≤ d₀`
    have : ((V0P D.δ ^ 2 : ℕ) : ℝ) ≤ d0P D.N := by
      push_cast
      calc (V0P D.δ : ℝ) ^ 2 ≤ (Z ^ 73) ^ 2 := pow_le_pow_left₀ (Nat.cast_nonneg _) hV 2
        _ = Z ^ 146 := by ring
        _ ≤ Z ^ 150 := pow_le_pow_right₀ hZ1 (by norm_num)
        _ ≤ d0P D.N := hdge
    exact_mod_cast this
  · have : (3 : ℝ) ≤ d0P D.N := by linarith
    exact_mod_cast this
  · -- `2¹¹ Λ² / δ²⁷ ≤ Z³⁰ ≤ d₀`
    have e : 2 ^ 11 * Real.log D.N ^ 2 / D.δ ^ 27 = 2 ^ 11 * Real.log D.N ^ 2 * (1 / D.δ) ^ 27 := by
      rw [one_div_pow]; ring
    rw [e]
    have hΛ0 : 0 ≤ Real.log D.N := by linarith
    calc 2 ^ 11 * Real.log D.N ^ 2 * (1 / D.δ) ^ 27 ≤ Z * Z ^ 2 * Z ^ 27 := by
          gcongr; linarith
      _ = Z ^ 30 := by ring
      _ ≤ Z ^ 150 := pow_le_pow_right₀ hZ1 (by norm_num)
      _ ≤ d0P D.N := hdge
  · -- `8k d₀^{10} ≤ Z^{1512} ≤ P'₁`
    have : ((8 * D.k * d0P D.N ^ 10 : ℕ) : ℝ) ≤ D.P₁' := by
      push_cast
      calc (8 * D.k : ℝ) * (d0P D.N : ℝ) ^ 10 ≤ Z ^ 2 * (Z ^ 151) ^ 10 := by
            gcongr
        _ = Z ^ 1512 := by ring
        _ ≤ D.P₁' := hZP
    exact_mod_cast this
  · -- `(8k)⁴ ≤ Z⁸ ≤ P'₁`
    have : (((8 * D.k) ^ 4 : ℕ) : ℝ) ≤ D.P₁' := by
      push_cast
      calc (8 * D.k : ℝ) ^ 4 ≤ (Z ^ 2) ^ 4 := pow_le_pow_left₀ (by positivity) h8k 4
        _ = Z ^ 8 := by ring
        _ ≤ D.P₁' := hpow 8 (by norm_num)
    exact_mod_cast this
  · -- `ρ⁴ P'₁ ≥ ρ⁴ (819200k)⁴ δ^{-108} = 1`
    have hk0 : (0 : ℝ) < D.k := by exact_mod_cast hk
    have hbig : (819200 * (D.k : ℝ)) ^ 4 * (1 / D.δ) ^ 108 ≤ D.P₁' := by
      calc (819200 * (D.k : ℝ)) ^ 4 * (1 / D.δ) ^ 108 ≤ (Z * Z) ^ 4 * Z ^ 108 := by
            gcongr; linarith
        _ = Z ^ 116 := by ring
        _ ≤ D.P₁' := hpow 116 (by norm_num)
    have hρ4 : rhoP D.δ D.k ^ 4 * ((819200 * (D.k : ℝ)) ^ 4 * (1 / D.δ) ^ 108) = 1 := by
      unfold rhoP; field_simp
    calc (1 : ℝ) = rhoP D.δ D.k ^ 4 * ((819200 * (D.k : ℝ)) ^ 4 * (1 / D.δ) ^ 108) := hρ4.symm
      _ ≤ rhoP D.δ D.k ^ 4 * D.P₁' :=
          mul_le_mul_of_nonneg_left hbig (by have := rhoP_pos hδ hk; positivity)
  · -- `80k/δ²¹ + 1 ≤ Z²⁴` and `Z⁴⁸ ≤ P'₁`, so `80k/δ²¹ < √P'₁ - 1 < ⌊√P'₁⌋`
    set X := 80 * (D.k : ℝ) / D.δ ^ 21 with hX
    have hX0 : 0 ≤ X := by positivity
    have hXZ : X ≤ Z ^ 23 := by
      have e : X = 80 * (D.k : ℝ) * (1 / D.δ) ^ 21 := by rw [hX, one_div_pow]; ring
      rw [e]
      calc 80 * (D.k : ℝ) * (1 / D.δ) ^ 21 ≤ Z * Z * Z ^ 21 := by
            gcongr; linarith
        _ = Z ^ 23 := by ring
    have hX1 : X + 1 ≤ Z ^ 24 := by
      have : 1 ≤ Z ^ 23 := one_le_pow₀ hZ1
      have : Z ^ 24 = Z * Z ^ 23 := by ring
      nlinarith
    have hsq : X + 1 ≤ Real.sqrt D.P₁' := by
      rw [Real.le_sqrt (by linarith) (Nat.cast_nonneg _)]
      calc (X + 1) ^ 2 ≤ (Z ^ 24) ^ 2 := pow_le_pow_left₀ (by linarith) hX1 2
        _ = Z ^ 48 := by ring
        _ ≤ D.P₁' := hpow 48 (by norm_num)
    have := Real.real_sqrt_lt_nat_sqrt_succ (a := D.P₁')
    linarith

/-- The output bounds: `V₀ ≤ δ^{-108}` and `W = 2V₀/(ρ√(2δ⁷)) ≤ δ^{-108}` for
`δ ≤ 1/(2⁷² C_R²)` (using `k ≤ δ^{-10}`, `√(2δ⁷) ≥ δ⁴`, `V₀ ≤ 2⁵¹ C_R² δ^{-66}`). -/
lemma out_bounds {δ : ℝ} {k : ℕ} (hδ : 0 < δ) (hδ₀ : δ ≤ 1 / (2 ^ 72 * FPDQ.CR ^ 2))
    (hk : 1 ≤ k) (hkδ : (k : ℝ) ≤ (1 / δ) ^ 10) :
    (V0P δ : ℝ) ≤ (1 / δ) ^ 108 ∧
      2 * (V0P δ : ℝ) / (rhoP δ k * Real.sqrt (2 * δ ^ 7)) ≤ (1 / δ) ^ 108 := by
  have hR := CR_one_le
  have hR0 : 0 < FPDQ.CR := FPDQ.CR_pos
  set w := 1 / δ with hw
  have hw0 : 0 < w := by positivity
  have hAw : 2 ^ 72 * FPDQ.CR ^ 2 ≤ w := by
    have hA : 0 < 2 ^ 72 * FPDQ.CR ^ 2 := by positivity
    rw [hw, le_div_iff₀ hδ]
    rw [le_div_iff₀ hA] at hδ₀
    linarith
  have hR2 : 1 ≤ FPDQ.CR ^ 2 := one_le_pow₀ hR
  have hw1 : 1 ≤ w := by
    have : (1 : ℝ) ≤ 2 ^ 72 * FPDQ.CR ^ 2 := by nlinarith
    linarith
  -- `V₀ ≤ 2⁵¹ C_R² w⁶⁶`
  have hV : (V0P δ : ℝ) ≤ 2 ^ 51 * FPDQ.CR ^ 2 * w ^ 66 := by
    have h1 := V0P_lt δ
    have e : (2 ^ 25 * FPDQ.CR / δ ^ 33) ^ 2 = 2 ^ 50 * FPDQ.CR ^ 2 * w ^ 66 := by
      rw [hw, one_div_pow]; field_simp
    have h2 : 1 ≤ 2 ^ 50 * FPDQ.CR ^ 2 * w ^ 66 := by
      have h3 : 1 ≤ w ^ 66 := one_le_pow₀ hw1
      calc (1 : ℝ) = 1 * 1 * 1 := by ring
        _ ≤ 2 ^ 50 * FPDQ.CR ^ 2 * w ^ 66 := by gcongr; norm_num
    rw [e] at h1
    linarith
  have hw66 : 2 ^ 51 * FPDQ.CR ^ 2 * w ^ 66 ≤ w ^ 108 := by
    have : 2 ^ 51 * FPDQ.CR ^ 2 ≤ w := le_trans (by nlinarith) hAw
    calc 2 ^ 51 * FPDQ.CR ^ 2 * w ^ 66 ≤ w * w ^ 66 := by gcongr
      _ = w ^ 67 := by ring
      _ ≤ w ^ 108 := pow_le_pow_right₀ hw1 (by norm_num)
  refine ⟨hV.trans hw66, ?_⟩
  -- `W ≤ 2V₀/(ρ δ⁴) = 1638400 k V₀ w³¹`
  have hρ := rhoP_pos hδ hk
  have hk0 : (0 : ℝ) < k := by exact_mod_cast hk
  have hs : δ ^ 4 ≤ Real.sqrt (2 * δ ^ 7) := by
    rw [Real.le_sqrt (by positivity) (by positivity)]
    have hδ1 : δ ≤ 1 := by
      have : δ * w = 1 := by rw [hw]; field_simp
      nlinarith
    have : δ ^ 8 ≤ 2 * δ ^ 7 := by
      have e : δ ^ 8 = δ * δ ^ 7 := by ring
      have := pow_pos hδ 7
      nlinarith
    calc (δ ^ 4) ^ 2 = δ ^ 8 := by ring
      _ ≤ 2 * δ ^ 7 := this
  have hW1 : 2 * (V0P δ : ℝ) / (rhoP δ k * Real.sqrt (2 * δ ^ 7)) ≤
      2 * (V0P δ : ℝ) / (rhoP δ k * δ ^ 4) :=
    div_le_div_of_nonneg_left (by positivity) (by positivity)
      (mul_le_mul_of_nonneg_left hs hρ.le)
  have hW2 : 2 * (V0P δ : ℝ) / (rhoP δ k * δ ^ 4) = 1638400 * k * V0P δ * w ^ 31 := by
    unfold rhoP; rw [hw, one_div_pow]; field_simp; ring
  have hW3 : 1638400 * (k : ℝ) * V0P δ * w ^ 31 ≤ w ^ 108 := by
    have hV0 : (0 : ℝ) ≤ V0P δ := Nat.cast_nonneg _
    calc 1638400 * (k : ℝ) * V0P δ * w ^ 31 ≤
          1638400 * w ^ 10 * (2 ^ 51 * FPDQ.CR ^ 2 * w ^ 66) * w ^ 31 := by
          gcongr
      _ = (1638400 * 2 ^ 51) * FPDQ.CR ^ 2 * w ^ 107 := by ring
      _ ≤ (2 ^ 72 * FPDQ.CR ^ 2) * w ^ 107 := by gcongr; norm_num
      _ ≤ w * w ^ 107 := by gcongr
      _ = w ^ 108 := by ring
  rw [hW2] at hW1
  exact hW1.trans hW3

/-- `16Y² ≤ δ¹⁰⁸ T` implies `16Y² < T √(2δ⁷)` (as `δ¹⁰⁸ ≤ δ⁴ < √(2δ⁷)` and `T > 0`). -/
lemma hT_of {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) {Y T : ℕ} (hY : 1 ≤ Y)
    (h : 16 * (Y : ℝ) ^ 2 ≤ δ ^ 108 * T) : 16 * (Y : ℝ) ^ 2 < T * Real.sqrt (2 * δ ^ 7) := by
  have hY1 : (1 : ℝ) ≤ Y := by exact_mod_cast hY
  have hY0 : (0 : ℝ) < 16 * (Y : ℝ) ^ 2 := by positivity
  have hT0 : (0 : ℝ) < T := by
    by_contra hT
    push Not at hT
    have : (T : ℝ) = 0 := le_antisymm hT (Nat.cast_nonneg _)
    rw [this, mul_zero] at h
    linarith
  have h1 : δ ^ 108 ≤ δ ^ 4 := pow_le_pow_of_le_one hδ.le hδ1 (by norm_num)
  have h2 : δ ^ 4 < Real.sqrt (2 * δ ^ 7) := by
    rw [Real.lt_sqrt (by positivity)]
    have : δ ^ 8 < 2 * δ ^ 7 := by
      have e : δ ^ 8 = δ * δ ^ 7 := by ring
      have := pow_pos hδ 7
      nlinarith
    calc (δ ^ 4) ^ 2 = δ ^ 8 := by ring
      _ < 2 * δ ^ 7 := this
  calc 16 * (Y : ℝ) ^ 2 ≤ δ ^ 108 * T := h
    _ ≤ δ ^ 4 * T := mul_le_mul_of_nonneg_right h1 hT0.le
    _ < Real.sqrt (2 * δ ^ 7) * T := mul_lt_mul_of_pos_right h2 hT0
    _ = T * Real.sqrt (2 * δ ^ 7) := by ring

end P6f

open P6f in
/-- **Step P6f** (review §9.1 Lemma R + Lemma Q, §9.4.6): the squares of a `Good6` box have the FPD
property `SqFPD` with `A' = 108`, `δ₀ = 1/(2⁷² C_R²)`. -/
theorem stepP6f : StepP6f := by
  have hR := CR_one_le
  obtain ⟨N₀, hN₀⟩ := growth (2 ^ 20 * FPDQ.CR) (by nlinarith) 1512
  have hR0 := FPDQ.CR_pos
  refine ⟨108, 1 / (2 ^ 72 * FPDQ.CR ^ 2), by positivity, N₀, ?_⟩
  intro D hδ₀ hN a b hab e c he T hT
  obtain ⟨hΛ, hZP⟩ := hN₀ D hN
  have hδ := D.hδ
  have hk := D.hk
  have hδ1 : D.δ ≤ 1 := by
    have : 1 / (2 ^ 72 * FPDQ.CR ^ 2) ≤ 1 := by
      rw [div_le_one (by positivity)]
      have : 1 ≤ FPDQ.CR ^ 2 := one_le_pow₀ hR
      nlinarith
    linarith
  have hZP' : ZP D.N ^ 1512 ≤ D.P₁' := hZP
  obtain ⟨hVd, hd₀3, hd₀Λ, hd₀P, hkP, hρP, hT2⟩ := large_facts D hΛ hZP'
  have hY1 : 1 ≤ ∏ ℓ, a ℓ := by
    have hP3 := D.hP₁'
    have : 0 < ∏ ℓ, a ℓ := Finset.prod_pos (fun ℓ _ => by
      have := ((D.hI ℓ).1).trans (hab.1 ℓ).1
      omega)
    omega
  have hT' := hT_of hδ hδ1 hY1 hT
  have hcore := core D a b hab (rhoP_pos hδ hk) (rhoP_le_one hδ hδ1 hk) (V0P_pos hδ) hVd hd₀3
    hΛ (logP₂'_le D hΛ) hd₀Λ hd₀P hkP hρP (T1_eq hδ hk).le hT2 (T3_le hδ) c hT'
  obtain ⟨hQ, hW⟩ := out_bounds hδ hδ₀ hk D.hkδ
  have hfin := fpd_mono hcore hQ hW
  rcases he with rfl | rfl
  · have e1 : ((almostPrimes a b).image fun x : ℕ => (1 : ℤ) * ((x : ℤ) ^ 2 - c)) =
        (almostPrimes a b).image (fun x : ℕ => (x : ℤ) ^ 2 - c) := by
      simp only [one_mul]
    rw [e1]
    exact hfin
  · have e1 : ((almostPrimes a b).image fun x : ℕ => (-1 : ℤ) * ((x : ℤ) ^ 2 - c)) =
        ((almostPrimes a b).image (fun x : ℕ => (x : ℤ) ^ 2 - c)).image (fun s => -s) := by
      rw [Finset.image_image]
      congr 1
      funext x
      simp
    rw [e1]
    exact fpd_image_neg hfin

end G22.P51

end

/- ## Section: `P51GlueP5` -/

section

/-
# GlueP5: step P5 of GS Proposition 5.1 from P5a, P5b and P5e

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, pp. 17–18 ("(5.9) cannot hold").

`glueP5 : GlueP5`, i.e. `StepP5a → StepP5b → StepP5e → StepP5`. The exponent `A` of `StepP5` is
the `A` of P5e. Given `c', C, E, C₂ ≥ 16A`, put `Cp = max C 1`, `τ₁ = min τ₀ 1` (`τ₀` from P5e) and
* `δ₀ = min(δ₀(P5a), 1/2, c'/2, τ₁/(128 Cp), 1/y₀)`, where `y₀` comes from `log_pow_bound`
  (so that `2 + Cp (C₂ log(1/δ))¹² ≤ 1/δ`);
* `N₀ = max(N₀(P5a), N₀(P5b), N₀(P5e), N₀')`, where `N₀'` comes from `P6f.growth` with the
  constant `64 Cp/τ₁` and the exponent `(E + 3)A` (so `P'₁^{1/A} ≥ (64 Cp log N/τ₁)^{E+3}`).

Proof (by contradiction). For `ψ = Λ̃ - Λ_per`, `E|ψ| ≤ 2 + Cp log¹² Q ≤ 1/δ` (`psi_avg_le`), and
`c'δ²/2 ≥ δ³`, so P5a and P5b give `δ³/16 ≤ |lhs14(ψ)|`. `lhs14` is linear in `ψ`
(`lhs14_add`, `lhs14_sum`, `lhs14_smul`) and `|lhs14(ψ)| ≤ E|ψ|` (`abs_lhs14_le`); hence
`|lhs14(h)| ≤ Cp/Q` and, by P5e applied to `gᵢ/Mᵢ` (`term_bound`, with `s = P'₁^{1/A}`),
`|lhs14(gᵢ)| ≤ τ₁⁻¹ Fᵢ^{1/A} Mᵢ^{1-1/A} / X^{1/A} + Mᵢ/s`. Summing with (4.5), (4.6)
(`sum_term_bound`) gives `|lhs14(ψ)| ≤ τ₁⁻¹ Cp Q^{-1/(4A)} + Cp log^E X / s + Cp/Q`, and each term is
`≤ δ³/64` (`first_term` with `Q_rpow_le`, `second_term`, `inv_Q_le`): a contradiction.
-/

open Finset Real

namespace G22.P51

namespace GlueP5

/- ## Uniform averages -/

section favg

variable {α : Type*}

lemma favg_eq (s : Finset α) (f : α → ℝ) : favg s f = (∑ x ∈ s, f x) / s.card := by
  simp [favg, wavg]

lemma abs_favg_le (s : Finset α) (f : α → ℝ) : |favg s f| ≤ favg s (fun x => |f x|) := by
  rw [favg_eq, favg_eq, abs_div, Nat.abs_cast]
  exact div_le_div_of_nonneg_right (Finset.abs_sum_le_sum_abs _ _) (Nat.cast_nonneg _)

lemma favg_mono (s : Finset α) {f g : α → ℝ} (h : ∀ x ∈ s, f x ≤ g x) :
    favg s f ≤ favg s g := by
  rw [favg_eq, favg_eq]
  exact div_le_div_of_nonneg_right (Finset.sum_le_sum h) (Nat.cast_nonneg _)

lemma favg_nonneg (s : Finset α) {f : α → ℝ} (h : ∀ x ∈ s, 0 ≤ f x) : 0 ≤ favg s f := by
  rw [favg_eq]
  exact div_nonneg (Finset.sum_nonneg h) (Nat.cast_nonneg _)

lemma favg_le_const (s : Finset α) {f : α → ℝ} {c : ℝ} (hc : 0 ≤ c) (h : ∀ x ∈ s, f x ≤ c) :
    favg s f ≤ c := by
  rw [favg_eq]
  rcases s.eq_empty_or_nonempty with rfl | hs
  · simp [hc]
  · rw [div_le_iff₀ (by exact_mod_cast hs.card_pos)]
    calc ∑ x ∈ s, f x ≤ ∑ _x ∈ s, c := Finset.sum_le_sum h
      _ = c * s.card := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]

lemma abs_favg_le_of (s : Finset α) {f : α → ℝ} {c : ℝ} (hc : 0 ≤ c)
    (h : ∀ x ∈ s, |f x| ≤ c) : |favg s f| ≤ c :=
  (abs_favg_le s f).trans (favg_le_const s hc h)

lemma card_win (X : ℕ) : (win X).card = X := by
  simp only [win, Int.card_Ico]
  omega

lemma favg_win (X : ℕ) (f : ℤ → ℝ) : favg (win X) f = (∑ x ∈ win X, f x) / X := by
  rw [favg_eq, card_win]

end favg

/- ## Linearity and size of `lhs14` in `ψ` -/

section lhs14

variable (f₁ : ℤ → ℝ) (lam X : ℕ) (B₁ B₂ : Finset ℕ) (ρ : ℕ → ℕ → ℝ) (u : ℤ) (L : ℕ)

lemma lhs14_add (ψ₁ ψ₂ : ℤ → ℝ) :
    lhs14 f₁ (fun x => ψ₁ x + ψ₂ x) lam X B₁ B₂ ρ u L =
      lhs14 f₁ ψ₁ lam X B₁ B₂ ρ u L + lhs14 f₁ ψ₂ lam X B₁ B₂ ρ u L := by
  simp only [lhs14, favg, add_mul, wavg_add, mul_add]

lemma lhs14_smul (c : ℝ) (ψ : ℤ → ℝ) :
    lhs14 f₁ (fun x => c * ψ x) lam X B₁ B₂ ρ u L = c * lhs14 f₁ ψ lam X B₁ B₂ ρ u L := by
  simp only [lhs14, favg, mul_assoc, wavg_smul, mul_left_comm (ρ _ _) c]

lemma lhs14_sum {ι : Type*} (t : Finset ι) (G : ι → ℤ → ℝ) :
    lhs14 f₁ (fun x => ∑ i ∈ t, G i x) lam X B₁ B₂ ρ u L =
      ∑ i ∈ t, lhs14 f₁ (G i) lam X B₁ B₂ ρ u L := by
  simp only [lhs14, favg, Finset.sum_mul, wavg_sum, Finset.mul_sum]

variable {f₁ ρ}

lemma abs_lhs14_le (hf : ∀ n, |f₁ n| ≤ 1) (hρ : ∀ s t, |ρ s t| ≤ 1) (ψ : ℤ → ℝ) :
    |lhs14 f₁ ψ lam X B₁ B₂ ρ u L| ≤ favg (win X) (fun x => |ψ x|) := by
  have hnn : 0 ≤ favg (win X) (fun x => |ψ x|) :=
    favg_nonneg _ fun x _ => abs_nonneg _
  unfold lhs14
  refine abs_favg_le_of _ hnn fun p₁ _ => abs_favg_le_of _ hnn fun p₂ _ => ?_
  rw [abs_mul]
  have hin : |favg (win X) (fun x => ψ x *
      favg (Finset.Ico u (u + L)) fun n =>
        f₁ (n * p₂ + (lam : ℤ) * x * p₁) * f₁ (n * p₁ + (lam : ℤ) * x * p₂))| ≤
        favg (win X) (fun x => |ψ x|) := by
    refine (abs_favg_le _ _).trans (favg_mono _ fun x _ => ?_)
    rw [abs_mul]
    have hI : |favg (Finset.Ico u (u + L)) fun n =>
        f₁ (n * p₂ + (lam : ℤ) * x * p₁) * f₁ (n * p₁ + (lam : ℤ) * x * p₂)| ≤ 1 :=
      abs_favg_le_of _ zero_le_one fun n _ => by
        rw [abs_mul]; exact mul_le_one₀ (hf _) (abs_nonneg _) (hf _)
    calc |ψ x| * _ ≤ |ψ x| * 1 := mul_le_mul_of_nonneg_left hI (abs_nonneg _)
      _ = |ψ x| := mul_one _
  calc |ρ p₁ p₂| * _ ≤ 1 * favg (win X) (fun x => |ψ x|) :=
        mul_le_mul (hρ _ _) hin (abs_nonneg _) zero_le_one
    _ = _ := one_mul _

end lhs14

/- ## Exponential sums -/

lemma norm_expSum_smul_le (X : ℕ) (g : ℤ → ℝ) {c F : ℝ} (hc : 0 ≤ c) (θ : ℝ)
    (hF : ‖∑ x ∈ Finset.Ico (X : ℤ) (2 * X), (g x : ℂ) * FPD.ee (θ * x)‖ ≤ F) :
    ‖expSum X (fun x => c * g x) θ‖ ≤ c * F := by
  have h : expSum X (fun x => c * g x) θ =
      (c : ℂ) * ∑ x ∈ Finset.Ico (X : ℤ) (2 * X), (g x : ℂ) * FPD.ee (θ * x) := by
    unfold expSum win
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun x _ => ?_
    push_cast
    ring
  rw [h, norm_mul, Complex.norm_real, Real.norm_of_nonneg hc]
  exact mul_le_mul_of_nonneg_left hF hc

/- ## The level `Q = ⌊δ^{-C₂}⌋` -/

lemma one_div_delta_ge (D : Data) (hδ : D.δ ≤ 1 / 2) : 2 ≤ 1 / D.δ := by
  rw [le_div_iff₀ D.hδ]; linarith

lemma Q_facts (D : Data) {C₂ : ℕ} (hC₂ : 1 ≤ C₂) (hδ : D.δ ≤ 1 / 2) :
    (1 / D.δ) ^ C₂ / 2 ≤ (D.Q C₂ : ℝ) ∧ (D.Q C₂ : ℝ) ≤ (1 / D.δ) ^ C₂ := by
  have hy := one_div_delta_ge D hδ
  have hy2 : 2 ≤ (1 / D.δ) ^ C₂ :=
    calc (2 : ℝ) ≤ 1 / D.δ := hy
      _ = (1 / D.δ) ^ 1 := (pow_one _).symm
      _ ≤ (1 / D.δ) ^ C₂ := pow_le_pow_right₀ (by linarith) hC₂
  refine ⟨?_, Nat.floor_le (by positivity)⟩
  have := Nat.lt_floor_add_one ((1 / D.δ) ^ C₂)
  unfold Data.Q
  linarith

lemma one_le_Q (D : Data) {C₂ : ℕ} (hC₂ : 1 ≤ C₂) (hδ : D.δ ≤ 1 / 2) : (1 : ℝ) ≤ D.Q C₂ := by
  have hy := one_div_delta_ge D hδ
  have hy2 : 2 ≤ (1 / D.δ) ^ C₂ :=
    calc (2 : ℝ) ≤ 1 / D.δ := hy
      _ = (1 / D.δ) ^ 1 := (pow_one _).symm
      _ ≤ (1 / D.δ) ^ C₂ := pow_le_pow_right₀ (by linarith) hC₂
  have := (Q_facts D hC₂ hδ).1
  linarith

/-- `Q^{-1/(4A)} ≤ 2δ⁴` for `C₂ ≥ 16A`. -/
lemma Q_rpow_le (D : Data) {A C₂ : ℕ} (hA : 1 ≤ A) (hC₂ : 16 * A ≤ C₂) (hδ : D.δ ≤ 1 / 2) :
    (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) ≤ 2 * D.δ ^ 4 := by
  have hC₂1 : 1 ≤ C₂ := by omega
  obtain ⟨hQlo, -⟩ := Q_facts D hC₂1 hδ
  have hQ1 := one_le_Q D hC₂1 hδ
  have hy := one_div_delta_ge D hδ
  set y : ℝ := 1 / D.δ with hydef
  have hy1 : 1 ≤ y := by linarith
  have hApos : (0 : ℝ) < A := by exact_mod_cast hA
  set a : ℝ := 1 / (A : ℝ) / 4 with hadef
  have ha0 : 0 ≤ a := by positivity
  have ha1 : a ≤ 1 := by
    rw [hadef, div_le_one (by norm_num), div_le_iff₀ hApos]
    have : (1 : ℝ) ≤ A := by exact_mod_cast hA
    linarith
  have hC₂a : (4 : ℝ) ≤ (C₂ : ℝ) * a := by
    have hC₂r : (16 : ℝ) * A ≤ C₂ := by exact_mod_cast hC₂
    rw [hadef, show (C₂ : ℝ) * (1 / A / 4) = C₂ / (4 * A) by ring, le_div_iff₀ (by positivity)]
    linarith
  have h1 : (y ^ C₂ / 2) ^ a ≤ (D.Q C₂ : ℝ) ^ a := Real.rpow_le_rpow (by positivity) hQlo ha0
  have h2 : (y ^ C₂ / 2) ^ a = (y ^ C₂) ^ a / 2 ^ a := Real.div_rpow (by positivity) (by norm_num) a
  have h3 : (y ^ C₂) ^ a = y ^ ((C₂ : ℝ) * a) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by linarith)]
  have h4 : y ^ ((4 : ℕ) : ℝ) ≤ y ^ ((C₂ : ℝ) * a) :=
    Real.rpow_le_rpow_of_exponent_le hy1 (by exact_mod_cast hC₂a)
  rw [Real.rpow_natCast] at h4
  have h5 : (2 : ℝ) ^ a ≤ 2 :=
    calc (2 : ℝ) ^ a ≤ 2 ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) ha1
      _ = 2 := Real.rpow_one 2
  have h6 : (0 : ℝ) < 2 ^ a := Real.rpow_pos_of_pos (by norm_num) a
  have hQa : y ^ 4 / 2 ≤ (D.Q C₂ : ℝ) ^ a := by
    calc y ^ 4 / 2 ≤ y ^ ((C₂ : ℝ) * a) / 2 ^ a := by
          rw [div_le_div_iff₀ (by norm_num) h6]
          have : 0 ≤ y ^ 4 := by positivity
          nlinarith
      _ = (y ^ C₂ / 2) ^ a := by rw [h2, h3]
      _ ≤ _ := h1
  have hy4 : 0 < y ^ 4 / 2 := by positivity
  rw [Real.rpow_neg (by linarith)]
  calc ((D.Q C₂ : ℝ) ^ a)⁻¹ ≤ (y ^ 4 / 2)⁻¹ := inv_anti₀ hy4 hQa
    _ = 2 * D.δ ^ 4 := by
      rw [hydef]
      have := D.hδ
      field_simp

/-- `1/Q ≤ Q^{-1/(4A)}`. -/
lemma inv_Q_le (D : Data) {A C₂ : ℕ} (hA : 1 ≤ A) (hC₂ : 16 * A ≤ C₂) (hδ : D.δ ≤ 1 / 2) :
    1 / (D.Q C₂ : ℝ) ≤ (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) := by
  have hQ1 := one_le_Q D (by omega : 1 ≤ C₂) hδ
  have hApos : (0 : ℝ) < A := by exact_mod_cast hA
  have ha1 : 1 / (A : ℝ) / 4 ≤ 1 := by
    rw [div_le_one (by norm_num), div_le_iff₀ hApos]
    have : (1 : ℝ) ≤ A := by exact_mod_cast hA
    linarith
  rw [Real.rpow_neg (by linarith), one_div]
  have hpos : 0 < (D.Q C₂ : ℝ) ^ (1 / (A : ℝ) / 4) := Real.rpow_pos_of_pos (by linarith) _
  apply inv_anti₀ hpos
  calc (D.Q C₂ : ℝ) ^ (1 / (A : ℝ) / 4) ≤ (D.Q C₂ : ℝ) ^ (1 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le hQ1 ha1
    _ = D.Q C₂ := Real.rpow_one _

/- ## Growth of `1/δ` against powers of its logarithm -/

lemma log_pow_bound (K : ℝ) :
    ∃ y₀ : ℝ, 0 < y₀ ∧ ∀ y : ℝ, y₀ ≤ y → 2 + K * Real.log y ^ 12 ≤ y := by
  set K' : ℝ := max K 1 with hK'
  have hK'1 : 1 ≤ K' := le_max_right _ _
  have hb := (Real.isLittleO_pow_log_id_atTop (n := 12)).bound
    (c := 1 / (2 * K')) (by positivity)
  obtain ⟨y₁, hy₁⟩ := Filter.eventually_atTop.mp (hb.and (Filter.eventually_ge_atTop (4 : ℝ)))
  refine ⟨max y₁ 4, by positivity, fun y hy => ?_⟩
  obtain ⟨h1, h2⟩ := hy₁ y (le_trans (le_max_left _ _) hy)
  have hy0 : 0 ≤ y := by linarith
  have hL : 0 ≤ Real.log y ^ 12 := by positivity
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hL, id, abs_of_nonneg hy0] at h1
  have : K * Real.log y ^ 12 ≤ y / 2 := by
    calc K * Real.log y ^ 12 ≤ K' * Real.log y ^ 12 :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) hL
      _ ≤ K' * (1 / (2 * K') * y) := mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = y / 2 := by field_simp
  linarith

/- ## The homogeneity step (GS p. 18) -/

/-- From P5e applied to `g/M`: `|lhs14(g)| ≤ τ₀⁻¹ X^{-1/A} F^{1/A} M^{1-1/A} + P'₁^{-1/A} M`
(here `s = P'₁^{1/A}`, `ℓ = lhs14(g)`, `Xr = X`). -/
lemma term_bound {A : ℕ} (hA : 1 ≤ A) {τ₀ s M F Xr ℓ : ℝ} (hτ₀ : 0 < τ₀) (hτ₀1 : τ₀ ≤ 1)
    (hs : 0 < s) (hsτ : s⁻¹ ≤ τ₀) (hM : 0 ≤ M) (hF : 0 ≤ F) (hX : 0 < Xr) (hℓM : |ℓ| ≤ M)
    (hP5e : 0 < M → ∀ τ : ℝ, 0 < τ → τ ≤ τ₀ → 1 ≤ τ ^ A * s ^ A → τ ≤ |ℓ| / M →
      τ ^ A * Xr ≤ F / M) :
    |ℓ| ≤ τ₀⁻¹ * (F ^ (1 / (A : ℝ)) * M ^ (1 - 1 / (A : ℝ))) / Xr ^ (1 / (A : ℝ)) + M / s := by
  set a : ℝ := 1 / (A : ℝ) with ha
  have hApos : (0 : ℝ) < A := by exact_mod_cast hA
  have ha0 : 0 < a := by positivity
  have hT1 : 0 ≤ τ₀⁻¹ * (F ^ a * M ^ (1 - a)) / Xr ^ a := by positivity
  have hT2 : 0 ≤ M / s := div_nonneg hM hs.le
  rcases hM.eq_or_lt with hM0 | hMpos
  · rw [← hM0] at hℓM
    have := abs_nonneg ℓ
    rw [← hM0]
    have h0 : 0 ≤ τ₀⁻¹ * (F ^ a * (0 : ℝ) ^ (1 - a)) / Xr ^ a + 0 / s := by
      rw [hM0]; linarith
    linarith
  set t := |ℓ| / M with ht
  have hℓt : |ℓ| = M * t := by rw [ht]; field_simp
  have ht0 : 0 ≤ t := div_nonneg (abs_nonneg _) hM
  have ht1 : t ≤ 1 := by rw [ht, div_le_one hMpos]; exact hℓM
  by_cases hts : t ≤ s⁻¹
  · calc |ℓ| = M * t := hℓt
      _ ≤ M * s⁻¹ := mul_le_mul_of_nonneg_left hts hM
      _ = M / s := (div_eq_mul_inv M s).symm
      _ ≤ _ := le_add_of_nonneg_left hT1
  · have hts : s⁻¹ < t := lt_of_not_ge hts
    set τ := min t τ₀ with hτ
    have hsinv : 0 < s⁻¹ := inv_pos.mpr hs
    have hτpos : 0 < τ := lt_min (hsinv.trans hts) hτ₀
    have hτle : τ ≤ τ₀ := min_le_right _ _
    have hτs : s⁻¹ ≤ τ := le_min hts.le hsτ
    have hτA : 1 ≤ τ ^ A * s ^ A := by
      rw [← mul_pow]
      apply one_le_pow₀
      calc (1 : ℝ) = s⁻¹ * s := (inv_mul_cancel₀ hs.ne').symm
        _ ≤ τ * s := mul_le_mul_of_nonneg_right hτs hs.le
    have hτt : τ ≤ t := min_le_left _ _
    have key := hP5e hMpos τ hτpos hτle hτA hτt
    have hR : τ ^ A ≤ F / (M * Xr) := by
      rw [le_div_iff₀ (mul_pos hMpos hX)]
      rw [le_div_iff₀ hMpos] at key
      linarith
    have hτR : τ ≤ (F / (M * Xr)) ^ a := by
      have h1 : τ = (τ ^ A) ^ a := by
        rw [ha, one_div, Real.pow_rpow_inv_natCast hτpos.le (by omega)]
      rw [h1]
      exact Real.rpow_le_rpow (by positivity) hR ha0.le
    have hτ₀t : τ₀ * t ≤ τ := le_min (by nlinarith) (by nlinarith)
    have hid : M * (F / (M * Xr)) ^ a = F ^ a * M ^ (1 - a) / Xr ^ a := by
      rw [Real.div_rpow hF (by positivity), Real.mul_rpow hM hX.le, Real.rpow_sub hMpos,
        Real.rpow_one]
      have : 0 < M ^ a := Real.rpow_pos_of_pos hMpos a
      have : 0 < Xr ^ a := Real.rpow_pos_of_pos hX a
      field_simp
    calc |ℓ| = M * t := hℓt
      _ = τ₀⁻¹ * (M * (τ₀ * t)) := by field_simp
      _ ≤ τ₀⁻¹ * (M * (F / (M * Xr)) ^ a) := by
          apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr hτ₀.le)
          exact mul_le_mul_of_nonneg_left (hτ₀t.trans hτR) hM
      _ = τ₀⁻¹ * (F ^ a * M ^ (1 - a)) / Xr ^ a := by rw [hid]; ring
      _ ≤ _ := le_add_of_nonneg_right hT2

/-- Summing `term_bound` over `i < n` with (4.5) and (4.6). -/
lemma sum_term_bound {n : ℕ} {ℓ M F : ℕ → ℝ} {a τ₀ s Xa K₁ K₂ : ℝ} (hτ₀ : 0 < τ₀) (hXa : 0 < Xa)
    (hs : 0 < s)
    (h : ∀ i ∈ range n, |ℓ i| ≤ τ₀⁻¹ * (F i ^ a * M i ^ (1 - a)) / Xa + M i / s)
    (h1 : ∑ i ∈ range n, F i ^ a * M i ^ (1 - a) ≤ K₁) (h2 : ∑ i ∈ range n, M i ≤ K₂) :
    ∑ i ∈ range n, |ℓ i| ≤ τ₀⁻¹ * K₁ / Xa + K₂ / s := by
  calc ∑ i ∈ range n, |ℓ i|
      ≤ ∑ i ∈ range n, (τ₀⁻¹ * (F i ^ a * M i ^ (1 - a)) / Xa + M i / s) := Finset.sum_le_sum h
    _ = τ₀⁻¹ * (∑ i ∈ range n, F i ^ a * M i ^ (1 - a)) / Xa + (∑ i ∈ range n, M i) / s := by
        rw [Finset.sum_add_distrib, ← Finset.sum_div, ← Finset.sum_div, ← Finset.mul_sum]
    _ ≤ τ₀⁻¹ * K₁ / Xa + K₂ / s := by
        have : 0 ≤ τ₀⁻¹ := inv_nonneg.mpr hτ₀.le
        gcongr

/- ## Size estimates -/

lemma one_le_X (D : Data) {X : ℕ} (hX : D.P₁ ≤ X) : 1 ≤ X := by
  have h1 := D.hP₂'P₁
  have h2 : D.P₁ = D.lo (Fin.last D.k) := rfl
  omega

/-- `log X ≤ log N` (from `log⁴ P₂ < log N`). -/
lemma logX_le (D : Data) {X : ℕ} (hX1 : 1 ≤ X) (hX2 : X < D.P₂) (hΛ : 1 ≤ Real.log D.N) :
    Real.log X ≤ Real.log D.N := by
  have hP₂N : Real.log (D.P₂ : ℝ) ^ 4 < Real.log D.N := D.hP₂N
  have hXpos : (0 : ℝ) < X := Nat.cast_pos.mpr (by omega)
  have hXP : Real.log X ≤ Real.log D.P₂ :=
    Real.log_le_log hXpos (by exact_mod_cast hX2.le)
  have h0 : 0 ≤ Real.log X := Real.log_nonneg (by exact_mod_cast hX1)
  have h4 : Real.log X ^ 4 < Real.log D.N := lt_of_le_of_lt (pow_le_pow_left₀ h0 hXP 4) hP₂N
  by_cases h : Real.log X ≤ 1
  · linarith
  · have : Real.log X ≤ Real.log X ^ 4 := le_self_pow₀ (le_of_lt (not_le.mp h)) (by norm_num)
    linarith

/-- `E_{[X,2X)} |Λ̃ - Λ_per| ≤ 2 + B` from (4.2) and (4.3). -/
lemma psi_avg_le {X : ℕ} (hX : 1 ≤ X) {Λt Λper : ℤ → ℝ} {B : ℝ} (hΛt0 : ∀ x, 0 ≤ Λt x)
    (hΛtsum : ∑ x ∈ Finset.Ico (X : ℤ) (2 * X), Λt x ≤ 2 * X)
    (hper : ∑ x ∈ Finset.Ico (X : ℤ) (2 * X), |Λper x| ≤ B * X) :
    favg (win X) (fun x => |Λt x - Λper x|) ≤ 2 + B := by
  have hXpos : (0 : ℝ) < X := Nat.cast_pos.mpr (by omega)
  rw [favg_win, div_le_iff₀ hXpos]
  calc ∑ x ∈ win X, |Λt x - Λper x| ≤ ∑ x ∈ win X, (Λt x + |Λper x|) := by
        refine Finset.sum_le_sum fun x _ => ?_
        calc |Λt x - Λper x| ≤ |Λt x| + |Λper x| := abs_sub _ _
          _ = Λt x + |Λper x| := by rw [abs_of_nonneg (hΛt0 x)]
    _ = ∑ x ∈ win X, Λt x + ∑ x ∈ win X, |Λper x| := Finset.sum_add_distrib
    _ ≤ 2 * X + B * X := add_le_add hΛtsum hper
    _ = (2 + B) * X := by ring

/-- The second error term: `C log^E X · P'₁^{-1/A} ≤ δ³/64`, and `P'₁^{-1/A} ≤ τ₁`. -/
lemma second_term {Cp τ₁ δ Λ s lX : ℝ} {E : ℕ} (hCp : 1 ≤ Cp) (hτ₁ : 0 < τ₁) (hτ₁1 : τ₁ ≤ 1)
    (hδ : 0 < δ) (hΛ : 1 ≤ Λ) (hδΛ : 1 / δ ≤ Λ) (hlX0 : 0 ≤ lX) (hlX : lX ≤ Λ)
    (hs : (64 * Cp / τ₁ * Λ) ^ (E + 3) ≤ s) :
    Cp * lX ^ E / s ≤ δ ^ 3 / 64 ∧ s⁻¹ ≤ τ₁ := by
  set C' := 64 * Cp / τ₁ with hC'
  have hC'ge : 64 * Cp ≤ C' := by
    rw [hC', le_div_iff₀ hτ₁]; nlinarith
  have hC'1 : 1 ≤ C' := by linarith
  have hC'Λ : C' ≤ C' * Λ := le_mul_of_one_le_right (by linarith) hΛ
  have hC'Λ1 : 1 ≤ C' * Λ := by linarith
  have hpow : C' * Λ ≤ (C' * Λ) ^ (E + 3) := le_self_pow₀ hC'Λ1 (by omega)
  have hs0 : 0 < s := by linarith
  refine ⟨?_, ?_⟩
  · rw [div_le_iff₀ hs0]
    have hδΛ' : 1 ≤ δ * Λ := by rw [div_le_iff₀ hδ] at hδΛ; linarith
    have hs' : 64 * Cp * Λ ^ E * Λ ^ 3 ≤ s := by
      calc 64 * Cp * Λ ^ E * Λ ^ 3 = 64 * Cp * Λ ^ (E + 3) := by ring
        _ ≤ C' * Λ ^ (E + 3) := by gcongr
        _ ≤ C' ^ (E + 3) * Λ ^ (E + 3) := by
            gcongr
            exact le_self_pow₀ hC'1 (by omega)
        _ = (C' * Λ) ^ (E + 3) := (mul_pow _ _ _).symm
        _ ≤ s := hs
    calc Cp * lX ^ E ≤ Cp * Λ ^ E := by gcongr
      _ ≤ Cp * Λ ^ E * (δ * Λ) ^ 3 :=
          le_mul_of_one_le_right (by positivity) (one_le_pow₀ hδΛ')
      _ = δ ^ 3 / 64 * (64 * Cp * Λ ^ E * Λ ^ 3) := by ring
      _ ≤ δ ^ 3 / 64 * s := by gcongr
  · have h1 : 1 / τ₁ ≤ C' := by
      rw [hC']
      exact div_le_div_of_nonneg_right (by linarith) hτ₁.le
    have hsτ : 1 / τ₁ ≤ s := by linarith
    calc s⁻¹ ≤ (1 / τ₁)⁻¹ := inv_anti₀ (by positivity) hsτ
      _ = τ₁ := by rw [one_div, inv_inv]

/-- The first error term: `τ₁⁻¹ C Q^{-1/(4A)} ≤ δ³/64`. -/
lemma first_term {Cp τ₁ δ q : ℝ} (hCp : 1 ≤ Cp) (hτ₁ : 0 < τ₁) (hδ : 0 < δ)
    (hδτ : δ ≤ τ₁ / (128 * Cp)) (hq : q ≤ 2 * δ ^ 4) : τ₁⁻¹ * Cp * q ≤ δ ^ 3 / 64 := by
  have h1 : 128 * Cp * δ ≤ τ₁ := by
    rw [le_div_iff₀ (by positivity)] at hδτ; linarith
  have hτi : 0 ≤ τ₁⁻¹ * Cp := by positivity
  calc τ₁⁻¹ * Cp * q ≤ τ₁⁻¹ * Cp * (2 * δ ^ 4) := mul_le_mul_of_nonneg_left hq hτi
    _ = (128 * Cp * δ) * δ ^ 3 / (64 * τ₁) := by field_simp; ring
    _ ≤ τ₁ * δ ^ 3 / (64 * τ₁) := by gcongr
    _ = δ ^ 3 / 64 := by field_simp

end GlueP5

open GlueP5 in
/-- **GlueP5** (GS pp. 17–18): P5a, P5b and P5e give P5. -/
theorem glueP5 : GlueP5 := by
  intro h5a h5b h5e
  obtain ⟨δa, hδa, Na, h5a⟩ := h5a
  obtain ⟨Nb, h5b⟩ := h5b
  obtain ⟨A, hA2, τ₀, hτ₀, Ne, h5e⟩ := h5e
  refine ⟨A, hA2, fun c' C E C₂ hc' hC₂ => ?_⟩
  have hA1 : 1 ≤ A := by omega
  set Cp : ℝ := max C 1 with hCpdef
  have hCp : 1 ≤ Cp := le_max_right _ _
  have hCCp : C ≤ Cp := le_max_left _ _
  set τ₁ : ℝ := min τ₀ 1 with hτ₁def
  have hτ₁ : 0 < τ₁ := lt_min hτ₀ one_pos
  have hτ₁1 : τ₁ ≤ 1 := min_le_right _ _
  have hτ₁τ₀ : τ₁ ≤ τ₀ := min_le_left _ _
  obtain ⟨y₀, hy₀, hy⟩ := log_pow_bound (Cp * (C₂ : ℝ) ^ 12)
  have hC' : 1 ≤ 64 * Cp / τ₁ := by
    rw [le_div_iff₀ hτ₁]; nlinarith
  obtain ⟨Ng, hNg⟩ := P6f.growth (64 * Cp / τ₁) hC' ((E + 3) * A)
  refine ⟨min (min δa (1 / 2)) (min (c' / 2) (min (τ₁ / (128 * Cp)) (1 / y₀))),
    lt_min (lt_min hδa (by norm_num))
      (lt_min (half_pos hc') (lt_min (div_pos hτ₁ (by linarith)) (one_div_pos.mpr hy₀))),
    max (max Na Nb) (max Ne Ng), ?_⟩
  intro D hδ hN f₁ hf₁ X hPX1 hPX2 Λt Λper n g h M F hΛt0 hΛtsum hΛper hdec hh hgM hM0 hMsum
    hF hF0 h46
  simp only [le_min_iff] at hδ
  obtain ⟨⟨hδa', hδ2⟩, hδc, hδτ, hδy⟩ := hδ
  simp only [max_le_iff] at hN
  obtain ⟨⟨hNa, hNb⟩, hNe, hNg'⟩ := hN
  have hδ0 := D.hδ
  have hX1 : 1 ≤ X := one_le_X D hPX1
  have hXr : (0 : ℝ) < X := Nat.cast_pos.mpr (by omega)
  have hC₂1 : 1 ≤ C₂ := by omega
  have hQ := Q_facts D hC₂1 hδ2
  have hQ1 := one_le_Q D hC₂1 hδ2
  have hQpos : (0 : ℝ) < D.Q C₂ := by linarith
  have hlogQ0 : 0 ≤ Real.log (D.Q C₂) := Real.log_nonneg hQ1
  obtain ⟨hΛ1, hgrow⟩ := hNg D hNg'
  have hlX0 : 0 ≤ Real.log X := Real.log_nonneg (by exact_mod_cast hX1)
  have hlX := logX_le D hX1 hPX2 hΛ1
  -- replace `C` by `Cp = max C 1 ≥ 1`
  have hΛper' : ∑ x ∈ Finset.Ico (X : ℤ) (2 * X), |Λper x| ≤
      Cp * Real.log (D.Q C₂) ^ 12 * X :=
    hΛper.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hCCp (pow_nonneg hlogQ0 12)) hXr.le)
  have hh' : ∑ x ∈ Finset.Ico (X : ℤ) (2 * X), |h x| ≤ Cp / (D.Q C₂) * X :=
    hh.trans (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hCCp hQpos.le) hXr.le)
  have hMsum' : ∑ i ∈ range n, M i ≤ Cp * Real.log X ^ E :=
    hMsum.trans (mul_le_mul_of_nonneg_right hCCp (pow_nonneg hlX0 E))
  have h46' : ∑ i ∈ range n, F i ^ (1 / (A : ℝ)) * M i ^ (1 - 1 / (A : ℝ)) ≤
      Cp * (X : ℝ) ^ (1 / (A : ℝ)) * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) :=
    h46.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hCCp (Real.rpow_nonneg hXr.le _))
      (Real.rpow_nonneg hQpos.le _))
  -- (5.11): `E|ψ| ≤ 1/δ` for `ψ = Λ̃ - Λ_per`
  have hψ : favg (win X) (fun x => |Λt x - Λper x|) ≤ 1 / D.δ := by
    refine (psi_avg_le hX1 hΛt0 hΛtsum hΛper').trans ?_
    have hlogQ : Real.log (D.Q C₂) ≤ C₂ * Real.log (1 / D.δ) := by
      rw [← Real.log_pow]; exact Real.log_le_log hQpos hQ.2
    have hy₀δ : y₀ ≤ 1 / D.δ := (le_one_div hy₀ hδ0).mpr hδy
    calc 2 + Cp * Real.log (D.Q C₂) ^ 12
        ≤ 2 + Cp * ((C₂ : ℝ) * Real.log (1 / D.δ)) ^ 12 := by gcongr
      _ = 2 + Cp * (C₂ : ℝ) ^ 12 * Real.log (1 / D.δ) ^ 12 := by ring
      _ ≤ 1 / D.δ := hy _ hy₀δ
  -- suppose (5.9) holds
  by_contra hcon
  have hcon' : c' * D.δ ^ 2 / 2 ≤
      |favg (win X) (fun x => (Λt x - Λper x) * Phi D f₁ x)| := le_of_not_gt hcon
  have hδ3 : D.δ ^ 3 ≤ |favg (win X) (fun x => (Λt x - Λper x) * Phi D f₁ x)| := by
    have : D.δ ^ 3 ≤ c' * D.δ ^ 2 / 2 := by
      have h2 : 0 ≤ D.δ ^ 2 := sq_nonneg _
      have : D.δ ^ 3 = D.δ * D.δ ^ 2 := by ring
      rw [this]
      nlinarith
    linarith
  -- P5a and P5b: (5.12) and (5.14)
  obtain ⟨a₁, b₁, a₂, b₂, hG1, hG2, h12⟩ :=
    h5a D hδa' hNa f₁ hf₁ X hPX1 hPX2 (fun x => Λt x - Λper x) hψ hδ3
  obtain ⟨ρ, hρ, u, L, hL, h14⟩ :=
    h5b D hNb f₁ hf₁ X hPX1 hPX2 (fun x => Λt x - Λper x) hψ a₁ b₁ a₂ b₂ hG1 hG2 h12
  -- linearity: `ψ = ∑ gᵢ + h`
  have hdecomp : lhs14 f₁ (fun x => Λt x - Λper x) D.lam X (almostPrimes a₁ b₁)
      (almostPrimes a₂ b₂) ρ u L =
      ∑ i ∈ range n, lhs14 f₁ (g i) D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L +
        lhs14 f₁ h D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L := by
    have e : (fun x => Λt x - Λper x) = (fun x => (fun y => ∑ i ∈ range n, g i y) x + h x) :=
      funext hdec
    rw [e, lhs14_add, lhs14_sum]
  -- the `h`-term: `|lhs14(h)| ≤ E|h| ≤ C/Q`
  have hhb : |lhs14 f₁ h D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L| ≤
      Cp / D.Q C₂ := by
    refine (abs_lhs14_le _ _ _ _ _ _ hf₁ hρ h).trans ?_
    rw [favg_win, div_le_iff₀ hXr]
    exact hh'
  -- `s = P'₁^{1/A}`
  set s : ℝ := (D.P₁' : ℝ) ^ (1 / (A : ℝ)) with hsdef
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact Nat.cast_pos.mpr (by omega)
  have hs0 : 0 < s := Real.rpow_pos_of_pos hP₁'pos _
  have hsA : s ^ A = D.P₁' := by
    rw [hsdef, one_div]; exact Real.rpow_inv_natCast_pow hP₁'pos.le (by omega)
  have hbase : 0 ≤ 64 * Cp / τ₁ * Real.log D.N :=
    mul_nonneg (div_nonneg (by linarith) hτ₁.le) (by linarith)
  have hsbig : (64 * Cp / τ₁ * Real.log D.N) ^ (E + 3) ≤ s := by
    have h1 : ((64 * Cp / τ₁ * Real.log D.N) ^ (E + 3)) ^ A ≤ (D.P₁' : ℝ) := by
      rw [← pow_mul]; exact hgrow
    calc (64 * Cp / τ₁ * Real.log D.N) ^ (E + 3)
        = (((64 * Cp / τ₁ * Real.log D.N) ^ (E + 3)) ^ A) ^ (1 / (A : ℝ)) := by
          rw [one_div, Real.pow_rpow_inv_natCast (pow_nonneg hbase _) (by omega)]
      _ ≤ s := Real.rpow_le_rpow (pow_nonneg (pow_nonneg hbase _) _) h1 (by positivity)
  have hδN : 1 / D.δ ≤ Real.log D.N := D.hδN.trans (Real.log_le_self (by linarith))
  obtain ⟨hsecond, hsτ⟩ := second_term (E := E) hCp hτ₁ hτ₁1 hδ0 hΛ1 hδN hlX0 hlX hsbig
  -- the homogeneity step for each `gᵢ`
  have hterm : ∀ i ∈ range n,
      |lhs14 f₁ (g i) D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L| ≤
        τ₁⁻¹ * (F i ^ (1 / (A : ℝ)) * M i ^ (1 - 1 / (A : ℝ))) / (X : ℝ) ^ (1 / (A : ℝ)) +
          M i / s := by
    intro i hi
    have hgi : ∀ x, |g i x| ≤ M i := hgM i hi
    refine term_bound hA1 hτ₁ hτ₁1 hs0 hsτ (hM0 i) (hF0 i) hXr
      ((abs_lhs14_le _ _ _ _ _ _ hf₁ hρ _).trans (favg_le_const _ (hM0 i) fun x _ => hgi x))
      ?_
    intro hMpos τ hτ hττ₁ hτA hτℓ
    have hgt : ∀ x, |(fun x => (M i)⁻¹ * g i x) x| ≤ 1 := fun x => by
      show |(M i)⁻¹ * g i x| ≤ 1
      rw [abs_mul, abs_inv, abs_of_pos hMpos, inv_mul_le_iff₀ hMpos, mul_one]
      exact hgi x
    have hℓt : |lhs14 f₁ (fun x => (M i)⁻¹ * g i x) D.lam X (almostPrimes a₁ b₁)
        (almostPrimes a₂ b₂) ρ u L| =
        |lhs14 f₁ (g i) D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L| / M i := by
      rw [lhs14_smul, abs_mul, abs_inv, abs_of_pos hMpos, inv_mul_eq_div]
    have hτA' : 1 ≤ τ ^ A * (D.P₁' : ℝ) := by rwa [hsA] at hτA
    obtain ⟨θ, hθ⟩ := h5e D hNe f₁ hf₁ X hPX1 hPX2 a₁ b₁ a₂ b₂ hG1 hG2 ρ hρ u L hL
      (fun x => (M i)⁻¹ * g i x) hgt τ hτ (hττ₁.trans hτ₁τ₀) hτA' (by rw [hℓt]; exact hτℓ)
    calc τ ^ A * X ≤ ‖expSum X (fun x => (M i)⁻¹ * g i x) θ‖ := hθ
      _ ≤ (M i)⁻¹ * F i := norm_expSum_smul_le X (g i) (inv_nonneg.mpr hMpos.le) θ (hF i hi θ)
      _ = F i / M i := by rw [inv_mul_eq_div]
  -- summing with (4.5) and (4.6)
  have hXa : (0 : ℝ) < (X : ℝ) ^ (1 / (A : ℝ)) := Real.rpow_pos_of_pos hXr _
  have hsum := sum_term_bound hτ₁ hXa hs0 hterm h46' hMsum'
  have hfirst_eq : τ₁⁻¹ * (Cp * (X : ℝ) ^ (1 / (A : ℝ)) * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4))) /
      (X : ℝ) ^ (1 / (A : ℝ)) = τ₁⁻¹ * Cp * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) := by
    field_simp
  rw [hfirst_eq] at hsum
  have hfirst := first_term hCp hτ₁ hδ0 hδτ (Q_rpow_le D hA1 hC₂ hδ2)
  have hthird : Cp / D.Q C₂ ≤ D.δ ^ 3 / 64 := by
    have h2 := inv_Q_le D hA1 hC₂ hδ2
    have hq : 0 ≤ (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) := Real.rpow_nonneg hQpos.le _
    have hτi : 1 ≤ τ₁⁻¹ := (one_le_inv₀ hτ₁).mpr hτ₁1
    calc Cp / D.Q C₂ = Cp * (1 / (D.Q C₂ : ℝ)) := by ring
      _ ≤ Cp * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) :=
          mul_le_mul_of_nonneg_left h2 (by linarith)
      _ ≤ τ₁⁻¹ * (Cp * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4))) :=
          le_mul_of_one_le_left (mul_nonneg (by linarith) hq) hτi
      _ = τ₁⁻¹ * Cp * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) := (mul_assoc _ _ _).symm
      _ ≤ D.δ ^ 3 / 64 := hfirst
  -- the total is `≤ 3δ³/64 < δ³/16`
  have htot : |lhs14 f₁ (fun x => Λt x - Λper x) D.lam X (almostPrimes a₁ b₁)
      (almostPrimes a₂ b₂) ρ u L| ≤ 3 * (D.δ ^ 3 / 64) := by
    rw [hdecomp]
    calc _ ≤ |∑ i ∈ range n, lhs14 f₁ (g i) D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂)
            ρ u L| + |lhs14 f₁ h D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L| :=
          abs_add_le _ _
      _ ≤ ∑ i ∈ range n, |lhs14 f₁ (g i) D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂)
            ρ u L| + |lhs14 f₁ h D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L| :=
          add_le_add (Finset.abs_sum_le_sum_abs _ _) le_rfl
      _ ≤ (τ₁⁻¹ * Cp * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4)) + Cp * Real.log X ^ E / s) +
            Cp / D.Q C₂ := add_le_add hsum hhb
      _ ≤ 3 * (D.δ ^ 3 / 64) := by linarith
  have hδ3pos : 0 < D.δ ^ 3 := by positivity
  linarith

end G22.P51

end

/- ## Section: `P51P6ab` -/

section

/-
# Steps P6a and P6b of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, pp. 21–22 ((5.10) → (5.24), then the triangle
inequality, Cauchy–Schwarz and the removal of non-coprime pairs). The statements are in
`Prop51Steps.lean`; here we prove `stepP6a : StepP6a` and `stepP6b : StepProdAvg → StepP6b`.
Helper lemmas live in `G22.P51.P6ab`.

Write `T = ⌊√P₁⌋`, `Q = ⌊δ^{-C₂}⌋`, `d = p₁² - p₂²` and `M₃ = E_{x∈[X,2X)} |Λ_per(x)|`.

## P6a
For `t ∈ [T]` and `p₁, p₂ ∈ 𝒫'` substitute `x = x' + Q!p₁t`, `n = n' - λQ!p₂t` (`Fp_eq_Fz`):
`np₂ + λxp₁ = n'p₂ + λx'p₁ + λtQ!d` and `np₁ + λxp₂ = n'p₁ + λx'p₂`, while
`Λ_per(x) = Λ_per(x')` by `Q!`-periodicity (`per_nat`). Moving the `n'`-range back costs at most
`M₃ · 2(1 + log K)/log N` (GS (A.2), `Elem.logAvg_shift_le'`, `K = λQ!P'₂T`); moving the
`x'`-range back costs at most `2Q!P'₂T · CQ²/X` (GS (A.1) on `[X, 2X)`, `favg_win_shift`, with
`‖Λ_per‖_∞ ≤ CQ²`). This is `inner_close`. Averaging over `t, p₁, p₂` (`Z524_ge`, with the Fubini
identity `favg_Phi`) gives `Z524 ≥ E(Λ_per Φ) - ε`, and `ε ≤ c'δ²/4` once `N ≥ N₀` (`growth6a`).
With `L = log log N`: `M₃ ≤ |C|Q¹² ≤ |C|L^{12C₂}`, `log K ≤ 3e^{L/4} + Q²` (`log_K_le`), and
`Q!P'₂T/X ≤ Q!/P'₂⁴` since `P'₂⁵ ≤ T` and `T² ≤ P₁ ≤ X`, where
`log P'₂ ≥ log P'₁ = e^m`, `m = log log P'₁ ≥ L^{1/10}`.

## P6b
Fubini gives `Z524 = E_x Λ_per(x) W(x)` (`Z524_eq`), where
`W(x) = E^log_{p₁,p₂} E^log_n f₁(np₁ + λxp₂) E_t f₁(np₂ + λxp₁ + λtQ!d)`.
* Jensen and `|f₁| ≤ 1` give `W² ≤ V` (`Wf_sq_le`). Here `V(x)` is the inner average of `CS1`
  without the factor `1_{(p₁,p₂)=1}`.
* `V ≤ V_cop + ν` (`Vf_le`), where `V_cop` is the inner average of `CS1` and `ν` is the
  logarithmic proportion of non-coprime pairs.
* `ν ≤ γ(𝒫') ≤ 4δ⁵` (`nu_le`: `Small.lemma52_indicator` converted by `StepProdAvg`, then
  `Small.lemma52_prop51`).
* Cauchy–Schwarz with weight `|Λ_per|` (`cs_weighted`) gives `Z524² ≤ M₃ · CS1 + ν M₃²`
  (`Z_sq_le`).
* Finally `128 δ M₃² ≤ c'²` for `δ ≤ δ₀` (`delta6b`, from `M₃ ≤ C log¹² Q` and
  `log Q ≤ C₂ log(1/δ)`), so `M₃ · CS1 ≥ (c'δ²)²/16 - 4δ⁵M₃² ≥ (c'δ²)²/32` (`final_arith`).

## Constants
* P6a: `δ₀ = 1` and `N₀ = ⌈exp(exp L₀)⌉` with `L₀ = max(2x₀, m₀¹⁰)`,
  `x₀ = max(1, (80|C|/c') 2^{14C₂+2} (14C₂+3)!)` and `m₀ = max(1, (16|C|/c' + 5)(20C₂+11)!)`.
* P6b: `N₀ = 0` and `δ₀ = min(1/2, e^{-v₀}, 1/(2C_M + 1))` with `v₀ = max(1, 25! · 128C²C₂²⁴/c'²)`,
  where `C_M ≥ 0` is the Mertens constant of `MertensProof.mertensLower`.

## Degenerate cases
If `𝒫' = ∅` then `Φ = 0` and `Z524 = 0`, so the hypotheses fail. `N ≥ 2` follows from
`0 < 1/δ ≤ log log N` (`two_le_N`); `T ≥ 1` and `X ≥ 3` follow from `P₁ ≥ 3`. No sign condition
on `C` is needed: the bounds use `|C|`, and `CQ² ≥ |Λ_per(0)| ≥ 0`.
-/

open Finset Real

namespace G22.P51

namespace P6ab

/- ## Generic facts about averages -/

section Generic

variable {α β γ δ' : Type*}

lemma gwU {s : Finset α} (hs : s.Nonempty) : GoodWeights s (fun _ => (1 : ℝ)) :=
  ⟨fun _ _ => one_pos, hs⟩

lemma win_nonempty {X : ℕ} (hX : 1 ≤ X) : (win X).Nonempty := by
  unfold win
  exact nonempty_Ico.mpr (by omega)

lemma favg_div (s : Finset α) (f : α → ℝ) (c : ℝ) :
    favg s (fun x => f x / c) = favg s f / c := by
  unfold favg wavg
  have h : ∑ x ∈ s, 1 * (f x / c) = (∑ x ∈ s, 1 * f x) / c := by
    rw [Finset.sum_div]
    exact Finset.sum_congr rfl fun x _ => by ring
  rw [h, div_right_comm]

/-- `|E(ab) - E(ac)| ≤ E|a| · e` if `|b - c| ≤ e` on `s`. -/
lemma abs_favg_mul_sub_le {s : Finset α} (hs : s.Nonempty) (a b c : α → ℝ) {e : ℝ}
    (h : ∀ x ∈ s, |b x - c x| ≤ e) :
    |favg s (fun x => a x * b x) - favg s (fun x => a x * c x)| ≤
      favg s (fun x => |a x|) * e := by
  have hw := gwU hs
  unfold favg
  rw [← wavg_sub]
  refine (abs_wavg_le hw _).trans ?_
  rw [Elem.wavg_mul_const]
  refine wavg_mono hw fun x hx => ?_
  rw [← mul_sub, abs_mul]
  exact mul_le_mul_of_nonneg_left (h x hx) (abs_nonneg _)

end Generic

/- ## GS (A.1) on the window `[X, 2X)` -/

section Shift

lemma sum_Ico_eq_sum_Icc (a : ℤ) (L : ℕ) (F : ℤ → ℝ) :
    ∑ n ∈ Ico a (a + L), F n = ∑ h ∈ Icc 1 L, F (a - 1 + h) := by
  refine Finset.sum_nbij' (fun n => (n - a + 1).toNat) (fun h => a - 1 + h) ?_ ?_ ?_ ?_ ?_
  · intro n hn
    simp only [mem_Ico] at hn
    simp only [mem_Icc]
    omega
  · intro h hh
    simp only [mem_Icc] at hh
    simp only [mem_Ico]
    omega
  · intro n hn
    simp only [mem_Ico] at hn
    omega
  · intro h hh
    simp only [mem_Icc] at hh
    omega
  · intro n hn
    simp only [mem_Ico] at hn
    congr 1
    omega

lemma favg_Ico_eq_uavg (a : ℤ) (L : ℕ) (F : ℤ → ℝ) :
    favg (Ico a (a + L)) F = uavg L fun h => F (a - 1 + h) := by
  unfold favg uavg wavg
  congr 1
  · exact sum_Ico_eq_sum_Icc a L _
  · exact sum_Ico_eq_sum_Icc a L _

lemma favg_Ico_shift (a : ℤ) (L : ℕ) (g : ℤ → ℝ) (hg : ∀ n, |g n| ≤ 1) (s : ℤ) :
    |favg (Ico a (a + L)) (fun n => g (n + s)) - favg (Ico a (a + L)) g| ≤
      2 * |(s : ℝ)| / L := by
  rw [favg_Ico_eq_uavg, favg_Ico_eq_uavg]
  have key := Elem.uavg_shift_le L (fun m => g (a - 1 + m)) (fun _ => hg _) s
  simpa only [add_assoc] using key

lemma win_eq (X : ℕ) : win X = Ico (X : ℤ) ((X : ℤ) + (X : ℕ)) := by
  unfold win
  congr 1
  ring

/-- **GS (A.1)** on `[X, 2X)` for an `M`-bounded function. -/
lemma favg_win_shift (X : ℕ) (g : ℤ → ℝ) {M : ℝ} (hM : 0 ≤ M) (hg : ∀ n, |g n| ≤ M)
    (s : ℤ) :
    |favg (win X) (fun n => g (n + s)) - favg (win X) g| ≤ 2 * |(s : ℝ)| * M / X := by
  rcases hM.eq_or_lt with hM0 | hMpos
  · subst hM0
    have h0 : g = fun _ => 0 := funext fun n => abs_nonpos_iff.mp (hg n)
    subst h0
    simp
  · have hg' : ∀ n, |g n / M| ≤ 1 := fun n => by
      rw [abs_div, abs_of_pos hMpos, div_le_one hMpos]
      exact hg n
    have key := favg_Ico_shift X X (fun n => g n / M) hg' s
    rw [← win_eq, favg_div (win X) (fun n => g (n + s)) M, favg_div (win X) g M, ← sub_div,
      abs_div, abs_of_pos hMpos, div_le_iff₀ hMpos] at key
    calc _ ≤ 2 * |(s : ℝ)| / X * M := key
      _ = 2 * |(s : ℝ)| * M / X := by ring

end Shift

/- ## Periodicity and the substitution of GS p. 21 -/

lemma per_nat {Λ : ℤ → ℝ} {q : ℕ} (h : ∀ x : ℤ, Λ (x + q) = Λ x) (m : ℕ) (x : ℤ) :
    Λ (x + m * q) = Λ x := by
  induction m with
  | zero => simp
  | succ m ih =>
    have e : x + ((m + 1 : ℕ) : ℤ) * q = (x + m * q) + q := by push_cast; ring
    rw [e, h, ih]

/-- The integrand of `Z524` for fixed `t, p₁, p₂`. -/
noncomputable def Fz (D : Data) (f₁ : ℤ → ℝ) (Q t p₁ p₂ : ℕ) (x n : ℤ) : ℝ :=
  f₁ (n * p₂ + (D.lam : ℤ) * x * p₁ +
      (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
    f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)

/-- The integrand of `Φ`. -/
noncomputable def Fp (D : Data) (f₁ : ℤ → ℝ) (p₁ p₂ : ℕ) (x n : ℤ) : ℝ :=
  f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)

lemma abs_Fz_le (D : Data) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q t p₁ p₂ : ℕ) (x n : ℤ) :
    |Fz D f₁ Q t p₁ p₂ x n| ≤ 1 :=
  Elem.abs_mul_le_one (hf₁ _) (hf₁ _)

/-- The substitution `x = x' + Q!p₁t`, `n = n' - λQ!p₂t` (GS p. 21). -/
lemma Fp_eq_Fz (D : Data) (f₁ : ℤ → ℝ) (Q t p₁ p₂ : ℕ) (x n : ℤ) :
    Fp D f₁ p₁ p₂ x n = Fz D f₁ Q t p₁ p₂ (x + -((Q.factorial : ℤ) * p₁ * t))
      (n + (D.lam : ℤ) * Q.factorial * p₂ * t) := by
  unfold Fp Fz
  congr 2 <;> ring

/-- **P6a for fixed `t, p₁, p₂`**: the `Z524` inner average is within
`E|Λ| · 2(1 + log K)/log N + 2SM/X` of the `Φ` inner average. -/
lemma inner_close (D : Data) (hN : 2 ≤ D.N) (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q X : ℕ)
    (hX : 1 ≤ X) (Λ : ℤ → ℝ) (hper : ∀ x : ℤ, Λ (x + Q.factorial) = Λ x) {M : ℝ}
    (hM0 : 0 ≤ M) (hM : ∀ x, |Λ x| ≤ M) (t p₁ p₂ K S : ℕ)
    (hK : D.lam * Q.factorial * p₂ * t ≤ K) (hS : Q.factorial * p₁ * t ≤ S) :
    |favg (win X) (fun x => Λ x * logAvg D.N (Fz D f₁ Q t p₁ p₂ x)) -
      favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x))| ≤
      favg (win X) (fun x => |Λ x|) * (2 * (1 + Real.log K) / Real.log D.N) +
        2 * S * M / X := by
  set s : ℤ := (Q.factorial : ℤ) * p₁ * t with hs
  set r : ℤ := (D.lam : ℤ) * Q.factorial * p₂ * t with hr
  set g : ℤ → ℝ := fun y => Λ y * logAvg D.N (Fz D f₁ Q t p₁ p₂ y) with hgdef
  have hlog1 : ∀ y, |logAvg D.N (Fz D f₁ Q t p₁ p₂ y)| ≤ 1 := fun y =>
    Small.abs_logAvg_le_one (abs_Fz_le D hf₁ Q t p₁ p₂ y)
  have hg : ∀ y, |g y| ≤ M := fun y => by
    rw [hgdef, abs_mul]
    calc |Λ y| * |logAvg D.N (Fz D f₁ Q t p₁ p₂ y)| ≤ M * 1 :=
          mul_le_mul (hM y) (hlog1 y) (abs_nonneg _) hM0
      _ = M := mul_one M
  -- (c) the shift of the `x`-range
  have hc := favg_win_shift X g hM0 hg (-s)
  have hsS : |((-s : ℤ) : ℝ)| ≤ S := by
    rw [hs]
    push_cast
    rw [abs_neg, abs_of_nonneg (by positivity)]
    exact_mod_cast hS
  have hc' : |favg (win X) (fun x => g (x + -s)) - favg (win X) g| ≤ 2 * S * M / X := by
    refine hc.trans ?_
    have hX0 : (0 : ℝ) ≤ X := Nat.cast_nonneg X
    apply div_le_div_of_nonneg_right _ hX0
    have := mul_le_mul_of_nonneg_right hsS hM0
    linarith
  -- (b) periodicity: `Λ x = Λ (x - s)`
  have hb : ∀ x, Λ x = Λ (x + -s) := by
    intro x
    have h1 := per_nat hper (p₁ * t) (x + -s)
    rw [← h1]
    congr 1
    rw [hs]
    push_cast
    ring
  -- (a) the shift of the `n`-range (GS (A.2))
  have ha : ∀ x ∈ win X, |logAvg D.N (Fp D f₁ p₁ p₂ x) -
      logAvg D.N (Fz D f₁ Q t p₁ p₂ (x + -s))| ≤ 2 * (1 + Real.log K) / Real.log D.N := by
    intro x _
    have e : Fp D f₁ p₁ p₂ x = fun n => Fz D f₁ Q t p₁ p₂ (x + -s) (n + r) :=
      funext fun n => Fp_eq_Fz D f₁ Q t p₁ p₂ x n
    rw [e]
    refine Elem.logAvg_shift_le' D.N hN _ (abs_Fz_le D hf₁ Q t p₁ p₂ _) r K ?_
    rw [hr]
    have : ((D.lam : ℤ) * Q.factorial * p₂ * t) = ((D.lam * Q.factorial * p₂ * t : ℕ) : ℤ) := by
      push_cast; ring
    rw [this, Int.natAbs_natCast]
    exact hK
  have hne := win_nonempty hX
  have hA := abs_favg_mul_sub_le hne Λ (fun x => logAvg D.N (Fp D f₁ p₁ p₂ x))
    (fun x => logAvg D.N (Fz D f₁ Q t p₁ p₂ (x + -s))) ha
  have e2 : favg (win X) (fun x => Λ x * logAvg D.N (Fz D f₁ Q t p₁ p₂ (x + -s))) =
      favg (win X) (fun x => g (x + -s)) := by
    refine wavg_congr fun x _ => ?_
    rw [hgdef]
    simp only
    rw [← hb x]
  rw [e2] at hA
  have e3 : favg (win X) (fun x => Λ x * logAvg D.N (Fz D f₁ Q t p₁ p₂ x)) =
      favg (win X) g := rfl
  rw [e3]
  rw [abs_sub_comm] at hA
  calc |favg (win X) g - favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x))|
      ≤ |favg (win X) g - favg (win X) (fun x => g (x + -s))| +
        |favg (win X) (fun x => g (x + -s)) -
          favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x))| := abs_sub_le _ _ _
    _ ≤ 2 * S * M / X + favg (win X) (fun x => |Λ x|) *
          (2 * (1 + Real.log K) / Real.log D.N) := by
        rw [abs_sub_comm] at hc'
        exact add_le_add hc' hA
    _ = _ := by ring

/- ## Step P6a: averaging over `t, p₁, p₂` -/

/-- Fubini: `E_x Λ(x) Φ(x) = E^log_{p₁} E^log_{p₂} E_x Λ(x) E^log_n Fp`. -/
lemma favg_Phi (D : Data) (f₁ : ℤ → ℝ) (X : ℕ) (Λ : ℤ → ℝ) :
    favg (win X) (fun x => Λ x * Phi D f₁ x) =
      lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ =>
        favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x)))) := by
  have h1 : ∀ x, Λ x * Phi D f₁ x = lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ =>
      Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x))) := by
    intro x
    unfold Phi lavg
    rw [← wavg_smul]
    refine wavg_congr fun p₁ _ => ?_
    rw [← wavg_smul]
    rfl
  simp only [h1]
  unfold favg lavg
  rw [Elem.wavg_comm]
  refine wavg_congr fun p₁ _ => ?_
  rw [Elem.wavg_comm]

/-- Averaging the pointwise estimate over `t ∈ [T]`, `p₁, p₂ ∈ 𝒫'`. -/
lemma Z524_ge (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λ : ℤ → ℝ) (hne : D.Pp.Nonempty)
    (hT : 1 ≤ Nat.sqrt D.P₁) {ε : ℝ}
    (h : ∀ t ∈ Icc 1 (Nat.sqrt D.P₁), ∀ p₁ ∈ D.Pp, ∀ p₂ ∈ D.Pp,
      |favg (win X) (fun x => Λ x * logAvg D.N (Fz D f₁ Q t p₁ p₂ x)) -
        favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x))| ≤ ε) :
    favg (win X) (fun x => Λ x * Phi D f₁ x) - ε ≤ Z524 D f₁ Q X Λ := by
  rw [favg_Phi]
  have hw := P3.gw_Pp hne
  have hu := goodWeights_uavg hT
  have hZ : Z524 D f₁ Q X Λ = uavg (Nat.sqrt D.P₁) (fun t => lavg D.Pp (fun p₁ =>
      lavg D.Pp (fun p₂ => favg (win X) (fun x => Λ x * logAvg D.N (Fz D f₁ Q t p₁ p₂ x))))) :=
    rfl
  have hA : uavg (Nat.sqrt D.P₁) (fun _ => lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ =>
      favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x))))) =
      lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ =>
        favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x)))) :=
    wavg_const hu _
  have key : |uavg (Nat.sqrt D.P₁) (fun t => lavg D.Pp (fun p₁ =>
      lavg D.Pp (fun p₂ => favg (win X) (fun x => Λ x * logAvg D.N (Fz D f₁ Q t p₁ p₂ x))))) -
      uavg (Nat.sqrt D.P₁) (fun _ => lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ =>
        favg (win X) (fun x => Λ x * logAvg D.N (Fp D f₁ p₁ p₂ x)))))| ≤ ε := by
    refine Elem.abs_wavg_sub_le hu fun t ht => ?_
    refine Elem.abs_wavg_sub_le hw fun p₁ hp₁ => ?_
    refine Elem.abs_wavg_sub_le hw fun p₂ hp₂ => ?_
    exact h t ht p₁ hp₁ p₂ hp₂
  rw [hA, ← hZ] at key
  linarith [(abs_le.mp key).1]

/- ## Step P6a: `N` large -/

/-- `A xᵖ ≤ eˣ` for `x ≥ 1` and `x ≥ A (p+1)!`. -/
lemma poly_le_exp {A x : ℝ} (p : ℕ) (hx1 : 1 ≤ x)
    (hxA : A * ((p + 1).factorial : ℝ) ≤ x) : A * x ^ p ≤ Real.exp x := by
  have hfac : (0 : ℝ) < ((p + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have hx0 : 0 ≤ x := by linarith
  have h := Real.pow_div_factorial_le_exp x hx0 (p + 1)
  have hxp : 0 ≤ x ^ p := pow_nonneg hx0 p
  calc A * x ^ p = (A * (p + 1).factorial) * x ^ p / (p + 1).factorial := by
        field_simp
    _ ≤ x * x ^ p / (p + 1).factorial := by
        apply div_le_div_of_nonneg_right _ hfac.le
        exact mul_le_mul_of_nonneg_right hxA hxp
    _ = x ^ (p + 1) / (p + 1).factorial := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h

/-- `Q! ≤ e^{Q²}`. -/
lemma factorial_le_exp_sq (Q : ℕ) : (Q.factorial : ℝ) ≤ Real.exp ((Q : ℝ) ^ 2) := by
  have h1 : (Q.factorial : ℝ) ≤ (Q : ℝ) ^ Q := by exact_mod_cast Nat.factorial_le_pow Q
  have h2 : (Q : ℝ) ^ Q ≤ Real.exp (Q : ℝ) ^ Q :=
    pow_le_pow_left₀ (Nat.cast_nonneg Q) (by linarith [Real.add_one_le_exp (Q : ℝ)]) Q
  have h3 : Real.exp (Q : ℝ) ^ Q = Real.exp ((Q : ℝ) ^ 2) := by
    rw [← Real.exp_nat_mul]; congr 1; ring
  linarith

/-- `log Q! ≤ Q²`. -/
lemma log_factorial_le (Q : ℕ) : Real.log (Q.factorial : ℝ) ≤ (Q : ℝ) ^ 2 := by
  have hpos : (0 : ℝ) < (Q.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos Q
  calc Real.log (Q.factorial : ℝ) ≤ Real.log (Real.exp ((Q : ℝ) ^ 2)) :=
        Real.log_le_log hpos (factorial_le_exp_sq Q)
    _ = (Q : ℝ) ^ 2 := Real.log_exp _

/-- From `a⁴ ≤ e^L`: `a ≤ e^{L/4}`. -/
lemma le_exp_quarter {a L : ℝ} (ha : 0 ≤ a) (h : a ^ 4 ≤ Real.exp L) : a ≤ Real.exp (L / 4) := by
  have e : Real.exp (L / 4) ^ 4 = Real.exp L := by
    rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
  rw [← e] at h
  exact (pow_le_pow_iff_left₀ ha (Real.exp_pos _).le (by norm_num)).mp h

/-- The error of the `n`-shift, as a real inequality (`L = log log N`, `u = 1/δ`,
`lK = log(λQ!P'₂T)`). -/
lemma termA_real {c' C L u Q lK : ℝ} (C₂ : ℕ) (hc' : 0 < c') (hL1 : 1 ≤ L)
    (hLA : 80 * |C| / c' * L ^ (14 * C₂ + 2) ≤ Real.exp (L / 2))
    (hu : 0 < u) (huL : u ≤ L) (hQ0 : 0 ≤ Q) (hQ : Q ≤ L ^ C₂)
    (hlK : 0 ≤ lK) (hlK' : lK ≤ 3 * Real.exp (L / 4) + Q ^ 2) :
    |C| * Q ^ 12 * (2 * (1 + lK) / Real.exp L) ≤ c' * (1 / u) ^ 2 / 8 := by
  set E := Real.exp (L / 4) with hE
  have hE1 : 1 ≤ E := Real.one_le_exp (by linarith)
  have hL0 : 0 < L := by linarith
  have hLp : 1 ≤ L ^ (2 * C₂) := one_le_pow₀ hL1
  have hQ2 : Q ^ 2 ≤ L ^ (2 * C₂) := by
    calc Q ^ 2 ≤ (L ^ C₂) ^ 2 := pow_le_pow_left₀ hQ0 hQ 2
      _ = L ^ (2 * C₂) := by rw [← pow_mul, mul_comm]
  have hQ12 : Q ^ 12 ≤ L ^ (12 * C₂) := by
    calc Q ^ 12 ≤ (L ^ C₂) ^ 12 := pow_le_pow_left₀ hQ0 hQ 12
      _ = L ^ (12 * C₂) := by rw [← pow_mul, mul_comm]
  have h1 : 1 + lK ≤ 5 * L ^ (2 * C₂) * E := by nlinarith
  have hexp : Real.exp (L / 2) * E ≤ Real.exp L := by
    rw [hE, ← Real.exp_add]; exact Real.exp_le_exp.mpr (by linarith)
  have hC80 : 80 * |C| * L ^ (14 * C₂ + 2) ≤ c' * Real.exp (L / 2) := by
    have := mul_le_mul_of_nonneg_left hLA hc'.le
    calc 80 * |C| * L ^ (14 * C₂ + 2) = c' * (80 * |C| / c' * L ^ (14 * C₂ + 2)) := by
          field_simp
      _ ≤ c' * Real.exp (L / 2) := this
  have hC0 : 0 ≤ |C| := abs_nonneg C
  have key : 16 * |C| * Q ^ 12 * (1 + lK) * L ^ 2 ≤ c' * Real.exp L := by
    calc 16 * |C| * Q ^ 12 * (1 + lK) * L ^ 2
        ≤ 16 * |C| * L ^ (12 * C₂) * (5 * L ^ (2 * C₂) * E) * L ^ 2 := by
          gcongr
      _ = 80 * |C| * L ^ (14 * C₂ + 2) * E := by ring
      _ ≤ c' * Real.exp (L / 2) * E := mul_le_mul_of_nonneg_right hC80 (by linarith)
      _ = c' * (Real.exp (L / 2) * E) := by ring
      _ ≤ c' * Real.exp L := mul_le_mul_of_nonneg_left hexp hc'.le
  have hexpL : 0 < Real.exp L := Real.exp_pos L
  have hu2 : 1 / L ^ 2 ≤ (1 / u) ^ 2 := by
    rw [div_pow, one_pow]
    exact one_div_le_one_div_of_le (by positivity) (pow_le_pow_left₀ hu.le huL 2)
  calc |C| * Q ^ 12 * (2 * (1 + lK) / Real.exp L)
      = (16 * |C| * Q ^ 12 * (1 + lK) * L ^ 2) / (8 * L ^ 2 * Real.exp L) := by
        field_simp; ring
    _ ≤ (c' * Real.exp L) / (8 * L ^ 2 * Real.exp L) := by gcongr
    _ = c' * (1 / L ^ 2) / 8 := by field_simp
    _ ≤ c' * (1 / u) ^ 2 / 8 := by gcongr

/-- The error of the `x`-shift, as a real inequality (`m = log log P'₁`, `F = Q!`,
`P = P'₂`). -/
lemma termB_real {c' C m u Q F P : ℝ} (C₂ : ℕ) (hc' : 0 < c') (hm1 : 1 ≤ m)
    (hmA : (16 * |C| / c' + 5) * m ^ (20 * C₂ + 10) ≤ Real.exp m)
    (hu : 0 < u) (hum : u ≤ m ^ 10) (hQ0 : 0 ≤ Q) (hQ : Q ≤ m ^ (10 * C₂))
    (hF0 : 0 ≤ F) (hF : F ≤ Real.exp (Q ^ 2)) (hP0 : 0 < P)
    (hP : Real.exp (4 * Real.exp m) ≤ P ^ 4) :
    2 * |C| * Q ^ 2 * F / P ^ 4 ≤ c' * (1 / u) ^ 2 / 8 := by
  set a : ℝ := 16 * |C| / c' with ha
  have ha0 : 0 ≤ a := by positivity
  have hp1 : 1 ≤ m ^ (20 * C₂ + 10) := one_le_pow₀ hm1
  have hQp : Q ≤ m ^ (20 * C₂ + 10) := hQ.trans (pow_le_pow_right₀ hm1 (by omega))
  have hQ2p : Q ^ 2 ≤ m ^ (20 * C₂ + 10) := by
    calc Q ^ 2 ≤ (m ^ (10 * C₂)) ^ 2 := pow_le_pow_left₀ hQ0 hQ 2
      _ = m ^ (20 * C₂) := by rw [← pow_mul]; ring_nf
      _ ≤ m ^ (20 * C₂ + 10) := pow_le_pow_right₀ hm1 (by omega)
  have hup : u ≤ m ^ (20 * C₂ + 10) := hum.trans (pow_le_pow_right₀ hm1 (by omega))
  have hem : 0 < Real.exp m := Real.exp_pos m
  have hsum : a + 2 * Q + Q ^ 2 + 2 * u ≤ 4 * Real.exp m := by
    have : a ≤ a * m ^ (20 * C₂ + 10) := le_mul_of_one_le_right ha0 hp1
    nlinarith
  have hxe : ∀ x : ℝ, x ≤ Real.exp x := fun x => by linarith [Real.add_one_le_exp x]
  have hsq : ∀ x : ℝ, 0 ≤ x → x ^ 2 ≤ Real.exp (2 * x) := fun x hx => by
    calc x ^ 2 ≤ Real.exp x ^ 2 := pow_le_pow_left₀ hx (hxe x) 2
      _ = Real.exp (2 * x) := by rw [← Real.exp_nat_mul]; norm_num
  have hprod : a * Q ^ 2 * F * u ^ 2 ≤ Real.exp (4 * Real.exp m) := by
    calc a * Q ^ 2 * F * u ^ 2
        ≤ Real.exp a * Real.exp (2 * Q) * Real.exp (Q ^ 2) * Real.exp (2 * u) := by
          gcongr
          · exact hxe a
          · exact hsq Q hQ0
          · exact hsq u hu.le
      _ = Real.exp (a + 2 * Q + Q ^ 2 + 2 * u) := by
          rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
      _ ≤ Real.exp (4 * Real.exp m) := Real.exp_le_exp.mpr hsum
  have key : 16 * |C| * Q ^ 2 * F * u ^ 2 ≤ c' * P ^ 4 := by
    have h := hprod.trans hP
    calc 16 * |C| * Q ^ 2 * F * u ^ 2 = c' * (a * Q ^ 2 * F * u ^ 2) := by
          rw [ha]; field_simp
      _ ≤ c' * P ^ 4 := mul_le_mul_of_nonneg_left h hc'.le
  calc 2 * |C| * Q ^ 2 * F / P ^ 4
      = (16 * |C| * Q ^ 2 * F * u ^ 2) / (8 * u ^ 2 * P ^ 4) := by field_simp; ring
    _ ≤ (c' * P ^ 4) / (8 * u ^ 2 * P ^ 4) := by gcongr
    _ = c' * (1 / u) ^ 2 / 8 := by field_simp

/-- `λQ!P'₂T ≥ 1`. -/
lemma one_le_K (D : Data) (Q : ℕ) : 1 ≤ D.lam * Q.factorial * D.P₂' * Nat.sqrt D.P₁ := by
  have h1 : 0 < D.lam := D.hlam
  have h2 : 0 < Q.factorial := Nat.factorial_pos Q
  have h3 : 0 < D.P₂' := by have := D.hP₁'; have := D.hP₁'P₂'; omega
  have h4 : 0 < Nat.sqrt D.P₁ := Nat.sqrt_pos.mpr (by have := P3.three_le_P₁ D; omega)
  exact Nat.mul_pos (Nat.mul_pos (Nat.mul_pos h1 h2) h3) h4

/-- `log(λQ!P'₂T) ≤ 3e^{L/4} + Q²` where `log N = e^L` (from `(log λ)⁴ ≤ log N`,
`(log P₂)⁴ < log N`, `P'₂, T < P₂` and `log Q! ≤ Q²`). -/
lemma log_K_le (D : Data) (Q : ℕ) {L : ℝ} (hL : Real.log D.N = Real.exp L) :
    Real.log ((D.lam * Q.factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) ≤
      3 * Real.exp (L / 4) + (Q : ℝ) ^ 2 := by
  have hlam : (1 : ℝ) ≤ D.lam := by exact_mod_cast D.hlam
  have hP₂'3 : 3 ≤ D.P₂' := by have := D.hP₁'; have := D.hP₁'P₂'; omega
  have hP₂' : (1 : ℝ) ≤ D.P₂' := by exact_mod_cast (show 1 ≤ D.P₂' by omega)
  have hT : 1 ≤ Nat.sqrt D.P₁ := Nat.sqrt_pos.mpr (by have := P3.three_le_P₁ D; omega)
  have hTR : (1 : ℝ) ≤ Nat.sqrt D.P₁ := by exact_mod_cast hT
  have hF : (1 : ℝ) ≤ Q.factorial := by exact_mod_cast Nat.factorial_pos Q
  have hP₂lt := P3.P₂'_lt_P₂ D
  have hP₂ : (1 : ℝ) ≤ D.P₂ := by exact_mod_cast (show 1 ≤ D.P₂ by omega)
  have hlogP₂ : Real.log D.P₂ ≤ Real.exp (L / 4) := by
    refine le_exp_quarter (Real.log_nonneg hP₂) ?_
    rw [← hL]
    exact D.hP₂N.le
  have hloglam : Real.log D.lam ≤ Real.exp (L / 4) := by
    refine le_exp_quarter (Real.log_nonneg hlam) ?_
    rw [← hL]
    exact D.hlamN
  have hlogP₂' : Real.log D.P₂' ≤ Real.log D.P₂ :=
    Real.log_le_log (by linarith) (by exact_mod_cast hP₂lt.le)
  have hlogT : Real.log (Nat.sqrt D.P₁) ≤ Real.log D.P₂ := by
    apply Real.log_le_log (by linarith)
    have h1 : Nat.sqrt D.P₁ ≤ D.P₁ := Nat.sqrt_le_self _
    have h2 : D.P₁ < D.P₂ := D.hP₁P₂
    exact_mod_cast (h1.trans h2.le)
  have hlogF := log_factorial_le Q
  push_cast
  rw [Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity)]
  linarith

/-- **`N` large for P6a.** With `A₁ = 80|C|/c'`, `p₁ = 14C₂ + 2`, `A₂ = 16|C|/c' + 5`,
`p₂ = 20C₂ + 10`, `x₀ = max(1, A₁2^{p₁}(p₁+1)!)`, `m₀ = max(1, A₂(p₂+1)!)`,
`L₀ = max(2x₀, m₀¹⁰)`, the threshold is `N₀ = ⌈exp(exp L₀)⌉`. Then `N ≥ 2` and both errors are
`≤ c'δ²/8`: the `n`-shift error `|C|Q¹²·2(1 + log(λQ!P'₂T))/log N` and the `x`-shift error
`2|C|Q²Q!/P'₂⁴`. -/
lemma growth6a (c' C : ℝ) (C₂ : ℕ) (hc' : 0 < c') : ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    2 ≤ D.N ∧
    |C| * ((D.Q C₂ : ℕ) : ℝ) ^ 12 * (2 * (1 + Real.log
        ((D.lam * (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ)) / Real.log D.N) ≤
      c' * D.δ ^ 2 / 8 ∧
    2 * |C| * ((D.Q C₂ : ℕ) : ℝ) ^ 2 * ((D.Q C₂).factorial : ℝ) / (D.P₂' : ℝ) ^ 4 ≤
      c' * D.δ ^ 2 / 8 := by
  set A₁ : ℝ := 80 * |C| / c' with hA₁
  set A₂ : ℝ := 16 * |C| / c' + 5 with hA₂
  set x₀ : ℝ := max 1 (A₁ * 2 ^ (14 * C₂ + 2) * ((14 * C₂ + 2 + 1).factorial : ℝ)) with hx₀
  set m₀ : ℝ := max 1 (A₂ * ((20 * C₂ + 10 + 1).factorial : ℝ)) with hm₀
  set L₀ : ℝ := max (2 * x₀) (m₀ ^ 10) with hL₀
  refine ⟨⌈Real.exp (Real.exp L₀)⌉₊, fun D hN => ?_⟩
  have hx₀1 : 1 ≤ x₀ := le_max_left _ _
  have hm₀1 : 1 ≤ m₀ := le_max_left _ _
  have hL₀x : 2 * x₀ ≤ L₀ := le_max_left _ _
  have hL₀m : m₀ ^ 10 ≤ L₀ := le_max_right _ _
  have hNr : Real.exp (Real.exp L₀) ≤ (D.N : ℝ) := (Nat.le_ceil _).trans (by exact_mod_cast hN)
  have hN0 : (0 : ℝ) < D.N := lt_of_lt_of_le (Real.exp_pos _) hNr
  have hy : Real.exp L₀ ≤ Real.log D.N := (Real.le_log_iff_exp_le hN0).mpr hNr
  have hy0 : 0 < Real.log D.N := lt_of_lt_of_le (Real.exp_pos _) hy
  have hL : L₀ ≤ Real.log (Real.log D.N) := (Real.le_log_iff_exp_le hy0).mpr hy
  have hyL : Real.log D.N = Real.exp (Real.log (Real.log D.N)) := (Real.exp_log hy0).symm
  have hL1 : 1 ≤ Real.log (Real.log D.N) := by linarith
  have hN2 : 2 ≤ D.N := by
    have h1 : Real.exp L₀ + 1 ≤ Real.exp (Real.exp L₀) := Real.add_one_le_exp _
    have h2 : L₀ + 1 ≤ Real.exp L₀ := Real.add_one_le_exp _
    have : (2 : ℝ) ≤ D.N := by linarith
    exact_mod_cast this
  have hu0 : 0 < 1 / D.δ := one_div_pos.mpr D.hδ
  have huL : 1 / D.δ ≤ Real.log (Real.log D.N) := D.hδN
  have hδu : D.δ = 1 / (1 / D.δ) := (one_div_one_div D.δ).symm
  have hQu : ((D.Q C₂ : ℕ) : ℝ) ≤ (1 / D.δ) ^ C₂ := Nat.floor_le (by positivity)
  have hQL : ((D.Q C₂ : ℕ) : ℝ) ≤ Real.log (Real.log D.N) ^ C₂ :=
    hQu.trans (pow_le_pow_left₀ hu0.le huL C₂)
  refine ⟨hN2, ?_, ?_⟩
  · -- the `n`-shift error
    have hK1 : (1 : ℝ) ≤ ((D.lam * (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) := by
      exact_mod_cast one_le_K D (D.Q C₂)
    have hLA : A₁ * Real.log (Real.log D.N) ^ (14 * C₂ + 2) ≤
        Real.exp (Real.log (Real.log D.N) / 2) := by
      have hx : x₀ ≤ Real.log (Real.log D.N) / 2 := by linarith
      have h := poly_le_exp (A := A₁ * 2 ^ (14 * C₂ + 2)) (14 * C₂ + 2) (hx₀1.trans hx)
        ((le_max_right _ _).trans hx)
      calc A₁ * Real.log (Real.log D.N) ^ (14 * C₂ + 2) =
            A₁ * 2 ^ (14 * C₂ + 2) * (Real.log (Real.log D.N) / 2) ^ (14 * C₂ + 2) := by
            rw [div_pow]; field_simp
        _ ≤ Real.exp (Real.log (Real.log D.N) / 2) := h
    rw [hyL, hδu]
    exact termA_real C₂ hc' hL1 hLA hu0 huL (Nat.cast_nonneg _) hQL (Real.log_nonneg hK1)
      (log_K_le D _ hyL)
  · -- the `x`-shift error
    have hP₁'3 : (3 : ℝ) ≤ D.P₁' := by exact_mod_cast D.hP₁'
    have hlogP₁' : 0 < Real.log D.P₁' := Real.log_pos (by linarith)
    have hm0 : 0 < Real.log (Real.log D.P₁') := Small.loglog_pos D.hP₁'
    have hLm : Real.log (Real.log D.N) ≤ Real.log (Real.log D.P₁') ^ 10 := D.hP₁'N
    have hmm₀ : m₀ ≤ Real.log (Real.log D.P₁') := by
      have h1 : m₀ ^ 10 ≤ Real.log (Real.log D.P₁') ^ 10 := hL₀m.trans (hL.trans hLm)
      exact (pow_le_pow_iff_left₀ (by linarith) hm0.le (by norm_num)).mp h1
    have hm1 : 1 ≤ Real.log (Real.log D.P₁') := hm₀1.trans hmm₀
    have hmA : A₂ * Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) ≤
        Real.exp (Real.log (Real.log D.P₁')) :=
      poly_le_exp (20 * C₂ + 10) hm1 ((le_max_right _ _).trans hmm₀)
    have hum : 1 / D.δ ≤ Real.log (Real.log D.P₁') ^ 10 := huL.trans hLm
    have hQm : ((D.Q C₂ : ℕ) : ℝ) ≤ Real.log (Real.log D.P₁') ^ (10 * C₂) := by
      calc ((D.Q C₂ : ℕ) : ℝ) ≤ Real.log (Real.log D.N) ^ C₂ := hQL
        _ ≤ (Real.log (Real.log D.P₁') ^ 10) ^ C₂ := pow_le_pow_left₀ (by linarith) hLm C₂
        _ = Real.log (Real.log D.P₁') ^ (10 * C₂) := by rw [← pow_mul]
    have hP₂'0 : (0 : ℝ) < D.P₂' := by
      have : 0 < D.P₂' := by have := D.hP₁'; have := D.hP₁'P₂'; omega
      exact_mod_cast this
    have hP : Real.exp (4 * Real.exp (Real.log (Real.log D.P₁'))) ≤ (D.P₂' : ℝ) ^ 4 := by
      have hem : Real.exp (Real.log (Real.log D.P₁')) = Real.log D.P₁' := Real.exp_log hlogP₁'
      have hle : Real.log D.P₁' ≤ Real.log D.P₂' :=
        Real.log_le_log (by linarith) (by exact_mod_cast D.hP₁'P₂'.le)
      have e4 : (4 : ℝ) * Real.log D.P₂' = Real.log ((D.P₂' : ℝ) ^ 4) := by
        rw [Real.log_pow]; norm_num
      calc Real.exp (4 * Real.exp (Real.log (Real.log D.P₁'))) ≤
            Real.exp (4 * Real.log D.P₂') := Real.exp_le_exp.mpr (by rw [hem]; linarith)
        _ = (D.P₂' : ℝ) ^ 4 := by rw [e4]; exact Real.exp_log (by positivity)
    rw [hδu]
    exact termB_real C₂ hc' hm1 hmA hu0 hum (Nat.cast_nonneg _) hQm (Nat.cast_nonneg _)
      (factorial_le_exp_sq _) hP₂'0 hP

/- ## Step P6b: nested averages -/

section Nested

variable {α β γ δ' : Type*}

/-- Move the outermost of four averages to the innermost position. -/
lemma comm3 (s₁ : Finset α) (w₁ : α → ℝ) (s₂ : Finset β) (w₂ : β → ℝ) (s₃ : Finset γ)
    (w₃ : γ → ℝ) (s₄ : Finset δ') (w₄ : δ' → ℝ) (F : α → β → γ → δ' → ℝ) :
    wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄
      (fun d => F a b c d)))) =
      wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d => wavg s₁ w₁
        (fun a => F a b c d)))) := by
  calc wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄
        (fun d => F a b c d))))
      = wavg s₂ w₂ (fun b => wavg s₁ w₁ (fun a => wavg s₃ w₃ (fun c => wavg s₄ w₄
        (fun d => F a b c d)))) := Elem.wavg_comm _ _ _ _ _
    _ = wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₁ w₁ (fun a => wavg s₄ w₄
        (fun d => F a b c d)))) := wavg_congr fun b _ => Elem.wavg_comm _ _ _ _ _
    _ = _ := wavg_congr fun b _ => wavg_congr fun c _ => Elem.wavg_comm _ _ _ _ _

/-- Pull a constant factor out of three averages. -/
lemma smul3 (s₁ : Finset α) (w₁ : α → ℝ) (s₂ : Finset β) (w₂ : β → ℝ) (s₃ : Finset γ)
    (w₃ : γ → ℝ) (k : ℝ) (F : α → β → γ → ℝ) :
    wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => k * F a b c))) =
      k * wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => F a b c))) := by
  rw [← wavg_smul]
  refine wavg_congr fun a _ => ?_
  rw [← wavg_smul]
  refine wavg_congr fun b _ => ?_
  rw [← wavg_smul]

/-- Jensen for three nested averages. -/
lemma jensen3 {s₁ : Finset α} {w₁ : α → ℝ} {s₂ : Finset β} {w₂ : β → ℝ} {s₃ : Finset γ}
    {w₃ : γ → ℝ} (h₁ : GoodWeights s₁ w₁) (h₂ : GoodWeights s₂ w₂) (h₃ : GoodWeights s₃ w₃)
    (F : α → β → γ → ℝ) :
    (wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => F a b c)))) ^ 2 ≤
      wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => F a b c ^ 2))) := by
  refine (Elem.wavg_sq_le h₁ _).trans (wavg_mono h₁ fun a _ => ?_)
  refine (Elem.wavg_sq_le h₂ _).trans (wavg_mono h₂ fun b _ => ?_)
  exact Elem.wavg_sq_le h₃ _

lemma wavg_add_const {s : Finset α} {w : α → ℝ} (h : GoodWeights s w) (f : α → ℝ) (c : ℝ) :
    wavg s w (fun x => f x + c) = wavg s w f + c := by
  rw [wavg_add, wavg_const h]

/-- Removing a condition `P` on the last two variables: for `|g| ≤ 1`,
`E_{a,b,c,d} g ≤ E_{a,b,c,d} 1_P g + E_{c,d} 1_{¬P}`. -/
lemma split_cond {s₁ : Finset α} {w₁ : α → ℝ} {s₂ : Finset β} {w₂ : β → ℝ} {s₃ : Finset γ}
    {w₃ : γ → ℝ} {s₄ : Finset δ'} {w₄ : δ' → ℝ} (h₁ : GoodWeights s₁ w₁)
    (h₂ : GoodWeights s₂ w₂) (h₃ : GoodWeights s₃ w₃) (h₄ : GoodWeights s₄ w₄)
    (P : γ → δ' → Prop) [∀ c d, Decidable (P c d)] (g : α → β → γ → δ' → ℝ)
    (hg : ∀ a b c d, |g a b c d| ≤ 1) :
    wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄
      (fun d => g a b c d)))) ≤
      wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄
        (fun d => (if P c d then (1 : ℝ) else 0) * g a b c d)))) +
      wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d => if P c d then (0 : ℝ) else 1)) := by
  set ν := wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d => if P c d then (0 : ℝ) else 1)) with hν
  have hpt : ∀ a b c d, g a b c d ≤
      (if P c d then (1 : ℝ) else 0) * g a b c d + (if P c d then (0 : ℝ) else 1) := by
    intro a b c d
    split_ifs
    · simp
    · simpa using (le_abs_self _).trans (hg a b c d)
  have hin : ∀ a b, wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d =>
      (if P c d then (1 : ℝ) else 0) * g a b c d + (if P c d then (0 : ℝ) else 1))) =
      wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d => (if P c d then (1 : ℝ) else 0) * g a b c d)) +
        ν := by
    intro a b
    rw [hν, ← wavg_add]
    exact wavg_congr fun c _ => wavg_add _ _
  calc wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄
        (fun d => g a b c d))))
      ≤ wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d =>
          (if P c d then (1 : ℝ) else 0) * g a b c d + (if P c d then (0 : ℝ) else 1))))) :=
        wavg_mono h₁ fun a _ => wavg_mono h₂ fun b _ => wavg_mono h₃ fun c _ =>
          wavg_mono h₄ fun d _ => hpt a b c d
    _ = wavg s₁ w₁ (fun a => wavg s₂ w₂ (fun b => wavg s₃ w₃ (fun c => wavg s₄ w₄ (fun d =>
          (if P c d then (1 : ℝ) else 0) * g a b c d)) + ν)) :=
        wavg_congr fun a _ => wavg_congr fun b _ => hin a b
    _ = _ := by
        rw [← wavg_add_const h₁]
        exact wavg_congr fun a _ => wavg_add_const h₂ _ _

/-- Cauchy–Schwarz with a nonnegative weight: `(E wY)² ≤ E w · E wY²`. -/
lemma cs_weighted {s : Finset α} (hs : s.Nonempty) (w Y : α → ℝ) (hw : ∀ x ∈ s, 0 ≤ w x) :
    (favg s (fun x => w x * Y x)) ^ 2 ≤ favg s w * favg s (fun x => w x * Y x ^ 2) := by
  have h := wavg_mul_sq_le (gwU hs) (fun x => Real.sqrt (w x)) (fun x => Real.sqrt (w x) * Y x)
  have e1 : wavg s (fun _ => (1 : ℝ)) (fun x => Real.sqrt (w x) * (Real.sqrt (w x) * Y x)) =
      favg s (fun x => w x * Y x) := by
    refine wavg_congr fun x hx => ?_
    rw [← mul_assoc, Real.mul_self_sqrt (hw x hx)]
  have e2 : wavg s (fun _ => (1 : ℝ)) (fun x => Real.sqrt (w x) ^ 2) = favg s w :=
    wavg_congr fun x hx => Real.sq_sqrt (hw x hx)
  have e3 : wavg s (fun _ => (1 : ℝ)) (fun x => (Real.sqrt (w x) * Y x) ^ 2) =
      favg s (fun x => w x * Y x ^ 2) :=
    wavg_congr fun x hx => by rw [mul_pow, Real.sq_sqrt (hw x hx)]
  rw [e1, e2, e3] at h
  exact h

end Nested

/- ## Step P6b: the functions `W`, `V`, `V_cop` and the Cauchy–Schwarz chain -/

/-- `f₁(np₂ + λxp₁ + λtQ!(p₁² - p₂²))`. -/
noncomputable def aF (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (x : ℤ) (p₁ p₂ t : ℕ) (n : ℤ) : ℝ :=
  f₁ (n * p₂ + (D.lam : ℤ) * x * p₁ +
    (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2))

/-- `f₁(np₁ + λxp₂)`. -/
noncomputable def bF (D : Data) (f₁ : ℤ → ℝ) (x : ℤ) (p₁ p₂ : ℕ) (n : ℤ) : ℝ :=
  f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)

/-- `W(x) = E^log_{p₁,p₂} E^log_n f₁(np₁ + λxp₂) E_t f₁(np₂ + λxp₁ + λtQ!(p₁² - p₂²))`. -/
noncomputable def Wf (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (x : ℤ) : ℝ :=
  lavg D.Pp fun p₁ => lavg D.Pp fun p₂ => logAvg D.N fun n =>
    bF D f₁ x p₁ p₂ n * uavg (Nat.sqrt D.P₁) fun t => aF D f₁ Q x p₁ p₂ t n

/-- `V(x) = E_{t,t'} E^log_{p₁,p₂} E^log_n a_t a_{t'}` (the inner average of `CS1` without the
coprimality condition). -/
noncomputable def Vf (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (x : ℤ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' => lavg D.Pp fun p₁ =>
    lavg D.Pp fun p₂ => logAvg D.N fun n => aF D f₁ Q x p₁ p₂ t n * aF D f₁ Q x p₁ p₂ t' n

/-- The inner average of `CS1`. -/
noncomputable def Vc (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (x : ℤ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' => lavg D.Pp fun p₁ =>
    lavg D.Pp fun p₂ => (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) *
      logAvg D.N fun n => aF D f₁ Q x p₁ p₂ t n * aF D f₁ Q x p₁ p₂ t' n

/-- The proportion `E^log_{p₁,p₂∈𝒫'} 1_{(p₁,p₂) ≠ 1}` of non-coprime pairs. -/
noncomputable def nu (D : Data) : ℝ :=
  lavg D.Pp fun p₁ => lavg D.Pp fun p₂ => if Nat.Coprime p₁ p₂ then (0 : ℝ) else 1

lemma CS1_eq (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λ : ℤ → ℝ) :
    CS1 D f₁ Q X Λ = favg (win X) (fun x => |Λ x| * Vc D f₁ Q x) := rfl

/-- Fubini: `Z524 = E_x Λ(x) W(x)`. -/
lemma Z524_eq (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λ : ℤ → ℝ) :
    Z524 D f₁ Q X Λ = favg (win X) (fun x => Λ x * Wf D f₁ Q x) := by
  unfold Z524 Wf uavg lavg favg logAvg
  rw [← comm3]
  refine wavg_congr fun x _ => ?_
  rw [smul3]
  congr 1
  rw [comm3]
  refine wavg_congr fun p₁ _ => wavg_congr fun p₂ _ => wavg_congr fun n _ => ?_
  beta_reduce
  rw [← wavg_smul]
  exact wavg_congr fun t _ => by unfold aF bF; ring

/-- Jensen three times, `|f₁| ≤ 1`, and `(E_t a_t)² = E_{t,t'} a_t a_{t'}`: `W(x)² ≤ V(x)`. -/
lemma Wf_sq_le (D : Data) (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q : ℕ) (hne : D.Pp.Nonempty)
    (hN : 1 ≤ D.N) (x : ℤ) :
    Wf D f₁ Q x ^ 2 ≤ Vf D f₁ Q x := by
  have hw := P3.gw_Pp hne
  have hn := goodWeights_logAvg hN
  have h1 : Wf D f₁ Q x ^ 2 ≤ lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ => logAvg D.N (fun n =>
      (bF D f₁ x p₁ p₂ n * uavg (Nat.sqrt D.P₁) (fun t => aF D f₁ Q x p₁ p₂ t n)) ^ 2))) :=
    jensen3 hw hw hn _
  have h2 : lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ => logAvg D.N (fun n =>
      (bF D f₁ x p₁ p₂ n * uavg (Nat.sqrt D.P₁) (fun t => aF D f₁ Q x p₁ p₂ t n)) ^ 2))) ≤
      lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ => logAvg D.N (fun n =>
        (uavg (Nat.sqrt D.P₁) (fun t => aF D f₁ Q x p₁ p₂ t n)) ^ 2))) := by
    refine wavg_mono hw fun p₁ _ => wavg_mono hw fun p₂ _ => wavg_mono hn fun n _ => ?_
    beta_reduce
    have hb : bF D f₁ x p₁ p₂ n ^ 2 ≤ 1 := (sq_le_one_iff_abs_le_one _).mpr (hf₁ _)
    rw [mul_pow]
    exact mul_le_of_le_one_left (sq_nonneg _) hb
  have h3 : lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ => logAvg D.N (fun n =>
      (uavg (Nat.sqrt D.P₁) (fun t => aF D f₁ Q x p₁ p₂ t n)) ^ 2))) = Vf D f₁ Q x := by
    have e : ∀ (p₁ p₂ : ℕ) (n : ℤ), (uavg (Nat.sqrt D.P₁) (fun t => aF D f₁ Q x p₁ p₂ t n)) ^ 2 =
        uavg (Nat.sqrt D.P₁) (fun t => uavg (Nat.sqrt D.P₁) (fun t' =>
          aF D f₁ Q x p₁ p₂ t n * aF D f₁ Q x p₁ p₂ t' n)) := fun p₁ p₂ n => P3.wavg_sq_eq _ _ _
    simp only [e]
    unfold Vf uavg lavg logAvg
    conv_lhs => rw [← comm3]
    refine wavg_congr fun t _ => ?_
    conv_lhs => rw [← comm3]
  linarith

/-- Removing the coprimality condition: `V(x) ≤ V_cop(x) + ν`. -/
lemma Vf_le (D : Data) (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q : ℕ) (hne : D.Pp.Nonempty)
    (hT : 1 ≤ Nat.sqrt D.P₁) (x : ℤ) : Vf D f₁ Q x ≤ Vc D f₁ Q x + nu D := by
  have hw := P3.gw_Pp hne
  have hu := goodWeights_uavg hT
  exact split_cond hu hu hw hw (fun p₁ p₂ => Nat.Coprime p₁ p₂)
    (fun t t' p₁ p₂ => logAvg D.N fun n => aF D f₁ Q x p₁ p₂ t n * aF D f₁ Q x p₁ p₂ t' n)
    (fun t t' p₁ p₂ => Small.abs_logAvg_le_one fun n => Elem.abs_mul_le_one (hf₁ _) (hf₁ _))

/-- `ν ≤ γ(𝒫')`: `Small.lemma52_indicator`, converted by `StepProdAvg`. -/
lemma nu_le (hProd : StepProdAvg) (D : Data) (hne : D.Pp.Nonempty) :
    nu D ≤ Small.gammaP D.k (P3.Sfam D) := by
  have hS := P3.goodSets_of_ne hne
  have hP := hProd D.k (P3.Sfam D) (P3.Sfam_prime D) (P3.Sfam_disj D)
  have e1 : ∀ a, lavg D.Pp (fun b => if Nat.Coprime a b then (0 : ℝ) else 1) =
      iterAvg D.k (P3.Sfam D) (fun b => if Nat.Coprime a (∏ ℓ, b ℓ) then (0 : ℝ) else 1) :=
    fun a => (hP (fun b => if Nat.Coprime a b then (0 : ℝ) else 1)).symm
  have e2 : nu D = iterAvg D.k (P3.Sfam D) (fun a =>
      lavg D.Pp (fun b => if Nat.Coprime (∏ ℓ, a ℓ) b then (0 : ℝ) else 1)) :=
    (hP (fun a => lavg D.Pp (fun b => if Nat.Coprime a b then (0 : ℝ) else 1))).symm
  rw [e2]
  simp only [e1]
  exact Small.lemma52_indicator (P3.Sfam D) hS

/-- **Triangle inequality, Cauchy–Schwarz, coprime pairs** (GS pp. 21–22):
`Z524² ≤ E|Λ| · CS1 + ν (E|Λ|)²`. -/
lemma Z_sq_le (D : Data) (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q X : ℕ) (hX : 1 ≤ X)
    (Λ : ℤ → ℝ) (hne : D.Pp.Nonempty) (hN : 1 ≤ D.N) (hT : 1 ≤ Nat.sqrt D.P₁) :
    Z524 D f₁ Q X Λ ^ 2 ≤ favg (win X) (fun x => |Λ x|) * CS1 D f₁ Q X Λ +
      nu D * favg (win X) (fun x => |Λ x|) ^ 2 := by
  have hs := win_nonempty hX
  have hw := gwU hs
  set M₃ := favg (win X) (fun x => |Λ x|)
  have hM₃0 : 0 ≤ M₃ := wavg_nonneg hw fun x _ => abs_nonneg _
  have habs : |Z524 D f₁ Q X Λ| ≤ favg (win X) (fun x => |Λ x| * |Wf D f₁ Q x|) := by
    rw [Z524_eq]
    refine (abs_wavg_le hw _).trans (le_of_eq ?_)
    exact wavg_congr fun x _ => abs_mul _ _
  have hcs := cs_weighted hs (fun x => |Λ x|) (fun x => |Wf D f₁ Q x|) (fun x _ => abs_nonneg _)
  have hW2 : favg (win X) (fun x => |Λ x| * |Wf D f₁ Q x| ^ 2) ≤ CS1 D f₁ Q X Λ + nu D * M₃ := by
    calc favg (win X) (fun x => |Λ x| * |Wf D f₁ Q x| ^ 2)
        ≤ favg (win X) (fun x => |Λ x| * Vc D f₁ Q x + nu D * |Λ x|) := by
          refine wavg_mono hw fun x _ => ?_
          rw [sq_abs]
          have h1 := (Wf_sq_le D f₁ hf₁ Q hne hN x).trans (Vf_le D f₁ hf₁ Q hne hT x)
          have h2 := mul_le_mul_of_nonneg_left h1 (abs_nonneg (Λ x))
          linarith
      _ = CS1 D f₁ Q X Λ + nu D * M₃ := by
          unfold favg
          rw [wavg_add, wavg_smul]
          rfl
  calc Z524 D f₁ Q X Λ ^ 2 = |Z524 D f₁ Q X Λ| ^ 2 := (sq_abs _).symm
    _ ≤ (favg (win X) (fun x => |Λ x| * |Wf D f₁ Q x|)) ^ 2 :=
        pow_le_pow_left₀ (abs_nonneg _) habs 2
    _ ≤ M₃ * favg (win X) (fun x => |Λ x| * |Wf D f₁ Q x| ^ 2) := hcs
    _ ≤ M₃ * (CS1 D f₁ Q X Λ + nu D * M₃) := mul_le_mul_of_nonneg_left hW2 hM₃0
    _ = M₃ * CS1 D f₁ Q X Λ + nu D * M₃ ^ 2 := by ring

/-- The final arithmetic of P6b. -/
lemma final_arith {c' δ Z M₃ CS ν : ℝ} (hc' : 0 < c') (hδ : 0 < δ)
    (hZ : c' * δ ^ 2 / 4 ≤ Z) (hZ2 : Z ^ 2 ≤ M₃ * CS + ν * M₃ ^ 2) (hν : ν ≤ 4 * δ ^ 5)
    (hsmall : 128 * δ * M₃ ^ 2 ≤ c' ^ 2) : (c' * δ ^ 2) ^ 2 / 32 ≤ M₃ * CS := by
  have h1 : (c' * δ ^ 2 / 4) ^ 2 ≤ Z ^ 2 := pow_le_pow_left₀ (by positivity) hZ 2
  have h2 : ν * M₃ ^ 2 ≤ 4 * δ ^ 5 * M₃ ^ 2 := mul_le_mul_of_nonneg_right hν (sq_nonneg _)
  have h3 : 4 * δ ^ 5 * M₃ ^ 2 ≤ (c' * δ ^ 2) ^ 2 / 32 := by
    have h4 := mul_le_mul_of_nonneg_left hsmall (show 0 ≤ δ ^ 4 / 32 by positivity)
    calc 4 * δ ^ 5 * M₃ ^ 2 = δ ^ 4 / 32 * (128 * δ * M₃ ^ 2) := by ring
      _ ≤ δ ^ 4 / 32 * c' ^ 2 := h4
      _ = (c' * δ ^ 2) ^ 2 / 32 := by ring
  have e : (c' * δ ^ 2 / 4) ^ 2 = (c' * δ ^ 2) ^ 2 / 16 := by ring
  linarith

/-- **`δ` small for P6b.** With `K = 128C²C₂²⁴/c'²` and `v₀ = max(1, 25!·K)`,
`δ₀ = min(1/2, e^{-v₀})`: for `δ ≤ δ₀` and `Q = ⌊δ^{-C₂}⌋`, `128δC²(log Q)²⁴ ≤ c'²`
(as `log Q ≤ C₂ log(1/δ)` and `K v²⁴ ≤ eᵛ` for `v = log(1/δ) ≥ v₀`). -/
lemma delta6b (c' C : ℝ) (C₂ : ℕ) (hc' : 0 < c') : ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ 1 / 2 ∧
    ∀ δ : ℝ, 0 < δ → δ ≤ δ₀ →
      128 * δ * (C ^ 2 * Real.log ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) ^ 24) ≤ c' ^ 2 := by
  set K : ℝ := 128 * C ^ 2 * (C₂ : ℝ) ^ 24 / c' ^ 2 with hK
  set v₀ : ℝ := max 1 (K * ((24 + 1).factorial : ℝ)) with hv₀
  refine ⟨min (1 / 2) (Real.exp (-v₀)), lt_min (by norm_num) (Real.exp_pos _),
    min_le_left _ _, ?_⟩
  intro δ hδ hδ₀
  have hδe : δ ≤ Real.exp (-v₀) := hδ₀.trans (min_le_right _ _)
  have hu0 : 0 < 1 / δ := one_div_pos.mpr hδ
  have hv : v₀ ≤ Real.log (1 / δ) := by
    rw [one_div, Real.log_inv]
    have h := Real.log_le_log hδ hδe
    rw [Real.log_exp] at h
    linarith
  have hv1 : 1 ≤ Real.log (1 / δ) := (le_max_left _ _).trans hv
  have hlogQ0 : 0 ≤ Real.log ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) := Real.log_natCast_nonneg _
  have hlogQ : Real.log ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) ≤ C₂ * Real.log (1 / δ) := by
    rcases Nat.eq_zero_or_pos ⌊(1 / δ) ^ C₂⌋₊ with h0 | hpos
    · rw [h0, Nat.cast_zero, Real.log_zero]
      have : (0 : ℝ) ≤ C₂ := Nat.cast_nonneg _
      nlinarith
    · have hQ : ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) ≤ (1 / δ) ^ C₂ := Nat.floor_le (by positivity)
      calc Real.log ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) ≤ Real.log ((1 / δ) ^ C₂) :=
            Real.log_le_log (by exact_mod_cast hpos) hQ
        _ = C₂ * Real.log (1 / δ) := Real.log_pow _ _
  have h24 : Real.log ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) ^ 24 ≤
      (C₂ : ℝ) ^ 24 * Real.log (1 / δ) ^ 24 := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ hlogQ0 hlogQ 24
  have hKv : K * Real.log (1 / δ) ^ 24 ≤ 1 / δ := by
    have h := poly_le_exp (A := K) 24 hv1 ((le_max_right _ _).trans hv)
    rwa [Real.exp_log hu0] at h
  have hc2 : 0 < c' ^ 2 := by positivity
  calc 128 * δ * (C ^ 2 * Real.log ((⌊(1 / δ) ^ C₂⌋₊ : ℕ) : ℝ) ^ 24)
      ≤ 128 * δ * (C ^ 2 * ((C₂ : ℝ) ^ 24 * Real.log (1 / δ) ^ 24)) := by gcongr
    _ = δ * c' ^ 2 * (K * Real.log (1 / δ) ^ 24) := by rw [hK]; field_simp
    _ ≤ δ * c' ^ 2 * (1 / δ) := by gcongr
    _ = c' ^ 2 := by field_simp

/-- `N ≥ 2`, from `0 < 1/δ ≤ log log N`. -/
lemma two_le_N (D : Data) : 2 ≤ D.N := by
  by_contra h
  have h01 : D.N = 0 ∨ D.N = 1 := by omega
  have h0 : Real.log (Real.log D.N) = 0 := by
    rcases h01 with h0 | h1
    · rw [h0]; simp
    · rw [h1]; simp
  have h1 := D.hδN
  have h2 : 0 < 1 / D.δ := one_div_pos.mpr D.hδ
  linarith

end P6ab

open P6ab in
/-- **Step P6a** (GS p. 21, (5.10) → (5.24)). Constants: `δ₀ = 1`, `N₀` from `P6ab.growth6a`. -/
theorem stepP6a : StepP6a := by
  intro c' C C₂ hc'
  obtain ⟨N₀, hN₀⟩ := growth6a c' C C₂ hc'
  refine ⟨1, one_pos, N₀, ?_⟩
  intro D _ hN f₁ hf₁ X hX1 _ Λper hPer hΦ
  obtain ⟨hper, hl1, -, hsup⟩ := hPer
  obtain ⟨hN2, hA, hB⟩ := hN₀ D hN
  have hP₁3 := P3.three_le_P₁ D
  have hX3 : 3 ≤ X := le_trans hP₁3 hX1
  have hXpos : (0 : ℝ) < X := by exact_mod_cast (show 0 < X by omega)
  have hT : 1 ≤ Nat.sqrt D.P₁ := Nat.sqrt_pos.mpr (by omega)
  have hδ := D.hδ
  -- `𝒫' ≠ ∅`, else `Φ = 0`
  have hne : D.Pp.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hemp
    have h0 : ∀ x, Phi D f₁ x = 0 := fun x => by
      unfold Phi lavg wavg
      rw [hemp]
      simp
    have h1 : favg (win X) (fun x => Λper x * Phi D f₁ x) = 0 := by
      simp only [h0, mul_zero]
      unfold favg wavg
      simp
    have : 0 < c' * D.δ ^ 2 / 2 := by positivity
    linarith
  have hM0 : 0 ≤ C * ((D.Q C₂ : ℕ) : ℝ) ^ 2 := le_trans (abs_nonneg _) (hsup 0)
  have hclose : ∀ t ∈ Icc 1 (Nat.sqrt D.P₁), ∀ p₁ ∈ D.Pp, ∀ p₂ ∈ D.Pp,
      |favg (win X) (fun x => Λper x * logAvg D.N (Fz D f₁ (D.Q C₂) t p₁ p₂ x)) -
        favg (win X) (fun x => Λper x * logAvg D.N (Fp D f₁ p₁ p₂ x))| ≤
      favg (win X) (fun x => |Λper x|) * (2 * (1 + Real.log
          ((D.lam * (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ)) / Real.log D.N) +
        2 * (((D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) *
          (C * ((D.Q C₂ : ℕ) : ℝ) ^ 2) / X := by
    intro t ht p₁ hp₁ p₂ hp₂
    have ht' := (Finset.mem_Icc.mp ht).2
    have hp₁' := (P3.mem_Pp hp₁).2
    have hp₂' := (P3.mem_Pp hp₂).2
    refine inner_close D hN2 f₁ hf₁ (D.Q C₂) X (by omega) Λper hper hM0 hsup t p₁ p₂ _ _ ?_ ?_
    · exact Nat.mul_le_mul (Nat.mul_le_mul_left _ hp₂') ht'
    · exact Nat.mul_le_mul (Nat.mul_le_mul_left _ hp₁') ht'
  have hZ := Z524_ge D f₁ (D.Q C₂) X Λper hne hT hclose
  -- the `n`-shift error
  have hM3 : favg (win X) (fun x => |Λper x|) ≤ C * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 12 := by
    rw [P3.favg_win, div_le_iff₀ hXpos]
    exact hl1
  have hlogQ : Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 12 ≤ ((D.Q C₂ : ℕ) : ℝ) ^ 12 :=
    pow_le_pow_left₀ (Real.log_natCast_nonneg _) (Real.log_le_self (Nat.cast_nonneg _)) 12
  have hM3' : favg (win X) (fun x => |Λper x|) ≤ |C| * ((D.Q C₂ : ℕ) : ℝ) ^ 12 := by
    refine hM3.trans ?_
    calc C * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 12 ≤ |C| * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 12 :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity)
      _ ≤ |C| * ((D.Q C₂ : ℕ) : ℝ) ^ 12 := mul_le_mul_of_nonneg_left hlogQ (abs_nonneg C)
  have he₂ : 0 ≤ 2 * (1 + Real.log
      ((D.lam * (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ)) / Real.log D.N := by
    have hK1 : (1 : ℝ) ≤ ((D.lam * (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) := by
      exact_mod_cast one_le_K D (D.Q C₂)
    have := Real.log_nonneg hK1
    have hlogN : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
    positivity
  have hErrA := (mul_le_mul_of_nonneg_right hM3' he₂).trans hA
  -- the `x`-shift error: `S P'₂⁴ ≤ Q! X` as `P'₂⁵ ≤ T`, `T² ≤ P₁ ≤ X`
  have hSX : (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ * D.P₂' ^ 4 ≤
      (D.Q C₂).factorial * X := by
    have h5 : D.P₂' ^ 5 ≤ Nat.sqrt D.P₁ := by
      have h10 : (D.P₂' ^ 5) ^ 2 ≤ D.P₁ := by rw [← pow_mul]; exact D.hpow
      calc D.P₂' ^ 5 = Nat.sqrt ((D.P₂' ^ 5) ^ 2) := (Nat.sqrt_eq' _).symm
        _ ≤ Nat.sqrt D.P₁ := Nat.sqrt_le_sqrt h10
    have hTT : Nat.sqrt D.P₁ * Nat.sqrt D.P₁ ≤ D.P₁ := Nat.sqrt_le D.P₁
    calc (D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ * D.P₂' ^ 4 =
          (D.Q C₂).factorial * (D.P₂' ^ 5 * Nat.sqrt D.P₁) := by ring
      _ ≤ (D.Q C₂).factorial * (Nat.sqrt D.P₁ * Nat.sqrt D.P₁) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ h5)
      _ ≤ (D.Q C₂).factorial * X := Nat.mul_le_mul_left _ (hTT.trans hX1)
  have hP₂'0 : (0 : ℝ) < D.P₂' := by
    have : 0 < D.P₂' := by have := D.hP₁'; have := D.hP₁'P₂'; omega
    exact_mod_cast this
  have hSXr : (((D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) / X ≤
      ((D.Q C₂).factorial : ℝ) / (D.P₂' : ℝ) ^ 4 := by
    rw [div_le_div_iff₀ hXpos (by positivity)]
    exact_mod_cast hSX
  have hMle : C * ((D.Q C₂ : ℕ) : ℝ) ^ 2 ≤ |C| * ((D.Q C₂ : ℕ) : ℝ) ^ 2 :=
    mul_le_mul_of_nonneg_right (le_abs_self C) (sq_nonneg _)
  have hErrB : 2 * (((D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) *
      (C * ((D.Q C₂ : ℕ) : ℝ) ^ 2) / X ≤ c' * D.δ ^ 2 / 8 := by
    calc 2 * (((D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) *
          (C * ((D.Q C₂ : ℕ) : ℝ) ^ 2) / X =
          2 * (C * ((D.Q C₂ : ℕ) : ℝ) ^ 2) *
            ((((D.Q C₂).factorial * D.P₂' * Nat.sqrt D.P₁ : ℕ) : ℝ) / X) := by ring
      _ ≤ 2 * (|C| * ((D.Q C₂ : ℕ) : ℝ) ^ 2) *
            (((D.Q C₂).factorial : ℝ) / (D.P₂' : ℝ) ^ 4) := by
          gcongr
      _ = 2 * |C| * ((D.Q C₂ : ℕ) : ℝ) ^ 2 * ((D.Q C₂).factorial : ℝ) / (D.P₂' : ℝ) ^ 4 := by
          ring
      _ ≤ c' * D.δ ^ 2 / 8 := hB
  linarith

open P6ab in
/-- **Step P6b** (GS pp. 21–22), from the product identity `StepProdAvg`. Constants:
`δ₀ = min(δ₀(delta6b), 1/(2C_M + 1))` (`C_M ≥ 0` the Mertens constant), `N₀ = 0`. -/
theorem stepP6b (hProd : StepProdAvg) : StepP6b := by
  intro c' C C₂ hc'
  obtain ⟨C_M, hCM0, hM⟩ := MertensProof.mertensLower
  obtain ⟨δ₁, hδ₁, hδ₁h, hδ₁K⟩ := delta6b c' C C₂ hc'
  have hCM1 : 0 < 2 * C_M + 1 := by linarith
  refine ⟨min δ₁ (1 / (2 * C_M + 1)), lt_min hδ₁ (by positivity), 0, ?_⟩
  intro D hδ₀ _ f₁ hf₁ X hX1 _ Λper hPer hZ
  obtain ⟨-, hl1, -, -⟩ := hPer
  simp only [le_min_iff] at hδ₀
  obtain ⟨hδδ₁, hδM⟩ := hδ₀
  have hδ := D.hδ
  have hδh : D.δ ≤ 1 / 2 := hδδ₁.trans hδ₁h
  have hδ1 : D.δ ≤ 1 := by linarith
  have hδ5 : D.δ ^ 5 ≤ D.δ := pow_le_of_le_one hδ.le hδ1 (by norm_num)
  have hδC : 2 * C_M * D.δ ^ 5 ≤ 1 := by
    have h1 : D.δ * (2 * C_M + 1) ≤ 1 := (le_div_iff₀ hCM1).mp hδM
    have h2 : C_M * D.δ ^ 5 ≤ C_M * D.δ := mul_le_mul_of_nonneg_left hδ5 hCM0
    nlinarith
  have hN : 1 ≤ D.N := le_trans (by norm_num) (two_le_N D)
  have hP₁3 := P3.three_le_P₁ D
  have hX3 : 3 ≤ X := le_trans hP₁3 hX1
  have hXpos : (0 : ℝ) < X := by exact_mod_cast (show 0 < X by omega)
  have hT : 1 ≤ Nat.sqrt D.P₁ := Nat.sqrt_pos.mpr (by omega)
  -- `𝒫' ≠ ∅`, else `Z524 = 0`
  have hne : D.Pp.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hemp
    have hW0 : ∀ x, Wf D f₁ (D.Q C₂) x = 0 := fun x => by
      unfold Wf lavg wavg
      rw [hemp]
      simp
    have h0 : Z524 D f₁ (D.Q C₂) X Λper = 0 := by
      rw [Z524_eq]
      simp only [hW0, mul_zero]
      unfold favg wavg
      simp
    have : 0 < c' * D.δ ^ 2 / 4 := by positivity
    linarith
  -- GS Lemma 5.2: `ν ≤ γ(𝒫') ≤ 4δ⁵`
  have hγ : Small.gammaP D.k (P3.Sfam D) ≤ 4 * D.δ ^ 5 :=
    Small.lemma52_prop51 D.hk hM hδ hδh hδC D.lo D.hi D.hP₁' D.hI D.hdisj D.hwidth
  have hν := (nu_le hProd D hne).trans hγ
  -- `E|Λ_per| ≤ C log¹² Q`, so `128δ(E|Λ_per|)² ≤ c'²`
  have hM₃0 : 0 ≤ favg (win X) (fun x => |Λper x|) :=
    wavg_nonneg (gwU (win_nonempty (by omega))) fun x _ => abs_nonneg _
  have hM₃ : favg (win X) (fun x => |Λper x|) ≤ C * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 12 := by
    rw [P3.favg_win, div_le_iff₀ hXpos]
    exact hl1
  have hsmall : 128 * D.δ * favg (win X) (fun x => |Λper x|) ^ 2 ≤ c' ^ 2 := by
    have h1 : favg (win X) (fun x => |Λper x|) ^ 2 ≤
        C ^ 2 * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 24 := by
      calc _ ≤ (C * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 12) ^ 2 := pow_le_pow_left₀ hM₃0 hM₃ 2
        _ = C ^ 2 * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 24 := by ring
    calc 128 * D.δ * favg (win X) (fun x => |Λper x|) ^ 2 ≤
          128 * D.δ * (C ^ 2 * Real.log ((D.Q C₂ : ℕ) : ℝ) ^ 24) := by gcongr
      _ ≤ c' ^ 2 := hδ₁K D.δ hδ hδδ₁
  exact P6ab.final_arith hc' hδ hZ
    (Z_sq_le D f₁ hf₁ (D.Q C₂) X (by omega) Λper hne hN hT) hν hsmall

end G22.P51

end

/- ## Section: `P51P6cd` -/

section

/-
# Steps P6c and P6d of GS Proposition 5.1 (GS p. 22, (5.25)–(5.26))

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. The statements `StepP6c`, `StepP6d` are in
`Prop51Steps.lean`, the sketches in `notes/prop51_steps.md`. This file proves

* `G22.P51.stepP6c : StepP6c` and `G22.P51.stepP6d : StepP6d`;

the helpers live in `G22.P51.P6cd`.

Notation: `Q = ⌊δ^{-C₂}⌋`, `F = Q!`, `K = C log¹² Q`, `M = E_{[X,2X)} |Λ_per| ≤ K` (from
`PerHyp`), `T = ⌊√P₁⌋`, `d = p₁² − p₂²`, `ker(y) = f₁(y + λtFd) f₁(y + λt'Fd)` (`P6cd.ker`).
`I1 h` and `I2 h` are the inner averages of `CS1` and `Z525` at `h`, so
`CS1 = E_h |Λ_per(h)| I1(h)` and `Z525 = E_h |Λ_per(h)| I2(h)` (both by `rfl`).

## P6c
1. (`P6cd.step1`) Put `H = X' = ⌊δ⁵X/F⌋`. For `h' ∈ [H]`, periodicity turns
   `E_h |Λ_per(h)| I1(h + Fh')` into the same sum over `[X + Fh', 2X + Fh')`. The two edge sums
   have length `Fh' ≤ δ⁵X` and are `≤ h'KF` by (4.17), applied `h'` times (`P6cd.sum_block_le`).
   Averaging over `h'` gives `E_h |Λ_per(h)| E_{h'} I1(h + Fh') ≥ CS1 − 2δ⁵K`.
2. (`P6cd.A3_h`) Use Fubini, then GS Lemma A.3 (`Small.lemmaA3`) for each `(t, t', p₁, p₂)` with
   `(p₁, p₂) = 1`, taking `q = p₂` and `b = λFp₁`. These are coprime: the primes of `λ` and of `F`
   are `< P'₁` (`D.hlamP`, and `Q < P'₁`), while those of `p₂` are `≥ P'₁`
   (`P6cd.prime_factor_ge`). This gives `|E_{h'} I1(h + Fh') − I2(h)| ≤ err_A`, where
   `err_A = 5((1 + log P'₂ + log(λP'₂X))/log N + P'₂/H)`.
3. (`P6cd.core_c`) `M·CS1 ≤ M·Z525 + 2δ⁵K² + K² err_A`, and each error term is `≤ (c'δ²)²/128`.

## P6d
1. (`P6cd.I2_close`) GS (A.2) (`Elem.logAvg_shift_le'`) removes the shift `λhp₁`, which has
   `|λhp₁| ≤ 2λXP'₂`. So `|I2(h) − G_cop| ≤ err_D = 2(1 + log(2λXP'₂))/log N` for
   `h ∈ [X, 2X)`, where `G_cop` (`P6cd.Gcop`) no longer depends on `h`.
2. (`P6cd.Gcop_eq`, `P6cd.Gfun_nonneg`) By Fubini, `G_cop = E^log_{p₁,p₂} 1_{(p₁,p₂)=1} Gfun`.
   Also `Gfun = E^log_n (E_t f₁(n + λtFd))² ≥ 0`, so `0 ≤ G_cop ≤ E^log E^log Gfun`.
3. (`P6cd.core_d`) `(c'δ²)²/64 ≤ M·Z525 ≤ M²(G_cop + err_D) ≤ K²(G_cop + err_D)`. If
   `E^log E^log Gfun < δ⁵`, this is `≤ K²(δ⁵ + err_D) ≤ (c'δ²)²/128`, a contradiction.

## Constants
Let `V = C²C₂²⁴` and `L = log log N`.
* `δ₀`, for both steps (`P6cd.delta_small`): `δ₀ = 1/max(y₀, 2)`, where
  `(256V/c'² + 1) log²⁴ y ≤ y` for `y ≥ y₀` (`isLittleO_pow_log_id_atTop`). Since
  `0 ≤ log Q ≤ C₂ log(1/δ)`, this gives `256 K² δ ≤ c'²`.
* `N₀ = ⌈exp exp L₀⌉`:
  - for P6c, `L₀ = max(1, ((log 2A₀ + 34)·(20C₂ + 11)!)¹⁰, 3B·29!, (3B)⁴·113!)` with
    `A₀ = 1280V/c'² + 1` and `B = 3840V/c'²`;
  - for P6d, `L₀ = max(1, 3B·29!, (3B)⁴·113!)` with `B = 1024V/c'²`.

For `L ≥ L₀` the following hold.
* `2A₀L³³Q! ≤ P'₁` (`P6cd.fact_le_P1'`). Here `log Q! ≤ Q² ≤ L^{2C₂}`, while
  `log P'₁ = exp(log log P'₁)` and `(log log P'₁)¹⁰ ≥ L`. Hence `Q < P'₁`, and
  `H ≥ A₀L²⁸P'₂` since `X ≥ P₁ ≥ P'₂¹⁰` and `δ ≥ 1/L` (`P6cd.H_facts`).
* `B L²⁸ (1 + log λ + log P₂) ≤ log N` (`P6cd.logs_le`), from `(log λ)⁴ ≤ log N` and
  `(log P₂)⁴ < log N`.
* `K² ≤ V L²⁸ δ⁴` (`P6cd.K0_sq_le'`). So `128 K² err_A ≤ c'²δ⁴` (`P6cd.small2_c`) and
  `256 K² err_D ≤ c'²δ⁴` (`P6cd.small2_d`).
-/

open Finset Real

namespace G22.P51

namespace P6cd

/- ## 1. Averages with non-negative weights (no `GoodWeights` needed) -/

section Gen
variable {α : Type*}

lemma wavg_abs_le {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) {f : α → ℝ} {c : ℝ}
    (hc : 0 ≤ c) (hf : ∀ x ∈ s, |f x| ≤ c) : |wavg s w f| ≤ c := by
  unfold wavg
  rcases (Finset.sum_nonneg hw).eq_or_lt with h0 | hpos
  · rw [← h0, div_zero, abs_zero]; exact hc
  · rw [abs_div, abs_of_pos hpos, div_le_iff₀ hpos]
    calc |∑ x ∈ s, w x * f x| ≤ ∑ x ∈ s, |w x * f x| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ x ∈ s, c * w x := Finset.sum_le_sum fun x hx => by
          rw [abs_mul, abs_of_nonneg (hw x hx), mul_comm c]
          exact mul_le_mul_of_nonneg_left (hf x hx) (hw x hx)
      _ = c * ∑ x ∈ s, w x := by rw [Finset.mul_sum]

lemma wavg_sub_abs_le {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) {f g : α → ℝ}
    {ε : ℝ} (hε : 0 ≤ ε) (hfg : ∀ x ∈ s, |f x - g x| ≤ ε) :
    |wavg s w f - wavg s w g| ≤ ε := by
  rw [← wavg_sub]
  exact wavg_abs_le hw hε hfg

lemma wavg_mono' {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) {f g : α → ℝ}
    (hfg : ∀ x ∈ s, f x ≤ g x) : wavg s w f ≤ wavg s w g := by
  unfold wavg
  apply div_le_div_of_nonneg_right _ (Finset.sum_nonneg hw)
  exact Finset.sum_le_sum fun x hx => mul_le_mul_of_nonneg_left (hfg x hx) (hw x hx)

lemma wavg_nonneg' {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) {f : α → ℝ}
    (hf : ∀ x ∈ s, 0 ≤ f x) : 0 ≤ wavg s w f := by
  unfold wavg
  exact div_nonneg (Finset.sum_nonneg fun x hx => mul_nonneg (hw x hx) (hf x hx))
    (Finset.sum_nonneg hw)

lemma wavg_zero' (s : Finset α) (w : α → ℝ) : wavg s w (fun _ => 0) = 0 := by
  simp [wavg]

end Gen

lemma uw_nonneg (s : Finset ℕ) : ∀ x ∈ s, (0 : ℝ) ≤ (fun _ : ℕ => (1 : ℝ)) x :=
  fun _ _ => zero_le_one

lemma lw_nonneg (s : Finset ℕ) : ∀ x ∈ s, (0 : ℝ) ≤ (fun p : ℕ => 1 / (p : ℝ)) x :=
  fun _ _ => by positivity

lemma uavg_sub_le {H : ℕ} {f g : ℕ → ℝ} {ε : ℝ} (hε : 0 ≤ ε)
    (hfg : ∀ x, |f x - g x| ≤ ε) : |uavg H f - uavg H g| ≤ ε :=
  wavg_sub_abs_le (uw_nonneg _) hε fun x _ => hfg x

lemma lavg_sub_le {S : Finset ℕ} {f g : ℕ → ℝ} {ε : ℝ} (hε : 0 ≤ ε)
    (hfg : ∀ x ∈ S, |f x - g x| ≤ ε) : |lavg S f - lavg S g| ≤ ε :=
  wavg_sub_abs_le (lw_nonneg _) hε hfg

lemma uavg_abs_le {H : ℕ} {f : ℕ → ℝ} {c : ℝ} (hc : 0 ≤ c) (hf : ∀ x, |f x| ≤ c) :
    |uavg H f| ≤ c :=
  wavg_abs_le (uw_nonneg _) hc fun x _ => hf x

lemma lavg_abs_le {S : Finset ℕ} {f : ℕ → ℝ} {c : ℝ} (hc : 0 ≤ c) (hf : ∀ x ∈ S, |f x| ≤ c) :
    |lavg S f| ≤ c :=
  wavg_abs_le (lw_nonneg _) hc hf

lemma logAvg_abs_le {N : ℕ} {f : ℤ → ℝ} {c : ℝ} (hc : 0 ≤ c) (hf : ∀ n, |f n| ≤ c) :
    |logAvg N f| ≤ c :=
  wavg_abs_le (fun _ _ => by positivity) hc fun n _ => hf n

lemma lavg_mono {S : Finset ℕ} {f g : ℕ → ℝ} (hfg : ∀ x ∈ S, f x ≤ g x) :
    lavg S f ≤ lavg S g :=
  wavg_mono' (lw_nonneg _) hfg

lemma lavg_nonneg {S : Finset ℕ} {f : ℕ → ℝ} (hf : ∀ x ∈ S, 0 ≤ f x) : 0 ≤ lavg S f :=
  wavg_nonneg' (lw_nonneg _) hf

lemma uavg_nonneg {H : ℕ} {f : ℕ → ℝ} (hf : ∀ x, 0 ≤ f x) : 0 ≤ uavg H f :=
  wavg_nonneg' (uw_nonneg _) fun x _ => hf x

/- ## 2. The window `[X, 2X)` -/

lemma card_win (X : ℕ) : (win X).card = X := by
  unfold win
  rw [Int.card_Ico]
  have : 2 * (X : ℤ) - X = X := by ring
  rw [this]
  exact Int.toNat_natCast X

lemma favg_win (X : ℕ) (g : ℤ → ℝ) : favg (win X) g = (∑ x ∈ win X, g x) / X := by
  unfold favg wavg
  simp only [one_mul, Finset.sum_const, card_win, nsmul_eq_mul, mul_one]

lemma favg_win_mono {X : ℕ} {f g : ℤ → ℝ} (hfg : ∀ x ∈ win X, f x ≤ g x) :
    favg (win X) f ≤ favg (win X) g :=
  wavg_mono' (fun _ _ => zero_le_one) hfg

/- ## 3. The inner averages -/

/-- `f₁(y + λtQ!(p₁² − p₂²)) f₁(y + λt'Q!(p₁² − p₂²))`. -/
noncomputable def ker (D : Data) (f₁ : ℤ → ℝ) (Q p₁ p₂ t t' : ℕ) (y : ℤ) : ℝ :=
  f₁ (y + (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
    f₁ (y + (D.lam : ℤ) * t' * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2))

lemma abs_ker_le (D : Data) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q p₁ p₂ t t' : ℕ) (y : ℤ) :
    |ker D f₁ Q p₁ p₂ t t' y| ≤ 1 := by
  unfold ker
  rw [abs_mul]
  exact mul_le_one₀ (hf₁ _) (abs_nonneg _) (hf₁ _)

/-- The coprimality indicator. -/
lemma abs_cop_le (p₁ p₂ : ℕ) : |(if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0)| ≤ 1 := by
  split_ifs <;> simp

/-- The inner average of `CS1` at `h`. -/
noncomputable def I1 (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (h : ℤ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
    lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
      (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) *
        logAvg D.N fun n => ker D f₁ Q p₁ p₂ t t' (n * p₂ + (D.lam : ℤ) * h * p₁)

/-- The inner average of `Z525` at `h`. -/
noncomputable def I2 (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (h : ℤ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
    lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
      (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) *
        logAvg D.N fun n => ker D f₁ Q p₁ p₂ t t' (n + (D.lam : ℤ) * h * p₁)

/-- The `h`-free average after the A.2 shift: `E_{t,t'} E^log_{p₁,p₂} 1_{cop} E^log_n ker`. -/
noncomputable def Gcop (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
    lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
      (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) * logAvg D.N (ker D f₁ Q p₁ p₂ t t')

lemma CS1_eq (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λper : ℤ → ℝ) :
    CS1 D f₁ Q X Λper = favg (win X) fun h => |Λper h| * I1 D f₁ Q h := rfl

lemma Z525_eq (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λper : ℤ → ℝ) :
    Z525 D f₁ Q X Λper = favg (win X) fun h => |Λper h| * I2 D f₁ Q h := rfl

lemma Gfun_eq (D : Data) (f₁ : ℤ → ℝ) (Q p₁ p₂ : ℕ) :
    Gfun D f₁ Q p₁ p₂ = uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
      logAvg D.N (ker D f₁ Q p₁ p₂ t t') := rfl

lemma abs_I1_le (D : Data) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q : ℕ) (h : ℤ) :
    |I1 D f₁ Q h| ≤ 1 := by
  unfold I1
  refine uavg_abs_le zero_le_one fun t => uavg_abs_le zero_le_one fun t' =>
    lavg_abs_le zero_le_one fun p₁ _ => lavg_abs_le zero_le_one fun p₂ _ => ?_
  rw [abs_mul]
  exact mul_le_one₀ (abs_cop_le p₁ p₂) (abs_nonneg _)
    (logAvg_abs_le zero_le_one fun n => abs_ker_le D hf₁ _ _ _ _ _ _)

/- ## 4. Fubini -/

lemma comm_H (H T : ℕ) (S : Finset ℕ) (J : ℕ → ℕ → ℕ → ℕ → ℕ → ℝ) :
    (uavg H fun h' => uavg T fun t => uavg T fun t' => lavg S fun p₁ => lavg S fun p₂ =>
      J h' t t' p₁ p₂) =
    uavg T fun t => uavg T fun t' => lavg S fun p₁ => lavg S fun p₂ => uavg H fun h' =>
      J h' t t' p₁ p₂ := by
  unfold uavg lavg
  refine (Elem.wavg_comm _ _ _ _ _).trans (wavg_congr fun t _ => ?_)
  refine (Elem.wavg_comm _ _ _ _ _).trans (wavg_congr fun t' _ => ?_)
  refine (Elem.wavg_comm _ _ _ _ _).trans (wavg_congr fun p₁ _ => ?_)
  exact Elem.wavg_comm _ _ _ _ _

lemma comm_TT (T : ℕ) (S : Finset ℕ) (J : ℕ → ℕ → ℕ → ℕ → ℝ) :
    (uavg T fun t => uavg T fun t' => lavg S fun p₁ => lavg S fun p₂ => J t t' p₁ p₂) =
    lavg S fun p₁ => lavg S fun p₂ => uavg T fun t => uavg T fun t' => J t t' p₁ p₂ := by
  unfold uavg lavg
  have h1 : ∀ t, (wavg (Icc 1 T) (fun _ => (1 : ℝ)) fun t' =>
      wavg S (fun p : ℕ => 1 / (p : ℝ)) fun p₁ => wavg S (fun p : ℕ => 1 / (p : ℝ)) fun p₂ =>
        J t t' p₁ p₂) =
      wavg S (fun p : ℕ => 1 / (p : ℝ)) fun p₁ => wavg S (fun p : ℕ => 1 / (p : ℝ)) fun p₂ =>
        wavg (Icc 1 T) (fun _ => (1 : ℝ)) fun t' => J t t' p₁ p₂ := fun t =>
    (Elem.wavg_comm _ _ _ _ _).trans (wavg_congr fun p₁ _ => Elem.wavg_comm _ _ _ _ _)
  rw [wavg_congr fun t _ => h1 t]
  refine (Elem.wavg_comm _ _ _ _ _).trans (wavg_congr fun p₁ _ => ?_)
  exact Elem.wavg_comm _ _ _ _ _

lemma uavg_uavg_logAvg (T N : ℕ) (a : ℕ → ℤ → ℝ) :
    (uavg T fun t => uavg T fun t' => logAvg N fun n => a t n * a t' n) =
      logAvg N fun n => (uavg T fun t => a t n) ^ 2 := by
  have h1 : ∀ t, (uavg T fun t' => logAvg N fun n => a t n * a t' n) =
      logAvg N fun n => uavg T fun t' => a t n * a t' n := fun t =>
    (Elem.logAvg_uavg_comm N T (fun t' n => a t n * a t' n)).symm
  rw [show (uavg T fun t => uavg T fun t' => logAvg N fun n => a t n * a t' n) =
      uavg T fun t => logAvg N fun n => uavg T fun t' => a t n * a t' n from
    wavg_congr fun t _ => h1 t]
  rw [← Elem.logAvg_uavg_comm N T (fun t n => uavg T fun t' => a t n * a t' n)]
  unfold logAvg
  refine wavg_congr fun n _ => ?_
  show (uavg T fun t => uavg T fun t' => a t n * a t' n) = (uavg T fun t => a t n) ^ 2
  have h2 : ∀ t, (uavg T fun t' => a t n * a t' n) = a t n * uavg T fun t' => a t' n :=
    fun t => wavg_smul (a t n) (fun t' => a t' n)
  rw [show (uavg T fun t => uavg T fun t' => a t n * a t' n) =
      uavg T fun t => a t n * uavg T fun t' => a t' n from wavg_congr fun t _ => h2 t]
  unfold uavg
  rw [← Elem.wavg_mul_const, sq]

lemma Gfun_nonneg (D : Data) (f₁ : ℤ → ℝ) (Q p₁ p₂ : ℕ) : 0 ≤ Gfun D f₁ Q p₁ p₂ := by
  rw [Gfun_eq]
  unfold ker
  rw [uavg_uavg_logAvg (Nat.sqrt D.P₁) D.N
    (fun t n => f₁ (n + (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)))]
  exact logAvg_sq_nonneg _ _

/- ## 5. Elements of `𝒫'` -/

lemma mem_Pp {D : Data} {q : ℕ} (hq : q ∈ D.Pp) : 1 ≤ q ∧ q ≤ D.P₂' := by
  unfold Data.Pp almostPrimes FPDQ.boxProd at hq
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hq
  rw [Fintype.mem_piFinset] at hf
  have hmem : ∀ ℓ, (f ℓ).Prime ∧ f ℓ < D.hi ℓ.castSucc := fun ℓ => by
    have h := hf ℓ
    unfold primesIn at h
    rw [Finset.mem_filter, Finset.mem_Ico] at h
    exact ⟨h.2, h.1.2⟩
  refine ⟨Nat.one_le_iff_ne_zero.mpr ?_, ?_⟩
  · rw [Finset.prod_ne_zero_iff]
    exact fun ℓ _ => (hmem ℓ).1.ne_zero
  · calc ∏ ℓ, f ℓ ≤ ∏ ℓ : Fin D.k, D.hi ℓ.castSucc :=
          Finset.prod_le_prod (fun _ _ => Nat.zero_le _) (fun ℓ _ => (hmem ℓ).2.le)
      _ ≤ D.P₂' := D.hprod

/-- Every prime factor of an element of `𝒫'` is `≥ P'₁`. -/
lemma prime_factor_ge {D : Data} {q : ℕ} (hq : q ∈ D.Pp) {r : ℕ} (hr : r.Prime) (hrq : r ∣ q) :
    D.P₁' ≤ r := by
  unfold Data.Pp almostPrimes FPDQ.boxProd at hq
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hq
  rw [Fintype.mem_piFinset] at hf
  obtain ⟨ℓ, -, hℓ⟩ := (Prime.dvd_finsetProd_iff hr.prime f).mp hrq
  have h := hf ℓ
  unfold primesIn at h
  rw [Finset.mem_filter, Finset.mem_Ico] at h
  have hrf : r = f ℓ := (Nat.prime_dvd_prime_iff_eq hr h.2).mp hℓ
  have h1 : D.lo ℓ.castSucc ≤ f ℓ := h.1.1
  have h2 := (D.hI ℓ).1
  omega

lemma coprime_lam {D : Data} {q : ℕ} (hq : q ∈ D.Pp) : Nat.Coprime q D.lam :=
  Nat.coprime_of_dvd fun r hr hrq hrl => by
    have h1 := prime_factor_ge hq hr hrq
    have h2 := D.hlamP r hr hrl
    omega

lemma coprime_fact {D : Data} {q : ℕ} (hq : q ∈ D.Pp) {Q : ℕ} (hQ : Q < D.P₁') :
    Nat.Coprime q Q.factorial :=
  Nat.coprime_of_dvd fun r hr hrq hrQ => by
    have h1 := prime_factor_ge hq hr hrq
    have h2 := (Nat.Prime.dvd_factorial hr).mp hrQ
    omega

/- ## 6. Periodicity and edge effects (P6c, first step) -/

lemma sum_Ico_split (g : ℤ → ℝ) {a b c : ℤ} (hab : a ≤ b) (hbc : b ≤ c) :
    ∑ x ∈ Ico a c, g x = ∑ x ∈ Ico a b, g x + ∑ x ∈ Ico b c, g x := by
  rw [← Finset.Ico_union_Ico_eq_Ico hab hbc,
    Finset.sum_union (Finset.Ico_disjoint_Ico_consecutive a b c)]

lemma shift_diff (g : ℤ → ℝ) {a b s : ℤ} (hab : a ≤ b) (hs : 0 ≤ s) :
    ∑ x ∈ Ico a b, g (x + s) - ∑ x ∈ Ico a b, g x =
      ∑ x ∈ Ico b (b + s), g x - ∑ x ∈ Ico a (a + s), g x := by
  rw [Finset.sum_Ico_add' g a b s]
  have h1 := sum_Ico_split g (show a ≤ a + s by linarith) (show a + s ≤ b + s by linarith)
  have h2 := sum_Ico_split g hab (show b ≤ b + s by linarith)
  linarith

lemma per_shift {Λ : ℤ → ℝ} {F : ℕ} (hper : ∀ x : ℤ, Λ (x + F) = Λ x) (m : ℕ) (x : ℤ) :
    Λ (x + (F : ℤ) * m) = Λ x := by
  induction m with
  | zero => simp
  | succ m ih =>
    have e : x + (F : ℤ) * ((m + 1 : ℕ) : ℤ) = (x + (F : ℤ) * m) + F := by push_cast; ring
    rw [e, hper, ih]

lemma sum_block_le {Λ : ℤ → ℝ} {F : ℕ} {K : ℝ}
    (h417 : ∀ a : ℤ, ∑ x ∈ Ico a (a + F), |Λ x| ≤ K * F) (m : ℕ) (a : ℤ) :
    ∑ x ∈ Ico a (a + (F : ℤ) * m), |Λ x| ≤ m * (K * F) := by
  induction m with
  | zero => simp
  | succ m ih =>
    have e : a + (F : ℤ) * ((m + 1 : ℕ) : ℤ) = (a + (F : ℤ) * m) + F := by push_cast; ring
    have hF0 : (0 : ℤ) ≤ F := Int.natCast_nonneg F
    have hm0 : (0 : ℤ) ≤ (F : ℤ) * m := mul_nonneg hF0 (Int.natCast_nonneg m)
    rw [e, sum_Ico_split _ (show a ≤ a + (F : ℤ) * m by linarith)
      (show a + (F : ℤ) * m ≤ a + (F : ℤ) * m + F by linarith)]
    have h1 := h417 (a + (F : ℤ) * m)
    push_cast
    linarith

lemma edge_sum (Λ G : ℤ → ℝ) {F : ℕ} {K : ℝ} (hper : ∀ x : ℤ, Λ (x + F) = Λ x)
    (h417 : ∀ a : ℤ, ∑ x ∈ Ico a (a + F), |Λ x| ≤ K * F) (hG : ∀ x, |G x| ≤ 1) (X m : ℕ) :
    |∑ h ∈ win X, |Λ h| * G (h + (F : ℤ) * m) - ∑ h ∈ win X, |Λ h| * G h| ≤
      2 * (m * (K * F)) := by
  have hs0 : (0 : ℤ) ≤ (F : ℤ) * m := mul_nonneg (Int.natCast_nonneg F) (Int.natCast_nonneg m)
  have e1 : ∑ h ∈ win X, |Λ h| * G (h + (F : ℤ) * m) =
      ∑ h ∈ win X, (fun x => |Λ x| * G x) (h + (F : ℤ) * m) := by
    refine Finset.sum_congr rfl fun h _ => ?_
    show |Λ h| * G (h + (F : ℤ) * m) = |Λ (h + (F : ℤ) * m)| * G (h + (F : ℤ) * m)
    rw [per_shift hper m h]
  rw [e1]
  unfold win
  rw [shift_diff (fun x => |Λ x| * G x) (show (X : ℤ) ≤ 2 * X by linarith) hs0]
  have hgabs : ∀ x, |(fun x => |Λ x| * G x) x| ≤ |Λ x| := fun x => by
    show |(|Λ x| * G x)| ≤ |Λ x|
    rw [abs_mul, abs_abs]
    exact mul_le_of_le_one_right (abs_nonneg _) (hG x)
  have b1 : |∑ x ∈ Ico (2 * (X : ℤ)) (2 * X + (F : ℤ) * m), (fun x => |Λ x| * G x) x| ≤
      m * (K * F) :=
    (Finset.abs_sum_le_sum_abs _ _).trans
      ((Finset.sum_le_sum fun x _ => hgabs x).trans (sum_block_le h417 m _))
  have b2 : |∑ x ∈ Ico (X : ℤ) (X + (F : ℤ) * m), (fun x => |Λ x| * G x) x| ≤ m * (K * F) :=
    (Finset.abs_sum_le_sum_abs _ _).trans
      ((Finset.sum_le_sum fun x _ => hgabs x).trans (sum_block_le h417 m _))
  calc _ ≤ |∑ x ∈ Ico (2 * (X : ℤ)) (2 * X + (F : ℤ) * m), (fun x => |Λ x| * G x) x| +
        |∑ x ∈ Ico (X : ℤ) (X + (F : ℤ) * m), (fun x => |Λ x| * G x) x| := abs_sub _ _
    _ ≤ _ := by linarith

lemma edge_favg (Λ G : ℤ → ℝ) {F : ℕ} {K : ℝ} (hper : ∀ x : ℤ, Λ (x + F) = Λ x)
    (h417 : ∀ a : ℤ, ∑ x ∈ Ico a (a + F), |Λ x| ≤ K * F) (hG : ∀ x, |G x| ≤ 1) {X : ℕ}
    (hX : 1 ≤ X) (m : ℕ) :
    |favg (win X) (fun h => |Λ h| * G (h + (F : ℤ) * m)) - favg (win X) (fun h => |Λ h| * G h)| ≤
      2 * (m * (K * F)) / X := by
  have hXpos : (0 : ℝ) < X := by exact_mod_cast hX
  rw [favg_win, favg_win, ← sub_div, abs_div, abs_of_pos hXpos]
  exact div_le_div_of_nonneg_right (edge_sum Λ G hper h417 hG X m) hXpos.le

/-- **P6c, step 1**: adding the average over `h' ∈ [H]` (shift `h ↦ h + Q!h'`) costs `2ηK`
if `Q! H ≤ ηX`. -/
lemma step1 (Λ G : ℤ → ℝ) {F : ℕ} {K : ℝ} (hK : 0 ≤ K) (hper : ∀ x : ℤ, Λ (x + F) = Λ x)
    (h417 : ∀ a : ℤ, ∑ x ∈ Ico a (a + F), |Λ x| ≤ K * F) (hG : ∀ x, |G x| ≤ 1) {X H : ℕ}
    (hX : 1 ≤ X) (hH : 1 ≤ H) {η : ℝ} (hFH : (F : ℝ) * H ≤ η * X) :
    favg (win X) (fun h => |Λ h| * G h) - 2 * η * K ≤
      favg (win X) (fun h => |Λ h| * uavg H (fun h' => G (h + (F : ℤ) * h'))) := by
  have hXpos : (0 : ℝ) < X := by exact_mod_cast hX
  have e : favg (win X) (fun h => |Λ h| * uavg H (fun h' => G (h + (F : ℤ) * h'))) =
      uavg H (fun h' => favg (win X) (fun h => |Λ h| * G (h + (F : ℤ) * h'))) := by
    have e0 : ∀ h : ℤ, |Λ h| * uavg H (fun h' => G (h + (F : ℤ) * h')) =
        uavg H (fun h' => |Λ h| * G (h + (F : ℤ) * h')) := fun h => (wavg_smul _ _).symm
    rw [show favg (win X) (fun h => |Λ h| * uavg H (fun h' => G (h + (F : ℤ) * h'))) =
        favg (win X) (fun h => uavg H (fun h' => |Λ h| * G (h + (F : ℤ) * h'))) from
      wavg_congr fun h _ => e0 h]
    exact Elem.wavg_comm _ _ _ _ _
  rw [e]
  refine le_wavg_of_le (goodWeights_uavg hH) fun m hm => ?_
  have hmH : m ≤ H := (Finset.mem_Icc.mp hm).2
  have h1 := edge_favg Λ G hper h417 hG hX m
  have h2 : 2 * (m * (K * F)) / X ≤ 2 * η * K := by
    rw [div_le_iff₀ hXpos]
    have hmF : (m : ℝ) * F ≤ η * X := by
      have : (m : ℝ) ≤ H := by exact_mod_cast hmH
      calc (m : ℝ) * F ≤ H * F := mul_le_mul_of_nonneg_right this (Nat.cast_nonneg _)
        _ = F * H := mul_comm _ _
        _ ≤ η * X := hFH
    have := mul_le_mul_of_nonneg_left hmF hK
    nlinarith
  have := (abs_le.mp h1).1
  linarith

/- ## 7. P6c, second step: GS Lemma A.3 -/

lemma A3_pair (D : Data) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1) {Q : ℕ} (hQ : Q < D.P₁')
    (hN : 2 ≤ D.N) {H : ℕ} (hH : 1 ≤ H) (h : ℤ) (t t' : ℕ) {p₁ p₂ : ℕ} (hp₁ : p₁ ∈ D.Pp)
    (hp₂ : p₂ ∈ D.Pp) :
    |(uavg H fun h' => (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) *
        logAvg D.N fun n => ker D f₁ Q p₁ p₂ t t'
          (n * p₂ + (D.lam : ℤ) * (h + (Q.factorial : ℤ) * h') * p₁)) -
      (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) *
        logAvg D.N (fun n => ker D f₁ Q p₁ p₂ t t' (n + (D.lam : ℤ) * h * p₁))| ≤
      5 * ((1 + Real.log p₂ + Real.log (((D.lam * Q.factorial * p₁ : ℕ) : ℝ) * H)) /
        Real.log D.N + p₂ / H) := by
  have hq : 1 ≤ p₂ := (mem_Pp hp₂).1
  have hp1 : 1 ≤ p₁ := (mem_Pp hp₁).1
  have hlam := D.hlam
  have hb : 1 ≤ D.lam * Q.factorial * p₁ :=
    Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (Nat.mul_ne_zero (by omega)
      (Nat.factorial_ne_zero _)) (by omega))
  have herr : 0 ≤ 5 * ((1 + Real.log p₂ + Real.log (((D.lam * Q.factorial * p₁ : ℕ) : ℝ) * H)) /
      Real.log D.N + p₂ / H) := by
    have h1 : 0 ≤ Real.log (p₂ : ℝ) := Real.log_natCast_nonneg _
    have h2 : 0 ≤ Real.log (((D.lam * Q.factorial * p₁ : ℕ) : ℝ) * H) := by
      rw [← Nat.cast_mul]; exact Real.log_natCast_nonneg _
    have h3 : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
    positivity
  by_cases hc : Nat.Coprime p₁ p₂
  · simp only [if_pos hc, one_mul]
    have hcop : Nat.Coprime p₂ (D.lam * Q.factorial * p₁) :=
      Nat.Coprime.mul_right (Nat.Coprime.mul_right (coprime_lam hp₂) (coprime_fact hp₂ hQ))
        hc.symm
    have e1 : (uavg H fun h' => logAvg D.N fun n => ker D f₁ Q p₁ p₂ t t'
          (n * p₂ + (D.lam : ℤ) * (h + (Q.factorial : ℤ) * h') * p₁)) =
        logAvg D.N fun n => uavg H fun h' =>
          (fun y => ker D f₁ Q p₁ p₂ t t' (y + (D.lam : ℤ) * h * p₁))
            ((p₂ : ℤ) * n + ((D.lam * Q.factorial * p₁ : ℕ) : ℤ) * (h' : ℤ)) := by
      rw [Elem.logAvg_uavg_comm]
      refine wavg_congr fun h' _ => ?_
      unfold logAvg
      refine wavg_congr fun n _ => ?_
      show ker D f₁ Q p₁ p₂ t t' _ = ker D f₁ Q p₁ p₂ t t' _
      congr 1
      push_cast
      ring
    rw [e1]
    have hΨ : ∀ n : ℤ, |(fun y => ker D f₁ Q p₁ p₂ t t' (y + (D.lam : ℤ) * h * p₁)) n| ≤ 1 :=
      fun n => abs_ker_le D hf₁ Q p₁ p₂ t t' _
    exact Small.lemmaA3 hN hq hb hH hcop
      (fun y => ker D f₁ Q p₁ p₂ t t' (y + (D.lam : ℤ) * h * p₁)) hΨ
  · simp only [if_neg hc, zero_mul, sub_zero]
    rw [show (uavg H fun _ : ℕ => (0 : ℝ)) = 0 from wavg_zero' _ _, abs_zero]
    exact herr

lemma comm_I1 (D : Data) (f₁ : ℤ → ℝ) (Q H : ℕ) (h : ℤ) :
    uavg H (fun h' => I1 D f₁ Q (h + (Q.factorial : ℤ) * h')) =
      uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
        lavg D.Pp fun p₁ => lavg D.Pp fun p₂ => uavg H fun h' =>
          (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) *
            logAvg D.N fun n => ker D f₁ Q p₁ p₂ t t'
              (n * p₂ + (D.lam : ℤ) * (h + (Q.factorial : ℤ) * h') * p₁) :=
  comm_H H (Nat.sqrt D.P₁) D.Pp _

/-- **P6c, step 2** (A.3 for each `(t, t', p₁, p₂)`). -/
lemma A3_h (D : Data) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1) {Q : ℕ} (hQ : Q < D.P₁')
    (hN : 2 ≤ D.N) {H X : ℕ} (hH : 1 ≤ H) (hFH : Q.factorial * H ≤ X) (h : ℤ) :
    |uavg H (fun h' => I1 D f₁ Q (h + (Q.factorial : ℤ) * h')) - I2 D f₁ Q h| ≤
      5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / Real.log D.N +
        D.P₂' / H) := by
  have hlogN : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
  have hHpos : (0 : ℝ) < H := by exact_mod_cast hH
  have herr : 0 ≤ 5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) /
      Real.log D.N + D.P₂' / H) := by
    have h1 : 0 ≤ Real.log (D.P₂' : ℝ) := Real.log_natCast_nonneg _
    have h2 : 0 ≤ Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ) := Real.log_natCast_nonneg _
    positivity
  rw [comm_I1]
  unfold I2
  refine uavg_sub_le herr fun t => uavg_sub_le herr fun t' => lavg_sub_le herr fun p₁ hp₁ =>
    lavg_sub_le herr fun p₂ hp₂ => (A3_pair D hf₁ hQ hN hH h t t' hp₁ hp₂).trans ?_
  have hq1 := (mem_Pp hp₂).1
  have hqP := (mem_Pp hp₂).2
  have hp1P := (mem_Pp hp₁).2
  have hlam := D.hlam
  have hl1 : Real.log (p₂ : ℝ) ≤ Real.log D.P₂' :=
    Real.log_le_log (by exact_mod_cast hq1) (by exact_mod_cast hqP)
  have hnat : D.lam * Q.factorial * p₁ * H ≤ D.lam * D.P₂' * X :=
    calc D.lam * Q.factorial * p₁ * H = D.lam * p₁ * (Q.factorial * H) := by ring
      _ ≤ D.lam * D.P₂' * X := Nat.mul_le_mul (Nat.mul_le_mul_left _ hp1P) hFH
  have hpos : 1 ≤ D.lam * Q.factorial * p₁ * H :=
    Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (Nat.mul_ne_zero (Nat.mul_ne_zero (by omega)
      (Nat.factorial_ne_zero _)) (by have := (mem_Pp hp₁).1; omega)) (by omega))
  have hl2 : Real.log (((D.lam * Q.factorial * p₁ : ℕ) : ℝ) * H) ≤
      Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ) := by
    rw [← Nat.cast_mul]
    exact Real.log_le_log (by exact_mod_cast hpos) (by exact_mod_cast hnat)
  have h1 : (1 + Real.log p₂ + Real.log (((D.lam * Q.factorial * p₁ : ℕ) : ℝ) * H)) /
      Real.log D.N ≤ (1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) /
      Real.log D.N := div_le_div_of_nonneg_right (by linarith) hlogN.le
  have h2 : (p₂ : ℝ) / H ≤ D.P₂' / H :=
    div_le_div_of_nonneg_right (by exact_mod_cast hqP) hHpos.le
  linarith

/- ## 8. P6d: GS (A.2) and the decoupled average -/

/-- **P6d, step 1** (A.2): for `h ∈ [X, 2X)` the shift `λhp₁` changes the inner average by
at most `2(1 + log(2λXP'₂))/log N`. -/
lemma I2_close (D : Data) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1) (Q : ℕ) (hN : 2 ≤ D.N) {X : ℕ}
    {h : ℤ} (hh : h ∈ win X) :
    |I2 D f₁ Q h - Gcop D f₁ Q| ≤
      2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N := by
  have herr : 0 ≤ 2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N := by
    have := Real.log_natCast_nonneg (D.lam * (2 * X) * D.P₂')
    have := Real.log_pos (show (1 : ℝ) < D.N by exact_mod_cast (show 1 < D.N by omega))
    positivity
  have hh' := Finset.mem_Ico.mp hh
  unfold I2 Gcop
  refine uavg_sub_le herr fun t => uavg_sub_le herr fun t' => lavg_sub_le herr fun p₁ hp₁ =>
    lavg_sub_le herr fun p₂ hp₂ => ?_
  rw [← mul_sub, abs_mul]
  refine (mul_le_of_le_one_left (abs_nonneg _) (abs_cop_le p₁ p₂)).trans ?_
  have hK : ((D.lam : ℤ) * h * p₁).natAbs ≤ D.lam * (2 * X) * D.P₂' := by
    rw [Int.natAbs_mul, Int.natAbs_mul, Int.natAbs_natCast, Int.natAbs_natCast]
    have : h.natAbs ≤ 2 * X := by omega
    exact Nat.mul_le_mul (Nat.mul_le_mul_left _ this) (mem_Pp hp₁).2
  exact Elem.logAvg_shift_le' D.N hN _ (abs_ker_le D hf₁ Q p₁ p₂ t t') _ _ hK

lemma Gcop_eq (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) :
    Gcop D f₁ Q = lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
      (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) * Gfun D f₁ Q p₁ p₂ := by
  unfold Gcop
  refine (comm_TT _ _ _).trans (wavg_congr fun p₁ _ => wavg_congr fun p₂ _ => ?_)
  rw [Gfun_eq]
  unfold uavg
  rw [← wavg_smul]
  refine wavg_congr fun t _ => ?_
  rw [← wavg_smul]

lemma Gcop_nonneg (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) : 0 ≤ Gcop D f₁ Q := by
  rw [Gcop_eq]
  refine lavg_nonneg fun p₁ _ => lavg_nonneg fun p₂ _ => ?_
  have := Gfun_nonneg D f₁ Q p₁ p₂
  split_ifs <;> positivity

lemma Gcop_le (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) :
    Gcop D f₁ Q ≤ lavg D.Pp (fun s => lavg D.Pp (fun t => Gfun D f₁ Q s t)) := by
  rw [Gcop_eq]
  refine lavg_mono fun p₁ _ => lavg_mono fun p₂ _ => ?_
  have := Gfun_nonneg D f₁ Q p₁ p₂
  split_ifs <;> linarith

/- ## 9. Numerics -/

lemma exists_log_pow_le (K : ℝ) (hK : 0 < K) (n : ℕ) :
    ∃ y₀ : ℝ, ∀ y, y₀ ≤ y → K * Real.log y ^ n ≤ y := by
  have h := (isLittleO_pow_log_id_atTop (n := n)).bound (show (0 : ℝ) < 1 / K by positivity)
  obtain ⟨L₀, hL₀⟩ := Filter.eventually_atTop.mp h
  refine ⟨max L₀ 0, fun L hL => ?_⟩
  have h1 := hL₀ L (le_trans (le_max_left _ _) hL)
  have hL0 : 0 ≤ L := le_trans (le_max_right _ _) hL
  simp only [Real.norm_eq_abs, id_eq] at h1
  rw [abs_of_nonneg hL0] at h1
  have h2 : Real.log L ^ n ≤ 1 / K * L := (le_abs_self _).trans h1
  calc K * Real.log L ^ n ≤ K * (1 / K * L) := mul_le_mul_of_nonneg_left h2 hK.le
    _ = L := by field_simp

/-- `(C log¹² Q)² ≤ C² C₂²⁴ log²⁴(1/δ)`. -/
lemma K0_sq_le (D : Data) (C : ℝ) (C₂ : ℕ) (hδ1 : D.δ ≤ 1) :
    (C * Real.log (D.Q C₂) ^ 12) ^ 2 ≤ C ^ 2 * (C₂ : ℝ) ^ 24 * Real.log (1 / D.δ) ^ 24 := by
  have hδ := D.hδ
  have hy1 : 1 ≤ 1 / D.δ := by rw [le_div_iff₀ hδ]; linarith
  have hly : 0 ≤ Real.log (1 / D.δ) := Real.log_nonneg hy1
  have hlogQ0 : 0 ≤ Real.log (D.Q C₂ : ℝ) := Real.log_natCast_nonneg _
  have hlogQ : Real.log (D.Q C₂ : ℝ) ≤ C₂ * Real.log (1 / D.δ) := by
    rcases Nat.eq_zero_or_pos (D.Q C₂) with h0 | hpos
    · rw [h0, Nat.cast_zero, Real.log_zero]; positivity
    · calc Real.log (D.Q C₂ : ℝ) ≤ Real.log ((1 / D.δ) ^ C₂) :=
            Real.log_le_log (by exact_mod_cast hpos) (Nat.floor_le (by positivity))
        _ = C₂ * Real.log (1 / D.δ) := Real.log_pow _ _
  calc (C * Real.log (D.Q C₂) ^ 12) ^ 2 = C ^ 2 * Real.log (D.Q C₂) ^ 24 := by ring
    _ ≤ C ^ 2 * (C₂ * Real.log (1 / D.δ)) ^ 24 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hlogQ0 hlogQ 24) (sq_nonneg C)
    _ = C ^ 2 * (C₂ : ℝ) ^ 24 * Real.log (1 / D.δ) ^ 24 := by ring

/-- `(C log¹² Q)² ≤ C² C₂²⁴ L²⁸ δ⁴` with `L = log log N` (as `1/δ ≤ L`). -/
lemma K0_sq_le' (D : Data) (C : ℝ) (C₂ : ℕ) (hδ1 : D.δ ≤ 1) :
    (C * Real.log (D.Q C₂) ^ 12) ^ 2 ≤
      C ^ 2 * (C₂ : ℝ) ^ 24 * Real.log (Real.log D.N) ^ 28 * D.δ ^ 4 := by
  have h1 := K0_sq_le D C C₂ hδ1
  have hδ := D.hδ
  have hy1 : 1 ≤ 1 / D.δ := by rw [le_div_iff₀ hδ]; linarith
  have hly0 : 0 ≤ Real.log (1 / D.δ) := Real.log_nonneg hy1
  have hly : Real.log (1 / D.δ) ≤ 1 / D.δ := Real.log_le_self (by linarith)
  have hyL : 1 / D.δ ≤ Real.log (Real.log D.N) := D.hδN
  have h2 : Real.log (1 / D.δ) ^ 24 ≤ (1 / D.δ) ^ 24 := pow_le_pow_left₀ hly0 hly 24
  have h3 : (1 / D.δ) ^ 24 = (1 / D.δ) ^ 28 * D.δ ^ 4 := by
    have e : (1 / D.δ) * D.δ = 1 := by field_simp
    calc (1 / D.δ) ^ 24 = (1 / D.δ) ^ 24 * ((1 / D.δ) * D.δ) ^ 4 := by
          rw [e, one_pow, mul_one]
      _ = (1 / D.δ) ^ 28 * D.δ ^ 4 := by ring
  have h4 : (1 / D.δ) ^ 28 ≤ Real.log (Real.log D.N) ^ 28 :=
    pow_le_pow_left₀ (by linarith) hyL 28
  have hV : 0 ≤ C ^ 2 * (C₂ : ℝ) ^ 24 := by positivity
  calc (C * Real.log (D.Q C₂) ^ 12) ^ 2 ≤ C ^ 2 * (C₂ : ℝ) ^ 24 * Real.log (1 / D.δ) ^ 24 := h1
    _ ≤ C ^ 2 * (C₂ : ℝ) ^ 24 * ((1 / D.δ) ^ 28 * D.δ ^ 4) := by
        rw [← h3]; exact mul_le_mul_of_nonneg_left h2 hV
    _ ≤ C ^ 2 * (C₂ : ℝ) ^ 24 * (Real.log (Real.log D.N) ^ 28 * D.δ ^ 4) := by
        apply mul_le_mul_of_nonneg_left _ hV
        exact mul_le_mul_of_nonneg_right h4 (by positivity)
    _ = C ^ 2 * (C₂ : ℝ) ^ 24 * Real.log (Real.log D.N) ^ 28 * D.δ ^ 4 := by ring

/-- **`δ` small**: `256 (C log¹² Q)² δ ≤ c'²` for `δ ≤ δ₀` (as `log²⁴(1/δ) = o(1/δ)`). -/
lemma delta_small (c' C : ℝ) (C₂ : ℕ) (hc' : 0 < c') :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ 1 / 2 ∧ ∀ D : Data, D.δ ≤ δ₀ →
      256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 * D.δ ≤ c' ^ 2 := by
  obtain ⟨y₀, hy₀⟩ :=
    exists_log_pow_le (256 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1) (by positivity) 24
  have hm : (0 : ℝ) < max y₀ 2 := lt_of_lt_of_le (by norm_num) (le_max_right _ _)
  refine ⟨1 / max y₀ 2, by positivity, ?_, fun D hδ₀ => ?_⟩
  · rw [div_le_div_iff₀ hm (by norm_num)]
    linarith [le_max_right y₀ 2]
  have hδ := D.hδ
  have hy : max y₀ 2 ≤ 1 / D.δ := by
    rw [le_div_iff₀ hδ]
    rw [le_div_iff₀ hm] at hδ₀
    linarith
  have hδ1 : D.δ ≤ 1 := by
    have h2 : (2 : ℝ) ≤ 1 / D.δ := le_trans (le_max_right _ _) hy
    rw [le_div_iff₀ hδ] at h2
    linarith
  have hK := K0_sq_le D C C₂ hδ1
  have h1 := hy₀ (1 / D.δ) (le_trans (le_max_left _ _) hy)
  have hl : 0 ≤ Real.log (1 / D.δ) ^ 24 := by positivity
  have hV : 0 ≤ C ^ 2 * (C₂ : ℝ) ^ 24 := by positivity
  have h2 : 256 * (C ^ 2 * (C₂ : ℝ) ^ 24) * Real.log (1 / D.δ) ^ 24 ≤ c' ^ 2 * (1 / D.δ) := by
    have e : (256 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1) * Real.log (1 / D.δ) ^ 24 =
        256 * (C ^ 2 * (C₂ : ℝ) ^ 24) * Real.log (1 / D.δ) ^ 24 / c' ^ 2 +
          Real.log (1 / D.δ) ^ 24 := by
      field_simp
    rw [e] at h1
    have h3 : 256 * (C ^ 2 * (C₂ : ℝ) ^ 24) * Real.log (1 / D.δ) ^ 24 / c' ^ 2 ≤ 1 / D.δ := by
      linarith
    rw [div_le_iff₀ (by positivity)] at h3
    linarith
  have hyδ : c' ^ 2 * (1 / D.δ) * D.δ = c' ^ 2 := by field_simp
  calc 256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 * D.δ
      ≤ 256 * (C ^ 2 * (C₂ : ℝ) ^ 24 * Real.log (1 / D.δ) ^ 24) * D.δ :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hK (by norm_num)) hδ.le
    _ = 256 * (C ^ 2 * (C₂ : ℝ) ^ 24) * Real.log (1 / D.δ) ^ 24 * D.δ := by ring
    _ ≤ c' ^ 2 * (1 / D.δ) * D.δ := mul_le_mul_of_nonneg_right h2 hδ.le
    _ = c' ^ 2 := hyδ

lemma one_lt_log_of_three_le {n : ℕ} (hn : 3 ≤ n) : 1 < Real.log n := by
  have h3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [Real.lt_log_iff_exp_lt (by linarith)]
  have := Real.exp_one_lt_d9
  norm_num at this
  linarith

/-- `c xⁿ ≤ eˣ` once `x ≥ c (n+1)!`. -/
lemma mul_pow_le_exp {c x : ℝ} (n : ℕ) (_hc : 0 ≤ c) (hx : c * (n + 1).factorial ≤ x)
    (hx0 : 0 ≤ x) : c * x ^ n ≤ Real.exp x := by
  have hfac : (0 : ℝ) < (n + 1).factorial := by exact_mod_cast Nat.factorial_pos _
  have h := Real.pow_div_factorial_le_exp x hx0 (n + 1)
  calc c * x ^ n = c * (n + 1).factorial * x ^ n / (n + 1).factorial := by
        field_simp
    _ ≤ x * x ^ n / (n + 1).factorial := by gcongr
    _ = x ^ (n + 1) / (n + 1).factorial := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h

/-- From `v⁴ ≤ u` and `c⁴K⁴ ≤ u³`: `cKv ≤ u`. -/
lemma quartic {u v c K : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) (hc : 0 ≤ c) (hK : 0 ≤ K)
    (hvu : v ^ 4 ≤ u) (hcK : c ^ 4 * K ^ 4 ≤ u ^ 3) : c * K * v ≤ u := by
  have h : (c * K * v) ^ 4 ≤ u ^ 4 := by
    calc (c * K * v) ^ 4 = (c ^ 4 * K ^ 4) * v ^ 4 := by ring
      _ ≤ u ^ 3 * u := mul_le_mul hcK hvu (by positivity) (by positivity)
      _ = u ^ 4 := by ring
  exact (pow_le_pow_iff_left₀ (by positivity) hu (by norm_num)).mp h

lemma log_fact_le (Q : ℕ) : Real.log (Q.factorial : ℝ) ≤ (Q : ℝ) ^ 2 := by
  have hQ0 : (0 : ℝ) ≤ Q := Nat.cast_nonneg _
  have hfac_pos : (0 : ℝ) < Q.factorial := by exact_mod_cast Nat.factorial_pos Q
  have h1 : (Q.factorial : ℝ) ≤ (Q : ℝ) ^ Q := by exact_mod_cast Nat.factorial_le_pow Q
  calc Real.log (Q.factorial : ℝ) ≤ Real.log ((Q : ℝ) ^ Q) := Real.log_le_log hfac_pos h1
    _ = Q * Real.log Q := Real.log_pow _ _
    _ ≤ Q * Q := mul_le_mul_of_nonneg_left (Real.log_le_self hQ0) hQ0
    _ = (Q : ℝ) ^ 2 := by ring

lemma Q_le (D : Data) (C₂ : ℕ) : (D.Q C₂ : ℝ) ≤ Real.log (Real.log D.N) ^ C₂ := by
  have hδ := D.hδ
  have h1 : (D.Q C₂ : ℝ) ≤ (1 / D.δ) ^ C₂ := Nat.floor_le (by positivity)
  exact h1.trans (pow_le_pow_left₀ (by positivity) D.hδN C₂)

/-- **`Q!` is small against `P'₁`**: `A L^j Q! ≤ P'₁` for `L = log log N` large, since
`log Q! ≤ Q² ≤ L^{2C₂}` while `log P'₁ = exp(log log P'₁) ≥ exp(L^{1/10})`. -/
lemma fact_le_P1' (D : Data) (C₂ j : ℕ) (A : ℝ) (hA : 1 ≤ A)
    (hL : ((Real.log A + j + 1) * ((20 * C₂ + 10 + 1).factorial : ℝ)) ^ 10 ≤
      Real.log (Real.log D.N))
    (hL1 : 1 ≤ Real.log (Real.log D.N)) :
    A * Real.log (Real.log D.N) ^ j * ((D.Q C₂).factorial : ℝ) ≤ D.P₁' := by
  have hlogA : 0 ≤ Real.log A := Real.log_nonneg hA
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact_mod_cast (by omega : 0 < D.P₁')
  have hlP : 1 < Real.log D.P₁' := one_lt_log_of_three_le D.hP₁'
  have hw0 : 0 < Real.log (Real.log D.P₁') := Real.log_pos hlP
  have hLw : Real.log (Real.log D.N) ≤ Real.log (Real.log D.P₁') ^ 10 := D.hP₁'N
  have hfac1 : (1 : ℝ) ≤ ((20 * C₂ + 10 + 1).factorial : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hj0 : (0 : ℝ) ≤ j := Nat.cast_nonneg _
  have hc1 : 1 ≤ Real.log A + j + 1 := by linarith
  have hcw : (Real.log A + j + 1) * ((20 * C₂ + 10 + 1).factorial : ℝ) ≤
      Real.log (Real.log D.P₁') := by
    have h1 := hL.trans hLw
    exact (pow_le_pow_iff_left₀ (by positivity) hw0.le (by norm_num)).mp h1
  have hw1 : 1 ≤ Real.log (Real.log D.P₁') :=
    le_trans (one_le_mul_of_one_le_of_one_le hc1 hfac1) hcw
  have hexp : (Real.log A + j + 1) * Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) ≤
      Real.exp (Real.log (Real.log D.P₁')) :=
    mul_pow_le_exp (20 * C₂ + 10) (by positivity) hcw hw0.le
  have hexpw : Real.exp (Real.log (Real.log D.P₁')) = Real.log D.P₁' :=
    Real.exp_log (by linarith)
  have hwn : 1 ≤ Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) := one_le_pow₀ hw1
  have hw10 : Real.log (Real.log D.P₁') ^ 10 ≤ Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) :=
    pow_le_pow_right₀ hw1 (by omega)
  have hw20 : Real.log (Real.log D.P₁') ^ (20 * C₂) ≤
      Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) := pow_le_pow_right₀ hw1 (by omega)
  have hL0 : 0 ≤ Real.log (Real.log D.N) := by linarith
  have hlogL : Real.log (Real.log (Real.log D.N)) ≤
      Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) :=
    (Real.log_le_self hL0).trans (hLw.trans hw10)
  have hlogF : Real.log ((D.Q C₂).factorial : ℝ) ≤
      Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) := by
    have h1 := log_fact_le (D.Q C₂)
    have h2 : (D.Q C₂ : ℝ) ^ 2 ≤ (Real.log (Real.log D.N) ^ C₂) ^ 2 :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) (Q_le D C₂) 2
    have h3 : (Real.log (Real.log D.N) ^ C₂) ^ 2 ≤
        (Real.log (Real.log D.P₁') ^ 10) ^ (2 * C₂) := by
      rw [← pow_mul, mul_comm C₂ 2]
      exact pow_le_pow_left₀ hL0 hLw _
    have h4 : (Real.log (Real.log D.P₁') ^ 10) ^ (2 * C₂) =
        Real.log (Real.log D.P₁') ^ (20 * C₂) := by
      rw [← pow_mul]; ring_nf
    linarith
  have hF : (0 : ℝ) < ((D.Q C₂).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have hLpos : 0 < Real.log (Real.log D.N) := by linarith
  have hA0 : 0 < A := by linarith
  have hpos : 0 < A * Real.log (Real.log D.N) ^ j * ((D.Q C₂).factorial : ℝ) :=
    mul_pos (mul_pos hA0 (pow_pos hLpos j)) hF
  rw [← Real.log_le_log_iff hpos hP₁'pos, Real.log_mul (mul_pos hA0 (pow_pos hLpos j)).ne' hF.ne',
    Real.log_mul hA0.ne' (pow_pos hLpos j).ne', Real.log_pow, ← hexpw]
  have h5 : Real.log A ≤ Real.log A * Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) :=
    le_mul_of_one_le_right hlogA hwn
  have h6 : (j : ℝ) * Real.log (Real.log (Real.log D.N)) ≤
      j * Real.log (Real.log D.P₁') ^ (20 * C₂ + 10) :=
    mul_le_mul_of_nonneg_left hlogL hj0
  linarith

/-- **The logarithmic error terms are small**: `B L^j (1 + log λ + log P₂) ≤ log N` for
`L = log log N` large (from `(log λ)⁴, (log P₂)⁴ ≤ log N = e^L`). -/
lemma logs_le (D : Data) (B : ℝ) (hB : 0 ≤ B) (j : ℕ)
    (hL : 3 * B * ((j + 1).factorial : ℝ) ≤ Real.log (Real.log D.N))
    (hL' : (3 * B) ^ 4 * ((4 * j + 1).factorial : ℝ) ≤ Real.log (Real.log D.N))
    (hL0 : 0 ≤ Real.log (Real.log D.N)) (hu : 0 < Real.log D.N) :
    B * Real.log (Real.log D.N) ^ j * (1 + Real.log D.lam + Real.log D.P₂) ≤ Real.log D.N := by
  have hexpL : Real.exp (Real.log (Real.log D.N)) = Real.log D.N := Real.exp_log hu
  have hu1 : 1 ≤ Real.log D.N := by rw [← hexpL]; exact Real.one_le_exp hL0
  have hB3 : 0 ≤ 3 * B := by linarith
  have h0 : 3 * B * Real.log (Real.log D.N) ^ j ≤ Real.log D.N := by
    have := mul_pow_le_exp j hB3 hL hL0
    rwa [hexpL] at this
  have h4 : (3 * B) ^ 4 * (Real.log (Real.log D.N) ^ j) ^ 4 ≤ Real.log D.N ^ 3 := by
    rw [← pow_mul, mul_comm j 4]
    calc (3 * B) ^ 4 * Real.log (Real.log D.N) ^ (4 * j)
        ≤ Real.exp (Real.log (Real.log D.N)) :=
          mul_pow_le_exp (4 * j) (by positivity) hL' hL0
      _ = Real.log D.N := hexpL
      _ ≤ Real.log D.N ^ 3 := le_self_pow₀ hu1 (by norm_num)
  have hv1 : 0 ≤ Real.log (D.lam : ℝ) := Real.log_natCast_nonneg _
  have hv2 : 0 ≤ Real.log (D.P₂ : ℝ) := Real.log_natCast_nonneg _
  have h1 : 3 * B * Real.log (Real.log D.N) ^ j * Real.log D.lam ≤ Real.log D.N :=
    quartic hu.le hv1 hB3 (pow_nonneg hL0 j) D.hlamN h4
  have h2 : 3 * B * Real.log (Real.log D.N) ^ j * Real.log D.P₂ ≤ Real.log D.N :=
    quartic hu.le hv2 hB3 (pow_nonneg hL0 j) D.hP₂N.le h4
  nlinarith

/-- `N ≥ ⌈exp exp L₀⌉` gives `N ≥ 2`, `log N > 0` and `log log N ≥ L₀`. -/
lemma N_large_aux (L₀ : ℝ) (hL₀ : 1 ≤ L₀) (D : Data) (hN : ⌈Real.exp (Real.exp L₀)⌉₊ ≤ D.N) :
    2 ≤ D.N ∧ 0 < Real.log D.N ∧ L₀ ≤ Real.log (Real.log D.N) := by
  have hNR : Real.exp (Real.exp L₀) ≤ (D.N : ℝ) := (Nat.le_ceil _).trans (by exact_mod_cast hN)
  have hN0 : (0 : ℝ) < D.N := lt_of_lt_of_le (Real.exp_pos _) hNR
  have hu : Real.exp L₀ ≤ Real.log D.N := (Real.le_log_iff_exp_le hN0).mpr hNR
  have hu0 : 0 < Real.log D.N := lt_of_lt_of_le (Real.exp_pos _) hu
  have hL : L₀ ≤ Real.log (Real.log D.N) := (Real.le_log_iff_exp_le hu0).mpr hu
  refine ⟨?_, hu0, hL⟩
  have h2 : (2 : ℝ) < Real.exp 1 := by
    have := Real.exp_one_gt_d9
    norm_num at this
    linarith
  have h3 : Real.exp 1 ≤ Real.exp (Real.exp L₀) := by
    apply Real.exp_le_exp.mpr
    have := Real.add_one_le_exp L₀
    linarith
  have : (2 : ℝ) < D.N := by linarith
  exact_mod_cast this.le

lemma P₂'_le_P₂ (D : Data) : D.P₂' ≤ D.P₂ := by
  have h1 := D.hP₂'P₁
  have h2 := D.hP₁P₂
  unfold Data.P₂
  omega

lemma one_le_P₂' (D : Data) : 1 ≤ D.P₂' := by
  have := D.hP₁'
  have := D.hP₁'P₂'
  omega

lemma logP (D : Data) {x : ℕ} (hx1 : 1 ≤ x) (hx : x ≤ D.P₂) : Real.log x ≤ Real.log D.P₂ :=
  Real.log_le_log (by exact_mod_cast hx1) (by exact_mod_cast hx)

lemma log_mul3 {a b c : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b) (hc : 1 ≤ c) :
    Real.log ((a * b * c : ℕ) : ℝ) = Real.log a + Real.log b + Real.log c := by
  have ha' : (a : ℝ) ≠ 0 := by positivity
  have hb' : (b : ℝ) ≠ 0 := by positivity
  have hc' : (c : ℝ) ≠ 0 := by positivity
  push_cast
  rw [Real.log_mul (mul_ne_zero ha' hb') hc', Real.log_mul ha' hb']

lemma errA_num_le (D : Data) {X : ℕ} (hX1 : 1 ≤ X) (hX2 : X < D.P₂) :
    1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ) ≤
      3 * (1 + Real.log D.lam + Real.log D.P₂) := by
  rw [log_mul3 D.hlam (one_le_P₂' D) hX1]
  have h1 := logP D (one_le_P₂' D) (P₂'_le_P₂ D)
  have h2 := logP D hX1 hX2.le
  have h3 : 0 ≤ Real.log (D.lam : ℝ) := Real.log_natCast_nonneg _
  linarith

lemma errD_num_le (D : Data) {X : ℕ} (hX1 : 1 ≤ X) (hX2 : X < D.P₂) :
    1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ) ≤
      2 * (1 + Real.log D.lam + Real.log D.P₂) := by
  rw [log_mul3 D.hlam (by omega : 1 ≤ 2 * X) (one_le_P₂' D)]
  have hX : (1 : ℝ) ≤ X := by exact_mod_cast hX1
  have e : Real.log ((2 * X : ℕ) : ℝ) = Real.log 2 + Real.log X := by
    push_cast
    exact Real.log_mul (by norm_num) (by linarith)
  rw [e]
  have h1 := logP D (one_le_P₂' D) (P₂'_le_P₂ D)
  have h2 := logP D hX1 hX2.le
  have h3 : 0 ≤ Real.log (D.lam : ℝ) := Real.log_natCast_nonneg _
  have h4 : Real.log 2 < 1 := by
    have := Real.log_two_lt_d9
    norm_num at this
    linarith
  linarith

/-- The choice `H = X' = ⌊δ⁵X/Q!⌋`: `H ≥ 1`, `Q! H ≤ δ⁵X` and `H ≥ A₀ L²⁸ P'₂`, given
`2A₀L³³Q! ≤ P'₁` (and `X ≥ P₁ ≥ P'₂¹⁰`, `δ ≥ 1/L`). -/
lemma H_facts (D : Data) (C₂ : ℕ) {X : ℕ} (hX1 : D.P₁ ≤ X) (A₀ : ℝ) (hA₀ : 1 ≤ A₀)
    (hL1 : 1 ≤ Real.log (Real.log D.N))
    (hbig : 2 * A₀ * Real.log (Real.log D.N) ^ 33 * ((D.Q C₂).factorial : ℝ) ≤ D.P₁') :
    1 ≤ ⌊D.δ ^ 5 * X / (D.Q C₂).factorial⌋₊ ∧
      ((D.Q C₂).factorial : ℝ) * ⌊D.δ ^ 5 * X / (D.Q C₂).factorial⌋₊ ≤ D.δ ^ 5 * X ∧
      A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' ≤ ⌊D.δ ^ 5 * X / (D.Q C₂).factorial⌋₊ := by
  have hF1 : (1 : ℝ) ≤ ((D.Q C₂).factorial : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hFpos : (0 : ℝ) < ((D.Q C₂).factorial : ℝ) := by linarith
  have hδ := D.hδ
  have hLpos : 0 < Real.log (Real.log D.N) := by linarith
  have hδL : 1 ≤ D.δ * Real.log (Real.log D.N) := by
    have := D.hδN
    rw [div_le_iff₀ hδ] at this
    linarith
  have hδL5 : 1 ≤ D.δ ^ 5 * Real.log (Real.log D.N) ^ 5 := by
    rw [← mul_pow]; exact one_le_pow₀ hδL
  have hP₂'1 : (1 : ℝ) ≤ D.P₂' := by exact_mod_cast one_le_P₂' D
  have hP₁'P₂' : (D.P₁' : ℝ) ≤ D.P₂' := by exact_mod_cast D.hP₁'P₂'.le
  have hX : (D.P₂' : ℝ) ^ 10 ≤ X := by
    have h1 : D.P₂' ^ 10 ≤ X := D.hpow.trans hX1
    exact_mod_cast h1
  have hP10 : (D.P₂' : ℝ) * D.P₁' ≤ (D.P₂' : ℝ) ^ 10 := by
    have h9 : (D.P₁' : ℝ) ≤ (D.P₂' : ℝ) ^ 9 :=
      hP₁'P₂'.trans (le_self_pow₀ hP₂'1 (by norm_num))
    calc (D.P₂' : ℝ) * D.P₁' ≤ D.P₂' * D.P₂' ^ 9 :=
          mul_le_mul_of_nonneg_left h9 (by positivity)
      _ = D.P₂' ^ 10 := by ring
  have hmain : 2 * A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' * ((D.Q C₂).factorial : ℝ) ≤
      D.δ ^ 5 * X := by
    have hpos : 0 ≤ 2 * A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' * ((D.Q C₂).factorial : ℝ) := by
      have : 0 ≤ A₀ := by linarith
      positivity
    calc 2 * A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' * ((D.Q C₂).factorial : ℝ)
        ≤ (2 * A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' * ((D.Q C₂).factorial : ℝ)) *
            (D.δ ^ 5 * Real.log (Real.log D.N) ^ 5) := le_mul_of_one_le_right hpos hδL5
      _ = D.δ ^ 5 * (D.P₂' *
            (2 * A₀ * Real.log (Real.log D.N) ^ 33 * ((D.Q C₂).factorial : ℝ))) := by ring
      _ ≤ D.δ ^ 5 * (D.P₂' * D.P₁') := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          exact mul_le_mul_of_nonneg_left hbig (by positivity)
      _ ≤ D.δ ^ 5 * X := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          linarith
  have hz : 2 * A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' ≤
      D.δ ^ 5 * X / (D.Q C₂).factorial := by
    rw [le_div_iff₀ hFpos]; exact hmain
  have hge1 : 1 ≤ A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' :=
    one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hA₀ (one_le_pow₀ hL1)) hP₂'1
  have hfl := Nat.sub_one_lt_floor (D.δ ^ 5 * X / (D.Q C₂).factorial)
  have h3 : A₀ * Real.log (Real.log D.N) ^ 28 * D.P₂' ≤
      (⌊D.δ ^ 5 * X / (D.Q C₂).factorial⌋₊ : ℝ) := by linarith
  refine ⟨?_, ?_, h3⟩
  · have h4 : (1 : ℝ) ≤ ⌊D.δ ^ 5 * X / (D.Q C₂).factorial⌋₊ := hge1.trans h3
    exact_mod_cast h4
  · calc ((D.Q C₂).factorial : ℝ) * ⌊D.δ ^ 5 * X / (D.Q C₂).factorial⌋₊
        ≤ ((D.Q C₂).factorial : ℝ) * (D.δ ^ 5 * X / (D.Q C₂).factorial) :=
          mul_le_mul_of_nonneg_left (Nat.floor_le (by positivity)) hFpos.le
      _ = D.δ ^ 5 * X := by field_simp

/- ## 10. The cores of P6c and P6d -/

lemma M3_facts (D : Data) (C : ℝ) (C₂ : ℕ) {X : ℕ} (hX : 1 ≤ X) {Λper : ℤ → ℝ}
    (hPer : PerHyp D C C₂ X Λper) :
    0 ≤ favg (win X) (fun x => |Λper x|) ∧
      favg (win X) (fun x => |Λper x|) ≤ C * Real.log (D.Q C₂) ^ 12 := by
  have hXpos : (0 : ℝ) < X := by exact_mod_cast hX
  rw [favg_win]
  refine ⟨div_nonneg (Finset.sum_nonneg fun x _ => abs_nonneg _) hXpos.le, ?_⟩
  rw [div_le_iff₀ hXpos]
  exact hPer.2.1

lemma favg_mul_const {α : Type*} (s : Finset α) (f : α → ℝ) (c : ℝ) :
    favg s f * c = favg s (fun x => f x * c) := Elem.wavg_mul_const _ _ _ _

/-- **Core of P6c** for fixed data: periodicity (`step1`) and A.3 (`A3_h`), then
`E|Λ| · CS1 ≤ E|Λ| · Z525 + K²(2δ⁵ + err)` with `E|Λ| ≤ K = C log¹² Q`. -/
theorem core_c (D : Data) (C : ℝ) (C₂ : ℕ) (c' : ℝ) {f₁ : ℤ → ℝ} (hf₁ : ∀ n, |f₁ n| ≤ 1)
    {X : ℕ} (hX : 1 ≤ X) {Λper : ℤ → ℝ} (hPer : PerHyp D C C₂ X Λper) (hN : 2 ≤ D.N)
    (hQ : D.Q C₂ < D.P₁') {H : ℕ} (hH : 1 ≤ H)
    (hFH : ((D.Q C₂).factorial : ℝ) * H ≤ D.δ ^ 5 * X) (hδ1 : D.δ ≤ 1)
    (hsmall1 : 256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 * D.δ ≤ c' ^ 2)
    (hsmall2 : 128 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 *
      (5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / Real.log D.N +
        D.P₂' / H)) ≤ c' ^ 2 * D.δ ^ 4)
    (hyp : (c' * D.δ ^ 2) ^ 2 / 32 ≤
      favg (win X) (fun x => |Λper x|) * CS1 D f₁ (D.Q C₂) X Λper) :
    (c' * D.δ ^ 2) ^ 2 / 64 ≤ favg (win X) (fun x => |Λper x|) * Z525 D f₁ (D.Q C₂) X Λper := by
  obtain ⟨hM0, hMK⟩ := M3_facts D C C₂ hX hPer
  obtain ⟨hper, -, h417, -⟩ := hPer
  have hK0 : 0 ≤ C * Real.log (D.Q C₂) ^ 12 := hM0.trans hMK
  have hδ := D.hδ
  have hδ5 : D.δ ^ 5 ≤ 1 := pow_le_one₀ hδ.le hδ1
  have hXR : (0 : ℝ) ≤ X := Nat.cast_nonneg _
  have hFHnat : (D.Q C₂).factorial * H ≤ X := by
    have h1 : ((D.Q C₂).factorial : ℝ) * H ≤ X := hFH.trans (by nlinarith)
    exact_mod_cast h1
  have hlogN : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
  have herr0 : 0 ≤ 5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) /
      Real.log D.N + D.P₂' / H) := by
    have h1 : 0 ≤ Real.log (D.P₂' : ℝ) := Real.log_natCast_nonneg _
    have h2 : 0 ≤ Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ) := Real.log_natCast_nonneg _
    positivity
  -- step 1: the average over `h'`
  have hs1 := step1 Λper (I1 D f₁ (D.Q C₂)) hK0 hper h417 (abs_I1_le D hf₁ _) hX hH hFH
  rw [← CS1_eq] at hs1
  -- step 2: A.3
  have hs2 : favg (win X) (fun h => |Λper h| *
      uavg H (fun h' => I1 D f₁ (D.Q C₂) (h + ((D.Q C₂).factorial : ℤ) * h'))) ≤
      Z525 D f₁ (D.Q C₂) X Λper + favg (win X) (fun x => |Λper x|) *
        (5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / Real.log D.N +
          D.P₂' / H)) := by
    rw [Z525_eq, favg_mul_const, ← favg_add']
    refine favg_win_mono fun h _ => ?_
    have h1 := (abs_le.mp (A3_h D hf₁ hQ hN hH hFHnat h)).2
    have h2 := mul_le_mul_of_nonneg_left h1 (abs_nonneg (Λper h))
    linarith
  -- combine
  set M := favg (win X) (fun x => |Λper x|) with hMdef
  set K := C * Real.log (D.Q C₂) ^ 12 with hKdef
  set e := 5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / Real.log D.N +
    D.P₂' / H) with hedef
  have hCS : CS1 D f₁ (D.Q C₂) X Λper ≤ Z525 D f₁ (D.Q C₂) X Λper + M * e +
      2 * D.δ ^ 5 * K := by linarith
  have hA := mul_le_mul_of_nonneg_left hCS hM0
  have hMM : M * M ≤ K * K := mul_self_le_mul_self hM0 hMK
  have hB : M * (M * e) ≤ K ^ 2 * e := by
    have := mul_le_mul_of_nonneg_right hMM herr0
    nlinarith
  have hC : M * (2 * D.δ ^ 5 * K) ≤ 2 * D.δ ^ 5 * K ^ 2 := by
    have h1 : 0 ≤ 2 * D.δ ^ 5 * K := by positivity
    have := mul_le_mul_of_nonneg_right hMK h1
    nlinarith
  have hD : 2 * D.δ ^ 5 * K ^ 2 ≤ c' ^ 2 * D.δ ^ 4 / 128 := by
    have h4 : 0 ≤ D.δ ^ 4 := by positivity
    have := mul_le_mul_of_nonneg_left hsmall1 h4
    nlinarith
  have hE : K ^ 2 * e ≤ c' ^ 2 * D.δ ^ 4 / 128 := by linarith
  have e2 : (c' * D.δ ^ 2) ^ 2 = c' ^ 2 * D.δ ^ 4 := by ring
  rw [e2] at hyp ⊢
  nlinarith

/-- **Core of P6d** for fixed data: A.2 (`I2_close`) gives `Z525 ≤ E|Λ| (G_cop + err)`, then
`G_cop ≤ E^log E^log Gfun` (as `Gfun ≥ 0`). -/
theorem core_d (D : Data) (C : ℝ) (C₂ : ℕ) (c' : ℝ) (hc' : 0 < c') {f₁ : ℤ → ℝ}
    (hf₁ : ∀ n, |f₁ n| ≤ 1) {X : ℕ} (hX : 1 ≤ X) {Λper : ℤ → ℝ} (hPer : PerHyp D C C₂ X Λper)
    (hN : 2 ≤ D.N)
    (hsmall1 : 256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 * D.δ ≤ c' ^ 2)
    (hsmall2 : 256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 *
      (2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N) ≤
        c' ^ 2 * D.δ ^ 4)
    (hyp : (c' * D.δ ^ 2) ^ 2 / 64 ≤
      favg (win X) (fun x => |Λper x|) * Z525 D f₁ (D.Q C₂) X Λper) :
    D.δ ^ 5 ≤ lavg D.Pp (fun s => lavg D.Pp (fun t => Gfun D f₁ (D.Q C₂) s t)) := by
  obtain ⟨hM0, hMK⟩ := M3_facts D C C₂ hX hPer
  have herr0 : 0 ≤ 2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N := by
    have := Real.log_natCast_nonneg (D.lam * (2 * X) * D.P₂')
    have := Real.log_pos (show (1 : ℝ) < D.N by exact_mod_cast (show 1 < D.N by omega))
    positivity
  have hGc0 := Gcop_nonneg D f₁ (D.Q C₂)
  have hGcle := Gcop_le D f₁ (D.Q C₂)
  have hZ : Z525 D f₁ (D.Q C₂) X Λper ≤ favg (win X) (fun x => |Λper x|) *
      (Gcop D f₁ (D.Q C₂) +
        2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N) := by
    rw [Z525_eq, favg_mul_const]
    refine favg_win_mono fun h hh => ?_
    have h1 := (abs_le.mp (I2_close D hf₁ (D.Q C₂) hN hh)).2
    exact mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
  set M := favg (win X) (fun x => |Λper x|) with hMdef
  set K := C * Real.log (D.Q C₂) ^ 12 with hKdef
  set e := 2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N with hedef
  set Gc := Gcop D f₁ (D.Q C₂) with hGcdef
  set Gall := lavg D.Pp (fun s => lavg D.Pp (fun t => Gfun D f₁ (D.Q C₂) s t)) with hGalldef
  have hMZ := mul_le_mul_of_nonneg_left hZ hM0
  have hMM : M * M ≤ K * K := mul_self_le_mul_self hM0 hMK
  have hGe : 0 ≤ Gc + e := by linarith
  have h1 : M * (M * (Gc + e)) ≤ K ^ 2 * (Gc + e) := by
    have := mul_le_mul_of_nonneg_right hMM hGe
    nlinarith
  by_contra hlt'
  have hlt := not_le.mp hlt'
  have h2 : K ^ 2 * (Gc + e) ≤ K ^ 2 * (D.δ ^ 5 + e) :=
    mul_le_mul_of_nonneg_left (by linarith) (sq_nonneg K)
  have hδ := D.hδ
  have h3 : K ^ 2 * D.δ ^ 5 ≤ c' ^ 2 * D.δ ^ 4 / 256 := by
    have h4 : 0 ≤ D.δ ^ 4 := by positivity
    have := mul_le_mul_of_nonneg_left hsmall1 h4
    nlinarith
  have h4 : K ^ 2 * e ≤ c' ^ 2 * D.δ ^ 4 / 256 := by linarith
  have hpos : 0 < c' ^ 2 * D.δ ^ 4 := by positivity
  have e2 : (c' * D.δ ^ 2) ^ 2 = c' ^ 2 * D.δ ^ 4 := by ring
  rw [e2] at hyp
  nlinarith

/- ## 11. The "`N` large" error bounds -/

lemma small2_c (D : Data) (C : ℝ) (C₂ : ℕ) (c' : ℝ) (hc' : 0 < c') {X H : ℕ} (hX1 : 1 ≤ X)
    (hX2 : X < D.P₂) (hδ1 : D.δ ≤ 1) (hu0 : 0 < Real.log D.N) (hH1 : 1 ≤ H)
    (hlogs : 3840 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 * Real.log (Real.log D.N) ^ 28 *
      (1 + Real.log D.lam + Real.log D.P₂) ≤ Real.log D.N)
    (hHbig : (1280 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1) * Real.log (Real.log D.N) ^ 28 *
      D.P₂' ≤ H) :
    128 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 *
      (5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / Real.log D.N +
        D.P₂' / H)) ≤ c' ^ 2 * D.δ ^ 4 := by
  have hK := K0_sq_le' D C C₂ hδ1
  have hnum := errA_num_le D hX1 hX2
  have hHpos : (0 : ℝ) < H := by exact_mod_cast hH1
  have hP0 : (0 : ℝ) ≤ D.P₂' := Nat.cast_nonneg _
  have hc2 : 0 < c' ^ 2 := by positivity
  have herr0 : 0 ≤ 5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) /
      Real.log D.N + D.P₂' / H) := by
    have h1 : 0 ≤ Real.log (D.P₂' : ℝ) := Real.log_natCast_nonneg _
    have h2 : 0 ≤ Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ) := Real.log_natCast_nonneg _
    positivity
  set V := C ^ 2 * (C₂ : ℝ) ^ 24 with hVdef
  set L := Real.log (Real.log D.N) with hLdef
  set u := Real.log D.N with hudef
  set E := 1 + Real.log D.lam + Real.log D.P₂ with hEdef
  have hV0 : 0 ≤ V := by positivity
  have hL0 : 0 ≤ L ^ 28 := by positivity
  have herr : 5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / u +
      D.P₂' / H) ≤ 15 * (E / u) + 5 * (D.P₂' / H) := by
    have h1 : (1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / u ≤ 3 * E / u :=
      div_le_div_of_nonneg_right hnum hu0.le
    have h2 : 3 * E / u = 3 * (E / u) := by ring
    linarith
  have hE1 : V * L ^ 28 * (E / u) ≤ c' ^ 2 / 3840 := by
    have h1 : 3840 * V * L ^ 28 * E ≤ c' ^ 2 * u := by
      have h2 := mul_le_mul_of_nonneg_left hlogs hc2.le
      have e : c' ^ 2 * (3840 * V / c' ^ 2 * L ^ 28 * E) = 3840 * V * L ^ 28 * E := by
        field_simp
      linarith
    rw [show V * L ^ 28 * (E / u) = (V * L ^ 28 * E) / u by ring, div_le_iff₀ hu0]
    linarith
  have hE2 : V * L ^ 28 * (D.P₂' / H) ≤ c' ^ 2 / 1280 := by
    have h1 : 1280 * V * L ^ 28 * D.P₂' ≤ c' ^ 2 * H := by
      have h3 : 1280 * V / c' ^ 2 * L ^ 28 * D.P₂' ≤ H := by
        refine le_trans ?_ hHbig
        apply mul_le_mul_of_nonneg_right _ hP0
        apply mul_le_mul_of_nonneg_right _ hL0
        linarith
      have h2 := mul_le_mul_of_nonneg_left h3 hc2.le
      have e : c' ^ 2 * (1280 * V / c' ^ 2 * L ^ 28 * D.P₂') = 1280 * V * L ^ 28 * D.P₂' := by
        field_simp
      linarith
    rw [show V * L ^ 28 * (D.P₂' / H) = (V * L ^ 28 * D.P₂') / H by ring, div_le_iff₀ hHpos]
    linarith
  have hδ4 : 0 ≤ D.δ ^ 4 := by positivity
  calc 128 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 *
        (5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / u + D.P₂' / H))
      ≤ 128 * (V * L ^ 28 * D.δ ^ 4) *
        (5 * ((1 + Real.log D.P₂' + Real.log ((D.lam * D.P₂' * X : ℕ) : ℝ)) / u +
          D.P₂' / H)) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hK (by norm_num)) herr0
    _ ≤ 128 * (V * L ^ 28 * D.δ ^ 4) * (15 * (E / u) + 5 * (D.P₂' / H)) :=
        mul_le_mul_of_nonneg_left herr (by positivity)
    _ = D.δ ^ 4 * (1920 * (V * L ^ 28 * (E / u)) + 640 * (V * L ^ 28 * (D.P₂' / H))) := by
        ring
    _ ≤ D.δ ^ 4 * (1920 * (c' ^ 2 / 3840) + 640 * (c' ^ 2 / 1280)) := by
        apply mul_le_mul_of_nonneg_left _ hδ4
        linarith
    _ = c' ^ 2 * D.δ ^ 4 := by ring

lemma small2_d (D : Data) (C : ℝ) (C₂ : ℕ) (c' : ℝ) (hc' : 0 < c') {X : ℕ} (hX1 : 1 ≤ X)
    (hX2 : X < D.P₂) (hδ1 : D.δ ≤ 1) (hu0 : 0 < Real.log D.N)
    (hlogs : 1024 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 * Real.log (Real.log D.N) ^ 28 *
      (1 + Real.log D.lam + Real.log D.P₂) ≤ Real.log D.N) :
    256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 *
      (2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N) ≤
        c' ^ 2 * D.δ ^ 4 := by
  have hK := K0_sq_le' D C C₂ hδ1
  have hnum := errD_num_le D hX1 hX2
  have hc2 : 0 < c' ^ 2 := by positivity
  have herr0 : 0 ≤ 2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / Real.log D.N := by
    have := Real.log_natCast_nonneg (D.lam * (2 * X) * D.P₂')
    positivity
  set V := C ^ 2 * (C₂ : ℝ) ^ 24 with hVdef
  set L := Real.log (Real.log D.N) with hLdef
  set u := Real.log D.N with hudef
  set E := 1 + Real.log D.lam + Real.log D.P₂ with hEdef
  have hV0 : 0 ≤ V := by positivity
  have herr : 2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / u ≤ 4 * (E / u) := by
    rw [show 4 * (E / u) = 2 * (2 * E) / u by ring]
    exact div_le_div_of_nonneg_right (by linarith) hu0.le
  have hE1 : V * L ^ 28 * (E / u) ≤ c' ^ 2 / 1024 := by
    have h1 : 1024 * V * L ^ 28 * E ≤ c' ^ 2 * u := by
      have h2 := mul_le_mul_of_nonneg_left hlogs hc2.le
      have e : c' ^ 2 * (1024 * V / c' ^ 2 * L ^ 28 * E) = 1024 * V * L ^ 28 * E := by
        field_simp
      linarith
    rw [show V * L ^ 28 * (E / u) = (V * L ^ 28 * E) / u by ring, div_le_iff₀ hu0]
    linarith
  have hδ4 : 0 ≤ D.δ ^ 4 := by positivity
  calc 256 * (C * Real.log (D.Q C₂) ^ 12) ^ 2 *
        (2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / u)
      ≤ 256 * (V * L ^ 28 * D.δ ^ 4) *
        (2 * (1 + Real.log ((D.lam * (2 * X) * D.P₂' : ℕ) : ℝ)) / u) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hK (by norm_num)) herr0
    _ ≤ 256 * (V * L ^ 28 * D.δ ^ 4) * (4 * (E / u)) :=
        mul_le_mul_of_nonneg_left herr (by positivity)
    _ = D.δ ^ 4 * (1024 * (V * L ^ 28 * (E / u))) := by ring
    _ ≤ D.δ ^ 4 * (1024 * (c' ^ 2 / 1024)) := by
        apply mul_le_mul_of_nonneg_left _ hδ4
        linarith
    _ = c' ^ 2 * D.δ ^ 4 := by ring

end P6cd

open P6cd in
/-- **Step P6c** (GS p. 22, → (5.25)). Constants: `δ₀` from `P6cd.delta_small`
(`256 (C log¹² Q)² δ ≤ c'²`, `δ₀ ≤ 1/2`), and `N₀ = ⌈exp exp L₀⌉` with
`L₀ = max(1, ((log 2A₀ + 34)·(20C₂+11)!)¹⁰, 3B·29!, (3B)⁴·113!)`, `V = C²C₂²⁴`,
`A₀ = 1280V/c'² + 1`, `B = 3840V/c'²`. The average over `h'` runs over
`[⌊δ⁵X/Q!⌋]`. -/
theorem stepP6c : StepP6c := by
  intro c' C C₂ hc'
  obtain ⟨δ₀, hδ₀, hδ₀h, hsmall⟩ := delta_small c' C C₂ hc'
  have hV0 : 0 ≤ C ^ 2 * (C₂ : ℝ) ^ 24 := by positivity
  have hA₀1 : 1 ≤ 1280 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1 := by
    have : 0 ≤ 1280 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 := by positivity
    linarith
  have hB0 : 0 ≤ 3840 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 := by positivity
  refine ⟨δ₀, hδ₀, ⌈Real.exp (Real.exp (max 1 (max
    (((Real.log (2 * (1280 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1)) + (33 : ℕ) + 1) *
      ((20 * C₂ + 10 + 1).factorial : ℝ)) ^ 10)
    (max (3 * (3840 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2) * ((28 + 1).factorial : ℝ))
      ((3 * (3840 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2)) ^ 4 *
        ((4 * 28 + 1).factorial : ℝ))))))⌉₊, ?_⟩
  intro D hδ hN f₁ hf₁ X hX1 hX2 Λper hPer hyp
  obtain ⟨hN2, hu0, hLL⟩ := N_large_aux _ (le_max_left _ _) D hN
  have hL1 : 1 ≤ Real.log (Real.log D.N) := le_trans (le_max_left _ _) hLL
  have hLa := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hLL
  have hLb := le_trans (le_trans (le_trans (le_max_left _ _) (le_max_right _ _))
    (le_max_right _ _)) hLL
  have hLc := le_trans (le_trans (le_trans (le_max_right _ _) (le_max_right _ _))
    (le_max_right _ _)) hLL
  have hδ1 : D.δ ≤ 1 := by linarith
  have hbig := fact_le_P1' D C₂ 33 (2 * (1280 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1))
    (by linarith) hLa hL1
  have hlogs := logs_le D _ hB0 28 hLb hLc (by linarith) hu0
  obtain ⟨hH1, hFH, hHbig⟩ := H_facts D C₂ hX1 _ hA₀1 hL1 (by linarith [hbig])
  have hX3 : 1 ≤ X := by
    have := D.hP₁'; have := D.hP₁'P₂'; have := D.hP₂'P₁
    unfold Data.P₁ at hX1
    omega
  have hQ : D.Q C₂ < D.P₁' := by
    have hF1 : (1 : ℝ) ≤ ((D.Q C₂).factorial : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
    have hQF : (D.Q C₂ : ℝ) ≤ ((D.Q C₂).factorial : ℝ) := by
      exact_mod_cast Nat.self_le_factorial _
    have hL33 : 1 ≤ Real.log (Real.log D.N) ^ 33 := one_le_pow₀ hL1
    have h2 : (2 : ℝ) ≤ 2 * (1280 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 + 1) *
        Real.log (Real.log D.N) ^ 33 := by nlinarith
    have h3 : (D.Q C₂ : ℝ) < D.P₁' := by nlinarith
    exact_mod_cast h3
  exact core_c D C C₂ c' hf₁ hX3 hPer hN2 hQ hH1 hFH hδ1 (hsmall D hδ)
    (small2_c D C C₂ c' hc' hX3 hX2 hδ1 hu0 hH1 hlogs hHbig) hyp

open P6cd in
/-- **Step P6d** (GS p. 22, (5.25) → (5.26)). Constants: `δ₀` from `P6cd.delta_small`, and
`N₀ = ⌈exp exp L₀⌉` with `L₀ = max(1, 3B·29!, (3B)⁴·113!)`, `B = 1024 C²C₂²⁴/c'²`. -/
theorem stepP6d : StepP6d := by
  intro c' C C₂ hc'
  obtain ⟨δ₀, hδ₀, hδ₀h, hsmall⟩ := delta_small c' C C₂ hc'
  have hB0 : 0 ≤ 1024 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2 := by positivity
  refine ⟨δ₀, hδ₀, ⌈Real.exp (Real.exp (max 1
    (max (3 * (1024 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2) * ((28 + 1).factorial : ℝ))
      ((3 * (1024 * (C ^ 2 * (C₂ : ℝ) ^ 24) / c' ^ 2)) ^ 4 *
        ((4 * 28 + 1).factorial : ℝ)))))⌉₊, ?_⟩
  intro D hδ hN f₁ hf₁ X hX1 hX2 Λper hPer hyp
  obtain ⟨hN2, hu0, hLL⟩ := N_large_aux _ (le_max_left _ _) D hN
  have hL1 : 1 ≤ Real.log (Real.log D.N) := le_trans (le_max_left _ _) hLL
  have hLb := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hLL
  have hLc := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hLL
  have hδ1 : D.δ ≤ 1 := by linarith
  have hlogs := logs_le D _ hB0 28 hLb hLc (by linarith) hu0
  have hX3 : 1 ≤ X := by
    have := D.hP₁'; have := D.hP₁'P₂'; have := D.hP₂'P₁
    unfold Data.P₁ at hX1
    omega
  exact core_d D C C₂ c' hc' hf₁ hX3 hPer hN2 (hsmall D hδ)
    (small2_d D C C₂ c' hc' hX3 hX2 hδ1 hu0 hlogs) hyp

end G22.P51

end

/- ## Section: `P51P6g` -/

section

/-
# Step P6g of GS Proposition 5.1 (GS p. 23)

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. This file proves

* `stepP6g : StepP6g` with `A'' = 2A' + 20`, `δ₀ = 1/80` and
  `N₀ = ⌈exp exp L₀⌉ + 2`, where `L₀ = max(81920⁴ (J+1)!, (80 (M+1)!)¹⁰)`,
  `J = 72 + 8A' + 2C₂`, `M = 10(2A' + 12)`.

## Proof

Write `T = ⌊√P₁⌋`, `H = ⌊√T⌋`, `m = λQ!`, `X = 1/δ`, `Q₀ = X^{A'}`.

1. (Pigeonhole.) Let `Y_i = ∏ a_i`. If `Y₂ ≤ Y₁` fix `t ∈ B₂` with
   `δ⁶ ≤ E_{s∈B₁} G(s,t)` and take `S = {s² - t² : s ∈ B₁}` (sign `e = 1`); otherwise fix `s ∈ B₁`
   and take `S = {-(t² - s²) : t ∈ B₂}` (sign `e = -1`). Either way `S ⊂ (-4Y², 4Y²)` for the
   `Y` of the averaged box (elements of a `Good5` box are `< 2Y`), and `SqFPD` gives
   `FPDProp S T (4Y²) δ⁷ Q₀ Q₀`.
2. (`core`, A.2 with modulus `m`.) `E_{s∈S} G(s) = E^log_n F(n)` with
   `F(n) = E_{t,t'} E_s f(n + mts) f(n + mt's)`; `Small.lemmaA2res` gives
   `E_{a<m} C_a ≥ δ⁶ - err`, `C_a` the correlation of `f_a(y) = f(my + a)` in the form of
   `L24.lemma24_gen`, `err = 3(1 + log m)/log N`.
3. (Lemma 2.4* for each residue.) With `ε = δ⁶`, `β = (ε/4)²/(100Q₀)` and `K = ⌊Q₀⌋`:
   `β (C_a - ε/4) ≤ ∑_{q ≤ K} ‖f_a‖²_{U¹[q,H]}` for every `a` (`residue_bound`; trivial if
   `C_a < ε/4`).
4. (Pigeonhole `q`.) Summing over `a`: `∑_{q≤K} E_a ‖f_a‖²_{U¹[q,H]} ≥ βε/2`, so some `q ≤ K`
   has `E_a ‖f_a‖²_{U¹[q,H]} ≥ βε/(2K) ≥ ε³/(3200 Q₀²)`.
5. (A.2 again.) `E_a ‖f_a‖²_{U¹[q,H]} = E_a E^log_n G(mn + a)`,
   `G(n) = (E_h f(n + mqh))²`, so `‖f‖²_{U¹[mq,H]} ≥ ε³/(3200Q₀²) - err`.
6. (Parameters.) `1/δ ≤ log log N ≤ (log log P'₁)¹⁰` gives `80 X^{2A'+12} ≤ P'₁`
   (`P1'_big`), whence `16Y² ≤ δ^{A'}T`, `16HQ₀ ≤ 4TY²`, `20Q₀²H ≤ (ε/4)²·4TY²`
   (`H ≥ P'₂² > P'₁`, `T ≥ H²`, `T ≥ P'₂⁵`, `Y ≤ P'₂`). With `L = log log N ≥ L₀`,
   `c L^j ≤ e^L = log N` for `c ≤ 81920⁴`, `j ≤ J`; with `(log P₂)⁴ < log N`,
   `(log λ)⁴ ≤ log N` and `log Q! ≤ Q² ≤ L^{2C₂}` this gives the `log`-conditions of
   Lemma 2.4* and `err ≤ δ^{18+2A'}/6400` (`log_small`, `err_small`, via `quartic`).
   Finally `δ^{18+2A'}/3200 - err ≥ δ^{18+2A'}/6400 ≥ δ^{2A'+20}` as `δ ≤ 1/80`.
-/

open Finset Real

namespace G22.P51

namespace P6g

/- ### Averages -/

lemma favg_eq {α : Type*} (s : Finset α) (f : α → ℝ) :
    favg s f = (∑ x ∈ s, f x) / s.card := by
  unfold favg wavg
  simp

lemma favg_comm {α β : Type*} (s : Finset α) (t : Finset β) (F : α → β → ℝ) :
    favg s (fun x => favg t (fun y => F x y)) = favg t (fun y => favg s (fun x => F x y)) :=
  Elem.wavg_comm _ _ _ _ _

lemma exists_le_of_le_favg {α : Type*} {s : Finset α} {f : α → ℝ} {c : ℝ} (hc : 0 < c)
    (h : c ≤ favg s f) : ∃ x ∈ s, c ≤ f x := by
  by_contra hne
  push Not at hne
  rw [favg_eq] at h
  rcases s.eq_empty_or_nonempty with hs | hs
  · subst hs
    simp at h
    linarith
  · have hcard : (0 : ℝ) < s.card := by exact_mod_cast hs.card_pos
    have hsum : ∑ x ∈ s, f x < ∑ _x ∈ s, c := Finset.sum_lt_sum_of_nonempty hs hne
    rw [Finset.sum_const, nsmul_eq_mul] at hsum
    rw [le_div_iff₀ hcard] at h
    linarith

lemma favg_image_eq {B : Finset ℕ} {σ : ℕ → ℤ} (hσ : Function.Injective σ) (g : ℤ → ℝ) :
    favg B (fun x => g (σ x)) = (∑ s ∈ B.image σ, g s) / (B.image σ).card := by
  rw [favg_eq, Finset.sum_image (fun x _ y _ h => hσ h), Finset.card_image_of_injective _ hσ]

lemma abs_uavg_le_one {T : ℕ} {g : ℕ → ℝ} (hg : ∀ t, |g t| ≤ 1) : |uavg T g| ≤ 1 := by
  rcases Nat.eq_zero_or_pos T with h | h
  · subst h
    simp [uavg, wavg]
  · exact abs_wavg_le_of_abs_le (goodWeights_uavg h) fun t _ => hg t

lemma wavg_sum_div {α β : Type*} (I : Finset α) (w : α → ℝ) (S : Finset β) (g : β → α → ℝ)
    (c : ℝ) : (∑ s ∈ S, wavg I w (g s)) / c = wavg I w (fun i => (∑ s ∈ S, g s i) / c) := by
  rw [← wavg_sum]
  simp only [div_eq_mul_inv]
  exact Elem.wavg_mul_const _ _ _ _

lemma uavg_sum_div {β : Type*} (T : ℕ) (S : Finset β) (g : β → ℕ → ℝ) (c : ℝ) :
    (∑ s ∈ S, uavg T (g s)) / c = uavg T (fun t => (∑ s ∈ S, g s t) / c) :=
  wavg_sum_div _ _ _ _ _

lemma logAvg_sum_div {β : Type*} (N : ℕ) (S : Finset β) (g : β → ℤ → ℝ) (c : ℝ) :
    (∑ s ∈ S, logAvg N (g s)) / c = logAvg N (fun n => (∑ s ∈ S, g s n) / c) :=
  wavg_sum_div _ _ _ (fun s (n : ℕ) => g s n) _

lemma uavg_logAvg_comm (T N : ℕ) (G : ℕ → ℤ → ℝ) :
    uavg T (fun t => logAvg N (G t)) = logAvg N (fun n => uavg T (fun t => G t n)) :=
  (Elem.logAvg_uavg_comm N T G).symm

lemma U1logSq_nonneg (N q H : ℕ) (f : ℤ → ℝ) : 0 ≤ U1logSq N q H f := by
  unfold U1logSq logAvg wavg
  apply div_nonneg
  · exact Finset.sum_nonneg fun n _ => mul_nonneg (by positivity) (sq_nonneg _)
  · exact Finset.sum_nonneg fun n _ => by positivity

/- ### The averages of the proof -/

/-- `G(s) = E_{t,t'∈[T]} E^log_{n∈[N]} f(n + mts) f(n + mt's)`. -/
noncomputable def Gs (N T m : ℕ) (f : ℤ → ℝ) (s : ℤ) : ℝ :=
  uavg T fun t => uavg T fun t' => logAvg N fun n =>
    f (n + (m : ℤ) * t * s) * f (n + (m : ℤ) * t' * s)

/-- `F(n) = E_{t,t'∈[T]} E_{s∈S} f(n + mts) f(n + mt's)`. -/
noncomputable def Fm (T m : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) (n : ℤ) : ℝ :=
  uavg T fun t => uavg T fun t' =>
    (∑ s ∈ S, f (n + (m : ℤ) * t * s) * f (n + (m : ℤ) * t' * s)) / S.card

/-- The correlation in the hypothesis of `L24.lemma24_gen`. -/
noncomputable def C24 (N T : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) : ℝ :=
  logAvg N fun n => uavg T fun t => uavg T fun t' =>
    (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card

lemma Gfun_eq (D : Data) (f₁ : ℤ → ℝ) (Q p₁ p₂ : ℕ) :
    Gfun D f₁ Q p₁ p₂ =
      Gs D.N (Nat.sqrt D.P₁) (D.lam * Q.factorial) f₁ ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2) := by
  unfold Gfun Gs
  congr 1; funext t; congr 1; funext t'; congr 1; funext n
  push_cast
  congr 1 <;> congr 1 <;> ring

lemma sum_Gs_eq (N T m : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) :
    (∑ s ∈ S, Gs N T m f s) / S.card = logAvg N (Fm T m S f) := by
  unfold Gs Fm
  simp_rw [uavg_sum_div, logAvg_sum_div, uavg_logAvg_comm]

lemma abs_Fm_le (T m : ℕ) (S : Finset ℤ) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (n : ℤ) :
    |Fm T m S f n| ≤ 1 := by
  unfold Fm
  rw [L24.avg3_eq]
  exact L24.abs_avg3_le_one T S _ fun t t' s => Elem.abs_mul_le_one (hf _) (hf _)

lemma logAvg_Fm_res (N T m : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) (a : ℕ) :
    logAvg N (fun n => Fm T m S f ((m : ℤ) * n + a)) =
      C24 N T S (fun y => f ((m : ℤ) * y + a)) := by
  unfold C24 Fm
  dsimp only
  congr 1; funext n; congr 1; funext t; congr 1; funext t'; congr 1
  refine Finset.sum_congr rfl fun s _ => ?_
  congr 1 <;> congr 1 <;> ring

lemma C24_le_one {N : ℕ} (hN : 1 ≤ N) (T : ℕ) (S : Finset ℤ) {g : ℤ → ℝ}
    (hg : ∀ n, |g n| ≤ 1) : C24 N T S g ≤ 1 :=
  L24.corr_le_one (goodWeights_logAvg hN) (fun n : ℕ => (n : ℤ)) hg S T

/- ### Lemma 2.4* on one residue class -/

/-- `β (C - ε/4) ≤ ∑_{q ≤ ⌊Q₀⌋} ‖g‖²_{U¹[q,H]}`, `β = (ε/4)²/(100 Q₀)`, for the correlation
`C` of `g`: Lemma 2.4* (threshold `ε/4`) if `C ≥ ε/4`, trivial otherwise. -/
lemma residue_bound {S : Finset ℤ} (hS : S.Nonempty) {T Dd N H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (Dd : ℤ)) {g : ℤ → ℝ} (hg : ∀ n, |g n| ≤ 1) (hN : 2 ≤ N)
    (hH : 1 ≤ H) {ε η Q₀ : ℝ} (hε : 0 < ε) (hη0 : 0 ≤ η) (hη : η ≤ ε / 40) (hQ₀ : 1 ≤ Q₀)
    (hFPD : L24.FPDProp S T Dd η Q₀ Q₀)
    (hlog : (1 + Real.log (10 * T * Dd)) / Real.log N ≤ (ε / 4) ^ 2 / (640 * Q₀))
    (hHW : 16 * H * Q₀ ≤ T * Dd) (hHQ : 20 * Q₀ ^ 2 * H ≤ (ε / 4) ^ 2 * (T * Dd)) :
    (ε / 4) ^ 2 / (100 * Q₀) * (C24 N T S g - ε / 4) ≤
      ∑ q ∈ Icc 1 ⌊Q₀⌋₊, U1logSq N q H g := by
  have hβ : 0 ≤ (ε / 4) ^ 2 / (100 * Q₀) := by
    have : 0 < Q₀ := by linarith
    positivity
  by_cases hc : ε / 4 ≤ C24 N T S g
  · obtain ⟨q, hq1, hqQ, hU⟩ := L24.lemma24_gen hS hSD hg hN hH (by positivity) hη0
      (by linarith) hFPD hlog hHW hHQ hc
    have hC1 : C24 N T S g ≤ 1 := C24_le_one (by omega) T S hg
    have hqK : q ∈ Icc 1 ⌊Q₀⌋₊ := Finset.mem_Icc.mpr ⟨hq1, Nat.le_floor hqQ⟩
    have hsingle : U1logSq N q H g ≤ ∑ q ∈ Icc 1 ⌊Q₀⌋₊, U1logSq N q H g :=
      Finset.single_le_sum (fun q _ => U1logSq_nonneg N q H g) hqK
    calc (ε / 4) ^ 2 / (100 * Q₀) * (C24 N T S g - ε / 4)
        ≤ (ε / 4) ^ 2 / (100 * Q₀) * 1 := mul_le_mul_of_nonneg_left (by linarith) hβ
      _ = (ε / 4) ^ 2 / (100 * Q₀) := mul_one _
      _ ≤ U1logSq N q H g := hU
      _ ≤ _ := hsingle
  · push Not at hc
    calc (ε / 4) ^ 2 / (100 * Q₀) * (C24 N T S g - ε / 4) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos hβ (by linarith)
      _ ≤ _ := Finset.sum_nonneg fun q _ => U1logSq_nonneg N q H g

/- ### The core argument -/

/-- **Core of P6g**: A.2 with modulus `m`, Lemma 2.4* on each residue class, pigeonhole in `q`,
A.2 again. -/
theorem core {S : Finset ℤ} (hS : S.Nonempty) {T Dd N H m : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (Dd : ℤ)) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (hN : 2 ≤ N)
    (hH : 1 ≤ H) (hm : 1 ≤ m) {ε η Q₀ : ℝ} (hε : 0 < ε) (hη0 : 0 ≤ η) (hη : η ≤ ε / 40)
    (hQ₀ : 1 ≤ Q₀) (hFPD : L24.FPDProp S T Dd η Q₀ Q₀)
    (hlog : (1 + Real.log (10 * T * Dd)) / Real.log N ≤ (ε / 4) ^ 2 / (640 * Q₀))
    (hHW : 16 * H * Q₀ ≤ T * Dd) (hHQ : 20 * Q₀ ^ 2 * H ≤ (ε / 4) ^ 2 * (T * Dd))
    (herr : 3 * (1 + Real.log m) / Real.log N ≤ ε / 4)
    (hcorr : ε ≤ (∑ s ∈ S, Gs N T m f s) / S.card) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧
      ε ^ 3 / (3200 * Q₀ ^ 2) - 3 * (1 + Real.log m) / Real.log N ≤
        U1logSq N (m * q) H f := by
  set err := 3 * (1 + Real.log m) / Real.log N with herr_def
  set K := ⌊Q₀⌋₊ with hK_def
  have hK1 : 1 ≤ K := Nat.le_floor (by exact_mod_cast hQ₀)
  have hKR : (0 : ℝ) < K := by exact_mod_cast hK1
  have hKQ : (K : ℝ) ≤ Q₀ := Nat.floor_le (by linarith)
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hQ₀0 : 0 < Q₀ := by linarith
  -- the functions on the residue classes
  set fa : ℕ → ℤ → ℝ := fun a y => f ((m : ℤ) * y + a) with hfa
  have hfab : ∀ a n, |fa a n| ≤ 1 := fun a n => hf _
  -- A.2: the average of the correlations on the residue classes
  rw [sum_Gs_eq] at hcorr
  have hA2 := Small.lemmaA2res hN hm (Fm T m S f) (abs_Fm_le T m S hf)
  have hsumC : ∑ a ∈ range m, logAvg N (fun n => Fm T m S f ((m : ℤ) * n + a)) =
      ∑ a ∈ range m, C24 N T S (fa a) :=
    Finset.sum_congr rfl fun a _ => logAvg_Fm_res N T m S f a
  rw [hsumC] at hA2
  have havg : m * (ε - err) ≤ ∑ a ∈ range m, C24 N T S (fa a) := by
    have h1 := (abs_le.mp hA2).1
    have h2 : ε - err ≤ (∑ a ∈ range m, C24 N T S (fa a)) / m := by linarith
    rwa [le_div_iff₀ hmR, mul_comm] at h2
  -- Lemma 2.4* on each residue class
  set β : ℝ := (ε / 4) ^ 2 / (100 * Q₀) with hβ_def
  have hβ0 : 0 ≤ β := by positivity
  have hres : ∀ a ∈ range m, β * (C24 N T S (fa a) - ε / 4) ≤
      ∑ q ∈ Icc 1 K, U1logSq N q H (fa a) :=
    fun a _ => residue_bound hS hSD (hfab a) hN hH hε hη0 hη hQ₀ hFPD hlog hHW hHQ
  -- sum over the residues
  have hsum : β * ε / 2 ≤ ∑ q ∈ Icc 1 K, (∑ a ∈ range m, U1logSq N q H (fa a)) / m := by
    have h1 := Finset.sum_le_sum hres
    have e1 : ∑ a ∈ range m, β * (C24 N T S (fa a) - ε / 4) =
        β * (∑ a ∈ range m, C24 N T S (fa a)) - β * (m * (ε / 4)) := by
      rw [← Finset.mul_sum, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul, mul_sub]
    have e2 : ∑ a ∈ range m, ∑ q ∈ Icc 1 K, U1logSq N q H (fa a) =
        m * ∑ q ∈ Icc 1 K, (∑ a ∈ range m, U1logSq N q H (fa a)) / m := by
      rw [Finset.sum_comm, Finset.mul_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [mul_div_cancel₀ _ hmR.ne']
    rw [e1, e2] at h1
    have h3 : β * (m * (ε - err)) ≤ β * ∑ a ∈ range m, C24 N T S (fa a) :=
      mul_le_mul_of_nonneg_left havg hβ0
    have h4 : m * (β * ε / 2) ≤ β * (m * (ε - err)) - β * (m * (ε / 4)) := by
      have h5 : 0 ≤ β * m * (ε / 4 - err) :=
        mul_nonneg (mul_nonneg hβ0 hmR.le) (by linarith)
      nlinarith
    have h6 : m * (β * ε / 2) ≤
        m * ∑ q ∈ Icc 1 K, (∑ a ∈ range m, U1logSq N q H (fa a)) / m := by linarith
    exact le_of_mul_le_mul_left h6 hmR
  -- pigeonhole in `q`
  obtain ⟨q, hqK, hq⟩ : ∃ q ∈ Icc 1 K,
      β * ε / 2 / K ≤ (∑ a ∈ range m, U1logSq N q H (fa a)) / m := by
    refine Finset.exists_le_of_sum_le (Finset.nonempty_Icc.mpr hK1) ?_
    rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel,
      mul_div_cancel₀ _ hKR.ne']
    exact hsum
  -- A.2 again
  set G : ℤ → ℝ := fun n => (uavg H fun h => f (n + ((m * q : ℕ) : ℤ) * h)) ^ 2 with hG_def
  have hGb : ∀ n, |G n| ≤ 1 := fun n => by
    simp only [hG_def]
    rw [abs_pow]
    exact pow_le_one₀ (abs_nonneg _) (abs_uavg_le_one fun h => hf _)
  have hA2' := Small.lemmaA2res hN hm G hGb
  have hUres : ∀ a : ℕ, logAvg N (fun n => G ((m : ℤ) * n + a)) = U1logSq N q H (fa a) := by
    intro a
    unfold U1logSq
    congr 1; funext n
    simp only [hG_def, hfa]
    congr 2; funext h
    congr 1; push_cast; ring
  have hsumU : ∑ a ∈ range m, logAvg N (fun n => G ((m : ℤ) * n + a)) =
      ∑ a ∈ range m, U1logSq N q H (fa a) := Finset.sum_congr rfl fun a _ => hUres a
  rw [hsumU] at hA2'
  have hUG : logAvg N G = U1logSq N (m * q) H f := rfl
  rw [hUG] at hA2'
  have hfin := (abs_le.mp hA2').2
  -- bookkeeping
  refine ⟨q, (Finset.mem_Icc.mp hqK).1, ?_, ?_⟩
  · have : (q : ℝ) ≤ K := by exact_mod_cast (Finset.mem_Icc.mp hqK).2
    linarith
  · have h1 : ε ^ 3 / (3200 * Q₀ ^ 2) ≤ β * ε / 2 / K := by
      rw [hβ_def, div_le_div_iff₀ (by positivity) hKR]
      have e : (ε / 4) ^ 2 / (100 * Q₀) * ε / 2 * (3200 * Q₀ ^ 2) = ε ^ 3 * Q₀ := by
        field_simp
        ring
      rw [e]
      exact mul_le_mul_of_nonneg_left hKQ (by positivity)
    linarith

/- ### Boxes -/

/-- Elements of a `Good5` box are `< 2Y`, `Y = ∏ a ℓ`. -/
lemma good5_mem_lt (D : Data) {a b : Fin D.k → ℕ} (hG : Good5 D a b) {x : ℕ}
    (hx : x ∈ almostPrimes a b) : x < 2 * ∏ ℓ, a ℓ := by
  obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hx
  have hg' := Fintype.mem_piFinset.mp hg
  have hmem : ∀ ℓ, a ℓ ≤ g ℓ ∧ g ℓ < b ℓ := fun ℓ =>
    Finset.mem_Ico.mp (Finset.mem_filter.mp (hg' ℓ)).1
  have hk := D.hk
  have hkR : (1 : ℝ) ≤ D.k := by exact_mod_cast hk
  have hapos : ∀ ℓ, 0 < a ℓ := fun ℓ => by
    have h1 := (hG ℓ).1
    have h2 := (D.hI ℓ).1
    have h3 := D.hP₁'
    omega
  have hb : ∀ ℓ, (b ℓ : ℝ) ≤ (1 + 1 / (4 * (D.k : ℝ))) * a ℓ := by
    intro ℓ
    have h := (hG ℓ).2.2.2.1
    have h' : (4 * D.k : ℝ) * b ℓ ≤ (4 * D.k + 1) * a ℓ := by exact_mod_cast h
    have e : (1 + 1 / (4 * (D.k : ℝ))) * a ℓ = ((4 * D.k + 1) * a ℓ) / (4 * D.k) := by
      field_simp
    rw [e, le_div_iff₀ (by positivity)]
    linarith
  have key : ((∏ ℓ, g ℓ : ℕ) : ℝ) < 2 * ((∏ ℓ, a ℓ : ℕ) : ℝ) := by
    push_cast
    calc ∏ ℓ, (g ℓ : ℝ) ≤ ∏ ℓ, (b ℓ : ℝ) :=
          Finset.prod_le_prod (fun ℓ _ => Nat.cast_nonneg _)
            (fun ℓ _ => by exact_mod_cast (hmem ℓ).2.le)
      _ ≤ ∏ ℓ, ((1 + 1 / (4 * (D.k : ℝ))) * a ℓ) :=
          Finset.prod_le_prod (fun ℓ _ => Nat.cast_nonneg _) (fun ℓ _ => hb ℓ)
      _ = (1 + 1 / (4 * (D.k : ℝ))) ^ D.k * ∏ ℓ, (a ℓ : ℝ) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ < 2 * ∏ ℓ, (a ℓ : ℝ) := by
          apply mul_lt_mul_of_pos_right (FPDQ.one_add_pow_lt_two hk le_rfl)
          exact Finset.prod_pos fun ℓ _ => by exact_mod_cast hapos ℓ
  exact_mod_cast key

lemma good5_prod_le (D : Data) {a b : Fin D.k → ℕ} (hG : Good5 D a b) :
    ∏ ℓ, a ℓ ≤ D.P₂' := by
  calc ∏ ℓ, a ℓ ≤ ∏ ℓ : Fin D.k, D.hi ℓ.castSucc :=
        Finset.prod_le_prod (fun _ _ => Nat.zero_le _) (fun ℓ _ => by
          obtain ⟨h1, h2, h3, -, -⟩ := hG ℓ
          omega)
    _ ≤ D.P₂' := D.hprod

lemma good5_prod_pos (D : Data) {a b : Fin D.k → ℕ} (hG : Good5 D a b) :
    1 ≤ ∏ ℓ, a ℓ := by
  have : 0 < ∏ ℓ, a ℓ := Finset.prod_pos fun ℓ _ => by
    have h1 := (hG ℓ).1
    have h2 := (D.hI ℓ).1
    have h3 := D.hP₁'
    omega
  omega

lemma sq_map_injective {e c : ℤ} (he : e = 1 ∨ e = -1) :
    Function.Injective (fun x : ℕ => e * ((x : ℤ) ^ 2 - c)) := by
  intro x y hxy
  simp only at hxy
  have he0 : e ≠ 0 := by rcases he with rfl | rfl <;> norm_num
  have h1 : (x : ℤ) ^ 2 = (y : ℤ) ^ 2 := by
    have := mul_left_cancel₀ he0 hxy
    linarith
  have h2 : x ^ 2 = y ^ 2 := by exact_mod_cast h1
  exact Nat.pow_left_injective (by norm_num) h2

/- ### Growth -/

lemma one_lt_log_three_le {n : ℕ} (hn : 3 ≤ n) : 1 < Real.log n := by
  have h3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [Real.lt_log_iff_exp_lt (by linarith)]
  have := Real.exp_one_lt_d9
  norm_num at this
  linarith

/-- `c xⁿ ≤ eˣ` once `x ≥ c (n+1)!`. -/
lemma mul_pow_le_exp {c x : ℝ} (n : ℕ) (_hc : 0 ≤ c) (hx : c * (n + 1).factorial ≤ x)
    (hx0 : 0 ≤ x) : c * x ^ n ≤ Real.exp x := by
  have hfac : (0 : ℝ) < (n + 1).factorial := by exact_mod_cast Nat.factorial_pos _
  have h := Real.pow_div_factorial_le_exp x hx0 (n + 1)
  calc c * x ^ n = c * (n + 1).factorial * x ^ n / (n + 1).factorial := by
        field_simp
    _ ≤ x * x ^ n / (n + 1).factorial := by gcongr
    _ = x ^ (n + 1) / (n + 1).factorial := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h

/-- From `v⁴ ≤ u` and `c⁴K⁴ ≤ u³`: `cKv ≤ u`. -/
lemma quartic {u v c K : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) (hc : 0 ≤ c) (hK : 0 ≤ K)
    (hvu : v ^ 4 ≤ u) (hcK : c ^ 4 * K ^ 4 ≤ u ^ 3) : c * K * v ≤ u := by
  have h : (c * K * v) ^ 4 ≤ u ^ 4 := by
    calc (c * K * v) ^ 4 = (c ^ 4 * K ^ 4) * v ^ 4 := by ring
      _ ≤ u ^ 3 * u := by gcongr
      _ = u ^ 4 := by ring
  exact (pow_le_pow_iff_left₀ (by positivity) hu (by norm_num)).mp h

lemma le_cube {u : ℝ} (hu : 1 ≤ u) : u ≤ u ^ 3 := by
  have h : 1 ≤ u ^ 2 := one_le_pow₀ hu
  calc u = u * 1 := (mul_one u).symm
    _ ≤ u * u ^ 2 := mul_le_mul_of_nonneg_left h (by linarith)
    _ = u ^ 3 := by ring

/-- The exponent `J` of the largeness condition on `log log N`. -/
def JJ (A' C₂ : ℕ) : ℕ := 72 + 8 * A' + 2 * C₂

/-- The exponent `M` of the largeness condition on `P'₁`. -/
def MM (A' : ℕ) : ℕ := 10 * (2 * A' + 12)

/-- The threshold `L₀` for `log log N`. -/
noncomputable def L0 (A' C₂ : ℕ) : ℝ :=
  max ((81920 : ℝ) ^ 4 * (JJ A' C₂ + 1).factorial) ((80 * ((MM A' + 1).factorial : ℝ)) ^ 10)

lemma loglog_facts (A' C₂ : ℕ) (D : Data) (hN2 : 2 ≤ D.N)
    (hL : L0 A' C₂ ≤ Real.log (Real.log D.N)) :
    0 < Real.log D.N ∧ 1 ≤ Real.log (Real.log D.N) ∧
      ∀ j ≤ JJ A' C₂, (81920 : ℝ) ^ 4 * Real.log (Real.log D.N) ^ j ≤ Real.log D.N := by
  set L := Real.log (Real.log D.N) with hLdef
  have hu : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
  have hL1 : (81920 : ℝ) ^ 4 * (JJ A' C₂ + 1).factorial ≤ L := le_trans (le_max_left _ _) hL
  have hfac : (1 : ℝ) ≤ (JJ A' C₂ + 1).factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hL1' : 1 ≤ L := by
    have : (1 : ℝ) ≤ (81920 : ℝ) ^ 4 * (JJ A' C₂ + 1).factorial := by
      have h8 : (1 : ℝ) ≤ (81920 : ℝ) ^ 4 := by norm_num
      nlinarith
    linarith
  refine ⟨hu, hL1', fun j hj => ?_⟩
  have h2 := mul_pow_le_exp (JJ A' C₂) (by positivity) hL1 (by linarith)
  have h3 : Real.exp L = Real.log D.N := Real.exp_log hu
  calc (81920 : ℝ) ^ 4 * L ^ j ≤ 81920 ^ 4 * L ^ JJ A' C₂ :=
        mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hL1' hj) (by positivity)
    _ ≤ Real.exp L := h2
    _ = Real.log D.N := h3

/-- `80 δ^{-(2A'+12)} ≤ P'₁` (from `1/δ ≤ log log N ≤ (log log P'₁)¹⁰`). -/
lemma P1'_big (A' C₂ : ℕ) (D : Data) (hL : L0 A' C₂ ≤ Real.log (Real.log D.N)) :
    80 * (1 / D.δ) ^ (2 * A' + 12) ≤ (D.P₁' : ℝ) := by
  set L := Real.log (Real.log D.N) with hLdef
  set w := Real.log D.P₁' with hw
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact_mod_cast (by omega : 0 < D.P₁')
  have hw1 : 1 < w := one_lt_log_three_le D.hP₁'
  have hz0 : 0 < Real.log w := Real.log_pos hw1
  have hzw : Real.log w ≤ w := Real.log_le_self (by linarith)
  have hLz : L ≤ (Real.log w) ^ 10 := D.hP₁'N
  have hLw : L ≤ w ^ 10 := hLz.trans (pow_le_pow_left₀ hz0.le hzw 10)
  have hW : 80 * ((MM A' + 1).factorial : ℝ) ≤ w := by
    have h1 : (80 * ((MM A' + 1).factorial : ℝ)) ^ 10 ≤ w ^ 10 :=
      (le_trans (le_max_right _ _) hL).trans hLw
    exact (pow_le_pow_iff_left₀ (by positivity) (by linarith) (by norm_num)).mp h1
  have hX : 1 / D.δ ≤ L := D.hδN
  have hX0 : 0 ≤ 1 / D.δ := le_of_lt (one_div_pos.mpr D.hδ)
  calc 80 * (1 / D.δ) ^ (2 * A' + 12) ≤ 80 * (w ^ 10) ^ (2 * A' + 12) := by
        gcongr
        exact hX.trans hLw
    _ = 80 * w ^ (MM A') := by rw [← pow_mul]; rfl
    _ ≤ Real.exp w := mul_pow_le_exp (MM A') (by norm_num) hW (by linarith)
    _ = D.P₁' := Real.exp_log hP₁'pos

/-- The `log`-condition of Lemma 2.4*: `(1 + log Z) · 10240 δ^{-(12+A')} ≤ log N` for
`1 ≤ Z ≤ P₂⁴`. -/
lemma log_small (A' C₂ : ℕ) (D : Data) (hN2 : 2 ≤ D.N)
    (hL : L0 A' C₂ ≤ Real.log (Real.log D.N)) {Z : ℝ} (hZ1 : 1 ≤ Z)
    (hZ : Z ≤ (D.P₂ : ℝ) ^ 4) :
    (1 + Real.log Z) * (10240 * (1 / D.δ) ^ (12 + A')) ≤ Real.log D.N := by
  obtain ⟨hu, hL1, hJ⟩ := loglog_facts A' C₂ D hN2 hL
  set L := Real.log (Real.log D.N) with hLdef
  set u := Real.log D.N with hudef
  set X := 1 / D.δ with hXdef
  have hX0 : 0 ≤ X := le_of_lt (one_div_pos.mpr D.hδ)
  have hXL : X ≤ L := D.hδN
  have hP₂3 : 3 ≤ D.P₂ := by
    have h1 := D.hP₁'
    have h2 := D.hP₁'P₂'
    have h3 := D.hP₂'P₁
    have h4 := D.hP₁P₂
    unfold Data.P₂
    omega
  set v := Real.log (D.P₂ : ℝ) with hvdef
  have hv1 : 1 < v := one_lt_log_three_le hP₂3
  have hv4 : v ^ 4 ≤ u := D.hP₂N.le
  have hlogZ : Real.log Z ≤ 4 * v := by
    calc Real.log Z ≤ Real.log ((D.P₂ : ℝ) ^ 4) := Real.log_le_log (by linarith) hZ
      _ = 4 * v := by rw [Real.log_pow, hvdef]; norm_num
  have hu1 : 1 ≤ u := by
    have := hJ 0 (Nat.zero_le _)
    have h8 : (1 : ℝ) ≤ (81920 : ℝ) ^ 4 := by norm_num
    simp only [pow_zero, mul_one] at this
    linarith
  have hK4 : (51200 : ℝ) ^ 4 * (X ^ (12 + A')) ^ 4 ≤ u ^ 3 := by
    have hj : 48 + 4 * A' ≤ JJ A' C₂ := by unfold JJ; omega
    have hX4 : (X ^ (12 + A')) ^ 4 ≤ L ^ (48 + 4 * A') := by
      rw [← pow_mul]
      have e : (12 + A') * 4 = 48 + 4 * A' := by ring
      rw [e]
      exact pow_le_pow_left₀ hX0 hXL _
    calc (51200 : ℝ) ^ 4 * (X ^ (12 + A')) ^ 4 ≤ 81920 ^ 4 * L ^ (48 + 4 * A') :=
          mul_le_mul (by norm_num) hX4 (by positivity) (by positivity)
      _ ≤ u := hJ _ hj
      _ ≤ u ^ 3 := le_cube hu1
  have hq : 51200 * X ^ (12 + A') * v ≤ u :=
    quartic hu.le (by linarith) (by norm_num) (by positivity) hv4 hK4
  calc (1 + Real.log Z) * (10240 * X ^ (12 + A')) ≤ (5 * v) * (10240 * X ^ (12 + A')) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ = 51200 * X ^ (12 + A') * v := by ring
    _ ≤ u := hq

/-- The error of A.2: `3 (1 + log λQ!) · 6400 δ^{-(18+2A')} ≤ log N`. -/
lemma err_small (A' C₂ : ℕ) (D : Data) (hN2 : 2 ≤ D.N)
    (hL : L0 A' C₂ ≤ Real.log (Real.log D.N)) :
    3 * (1 + Real.log ((D.lam * (D.Q C₂).factorial : ℕ) : ℝ)) *
      (6400 * (1 / D.δ) ^ (18 + 2 * A')) ≤ Real.log D.N := by
  obtain ⟨hu, hL1, hJ⟩ := loglog_facts A' C₂ D hN2 hL
  set L := Real.log (Real.log D.N) with hLdef
  set u := Real.log D.N with hudef
  set X := 1 / D.δ with hXdef
  have hX0 : 0 ≤ X := le_of_lt (one_div_pos.mpr D.hδ)
  have hXL : X ≤ L := D.hδN
  have hL0 : 0 ≤ L := by linarith
  have hu1 : 1 ≤ u := by
    have := hJ 0 (Nat.zero_le _)
    have h8 : (1 : ℝ) ≤ (81920 : ℝ) ^ 4 := by norm_num
    simp only [pow_zero, mul_one] at this
    linarith
  -- `log m ≤ log λ + L^{2C₂}`
  have hlam1 : (1 : ℝ) ≤ D.lam := by exact_mod_cast D.hlam
  set v := Real.log (D.lam : ℝ) with hvdef
  have hv0 : 0 ≤ v := Real.log_nonneg hlam1
  have hv4 : v ^ 4 ≤ u := D.hlamN
  set Q := D.Q C₂ with hQdef
  have hQ0 : (0 : ℝ) ≤ Q := Nat.cast_nonneg _
  have hQ : (Q : ℝ) ≤ L ^ C₂ := by
    have h1 : (Q : ℝ) ≤ X ^ C₂ := Nat.floor_le (by positivity)
    exact h1.trans (pow_le_pow_left₀ hX0 hXL C₂)
  have hlogfac : Real.log (Q.factorial : ℝ) ≤ L ^ (2 * C₂) := by
    have hfac_pos : (0 : ℝ) < Q.factorial := by exact_mod_cast Nat.factorial_pos Q
    have h1 : (Q.factorial : ℝ) ≤ (Q : ℝ) ^ Q := by exact_mod_cast Nat.factorial_le_pow Q
    calc Real.log (Q.factorial : ℝ) ≤ Real.log ((Q : ℝ) ^ Q) := Real.log_le_log hfac_pos h1
      _ = Q * Real.log Q := Real.log_pow _ _
      _ ≤ Q * Q := mul_le_mul_of_nonneg_left (Real.log_le_self hQ0) hQ0
      _ ≤ L ^ C₂ * L ^ C₂ := mul_le_mul hQ hQ hQ0 (by positivity)
      _ = L ^ (2 * C₂) := by rw [← pow_add, two_mul]
  have hlogm : Real.log ((D.lam * Q.factorial : ℕ) : ℝ) ≤ v + L ^ (2 * C₂) := by
    have hfac_pos : (0 : ℝ) < Q.factorial := by exact_mod_cast Nat.factorial_pos Q
    push_cast
    rw [Real.log_mul (by positivity) hfac_pos.ne']
    linarith
  -- the three pieces
  set n := 18 + 2 * A' with hn
  have hXn : X ^ n ≤ L ^ n := pow_le_pow_left₀ hX0 hXL n
  have h8 : (57600 : ℝ) ≤ 81920 ^ 4 := by norm_num
  have hp1 : 57600 * X ^ n ≤ u := by
    have hj : n ≤ JJ A' C₂ := by unfold JJ; omega
    calc 57600 * X ^ n ≤ 81920 ^ 4 * L ^ n :=
          mul_le_mul h8 hXn (by positivity) (by positivity)
      _ ≤ u := hJ n hj
  have hp2 : 57600 * (L ^ (2 * C₂) * X ^ n) ≤ u := by
    have hj : 2 * C₂ + n ≤ JJ A' C₂ := by unfold JJ; omega
    calc 57600 * (L ^ (2 * C₂) * X ^ n) ≤ 81920 ^ 4 * (L ^ (2 * C₂) * L ^ n) :=
          mul_le_mul h8 (mul_le_mul_of_nonneg_left hXn (by positivity)) (by positivity)
            (by positivity)
      _ = 81920 ^ 4 * L ^ (2 * C₂ + n) := by rw [pow_add L (2 * C₂) n]
      _ ≤ u := hJ _ hj
  have hp3 : 57600 * X ^ n * v ≤ u := by
    have hK4 : (57600 : ℝ) ^ 4 * (X ^ n) ^ 4 ≤ u ^ 3 := by
      have hj : 4 * n ≤ JJ A' C₂ := by unfold JJ; omega
      have hX4 : (X ^ n) ^ 4 ≤ L ^ (4 * n) := by
        rw [← pow_mul, mul_comm n 4]
        exact pow_le_pow_left₀ hX0 hXL _
      calc (57600 : ℝ) ^ 4 * (X ^ n) ^ 4 ≤ 81920 ^ 4 * L ^ (4 * n) :=
            mul_le_mul (by norm_num) hX4 (by positivity) (by positivity)
        _ ≤ u := hJ _ hj
        _ ≤ u ^ 3 := le_cube hu1
    exact quartic (by linarith) hv0 (by norm_num) (by positivity) hv4 hK4
  have hb : 3 * (1 + Real.log ((D.lam * Q.factorial : ℕ) : ℝ)) * (6400 * X ^ n) ≤
      3 * (1 + (v + L ^ (2 * C₂))) * (6400 * X ^ n) :=
    mul_le_mul_of_nonneg_right (by linarith) (by positivity)
  have e : 3 * (1 + (v + L ^ (2 * C₂))) * (6400 * X ^ n) =
      (57600 * X ^ n + 57600 * (L ^ (2 * C₂) * X ^ n) + 57600 * X ^ n * v) / 3 := by ring
  linarith

/- ### Numerics in terms of `X = 1/δ` -/

lemma num_h16 (A' : ℕ) {δ X Y T P : ℝ} (hδX : δ = 1 / X) (hX1 : 1 ≤ X) (hY0 : 0 ≤ Y)
    (hYP : Y ≤ P) (hP1 : 1 ≤ P) (hPX : 16 * X ^ A' ≤ P) (hPT : P ^ 5 ≤ T) :
    16 * Y ^ 2 ≤ δ ^ A' * T := by
  have hX0 : 0 < X := by linarith
  have hδA : δ ^ A' = 1 / X ^ A' := by rw [hδX, one_div_pow]
  rw [hδA, one_div_mul_eq_div, le_div_iff₀ (by positivity)]
  have hP0 : 0 ≤ P := by linarith
  have hXA : 0 ≤ X ^ A' := by positivity
  calc 16 * Y ^ 2 * X ^ A' ≤ 16 * P ^ 2 * X ^ A' :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hY0 hYP 2) (by norm_num)) hXA
    _ = P ^ 2 * (16 * X ^ A') := by ring
    _ ≤ P ^ 2 * P := mul_le_mul_of_nonneg_left hPX (by positivity)
    _ = P ^ 3 := by ring
    _ ≤ P ^ 5 := pow_le_pow_right₀ hP1 (by norm_num)
    _ ≤ T := hPT

lemma num_hHW (A' : ℕ) {X H T Dd : ℝ} (hX1 : 1 ≤ X) (hHX : 80 * X ^ (2 * A' + 12) ≤ H)
    (hHT : H ^ 2 ≤ T) (hDd : 4 ≤ Dd) (hH0 : 0 ≤ H) (hT0 : 0 ≤ T) :
    16 * H * X ^ A' ≤ T * Dd := by
  have hXA : X ^ A' ≤ X ^ (2 * A' + 12) := pow_le_pow_right₀ hX1 (by omega)
  have hXA0 : 0 ≤ X ^ A' := pow_nonneg (by linarith) _
  have h4X : 4 * X ^ A' ≤ H := by linarith
  calc 16 * H * X ^ A' = 4 * H * (4 * X ^ A') := by ring
    _ ≤ 4 * H * H := mul_le_mul_of_nonneg_left h4X (by positivity)
    _ = 4 * H ^ 2 := by ring
    _ ≤ 4 * T := by linarith
    _ = T * 4 := by ring
    _ ≤ T * Dd := mul_le_mul_of_nonneg_left hDd hT0

lemma num_hHQ (A' : ℕ) {δ X H T Dd : ℝ} (hδX : δ = 1 / X) (hX1 : 1 ≤ X)
    (hHX : 80 * X ^ (2 * A' + 12) ≤ H) (hHT : H ^ 2 ≤ T) (hDd : 4 ≤ Dd) (hH0 : 0 ≤ H)
    (hT0 : 0 ≤ T) : 20 * (X ^ A') ^ 2 * H ≤ (δ ^ 6 / 4) ^ 2 * (T * Dd) := by
  have hX0 : 0 < X := by linarith
  have hXne : X ≠ 0 := hX0.ne'
  have e : (δ ^ 6 / 4) ^ 2 = 1 / (16 * X ^ 12) := by
    rw [hδX]
    field_simp
    ring
  rw [e, one_div_mul_eq_div, le_div_iff₀ (by positivity)]
  calc 20 * (X ^ A') ^ 2 * H * (16 * X ^ 12) = 4 * H * (80 * X ^ (2 * A' + 12)) := by ring
    _ ≤ 4 * H * H := mul_le_mul_of_nonneg_left hHX (by positivity)
    _ = 4 * H ^ 2 := by ring
    _ ≤ 4 * T := by linarith
    _ = T * 4 := by ring
    _ ≤ T * Dd := mul_le_mul_of_nonneg_left hDd hT0

lemma num_hlog (A' : ℕ) {δ X Z u : ℝ} (hδX : δ = 1 / X) (hX0 : 0 < X) (hu : 0 < u)
    (key : (1 + Real.log Z) * (10240 * X ^ (12 + A')) ≤ u) :
    (1 + Real.log Z) / u ≤ (δ ^ 6 / 4) ^ 2 / (640 * X ^ A') := by
  have hXne : X ≠ 0 := hX0.ne'
  have e : (δ ^ 6 / 4) ^ 2 / (640 * X ^ A') = 1 / (10240 * X ^ (12 + A')) := by
    rw [hδX]
    field_simp
    ring
  rw [e, div_le_div_iff₀ hu (by positivity), one_mul]
  exact key

lemma num_herr (A' : ℕ) {δ X E u : ℝ} (hδX : δ = 1 / X) (hX1 : 1 ≤ X) (hu : 0 < u)
    (key : E * (6400 * X ^ (18 + 2 * A')) ≤ u) :
    E / u ≤ 1 / (6400 * X ^ (18 + 2 * A')) ∧ E / u ≤ δ ^ 6 / 4 := by
  have hX0 : 0 < X := by linarith
  have hXne : X ≠ 0 := hX0.ne'
  have h1 : E / u ≤ 1 / (6400 * X ^ (18 + 2 * A')) := by
    rw [div_le_div_iff₀ hu (by positivity), one_mul]
    exact key
  refine ⟨h1, h1.trans ?_⟩
  have e : δ ^ 6 / 4 = 1 / (4 * X ^ 6) := by
    rw [hδX]
    field_simp
  rw [e, one_div_le_one_div (by positivity) (by positivity)]
  have : X ^ 6 ≤ X ^ (18 + 2 * A') := pow_le_pow_right₀ hX1 (by omega)
  have : 0 ≤ X ^ 6 := by positivity
  linarith

lemma num_final (A' : ℕ) {δ X U E : ℝ} (hδX : δ = 1 / X) (hX80 : 80 ≤ X)
    (hE : E ≤ 1 / (6400 * X ^ (18 + 2 * A')))
    (hU : (δ ^ 6) ^ 3 / (3200 * (X ^ A') ^ 2) - E ≤ U) : δ ^ (2 * A' + 20) ≤ U := by
  have hX0 : 0 < X := by linarith
  have hXne : X ≠ 0 := hX0.ne'
  have hmain : (δ ^ 6) ^ 3 / (3200 * (X ^ A') ^ 2) = 2 * (1 / (6400 * X ^ (18 + 2 * A'))) := by
    rw [hδX]
    field_simp
    ring
  have hfin : δ ^ (2 * A' + 20) ≤ 1 / (6400 * X ^ (18 + 2 * A')) := by
    rw [hδX, one_div_pow, one_div_le_one_div (by positivity) (by positivity)]
    have e2 : X ^ (2 * A' + 20) = X ^ 2 * X ^ (18 + 2 * A') := by ring
    rw [e2]
    have hX2 : (6400 : ℝ) ≤ X ^ 2 := by
      calc (6400 : ℝ) = 80 ^ 2 := by norm_num
        _ ≤ X ^ 2 := pow_le_pow_left₀ (by norm_num) hX80 2
    exact mul_le_mul_of_nonneg_right hX2 (by positivity)
  linarith

lemma num_eta {δ : ℝ} (hδ0 : 0 < δ) (hδ80 : δ ≤ 1 / 80) : δ ^ 7 ≤ δ ^ 6 / 40 := by
  have h6 : 0 < δ ^ 6 := pow_pos hδ0 6
  calc δ ^ 7 = δ ^ 6 * δ := pow_succ _ _
    _ ≤ δ ^ 6 * (1 / 80) := mul_le_mul_of_nonneg_left hδ80 h6.le
    _ ≤ δ ^ 6 / 40 := by linarith

lemma sq_lt_four_sq {x Y : ℤ} (hx : 0 ≤ x) (h : x < 2 * Y) : x ^ 2 < 4 * Y ^ 2 := by
  have := mul_lt_mul'' h h hx hx
  calc x ^ 2 = x * x := sq x
    _ < 2 * Y * (2 * Y) := this
    _ = 4 * Y ^ 2 := by ring

/- ### One box -/

/-- **P6g for one box.** The variable of the box `(a, b)` is averaged, the other one is fixed to
`y₀ < 2Y` (`Y = ∏ a ℓ`), `c = y₀²`, `e = ±1`. -/
theorem main_case (A' C₂ : ℕ) (D : Data) (hδ80 : D.δ ≤ 1 / 80) (hN2 : 2 ≤ D.N)
    (hL : L0 A' C₂ ≤ Real.log (Real.log D.N)) (f₁ : ℤ → ℝ) (hf : ∀ n, |f₁ n| ≤ 1)
    (a b : Fin D.k → ℕ) (hG : Good5 D a b) (hSq : SqFPD D A' a b)
    (e c : ℤ) (he : e = 1 ∨ e = -1) (y₀ : ℕ) (hc : c = (y₀ : ℤ) ^ 2)
    (hy₀ : y₀ < 2 * ∏ ℓ, a ℓ)
    (hcorr : D.δ ^ 6 ≤ favg (almostPrimes a b) (fun x =>
      Gs D.N (Nat.sqrt D.P₁) (D.lam * (D.Q C₂).factorial) f₁ (e * ((x : ℤ) ^ 2 - c)))) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (1 / D.δ) ^ A' ∧
      D.δ ^ (2 * A' + 20) ≤
        U1logSq D.N (D.lam * (D.Q C₂).factorial * q) (Nat.sqrt (Nat.sqrt D.P₁)) f₁ := by
  have hδ0 := D.hδ
  -- growth
  have hbig := P1'_big A' C₂ D hL
  have herrN := err_small A' C₂ D hN2 hL
  have hlogZ := fun (Z : ℝ) (h1 : 1 ≤ Z) (h2 : Z ≤ (D.P₂ : ℝ) ^ 4) =>
    log_small A' C₂ D hN2 hL h1 h2
  obtain ⟨hu, -, -⟩ := loglog_facts A' C₂ D hN2 hL
  have hX80 : 80 ≤ 1 / D.δ := by
    have := one_div_le_one_div_of_le hδ0 hδ80
    rwa [one_div_one_div] at this
  -- the box and the parameters
  have hSq' := hSq e c he (Nat.sqrt D.P₁)
  have hY1 : 1 ≤ ∏ ℓ, a ℓ := good5_prod_pos D hG
  have hYP : ∏ ℓ, a ℓ ≤ D.P₂' := good5_prod_le D hG
  have hmem : ∀ x ∈ almostPrimes a b, x < 2 * ∏ ℓ, a ℓ := fun x hx => good5_mem_lt D hG hx
  have hP₂'1 : 1 ≤ D.P₂' := by have := D.hP₁'; have := D.hP₁'P₂'; omega
  have hP₁'P₂' : D.P₁' < D.P₂' := D.hP₁'P₂'
  have hpow : D.P₂' ^ 10 ≤ D.P₁ := D.hpow
  have hP₁P₂ : D.P₁ < D.P₂ := D.hP₁P₂
  have hP₂'P₁ : D.P₂' < D.P₁ := D.hP₂'P₁
  have h1024 : 1024 ≤ D.P₂' ^ 10 := by
    have h2 : 2 ≤ D.P₂' := by have := D.hP₁'; omega
    calc 1024 = 2 ^ 10 := by norm_num
      _ ≤ D.P₂' ^ 10 := Nat.pow_le_pow_left h2 10
  have hm1 : 1 ≤ D.lam * (D.Q C₂).factorial := by
    have hlam := D.hlam
    have hfac := Nat.factorial_pos (D.Q C₂)
    have : 0 < D.lam * (D.Q C₂).factorial := Nat.mul_pos (by omega) hfac
    omega
  set T := Nat.sqrt D.P₁ with hT
  set H := Nat.sqrt T with hH
  set m := D.lam * (D.Q C₂).factorial with hm
  set Y := ∏ ℓ, a ℓ with hY
  set X := 1 / D.δ with hX
  have hT5 : D.P₂' ^ 5 ≤ T := Nat.le_sqrt.mpr (by
    calc D.P₂' ^ 5 * D.P₂' ^ 5 = D.P₂' ^ 10 := by ring
      _ ≤ D.P₁ := hpow)
  have hTP₁ : T ≤ D.P₁ := Nat.sqrt_le_self _
  have hHT : H ^ 2 ≤ T := Nat.sqrt_le' T
  have hH2 : D.P₂' ^ 2 ≤ H := Nat.le_sqrt.mpr (by
    calc D.P₂' ^ 2 * D.P₂' ^ 2 = D.P₂' ^ 4 := by ring
      _ ≤ D.P₂' ^ 5 := Nat.pow_le_pow_right hP₂'1 (by norm_num)
      _ ≤ T := hT5)
  have hδX : D.δ = 1 / X := by rw [hX, one_div_one_div]
  clear_value T H m Y X
  -- facts in `ℕ`
  have hP₂'sq : D.P₂' ≤ D.P₂' ^ 2 := Nat.le_self_pow (by norm_num) _
  have hP₁'H : D.P₁' ≤ H := by omega
  have hH1 : 1 ≤ H := by have := D.hP₁'; omega
  have hT1 : 1 ≤ T := by
    have : 1 ≤ H ^ 2 := Nat.one_le_pow _ _ (by omega)
    omega
  have hY2 : 1 ≤ Y ^ 2 := Nat.one_le_pow _ _ (by omega)
  have hDd4N : 4 ≤ 4 * Y ^ 2 := by omega
  have hN4 : 10 * T * (4 * Y ^ 2) ≤ D.P₂ ^ 4 := by
    have hTP₂ : T ≤ D.P₂ := by omega
    have hYP₂ : Y ≤ D.P₂ := by omega
    have h40 : 40 ≤ D.P₂ := by omega
    calc 10 * T * (4 * Y ^ 2) ≤ 10 * D.P₂ * (4 * D.P₂ ^ 2) :=
          Nat.mul_le_mul (Nat.mul_le_mul_left 10 hTP₂)
            (Nat.mul_le_mul_left 4 (Nat.pow_le_pow_left hYP₂ 2))
      _ = 40 * D.P₂ ^ 3 := by ring
      _ ≤ D.P₂ * D.P₂ ^ 3 := Nat.mul_le_mul_right _ h40
      _ = D.P₂ ^ 4 := by ring
  -- facts in `ℝ`
  have hX1 : 1 ≤ X := by linarith
  have hX0 : 0 < X := by linarith
  have hH0 : (0 : ℝ) ≤ H := Nat.cast_nonneg _
  have hT0 : (0 : ℝ) ≤ T := Nat.cast_nonneg _
  have hT1R : (1 : ℝ) ≤ T := by exact_mod_cast hT1
  have hHTR : (H : ℝ) ^ 2 ≤ T := by exact_mod_cast hHT
  have hHR : 80 * X ^ (2 * A' + 12) ≤ (H : ℝ) := hbig.trans (by exact_mod_cast hP₁'H)
  have hDd4 : (4 : ℝ) ≤ ((4 * Y ^ 2 : ℕ) : ℝ) := by exact_mod_cast hDd4N
  have hPX : 16 * X ^ A' ≤ (D.P₂' : ℝ) := by
    have hXA : X ^ A' ≤ X ^ (2 * A' + 12) := pow_le_pow_right₀ hX1 (by omega)
    have hXA0 : 0 ≤ X ^ A' := pow_nonneg hX0.le _
    have : (D.P₁' : ℝ) ≤ D.P₂' := by exact_mod_cast hP₁'P₂'.le
    linarith
  -- the FPD property of `S`
  have h16 : 16 * (Y : ℝ) ^ 2 ≤ D.δ ^ A' * T :=
    num_h16 A' hδX hX1 (Nat.cast_nonneg _) (by exact_mod_cast hYP) (by exact_mod_cast hP₂'1)
      hPX (by exact_mod_cast hT5)
  have hFPD := hSq' h16
  set S := (almostPrimes a b).image (fun x : ℕ => e * ((x : ℤ) ^ 2 - c)) with hS
  have hcorr' : D.δ ^ 6 ≤ (∑ s ∈ S, Gs D.N T m f₁ s) / S.card :=
    hcorr.trans_eq (favg_image_eq (sq_map_injective he) (Gs D.N T m f₁))
  have hSne : S.Nonempty := by
    rcases S.eq_empty_or_nonempty with h | h
    · exfalso
      rw [h] at hcorr'
      simp at hcorr'
      linarith [pow_pos hδ0 6]
    · exact h
  have hSD : ∀ s ∈ S, |s| ≤ 4 * ((4 * Y ^ 2 : ℕ) : ℤ) := by
    intro s hs
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hs
    have h1 : (x : ℤ) < 2 * Y := by exact_mod_cast hmem x hx
    have h2 : (y₀ : ℤ) < 2 * Y := by exact_mod_cast hy₀
    have hx4 := sq_lt_four_sq (Nat.cast_nonneg x) h1
    have hy4 := sq_lt_four_sq (Nat.cast_nonneg y₀) h2
    have hsq0 : (0 : ℤ) ≤ (x : ℤ) ^ 2 := sq_nonneg _
    have hsq1 : (0 : ℤ) ≤ (y₀ : ℤ) ^ 2 := sq_nonneg _
    have hY0 : (0 : ℤ) ≤ (Y : ℤ) ^ 2 := sq_nonneg _
    have he1 : |e| = 1 := by rcases he with h | h <;> rw [h] <;> norm_num
    push_cast
    rw [abs_mul, he1, one_mul, hc, abs_le]
    constructor <;> linarith
  -- the conditions of Lemma 2.4*
  have hZ1 : (1 : ℝ) ≤ 10 * (T : ℝ) * ((4 * Y ^ 2 : ℕ) : ℝ) := by
    calc (1 : ℝ) ≤ 10 * 1 * 4 := by norm_num
      _ ≤ 10 * (T : ℝ) * ((4 * Y ^ 2 : ℕ) : ℝ) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hT1R (by norm_num)) hDd4 (by norm_num)
            (by positivity)
  have hZ : 10 * (T : ℝ) * ((4 * Y ^ 2 : ℕ) : ℝ) ≤ (D.P₂ : ℝ) ^ 4 := by exact_mod_cast hN4
  have hlog : (1 + Real.log (10 * (T : ℝ) * ((4 * Y ^ 2 : ℕ) : ℝ))) / Real.log D.N ≤
      (D.δ ^ 6 / 4) ^ 2 / (640 * X ^ A') :=
    num_hlog A' hδX hX0 hu (hlogZ _ hZ1 hZ)
  have hHW : 16 * (H : ℝ) * X ^ A' ≤ T * ((4 * Y ^ 2 : ℕ) : ℝ) :=
    num_hHW A' hX1 hHR hHTR hDd4 hH0 hT0
  have hHQ : 20 * (X ^ A') ^ 2 * (H : ℝ) ≤ (D.δ ^ 6 / 4) ^ 2 * (T * ((4 * Y ^ 2 : ℕ) : ℝ)) :=
    num_hHQ A' hδX hX1 hHR hHTR hDd4 hH0 hT0
  obtain ⟨herr1, herr2⟩ := num_herr A' hδX hX1 hu herrN
  -- apply the core argument
  obtain ⟨q, hq1, hqQ, hU⟩ := core hSne hSD hf hN2 hH1 hm1 (pow_pos hδ0 6)
    (pow_nonneg hδ0.le 7) (num_eta hδ0 hδ80) (one_le_pow₀ hX1) hFPD hlog hHW hHQ herr2 hcorr'
  exact ⟨q, hq1, hqQ, num_final A' hδX hX80 herr1 hU⟩

end P6g

open P6g in
/-- **Step P6g** (GS p. 23), with `A'' = 2A' + 20`, `δ₀ = 1/80`. -/
theorem stepP6g : StepP6g := by
  intro A'
  refine ⟨2 * A' + 20, fun C₂ => ?_⟩
  refine ⟨1 / 80, by norm_num, ⌈Real.exp (Real.exp (L0 A' C₂))⌉₊ + 2, ?_⟩
  intro D hδ hN f₁ hf a₁ b₁ a₂ b₂ hG₁ hG₂ hSq₁ hSq₂ hcorr
  have hN2 : 2 ≤ D.N := by omega
  have hL : L0 A' C₂ ≤ Real.log (Real.log D.N) := by
    have hNr : Real.exp (Real.exp (L0 A' C₂)) ≤ D.N := by
      have h1 := Nat.le_ceil (Real.exp (Real.exp (L0 A' C₂)))
      have h2 : ((⌈Real.exp (Real.exp (L0 A' C₂))⌉₊ : ℕ) : ℝ) ≤ D.N := by
        exact_mod_cast (by omega : ⌈Real.exp (Real.exp (L0 A' C₂))⌉₊ ≤ D.N)
      linarith
    have h1 : Real.exp (L0 A' C₂) ≤ Real.log D.N := by
      rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) hNr)]
      exact hNr
    rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) h1)]
    exact h1
  rcases le_or_gt (∏ ℓ, a₂ ℓ) (∏ ℓ, a₁ ℓ) with hY | hY
  · -- `Y₂ ≤ Y₁`: fix `t ∈ B₂`, average over `B₁` (sign `e = 1`)
    rw [favg_comm] at hcorr
    obtain ⟨t, ht, hcorr'⟩ := exists_le_of_le_favg (pow_pos D.hδ 6) hcorr
    have ht2 : t < 2 * ∏ ℓ, a₂ ℓ := good5_mem_lt D hG₂.1 ht
    refine main_case A' C₂ D hδ hN2 hL f₁ hf a₁ b₁ hG₁.1 hSq₁ 1 ((t : ℤ) ^ 2) (Or.inl rfl) t rfl
      (by omega) (hcorr'.trans_eq ?_)
    congr 1
    funext x
    rw [Gfun_eq, one_mul]
  · -- `Y₁ < Y₂`: fix `s ∈ B₁`, average over `B₂` (sign `e = -1`)
    obtain ⟨s, hs, hcorr'⟩ := exists_le_of_le_favg (pow_pos D.hδ 6) hcorr
    have hs2 : s < 2 * ∏ ℓ, a₁ ℓ := good5_mem_lt D hG₁.1 hs
    refine main_case A' C₂ D hδ hN2 hL f₁ hf a₂ b₂ hG₂.1 hSq₂ (-1) ((s : ℤ) ^ 2) (Or.inr rfl) s
      rfl (by omega) (hcorr'.trans_eq ?_)
    congr 1
    funext x
    rw [Gfun_eq]
    congr 1
    ring

end G22.P51

end

/- ## Section: `P51P7G6` -/

section

/-
# Step P7 (GS Lemma A.6) and the glue `GlueP6` of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, pp. 21–23. This file proves

* `stepP7 : StepP7` with `δ₀ = 1/2` and `N₀ = ⌈exp exp L₀⌉ + 2`, where
  `L₀ = max(120⁴ (J+1)!, (208 (10n+1)!)¹⁰)`, `J = 4A'' + 2C₂ + A'`, `n = A'' + 4C₂`;
* `glueP6 : GlueP6` with `A₆ = max(A' + 1, A'' + 1)` (`A'` from P6f, `A''` from P6g at `A'`),
  `δ₀ = min(δ₀(P6a), …, δ₀(P6g), δ₀(P7), 1)`, `N₀ = max(N₀(P6a), …, N₀(P7))`.

## Proof of P7

Write `X = 1/δ ≥ 2`, `L = log log N ≥ X`, `Q = ⌊X^{C₂}⌋`, `M = ⌊X^{2C₂}⌋`, `V = M!`,
`H₀ = ⌊√⌊√P₁⌋⌋` and `K = ⌈24 X^{A''}⌉`.

1. `Q + q ≤ 2X^{C₂} ≤ X^{2C₂}`, so `Q + q ≤ M` and `Q!q ∣ Q!q! ∣ (Q + q)! ∣ V` (`Qq_le`,
   `factorial_mul_dvd`).
2. `log K ≤ 25 L^{A''}` and `log V ≤ M² ≤ L^{4C₂}`, so `8 log(KV) ≤ 208 L^{A''+4C₂} ≤ log P'₁`
   (as `log log P'₁ ≥ L^{1/10}`, `pow_le_logP₁'`), i.e. `(KV)⁸ ≤ P₁` (`KV_le`); with `H⁸ ≤ P₁`
   this gives `KVH ≤ H₀` (`KVH_le`).
3. `Small.lemmaA6` with `(q, H) = (λQ!q, H₀)` and `(q', H') = (λV, H)`: both error terms are
   `≤ δ^{A''}/4` (`err_le`): the first as `log(λQ!qH₀) ≤ log λ + L^{2C₂} + L^{A'} + log P₂` with
   `(log λ)⁴, (log P₂)⁴ ≤ log N = e^L` (`err1_key`), the second as `24 X^{A''} VH ≤ H₀`.
4. Hence `‖f₁‖²_{U¹[λV,H]} ≥ δ^{A''}/2 ≥ δ^{2A''+2}`.

## Proof of `GlueP6`

P6a → P6b → P6c → P6d give `δ⁵ ≤ E^log E^log Gfun`; P6e with `G = Gfun ∈ [0, 1]` (`Gfun_mem`:
`Gfun = E^log_n (E_t f₁(…))²`) gives two `Good6` boxes; P6f gives `SqFPD` for both; P6g gives
`q ≤ δ^{-A'}` with `δ^{A''} ≤ ‖f₁‖²_{U¹[λQ!q,H₀]}`; P7 (`A' + 1 ≤ A₆ ≤ C₂`) gives
`δ^{A''+1} ≤ ‖f₁‖_{U¹[λV,H]}`, and `δ^{A₆} ≤ δ^{A''+1}` as `δ ≤ 1`.
-/

open Finset Real

namespace G22.P51

namespace P7G6

/- ### Elementary growth facts -/

lemma one_lt_log_of_three_le {n : ℕ} (hn : 3 ≤ n) : 1 < Real.log n := by
  have h3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [Real.lt_log_iff_exp_lt (by linarith)]
  have := Real.exp_one_lt_d9
  norm_num at this
  linarith

/-- `c xⁿ ≤ eˣ` once `x ≥ c (n+1)!`. -/
lemma mul_pow_le_exp {c x : ℝ} (n : ℕ) (hx : c * (n + 1).factorial ≤ x) (hx0 : 0 ≤ x) :
    c * x ^ n ≤ Real.exp x := by
  have hfac : (0 : ℝ) < (n + 1).factorial := by exact_mod_cast Nat.factorial_pos _
  have hxn : 0 ≤ x ^ n := pow_nonneg hx0 n
  have h := Real.pow_div_factorial_le_exp x hx0 (n + 1)
  calc c * x ^ n = c * (n + 1).factorial * x ^ n / (n + 1).factorial := by
        field_simp
    _ ≤ x * x ^ n / (n + 1).factorial :=
        div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hx hxn) hfac.le
    _ = x ^ (n + 1) / (n + 1).factorial := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h

/-- From `v⁴ ≤ u` and `c⁴K⁴ ≤ u³`: `cKv ≤ u`. -/
lemma quartic {u v c K : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) (hc : 0 ≤ c) (hK : 0 ≤ K)
    (hvu : v ^ 4 ≤ u) (hcK : c ^ 4 * K ^ 4 ≤ u ^ 3) : c * K * v ≤ u := by
  have h : (c * K * v) ^ 4 ≤ u ^ 4 := by
    calc (c * K * v) ^ 4 = (c ^ 4 * K ^ 4) * v ^ 4 := by ring
      _ ≤ u ^ 3 * u := mul_le_mul hcK hvu (by positivity) (by positivity)
      _ = u ^ 4 := by ring
  exact (pow_le_pow_iff_left₀ (by positivity) hu (by norm_num)).mp h

lemma le_cube {u : ℝ} (hu : 1 ≤ u) : u ≤ u ^ 3 := by
  have h : 1 ≤ u ^ 2 := one_le_pow₀ hu
  calc u = u * 1 := (mul_one u).symm
    _ ≤ u * u ^ 2 := mul_le_mul_of_nonneg_left h (by linarith)
    _ = u ^ 3 := by ring

/- ### The largeness condition on `N` -/

/-- The exponent `J` of the condition `120⁴ L^j ≤ log N` (`j ≤ J`). -/
def JJ (A' A'' C₂ : ℕ) : ℕ := 4 * A'' + 2 * C₂ + A'

/-- The exponent `n` of the condition `208 Lⁿ ≤ log P'₁`. -/
def nn (A'' C₂ : ℕ) : ℕ := A'' + 4 * C₂

/-- The threshold `L₀` for `L = log log N`. -/
noncomputable def L0 (A' A'' C₂ : ℕ) : ℝ :=
  max ((120 : ℝ) ^ 4 * (JJ A' A'' C₂ + 1).factorial)
    ((208 * ((10 * nn A'' C₂ + 1).factorial : ℝ)) ^ 10)

/-- `N ≥ ⌈exp exp L₀⌉ + 2` gives `N ≥ 2` and `log log N ≥ L₀`. -/
lemma loglog_ge (L₀ : ℝ) (N : ℕ) (hN : ⌈Real.exp (Real.exp L₀)⌉₊ + 2 ≤ N) :
    2 ≤ N ∧ L₀ ≤ Real.log (Real.log N) := by
  refine ⟨by omega, ?_⟩
  have hNr : Real.exp (Real.exp L₀) ≤ N := by
    have h1 := Nat.le_ceil (Real.exp (Real.exp L₀))
    have h2 : ((⌈Real.exp (Real.exp L₀)⌉₊ : ℕ) : ℝ) ≤ N := by
      exact_mod_cast (by omega : ⌈Real.exp (Real.exp L₀)⌉₊ ≤ N)
    linarith
  have h1 : Real.exp L₀ ≤ Real.log N := by
    rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) hNr)]
    exact hNr
  rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) h1)]
  exact h1

/-- `c L^j ≤ log N` for `j ≤ J` once `L = log log N ≥ c (J+1)!` with `c ≥ 1`. -/
lemma pow_le_logN {c : ℝ} (hc : 1 ≤ c) (J N : ℕ) (hN2 : 2 ≤ N)
    (hL : c * (J + 1).factorial ≤ Real.log (Real.log N)) :
    0 < Real.log N ∧ 1 ≤ Real.log (Real.log N) ∧
      ∀ j ≤ J, c * Real.log (Real.log N) ^ j ≤ Real.log N := by
  have hu : 0 < Real.log N := Real.log_pos (by exact_mod_cast (show 1 < N by omega))
  have hfac : (1 : ℝ) ≤ (J + 1).factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
  have hcf : (1 : ℝ) ≤ c * (J + 1).factorial := one_le_mul_of_one_le_of_one_le hc hfac
  have hL1 : 1 ≤ Real.log (Real.log N) := hcf.trans hL
  refine ⟨hu, hL1, fun j hj => ?_⟩
  have h2 := mul_pow_le_exp J hL (by linarith)
  calc c * Real.log (Real.log N) ^ j ≤ c * Real.log (Real.log N) ^ J :=
        mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hL1 hj) (by linarith)
    _ ≤ Real.exp (Real.log (Real.log N)) := h2
    _ = Real.log N := Real.exp_log hu

/-- `c L^m ≤ log P'₁` once `L = log log N ≥ (c (10m+1)!)¹⁰` (as `L ≤ (log log P'₁)¹⁰`). -/
lemma pow_le_logP₁' {c : ℝ} (hc : 0 ≤ c) (m : ℕ) (D : Data)
    (hL : (c * (10 * m + 1).factorial) ^ 10 ≤ Real.log (Real.log D.N)) :
    c * Real.log (Real.log D.N) ^ m ≤ Real.log D.P₁' := by
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact_mod_cast (by omega : 0 < D.P₁')
  have hw1 : 1 < Real.log D.P₁' := one_lt_log_of_three_le D.hP₁'
  have hz0 : 0 < Real.log (Real.log D.P₁') := Real.log_pos hw1
  have hLz : Real.log (Real.log D.N) ≤ Real.log (Real.log D.P₁') ^ 10 := D.hP₁'N
  have hL0 : 0 ≤ Real.log (Real.log D.N) := le_trans (by positivity) hL
  have hcz : c * (10 * m + 1).factorial ≤ Real.log (Real.log D.P₁') :=
    (pow_le_pow_iff_left₀ (by positivity) hz0.le (by norm_num)).mp (hL.trans hLz)
  have h1 := mul_pow_le_exp (10 * m) hcz hz0.le
  calc c * Real.log (Real.log D.N) ^ m ≤ c * (Real.log (Real.log D.P₁') ^ 10) ^ m :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hL0 hLz m) hc
    _ = c * Real.log (Real.log D.P₁') ^ (10 * m) := by rw [← pow_mul]
    _ ≤ Real.exp (Real.log (Real.log D.P₁')) := h1
    _ = Real.log D.P₁' := Real.exp_log (by linarith)

lemma P₁'_le_P₁ (D : Data) : D.P₁' ≤ D.P₁ := by
  have h2 := D.hP₁'P₂'
  have h3 := D.hP₂'P₁
  unfold Data.P₁
  omega

lemma P₁_pos (D : Data) : 0 < D.P₁ := by
  have h1 := D.hP₁'
  have := P₁'_le_P₁ D
  omega

lemma P₂_three_le (D : Data) : 3 ≤ D.P₂ := by
  have h1 := D.hP₁'
  have h2 := D.hP₁'P₂'
  have h3 := D.hP₂'P₁
  have h4 := D.hP₁P₂
  unfold Data.P₂
  omega

/- ### Divisibility: `Q!q ∣ ⌊δ^{-2C₂}⌋!` -/

lemma factorial_mul_dvd {Q q M : ℕ} (hq : 1 ≤ q) (hQM : Q + q ≤ M) :
    Q.factorial * q ∣ M.factorial :=
  (mul_dvd_mul_left _ (Nat.dvd_factorial hq le_rfl)).trans
    ((Nat.factorial_mul_factorial_dvd_factorial_add Q q).trans (Nat.factorial_dvd_factorial hQM))

/-- `⌊X^{C₂}⌋ + q ≤ ⌊X^{2C₂}⌋` for `q ≤ X^{A'}`, `A' < C₂`, `X ≥ 2`. -/
lemma Qq_le {X : ℝ} (hX : 2 ≤ X) {A' C₂ q : ℕ} (hC : A' + 1 ≤ C₂) (hq : (q : ℝ) ≤ X ^ A') :
    ⌊X ^ C₂⌋₊ + q ≤ ⌊X ^ (2 * C₂)⌋₊ := by
  apply Nat.le_floor
  have hX0 : 0 ≤ X := by linarith
  have hX1 : 1 ≤ X := by linarith
  have h1 : ((⌊X ^ C₂⌋₊ : ℕ) : ℝ) ≤ X ^ C₂ := Nat.floor_le (pow_nonneg hX0 _)
  have h2 : X ^ A' ≤ X ^ C₂ := pow_le_pow_right₀ hX1 (by omega)
  have h3 : 2 ≤ X ^ C₂ := by
    calc (2 : ℝ) ≤ X := hX
      _ = X ^ 1 := (pow_one X).symm
      _ ≤ X ^ C₂ := pow_le_pow_right₀ hX1 (by omega)
  have h4 : X ^ (2 * C₂) = X ^ C₂ * X ^ C₂ := by rw [two_mul, pow_add]
  have h5 : 2 * X ^ C₂ ≤ X ^ C₂ * X ^ C₂ := mul_le_mul_of_nonneg_right h3 (by linarith)
  push_cast
  rw [h4]
  linarith

/- ### Sizes: `KVH ≤ H₀` -/

lemma log_factorial_le (M : ℕ) : Real.log (M.factorial : ℝ) ≤ (M : ℝ) ^ 2 := by
  have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg _
  have hfac : (0 : ℝ) < M.factorial := by exact_mod_cast Nat.factorial_pos M
  have h1 : (M.factorial : ℝ) ≤ (M : ℝ) ^ M := by exact_mod_cast Nat.factorial_le_pow M
  calc Real.log (M.factorial : ℝ) ≤ Real.log ((M : ℝ) ^ M) := Real.log_le_log hfac h1
    _ = M * Real.log M := Real.log_pow _ _
    _ ≤ M * M := mul_le_mul_of_nonneg_left (Real.log_le_self hM0) hM0
    _ = (M : ℝ) ^ 2 := by ring

lemma le_sqrt_sqrt {m P : ℕ} (h : m ^ 4 ≤ P) : m ≤ Nat.sqrt (Nat.sqrt P) := by
  rw [Nat.le_sqrt, Nat.le_sqrt]
  calc m * m * (m * m) = m ^ 4 := by ring
    _ ≤ P := h

lemma KVH_le {K V H P : ℕ} (hKV : (K * V) ^ 8 ≤ P) (hH : H ^ 8 ≤ P) :
    K * V * H ≤ Nat.sqrt (Nat.sqrt P) := by
  apply le_sqrt_sqrt
  have h1 : ((K * V * H) ^ 4) ^ 2 ≤ P ^ 2 := by
    calc ((K * V * H) ^ 4) ^ 2 = (K * V) ^ 8 * H ^ 8 := by ring
      _ ≤ P * P := Nat.mul_le_mul hKV hH
      _ = P ^ 2 := by ring
  exact (Nat.pow_le_pow_iff_left (by norm_num)).mp h1

/-- `(KV)⁸ ≤ P₁` for `K = ⌈24 X^{A''}⌉`, `V = ⌊X^{2C₂}⌋!`, `X = 1/δ ≥ 1`. -/
lemma KV_le (A' A'' C₂ : ℕ) (D : Data) (hL : L0 A' A'' C₂ ≤ Real.log (Real.log D.N))
    (hX1 : 1 ≤ 1 / D.δ) :
    (⌈24 * (1 / D.δ) ^ A''⌉₊ * (⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial) ^ 8 ≤ D.P₁ := by
  have hX0 : 0 ≤ 1 / D.δ := by linarith
  have hXL : 1 / D.δ ≤ Real.log (Real.log D.N) := D.hδN
  have hL1 : 1 ≤ Real.log (Real.log D.N) := hX1.trans hXL
  have hL0 : 0 ≤ Real.log (Real.log D.N) := by linarith
  -- `log K ≤ 25 L^{A''}`
  have hXA1 : 1 ≤ (1 / D.δ) ^ A'' := one_le_pow₀ hX1
  have hK0 : 0 < ⌈24 * (1 / D.δ) ^ A''⌉₊ := Nat.ceil_pos.mpr (by linarith)
  have hKR : ((⌈24 * (1 / D.δ) ^ A''⌉₊ : ℕ) : ℝ) ≤ 25 * Real.log (Real.log D.N) ^ A'' := by
    have h1 : ((⌈24 * (1 / D.δ) ^ A''⌉₊ : ℕ) : ℝ) < 24 * (1 / D.δ) ^ A'' + 1 :=
      Nat.ceil_lt_add_one (by linarith)
    have h2 : (1 / D.δ) ^ A'' ≤ Real.log (Real.log D.N) ^ A'' := pow_le_pow_left₀ hX0 hXL A''
    linarith
  have hlogK : Real.log ((⌈24 * (1 / D.δ) ^ A''⌉₊ : ℕ) : ℝ) ≤
      25 * Real.log (Real.log D.N) ^ A'' := (Real.log_le_self (Nat.cast_nonneg _)).trans hKR
  -- `log M! ≤ L^{4C₂}`
  have hMR : ((⌊(1 / D.δ) ^ (2 * C₂)⌋₊ : ℕ) : ℝ) ≤ Real.log (Real.log D.N) ^ (2 * C₂) :=
    (Nat.floor_le (pow_nonneg hX0 _)).trans (pow_le_pow_left₀ hX0 hXL _)
  have hlogV : Real.log (((⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial : ℕ) : ℝ) ≤
      Real.log (Real.log D.N) ^ (4 * C₂) := by
    calc Real.log (((⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial : ℕ) : ℝ)
        ≤ ((⌊(1 / D.δ) ^ (2 * C₂)⌋₊ : ℕ) : ℝ) ^ 2 := log_factorial_le _
      _ ≤ (Real.log (Real.log D.N) ^ (2 * C₂)) ^ 2 := pow_le_pow_left₀ (Nat.cast_nonneg _) hMR 2
      _ = Real.log (Real.log D.N) ^ (4 * C₂) := by rw [← pow_mul]; ring_nf
  -- `208 L^{A''+4C₂} ≤ log P'₁ ≤ log P₁`
  have hP : 208 * Real.log (Real.log D.N) ^ nn A'' C₂ ≤ Real.log D.P₁' :=
    pow_le_logP₁' (by norm_num) _ D (le_trans (le_max_right _ _) hL)
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact_mod_cast (by omega : 0 < D.P₁')
  have hlogP : Real.log D.P₁' ≤ Real.log D.P₁ :=
    Real.log_le_log hP₁'pos (by exact_mod_cast P₁'_le_P₁ D)
  have e1 : Real.log (Real.log D.N) ^ A'' ≤ Real.log (Real.log D.N) ^ nn A'' C₂ :=
    pow_le_pow_right₀ hL1 (by unfold nn; omega)
  have e2 : Real.log (Real.log D.N) ^ (4 * C₂) ≤ Real.log (Real.log D.N) ^ nn A'' C₂ :=
    pow_le_pow_right₀ hL1 (by unfold nn; omega)
  -- conclude
  have hV0 : (0 : ℝ) < (((⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial : ℕ) : ℝ) := by
    exact_mod_cast Nat.factorial_pos _
  have hKR0 : (0 : ℝ) < ((⌈24 * (1 / D.δ) ^ A''⌉₊ : ℕ) : ℝ) := by exact_mod_cast hK0
  have hpos : (0 : ℝ) <
      (((⌈24 * (1 / D.δ) ^ A''⌉₊ * (⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial) ^ 8 : ℕ) : ℝ) := by
    exact_mod_cast pow_pos (Nat.mul_pos hK0 (Nat.factorial_pos _)) 8
  have hP₁R : (0 : ℝ) < D.P₁ := by exact_mod_cast P₁_pos D
  have hlog8 : Real.log
      (((⌈24 * (1 / D.δ) ^ A''⌉₊ * (⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial) ^ 8 : ℕ) : ℝ) ≤
      Real.log (D.P₁ : ℝ) := by
    rw [Nat.cast_pow, Real.log_pow, Nat.cast_mul, Real.log_mul hKR0.ne' hV0.ne']
    push_cast
    linarith
  have := (Real.log_le_log_iff hpos hP₁R).mp hlog8
  exact_mod_cast this

/- ### The error terms of Lemma A.6 -/

/-- `24 a Xⁿ ≤ b` gives `6 (a/b) ≤ δⁿ/4` when `δX = 1`. -/
lemma err_le {δ X a b : ℝ} {n : ℕ} (hδ : 0 ≤ δ) (hδX : δ * X = 1) (hb : 0 < b)
    (h : 24 * a * X ^ n ≤ b) : 6 * (a / b) ≤ δ ^ n / 4 := by
  have e : δ ^ n * X ^ n = 1 := by rw [← mul_pow, hδX, one_pow]
  rw [mul_div_assoc', div_le_iff₀ hb]
  calc 6 * a = 6 * a * (δ ^ n * X ^ n) := by rw [e, mul_one]
    _ = δ ^ n / 4 * (24 * a * X ^ n) := by ring
    _ ≤ δ ^ n / 4 * b := mul_le_mul_of_nonneg_left h (by positivity)

/-- The first error term of A.6: `24 (1 + log(λQ!qH₀)) X^{A''} ≤ log N`. -/
lemma err1_key (A' A'' C₂ : ℕ) (D : Data) (hN2 : 2 ≤ D.N)
    (hL : L0 A' A'' C₂ ≤ Real.log (Real.log D.N)) (q : ℕ) (hq1 : 1 ≤ q)
    (hqA : (q : ℝ) ≤ (1 / D.δ) ^ A') :
    24 * (1 + Real.log (((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) *
      ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ))) * (1 / D.δ) ^ A'' ≤ Real.log D.N := by
  have hc : (1 : ℝ) ≤ 120 ^ 4 := by norm_num
  obtain ⟨hu, hL1, hJ⟩ :=
    pow_le_logN hc (JJ A' A'' C₂) D.N hN2 (le_trans (le_max_left _ _) hL)
  set L := Real.log (Real.log D.N) with hLdef
  set u := Real.log D.N with hudef
  have hX0 : 0 ≤ 1 / D.δ := le_of_lt (one_div_pos.mpr D.hδ)
  have hXL : 1 / D.δ ≤ L := D.hδN
  have hL0 : 0 ≤ L := by linarith
  have hu1 : 1 ≤ u := by
    have := hJ 0 (Nat.zero_le _)
    simp only [pow_zero, mul_one] at this
    linarith
  -- `log λ`
  have hlam1 : (1 : ℝ) ≤ D.lam := by exact_mod_cast D.hlam
  have hv₁0 : 0 ≤ Real.log (D.lam : ℝ) := Real.log_nonneg hlam1
  have hv₁4 : Real.log (D.lam : ℝ) ^ 4 ≤ u := D.hlamN
  -- `log P₂`
  have hv₂1 : 1 < Real.log (D.P₂ : ℝ) := one_lt_log_of_three_le (P₂_three_le D)
  have hv₂4 : Real.log (D.P₂ : ℝ) ^ 4 ≤ u := D.hP₂N.le
  -- `log Q! ≤ L^{2C₂}`
  have hQ0 : (0 : ℝ) ≤ (D.Q C₂ : ℕ) := Nat.cast_nonneg _
  have hQ : ((D.Q C₂ : ℕ) : ℝ) ≤ L ^ C₂ :=
    (Nat.floor_le (pow_nonneg hX0 _)).trans (pow_le_pow_left₀ hX0 hXL C₂)
  have hlogfac : Real.log ((D.Q C₂).factorial : ℝ) ≤ L ^ (2 * C₂) := by
    calc Real.log ((D.Q C₂).factorial : ℝ) ≤ ((D.Q C₂ : ℕ) : ℝ) ^ 2 := log_factorial_le _
      _ ≤ (L ^ C₂) ^ 2 := pow_le_pow_left₀ hQ0 hQ 2
      _ = L ^ (2 * C₂) := by rw [← pow_mul, mul_comm]
  -- `log q ≤ L^{A'}`
  have hlogq : Real.log (q : ℝ) ≤ L ^ A' :=
    (Real.log_le_self (Nat.cast_nonneg _)).trans (hqA.trans (pow_le_pow_left₀ hX0 hXL A'))
  -- `log H₀ ≤ log P₂`
  have hP₁pos := P₁_pos D
  have hH₀1 : 1 ≤ Nat.sqrt (Nat.sqrt D.P₁) := Nat.sqrt_pos.mpr (Nat.sqrt_pos.mpr hP₁pos)
  have hH₀P : Nat.sqrt (Nat.sqrt D.P₁) ≤ D.P₂ :=
    ((Nat.sqrt_le_self _).trans (Nat.sqrt_le_self _)).trans (le_of_lt D.hP₁P₂)
  have hlogH : Real.log ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ) ≤ Real.log (D.P₂ : ℝ) :=
    Real.log_le_log (by exact_mod_cast hH₀1) (by exact_mod_cast hH₀P)
  -- split the logarithm
  have hlamR : (0 : ℝ) < D.lam := by linarith
  have hfacR : (0 : ℝ) < (D.Q C₂).factorial := by exact_mod_cast Nat.factorial_pos _
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq1
  have hH₀R : (0 : ℝ) < ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ) := by exact_mod_cast hH₀1
  have hsplit : Real.log (((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) *
      ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ)) =
      Real.log (D.lam : ℝ) + Real.log ((D.Q C₂).factorial : ℝ) + Real.log (q : ℝ) +
        Real.log ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ) := by
    rw [Nat.cast_mul, Nat.cast_mul,
      Real.log_mul (mul_pos (mul_pos hlamR hfacR) hqR).ne' hH₀R.ne',
      Real.log_mul (mul_pos hlamR hfacR).ne' hqR.ne', Real.log_mul hlamR.ne' hfacR.ne']
  have hlog : 1 + Real.log (((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) *
      ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ)) ≤
      1 + Real.log (D.lam : ℝ) + L ^ (2 * C₂) + L ^ A' + Real.log (D.P₂ : ℝ) := by
    rw [hsplit]
    linarith
  have hXA : (1 / D.δ) ^ A'' ≤ L ^ A'' := pow_le_pow_left₀ hX0 hXL A''
  -- the five pieces
  have hLA : 0 ≤ L ^ A'' := pow_nonneg hL0 _
  have p1 : 120 * L ^ A'' ≤ u :=
    calc 120 * L ^ A'' ≤ 120 ^ 4 * L ^ A'' := mul_le_mul_of_nonneg_right (by norm_num) hLA
      _ ≤ u := hJ A'' (by unfold JJ; omega)
  have p3 : 120 * (L ^ (2 * C₂) * L ^ A'') ≤ u :=
    calc 120 * (L ^ (2 * C₂) * L ^ A'') = 120 * L ^ (2 * C₂ + A'') := by rw [pow_add]
      _ ≤ 120 ^ 4 * L ^ (2 * C₂ + A'') :=
          mul_le_mul_of_nonneg_right (by norm_num) (pow_nonneg hL0 _)
      _ ≤ u := hJ _ (by unfold JJ; omega)
  have p4 : 120 * (L ^ A' * L ^ A'') ≤ u :=
    calc 120 * (L ^ A' * L ^ A'') = 120 * L ^ (A' + A'') := by rw [pow_add]
      _ ≤ 120 ^ 4 * L ^ (A' + A'') :=
          mul_le_mul_of_nonneg_right (by norm_num) (pow_nonneg hL0 _)
      _ ≤ u := hJ _ (by unfold JJ; omega)
  have hK4 : (120 : ℝ) ^ 4 * (L ^ A'') ^ 4 ≤ u ^ 3 :=
    calc (120 : ℝ) ^ 4 * (L ^ A'') ^ 4 = 120 ^ 4 * L ^ (4 * A'') := by
          rw [← pow_mul, mul_comm A'' 4]
      _ ≤ u := hJ _ (by unfold JJ; omega)
      _ ≤ u ^ 3 := le_cube hu1
  have p2 : 120 * L ^ A'' * Real.log (D.lam : ℝ) ≤ u :=
    quartic hu.le hv₁0 (by norm_num) hLA hv₁4 hK4
  have p5 : 120 * L ^ A'' * Real.log (D.P₂ : ℝ) ≤ u :=
    quartic hu.le (by linarith) (by norm_num) hLA hv₂4 hK4
  have hb0 : 0 ≤ 1 + Real.log (D.lam : ℝ) + L ^ (2 * C₂) + L ^ A' + Real.log (D.P₂ : ℝ) := by
    have := pow_nonneg hL0 (2 * C₂)
    have := pow_nonneg hL0 A'
    linarith
  calc 24 * (1 + Real.log (((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) *
        ((Nat.sqrt (Nat.sqrt D.P₁) : ℕ) : ℝ))) * (1 / D.δ) ^ A''
      ≤ 24 * (1 + Real.log (D.lam : ℝ) + L ^ (2 * C₂) + L ^ A' + Real.log (D.P₂ : ℝ)) *
          L ^ A'' :=
        mul_le_mul (mul_le_mul_of_nonneg_left hlog (by norm_num)) hXA (pow_nonneg hX0 _)
          (by linarith)
    _ = (120 * L ^ A'' + 120 * L ^ A'' * Real.log (D.lam : ℝ) +
          120 * (L ^ (2 * C₂) * L ^ A'') + 120 * (L ^ A' * L ^ A'') +
          120 * L ^ A'' * Real.log (D.P₂ : ℝ)) / 5 := by ring
    _ ≤ (u + u + u + u + u) / 5 := by linarith
    _ = u := by ring

end P7G6

open P7G6 in
/-- **Step P7** (GS p. 23, Lemma A.6), with `δ₀ = 1/2`, `N₀ = ⌈exp exp L₀⌉ + 2`. -/
theorem stepP7 : StepP7 := by
  intro A' A'' C₂ hC₂
  refine ⟨1 / 2, by norm_num, ⌈Real.exp (Real.exp (L0 A' A'' C₂))⌉₊ + 2, ?_⟩
  intro D hδ hN f₁ hf q hq1 hqA hU H hH hH8
  obtain ⟨hN2, hL⟩ := loglog_ge _ D.N hN
  have hδ0 := D.hδ
  have hX2 : (2 : ℝ) ≤ 1 / D.δ := by rw [le_div_iff₀ hδ0]; linarith
  have hX1 : (1 : ℝ) ≤ 1 / D.δ := by linarith
  have hδX : D.δ * (1 / D.δ) = 1 := by field_simp
  have hu : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
  -- `Q!q ∣ V`
  have hQM : D.Q C₂ + q ≤ ⌊(1 / D.δ) ^ (2 * C₂)⌋₊ := Qq_le hX2 hC₂ hqA
  have hdvd := factorial_mul_dvd hq1 hQM
  -- `KVH ≤ H₀`
  have hKVH := KVH_le (KV_le A' A'' C₂ D hL hX1) hH8
  have he1 := err_le hδ0.le hδX hu (err1_key A' A'' C₂ D hN2 hL q hq1 hqA)
  set V := (⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial with hV
  set H₀ := Nat.sqrt (Nat.sqrt D.P₁) with hH₀
  set K := ⌈24 * (1 / D.δ) ^ A''⌉₊ with hK
  have hH₀1 : 1 ≤ H₀ := Nat.sqrt_pos.mpr (Nat.sqrt_pos.mpr (P₁_pos D))
  have hV1 : 1 ≤ V := Nat.factorial_pos _
  have hK1 : 1 ≤ K := Nat.ceil_pos.mpr (by positivity)
  have hQq1 : 1 ≤ (D.Q C₂).factorial * q := Nat.mul_pos (Nat.factorial_pos _) hq1
  have hVH : V * H ≤ H₀ := by
    calc V * H = 1 * (V * H) := (one_mul _).symm
      _ ≤ K * (V * H) := Nat.mul_le_mul_right _ hK1
      _ = K * V * H := (mul_assoc _ _ _).symm
      _ ≤ H₀ := hKVH
  -- Lemma A.6 with `(q, H) = (λQ!q, H₀)` and `(q', H') = (λV, H)`
  have hq_pos : 1 ≤ D.lam * (D.Q C₂).factorial * q :=
    Nat.mul_pos (Nat.mul_pos D.hlam (Nat.factorial_pos _)) hq1
  have hq'_pos : 1 ≤ D.lam * V := Nat.mul_pos D.hlam hV1
  have hdvd' : D.lam * (D.Q C₂).factorial * q ∣ D.lam * V := by
    rw [mul_assoc]
    exact Nat.mul_dvd_mul_left _ hdvd
  have hqH : D.lam * V * H ≤ D.lam * (D.Q C₂).factorial * q * H₀ := by
    calc D.lam * V * H = D.lam * (V * H) := by ring
      _ ≤ D.lam * (((D.Q C₂).factorial * q) * H₀) :=
          Nat.mul_le_mul_left _ (hVH.trans (by nlinarith))
      _ = D.lam * (D.Q C₂).factorial * q * H₀ := by ring
  have hA6 := Small.lemmaA6 hN2 hq_pos hdvd' hq'_pos hH₀1 hH hqH f₁ hf
  -- the second error term
  have he2 : 6 * (((D.lam * V : ℕ) : ℝ) * (H : ℝ) /
      (((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) * (H₀ : ℝ))) ≤ D.δ ^ A'' / 4 := by
    have hB : (0 : ℝ) < ((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) * (H₀ : ℝ) := by
      have h1 : (0 : ℝ) < ((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) := by exact_mod_cast hq_pos
      have h2 : (0 : ℝ) < (H₀ : ℝ) := by exact_mod_cast hH₀1
      positivity
    apply err_le hδ0.le hδX hB
    have hKc : 24 * (1 / D.δ) ^ A'' ≤ (K : ℝ) := Nat.le_ceil _
    have hKVH_R : (K : ℝ) * V * H ≤ H₀ := by exact_mod_cast hKVH
    have hQq_R : (1 : ℝ) ≤ (((D.Q C₂).factorial * q : ℕ) : ℝ) := by exact_mod_cast hQq1
    have hVHR : (0 : ℝ) ≤ (V : ℝ) * H := by positivity
    have h1 : 24 * (1 / D.δ) ^ A'' * ((V : ℝ) * H) ≤ (H₀ : ℝ) := by
      calc 24 * (1 / D.δ) ^ A'' * ((V : ℝ) * H) ≤ (K : ℝ) * ((V : ℝ) * H) :=
            mul_le_mul_of_nonneg_right hKc hVHR
        _ = (K : ℝ) * V * H := by ring
        _ ≤ H₀ := hKVH_R
    have h2 : (H₀ : ℝ) ≤ (((D.Q C₂).factorial * q : ℕ) : ℝ) * H₀ :=
      le_mul_of_one_le_left (Nat.cast_nonneg _) hQq_R
    have e1 : ((D.lam * V : ℕ) : ℝ) * (H : ℝ) = (D.lam : ℝ) * ((V : ℝ) * H) := by
      push_cast; ring
    have e2 : ((D.lam * (D.Q C₂).factorial * q : ℕ) : ℝ) * (H₀ : ℝ) =
        (D.lam : ℝ) * ((((D.Q C₂).factorial * q : ℕ) : ℝ) * H₀) := by
      push_cast; ring
    rw [e1, e2]
    calc 24 * ((D.lam : ℝ) * ((V : ℝ) * H)) * (1 / D.δ) ^ A'' =
        (D.lam : ℝ) * (24 * (1 / D.δ) ^ A'' * ((V : ℝ) * H)) := by ring
      _ ≤ (D.lam : ℝ) * ((((D.Q C₂).factorial * q : ℕ) : ℝ) * H₀) :=
          mul_le_mul_of_nonneg_left (h1.trans h2) (Nat.cast_nonneg _)
  -- conclusion
  have hU' : D.δ ^ A'' / 2 ≤ U1logSq D.N (D.lam * V) H f₁ := by linarith
  have hδ1 : D.δ ≤ 1 := by linarith
  have hpow : D.δ ^ (A'' + 2) ≤ 1 / 2 :=
    (pow_le_pow_of_le_one hδ0.le hδ1 (by omega : 1 ≤ A'' + 2)).trans (by rw [pow_one]; exact hδ)
  apply (Real.le_sqrt' (pow_pos hδ0 (A'' + 1))).mpr
  calc (D.δ ^ (A'' + 1)) ^ 2 = D.δ ^ A'' * D.δ ^ (A'' + 2) := by ring
    _ ≤ D.δ ^ A'' * (1 / 2) := mul_le_mul_of_nonneg_left hpow (pow_nonneg hδ0.le _)
    _ = D.δ ^ A'' / 2 := by ring
    _ ≤ U1logSq D.N (D.lam * V) H f₁ := hU'

namespace P7G6

/- ### `0 ≤ Gfun ≤ 1` -/

lemma abs_uavg_le_one {T : ℕ} {g : ℕ → ℝ} (hg : ∀ t, |g t| ≤ 1) : |uavg T g| ≤ 1 := by
  rcases Nat.eq_zero_or_pos T with h | h
  · subst h
    simp [uavg, wavg]
  · exact abs_wavg_le_of_abs_le (goodWeights_uavg h) fun t _ => hg t

lemma logAvg_nonneg_of {N : ℕ} {g : ℤ → ℝ} (hg : ∀ n, 0 ≤ g n) : 0 ≤ logAvg N g := by
  unfold logAvg wavg
  apply div_nonneg
  · exact Finset.sum_nonneg fun n _ => mul_nonneg (by positivity) (hg _)
  · exact Finset.sum_nonneg fun n _ => by positivity

lemma logAvg_le_one_of {N : ℕ} {g : ℤ → ℝ} (hg : ∀ n, g n ≤ 1) : logAvg N g ≤ 1 := by
  rcases Nat.eq_zero_or_pos N with h | h
  · subst h
    simp [logAvg, wavg]
  · exact wavg_le_of_le (goodWeights_logAvg h) fun n _ => hg n

/-- `E_{t,t'∈[T]} E^log_n g_t(n) g_{t'}(n) = E^log_n (E_{t∈[T]} g_t(n))²`. -/
lemma uavg_uavg_logAvg_eq_sq (T N : ℕ) (g : ℕ → ℤ → ℝ) :
    uavg T (fun t => uavg T (fun t' => logAvg N (fun n => g t n * g t' n))) =
      logAvg N (fun n => (uavg T (fun t => g t n)) ^ 2) := by
  calc uavg T (fun t => uavg T (fun t' => logAvg N (fun n => g t n * g t' n)))
      = uavg T (fun t => logAvg N (fun n => uavg T (fun t' => g t n * g t' n))) := by
        congr 1
        funext t
        exact (Elem.logAvg_uavg_comm N T (fun t' n => g t n * g t' n)).symm
    _ = logAvg N (fun n => uavg T (fun t => uavg T (fun t' => g t n * g t' n))) :=
        (Elem.logAvg_uavg_comm N T (fun t n => uavg T (fun t' => g t n * g t' n))).symm
    _ = logAvg N (fun n => (uavg T (fun t => g t n)) ^ 2) := by
        congr 1
        funext n
        have h1 : ∀ t, uavg T (fun t' => g t n * g t' n) = g t n * uavg T (fun t' => g t' n) :=
          fun t => wavg_smul (g t n) (fun t' => g t' n)
        simp only [h1]
        rw [sq]
        exact (Elem.wavg_mul_const _ _ (fun t => g t n) (uavg T (fun t' => g t' n))).symm

/-- `0 ≤ Gfun ≤ 1` for 1-bounded `f₁` (the hypothesis of P6e for `G = Gfun`). -/
lemma Gfun_mem (D : Data) (f₁ : ℤ → ℝ) (hf : ∀ n, |f₁ n| ≤ 1) (Q : ℕ) (s t : ℕ) :
    0 ≤ Gfun D f₁ Q s t ∧ Gfun D f₁ Q s t ≤ 1 := by
  have e : Gfun D f₁ Q s t = logAvg D.N (fun n => (uavg (Nat.sqrt D.P₁) (fun t' =>
      f₁ (n + (D.lam : ℤ) * t' * Q.factorial * ((s : ℤ) ^ 2 - (t : ℤ) ^ 2)))) ^ 2) :=
    uavg_uavg_logAvg_eq_sq _ _
      (fun t' n => f₁ (n + (D.lam : ℤ) * t' * Q.factorial * ((s : ℤ) ^ 2 - (t : ℤ) ^ 2)))
  rw [e]
  refine ⟨logAvg_nonneg_of fun n => sq_nonneg _, logAvg_le_one_of fun n => ?_⟩
  exact (sq_le_one_iff_abs_le_one _).mpr (abs_uavg_le_one fun t' => hf _)

end P7G6

open P7G6 in
/-- **GlueP6** (GS pp. 21–23): P6a → P6b → P6c → P6d → P6e (with `G = Gfun ∈ [0,1]`) → P6f (both
boxes) → P6g → P7, with `A₆ = max(A' + 1, A'' + 1)`. -/
theorem glueP6 : GlueP6 := by
  intro h6a h6b h6c h6d h6e h6f h6g h7
  obtain ⟨A', δf, hδf, Nf, h6f⟩ := h6f
  obtain ⟨A'', h6g⟩ := h6g A'
  refine ⟨max (A' + 1) (A'' + 1), ?_⟩
  intro c' C C₂ hc' hC₂
  have hA'C : A' + 1 ≤ C₂ := le_trans (le_max_left _ _) hC₂
  obtain ⟨δa, hδa, Na, ha⟩ := h6a c' C C₂ hc'
  obtain ⟨δb, hδb, Nb, hb⟩ := h6b c' C C₂ hc'
  obtain ⟨δc, hδc, Nc, hc⟩ := h6c c' C C₂ hc'
  obtain ⟨δd, hδd, Nd, hd⟩ := h6d c' C C₂ hc'
  obtain ⟨δe, hδe, Ne, he⟩ := h6e
  obtain ⟨δg, hδg, Ng, hg⟩ := h6g C₂
  obtain ⟨δ7, hδ7, N7, h7⟩ := h7 A' A'' C₂ hA'C
  refine ⟨min (min (min δa δb) (min δc δd)) (min (min δe δf) (min (min δg δ7) 1)),
    lt_min (lt_min (lt_min hδa hδb) (lt_min hδc hδd))
      (lt_min (lt_min hδe hδf) (lt_min (lt_min hδg hδ7) one_pos)),
    max (max (max Na Nb) (max Nc Nd)) (max (max Ne Nf) (max Ng N7)), ?_⟩
  intro D hδ hN f₁ hf₁ X hX1 hX2 Λper hPer hcorr H hH hH8
  simp only [le_min_iff] at hδ
  obtain ⟨⟨⟨hδa', hδb'⟩, hδc', hδd'⟩, ⟨hδe', hδf'⟩, ⟨hδg', hδ7'⟩, hδ1⟩ := hδ
  simp only [max_le_iff] at hN
  obtain ⟨⟨⟨hNa, hNb⟩, hNc, hNd⟩, ⟨hNe, hNf⟩, hNg, hN7⟩ := hN
  -- P6a → P6b → P6c → P6d
  have s1 := ha D hδa' hNa f₁ hf₁ X hX1 hX2 Λper hPer hcorr
  have s2 := hb D hδb' hNb f₁ hf₁ X hX1 hX2 Λper hPer s1
  have s3 := hc D hδc' hNc f₁ hf₁ X hX1 hX2 Λper hPer s2
  have s4 := hd D hδd' hNd f₁ hf₁ X hX1 hX2 Λper hPer s3
  -- P6e with `G = Gfun`
  obtain ⟨a₁, b₁, a₂, b₂, hG₁, hG₂, s5⟩ :=
    he D hδe' hNe (Gfun D f₁ (D.Q C₂)) (Gfun_mem D f₁ hf₁ (D.Q C₂)) s4
  -- P6f for both boxes
  have hS₁ := h6f D hδf' hNf a₁ b₁ hG₁
  have hS₂ := h6f D hδf' hNf a₂ b₂ hG₂
  -- P6g and P7
  obtain ⟨q, hq1, hqA, s6⟩ := hg D hδg' hNg f₁ hf₁ a₁ b₁ a₂ b₂ hG₁ hG₂ hS₁ hS₂ s5
  have s7 := h7 D hδ7' hN7 f₁ hf₁ q hq1 hqA s6 H hH hH8
  exact le_trans (pow_le_pow_of_le_one D.hδ.le hδ1 (le_max_right _ _)) s7

end G22.P51

