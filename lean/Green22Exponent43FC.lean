  /- The collision bound `k/⌊√P'₁⌋ < τ²⁴/2⁵⁸`. -/
  have hκ : (D.k : ℝ) / (Nat.sqrt D.P₁' : ℝ) < τ ^ 24 / 2 ^ 58 := by
    have hr1 : (1 : ℝ) ≤ Nat.sqrt D.P₁' := by exact_mod_cast sqrt_P1'_pos D
    have hPr : (D.P₁' : ℝ) < 4 * (Nat.sqrt D.P₁' : ℝ) ^ 2 := by
      have h1 : (D.P₁' : ℝ) < (((Nat.sqrt D.P₁').succ ^ 2 : ℕ) : ℝ) := by
        exact_mod_cast Nat.lt_succ_sqrt' D.P₁'
      push_cast at h1
