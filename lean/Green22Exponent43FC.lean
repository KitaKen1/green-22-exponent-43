/- ## Section: `FPD` -/

section

/-
# Rational approximation from the Fejér kernel when `T ≫ D`

This file formalises the arithmetic core of the "elementary route" to GS Proposition 5.1
(see `notes/prop51_elementary_route.md`). In GS's proof of Proposition 5.1 the diophantine
property of the sets `S` is only needed for frequencies `θ` with
`ψ(θ) = E_{s∈S} Φ_T(θ s) ≥ c₁δ²`, where `Φ_T` is the Fejér kernel, and in both applications
`T ≥ D^{2.5}`. In that regime:

* `near_int_pair`: if `θA` and `θB` are within `ε` of integers and `ε(|A| + |B|) < 1`, then the
  reduced denominator `v` of the common fraction divides `gcd(A, B)` and `‖vθ‖ ≤ vε/|A|`;
* `dnear_le_of_fejer`: `Φ_T(α) ≥ η/2` forces `‖α‖ ≤ 1/(T√(2η))`;
* `lemmaL`: for a set of integers in `[Y, 2Y]` in which a random pair is coprime with probability
  `> 1 - (η/2)²`, `E_s Φ_T(θs) ≥ η` and `T√(2η) > 4Y` imply `‖θ‖ ≤ 1/(√(2η)·T·Y)`.
-/

open Finset Real

namespace G22.FPD

/-- Distance from `x` to the nearest integer, `‖x‖_{ℝ/ℤ}`. -/
noncomputable def dnear (x : ℝ) : ℝ := |x - round x|

lemma dnear_nonneg (x : ℝ) : 0 ≤ dnear x := abs_nonneg _

lemma dnear_le (x : ℝ) (m : ℤ) : dnear x ≤ |x - m| := round_le x m

lemma dnear_le_half (x : ℝ) : dnear x ≤ 1 / 2 := abs_sub_round x

/- ### The arithmetic core -/

/-- **The pair argument.** If `θA` and `θB` are within `ε` of integers and `ε(|A| + |B|) < 1`,
then there is `v ∣ gcd(A, B)` with `‖vθ‖ ≤ vε/|A|`. -/
theorem near_int_pair {θ ε : ℝ} {A B : ℤ} (hA : A ≠ 0)
    (h1 : dnear (θ * A) ≤ ε) (h2 : dnear (θ * B) ≤ ε) (hsmall : ε * (|(A : ℝ)| + |(B : ℝ)|) < 1) :
    ∃ v : ℕ, 0 < v ∧ v ∣ Int.gcd A B ∧ dnear (v * θ) ≤ v * ε / |(A : ℝ)| := by
  set a : ℤ := round (θ * A) with ha
  set b : ℤ := round (θ * B) with hb
  have he1 : |θ * A - a| ≤ ε := h1
  have he2 : |θ * B - b| ≤ ε := h2
  -- `aB = bA`
  have hab : a * B = b * A := by
    have key : ((a * B - b * A : ℤ) : ℝ) = (θ * B - b) * A - (θ * A - a) * B := by
      push_cast; ring
    have hlt : |((a * B - b * A : ℤ) : ℝ)| < 1 := by
      rw [key]
      calc |(θ * B - b) * A - (θ * A - a) * B|
          ≤ |(θ * B - b) * A| + |(θ * A - a) * B| := abs_sub _ _
        _ = |θ * B - b| * |(A : ℝ)| + |θ * A - a| * |(B : ℝ)| := by rw [abs_mul, abs_mul]
        _ ≤ ε * |(A : ℝ)| + ε * |(B : ℝ)| := by gcongr
        _ = ε * (|(A : ℝ)| + |(B : ℝ)|) := by ring
        _ < 1 := hsmall
    have hz : |a * B - b * A| < 1 := by exact_mod_cast hlt
    have := Int.abs_lt_one_iff.mp hz
    linarith
  -- the reduced denominator `v = |A| / gcd(|a|, |A|)`
  set g : ℕ := Nat.gcd a.natAbs A.natAbs with hg
  have hApos : 0 < A.natAbs := Int.natAbs_pos.mpr hA
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_right _ hApos
  set v : ℕ := A.natAbs / g with hv
  have hgA : g ∣ A.natAbs := Nat.gcd_dvd_right _ _
  have hga : g ∣ a.natAbs := Nat.gcd_dvd_left _ _
  have hvpos : 0 < v := Nat.div_pos (Nat.le_of_dvd hApos hgA) hgpos
  have hAv : A.natAbs = g * v := (Nat.mul_div_cancel' hgA).symm
  set w : ℕ := a.natAbs / g with hw
  have haw : a.natAbs = g * w := (Nat.mul_div_cancel' hga).symm
  have hcop : Nat.Coprime w v := Nat.coprime_div_gcd_div_gcd hgpos
  -- `v ∣ |B|` from `|a||B| = |b||A|`
  have hvB : v ∣ B.natAbs := by
    have h := congrArg Int.natAbs hab
    rw [Int.natAbs_mul, Int.natAbs_mul, haw, hAv] at h
    -- `g w |B| = |b| g v`
    have h' : w * B.natAbs = b.natAbs * v := by
      have : g * (w * B.natAbs) = g * (b.natAbs * v) := by rw [← mul_assoc, h]; ring
      exact Nat.eq_of_mul_eq_mul_left hgpos this
    have : v ∣ w * B.natAbs := ⟨b.natAbs, by rw [h']; ring⟩
    exact hcop.symm.dvd_of_dvd_mul_left this
  have hvA : v ∣ A.natAbs := ⟨g, by rw [hAv]; ring⟩
  refine ⟨v, hvpos, Nat.dvd_gcd hvA hvB, ?_⟩
  -- `A ∣ v a`, so `vθ` is within `v|e₁|/|A|` of the integer `m = va/A`
  have hdvd : A ∣ (v : ℤ) * a := by
    rw [← Int.natAbs_dvd_natAbs, Int.natAbs_mul, Int.natAbs_natCast, hAv, haw]
    exact ⟨w, by ring⟩
  obtain ⟨m, hm⟩ := hdvd
  have hAR : (A : ℝ) ≠ 0 := by exact_mod_cast hA
  have hvθ : (v : ℝ) * θ - m = (v : ℝ) * (θ * A - a) / A := by
    have hm' : ((v : ℤ) : ℝ) * (a : ℝ) = (A : ℝ) * (m : ℝ) := by exact_mod_cast hm
    push_cast at hm'
    field_simp
    linear_combination hm'
  calc dnear (v * θ) ≤ |(v : ℝ) * θ - m| := dnear_le _ m
    _ = (v : ℝ) * |θ * A - a| / |(A : ℝ)| := by
        rw [hvθ, abs_div, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ v)]
    _ ≤ (v : ℝ) * ε / |(A : ℝ)| := by gcongr

/-- Coprime version of `near_int_pair`: `‖θ‖ ≤ ε/s`. -/
theorem near_int_coprime {θ ε : ℝ} {s s' : ℕ} (hs : 0 < s) (hcop : Nat.Coprime s s')
    (h1 : dnear (θ * s) ≤ ε) (h2 : dnear (θ * s') ≤ ε) (hsmall : ε * ((s : ℝ) + s') < 1) :
    dnear θ ≤ ε / s := by
  have hA : (s : ℤ) ≠ 0 := by exact_mod_cast hs.ne'
  obtain ⟨v, hv, hvg, hd⟩ := near_int_pair (θ := θ) (ε := ε) (A := (s : ℤ)) (B := (s' : ℤ)) hA
    (by exact_mod_cast h1) (by exact_mod_cast h2)
    (by simpa [abs_of_nonneg] using hsmall)
  have hg : Int.gcd (s : ℤ) (s' : ℤ) = 1 := by
    rw [Int.gcd_natCast_natCast]; exact hcop
  rw [hg, Nat.dvd_one] at hvg
  subst hvg
  simpa using hd

/- ### The Fejér kernel -/

/-- `e(x) = exp(2πix)`. -/
noncomputable def ee (x : ℝ) : ℂ := Complex.exp (2 * π * Complex.I * x)

/-- Fejér kernel `Φ_T(α) = |T⁻¹ ∑_{t=1}^{T} e(αt)|²` (GS: `ψ(θ) = E_{s∈S} Φ_T(θs)`). -/
noncomputable def fejer (T : ℕ) (α : ℝ) : ℝ := ‖(∑ t ∈ Icc 1 T, ee (α * t)) / T‖ ^ 2

lemma norm_ee (x : ℝ) : ‖ee x‖ = 1 := by
  unfold ee
  rw [show (2 * π * Complex.I * x : ℂ) = ((2 * π * x : ℝ) : ℂ) * Complex.I by push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

lemma fejer_nonneg (T : ℕ) (α : ℝ) : 0 ≤ fejer T α := sq_nonneg _

lemma fejer_le_one (T : ℕ) (α : ℝ) : fejer T α ≤ 1 := by
  unfold fejer
  rcases Nat.eq_zero_or_pos T with hT | hT
  · subst hT; simp
  have hTR : (0 : ℝ) < T := by exact_mod_cast hT
  have hnorm : ‖(∑ t ∈ Icc 1 T, ee (α * t)) / T‖ ≤ 1 := by
    rw [norm_div, Complex.norm_natCast, div_le_one hTR]
    calc ‖∑ t ∈ Icc 1 T, ee (α * t)‖ ≤ ∑ t ∈ Icc 1 T, ‖ee (α * t)‖ := norm_sum_le _ _
      _ = T := by simp [norm_ee]
  have h0 : 0 ≤ ‖(∑ t ∈ Icc 1 T, ee (α * t)) / T‖ := norm_nonneg _
  nlinarith

/-- `|sin(πα)| ≥ 2‖α‖` (Jordan's inequality after reduction to `[-1/2, 1/2]`). -/
lemma two_dnear_le_abs_sin (α : ℝ) : 2 * dnear α ≤ |Real.sin (π * α)| := by
  set m : ℤ := round α
  set y : ℝ := α - m with hy
  have hy2 : |y| ≤ 1 / 2 := abs_sub_round α
  have hsin : |Real.sin (π * α)| = |Real.sin (π * y)| := by
    have : π * α = π * y + m * π := by rw [hy]; ring
    rw [this, Real.sin_add_int_mul_pi, abs_mul, abs_neg_one_zpow, one_mul]
  have hjordan : 2 / π * (π * |y|) ≤ Real.sin (π * |y|) :=
    Real.mul_le_sin (by positivity) (by nlinarith [Real.pi_pos])
  have habs : |Real.sin (π * y)| = Real.sin (π * |y|) := by
    rcases le_or_gt 0 y with h | h
    · have hy' := (abs_le.mp hy2).2
      rw [abs_of_nonneg h, abs_of_nonneg]
      exact Real.sin_nonneg_of_nonneg_of_le_pi (by positivity) (by nlinarith [Real.pi_pos])
    · have hy' := (abs_le.mp hy2).1
      rw [abs_of_neg h, show π * y = -(π * -y) by ring, Real.sin_neg, abs_neg, abs_of_nonneg]
      exact Real.sin_nonneg_of_nonneg_of_le_pi (by nlinarith [Real.pi_pos])
        (by nlinarith [Real.pi_pos])
  rw [hsin, habs]
  have : 2 / π * (π * |y|) = 2 * |y| := by field_simp
  unfold dnear
  linarith

/-- Geometric sum bound: `|∑_{t=1}^{T} e(αt)| · 2‖α‖ ≤ 1`. -/
lemma norm_sum_ee_mul_dnear_le (T : ℕ) (α : ℝ) :
    ‖∑ t ∈ Icc 1 T, ee (α * t)‖ * (2 * dnear α) ≤ 1 := by
  rcases (dnear_nonneg α).eq_or_lt with h0 | hpos
  · rw [← h0]; simp
  set z : ℂ := ee α with hz
  have hzpow : ∀ t : ℕ, ee (α * t) = z ^ t := by
    intro t
    rw [hz]; unfold ee
    rw [← Complex.exp_nat_mul]; congr 1; push_cast; ring
  have hz1 : ‖z‖ = 1 := norm_ee α
  -- `‖z - 1‖ = 2|sin(πα)| ≥ 4‖α‖ > 0`
  have hzsub : ‖z - 1‖ = 2 * |Real.sin (π * α)| := by
    rw [hz]; unfold ee
    rw [show (2 * π * Complex.I * α : ℂ) = Complex.I * ((2 * π * α : ℝ) : ℂ) by push_cast; ring,
      Complex.norm_exp_I_mul_ofReal_sub_one]
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_two]
    congr 2; ring_nf
  have hlow : 4 * dnear α ≤ ‖z - 1‖ := by
    rw [hzsub]; linarith [two_dnear_le_abs_sin α]
  have hzne : z ≠ 1 := by
    intro h; rw [h, sub_self, norm_zero] at hlow; linarith
  have hsum : ∑ t ∈ Icc 1 T, ee (α * t) = z * (z ^ T - 1) / (z - 1) := by
    have hs : ∑ t ∈ Icc 1 T, ee (α * t) = ∑ t ∈ range T, z * z ^ t := by
      rw [Finset.range_eq_Ico]
      rw [show Icc 1 T = Ico 1 (T + 1) from rfl]
      rw [Finset.sum_Ico_eq_sum_range]
      refine Finset.sum_congr (by simp) fun t _ => ?_
      rw [hzpow, add_comm, pow_succ']
    rw [hs, ← Finset.mul_sum, geom_sum_eq hzne, mul_div_assoc]
  have hnum : ‖z * (z ^ T - 1)‖ ≤ 2 := by
    rw [norm_mul, hz1, one_mul]
    calc ‖z ^ T - 1‖ ≤ ‖z ^ T‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
      _ = 2 := by rw [norm_pow, hz1, one_pow, norm_one]; norm_num
  have hden : 0 < ‖z - 1‖ := by linarith
  rw [hsum, norm_div]
  calc ‖z * (z ^ T - 1)‖ / ‖z - 1‖ * (2 * dnear α) ≤ 2 / ‖z - 1‖ * (2 * dnear α) := by
        gcongr
    _ = 4 * dnear α / ‖z - 1‖ := by ring
    _ ≤ 1 := by rw [div_le_one hden]; exact hlow

/-- `Φ_T(α) · 4T²‖α‖² ≤ 1`. -/
lemma fejer_mul_le (T : ℕ) (α : ℝ) : fejer T α * (4 * T ^ 2 * dnear α ^ 2) ≤ 1 := by
  rcases Nat.eq_zero_or_pos T with hT | hT
  · subst hT; simp [fejer]
  have hTR : (0 : ℝ) < T := by exact_mod_cast hT
  have h := norm_sum_ee_mul_dnear_le T α
  have hn : 0 ≤ ‖∑ t ∈ Icc 1 T, ee (α * t)‖ := norm_nonneg _
  have hd : 0 ≤ dnear α := dnear_nonneg α
  unfold fejer
  rw [norm_div, Complex.norm_natCast, div_pow]
  have hsq : (‖∑ t ∈ Icc 1 T, ee (α * t)‖ * (2 * dnear α)) ^ 2 ≤ 1 := by
    have h0 : 0 ≤ ‖∑ t ∈ Icc 1 T, ee (α * t)‖ * (2 * dnear α) := by positivity
    nlinarith
  calc ‖∑ t ∈ Icc 1 T, ee (α * t)‖ ^ 2 / (T : ℝ) ^ 2 * (4 * T ^ 2 * dnear α ^ 2)
      = (‖∑ t ∈ Icc 1 T, ee (α * t)‖ * (2 * dnear α)) ^ 2 := by field_simp; ring
    _ ≤ 1 := hsq

/-- `Φ_T(α) ≥ η/2` forces `‖α‖ ≤ 1/(T√(2η))`. -/
lemma dnear_le_of_fejer {T : ℕ} (hT : 1 ≤ T) {η α : ℝ} (hη : 0 < η) (h : η / 2 ≤ fejer T α) :
    dnear α ≤ 1 / (T * Real.sqrt (2 * η)) := by
  have hTR : (0 : ℝ) < T := by exact_mod_cast hT
  have hkey := fejer_mul_le T α
  have hd : 0 ≤ dnear α := dnear_nonneg α
  have h2η : 0 < Real.sqrt (2 * η) := Real.sqrt_pos.mpr (by linarith)
  -- `(T √(2η) ‖α‖)² = 2η T² ‖α‖² ≤ 1`
  have hsq : (T * Real.sqrt (2 * η) * dnear α) ^ 2 ≤ 1 := by
    have e : (T * Real.sqrt (2 * η) * dnear α) ^ 2 = 2 * η * T ^ 2 * dnear α ^ 2 := by
      rw [mul_pow, mul_pow, Real.sq_sqrt (by linarith)]; ring
    rw [e]
    have : η / 2 * (4 * T ^ 2 * dnear α ^ 2) ≤ fejer T α * (4 * T ^ 2 * dnear α ^ 2) :=
      mul_le_mul_of_nonneg_right h (by positivity)
    nlinarith
  have hle : T * Real.sqrt (2 * η) * dnear α ≤ 1 := by
    have h0 : 0 ≤ T * Real.sqrt (2 * η) * dnear α := by positivity
    nlinarith
  rw [le_div_iff₀ (by positivity)]
  linarith

/- ### Lemma L -/

/-- **Lemma L.** Let `S ⊆ [Y, 2Y]` be a finite set of positive integers in which fewer than a
proportion `(η/2)²` of the ordered pairs have a common factor, and let `T√(2η) > 4Y`. If
`E_{s∈S} Φ_T(θs) ≥ η` then `‖θ‖ ≤ 1/(√(2η)·T·Y)`. -/
theorem lemmaL {S : Finset ℕ} {Y : ℝ} (hY : 0 < Y) (hS : ∀ s ∈ S, Y ≤ s ∧ (s : ℝ) ≤ 2 * Y)
    {T : ℕ} (hT : 1 ≤ T) {η : ℝ} (hη : 0 < η)
    (hcoll : (((S ×ˢ S).filter (fun p : ℕ × ℕ => ¬ Nat.Coprime p.1 p.2)).card : ℝ) <
      (η / 2) ^ 2 * (S.card : ℝ) ^ 2)
    (hTY : 4 * Y < T * Real.sqrt (2 * η)) {θ : ℝ}
    (hθ : η * S.card ≤ ∑ s ∈ S, fejer T (θ * s)) :
    dnear θ ≤ 1 / (Real.sqrt (2 * η) * T * Y) := by
  classical
  set G : Finset ℕ := S.filter (fun s : ℕ => η / 2 ≤ fejer T (θ * (s : ℝ))) with hG
  -- `|G| ≥ (η/2)|S|`
  have hGcard : η / 2 * S.card ≤ G.card := by
    have hsplit : ∑ s ∈ S, fejer T (θ * s) ≤ (G.card : ℝ) + η / 2 * S.card := by
      rw [← Finset.sum_filter_add_sum_filter_not S (fun s : ℕ => η / 2 ≤ fejer T (θ * (s : ℝ)))]
      have h1 : ∑ s ∈ G, fejer T (θ * s) ≤ G.card := by
        calc ∑ s ∈ G, fejer T (θ * s) ≤ ∑ s ∈ G, (1 : ℝ) :=
              Finset.sum_le_sum fun s _ => fejer_le_one T _
          _ = G.card := by simp
      have h2 : ∑ s ∈ S.filter (fun s : ℕ => ¬ η / 2 ≤ fejer T (θ * (s : ℝ))), fejer T (θ * s) ≤
          η / 2 * S.card := by
        calc ∑ s ∈ S.filter (fun s : ℕ => ¬ η / 2 ≤ fejer T (θ * (s : ℝ))), fejer T (θ * s)
            ≤ ∑ s ∈ S.filter (fun s : ℕ => ¬ η / 2 ≤ fejer T (θ * (s : ℝ))), η / 2 :=
              Finset.sum_le_sum fun s hs => (not_le.mp (Finset.mem_filter.mp hs).2).le
          _ = (S.filter (fun s : ℕ => ¬ η / 2 ≤ fejer T (θ * (s : ℝ)))).card * (η / 2) := by
              rw [Finset.sum_const, nsmul_eq_mul]
          _ ≤ S.card * (η / 2) := by
              gcongr
              exact Finset.filter_subset _ S
          _ = η / 2 * S.card := by ring
      linarith
    linarith
  -- a coprime pair inside `G`
  have hpair : ∃ s ∈ G, ∃ s' ∈ G, Nat.Coprime s s' := by
    by_contra hno
    simp only [not_exists, not_and] at hno
    have hsub : G ×ˢ G ⊆ (S ×ˢ S).filter (fun p : ℕ × ℕ => ¬ Nat.Coprime p.1 p.2) := by
      intro p hp
      rw [Finset.mem_product] at hp
      rw [Finset.mem_filter, Finset.mem_product]
      exact ⟨⟨(Finset.mem_filter.mp hp.1).1, (Finset.mem_filter.mp hp.2).1⟩, hno _ hp.1 _ hp.2⟩
    have hle : ((G ×ˢ G).card : ℝ) ≤
        (((S ×ˢ S).filter (fun p : ℕ × ℕ => ¬ Nat.Coprime p.1 p.2)).card : ℝ) := by
      exact_mod_cast Finset.card_le_card hsub
    rw [Finset.card_product] at hle
    have hG0 : 0 ≤ η / 2 * (S.card : ℝ) := by positivity
    have : (η / 2) ^ 2 * (S.card : ℝ) ^ 2 ≤ ((G.card * G.card : ℕ) : ℝ) := by
      push_cast
      nlinarith
    linarith
  obtain ⟨s, hs, s', hs', hcop⟩ := hpair
  have hsS := (Finset.mem_filter.mp hs).1
  have hs'S := (Finset.mem_filter.mp hs').1
  set ε : ℝ := 1 / (T * Real.sqrt (2 * η)) with hε
  have hTR : (0 : ℝ) < T := by exact_mod_cast hT
  have h2η : 0 < Real.sqrt (2 * η) := Real.sqrt_pos.mpr (by linarith)
  have hd1 : dnear (θ * s) ≤ ε := dnear_le_of_fejer hT hη (Finset.mem_filter.mp hs).2
  have hd2 : dnear (θ * s') ≤ ε := dnear_le_of_fejer hT hη (Finset.mem_filter.mp hs').2
  have hsY := hS s hsS
  have hs'Y := hS s' hs'S
  have hspos : 0 < s := by
    have : (0 : ℝ) < s := lt_of_lt_of_le hY hsY.1
    exact_mod_cast this
  have hsmall : ε * ((s : ℝ) + s') < 1 := by
    have hsum : (s : ℝ) + s' ≤ 4 * Y := by linarith [hsY.2, hs'Y.2]
    rw [hε, div_mul_eq_mul_div, one_mul, div_lt_one (by positivity)]
    linarith
  have hmain := near_int_coprime hspos hcop hd1 hd2 hsmall
  calc dnear θ ≤ ε / s := hmain
    _ ≤ ε / Y := by
        apply div_le_div_of_nonneg_left (by positivity) hY hsY.1
    _ = 1 / (Real.sqrt (2 * η) * T * Y) := by rw [hε]; field_simp

end G22.FPD

end

/- ## Section: `Lemma24` -/

section

/-
# GS Lemma 2.4 (and 2.5) with the Fejér-positive diophantine hypothesis

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. This file proves the version of GS Lemma 2.4
used by the elementary route to GS Proposition 5.1 (`notes/prop51_elementary_route.md`): the
hypothesis "`S` is `(L, L', D)`-diophantine" is replaced by `FPDProp S T D η Q₀ W`, i.e. every
`θ` with `ψ(θ) = E_{s∈S} Φ_T(θ s) ≥ η` (`Φ_T = FPD.fejer T`) satisfies `‖qθ‖ ≤ W/(TD)` for some
`1 ≤ q ≤ Q₀`. This is exactly the conclusion that GS derive (via Lemma 2.2) after (2.8), so
Lemma 2.2 is not needed.

## Main results (namespace `G22.L24`)

* `lemma24` (log averages, threshold `c₁ δ² = δ²/10`): if `S ≠ ∅`, `|s| ≤ 4D` on `S`, `|f| ≤ 1`,
  `N ≥ 2`, `H ≥ 1`, `δ > 0`, `FPDProp S T D (δ²/10) Q₀ W`,
  `(1 + log(10TD))/log N ≤ δ²/(640 Q₀)`, `16 H W ≤ TD`, `20 Q₀² H ≤ δ² TD` and
  `δ ≤ E^log_{n∈[N]} E_{t,t'∈[T]} E_{s∈S} f(n+ts) f(n+t's)`, then there is `q ∈ ℕ`,
  `1 ≤ q ≤ Q₀`, with `δ²/(100 Q₀) ≤ ‖f‖²_{U¹_log[N;q,H]}` (`U1logSq N q H f`).
  `lemma24_gen` is the same for any threshold `0 ≤ η ≤ δ/10`.
* `lemma25`, `lemma25_gen`: the same for the uniform average `E_{n∈[X]}` (GS Lemma 2.5), with
  `6400 Q₀ TD ≤ δ² X` in place of the condition on `log(TD)/log N`.
* `lemma24_core`: the common statement for an arbitrary finite weighted average
  `wE I w e F = (∑_{i∈I} w_i F(e_i)) / ∑_{i∈I} w_i` (positive weights) satisfying the shift bound
  `ShiftBound I w e (10TD) ε` (shifting a 1-bounded function by `|h| ≤ 10TD` changes its average by
  `≤ ε`) with `ε ≤ δ²/(320 Q₀)`. For log averages `ε = 2(1 + log(10TD))/log N` (GS (A.2),
  `shiftBound_logAvg`), for uniform averages over `[X]` `ε = 20TD/X` (GS (A.1), `shiftBound_uavg`).

No largeness of `D, T` and no smallness of `δ` is needed (`δ ≤ 1` follows from the hypothesis).

## Proof (a streamlined version of GS pp. 6–8)

1. (Shift, Cauchy–Schwarz, shift.) With `A(n) = E_{t,t'} E_s f(n + (t-t')s)`, the shift bound gives
   `E f·A ≥ δ - ε`, Cauchy–Schwarz gives `E A² ≥ (δ - ε)²`, and averaging over `h ∈ [K]`, `K = TD`,
   gives `E_n E_{h∈[K]} A(n+h)² ≥ (δ - ε)² - ε`.
2. (Fourier analysis on `ZMod P`, `P = 9K + 1`, for each fixed `n`.) Put `g(z) = f(n - 4K + z)`,
   `z ∈ [0, P)`. For `h ∈ [K]` all the points `n + h + (t-t')s` lie in the window, so
   `∑_{h∈[K]} A(n+h)² ≤ ∑_z b(z)²` with `b = E_{t,t',s} g(· + (t-t')s)` (cyclic convolution).
   By Parseval and `b̂(k) = ψ(k/P) ĝ(k)`: frequencies with `ψ < η` contribute `≤ η² P²`; at the
   others `FPDProp` gives `q ≤ Q₀` with `‖qk/P‖ ≤ W/(TD) ≤ 1/(16H)`, hence `Φ_H(qk/P) ≥ 1/4`, and
   `Φ_H(qk/P) |ĝ(k)|² = |Ĝ_q(k)|²` for `G_q = E_{h∈[H]} g(· + qh)`. Parseval again gives
   `∑_{h∈[K]} A(n+h)² ≤ η² P + 4 ∑_{q≤Q₀} ∑_z G_q(z)²` (`pointwise_bound`); up to `qH` boundary
   terms, `∑_z G_q(z)² = ∑_{j<P} (E_{h∈[H]} f(n - 4K + j + qh))²`.
   (This replaces GS's kernel estimate, (2.7)–(2.9) and the physical-space step; it gives the
   better bound `δ²/Q₀` and no dependence on `W` in the conclusion.)
3. (Average over `n`, shift back.) Averaging over `n` and shifting by `j - 4K` bounds the right
   side by `4P ∑_{q ≤ Q₀} (‖f‖²_{U¹[q,H]} + ε) + O(Q₀² H)`; the numerics (`numerics`) give
   `∑_{q ≤ Q₀} ‖f‖²_{U¹[q,H]} ≥ δ²/100`, and pigeonholing `q` finishes the proof.
-/

open Finset Real

namespace G22.L24

open FPD

/-- Fejér-positive diophantine property of `S` at scale `(T, D)`: every frequency at which
`E_{s∈S} Φ_T(θ s) ≥ η` is within `W/(TD)` of a rational with denominator at most `Q₀`. -/
def FPDProp (S : Finset ℤ) (T D : ℕ) (η Q₀ W : ℝ) : Prop :=
  ∀ θ : ℝ, η ≤ (∑ s ∈ S, FPD.fejer T (θ * s)) / S.card →
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧ FPD.dnear (q * θ) ≤ W / ((T : ℝ) * D)

section Fourier
variable {P : ℕ} [NeZero P]

/-- Discrete Fourier transform of a real function on `ZMod P` (sign convention `e(+kz/P)`). -/
noncomputable def dft (a : ZMod P → ℝ) (k : ZMod P) : ℂ :=
  ∑ z : ZMod P, (a z : ℂ) * ZMod.stdAddChar (k * z)

lemma sum_stdAddChar_mul (w : ZMod P) :
    ∑ k : ZMod P, ZMod.stdAddChar (k * w) = if w = 0 then (P : ℂ) else 0 := by
  rw [AddChar.sum_mulShift w (ZMod.isPrimitive_stdAddChar P)]
  split_ifs <;> simp [ZMod.card]

lemma stdAddChar_neg (x : ZMod P) :
    ZMod.stdAddChar (-x) = (starRingEnd ℂ) (ZMod.stdAddChar x) :=
  AddChar.map_neg_eq_conj _ _

/-- Parseval's identity on `ZMod P`. -/
lemma parseval (a : ZMod P → ℝ) : ∑ k, ‖dft a k‖ ^ 2 = P * ∑ z, a z ^ 2 := by
  have h1 : ∀ k, ((‖dft a k‖ ^ 2 : ℝ) : ℂ) =
      ∑ z, ∑ w, ((a z * a w : ℝ) : ℂ) * ZMod.stdAddChar (k * (z - w)) := by
    intro k
    push_cast
    rw [← Complex.mul_conj']
    unfold dft
    rw [map_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun w _ => ?_
    rw [map_mul (starRingEnd ℂ), Complex.conj_ofReal, ← stdAddChar_neg,
      show k * (z - w) = k * z + -(k * w) by ring, AddChar.map_add_eq_mul]
    ring
  have h3 : ∀ z w : ZMod P, ∑ k : ZMod P, ((a z * a w : ℝ) : ℂ) * ZMod.stdAddChar (k * (z - w)) =
      if z = w then ((P * a z ^ 2 : ℝ) : ℂ) else 0 := by
    intro z w
    rw [← Finset.mul_sum, sum_stdAddChar_mul]
    by_cases h : z = w
    · subst h; simp only [sub_self, if_true]; push_cast; ring
    · have h' : z - w ≠ 0 := sub_ne_zero.mpr h
      simp [h, h']
  have h2 : ((∑ k, ‖dft a k‖ ^ 2 : ℝ) : ℂ) = ((P * ∑ z, a z ^ 2 : ℝ) : ℂ) := by
    rw [Complex.ofReal_sum]
    rw [Finset.sum_congr rfl fun k _ => h1 k]
    rw [Finset.sum_comm]
    rw [Finset.sum_congr rfl fun z _ => Finset.sum_comm]
    simp only [h3, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    push_cast
    rw [Finset.mul_sum]
  exact_mod_cast h2

lemma dft_shift (a : ZMod P → ℝ) (y k : ZMod P) :
    dft (fun z => a (z + y)) k = ZMod.stdAddChar (-(k * y)) * dft a k := by
  unfold dft
  rw [Finset.mul_sum]
  refine Fintype.sum_equiv (Equiv.addRight y) _ _ fun z => ?_
  simp only [Equiv.coe_addRight]
  rw [show k * z = -(k * y) + k * (z + y) by ring, AddChar.map_add_eq_mul]
  ring

lemma dft_finset_sum {ι : Type*} (I : Finset ι) (a : ι → ZMod P → ℝ) (k : ZMod P) :
    dft (fun z => ∑ i ∈ I, a i z) k = ∑ i ∈ I, dft (a i) k := by
  unfold dft
  push_cast
  simp_rw [Finset.sum_mul]
  exact Finset.sum_comm

lemma dft_div (a : ZMod P → ℝ) (c : ℝ) (k : ZMod P) :
    dft (fun z => a z / c) k = dft a k / c := by
  unfold dft
  push_cast
  rw [Finset.sum_div]
  exact Finset.sum_congr rfl fun z _ => by ring

/-- `e(k m / P)` for an integer `m`. -/
lemma stdAddChar_mul_intCast (k : ZMod P) (m : ℤ) :
    ZMod.stdAddChar (k * (m : ZMod P)) = ee ((k.val : ℝ) / P * m) := by
  have e : k * (m : ZMod P) = (((k.val : ℤ) * m : ℤ) : ZMod P) := by
    push_cast; rw [ZMod.natCast_zmod_val]
  rw [e, ZMod.stdAddChar_coe]
  unfold ee
  congr 1
  push_cast
  ring

end Fourier

/- ### Fejér kernel facts -/

lemma fejer_eq (T : ℕ) (α : ℝ) :
    fejer T α = ‖∑ t ∈ Icc 1 T, ee (α * t)‖ ^ 2 / (T : ℝ) ^ 2 := by
  unfold fejer
  rw [norm_div, Complex.norm_natCast, div_pow]

lemma fejer_zero {T : ℕ} (hT : 1 ≤ T) : fejer T 0 = 1 := by
  have hTR : (T : ℝ) ≠ 0 := by have : (0 : ℝ) < T := by exact_mod_cast hT
                               exact this.ne'
  rw [fejer_eq]
  have : ∑ t ∈ Icc 1 T, ee ((0 : ℝ) * t) = (T : ℂ) := by
    simp [ee]
  rw [this, Complex.norm_natCast]
  field_simp

lemma ee_add_int_mul (y : ℝ) (r : ℤ) (h : ℕ) : ee ((y + r) * h) = ee (y * h) := by
  unfold ee
  have e : (2 * π * Complex.I * (((y + r) * h : ℝ) : ℂ)) =
      2 * π * Complex.I * ((y * h : ℝ) : ℂ) + ((r * h : ℤ) : ℂ) * (2 * π * Complex.I) := by
    push_cast; ring
  rw [e, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

lemma norm_ee_sub_one (u : ℝ) : ‖ee u - 1‖ ≤ 2 * π * |u| := by
  unfold ee
  have h := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * π * u)
  rw [show (2 * π * Complex.I * u : ℂ) = Complex.I * ((2 * π * u : ℝ) : ℂ) by push_cast; ring]
  refine h.trans (le_of_eq ?_)
  rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_of_pos two_pos, abs_of_pos Real.pi_pos]

/-- `Φ_H(x) ≥ 1/4` when `‖x‖ ≤ 1/(16H)`. -/
lemma fejer_ge_quarter {H : ℕ} (hH : 1 ≤ H) {x : ℝ} (hx : dnear x ≤ 1 / (16 * H)) :
    1 / 4 ≤ fejer H x := by
  set y : ℝ := x - round x with hydef
  have hy : |y| ≤ 1 / (16 * H) := hx
  have hHR : (0 : ℝ) < H := by exact_mod_cast hH
  have hsum : ∑ h ∈ Icc 1 H, ee (x * h) = ∑ h ∈ Icc 1 H, ee (y * h) := by
    refine Finset.sum_congr rfl fun h _ => ?_
    have := ee_add_int_mul y (round x) h
    rwa [show y + ((round x : ℤ) : ℝ) = x by rw [hydef]; ring] at this
  have hbound : ‖∑ h ∈ Icc 1 H, ee (y * h) - H‖ ≤ H / 2 := by
    have e : ∑ h ∈ Icc 1 H, ee (y * h) - H = ∑ h ∈ Icc 1 H, (ee (y * h) - 1) := by
      rw [Finset.sum_sub_distrib]; simp
    rw [e]
    calc ‖∑ h ∈ Icc 1 H, (ee (y * h) - 1)‖ ≤ ∑ h ∈ Icc 1 H, ‖ee (y * h) - 1‖ := norm_sum_le _ _
      _ ≤ ∑ h ∈ Icc 1 H, (1 / 2 : ℝ) := Finset.sum_le_sum fun h hh => by
          refine (norm_ee_sub_one _).trans ?_
          have hh' : (h : ℝ) ≤ H := by exact_mod_cast (Finset.mem_Icc.mp hh).2
          have h0 : (0 : ℝ) ≤ h := Nat.cast_nonneg h
          rw [abs_mul, abs_of_nonneg h0]
          have hpi := Real.pi_le_four
          have hy0 : 0 ≤ |y| := abs_nonneg y
          have h1 : |y| * h ≤ 1 / 16 := by
            calc |y| * h ≤ 1 / (16 * H) * H := mul_le_mul hy hh' h0 (by positivity)
              _ = 1 / 16 := by field_simp
          nlinarith [Real.pi_pos, mul_nonneg hy0 h0]
      _ = H / 2 := by simp; ring
  have hnorm : (H : ℝ) / 2 ≤ ‖∑ h ∈ Icc 1 H, ee (y * h)‖ := by
    have h1 := norm_sub_norm_le (H : ℂ) (∑ h ∈ Icc 1 H, ee (y * h))
    rw [Complex.norm_natCast, norm_sub_rev] at h1
    linarith
  rw [fejer_eq, hsum]
  have h2 : (H : ℝ) ^ 2 / 4 ≤ ‖∑ h ∈ Icc 1 H, ee (y * h)‖ ^ 2 := by
    have h0 : (0 : ℝ) ≤ H / 2 := by positivity
    nlinarith
  rw [le_div_iff₀ (by positivity)]
  linarith

section Kernels
variable {P : ℕ} [NeZero P]

/-- The kernel of `b ↦ E_{t,t'} E_s b(· + (t - t') s)`: a sum of Fejér kernels. -/
lemma kernel_b (k : ZMod P) (S : Finset ℤ) (T : ℕ) :
    ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
        ZMod.stdAddChar (-(k * ((((t : ℤ) - t') * s : ℤ) : ZMod P))) =
      ((∑ s ∈ S, ‖∑ t ∈ Icc 1 T, ee ((k.val : ℝ) / P * s * t)‖ ^ 2 : ℝ) : ℂ) := by
  rw [Finset.sum_congr rfl fun t _ => Finset.sum_comm, Finset.sum_comm, Complex.ofReal_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [Complex.ofReal_pow, ← Complex.conj_mul', map_sum, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun t' _ => ?_
  rw [show -(k * ((((t : ℤ) - t') * s : ℤ) : ZMod P)) =
      -(k * (((t : ℤ) * s : ℤ) : ZMod P)) + k * (((t' : ℤ) * s : ℤ) : ZMod P) by push_cast; ring,
    AddChar.map_add_eq_mul, stdAddChar_neg, stdAddChar_mul_intCast, stdAddChar_mul_intCast]
  have e1 : (k.val : ℝ) / P * (((t : ℤ) * s : ℤ) : ℝ) = (k.val : ℝ) / P * s * t := by push_cast; ring
  have e2 : (k.val : ℝ) / P * (((t' : ℤ) * s : ℤ) : ℝ) = (k.val : ℝ) / P * s * t' := by
    push_cast; ring
  rw [e1, e2]

lemma kernel_G (k : ZMod P) (q H : ℕ) :
    ‖(∑ h ∈ Icc 1 H, ZMod.stdAddChar (-(k * ((q * h : ℕ) : ZMod P)))) / (H : ℂ)‖ ^ 2 =
      fejer H (q * ((k.val : ℝ) / P)) := by
  unfold fejer
  have e : ∑ h ∈ Icc 1 H, ZMod.stdAddChar (-(k * ((q * h : ℕ) : ZMod P))) =
      (starRingEnd ℂ) (∑ h ∈ Icc 1 H, ee (q * ((k.val : ℝ) / P) * h)) := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun h _ => ?_
    rw [stdAddChar_neg]
    congr 1
    have := stdAddChar_mul_intCast k ((q * h : ℕ) : ℤ)
    rw [Int.cast_natCast] at this
    rw [this]
    congr 1
    push_cast; ring
  rw [e, norm_div, norm_div, Complex.norm_conj]

/-- `b(z) = E_{t,t' ∈ [T]} E_{s ∈ S} g(z + (t - t') s)` on `ZMod P`. -/
noncomputable def bAvg (g : ZMod P → ℝ) (S : Finset ℤ) (T : ℕ) (z : ZMod P) : ℝ :=
  (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, g (z + ((((t : ℤ) - t') * s : ℤ) : ZMod P))) /
    (T * T * S.card)

/-- `G_q(z) = E_{h ∈ [H]} g(z + q h)` on `ZMod P`. -/
noncomputable def gAvg (g : ZMod P → ℝ) (q H : ℕ) (z : ZMod P) : ℝ :=
  (∑ h ∈ Icc 1 H, g (z + ((q * h : ℕ) : ZMod P))) / H

lemma dft_bAvg (g : ZMod P → ℝ) (S : Finset ℤ) (T : ℕ) (k : ZMod P) :
    dft (bAvg g S T) k =
      (((∑ s ∈ S, fejer T ((k.val : ℝ) / P * s)) / S.card : ℝ) : ℂ) * dft g k := by
  unfold bAvg
  rw [dft_div]
  simp only [dft_finset_sum, dft_shift]
  simp only [← Finset.sum_mul]
  rw [kernel_b]
  have e : (∑ s ∈ S, fejer T ((k.val : ℝ) / P * s)) / S.card =
      (∑ s ∈ S, ‖∑ t ∈ Icc 1 T, ee ((k.val : ℝ) / P * s * t)‖ ^ 2) / (T * T * S.card) := by
    simp only [fejer_eq]
    rw [← Finset.sum_div, div_div]
    ring_nf
  rw [e]
  push_cast
  ring

lemma normSq_dft_gAvg (g : ZMod P → ℝ) (q H : ℕ) (k : ZMod P) :
    ‖dft (gAvg g q H) k‖ ^ 2 = fejer H (q * ((k.val : ℝ) / P)) * ‖dft g k‖ ^ 2 := by
  unfold gAvg
  rw [dft_div]
  simp only [dft_finset_sum, dft_shift]
  simp only [← Finset.sum_mul]
  rw [← kernel_G, mul_div_right_comm, norm_mul, mul_pow, Complex.ofReal_natCast]

end Kernels

/- ### The key inequality for a single `n` -/

section Key
variable {P : ℕ} [NeZero P]

lemma sum_sq_le_card (g : ZMod P → ℝ) (hg : ∀ z, |g z| ≤ 1) : ∑ z, g z ^ 2 ≤ P := by
  calc ∑ z, g z ^ 2 ≤ ∑ _z : ZMod P, (1 : ℝ) := Finset.sum_le_sum fun z _ => by
        have h1 := hg z
        have h0 := abs_nonneg (g z)
        rw [← sq_abs]; nlinarith
    _ = P := by simp [ZMod.card]

/-- **Key inequality.** If every frequency `k/P` at which the Fejér average
`ψ(k) = E_{s∈S} Φ_T(ks/P)` is `≥ η` has `Φ_H(qk/P) ≥ 1/4` for some `q ∈ [1, Q]`, then
`∑_z b(z)² ≤ η² P + 4 ∑_{q ≤ Q} ∑_z G_q(z)²` (Parseval + convolution on `ZMod P`). -/
theorem key_fourier (g : ZMod P → ℝ) (hg : ∀ z, |g z| ≤ 1) {S : Finset ℤ} (hS : S.Nonempty)
    (T H Q : ℕ) (η : ℝ)
    (hmaj : ∀ k : ZMod P, η ≤ (∑ s ∈ S, fejer T ((k.val : ℝ) / P * s)) / S.card →
      ∃ q ∈ Icc 1 Q, 1 / 4 ≤ fejer H (q * ((k.val : ℝ) / P))) :
    ∑ z, bAvg g S T z ^ 2 ≤ η ^ 2 * P + 4 * ∑ q ∈ Icc 1 Q, ∑ z, gAvg g q H z ^ 2 := by
  have hP : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  have hScard : (0 : ℝ) < S.card := by exact_mod_cast hS.card_pos
  have hD : ∀ k : ZMod P, ‖dft (bAvg g S T) k‖ ^ 2 ≤
      η ^ 2 * ‖dft g k‖ ^ 2 + 4 * ∑ q ∈ Icc 1 Q, ‖dft (gAvg g q H) k‖ ^ 2 := by
    intro k
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = (∑ s ∈ S, fejer T ((k.val : ℝ) / P * s)) / S.card := ⟨_, rfl⟩
    have hx0 : 0 ≤ x := by
      rw [hx]; exact div_nonneg (Finset.sum_nonneg fun s _ => fejer_nonneg _ _) hScard.le
    have hx1 : x ≤ 1 := by
      rw [hx, div_le_one hScard]
      calc ∑ s ∈ S, fejer T ((k.val : ℝ) / P * s) ≤ ∑ s ∈ S, (1 : ℝ) :=
            Finset.sum_le_sum fun s _ => fejer_le_one _ _
        _ = S.card := by simp
    rw [dft_bAvg, ← hx, norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    simp only [normSq_dft_gAvg]
    rw [← Finset.sum_mul]
    have hg0 : 0 ≤ ‖dft g k‖ ^ 2 := by positivity
    have hF0 : 0 ≤ ∑ q ∈ Icc 1 Q, fejer H (q * ((k.val : ℝ) / P)) :=
      Finset.sum_nonneg fun q _ => fejer_nonneg _ _
    by_cases hk : η ≤ x
    · obtain ⟨q₀, hq₀, hq₀f⟩ := hmaj k (hx ▸ hk)
      have h1 : fejer H (q₀ * ((k.val : ℝ) / P)) ≤
          ∑ q ∈ Icc 1 Q, fejer H (q * ((k.val : ℝ) / P)) :=
        Finset.single_le_sum (f := fun q : ℕ => fejer H (q * ((k.val : ℝ) / P)))
          (fun q _ => fejer_nonneg _ _) hq₀
      have h2 : x ^ 2 ≤ 1 := by nlinarith
      have h3 : 1 ≤ 4 * ∑ q ∈ Icc 1 Q, fejer H (q * ((k.val : ℝ) / P)) := by linarith
      nlinarith [mul_le_mul_of_nonneg_right h3 hg0, mul_le_mul_of_nonneg_right h2 hg0,
        mul_nonneg (sq_nonneg η) hg0]
    · rw [not_le] at hk
      have h2 : x ^ 2 ≤ η ^ 2 := by nlinarith
      nlinarith [mul_le_mul_of_nonneg_right h2 hg0, mul_nonneg hF0 hg0]
  have hsum : ∑ k, ‖dft (bAvg g S T) k‖ ^ 2 ≤
      ∑ k, (η ^ 2 * ‖dft g k‖ ^ 2 + 4 * ∑ q ∈ Icc 1 Q, ‖dft (gAvg g q H) k‖ ^ 2) :=
    Finset.sum_le_sum fun k _ => hD k
  have e1 : ∑ k, (η ^ 2 * ‖dft g k‖ ^ 2 + 4 * ∑ q ∈ Icc 1 Q, ‖dft (gAvg g q H) k‖ ^ 2) =
      η ^ 2 * (P * ∑ z, g z ^ 2) + 4 * ∑ q ∈ Icc 1 Q, P * ∑ z, gAvg g q H z ^ 2 := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_comm, parseval]
    congr 2
    exact Finset.sum_congr rfl fun q _ => parseval _
  rw [e1, parseval, ← Finset.mul_sum] at hsum
  have hg2 := sum_sq_le_card g hg
  have hmain : (P : ℝ) * ∑ z, bAvg g S T z ^ 2 ≤
      P * (η ^ 2 * P + 4 * ∑ q ∈ Icc 1 Q, ∑ z, gAvg g q H z ^ 2) := by
    calc (P : ℝ) * ∑ z, bAvg g S T z ^ 2
        ≤ η ^ 2 * (P * ∑ z, g z ^ 2) + 4 * (P * ∑ q ∈ Icc 1 Q, ∑ z, gAvg g q H z ^ 2) := hsum
      _ ≤ η ^ 2 * (P * P) + 4 * (P * ∑ q ∈ Icc 1 Q, ∑ z, gAvg g q H z ^ 2) := by gcongr
      _ = P * (η ^ 2 * P + 4 * ∑ q ∈ Icc 1 Q, ∑ z, gAvg g q H z ^ 2) := by ring
  exact le_of_mul_le_mul_left hmain hP

end Key

/- ### From `ℤ` to `ZMod P` -/

section Bridge
variable {P : ℕ} [NeZero P]

lemma val_intCast_eq {x : ℤ} (h0 : 0 ≤ x) (h1 : x < P) : (((x : ZMod P)).val : ℤ) = x := by
  rw [ZMod.val_intCast]; exact Int.emod_eq_of_lt h0 (by exact_mod_cast h1)

lemma sum_zmod_eq_sum_range (F : ZMod P → ℝ) : ∑ z, F z = ∑ j ∈ range P, F (j : ZMod P) := by
  refine Finset.sum_nbij' (fun z => z.val) (fun j => (j : ZMod P)) ?_ ?_ ?_ ?_ ?_
  · intro z _; exact Finset.mem_range.mpr (ZMod.val_lt z)
  · intro j _; exact Finset.mem_univ _
  · intro z _; exact ZMod.natCast_zmod_val z
  · intro j hj; exact ZMod.val_natCast_of_lt (Finset.mem_range.mp hj)
  · intro z _; rw [ZMod.natCast_zmod_val]

/-- The window `g_n(z) = f(n - c + z)`, `z ∈ [0, P)`, viewed as a function on `ZMod P`. -/
noncomputable def gShift (f : ℤ → ℝ) (n : ℤ) (c : ℕ) (z : ZMod P) : ℝ := f (n - c + (z.val : ℤ))

lemma bAvg_gShift (f : ℤ → ℝ) (S : Finset ℤ) (T : ℕ) (n : ℤ) (c h : ℕ)
    (hsmall : ∀ t ∈ Icc 1 T, ∀ t' ∈ Icc 1 T, ∀ s ∈ S, |((t : ℤ) - t') * s| ≤ c)
    (hP : h + 2 * c < P) :
    bAvg (gShift (P := P) f n c) S T ((h + c : ℕ) : ZMod P) =
      (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, f (n + h + ((t : ℤ) - t') * s)) /
        (T * T * S.card) := by
  unfold bAvg
  congr 1
  refine Finset.sum_congr rfl fun t ht => Finset.sum_congr rfl fun t' ht' =>
    Finset.sum_congr rfl fun s hs => ?_
  have hb := abs_le.mp (hsmall t ht t' ht' s hs)
  have e : ((h + c : ℕ) : ZMod P) + ((((t : ℤ) - t') * s : ℤ) : ZMod P) =
      ((((h : ℤ) + c) + ((t : ℤ) - t') * s : ℤ) : ZMod P) := by push_cast; ring
  unfold gShift
  rw [e, val_intCast_eq (by omega) (by omega)]
  congr 1; ring

lemma sum_sq_A_le (f : ℤ → ℝ) (S : Finset ℤ) (T : ℕ) (n : ℤ) (c M : ℕ)
    (hsmall : ∀ t ∈ Icc 1 T, ∀ t' ∈ Icc 1 T, ∀ s ∈ S, |((t : ℤ) - t') * s| ≤ c)
    (hP : M + 2 * c < P) :
    ∑ h ∈ Icc 1 M, ((∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, f (n + h + ((t : ℤ) - t') * s)) /
        (T * T * S.card)) ^ 2 ≤ ∑ z, bAvg (gShift (P := P) f n c) S T z ^ 2 := by
  classical
  have hinj : Set.InjOn (fun h : ℕ => ((h + c : ℕ) : ZMod P)) (Icc 1 M : Set ℕ) := by
    intro h₁ h₁m h₂ h₂m heq
    have h₁M := (Finset.mem_Icc.mp h₁m).2
    have h₂M := (Finset.mem_Icc.mp h₂m).2
    have := congrArg ZMod.val heq
    simp only at this
    rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at this
    omega
  calc ∑ h ∈ Icc 1 M, ((∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
          f (n + h + ((t : ℤ) - t') * s)) / (T * T * S.card)) ^ 2
      = ∑ h ∈ Icc 1 M, bAvg (gShift (P := P) f n c) S T ((h + c : ℕ) : ZMod P) ^ 2 := by
        refine Finset.sum_congr rfl fun h hh => ?_
        rw [bAvg_gShift f S T n c h hsmall (by have := (Finset.mem_Icc.mp hh).2; omega)]
    _ = ∑ z ∈ (Icc 1 M).image (fun h : ℕ => ((h + c : ℕ) : ZMod P)),
          bAvg (gShift (P := P) f n c) S T z ^ 2 := by
        rw [Finset.sum_image hinj]
    _ ≤ ∑ z, bAvg (gShift (P := P) f n c) S T z ^ 2 :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun z _ _ => sq_nonneg _

lemma abs_avg_le_one {ι : Type*} (I : Finset ι) (a : ι → ℝ) (ha : ∀ i ∈ I, |a i| ≤ 1) :
    |(∑ i ∈ I, a i) / I.card| ≤ 1 := by
  rcases Nat.eq_zero_or_pos I.card with h | h
  · simp [h]
  · rw [abs_div, Nat.abs_cast, div_le_one (by exact_mod_cast h)]
    exact Elem.abs_sum_le_card I a ha

lemma uavg_eq_sum_div (T : ℕ) (F : ℕ → ℝ) : uavg T F = (∑ t ∈ Icc 1 T, F t) / T := by
  unfold uavg wavg
  simp

omit [NeZero P] in
lemma gAvg_gShift (f : ℤ → ℝ) (n : ℤ) (c q H j : ℕ) (hj : j + q * H < P) :
    gAvg (gShift (P := P) f n c) q H (j : ZMod P) = uavg H (fun h => f (n - c + j + q * h)) := by
  unfold gAvg gShift
  rw [uavg_eq_sum_div]
  congr 1
  refine Finset.sum_congr rfl fun h hh => ?_
  have hhH := (Finset.mem_Icc.mp hh).2
  have hlt : j + q * h < P := lt_of_le_of_lt (Nat.add_le_add_left (Nat.mul_le_mul_left q hhH) j) hj
  rw [← Nat.cast_add, ZMod.val_natCast_of_lt hlt]
  push_cast; congr 1; ring

lemma sum_sq_gAvg_le (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (n : ℤ) (c q H : ℕ) :
    ∑ z, gAvg (gShift (P := P) f n c) q H z ^ 2 ≤
      ∑ j ∈ range P, (uavg H (fun h => f (n - c + j + q * h))) ^ 2 + q * H := by
  classical
  rw [sum_zmod_eq_sum_range]
  have hpt : ∀ j ∈ range P, gAvg (gShift (P := P) f n c) q H (j : ZMod P) ^ 2 ≤
      (uavg H (fun h => f (n - c + j + q * h))) ^ 2 + (if P ≤ j + q * H then 1 else 0) := by
    intro j _
    split_ifs with hjq
    · have h1 : |gAvg (gShift (P := P) f n c) q H (j : ZMod P)| ≤ 1 := by
        unfold gAvg
        have := abs_avg_le_one (Icc 1 H)
          (fun h => gShift (P := P) f n c ((j : ZMod P) + ((q * h : ℕ) : ZMod P)))
          (fun h _ => hf _)
        simpa using this
      have h2 : gAvg (gShift (P := P) f n c) q H (j : ZMod P) ^ 2 ≤ 1 := by
        rw [← sq_abs]; nlinarith [abs_nonneg (gAvg (gShift (P := P) f n c) q H (j : ZMod P))]
      nlinarith [sq_nonneg (uavg H (fun h => f (n - c + j + q * h)))]
    · rw [gAvg_gShift f n c q H j (by omega)]; linarith
  have hcard : (((range P).filter (fun j => P ≤ j + q * H)).card : ℝ) ≤ q * H := by
    have : ((range P).filter (fun j => P ≤ j + q * H)).card ≤ q * H := by
      calc ((range P).filter (fun j => P ≤ j + q * H)).card ≤ (Ico (P - q * H) P).card := by
            apply Finset.card_le_card
            intro j hj
            simp only [Finset.mem_filter, Finset.mem_range] at hj
            simp only [Finset.mem_Ico]
            omega
        _ ≤ q * H := by rw [Nat.card_Ico]; omega
    exact_mod_cast this
  calc ∑ j ∈ range P, gAvg (gShift (P := P) f n c) q H (j : ZMod P) ^ 2
      ≤ ∑ j ∈ range P, ((uavg H (fun h => f (n - c + j + q * h))) ^ 2 +
          (if P ≤ j + q * H then 1 else 0)) := Finset.sum_le_sum hpt
    _ = ∑ j ∈ range P, (uavg H (fun h => f (n - c + j + q * h))) ^ 2 +
          (((range P).filter (fun j => P ≤ j + q * H)).card : ℝ) := by
        rw [Finset.sum_add_distrib, Finset.sum_boole]
    _ ≤ ∑ j ∈ range P, (uavg H (fun h => f (n - c + j + q * h))) ^ 2 + q * H := by linarith

/-- The pointwise inequality for a fixed `n`. -/
theorem pointwise_bound (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) {S : Finset ℤ} (hS : S.Nonempty)
    (T H Q c M : ℕ) (η : ℝ)
    (hsmall : ∀ t ∈ Icc 1 T, ∀ t' ∈ Icc 1 T, ∀ s ∈ S, |((t : ℤ) - t') * s| ≤ c)
    (hP : M + 2 * c < P)
    (hmaj : ∀ k : ZMod P, η ≤ (∑ s ∈ S, fejer T ((k.val : ℝ) / P * s)) / S.card →
      ∃ q ∈ Icc 1 Q, 1 / 4 ≤ fejer H (q * ((k.val : ℝ) / P))) (n : ℤ) :
    ∑ h ∈ Icc 1 M, ((∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, f (n + h + ((t : ℤ) - t') * s)) /
        (T * T * S.card)) ^ 2 ≤
      η ^ 2 * P + 4 * ∑ q ∈ Icc 1 Q,
        (∑ j ∈ range P, (uavg H (fun h => f (n - c + j + q * h))) ^ 2 + q * H) := by
  have hg : ∀ z : ZMod P, |gShift f n c z| ≤ 1 := fun z => hf _
  calc _ ≤ ∑ z, bAvg (gShift (P := P) f n c) S T z ^ 2 := sum_sq_A_le f S T n c M hsmall hP
    _ ≤ η ^ 2 * P + 4 * ∑ q ∈ Icc 1 Q, ∑ z, gAvg (gShift (P := P) f n c) q H z ^ 2 :=
        key_fourier _ hg hS T H Q η hmaj
    _ ≤ _ := by
        gcongr with q hq
        exact sum_sq_gAvg_le f hf n c q H

end Bridge

/- ### Averages over `t, t' ∈ [T]`, `s ∈ S` -/

lemma avg3_eq (T : ℕ) (S : Finset ℤ) (F : ℕ → ℕ → ℤ → ℝ) :
    uavg T (fun t => uavg T (fun t' => (∑ s ∈ S, F t t' s) / S.card)) =
      (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, F t t' s) / (T * T * S.card) := by
  simp only [uavg_eq_sum_div, Finset.sum_div, div_div]
  refine Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun t' _ =>
    Finset.sum_congr rfl fun s _ => ?_
  congr 1; ring

lemma abs_avg3_le_one (T : ℕ) (S : Finset ℤ) (F : ℕ → ℕ → ℤ → ℝ)
    (hF : ∀ t t' s, |F t t' s| ≤ 1) :
    |(∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, F t t' s) / (T * T * S.card)| ≤ 1 := by
  have hnum : |∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, F t t' s| ≤ T * T * S.card := by
    calc |∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, F t t' s|
        ≤ ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, |F t t' s| := by
          refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun t _ => ?_)
          refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun t' _ => ?_)
          exact Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, (1 : ℝ) := by
          gcongr with t _ t' _ s _; exact hF t t' s
      _ = T * T * S.card := by simp; ring
  rw [abs_div]
  rcases (show (0 : ℝ) ≤ T * T * S.card by positivity).eq_or_lt with h | h
  · rw [← h]; simp
  · rw [abs_of_pos h, div_le_one h]; exact hnum

/- ### General finite weighted averages -/

section General
variable {ι : Type*}

/-- A finite weighted average `E F = (∑_{i∈I} w_i F(e_i)) / ∑_{i∈I} w_i` of `F : ℤ → ℝ`.
`logAvg N` is `wE (Icc 1 N) (fun n => 1 / n) Nat.cast` (`wE_logAvg`) and the uniform average
over `[X]` is `wE (Icc 1 X) (fun _ => 1) Nat.cast` (`wE_uavg`). -/
noncomputable def wE (I : Finset ι) (w : ι → ℝ) (e : ι → ℤ) (F : ℤ → ℝ) : ℝ :=
  wavg I w (fun i => F (e i))

/-- Shift property of the average `wE I w e`: shifting a 1-bounded function by at most `L`
changes its average by at most `ε` (GS (A.2) for logarithmic, (A.1) for uniform averages). -/
def ShiftBound (I : Finset ι) (w : ι → ℝ) (e : ι → ℤ) (L : ℕ) (ε : ℝ) : Prop :=
  ∀ F : ℤ → ℝ, (∀ n, |F n| ≤ 1) → ∀ h : ℤ, h.natAbs ≤ L →
    |wE I w e (fun n => F (n + h)) - wE I w e F| ≤ ε

lemma wE_logAvg (N : ℕ) (F : ℤ → ℝ) :
    wE (Icc 1 N) (fun n : ℕ => 1 / (n : ℝ)) (fun n : ℕ => (n : ℤ)) F = logAvg N F := rfl

lemma wE_uavg (X : ℕ) (F : ℤ → ℝ) :
    wE (Icc 1 X) (fun _ : ℕ => (1 : ℝ)) (fun n : ℕ => (n : ℤ)) F = uavg X (fun n => F n) := rfl

/-- GS (A.2): the logarithmic average has the shift property with `ε = 2(1 + log L)/log N`. -/
lemma shiftBound_logAvg (N : ℕ) (hN : 2 ≤ N) (L : ℕ) :
    ShiftBound (Icc 1 N) (fun n : ℕ => 1 / (n : ℝ)) (fun n : ℕ => (n : ℤ)) L
      (2 * (1 + Real.log L) / Real.log N) :=
  fun F hF h hh => Elem.logAvg_shift_le' N hN F hF h L hh

/-- GS (A.1): the uniform average over `[X]` has the shift property with `ε = 2L/X`. -/
lemma shiftBound_uavg (X L : ℕ) :
    ShiftBound (Icc 1 X) (fun _ : ℕ => (1 : ℝ)) (fun n : ℕ => (n : ℤ)) L (2 * L / X) := by
  intro F hF h hh
  refine (Elem.uavg_shift_le X F hF h).trans ?_
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg X)
  have h1 : (h.natAbs : ℝ) ≤ L := by exact_mod_cast hh
  have : |(h : ℝ)| ≤ L := by
    rw [← Int.cast_abs, Int.abs_eq_natAbs, Int.cast_natCast]; exact h1
  linarith

lemma wE_sum3_div (I : Finset ι) (w : ι → ℝ) (e : ι → ℤ) (T : ℕ) (S : Finset ℤ)
    (G : ℤ → ℕ → ℕ → ℤ → ℝ) (c : ℝ) :
    wE I w e (fun n => (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, G n t t' s) / c) =
      (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, wE I w e (fun n => G n t t' s)) / c := by
  unfold wE
  simp only [div_eq_inv_mul]
  simp only [wavg_smul, wavg_sum]

/-- `A(m) = E_{t,t' ∈ [T]} E_{s ∈ S} f(m + (t - t') s)`. -/
noncomputable def aAvg (f : ℤ → ℝ) (S : Finset ℤ) (T : ℕ) (m : ℤ) : ℝ :=
  (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, f (m + ((t : ℤ) - t') * s)) / (T * T * S.card)

lemma abs_aAvg_le (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (S : Finset ℤ) (T : ℕ) (m : ℤ) :
    |aAvg f S T m| ≤ 1 :=
  abs_avg3_le_one T S _ fun _ _ _ => hf _

/-- Step 1 (shift by `t' s`): `E E_{t,t',s} f(n+ts) f(n+t's) ≤ E f(n) A(n) + ε`. -/
lemma step_shift {I : Finset ι} {w : ι → ℝ} (e : ι → ℤ) {L : ℕ} {ε : ℝ}
    (hsh : ShiftBound I w e L ε) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) {S : Finset ℤ}
    (hS : S.Nonempty) {T : ℕ} (hT : 1 ≤ T)
    (hL : ∀ t ∈ Icc 1 T, ∀ s ∈ S, ((t : ℤ) * s).natAbs ≤ L) :
    wE I w e (fun n => (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
        f (n + t * s) * f (n + t' * s)) / (T * T * S.card)) ≤
      wE I w e (fun n => f n * aAvg f S T n) + ε := by
  have e1 : (fun n => f n * aAvg f S T n) = fun n => (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
      f (n + ((t : ℤ) - t') * s) * f n) / (T * T * S.card) := by
    funext n
    unfold aAvg
    rw [mul_div_assoc', Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun t' _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun s _ => by ring
  rw [e1, wE_sum3_div, wE_sum3_div]
  have hterm : ∀ t ∈ Icc 1 T, ∀ t' ∈ Icc 1 T, ∀ s ∈ S,
      wE I w e (fun n => f (n + t * s) * f (n + t' * s)) ≤
        wE I w e (fun n => f (n + ((t : ℤ) - t') * s) * f n) + ε := by
    intro t _ t' ht' s hs
    have hΦ : ∀ m, |f (m + ((t : ℤ) - t') * s) * f m| ≤ 1 := fun m =>
      Elem.abs_mul_le_one (hf _) (hf _)
    have key := hsh (fun m => f (m + ((t : ℤ) - t') * s) * f m) hΦ ((t' : ℤ) * s) (hL t' ht' s hs)
    have e : (fun n : ℤ => (fun m => f (m + ((t : ℤ) - t') * s) * f m) (n + t' * s)) =
        fun n => f (n + t * s) * f (n + t' * s) := by
      funext n
      simp only
      rw [show n + (t' : ℤ) * s + ((t : ℤ) - t') * s = n + t * s by ring]
    rw [e] at key
    have := (abs_le.mp key).2
    linarith
  have hsum : ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
        wE I w e (fun n => f (n + t * s) * f (n + t' * s)) ≤
      ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
        (wE I w e (fun n => f (n + ((t : ℤ) - t') * s) * f n) + ε) :=
    Finset.sum_le_sum fun t ht => Finset.sum_le_sum fun t' ht' =>
      Finset.sum_le_sum fun s hs => hterm t ht t' ht' s hs
  have hsplit : ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
        (wE I w e (fun n => f (n + ((t : ℤ) - t') * s) * f n) + ε) =
      ∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S,
        wE I w e (fun n => f (n + ((t : ℤ) - t') * s) * f n) + T * T * S.card * ε := by
    simp only [Finset.sum_add_distrib, Finset.sum_const, Nat.card_Icc, nsmul_eq_mul]
    push_cast; ring
  have hTR : (1 : ℝ) ≤ T := by exact_mod_cast hT
  have hScard : (0 : ℝ) < S.card := by exact_mod_cast hS.card_pos
  have hden : (0 : ℝ) < T * T * S.card := by positivity
  rw [hsplit] at hsum
  have := div_le_div_of_nonneg_right hsum hden.le
  rw [add_div, mul_div_cancel_left₀ _ hden.ne'] at this
  exact this

/-- Step 2 (Cauchy–Schwarz): `(E f g)² ≤ E g²` for 1-bounded `f`. -/
lemma step_cs {I : Finset ι} {w : ι → ℝ} (hw : GoodWeights I w) (e : ι → ℤ) (f g : ℤ → ℝ)
    (hf : ∀ n, |f n| ≤ 1) :
    (wE I w e (fun n => f n * g n)) ^ 2 ≤ wE I w e (fun n => g n ^ 2) := by
  have cs := wavg_mul_sq_le hw (fun i => f (e i)) (fun i => g (e i))
  have hf2 : wavg I w (fun i => f (e i) ^ 2) ≤ 1 :=
    wavg_le_of_le hw fun i _ => by
      have := hf (e i); rw [← sq_abs]; nlinarith [abs_nonneg (f (e i))]
  have hg20 : 0 ≤ wavg I w (fun i => g (e i) ^ 2) := wavg_nonneg hw fun i _ => sq_nonneg _
  unfold wE
  have := mul_le_of_le_one_left hg20 hf2
  linarith

/-- Step 3 (shift by `h ∈ [K]`, averaged). -/
lemma step_smooth {I : Finset ι} {w : ι → ℝ} (e : ι → ℤ) {L : ℕ} {ε : ℝ}
    (hsh : ShiftBound I w e L ε) (A : ℤ → ℝ) (hA : ∀ m, |A m| ≤ 1) {K : ℕ} (hK : 1 ≤ K)
    (hKL : K ≤ L) :
    wE I w e (fun n => A n ^ 2) - ε ≤ wE I w e (fun n => uavg K (fun h => A (n + h) ^ 2)) := by
  have hA2 : ∀ m, |A m ^ 2| ≤ 1 := fun m => by
    rw [abs_pow]; exact pow_le_one₀ (abs_nonneg _) (hA m)
  have e1 : wE I w e (fun n => uavg K (fun h => A (n + h) ^ 2)) =
      uavg K (fun h => wE I w e (fun n => A (n + h) ^ 2)) := by
    unfold wE uavg; exact Elem.wavg_comm _ _ _ _ _
  have e2 : wE I w e (fun n => A n ^ 2) = uavg K (fun _ => wE I w e (fun n => A n ^ 2)) :=
    (wavg_const (goodWeights_uavg hK) _).symm
  have key : |uavg K (fun h => wE I w e (fun n => A (n + h) ^ 2)) -
      uavg K (fun _ => wE I w e (fun n => A n ^ 2))| ≤ ε := by
    refine Elem.abs_wavg_sub_le (goodWeights_uavg hK) fun h hh => ?_
    have hhK := (Finset.mem_Icc.mp hh).2
    exact hsh (fun m => A m ^ 2) hA2 h (by rw [Int.natAbs_natCast]; omega)
  have := (abs_le.mp key).1
  linarith

/-- Step 4 (shift by `j - c` to drop the `m`-average). -/
lemma step_U {I : Finset ι} {w : ι → ℝ} (e : ι → ℤ) {L : ℕ} {ε : ℝ}
    (hsh : ShiftBound I w e L ε) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) {H : ℕ} (hH : 1 ≤ H)
    (q j c : ℕ) (hj : j ≤ L) (hc : c ≤ L) :
    wE I w e (fun n => (uavg H (fun h => f (n - c + j + q * h))) ^ 2) ≤
      wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) + ε := by
  have hΦ : ∀ m : ℤ, |(uavg H (fun h => f (m + q * h))) ^ 2| ≤ 1 := fun m => by
    have h1 : |uavg H (fun h => f (m + q * h))| ≤ 1 :=
      abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun _ _ => hf _
    rw [abs_pow]; exact pow_le_one₀ (abs_nonneg _) h1
  have hK : ((j : ℤ) - c).natAbs ≤ L := by
    have : |((j : ℤ) - c)| ≤ L := abs_le.mpr ⟨by omega, by omega⟩
    rw [Int.abs_eq_natAbs] at this
    exact_mod_cast this
  have key := hsh (fun m => (uavg H (fun h => f (m + q * h))) ^ 2) hΦ ((j : ℤ) - c) hK
  have e : (fun n : ℤ => (fun m => (uavg H (fun h => f (m + q * h))) ^ 2) (n + ((j : ℤ) - c))) =
      fun n => (uavg H (fun h => f (n - c + j + q * h))) ^ 2 := by
    funext n
    simp only
    congr 2
    funext h
    congr 1
    ring
  rw [e] at key
  have := (abs_le.mp key).2
  linarith

/-- Averaging a pointwise inequality of the shape produced by `pointwise_bound`. -/
lemma step_average {I : Finset ι} {w : ι → ℝ} (hw : GoodWeights I w) (e : ι → ℤ) (B : ℤ → ℝ)
    (V : ℕ → ℕ → ℤ → ℝ) (K α : ℝ) (Q P H : ℕ)
    (hpt : ∀ n, K * B n ≤ α + 4 * ∑ q ∈ Icc 1 Q, (∑ j ∈ range P, V q j n + q * H)) :
    K * wE I w e B ≤
      α + 4 * ∑ q ∈ Icc 1 Q, (∑ j ∈ range P, wE I w e (V q j) + q * H) := by
  have h1 : wE I w e (fun n => K * B n) ≤
      wE I w e (fun n => α + 4 * ∑ q ∈ Icc 1 Q, (∑ j ∈ range P, V q j n + q * H)) :=
    wavg_mono hw fun i _ => hpt (e i)
  have e1 : wE I w e (fun n => K * B n) = K * wE I w e B := wavg_smul _ _
  have e2 : wE I w e (fun n => α + 4 * ∑ q ∈ Icc 1 Q, (∑ j ∈ range P, V q j n + q * H)) =
      α + 4 * ∑ q ∈ Icc 1 Q, (∑ j ∈ range P, wE I w e (V q j) + q * H) := by
    unfold wE
    rw [wavg_add, wavg_const hw, wavg_smul, wavg_sum]
    congr 2
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [wavg_add, wavg_sum, wavg_const hw]
  rw [e1, e2] at h1
  exact h1

end General

/-- The final numerical bookkeeping (pure real arithmetic). -/
lemma numerics {δ η ε Q₀ Q K P H Sig E1 E3 : ℝ} (hδ1 : δ ≤ 1)
    (hη0 : 0 ≤ η) (hη : η ≤ δ / 10) (hε0 : 0 ≤ ε) (hεle : ε ≤ δ ^ 2 / (320 * Q₀))
    (hQ₀ : 1 ≤ Q₀) (hQ1 : 1 ≤ Q) (hQQ₀ : Q ≤ Q₀) (hPK : P ≤ 10 * K)
    (hKP : 9 * K ≤ P) (hK : 1 ≤ K) (hH : 0 ≤ H) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ ^ 2 * K)
    (hE1 : δ - ε ≤ E1) (hE3 : E1 ^ 2 - ε ≤ E3) (hE3nn : 0 ≤ E3)
    (hmain : K * E3 ≤ η ^ 2 * P + 4 * (P * Sig + Q * (P * ε + Q * H))) :
    δ ^ 2 / 100 ≤ Sig := by
  have hPpos : 0 < P := by linarith
  have hεδ : ε ≤ δ ^ 2 / 320 := by
    refine hεle.trans ?_
    exact div_le_div_of_nonneg_left (sq_nonneg _) (by norm_num) (by linarith)
  have hδε : 0 ≤ δ - ε := by nlinarith
  have hE1' : (δ - ε) ^ 2 ≤ E1 ^ 2 := pow_le_pow_left₀ hδε hE1 2
  have hE3' : δ ^ 2 - 3 * ε ≤ E3 := by nlinarith
  have hQ2 : Q ^ 2 ≤ Q₀ ^ 2 := pow_le_pow_left₀ (by linarith) hQQ₀ 2
  have hQH : Q ^ 2 * H ≤ δ ^ 2 * P / 180 := by
    have h1 : Q ^ 2 * H ≤ Q₀ ^ 2 * H := mul_le_mul_of_nonneg_right hQ2 hH
    have h3 : δ ^ 2 * K / 20 ≤ δ ^ 2 * P / 180 := by
      have := mul_le_mul_of_nonneg_left hKP (sq_nonneg δ)
      linarith
    linarith
  have hQε : Q * ε ≤ δ ^ 2 / 320 := by
    calc Q * ε ≤ Q₀ * (δ ^ 2 / (320 * Q₀)) := mul_le_mul hQQ₀ hεle hε0 (by linarith)
      _ = δ ^ 2 / 320 := by field_simp
  have hη2 : η ^ 2 ≤ δ ^ 2 / 100 := by nlinarith
  have h10 : P * E3 ≤ 10 * (η ^ 2 * P + 4 * (P * Sig + Q * (P * ε + Q * H))) := by
    have := mul_le_mul_of_nonneg_right hPK hE3nn
    linarith
  have hA : P * (δ ^ 2 - 3 * ε) ≤ P * E3 := mul_le_mul_of_nonneg_left hE3' hPpos.le
  have hB : η ^ 2 * P ≤ δ ^ 2 / 100 * P := mul_le_mul_of_nonneg_right hη2 hPpos.le
  have hC : P * (Q * ε) ≤ P * (δ ^ 2 / 320) := mul_le_mul_of_nonneg_left hQε hPpos.le
  have h1 : P * (δ ^ 2 - 3 * ε) ≤ P * (δ ^ 2 / 10 + 40 * Sig + δ ^ 2 / 8 + 2 * δ ^ 2 / 9) := by
    have e : 10 * (η ^ 2 * P + 4 * (P * Sig + Q * (P * ε + Q * H))) =
        10 * (η ^ 2 * P) + 40 * (P * Sig) + 40 * (P * (Q * ε)) + 40 * (Q ^ 2 * H) := by ring
    have e2 : P * (δ ^ 2 / 10 + 40 * Sig + δ ^ 2 / 8 + 2 * δ ^ 2 / 9) =
        10 * (δ ^ 2 / 100 * P) + 40 * (P * Sig) + 40 * (P * (δ ^ 2 / 320)) +
          40 * (δ ^ 2 * P / 180) := by ring
    rw [e2]
    linarith
  have h2 := le_of_mul_le_mul_left h1 hPpos
  nlinarith [sq_nonneg δ]

/- ### The core statement for a general average -/

/-- The hypothesis `FPDProp` at `θ = 0` forces `Q₀ ≥ 1` (as `Φ_T(0) = 1`). -/
lemma one_le_of_FPDProp {S : Finset ℤ} (hS : S.Nonempty) {T D : ℕ} (hT : 1 ≤ T)
    {η Q₀ W : ℝ} (hη : η ≤ 1) (hFPD : FPDProp S T D η Q₀ W) : 1 ≤ Q₀ := by
  have hScard : (0 : ℝ) < S.card := by exact_mod_cast hS.card_pos
  have h0 : η ≤ (∑ s ∈ S, fejer T ((0 : ℝ) * s)) / S.card := by
    simp only [zero_mul, fejer_zero hT, Finset.sum_const, nsmul_eq_mul, mul_one]
    rw [div_self hScard.ne']; exact hη
  obtain ⟨q, hq1, hqQ, -⟩ := hFPD 0 h0
  have : (1 : ℝ) ≤ q := by exact_mod_cast hq1
  linarith

/-- The correlation average is at most `1`. -/
lemma corr_le_one {ι : Type*} {I : Finset ι} {w : ι → ℝ} (hw : GoodWeights I w) (e : ι → ℤ)
    {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (S : Finset ℤ) (T : ℕ) :
    wE I w e (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card))) ≤ 1 := by
  refine wavg_le_of_le hw fun i _ => ?_
  dsimp only
  rw [avg3_eq]
  exact (le_abs_self _).trans (abs_avg3_le_one T S _ fun t t' s =>
    Elem.abs_mul_le_one (hf _) (hf _))

/-- A positive correlation average forces `T ≥ 1`. -/
lemma one_le_T_of_corr {ι : Type*} {I : Finset ι} {w : ι → ℝ} (e : ι → ℤ) (f : ℤ → ℝ)
    (S : Finset ℤ) (T : ℕ) {δ : ℝ} (hδ : 0 < δ)
    (hcorr : δ ≤ wE I w e (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card)))) : 1 ≤ T := by
  rcases Nat.eq_zero_or_pos T with h0 | h0
  · exfalso; subst h0; simp [wE, wavg, uavg] at hcorr; linarith
  · exact h0

/-- **GS Lemma 2.4/2.5 (FPD form) for a general finite weighted average** `E = wE I w e`
(positive weights, nonempty support) whose shift error for shifts `|h| ≤ 10TD` is `ε`. -/
theorem lemma24_core {ι : Type*} {I : Finset ι} {w : ι → ℝ} (hw : GoodWeights I w)
    (e : ι → ℤ) {S : Finset ℤ} (hS : S.Nonempty) {T D H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (D : ℤ)) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1)
    (hH : 1 ≤ H) {δ η Q₀ W ε : ℝ} (hδ : 0 < δ) (hη0 : 0 ≤ η) (hη : η ≤ δ / 10)
    (hFPD : FPDProp S T D η Q₀ W)
    (hsh : ShiftBound I w e (10 * T * D) ε) (hε : ε ≤ δ ^ 2 / (320 * Q₀))
    (hHW : 16 * H * W ≤ T * D) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ ^ 2 * (T * D))
    (hcorr : δ ≤ wE I w e (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card)))) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧
      δ ^ 2 / (100 * Q₀) ≤ wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) := by
  classical
  have hHR : (1 : ℝ) ≤ H := by exact_mod_cast hH
  have hT : 1 ≤ T := one_le_T_of_corr e f S T hδ hcorr
  have hδ1 : δ ≤ 1 := hcorr.trans (corr_le_one hw e hf S T)
  have hQ₀ : 1 ≤ Q₀ := one_le_of_FPDProp hS hT (by linarith) hFPD
  -- `ε ≥ 0` (shift by `0`)
  have hε0 : 0 ≤ ε := by
    have := hsh (fun _ => 0) (fun _ => by simp) 0 (by simp)
    exact (abs_nonneg _).trans this
  have ecorr : (fun n : ℤ => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card))) = fun n =>
      (∑ t ∈ Icc 1 T, ∑ t' ∈ Icc 1 T, ∑ s ∈ S, f (n + t * s) * f (n + t' * s)) /
        (T * T * S.card) := by
    funext n; exact avg3_eq T S _
  rw [ecorr] at hcorr
  -- `D ≥ 1`
  have hD : 1 ≤ D := by
    rcases Nat.eq_zero_or_pos D with h0 | h0
    · exfalso; subst h0
      rw [Nat.cast_zero, mul_zero, mul_zero] at hHQ
      have : 1 ≤ Q₀ ^ 2 := by nlinarith
      nlinarith
    · exact h0
  -- parameters `K = TD`, `c = 4K`, `P = 9K + 1`, `Q = ⌊Q₀⌋`, `L = 10K`
  set K : ℕ := T * D with hKdef
  have hK1 : 1 ≤ K := Nat.mul_pos hT hD
  have hKR : (K : ℝ) = T * D := by rw [hKdef]; push_cast; ring
  have hL : 10 * T * D = 10 * K := by rw [hKdef]; ring
  rw [hL] at hsh
  set c : ℕ := 4 * K with hcdef
  set P : ℕ := 9 * K + 1 with hPdef
  set Q : ℕ := ⌊Q₀⌋₊ with hQdef
  have hQ1 : 1 ≤ Q := Nat.le_floor (by exact_mod_cast hQ₀)
  have hQQ₀ : (Q : ℝ) ≤ Q₀ := Nat.floor_le (by linarith)
  have hPR : (P : ℝ) = 9 * K + 1 := by rw [hPdef]; push_cast; ring
  -- the shifts `(t - t') s` are at most `c = 4TD`
  have hsD : ∀ s ∈ S, s.natAbs ≤ 4 * D := by
    intro s hs
    have := hSD s hs
    rw [Int.abs_eq_natAbs] at this
    omega
  have hsmall : ∀ t ∈ Icc 1 T, ∀ t' ∈ Icc 1 T, ∀ s ∈ S, |((t : ℤ) - t') * s| ≤ c := by
    intro t ht t' ht' s hs
    have h1 := Finset.mem_Icc.mp ht
    have h2 := Finset.mem_Icc.mp ht'
    have htt : |((t : ℤ) - t')| ≤ T := by rw [abs_le]; constructor <;> omega
    rw [abs_mul]
    calc |((t : ℤ) - t')| * |s| ≤ T * (4 * D) :=
          mul_le_mul htt (hSD s hs) (abs_nonneg _) (by positivity)
      _ = c := by rw [hcdef, hKdef]; push_cast; ring
  have hP : K + 2 * c < P := by omega
  have hshift : ∀ t ∈ Icc 1 T, ∀ s ∈ S, ((t : ℤ) * s).natAbs ≤ 10 * K := by
    intro t ht s hs
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    have := hsD s hs
    have := (Finset.mem_Icc.mp ht).2
    calc t * s.natAbs ≤ T * (4 * D) := Nat.mul_le_mul (by omega) (by omega)
      _ ≤ 10 * K := by rw [hKdef]; ring_nf; omega
  -- the major-arc hypothesis in the form used by `key_fourier`
  have hmaj : ∀ k : ZMod P, η ≤ (∑ s ∈ S, fejer T ((k.val : ℝ) / P * s)) / S.card →
      ∃ q ∈ Icc 1 Q, 1 / 4 ≤ fejer H (q * ((k.val : ℝ) / P)) := by
    intro k hk
    obtain ⟨q, hq1, hqQ, hqd⟩ := hFPD _ hk
    refine ⟨q, Finset.mem_Icc.mpr ⟨hq1, Nat.le_floor hqQ⟩, fejer_ge_quarter hH ?_⟩
    refine hqd.trans ?_
    have hTD : (0 : ℝ) < T * D := by
      have : (1 : ℝ) ≤ T := by exact_mod_cast hT
      have : (1 : ℝ) ≤ D := by exact_mod_cast hD
      positivity
    rw [div_le_div_iff₀ hTD (by positivity)]
    linarith
  -- the pointwise inequality, averaged
  have hpt : ∀ n : ℤ, (K : ℝ) * uavg K (fun h => aAvg f S T (n + h) ^ 2) ≤
      η ^ 2 * P + 4 * ∑ q ∈ Icc 1 Q,
        (∑ j ∈ range P, (uavg H (fun h => f (n - c + j + q * h))) ^ 2 + q * H) := by
    intro n
    rw [uavg_eq_sum_div, mul_div_cancel₀ _ (by positivity : (K : ℝ) ≠ 0)]
    exact pointwise_bound f hf hS T H Q c K η hsmall hP hmaj n
  have hlin := step_average hw e (fun n => uavg K (fun h => aAvg f S T (n + h) ^ 2))
    (fun q j n => (uavg H (fun h => f (n - c + j + q * h))) ^ 2) K (η ^ 2 * P) Q P H hpt
  -- Steps 1–3
  have hE1 := step_shift e hsh f hf hS hT hshift
  have hE2 := step_cs hw e f (aAvg f S T) hf
  have hE3 := step_smooth e hsh (aAvg f S T) (abs_aAvg_le f hf S T) hK1 (by omega)
  -- Step 4
  set Sig : ℝ := ∑ q ∈ Icc 1 Q, wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2)
    with hSigdef
  have hsumU : ∑ q ∈ Icc 1 Q, (∑ j ∈ range P,
        wE I w e (fun n => (uavg H (fun h => f (n - c + j + q * h))) ^ 2) + q * H) ≤
      P * Sig + Q * (P * ε + Q * H) := by
    calc ∑ q ∈ Icc 1 Q, (∑ j ∈ range P,
          wE I w e (fun n => (uavg H (fun h => f (n - c + j + q * h))) ^ 2) + q * H)
        ≤ ∑ q ∈ Icc 1 Q, (P * (wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) + ε) +
            Q * H) := by
          refine Finset.sum_le_sum fun q hq => add_le_add ?_ ?_
          · calc ∑ j ∈ range P,
                  wE I w e (fun n => (uavg H (fun h => f (n - c + j + q * h))) ^ 2)
                ≤ ∑ j ∈ range P,
                    (wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) + ε) :=
                  Finset.sum_le_sum fun j hj => step_U e hsh f hf hH q j c
                    (by have := Finset.mem_range.mp hj; omega) (by omega)
              _ = P * (wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) + ε) := by
                  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          · have : (q : ℝ) ≤ Q := by exact_mod_cast (Finset.mem_Icc.mp hq).2
            exact mul_le_mul_of_nonneg_right this (by positivity)
      _ = P * Sig + Q * (P * ε + Q * H) := by
          simp only [mul_add, Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
            Nat.card_Icc, Nat.add_sub_cancel, nsmul_eq_mul]
          ring
  have hE3nn : 0 ≤ wE I w e (fun n => uavg K (fun h => aAvg f S T (n + h) ^ 2)) :=
    wavg_nonneg hw fun i _ => wavg_nonneg (goodWeights_uavg hK1) fun h _ => sq_nonneg _
  have hSig : δ ^ 2 / 100 ≤ Sig := by
    have hK1R : (1 : ℝ) ≤ K := by exact_mod_cast hK1
    refine numerics (Q := (Q : ℝ)) (K := (K : ℝ)) (P := (P : ℝ)) (H := (H : ℝ))
      (E1 := wE I w e (fun n => f n * aAvg f S T n)) hδ1 hη0 hη hε0 hε hQ₀
      (by exact_mod_cast hQ1) hQQ₀ (by rw [hPR]; linarith) (by rw [hPR]; linarith) hK1R
      (by positivity) (by rw [hKR]; linarith) (by linarith) (by linarith) hE3nn ?_
    linarith [hlin, hsumU]
  -- pigeonhole in `q`
  have hne : (Icc 1 Q).Nonempty := Finset.nonempty_Icc.mpr hQ1
  have hQpos : (0 : ℝ) < Q := by exact_mod_cast hQ1
  have hconst : ∑ q ∈ Icc 1 Q, δ ^ 2 / (100 * Q) ≤
      ∑ q ∈ Icc 1 Q, wE I w e (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) := by
    rw [Finset.sum_const, Nat.card_Icc, Nat.add_sub_cancel, nsmul_eq_mul]
    have : (Q : ℝ) * (δ ^ 2 / (100 * Q)) = δ ^ 2 / 100 := by field_simp
    rw [this]; exact hSig
  obtain ⟨q, hq, hqU⟩ := Finset.exists_le_of_sum_le hne hconst
  have hq' := Finset.mem_Icc.mp hq
  refine ⟨q, hq'.1, ?_, ?_⟩
  · have : (q : ℝ) ≤ Q := by exact_mod_cast hq'.2
    linarith
  · refine le_trans ?_ hqU
    exact div_le_div_of_nonneg_left (sq_nonneg _) (by positivity) (by linarith)

/- ### GS Lemma 2.4* (logarithmic averages) -/

/-- **GS Lemma 2.4 (FPD form), general threshold `η ≤ δ/10`.** -/
theorem lemma24_gen {S : Finset ℤ} (hS : S.Nonempty) {T D N H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (D : ℤ)) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (hN : 2 ≤ N)
    (hH : 1 ≤ H) {δ η Q₀ W : ℝ} (hδ : 0 < δ) (hη0 : 0 ≤ η) (hη : η ≤ δ / 10)
    (hFPD : FPDProp S T D η Q₀ W)
    (hlog : (1 + Real.log (10 * T * D)) / Real.log N ≤ δ ^ 2 / (640 * Q₀))
    (hHW : 16 * H * W ≤ T * D) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ ^ 2 * (T * D))
    (hcorr : δ ≤ logAvg N (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card)))) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧ δ ^ 2 / (100 * Q₀) ≤ U1logSq N q H f := by
  have hε : 2 * (1 + Real.log ((10 * T * D : ℕ) : ℝ)) / Real.log N ≤ δ ^ 2 / (320 * Q₀) := by
    push_cast
    have h2 : 2 * (1 + Real.log (10 * T * D)) / Real.log N =
        2 * ((1 + Real.log (10 * T * D)) / Real.log N) := by ring
    have h3 : 2 * (δ ^ 2 / (640 * Q₀)) = δ ^ 2 / (320 * Q₀) := by ring
    rw [h2, ← h3]
    linarith
  exact lemma24_core (goodWeights_logAvg (show 1 ≤ N by omega)) (fun n : ℕ => (n : ℤ)) hS hSD hf
    hH hδ hη0 hη hFPD (shiftBound_logAvg N hN _) hε hHW hHQ hcorr

/-- **GS Lemma 2.4 (FPD form)**, with the threshold `c₁ δ²`, `c₁ = 1/10`. -/
theorem lemma24 {S : Finset ℤ} (hS : S.Nonempty) {T D N H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (D : ℤ)) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (hN : 2 ≤ N)
    (hH : 1 ≤ H) {δ Q₀ W : ℝ} (hδ : 0 < δ)
    (hFPD : FPDProp S T D (δ ^ 2 / 10) Q₀ W)
    (hlog : (1 + Real.log (10 * T * D)) / Real.log N ≤ δ ^ 2 / (640 * Q₀))
    (hHW : 16 * H * W ≤ T * D) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ ^ 2 * (T * D))
    (hcorr : δ ≤ logAvg N (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card)))) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧ δ ^ 2 / (100 * Q₀) ≤ U1logSq N q H f := by
  have hδ1 : δ ≤ 1 :=
    hcorr.trans (corr_le_one (goodWeights_logAvg (show 1 ≤ N by omega)) _ hf S T)
  refine lemma24_gen hS hSD hf hN hH hδ (by positivity) ?_ hFPD hlog hHW hHQ hcorr
  nlinarith

/- ### GS Lemma 2.5* (uniform averages over `[X]`) -/

/-- **GS Lemma 2.5 (FPD form), general threshold `η ≤ δ/10`**: the uniform-average version,
`E_{n ∈ [X]}` in place of `E^log_{n ∈ [N]}`, with `TD ≤ δ² X / (6400 Q₀)` in place of the
condition on `log(TD)/log N`. -/
theorem lemma25_gen {S : Finset ℤ} (hS : S.Nonempty) {T D X H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (D : ℤ)) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (hX : 1 ≤ X)
    (hH : 1 ≤ H) {δ η Q₀ W : ℝ} (hδ : 0 < δ) (hη0 : 0 ≤ η) (hη : η ≤ δ / 10)
    (hFPD : FPDProp S T D η Q₀ W)
    (hTDX : 6400 * Q₀ * (T * D) ≤ δ ^ 2 * X)
    (hHW : 16 * H * W ≤ T * D) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ ^ 2 * (T * D))
    (hcorr : δ ≤ uavg X (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card)))) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧
      δ ^ 2 / (100 * Q₀) ≤ uavg X (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) := by
  have hXR : (0 : ℝ) < X := by exact_mod_cast hX
  have hδ1 : δ ≤ 1 := hcorr.trans (corr_le_one (goodWeights_uavg hX) _ hf S T)
  have hT : 1 ≤ T := one_le_T_of_corr (fun n : ℕ => (n : ℤ)) f S T hδ hcorr
  have hQ₀ : 1 ≤ Q₀ := one_le_of_FPDProp hS hT (by linarith) hFPD
  have hε : 2 * ((10 * T * D : ℕ) : ℝ) / X ≤ δ ^ 2 / (320 * Q₀) := by
    rw [div_le_div_iff₀ hXR (by positivity)]
    push_cast
    linarith
  exact lemma24_core (goodWeights_uavg hX) (fun n : ℕ => (n : ℤ)) hS hSD hf
    hH hδ hη0 hη hFPD (shiftBound_uavg X _) hε hHW hHQ hcorr

/-- **GS Lemma 2.5 (FPD form)**, with the threshold `c₁ δ²`, `c₁ = 1/10`. -/
theorem lemma25 {S : Finset ℤ} (hS : S.Nonempty) {T D X H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (D : ℤ)) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (hX : 1 ≤ X)
    (hH : 1 ≤ H) {δ Q₀ W : ℝ} (hδ : 0 < δ)
    (hFPD : FPDProp S T D (δ ^ 2 / 10) Q₀ W)
    (hTDX : 6400 * Q₀ * (T * D) ≤ δ ^ 2 * X)
    (hHW : 16 * H * W ≤ T * D) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ ^ 2 * (T * D))
    (hcorr : δ ≤ uavg X (fun n => uavg T (fun t => uavg T (fun t' =>
      (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card)))) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧
      δ ^ 2 / (100 * Q₀) ≤ uavg X (fun n => (uavg H (fun h => f (n + q * h))) ^ 2) := by
  have hδ1 : δ ≤ 1 := hcorr.trans (corr_le_one (goodWeights_uavg hX) _ hf S T)
  refine lemma25_gen hS hSD hf hX hH hδ (by positivity) ?_ hFPD hTDX hHW hHQ hcorr
  nlinarith

end G22.L24

end

/- ## Section: `FPDQ` -/

section

/-
# FPD toolkit: Lemmas C, Q, R, Sel, PH, M54

Formalisation of §9.1–9.2 of `notes/prop51_elementary_route_review.md` (the reviewed blueprint of
the elementary route to GS Proposition 5.1; GS = Green–Sawhney, arXiv:2511.09365v2), with the
Brun–Titchmarsh input `BTWith` and Mertens' lower bound `MertensLowerWith` as explicit hypotheses.

* `FPDProp`: a local copy of the FPD property, syntactically identical to the one in
  `Lemma24.lean` (so the two are definitionally equal).
* **Lemma C** (`lemmaC_injOn`, `card_boxProd`, `lemmaC_coll`): for pairwise disjoint sets of primes
  `P i`, the product map on the box is injective and the box `S` has at most
  `(∑ᵢ 1/|P i|) |S|²` non-coprime ordered pairs.
* Arithmetic: the divisor lemma `exists_dvd_Ioc`; the pointwise bound
  `(τ(n) 4^{ω(n)})⁴ ≤ 2^{57344} n` (`tau_mul_four_pow_omega_pow_le`) and the **Rankin-type bound**
  `rankin_sum : ∑_{V < d ≤ D} (τ(d) 4^{ω(d)} / d)² ≤ C_R / √V` with `C_R = 2^{28673}` (`CR_eq`).
* **Lemma Q** (`QHyp`, `lemmaQ`, `lemmaQ_FPD`), and `lemmaL_box_FPD` (Lemma C + `FPD.lemmaL`).
* **Lemma R** (`BTWith`, `lemmaR`): a box with one `ε`-rich factor satisfies (Q0)–(Q4);
  `lemmaRQ_FPD` chains Lemma R into Lemma Q (the (5.10) analysis) in `FPDProp` form.
* **Lemma Sel** (`sum_pieces`, `lemmaSel_i`, `lemmaSel_ii`, `lemmaSel_iii`, `lemmaSel_iv`).
* **Lemma PH** (`lemmaPH`, `lemmaPH_nonneg`, `prod_weight_bad`, `prod_weight_bad_pair`).
* **Lemma M54** (`lemmaM54B`: Mertens-weighted dyadic pigeonhole; `lemmaM54A`: Chebyshev,
  `P₂ ≥ 4P₁`, which is the hypothesis now in `Prop51With`).

## Deviations from the review

* (BT) is stated in the form requested for the Selberg-majorant route:
  `#{p ∈ [u, u+y) prime, p ≡ b (d)} ≤ C 4^{ω(d)} y / (d log y)` for `d^{10} ≤ y`, `y ≥ y₀`.
  Accordingly (Q2) reads `μ{x ≡ b (d)} ≤ K_res 4^{ω(d)} / d`, and the Rankin sum is
  `∑_{d>V} (τ(d) 4^{ω(d)}/d)²` (the square roots of `x² mod d` are counted as `≤ 2τ(d)` via
  `d = d₁d₂`, `d₁ ∣ x - y`, `d₂ ∣ x + y`, `gcd(d₁, d₂) ∣ 2`, instead of `|R_d| ≤ 2^{ω(d)+1}`).
* (Q5) is `4ρK_int + κ + 4C_R K_res²/√V₀ + 2β log(4Y²)/log d₀ < η³/8` (review: `η³/16`).
* (Q6) `4ρY² > V₀` is not needed: `gcd(A, B) ≤ V₀` follows from the good-triple conditions and the
  pair lemma `FPD.near_int_pair` allows `B = 0`. The side conditions `ρ ≤ 1/4`, `η ≤ 1`,
  `K ≥ 1`, `Y ≥ 2` are not needed either; `V₀ ≥ 1`, `V₀² ≤ d₀`, `d₀ ≥ 2` are used.
* Lemma R uses integer endpoints `I_i = [lo i, hi i)`; the conditions `d₀ ≤ M^{1/4}`,
  `η ≥ M^{-1/4}`, `ρ ≥ M^{-1/4}` become `d₀^{10} ≤ y` (BT range), `M³ ≤ y⁴`, `ρ⁴M ≥ 1`, plus
  `y₀ ≤ y`, `y₀ ≤ 2ρM` (BT threshold), `M ≥ 2`, `d₀ < lo i` (all primes exceed `d₀`), `d₀ ≥ 1`,
  `4k(hi i - lo i) ≤ lo i` and `M ≤ 8k(hi i₀ - lo i₀)` (with `y = hi i₀ - lo i₀`, `M = lo i₀`).
  The constants are the review's: `K_res = 8C/ε`, `K_int = 64Ck/ε`, `β = 8 log M/(ε d₀)`.
* Lemma Sel (iv) is stated for integer endpoints `3 ≤ A < B ≤ 2A`: `#P ≥ ε(B - A)/(4 log A)`;
  Sel (iii) assumes `(8k+1) a_i ≤ 8k a_{i+1}`.
* Lemma M54 B has the constant `α/2` (review: `α/16`); version A has `α/1000` and needs
  `P₁ ≥ 2^{24}`.
-/

set_option autoImplicit false

open Finset Real

namespace G22.FPDQ

section FPDDef

/-- Local copy of `FPDProp` (identical to the one in `Lemma24.lean`). -/
def FPDProp (S : Finset ℤ) (T D : ℕ) (η Q₀ W : ℝ) : Prop :=
  ∀ θ : ℝ, η ≤ (∑ s ∈ S, FPD.fejer T (θ * s)) / S.card →
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧ FPD.dnear (q * θ) ≤ W / ((T : ℝ) * D)

/-- Rescaling the `D` of an FPD property. -/
lemma FPDProp.of_mul {S : Finset ℤ} {T D a : ℕ} {η Q₀ W : ℝ}
    (h : FPDProp S T (a * D) η Q₀ W) : FPDProp S T D η Q₀ (W / a) := by
  intro θ hθ
  obtain ⟨q, hq1, hqQ, hqd⟩ := h θ hθ
  refine ⟨q, hq1, hqQ, ?_⟩
  calc FPD.dnear (q * θ) ≤ W / ((T : ℝ) * ((a * D : ℕ) : ℝ)) := hqd
    _ = W / a / ((T : ℝ) * D) := by push_cast; rw [div_div]; ring_nf

end FPDDef

section LemmaC

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The box `{∏ᵢ pᵢ : pᵢ ∈ P i}` of products. -/
def boxProd (P : ι → Finset ℕ) : Finset ℕ :=
  (Fintype.piFinset P).image (fun f => ∏ i, f i)

variable {P : ι → Finset ℕ}

omit [Fintype ι] in
lemma mem_of_mem_of_disj (hdisj : ∀ i j, i ≠ j → Disjoint (P i) (P j)) {i j : ι} {a : ℕ}
    (hi : a ∈ P i) (hj : a ∈ P j) : i = j := by
  by_contra h
  exact Finset.disjoint_left.mp (hdisj i j h) hi hj

lemma prime_dvd_prod_iff (hP : ∀ i, ∀ p ∈ P i, p.Prime) {f : ι → ℕ}
    (hf : f ∈ Fintype.piFinset P) {q : ℕ} (hq : q.Prime) :
    q ∣ ∏ i, f i ↔ ∃ i, q = f i := by
  constructor
  · intro h
    obtain ⟨i, -, hi⟩ := (Prime.dvd_finsetProd_iff hq.prime f).mp h
    have hfi : (f i).Prime := hP i (f i) (Fintype.mem_piFinset.mp hf i)
    exact ⟨i, (Nat.prime_dvd_prime_iff_eq hq hfi).mp hi⟩
  · rintro ⟨i, rfl⟩
    exact Finset.dvd_prod_of_mem f (Finset.mem_univ i)

/-- **Lemma C (i).** The product map on a box of pairwise disjoint prime sets is injective. -/
theorem lemmaC_injOn (hP : ∀ i, ∀ p ∈ P i, p.Prime)
    (hdisj : ∀ i j, i ≠ j → Disjoint (P i) (P j)) :
    Set.InjOn (fun f : ι → ℕ => ∏ i, f i) (Fintype.piFinset P : Set (ι → ℕ)) := by
  intro f hf g hg hfg
  simp only at hfg
  have hf' := Finset.mem_coe.mp hf
  have hg' := Finset.mem_coe.mp hg
  funext i
  have hfi : f i ∈ P i := Fintype.mem_piFinset.mp hf' i
  have hdiv : f i ∣ ∏ j, g j := hfg ▸ Finset.dvd_prod_of_mem f (Finset.mem_univ i)
  obtain ⟨j, hj⟩ := (prime_dvd_prod_iff hP hg' (hP i _ hfi)).mp hdiv
  have hgj : g j ∈ P j := Fintype.mem_piFinset.mp hg' j
  rw [hj] at hfi
  have := mem_of_mem_of_disj hdisj hfi hgj
  subst this
  exact hj

theorem card_boxProd (hP : ∀ i, ∀ p ∈ P i, p.Prime)
    (hdisj : ∀ i j, i ≠ j → Disjoint (P i) (P j)) :
    (boxProd P).card = ∏ i, (P i).card := by
  unfold boxProd
  rw [Finset.card_image_of_injOn (lemmaC_injOn hP hdisj), Fintype.card_piFinset]

lemma exists_eq_of_not_coprime (hP : ∀ i, ∀ p ∈ P i, p.Prime)
    (hdisj : ∀ i j, i ≠ j → Disjoint (P i) (P j)) {f g : ι → ℕ}
    (hf : f ∈ Fintype.piFinset P) (hg : g ∈ Fintype.piFinset P)
    (h : ¬ Nat.Coprime (∏ i, f i) (∏ i, g i)) : ∃ i, f i = g i := by
  obtain ⟨q, hq, hqf, hqg⟩ := Nat.Prime.not_coprime_iff_dvd.mp h
  obtain ⟨i, hi⟩ := (prime_dvd_prod_iff hP hf hq).mp hqf
  obtain ⟨j, hj⟩ := (prime_dvd_prod_iff hP hg hq).mp hqg
  have hfi := Fintype.mem_piFinset.mp hf i
  have hgj := Fintype.mem_piFinset.mp hg j
  rw [← hi, hj] at hfi
  have := mem_of_mem_of_disj hdisj hfi hgj
  subst this
  exact ⟨i, hi.symm.trans hj⟩

/-- Every fibre `{f ∈ box : f i = a}` has `|box| / |P i|` elements. -/
lemma card_fiber_mul (i : ι) {a : ℕ} (ha : a ∈ P i) :
    ((Fintype.piFinset P).filter (fun f => f i = a)).card * (P i).card =
      (Fintype.piFinset P).card := by
  have hset : (Fintype.piFinset P).filter (fun f => f i = a) =
      Fintype.piFinset (Function.update P i {a}) := by
    ext f
    simp only [Finset.mem_filter, Fintype.mem_piFinset]
    constructor
    · rintro ⟨h1, h2⟩ j
      by_cases hj : j = i
      · subst hj; simp [h2]
      · rw [Function.update_of_ne hj]; exact h1 j
    · intro h
      have hi := h i
      simp only [Function.update_self, Finset.mem_singleton] at hi
      refine ⟨fun j => ?_, hi⟩
      by_cases hj : j = i
      · subst hj; rw [hi]; exact ha
      · have := h j; rwa [Function.update_of_ne hj] at this
  rw [hset, Fintype.card_piFinset, Fintype.card_piFinset,
    ← Finset.prod_erase_mul Finset.univ _ (Finset.mem_univ i),
    ← Finset.prod_erase_mul Finset.univ (fun j => (P j).card) (Finset.mem_univ i)]
  simp only [Function.update_self, Finset.card_singleton, mul_one]
  congr 1
  refine Finset.prod_congr rfl fun j hj => ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]

/-- **Lemma C (ii).** Collision count of the box. -/
theorem lemmaC_coll (hP : ∀ i, ∀ p ∈ P i, p.Prime)
    (hdisj : ∀ i j, i ≠ j → Disjoint (P i) (P j)) :
    ((((boxProd P) ×ˢ (boxProd P)).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card : ℝ) ≤
      (∑ i, 1 / ((P i).card : ℝ)) * ((boxProd P).card : ℝ) ^ 2 := by
  set A := Fintype.piFinset P with hA
  have hinj := lemmaC_injOn hP hdisj
  set φ : (ι → ℕ) × (ι → ℕ) → ℕ × ℕ := fun q => (∏ i, q.1 i, ∏ i, q.2 i) with hφ
  have hφinj : Set.InjOn φ ((A ×ˢ A : Finset _) : Set ((ι → ℕ) × (ι → ℕ))) := by
    rintro ⟨f, g⟩ hfg ⟨f', g'⟩ hfg' h
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at hfg hfg'
    simp only [hφ, Prod.mk.injEq] at h
    have e1 := hinj (Finset.mem_coe.mpr hfg.1) (Finset.mem_coe.mpr hfg'.1) h.1
    have e2 := hinj (Finset.mem_coe.mpr hfg.2) (Finset.mem_coe.mpr hfg'.2) h.2
    rw [e1, e2]
  -- the collision set is the image of the collision set of the box
  have himg : ((boxProd P) ×ˢ (boxProd P)).filter (fun q => ¬ Nat.Coprime q.1 q.2) =
      ((A ×ˢ A).filter (fun q => ¬ Nat.Coprime (∏ i, q.1 i) (∏ i, q.2 i))).image φ := by
    ext ⟨x, y⟩
    simp only [boxProd, Finset.mem_filter, Finset.mem_product, Finset.mem_image, hφ,
      Prod.mk.injEq, Prod.exists]
    constructor
    · rintro ⟨⟨⟨f, hf, rfl⟩, ⟨g, hg, rfl⟩⟩, hc⟩
      exact ⟨f, g, ⟨⟨hf, hg⟩, hc⟩, rfl, rfl⟩
    · rintro ⟨f, g, ⟨⟨hf, hg⟩, hc⟩, rfl, rfl⟩
      exact ⟨⟨⟨f, hf, rfl⟩, ⟨g, hg, rfl⟩⟩, hc⟩
  have hcard1 : (((boxProd P) ×ˢ (boxProd P)).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card =
      ((A ×ˢ A).filter (fun q => ¬ Nat.Coprime (∏ i, q.1 i) (∏ i, q.2 i))).card := by
    rw [himg, Finset.card_image_of_injOn]
    exact hφinj.mono (by simp [Set.subset_def]; tauto)
  -- union bound over the coordinate where the two tuples agree
  have hsub : (A ×ˢ A).filter (fun q => ¬ Nat.Coprime (∏ i, q.1 i) (∏ i, q.2 i)) ⊆
      Finset.univ.biUnion (fun i => (A ×ˢ A).filter (fun q => q.1 i = q.2 i)) := by
    rintro ⟨f, g⟩ h
    simp only [Finset.mem_filter, Finset.mem_product] at h
    obtain ⟨i, hi⟩ := exists_eq_of_not_coprime hP hdisj h.1.1 h.1.2 h.2
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_filter,
      Finset.mem_product]
    exact ⟨i, ⟨h.1.1, h.1.2⟩, hi⟩
  have hfib : ∀ i, (((A ×ˢ A).filter (fun q => q.1 i = q.2 i)).card : ℝ) =
      (A.card : ℝ) ^ 2 / (P i).card := by
    intro i
    have hsum : ((A ×ˢ A).filter (fun q => q.1 i = q.2 i)).card =
        ∑ f ∈ A, (A.filter (fun g => g i = f i)).card := by
      rw [Finset.card_filter, Finset.sum_product]
      refine Finset.sum_congr rfl fun f _ => ?_
      rw [Finset.card_filter]
      exact Finset.sum_congr rfl fun g _ => by
        by_cases h : f i = g i
        · simp [h]
        · simp [h, Ne.symm h]
    rw [hsum]
    push_cast
    rcases (P i).eq_empty_or_nonempty with he | hne
    · have : A = ∅ := by
        rw [hA, Finset.eq_empty_iff_forall_notMem]
        intro f hf
        have := Fintype.mem_piFinset.mp hf i
        rw [he] at this
        simp at this
      simp [this]
    · have hPpos : (0 : ℝ) < (P i).card := by exact_mod_cast hne.card_pos
      have hterm : ∀ f ∈ A, ((A.filter (fun g => g i = f i)).card : ℝ) = A.card / (P i).card := by
        intro f hf
        have h := card_fiber_mul (P := P) i (Fintype.mem_piFinset.mp hf i)
        rw [eq_div_iff hPpos.ne']
        exact_mod_cast h
      rw [Finset.sum_congr rfl hterm, Finset.sum_const, nsmul_eq_mul]
      ring
  have hbox : (boxProd P).card = A.card := by
    unfold boxProd; rw [Finset.card_image_of_injOn hinj]
  calc ((((boxProd P) ×ˢ (boxProd P)).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card : ℝ)
      = (((A ×ˢ A).filter (fun q => ¬ Nat.Coprime (∏ i, q.1 i) (∏ i, q.2 i))).card : ℝ) := by
        rw [hcard1]
    _ ≤ ((Finset.univ.biUnion (fun i => (A ×ˢ A).filter (fun q => q.1 i = q.2 i))).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ i, (((A ×ˢ A).filter (fun q => q.1 i = q.2 i)).card : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ = ∑ i, (A.card : ℝ) ^ 2 / (P i).card := Finset.sum_congr rfl fun i _ => hfib i
    _ = (∑ i, 1 / ((P i).card : ℝ)) * ((boxProd P).card : ℝ) ^ 2 := by
        rw [hbox, Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => by ring

end LemmaC

section Arith

/-- `‖a - b‖ ≤ ‖a‖ + ‖b‖`. -/
lemma dnear_sub_le (a b : ℝ) : FPD.dnear (a - b) ≤ FPD.dnear a + FPD.dnear b := by
  have h := FPD.dnear_le (a - b) (round a - round b)
  unfold FPD.dnear at *
  push_cast at h
  calc |a - b - (round (a - b) : ℝ)| ≤ |a - b - ((round a : ℝ) - round b)| := h
    _ = |(a - round a) - (b - round b)| := by ring_nf
    _ ≤ |a - round a| + |b - round b| := abs_sub _ _

/-- **Divisor lemma.** If `V ≥ 1`, `V² ≤ d₀`, `g > V` and all prime factors of `g` are `≤ d₀`,
then `g` has a divisor in `(V, d₀]`. -/
theorem exists_dvd_Ioc {V d₀ : ℕ} (hV : 1 ≤ V) (hVd : V ^ 2 ≤ d₀) :
    ∀ g : ℕ, V < g → (∀ p, p.Prime → p ∣ g → p ≤ d₀) → ∃ d, d ∣ g ∧ V < d ∧ d ≤ d₀ := by
  intro g
  induction g using Nat.strong_induction_on with
  | _ g ih =>
  intro hg hpf
  by_cases hgd : g ≤ d₀
  · exact ⟨g, dvd_rfl, hg, hgd⟩
  push Not at hgd
  have hg1 : g ≠ 1 := by omega
  obtain ⟨p, hp, hpg⟩ := Nat.exists_prime_and_dvd hg1
  by_cases hpV : V < p
  · exact ⟨p, hpg, hpV, hpf p hp hpg⟩
  push Not at hpV
  obtain ⟨g', rfl⟩ := hpg
  have hp2 := hp.two_le
  have hg' : V < g' := by
    by_contra h
    push Not at h
    have h1 : p * g' ≤ V * V := Nat.mul_le_mul hpV h
    nlinarith
  have hlt : g' < p * g' := by nlinarith
  obtain ⟨d, hd, h1, h2⟩ := ih g' hlt hg' (fun q hq hqg => hpf q hq (Dvd.dvd.mul_left hqg p))
  exact ⟨d, Dvd.dvd.mul_left hd p, h1, h2⟩

/-- `(a + 1)^4 ≤ 2^6 · 2^a`. -/
lemma succ_pow_four_le (a : ℕ) : (a + 1) ^ 4 ≤ 2 ^ 6 * 2 ^ a := by
  induction a with
  | zero => norm_num
  | succ n ih =>
    rcases Nat.lt_or_ge n 5 with h | h
    · interval_cases n <;> norm_num
    · have h1 : 6 * (n + 2) ≤ 7 * (n + 1) := by omega
      have h2 : (6 * (n + 2)) ^ 4 ≤ (7 * (n + 1)) ^ 4 := Nat.pow_le_pow_left h1 4
      have h3 : 6 ^ 4 * (n + 2) ^ 4 ≤ 6 ^ 4 * (2 * (n + 1) ^ 4) := by
        calc 6 ^ 4 * (n + 2) ^ 4 = (6 * (n + 2)) ^ 4 := by ring
          _ ≤ (7 * (n + 1)) ^ 4 := h2
          _ = 7 ^ 4 * (n + 1) ^ 4 := by ring
          _ ≤ (6 ^ 4 * 2) * (n + 1) ^ 4 := Nat.mul_le_mul_right _ (by norm_num)
          _ = 6 ^ 4 * (2 * (n + 1) ^ 4) := by ring
      have h4 : (n + 2) ^ 4 ≤ 2 * (n + 1) ^ 4 := Nat.le_of_mul_le_mul_left h3 (by norm_num)
      calc (n + 1 + 1) ^ 4 = (n + 2) ^ 4 := by ring
        _ ≤ 2 * (n + 1) ^ 4 := h4
        _ ≤ 2 * (2 ^ 6 * 2 ^ n) := Nat.mul_le_mul_left 2 ih
        _ = 2 ^ 6 * 2 ^ (n + 1) := by ring

/-- Per prime power: `(4(a+1))^4 ≤ c_p p^a` with `c_p = 2^14` for `p < 4096`, `c_p = 1` else. -/
lemma four_succ_pow_le {p a : ℕ} (hp : 2 ≤ p) (ha : 1 ≤ a) :
    (4 * (a + 1)) ^ 4 ≤ (if p < 4096 then 2 ^ 14 else 1) * p ^ a := by
  split_ifs with h
  · calc (4 * (a + 1)) ^ 4 = 2 ^ 8 * (a + 1) ^ 4 := by ring
      _ ≤ 2 ^ 8 * (2 ^ 6 * 2 ^ a) := Nat.mul_le_mul_left _ (succ_pow_four_le a)
      _ = 2 ^ 14 * 2 ^ a := by ring
      _ ≤ 2 ^ 14 * p ^ a := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hp a)
  · push Not at h
    have h1 : a + 1 ≤ 2 ^ a := Nat.lt_two_pow_self
    have h256 : 256 ≤ 256 ^ a := by
      calc 256 = 256 ^ 1 := by norm_num
        _ ≤ 256 ^ a := Nat.pow_le_pow_right (by norm_num) ha
    calc (4 * (a + 1)) ^ 4 = 256 * (a + 1) ^ 4 := by ring
      _ ≤ 256 * (2 ^ a) ^ 4 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left h1 4)
      _ = 256 * 16 ^ a := by rw [← pow_mul, mul_comm a 4, pow_mul]; norm_num
      _ ≤ 256 ^ a * 16 ^ a := Nat.mul_le_mul_right _ h256
      _ = 4096 ^ a := by rw [← mul_pow]; norm_num
      _ ≤ p ^ a := Nat.pow_le_pow_left h a
      _ = 1 * p ^ a := (one_mul _).symm

/-- **Pointwise bound.** `(τ(n) · 4^{ω(n)})^4 ≤ 2^{14·4096} · n`. -/
theorem tau_mul_four_pow_omega_pow_le (n : ℕ) (hn : n ≠ 0) :
    (n.divisors.card * 4 ^ n.primeFactors.card) ^ 4 ≤ 2 ^ (14 * 4096) * n := by
  rw [Nat.card_divisors hn]
  have e1 : (∏ p ∈ n.primeFactors, (n.factorization p + 1)) * 4 ^ n.primeFactors.card =
      ∏ p ∈ n.primeFactors, (4 * (n.factorization p + 1)) := by
    rw [Finset.prod_mul_distrib, Finset.prod_const, mul_comm]
  rw [e1, ← Finset.prod_pow]
  have hc : ∏ p ∈ n.primeFactors, (if p < 4096 then 2 ^ 14 else 1) ≤ 2 ^ (14 * 4096) := by
    rw [Finset.prod_ite, Finset.prod_const_one, mul_one, Finset.prod_const, pow_mul]
    apply Nat.pow_le_pow_right (by norm_num)
    calc (n.primeFactors.filter (· < 4096)).card ≤ (Finset.range 4096).card := by
          apply Finset.card_le_card
          intro p hp
          simp only [Finset.mem_filter] at hp
          exact Finset.mem_range.mpr hp.2
      _ = 4096 := Finset.card_range _
  calc ∏ p ∈ n.primeFactors, (4 * (n.factorization p + 1)) ^ 4
      ≤ ∏ p ∈ n.primeFactors, ((if p < 4096 then 2 ^ 14 else 1) * p ^ n.factorization p) := by
        apply Finset.prod_le_prod (fun _ _ => Nat.zero_le _)
        intro p hp
        have hpp := Nat.prime_of_mem_primeFactors hp
        exact four_succ_pow_le hpp.two_le
          (hpp.factorization_pos_of_dvd hn (Nat.dvd_of_mem_primeFactors hp))
    _ = (∏ p ∈ n.primeFactors, (if p < 4096 then 2 ^ 14 else 1)) *
          ∏ p ∈ n.primeFactors, p ^ n.factorization p := Finset.prod_mul_distrib
    _ ≤ 2 ^ (14 * 4096) * n := by
        rw [← Nat.prod_primeFactors_pow_factorization hn]
        exact Nat.mul_le_mul_right _ hc

/-- `C_τ = 2^{28672}`, so that `(τ(n) 4^{ω(n)})² ≤ C_τ √n`. -/
irreducible_def Cτ : ℝ := 2 ^ 28672

/-- The absolute constant of the Rankin-type bound, `C_R = 2 C_τ = 2^{28673}`. -/
irreducible_def CR : ℝ := 2 * Cτ

lemma CR_eq : CR = 2 ^ 28673 := by
  rw [CR_def, Cτ_def]; exact (pow_succ' (2 : ℝ) 28672).symm

lemma Cτ_pos : 0 < Cτ := by rw [Cτ_def]; exact pow_pos two_pos _

lemma CR_pos : 0 < CR := by rw [CR_def]; exact mul_pos two_pos Cτ_pos

/-- `(τ(n) 4^{ω(n)} / n)² ≤ C_τ / (n √n)`. -/
lemma tau_omega_div_sq_le (n : ℕ) (hn : 1 ≤ n) :
    ((((n.divisors.card * 4 ^ n.primeFactors.card : ℕ) : ℝ) / n) ^ 2) ≤
      Cτ / ((n : ℝ) * Real.sqrt n) := by
  set X : ℝ := ((n.divisors.card * 4 ^ n.primeFactors.card : ℕ) : ℝ) with hX
  have hX0 : 0 ≤ X := Nat.cast_nonneg _
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hn0 : (0 : ℝ) < n := by linarith
  have hs : 0 < Real.sqrt n := Real.sqrt_pos.mpr hn0
  have hsq : Real.sqrt n ^ 2 = n := Real.sq_sqrt hn0.le
  have h4 : X ^ 4 ≤ (2 : ℝ) ^ (14 * 4096) * n := by
    have := tau_mul_four_pow_omega_pow_le n (by omega)
    rw [hX]
    exact_mod_cast this
  have hpow : (2 : ℝ) ^ (14 * 4096) = Cτ ^ 2 := by
    have e : (14 * 4096 : ℕ) = 28672 * 2 := by norm_num
    rw [Cτ_def, ← pow_mul, e]
  have hB0 : 0 ≤ Cτ := Cτ_pos.le
  -- `X² ≤ C_τ √n`
  have h2 : X ^ 2 ≤ Cτ * Real.sqrt n := by
    have : (X ^ 2) ^ 2 ≤ (Cτ * Real.sqrt n) ^ 2 := by
      rw [← pow_mul, mul_pow, hsq, ← hpow]
      exact h4
    exact (pow_le_pow_iff_left₀ (sq_nonneg X) (mul_nonneg hB0 (Real.sqrt_nonneg _))
      two_ne_zero).mp this
  rw [div_pow, div_le_div_iff₀ (by positivity) (by positivity)]
  have hmm : Real.sqrt n * Real.sqrt n = n := Real.mul_self_sqrt hn0.le
  calc X ^ 2 * (n * Real.sqrt n) ≤ Cτ * Real.sqrt n * (n * Real.sqrt n) := by
        gcongr
    _ = Cτ * n * (Real.sqrt n * Real.sqrt n) := by ring
    _ = Cτ * (n : ℝ) ^ 2 := by rw [hmm]; ring

/-- `1/(n√n) ≤ 2 (1/√(n-1) - 1/√n)` for `n ≥ 2`. -/
lemma inv_mul_sqrt_le (n : ℕ) (hn : 2 ≤ n) :
    1 / ((n : ℝ) * Real.sqrt n) ≤
      2 * (Real.sqrt ((n - 1 : ℕ) : ℝ))⁻¹ - 2 * (Real.sqrt n)⁻¹ := by
  have hn1 : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
    rw [Nat.cast_sub (by omega)]; simp
  set a := Real.sqrt ((n - 1 : ℕ) : ℝ) with ha
  set b := Real.sqrt (n : ℝ) with hb
  have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have ha2 : a ^ 2 = (n : ℝ) - 1 := by rw [ha, Real.sq_sqrt (by rw [hn1]; linarith), hn1]
  have hb2 : b ^ 2 = n := by rw [hb, Real.sq_sqrt (by linarith)]
  have ha0 : 0 < a := Real.sqrt_pos.mpr (by rw [hn1]; linarith)
  have hb0 : 0 < b := Real.sqrt_pos.mpr (by linarith)
  have hab : a ≤ b := Real.sqrt_le_sqrt (by rw [hn1]; linarith)
  rw [← hb2]
  have hdiff : (b - a) * (b + a) = 1 := by nlinarith
  have hba : b - a = 1 / (b + a) := by rw [eq_div_iff (by positivity)]; exact hdiff
  have e : 2 * a⁻¹ - 2 * b⁻¹ = 2 * (b - a) / (a * b) := by field_simp
  rw [e, hba, div_le_div_iff₀ (by positivity) (by positivity)]
  rw [one_mul, show 2 * (1 / (b + a)) * (b ^ 2 * b) = 2 * b ^ 3 / (b + a) by ring,
    le_div_iff₀ (by positivity)]
  nlinarith [mul_nonneg (mul_nonneg hb0.le (sub_nonneg.mpr hab)) (by positivity : (0:ℝ) ≤ 2 * b + a)]

/-- `∑_{V < d ≤ D} 1/(d√d) ≤ 2/√V`. -/
lemma sum_inv_mul_sqrt_le (V : ℕ) (hV : 1 ≤ V) (D : ℕ) :
    ∑ d ∈ Finset.Ioc V D, 1 / ((d : ℝ) * Real.sqrt d) ≤ 2 / Real.sqrt V := by
  have hVs : 0 < Real.sqrt V := Real.sqrt_pos.mpr (by exact_mod_cast hV)
  rcases Nat.lt_or_ge D V with hD | hD
  · rw [Finset.Ioc_eq_empty (by omega)]
    simp only [Finset.sum_empty]
    positivity
  have key : ∀ D, V ≤ D → ∑ d ∈ Finset.Ioc V D, 1 / ((d : ℝ) * Real.sqrt d) ≤
      2 * (Real.sqrt V)⁻¹ - 2 * (Real.sqrt D)⁻¹ := by
    intro D hD
    induction D, hD using Nat.le_induction with
    | base => simp
    | succ D hVD ih =>
      rw [Finset.sum_Ioc_succ_top hVD]
      have h := inv_mul_sqrt_le (D + 1) (by omega)
      simp only [Nat.add_sub_cancel] at h
      linarith
  have hDs : 0 ≤ 2 * (Real.sqrt D)⁻¹ := by positivity
  have := key D hD
  rw [div_eq_mul_inv]
  linarith

/-- **Rankin-type bound.** `∑_{V < d ≤ D} (τ(d) 4^{ω(d)} / d)² ≤ C_R / √V` with
`C_R = 2^{28673}`. -/
theorem rankin_sum (V D : ℕ) (hV : 1 ≤ V) :
    ∑ d ∈ Finset.Ioc V D, ((((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d) ^ 2) ≤
      CR / Real.sqrt V := by
  calc ∑ d ∈ Finset.Ioc V D, ((((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d) ^ 2)
      ≤ ∑ d ∈ Finset.Ioc V D, Cτ * (1 / ((d : ℝ) * Real.sqrt d)) := by
        apply Finset.sum_le_sum
        intro d hd
        have hd1 : 1 ≤ d := by have := (Finset.mem_Ioc.mp hd).1; omega
        rw [mul_one_div]
        exact tau_omega_div_sq_le d hd1
    _ = Cτ * ∑ d ∈ Finset.Ioc V D, 1 / ((d : ℝ) * Real.sqrt d) := by
        rw [Finset.mul_sum]
    _ ≤ Cτ * (2 / Real.sqrt V) := by
        gcongr
        · exact Cτ_pos.le
        · exact sum_inv_mul_sqrt_le V hV D
    _ = CR / Real.sqrt V := by rw [CR_def]; ring

end Arith

section LemmaQaux

/-- An integer all of whose prime factors exceed `d₀` is coprime to every `d ∈ [1, d₀]`. -/
lemma coprime_of_pf {x d d₀ : ℕ} (hpf : ∀ p, p.Prime → p ∣ x → d₀ < p) (hd1 : 1 ≤ d)
    (hd : d ≤ d₀) : Nat.Coprime x d := by
  apply Nat.coprime_of_dvd
  intro k hk hkx hkd
  have h1 := hpf k hk hkx
  have h2 := Nat.le_of_dvd (by omega) hkd
  omega

/-- A set of pairwise congruent (mod `L`) elements of `P` is no larger than one residue class. -/
lemma card_le_of_pairwise_modEq {P Z : Finset ℕ} {L d₀ : ℕ} {K : ℝ} (hK : 0 ≤ K)
    (hres : ∀ d b : ℕ, 1 ≤ d → d ≤ d₀ → Nat.Coprime b d →
      ((P.filter (fun x => x ≡ b [MOD d])).card : ℝ) ≤ K * 4 ^ d.primeFactors.card / d * P.card)
    (hL1 : 1 ≤ L) (hLd : L ≤ d₀) (hcop : ∀ y ∈ P, Nat.Coprime y L) (hZ : Z ⊆ P)
    (hmod : ∀ y ∈ Z, ∀ y' ∈ Z, y' ≡ y [MOD L]) :
    (Z.card : ℝ) ≤ K * 4 ^ L.primeFactors.card / L * P.card := by
  rcases Z.eq_empty_or_nonempty with he | ⟨y₀, hy₀⟩
  · rw [he, Finset.card_empty, Nat.cast_zero]
    positivity
  have hsub : Z ⊆ P.filter (fun x => x ≡ y₀ [MOD L]) := by
    intro y hy
    exact Finset.mem_filter.mpr ⟨hZ hy, hmod y₀ hy₀ y hy⟩
  calc (Z.card : ℝ) ≤ ((P.filter (fun x => x ≡ y₀ [MOD L])).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ _ := hres L y₀ hL1 hLd (hcop y₀ (hZ hy₀))

/-- The `y ∈ P` with `d₁ ∣ x - y` and `d₂ ∣ x + y`. -/
def sqClass (P : Finset ℕ) (x d₁ d₂ : ℕ) : Finset ℕ :=
  P.filter (fun y : ℕ => (d₁ : ℤ) ∣ (x : ℤ) - y ∧ (d₂ : ℤ) ∣ (x : ℤ) + y)

/-- `sqClass P x d₁ d₂` lies in one residue class modulo `lcm(d₁, d₂) ≥ d₁d₂/2`. -/
lemma card_sqClass_le {P : Finset ℕ} {d₀ : ℕ} {K : ℝ} (hK : 0 ≤ K)
    (hres : ∀ d b : ℕ, 1 ≤ d → d ≤ d₀ → Nat.Coprime b d →
      ((P.filter (fun x => x ≡ b [MOD d])).card : ℝ) ≤ K * 4 ^ d.primeFactors.card / d * P.card)
    {d₁ d₂ x : ℕ} (hd₁0 : 0 < d₁) (hd₂0 : 0 < d₂) (hdd : d₁ * d₂ ≤ d₀)
    (hPd : ∀ y ∈ P, Nat.Coprime y (d₁ * d₂)) (hx : Nat.Coprime x (d₁ * d₂)) :
    ((sqClass P x d₁ d₂).card : ℝ) ≤
      2 * (4 : ℝ) ^ (d₁ * d₂).primeFactors.card / (d₁ * d₂ : ℕ) * K * P.card := by
  have hd0 : 0 < d₁ * d₂ := Nat.mul_pos hd₁0 hd₂0
  rcases (sqClass P x d₁ d₂).eq_empty_or_nonempty with he | ⟨y₀, hy₀⟩
  · rw [he, Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg (mul_nonneg (div_nonneg (mul_nonneg zero_le_two
      (pow_nonneg (by norm_num) _)) (Nat.cast_nonneg _)) hK) (Nat.cast_nonneg _)
  have hy₀' := Finset.mem_filter.mp hy₀
  -- `gcd(d₁, d₂) ∣ 2`
  have hg2 : Nat.gcd d₁ d₂ ∣ 2 := by
    have h1 : ((Nat.gcd d₁ d₂ : ℕ) : ℤ) ∣ (x : ℤ) - y₀ :=
      (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_left d₁ d₂)).trans hy₀'.2.1
    have h2 : ((Nat.gcd d₁ d₂ : ℕ) : ℤ) ∣ (x : ℤ) + y₀ :=
      (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_right d₁ d₂)).trans hy₀'.2.2
    have h3 : ((Nat.gcd d₁ d₂ : ℕ) : ℤ) ∣ ((2 * x : ℕ) : ℤ) := by
      have e : ((2 * x : ℕ) : ℤ) = ((x : ℤ) - y₀) + ((x : ℤ) + y₀) := by push_cast; ring
      rw [e]; exact dvd_add h1 h2
    have h4 : Nat.gcd d₁ d₂ ∣ 2 * x := Int.natCast_dvd_natCast.mp h3
    have hgd : Nat.gcd d₁ d₂ ∣ d₁ * d₂ := (Nat.gcd_dvd_left d₁ d₂).trans (Dvd.intro d₂ rfl)
    have hcop : Nat.Coprime (Nat.gcd d₁ d₂) x := (Nat.Coprime.coprime_dvd_right hgd hx).symm
    exact hcop.dvd_of_dvd_mul_right h4
  have hg_le : Nat.gcd d₁ d₂ ≤ 2 := Nat.le_of_dvd (by norm_num) hg2
  have hLd : Nat.lcm d₁ d₂ ∣ d₁ * d₂ := Nat.lcm_dvd (Dvd.intro d₂ rfl) (Dvd.intro_left d₁ rfl)
  have hL1 : 1 ≤ Nat.lcm d₁ d₂ := Nat.one_le_iff_ne_zero.mpr (Nat.lcm_ne_zero hd₁0.ne' hd₂0.ne')
  have hLle : Nat.lcm d₁ d₂ ≤ d₁ * d₂ := Nat.le_of_dvd hd0 hLd
  have hgL : Nat.gcd d₁ d₂ * Nat.lcm d₁ d₂ = d₁ * d₂ := Nat.gcd_mul_lcm d₁ d₂
  have hmod : ∀ y ∈ sqClass P x d₁ d₂, ∀ y' ∈ sqClass P x d₁ d₂, y' ≡ y [MOD Nat.lcm d₁ d₂] := by
    intro y hy y' hy'
    have hy1 := (Finset.mem_filter.mp hy).2
    have hy1' := (Finset.mem_filter.mp hy').2
    have e1 : (d₁ : ℤ) ∣ (y : ℤ) - y' := by
      have e : (y : ℤ) - y' = ((x : ℤ) - y') - ((x : ℤ) - y) := by ring
      rw [e]; exact dvd_sub hy1'.1 hy1.1
    have e2 : (d₂ : ℤ) ∣ (y : ℤ) - y' := by
      have e : (y : ℤ) - y' = ((x : ℤ) + y) - ((x : ℤ) + y') := by ring
      rw [e]; exact dvd_sub hy1.2 hy1'.2
    rw [Nat.modEq_iff_dvd]
    have f1 : d₁ ∣ ((y : ℤ) - y').natAbs := Int.natCast_dvd.mp e1
    have f2 : d₂ ∣ ((y : ℤ) - y').natAbs := Int.natCast_dvd.mp e2
    exact Int.natCast_dvd.mpr (Nat.lcm_dvd f1 f2)
  have hcopL : ∀ y ∈ P, Nat.Coprime y (Nat.lcm d₁ d₂) := fun y hy =>
    Nat.Coprime.coprime_dvd_right hLd (hPd y hy)
  have hbound := card_le_of_pairwise_modEq hK hres hL1 (hLle.trans hdd) hcopL
    (Finset.filter_subset _ P) hmod
  -- compare `4^{ω(L)}/L` with `2·4^{ω(d)}/d`
  have hω : (Nat.lcm d₁ d₂).primeFactors.card ≤ (d₁ * d₂).primeFactors.card :=
    Finset.card_le_card (Nat.primeFactors_mono hLd hd0.ne')
  have hLR : (0 : ℝ) < (Nat.lcm d₁ d₂ : ℕ) := by exact_mod_cast hL1
  have hdR : (0 : ℝ) < (d₁ * d₂ : ℕ) := by exact_mod_cast hd0
  have hd2L : ((d₁ * d₂ : ℕ) : ℝ) ≤ 2 * (Nat.lcm d₁ d₂ : ℕ) := by
    have : d₁ * d₂ ≤ 2 * Nat.lcm d₁ d₂ := by
      rw [← hgL]; exact Nat.mul_le_mul_right _ hg_le
    exact_mod_cast this
  have h4 : (4 : ℝ) ^ (Nat.lcm d₁ d₂).primeFactors.card ≤ 4 ^ (d₁ * d₂).primeFactors.card :=
    pow_le_pow_right₀ (by norm_num) hω
  have hP0 : (0 : ℝ) ≤ P.card := Nat.cast_nonneg _
  have h4pos : (0 : ℝ) ≤ 4 ^ (d₁ * d₂).primeFactors.card := pow_nonneg (by norm_num) _
  calc ((sqClass P x d₁ d₂).card : ℝ)
      ≤ K * 4 ^ (Nat.lcm d₁ d₂).primeFactors.card / (Nat.lcm d₁ d₂ : ℕ) * P.card := hbound
    _ = K * P.card * 4 ^ (Nat.lcm d₁ d₂).primeFactors.card * (1 / (Nat.lcm d₁ d₂ : ℕ)) := by ring
    _ ≤ K * P.card * 4 ^ (d₁ * d₂).primeFactors.card * (2 / (d₁ * d₂ : ℕ)) := by
        apply mul_le_mul (mul_le_mul_of_nonneg_left h4 (mul_nonneg hK hP0)) _
          (by positivity) (mul_nonneg (mul_nonneg hK hP0) h4pos)
        rw [div_le_div_iff₀ hLR hdR]
        linarith
    _ = 2 * (4 : ℝ) ^ (d₁ * d₂).primeFactors.card / (d₁ * d₂ : ℕ) * K * P.card := by ring

/-- **Square roots.** For `x` coprime to `d ∈ [1, d₀]` (and all of `P` coprime to `d`),
`#{y ∈ P : d ∣ x² - y²} ≤ 2 τ(d) 4^{ω(d)} / d · K |P|`. -/
lemma card_sq_dvd_le {P : Finset ℕ} {d₀ : ℕ} {K : ℝ} (hK : 0 ≤ K)
    (hres : ∀ d b : ℕ, 1 ≤ d → d ≤ d₀ → Nat.Coprime b d →
      ((P.filter (fun x => x ≡ b [MOD d])).card : ℝ) ≤ K * 4 ^ d.primeFactors.card / d * P.card)
    {d x : ℕ} (hd1 : 1 ≤ d) (hdd : d ≤ d₀) (hPd : ∀ y ∈ P, Nat.Coprime y d)
    (hx : Nat.Coprime x d) :
    ((P.filter (fun y : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2)).card : ℝ) ≤
      2 * ((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d * K * P.card := by
  classical
  have hd0 : d ≠ 0 := by omega
  -- covering by the sets `sqClass P x d₁ (d / d₁)`
  have hcover : P.filter (fun y : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2) ⊆
      d.divisors.biUnion (fun d₁ => sqClass P x d₁ (d / d₁)) := by
    intro y hy
    rw [Finset.mem_filter] at hy
    have hfac : (x : ℤ) ^ 2 - (y : ℤ) ^ 2 = ((x : ℤ) - y) * ((x : ℤ) + y) := by ring
    rw [hfac] at hy
    obtain ⟨a₁, a₂, h1, h2, hda⟩ := exists_dvd_and_dvd_of_dvd_mul hy.2
    have hnat : d = a₁.natAbs * a₂.natAbs := by
      have := congrArg Int.natAbs hda
      rwa [Int.natAbs_natCast, Int.natAbs_mul] at this
    have ha₁ : 0 < a₁.natAbs := by
      rcases Nat.eq_zero_or_pos a₁.natAbs with h | h
      · rw [h, zero_mul] at hnat; omega
      · exact h
    rw [Finset.mem_biUnion]
    refine ⟨a₁.natAbs, Nat.mem_divisors.mpr ⟨⟨a₂.natAbs, hnat⟩, hd0⟩, ?_⟩
    have hq : d / a₁.natAbs = a₂.natAbs := by
      rw [hnat, Nat.mul_div_cancel_left _ ha₁]
    rw [sqClass, Finset.mem_filter, hq]
    exact ⟨hy.1, Int.natAbs_dvd.mpr h1, Int.natAbs_dvd.mpr h2⟩
  have hZle : ∀ d₁ ∈ d.divisors, ((sqClass P x d₁ (d / d₁)).card : ℝ) ≤
      2 * (4 : ℝ) ^ d.primeFactors.card / d * K * P.card := by
    intro d₁ hd₁
    have hd₁d : d₁ ∣ d := Nat.dvd_of_mem_divisors hd₁
    have hdd₁₂ : d₁ * (d / d₁) = d := Nat.mul_div_cancel' hd₁d
    have hd₁0 : 0 < d₁ := Nat.pos_of_mem_divisors hd₁
    have hd₂0 : 0 < d / d₁ := Nat.div_pos (Nat.le_of_dvd (by omega) hd₁d) hd₁0
    have hdd' : d₁ * (d / d₁) ≤ d₀ := by rw [hdd₁₂]; exact hdd
    have hPd' : ∀ y ∈ P, Nat.Coprime y (d₁ * (d / d₁)) := by rw [hdd₁₂]; exact hPd
    have hx' : Nat.Coprime x (d₁ * (d / d₁)) := by rw [hdd₁₂]; exact hx
    have := card_sqClass_le hK hres hd₁0 hd₂0 hdd' hPd' hx'
    rwa [hdd₁₂] at this
  calc ((P.filter (fun y : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2)).card : ℝ)
      ≤ ((d.divisors.biUnion (fun d₁ => sqClass P x d₁ (d / d₁))).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hcover
    _ ≤ ∑ d₁ ∈ d.divisors, ((sqClass P x d₁ (d / d₁)).card : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ d₁ ∈ d.divisors, 2 * (4 : ℝ) ^ d.primeFactors.card / d * K * P.card :=
        Finset.sum_le_sum hZle
    _ = 2 * ((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d * K * P.card := by
        rw [Finset.sum_const, nsmul_eq_mul]; push_cast; ring

/-- The prime factors `> d₀` of an integer `A`. -/
def bigPF (A : ℤ) (d₀ : ℕ) : Finset ℕ := A.natAbs.primeFactors.filter (fun p => d₀ < p)

lemma mem_bigPF {A : ℤ} {d₀ p : ℕ} (hA : A ≠ 0) (hp : p.Prime) (hpd : d₀ < p) (hpA : (p : ℤ) ∣ A) :
    p ∈ bigPF A d₀ := by
  rw [bigPF, Finset.mem_filter, Nat.mem_primeFactors]
  exact ⟨⟨hp, Int.natCast_dvd.mp hpA, Int.natAbs_ne_zero.mpr hA⟩, hpd⟩

/-- **Large primes.** If `gcd(x, y) = 1` and `A = x² - y² ≠ 0` with `|A| ≤ 4Y²`, then
`#{z ∈ P : ∃ p ∈ bigPF A d₀, p ∣ x² - z²} ≤ 2β log(4Y²)/log d₀ · |P|`. -/
lemma card_big_prime_le {P : Finset ℕ} {d₀ : ℕ} {β : ℝ} (hβ : 0 ≤ β)
    (hbig : ∀ p : ℕ, p.Prime → d₀ < p → ∀ b : ℕ, ¬ p ∣ b →
      ((P.filter (fun x => x ≡ b [MOD p])).card : ℝ) ≤ β * P.card)
    (hd₀ : 2 ≤ d₀) {x y : ℕ} (hxy : Nat.Coprime x y) {A : ℤ} (hA : A = (x : ℤ) ^ 2 - (y : ℤ) ^ 2)
    (hA0 : A ≠ 0) {Y : ℝ} (hAY : |(A : ℝ)| ≤ 4 * Y ^ 2) :
    ((P.filter (fun z : ℕ => ∃ p ∈ bigPF A d₀, (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) ≤
      2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * P.card := by
  classical
  set SA := bigPF A d₀ with hSA
  have hAn : A.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hA0
  -- covering
  have hcover : P.filter (fun z : ℕ => ∃ p ∈ SA, (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2) ⊆
      SA.biUnion (fun p => P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)) := by
    intro z hz
    obtain ⟨hzP, p, hp, hpB⟩ := Finset.mem_filter.mp hz
    rw [Finset.mem_biUnion]
    exact ⟨p, hp, Finset.mem_filter.mpr ⟨hzP, hpB⟩⟩
  -- each prime contributes at most `2β|P|`
  have hper : ∀ p ∈ SA,
      ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) ≤ 2 * β * P.card := by
    intro p hp
    rw [hSA, bigPF, Finset.mem_filter, Nat.mem_primeFactors] at hp
    obtain ⟨⟨hpp, hpA, -⟩, hpd⟩ := hp
    have hpA' : (p : ℤ) ∣ A := Int.natCast_dvd.mpr hpA
    -- `p ∤ x`
    have hpx : ¬ (p : ℤ) ∣ (x : ℤ) := by
      intro h
      have h1 : (p : ℤ) ∣ (y : ℤ) ^ 2 := by
        have h2 : (p : ℤ) ∣ (x : ℤ) ^ 2 := dvd_pow h two_ne_zero
        have e : (y : ℤ) ^ 2 = (x : ℤ) ^ 2 - A := by rw [hA]; ring
        rw [e]; exact dvd_sub h2 hpA'
      have h3 : p ∣ y := by
        have : p ∣ y ^ 2 := by exact_mod_cast h1
        exact hpp.dvd_of_dvd_pow this
      have h4 : p ∣ x := by exact_mod_cast h
      have h5 : p ∣ Nat.gcd x y := Nat.dvd_gcd h4 h3
      rw [Nat.Coprime.gcd_eq_one hxy] at h5
      exact hpp.one_lt.ne' (Nat.dvd_one.mp h5)
    -- split into the two classes `z ≡ ±x`
    have hsplit : P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2) ⊆
        P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) - z) ∪ P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) + z) := by
      intro z hz
      obtain ⟨hzP, hzd⟩ := Finset.mem_filter.mp hz
      have hfac : (x : ℤ) ^ 2 - (z : ℤ) ^ 2 = ((x : ℤ) - z) * ((x : ℤ) + z) := by ring
      rw [hfac] at hzd
      rcases Int.Prime.dvd_mul' hpp hzd with h | h
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hzP, h⟩)
      · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hzP, h⟩)
    -- a set of `z` pairwise congruent mod `p` and avoiding `0 mod p` has size `≤ β|P|`
    have hclass : ∀ Z : Finset ℕ, Z ⊆ P → (∀ z ∈ Z, ∀ z' ∈ Z, z' ≡ z [MOD p]) →
        (∀ z ∈ Z, ¬ p ∣ z) → (Z.card : ℝ) ≤ β * P.card := by
      intro Z hZ hmod hnd
      rcases Z.eq_empty_or_nonempty with he | ⟨z₁, hz₁⟩
      · rw [he, Finset.card_empty, Nat.cast_zero]; positivity
      have hsub : Z ⊆ P.filter (fun w => w ≡ z₁ [MOD p]) := fun z hz =>
        Finset.mem_filter.mpr ⟨hZ hz, hmod z₁ hz₁ z hz⟩
      calc (Z.card : ℝ) ≤ ((P.filter (fun w => w ≡ z₁ [MOD p])).card : ℝ) := by
            exact_mod_cast Finset.card_le_card hsub
        _ ≤ β * P.card := hbig p hpp hpd z₁ (hnd z₁ hz₁)
    have hm : ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) - z)).card : ℝ) ≤ β * P.card := by
      apply hclass _ (Finset.filter_subset _ _)
      · intro z hz z' hz'
        have a1 := (Finset.mem_filter.mp hz).2
        have a2 := (Finset.mem_filter.mp hz').2
        rw [Nat.modEq_iff_dvd]
        have e : (z : ℤ) - z' = ((x : ℤ) - z') - ((x : ℤ) - z) := by ring
        rw [e]; exact dvd_sub a2 a1
      · intro z hz hpz
        have a1 := (Finset.mem_filter.mp hz).2
        have hpz' : (p : ℤ) ∣ (z : ℤ) := by exact_mod_cast hpz
        have e : (x : ℤ) = ((x : ℤ) - z) + z := by ring
        exact hpx (e ▸ dvd_add a1 hpz')
    have hp' : ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) + z)).card : ℝ) ≤ β * P.card := by
      apply hclass _ (Finset.filter_subset _ _)
      · intro z hz z' hz'
        have a1 := (Finset.mem_filter.mp hz).2
        have a2 := (Finset.mem_filter.mp hz').2
        rw [Nat.modEq_iff_dvd]
        have e : (z : ℤ) - z' = ((x : ℤ) + z) - ((x : ℤ) + z') := by ring
        rw [e]; exact dvd_sub a1 a2
      · intro z hz hpz
        have a1 := (Finset.mem_filter.mp hz).2
        have hpz' : (p : ℤ) ∣ (z : ℤ) := by exact_mod_cast hpz
        have e : (x : ℤ) = ((x : ℤ) + z) - z := by ring
        exact hpx (e ▸ dvd_sub a1 hpz')
    calc ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ)
        ≤ ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) - z) ∪
            P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) + z)).card : ℝ) := by
          exact_mod_cast Finset.card_le_card hsplit
      _ ≤ ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) - z)).card : ℝ) +
            ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) + z)).card : ℝ) := by
          exact_mod_cast Finset.card_union_le _ _
      _ ≤ 2 * β * P.card := by linarith
  -- the number of large prime factors of `A`
  have hcount : (SA.card : ℝ) ≤ Real.log (4 * Y ^ 2) / Real.log d₀ := by
    have hlog0 : 0 < Real.log d₀ := Real.log_pos (by exact_mod_cast hd₀)
    rw [le_div_iff₀ hlog0]
    have h1 : d₀ ^ SA.card ≤ ∏ p ∈ SA, p :=
      Finset.pow_card_le_prod _ _ _ fun p hp => (Finset.mem_filter.mp (hSA ▸ hp)).2.le
    have h2 : ∏ p ∈ SA, p ≤ A.natAbs := by
      apply Nat.le_of_dvd (Nat.pos_of_ne_zero hAn)
      exact (Finset.prod_dvd_prod_of_subset _ _ _ (Finset.filter_subset _ _)).trans
        (Nat.prod_primeFactors_dvd _)
    have h3 : ((d₀ : ℝ)) ^ SA.card ≤ 4 * Y ^ 2 := by
      have : ((d₀ ^ SA.card : ℕ) : ℝ) ≤ (A.natAbs : ℝ) := by exact_mod_cast h1.trans h2
      push_cast at this
      calc (d₀ : ℝ) ^ SA.card ≤ (A.natAbs : ℝ) := this
        _ = |(A : ℝ)| := by rw [Nat.cast_natAbs, Int.cast_abs]
        _ ≤ 4 * Y ^ 2 := hAY
    have hpos : (0 : ℝ) < (d₀ : ℝ) ^ SA.card := by
      apply pow_pos; exact_mod_cast (by omega : 0 < d₀)
    have := Real.log_le_log hpos h3
    rwa [Real.log_pow] at this
  calc ((P.filter (fun z : ℕ => ∃ p ∈ SA, (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ)
      ≤ ((SA.biUnion (fun p => P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2))).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hcover
    _ ≤ ∑ p ∈ SA, ((P.filter (fun z : ℕ => (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ p ∈ SA, 2 * β * (P.card : ℝ) := Finset.sum_le_sum hper
    _ = SA.card * (2 * β * P.card) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ Real.log (4 * Y ^ 2) / Real.log d₀ * (2 * β * P.card) := by gcongr
    _ = 2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * P.card := by ring

end LemmaQaux

section LemmaQ

/-- The hypotheses (Q0)–(Q4) of Lemma Q for a finite set `P ⊆ [Y, 2Y]` of positive integers
(uniform measure `μ`):
* `pf` (Q0): every prime factor of every `x ∈ P` exceeds `d₀`;
* `coll` (Q1): `μ⊗μ{gcd(x, y) ≠ 1} ≤ κ`;
* `res` (Q2): `μ{x ≡ b (d)} ≤ K_res 4^{ω(d)} / d` for `1 ≤ d ≤ d₀`, `gcd(b, d) = 1`;
* `int` (Q3): `μ{x : |x - u| < 2ρY} ≤ 4ρ K_int` for all real `u`;
* `big` (Q4): `μ{x ≡ b (p)} ≤ β` for primes `p > d₀`, `p ∤ b`. -/
structure QHyp (P : Finset ℕ) (Y : ℝ) (d₀ : ℕ) (ρ κ Kres Kint β : ℝ) : Prop where
  mem : ∀ x ∈ P, Y ≤ x ∧ (x : ℝ) ≤ 2 * Y
  pf : ∀ x ∈ P, ∀ p : ℕ, p.Prime → p ∣ x → d₀ < p
  coll : (((P ×ˢ P).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card : ℝ) ≤ κ * (P.card : ℝ) ^ 2
  res : ∀ d b : ℕ, 1 ≤ d → d ≤ d₀ → Nat.Coprime b d →
    ((P.filter (fun x => x ≡ b [MOD d])).card : ℝ) ≤ Kres * 4 ^ d.primeFactors.card / d * P.card
  int : ∀ u : ℝ, ((P.filter (fun x : ℕ => |(x : ℝ) - u| < 2 * ρ * Y)).card : ℝ) ≤
    4 * ρ * Kint * P.card
  big : ∀ p : ℕ, p.Prime → d₀ < p → ∀ b : ℕ, ¬ p ∣ b →
    ((P.filter (fun x => x ≡ b [MOD p])).card : ℝ) ≤ β * P.card

/-- If `E f ≥ η` and `f ≤ 1` then `f ≥ η/2` on a proportion `≥ η/2`. -/
lemma card_filter_half_ge {s : Finset ℕ} {f : ℕ → ℝ} (hf1 : ∀ x ∈ s, f x ≤ 1) {η : ℝ}
    (hη : 0 ≤ η) (h : η * s.card ≤ ∑ x ∈ s, f x) :
    η / 2 * s.card ≤ (s.filter (fun x => η / 2 ≤ f x)).card := by
  have hsplit : ∑ x ∈ s, f x ≤ ((s.filter (fun x => η / 2 ≤ f x)).card : ℝ) + η / 2 * s.card := by
    rw [← Finset.sum_filter_add_sum_filter_not s (fun x => η / 2 ≤ f x)]
    have h1 : ∑ x ∈ s.filter (fun x => η / 2 ≤ f x), f x ≤
        (s.filter (fun x => η / 2 ≤ f x)).card := by
      calc _ ≤ ∑ x ∈ s.filter (fun x => η / 2 ≤ f x), (1 : ℝ) :=
            Finset.sum_le_sum fun x hx => hf1 x (Finset.mem_filter.mp hx).1
        _ = _ := by simp
    have h2 : ∑ x ∈ s.filter (fun x => ¬ η / 2 ≤ f x), f x ≤ η / 2 * s.card := by
      calc _ ≤ ∑ x ∈ s.filter (fun x => ¬ η / 2 ≤ f x), η / 2 :=
            Finset.sum_le_sum fun x hx => (not_le.mp (Finset.mem_filter.mp hx).2).le
        _ = (s.filter (fun x => ¬ η / 2 ≤ f x)).card * (η / 2) := by
            rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ s.card * (η / 2) := by
            gcongr
            exact Finset.filter_subset _ s
        _ = η / 2 * s.card := by ring
    linarith
  linarith

/-- `x² - y²` as an integer. -/
def sqDiff (x y : ℕ) : ℤ := (x : ℤ) ^ 2 - (y : ℤ) ^ 2

lemma sqDiff_cast (x y : ℕ) : ((sqDiff x y : ℤ) : ℝ) = (x : ℝ) ^ 2 - (y : ℝ) ^ 2 := by
  simp [sqDiff]

/-- The bad triples of Lemma Q. -/
def badQ (Y ρ : ℝ) (V₀ d₀ : ℕ) (x y z : ℕ) : Prop :=
  |(y : ℝ) - x| < 2 * ρ * Y ∨ ¬ Nat.Coprime x y ∨
    (∃ d ∈ Finset.Ioc V₀ d₀, (d : ℤ) ∣ sqDiff x y ∧ (d : ℤ) ∣ sqDiff x z) ∨
    (∃ p ∈ bigPF (sqDiff x y) d₀, (p : ℤ) ∣ sqDiff x z)

/-- The `B3` sum: `∑_y #{z : ∃ d ∈ (V₀, d₀], d ∣ x² - y², d ∣ x² - z²} ≤ 4 K² C_R / √V₀ · |P|²`. -/
lemma sum_B3_le {P : Finset ℕ} {d₀ V₀ : ℕ} {K : ℝ} (hK : 0 ≤ K) (hV₀ : 1 ≤ V₀)
    (hres : ∀ d b : ℕ, 1 ≤ d → d ≤ d₀ → Nat.Coprime b d →
      ((P.filter (fun x => x ≡ b [MOD d])).card : ℝ) ≤ K * 4 ^ d.primeFactors.card / d * P.card)
    (hpf : ∀ x ∈ P, ∀ p : ℕ, p.Prime → p ∣ x → d₀ < p) {x : ℕ} (hx : x ∈ P) :
    ∑ y ∈ P, ((P.filter (fun z : ℕ => ∃ d ∈ Finset.Ioc V₀ d₀,
        (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 ∧ (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) ≤
      4 * K ^ 2 * CR / Real.sqrt V₀ * (P.card : ℝ) ^ 2 := by
  classical
  set I := Finset.Ioc V₀ d₀ with hI
  -- `c d = #{z : d ∣ x² - z²}`
  have hc : ∀ d ∈ I, ((P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) ≤
      2 * ((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d * K * P.card := by
    intro d hd
    obtain ⟨h1, h2⟩ := Finset.mem_Ioc.mp hd
    have hd1 : 1 ≤ d := by omega
    exact card_sq_dvd_le hK hres hd1 h2 (fun y hy => coprime_of_pf (hpf y hy) hd1 h2)
      (coprime_of_pf (hpf x hx) hd1 h2)
  have hy : ∀ y ∈ P, ((P.filter (fun z : ℕ => ∃ d ∈ I,
      (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 ∧ (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) ≤
      ∑ d ∈ I, if (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 then
        ((P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) else 0 := by
    intro y _
    have hsub : P.filter (fun z : ℕ => ∃ d ∈ I,
        (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 ∧ (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2) ⊆
        (I.filter (fun d : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2)).biUnion
          (fun d => P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)) := by
      intro z hz
      obtain ⟨hzP, d, hdI, hdy, hdz⟩ := Finset.mem_filter.mp hz
      exact Finset.mem_biUnion.mpr ⟨d, Finset.mem_filter.mpr ⟨hdI, hdy⟩,
        Finset.mem_filter.mpr ⟨hzP, hdz⟩⟩
    calc _ ≤ (((I.filter (fun d : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2)).biUnion
          (fun d => P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2))).card : ℝ) := by
          exact_mod_cast Finset.card_le_card hsub
      _ ≤ ∑ d ∈ I.filter (fun d : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2),
            ((P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) := by
          exact_mod_cast Finset.card_biUnion_le
      _ = _ := Finset.sum_filter _ _
  calc ∑ y ∈ P, ((P.filter (fun z : ℕ => ∃ d ∈ I,
        (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 ∧ (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ)
      ≤ ∑ y ∈ P, ∑ d ∈ I, if (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 then
          ((P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) else 0 :=
        Finset.sum_le_sum hy
    _ = ∑ d ∈ I, ((P.filter (fun z : ℕ => (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)).card : ℝ) ^ 2 := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
        ring
    _ ≤ ∑ d ∈ I, (2 * ((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d * K * P.card) ^ 2 := by
        apply Finset.sum_le_sum
        intro d hd
        exact pow_le_pow_left₀ (Nat.cast_nonneg _) (hc d hd) 2
    _ = 4 * K ^ 2 * (P.card : ℝ) ^ 2 *
          ∑ d ∈ I, ((((d.divisors.card * 4 ^ d.primeFactors.card : ℕ) : ℝ) / d) ^ 2) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        ring
    _ ≤ 4 * K ^ 2 * (P.card : ℝ) ^ 2 * (CR / Real.sqrt V₀) := by
        gcongr
        exact rankin_sum V₀ d₀ hV₀
    _ = 4 * K ^ 2 * CR / Real.sqrt V₀ * (P.card : ℝ) ^ 2 := by ring

lemma abs_sqDiff_le {x y : ℕ} {Y : ℝ} (hx : Y ≤ x ∧ (x : ℝ) ≤ 2 * Y)
    (hy : Y ≤ y ∧ (y : ℝ) ≤ 2 * Y) (hY : 0 < Y) : |((sqDiff x y : ℤ) : ℝ)| ≤ 4 * Y ^ 2 := by
  rw [sqDiff_cast, abs_le]
  have hx0 : (0 : ℝ) ≤ x := by linarith
  have hy0 : (0 : ℝ) ≤ y := by linarith
  constructor <;> nlinarith

lemma abs_sqDiff_ge {x y : ℕ} {Y ρ : ℝ} (hx : Y ≤ x ∧ (x : ℝ) ≤ 2 * Y)
    (hy : Y ≤ y ∧ (y : ℝ) ≤ 2 * Y) (hY : 0 < Y) (h : 2 * ρ * Y ≤ |(y : ℝ) - x|) :
    4 * ρ * Y ^ 2 ≤ |((sqDiff x y : ℤ) : ℝ)| := by
  rw [sqDiff_cast, show (x : ℝ) ^ 2 - (y : ℝ) ^ 2 = ((x : ℝ) - y) * ((x : ℝ) + y) by ring,
    abs_mul, abs_sub_comm, abs_of_pos (by linarith : (0 : ℝ) < (x : ℝ) + y)]
  have : 2 * Y ≤ (x : ℝ) + y := by linarith
  calc 4 * ρ * Y ^ 2 = (2 * ρ * Y) * (2 * Y) := by ring
    _ ≤ |(y : ℝ) - x| * ((x : ℝ) + y) := by
        apply mul_le_mul h this (by linarith) (abs_nonneg _)

/-- **Lemma Q** (corrected form of the review's §9.1 Lemma Q, with the `d`-dependent residue
bound (Q2) `μ{x ≡ b (d)} ≤ K_res 4^{ω(d)}/d`). Let `P ⊆ [Y, 2Y]` be a finite nonempty set of
positive integers satisfying (Q0)–(Q4) (`QHyp`), `V₀ ≥ 1`, `V₀² ≤ d₀`, `d₀ ≥ 2` and
`(Q5) 4ρK_int + κ + 4 C_R K_res² / √V₀ + 2β log(4Y²)/log d₀ < η³/8`.
If `T √(2η) > 16 Y²` and `E_{x∈P} Φ_T(θ(x² - c)) ≥ η`, then some `v ∈ [1, V₀]` has
`‖vθ‖ ≤ (2V₀/(ρ√(2η))) / (T · 4Y²)`. -/
theorem lemmaQ {P : Finset ℕ} (hPne : P.Nonempty) {Y : ℝ} (hY : 0 < Y) {d₀ V₀ : ℕ}
    {ρ κ Kres Kint β η : ℝ} (hQ : QHyp P Y d₀ ρ κ Kres Kint β)
    (hη : 0 < η) (hρ : 0 < ρ) (hV₀ : 1 ≤ V₀) (hVd : V₀ ^ 2 ≤ d₀) (hd₀ : 2 ≤ d₀)
    (hQ5 : 4 * ρ * Kint + κ + 4 * CR * Kres ^ 2 / Real.sqrt V₀ +
      2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ < η ^ 3 / 8)
    (c : ℤ) {T : ℕ} (hT : 16 * Y ^ 2 < T * Real.sqrt (2 * η)) {θ : ℝ}
    (hθ : η * P.card ≤ ∑ x ∈ P, FPD.fejer T (θ * (((x : ℤ) ^ 2 - c : ℤ) : ℝ))) :
    ∃ v : ℕ, 1 ≤ v ∧ v ≤ V₀ ∧
      FPD.dnear (v * θ) ≤ 2 * V₀ / (ρ * Real.sqrt (2 * η)) / (T * (4 * Y ^ 2)) := by
  classical
  have hNpos : 0 < P.card := hPne.card_pos
  have hNR : (0 : ℝ) < P.card := by exact_mod_cast hNpos
  have hs2η : 0 < Real.sqrt (2 * η) := Real.sqrt_pos.mpr (by linarith)
  have hT1 : 1 ≤ T := by
    rcases Nat.eq_zero_or_pos T with h | h
    · rw [h, Nat.cast_zero, zero_mul] at hT; nlinarith [sq_nonneg Y]
    · exact h
  have hTR : (0 : ℝ) < T := by exact_mod_cast hT1
  obtain ⟨x₀, hx₀⟩ := hPne
  -- `K_res ≥ 0` and `β ≥ 0`
  have hK0 : 0 ≤ Kres := by
    have h := hQ.res 1 x₀ le_rfl (by omega) (Nat.coprime_one_right x₀)
    have hsub : P.filter (fun x => x ≡ x₀ [MOD 1]) = P :=
      Finset.filter_true_of_mem (fun x _ => Nat.modEq_one)
    rw [hsub] at h
    simp only [Nat.primeFactors_one, Finset.card_empty, pow_zero, Nat.cast_one, div_one,
      mul_one] at h
    nlinarith
  have hβ0 : 0 ≤ β := by
    obtain ⟨p, hp1, hp⟩ := Nat.exists_infinite_primes (d₀ + 1)
    have h := hQ.big p hp (by omega) 1 (fun h => hp.one_lt.ne' (Nat.dvd_one.mp h))
    have h0 : (0 : ℝ) ≤ ((P.filter (fun x => x ≡ 1 [MOD p])).card : ℝ) := Nat.cast_nonneg _
    nlinarith
  set N : ℝ := (P.card : ℝ) with hN
  -- the good set
  set G := P.filter (fun x : ℕ => η / 2 ≤ FPD.fejer T (θ * (((x : ℤ) ^ 2 - c : ℤ) : ℝ))) with hG
  have hGcard : η / 2 * N ≤ G.card :=
    card_filter_half_ge (fun x _ => FPD.fejer_le_one _ _) hη.le hθ
  have hGP : G ⊆ P := Finset.filter_subset _ _
  -- counting bad triples
  set bad := (P ×ˢ P ×ˢ P).filter (fun t : ℕ × ℕ × ℕ => badQ Y ρ V₀ d₀ t.1 t.2.1 t.2.2) with hbad
  have hcount : (bad.card : ℝ) =
      ∑ x ∈ P, ∑ y ∈ P, ((P.filter (fun z => badQ Y ρ V₀ d₀ x y z)).card : ℝ) := by
    have : bad.card = ∑ x ∈ P, ∑ y ∈ P, (P.filter (fun z => badQ Y ρ V₀ d₀ x y z)).card := by
      rw [hbad, Finset.card_filter, Finset.sum_product]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [Finset.sum_product]
      refine Finset.sum_congr rfl fun y _ => ?_
      rw [Finset.card_filter]
    rw [this]; push_cast; rfl
  set B3s : ℕ → ℕ → Finset ℕ := fun x y => P.filter (fun z : ℕ => ∃ d ∈ Finset.Ioc V₀ d₀,
    (d : ℤ) ∣ (x : ℤ) ^ 2 - (y : ℤ) ^ 2 ∧ (d : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2) with hB3s
  set B4s : ℕ → ℕ → Finset ℕ := fun x y =>
    P.filter (fun z : ℕ => ∃ p ∈ bigPF (sqDiff x y) d₀, (p : ℤ) ∣ (x : ℤ) ^ 2 - (z : ℤ) ^ 2)
    with hB4s
  have hxy : ∀ x ∈ P, ∀ y ∈ P, ((P.filter (fun z => badQ Y ρ V₀ d₀ x y z)).card : ℝ) ≤
      (if |(y : ℝ) - x| < 2 * ρ * Y then N else 0) + (if ¬ Nat.Coprime x y then N else 0) +
      ((B3s x y).card : ℝ) +
      (if |(y : ℝ) - x| < 2 * ρ * Y ∨ ¬ Nat.Coprime x y then 0 else ((B4s x y).card : ℝ)) := by
    intro x _ y _
    have hle : ((P.filter (fun z => badQ Y ρ V₀ d₀ x y z)).card : ℝ) ≤ N := by
      rw [hN]; exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)
    have h3nn : (0 : ℝ) ≤ ((B3s x y).card : ℝ) := Nat.cast_nonneg _
    have hNn : (0 : ℝ) ≤ N := hNR.le
    by_cases h1 : |(y : ℝ) - x| < 2 * ρ * Y
    · rw [if_pos h1, if_pos (Or.inl h1)]
      have : (0 : ℝ) ≤ if ¬ Nat.Coprime x y then N else 0 := by split_ifs <;> linarith
      linarith
    by_cases h2 : ¬ Nat.Coprime x y
    · rw [if_neg h1, if_pos h2, if_pos (Or.inr h2)]
      linarith
    rw [if_neg h1, if_neg h2, if_neg (by tauto)]
    have hsub : P.filter (fun z => badQ Y ρ V₀ d₀ x y z) ⊆ B3s x y ∪ B4s x y := by
      intro z hz
      obtain ⟨hzP, hb⟩ := Finset.mem_filter.mp hz
      unfold badQ at hb
      rcases hb with hb | hb | hb | hb
      · exact absurd hb h1
      · exact absurd hb h2
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hzP, hb⟩)
      · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hzP, hb⟩)
    calc ((P.filter (fun z => badQ Y ρ V₀ d₀ x y z)).card : ℝ)
        ≤ ((B3s x y ∪ B4s x y).card : ℝ) := by exact_mod_cast Finset.card_le_card hsub
      _ ≤ ((B3s x y).card : ℝ) + ((B4s x y).card : ℝ) := by
          exact_mod_cast Finset.card_union_le _ _
      _ = 0 + 0 + ((B3s x y).card : ℝ) + ((B4s x y).card : ℝ) := by ring
  -- the four sums
  have hC1 : ∑ x ∈ P, ∑ y ∈ P, (if |(y : ℝ) - x| < 2 * ρ * Y then N else 0) ≤
      4 * ρ * Kint * N ^ 3 := by
    calc ∑ x ∈ P, ∑ y ∈ P, (if |(y : ℝ) - x| < 2 * ρ * Y then N else 0)
        = ∑ x ∈ P, ((P.filter (fun y : ℕ => |(y : ℝ) - x| < 2 * ρ * Y)).card : ℝ) * N := by
          refine Finset.sum_congr rfl fun x _ => ?_
          rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ x ∈ P, 4 * ρ * Kint * N * N := by
          apply Finset.sum_le_sum
          intro x _
          exact mul_le_mul_of_nonneg_right (hQ.int x) hNR.le
      _ = 4 * ρ * Kint * N ^ 3 := by
          rw [Finset.sum_const, nsmul_eq_mul, ← hN]; ring
  have hC2 : ∑ x ∈ P, ∑ y ∈ P, (if ¬ Nat.Coprime x y then N else 0) ≤ κ * N ^ 3 := by
    have e : ∑ x ∈ P, ∑ y ∈ P, (if ¬ Nat.Coprime x y then N else 0) =
        N * (((P ×ˢ P).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card : ℝ) := by
      rw [Finset.card_filter, Finset.sum_product, Nat.cast_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [Nat.cast_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun y _ => ?_
      split_ifs <;> simp
    rw [e]
    calc N * (((P ×ˢ P).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card : ℝ) ≤ N * (κ * N ^ 2) :=
          mul_le_mul_of_nonneg_left hQ.coll hNR.le
      _ = κ * N ^ 3 := by ring
  have hC3 : ∑ x ∈ P, ∑ y ∈ P, ((B3s x y).card : ℝ) ≤ 4 * CR * Kres ^ 2 / Real.sqrt V₀ * N ^ 3 := by
    calc ∑ x ∈ P, ∑ y ∈ P, ((B3s x y).card : ℝ)
        ≤ ∑ x ∈ P, 4 * Kres ^ 2 * CR / Real.sqrt V₀ * N ^ 2 :=
          Finset.sum_le_sum fun x hx => sum_B3_le hK0 hV₀ hQ.res hQ.pf hx
      _ = 4 * CR * Kres ^ 2 / Real.sqrt V₀ * N ^ 3 := by
          rw [Finset.sum_const, nsmul_eq_mul, ← hN]; ring
  have hC4 : ∑ x ∈ P, ∑ y ∈ P,
      (if |(y : ℝ) - x| < 2 * ρ * Y ∨ ¬ Nat.Coprime x y then 0 else ((B4s x y).card : ℝ)) ≤
      2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * N ^ 3 := by
    have hper : ∀ x ∈ P, ∀ y ∈ P,
        (if |(y : ℝ) - x| < 2 * ρ * Y ∨ ¬ Nat.Coprime x y then 0 else ((B4s x y).card : ℝ)) ≤
        2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * N := by
      intro x hx y hy
      have hlog : 0 ≤ 2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * N := by
        apply mul_nonneg _ hNR.le
        apply div_nonneg _ (Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ d₀)))
        apply mul_nonneg (by linarith)
        apply Real.log_nonneg
        have hx1 := hQ.mem x hx
        have hxpos : (1 : ℝ) ≤ x := by
          have : 1 ≤ x := by
            rcases Nat.eq_zero_or_pos x with h | h
            · exfalso
              obtain ⟨p, hp1, hp⟩ := Nat.exists_infinite_primes (d₀ + 1)
              have := hQ.pf x hx p hp (by rw [h]; exact dvd_zero p)
              -- `x = 0` would have every prime as a factor; but `x ≥ Y > 0`
              rw [h] at hx1; simp at hx1; linarith [hx1.1]
            · exact h
          exact_mod_cast this
        nlinarith [hx1.1, hx1.2]
      split_ifs with h
      · exact hlog
      push Not at h
      obtain ⟨h1, h2⟩ := h
      have hxY := hQ.mem x hx
      have hyY := hQ.mem y hy
      have hA0 : sqDiff x y ≠ 0 := by
        intro h0
        have := abs_sqDiff_ge hxY hyY hY h1
        rw [h0, Int.cast_zero, abs_zero] at this
        have : 0 < 4 * ρ * Y ^ 2 := by positivity
        linarith
      exact card_big_prime_le hβ0 hQ.big hd₀ h2 rfl hA0 (abs_sqDiff_le hxY hyY hY)
    calc _ ≤ ∑ x ∈ P, ∑ y ∈ P, 2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * N :=
          Finset.sum_le_sum fun x hx => Finset.sum_le_sum fun y hy => hper x hx y hy
      _ = 2 * β * Real.log (4 * Y ^ 2) / Real.log d₀ * N ^ 3 := by
          simp only [Finset.sum_const, nsmul_eq_mul, ← hN]; ring
  have hbadle : (bad.card : ℝ) ≤ (4 * ρ * Kint + κ + 4 * CR * Kres ^ 2 / Real.sqrt V₀ +
      2 * β * Real.log (4 * Y ^ 2) / Real.log d₀) * N ^ 3 := by
    rw [hcount]
    calc ∑ x ∈ P, ∑ y ∈ P, ((P.filter (fun z => badQ Y ρ V₀ d₀ x y z)).card : ℝ)
        ≤ ∑ x ∈ P, ∑ y ∈ P, ((if |(y : ℝ) - x| < 2 * ρ * Y then N else 0) +
            (if ¬ Nat.Coprime x y then N else 0) + ((B3s x y).card : ℝ) +
            (if |(y : ℝ) - x| < 2 * ρ * Y ∨ ¬ Nat.Coprime x y then 0 else
              ((B4s x y).card : ℝ))) :=
          Finset.sum_le_sum fun x hx => Finset.sum_le_sum fun y hy => hxy x hx y hy
      _ = (∑ x ∈ P, ∑ y ∈ P, (if |(y : ℝ) - x| < 2 * ρ * Y then N else 0)) +
          (∑ x ∈ P, ∑ y ∈ P, (if ¬ Nat.Coprime x y then N else 0)) +
          (∑ x ∈ P, ∑ y ∈ P, ((B3s x y).card : ℝ)) +
          (∑ x ∈ P, ∑ y ∈ P, (if |(y : ℝ) - x| < 2 * ρ * Y ∨ ¬ Nat.Coprime x y then 0 else
              ((B4s x y).card : ℝ))) := by
          simp only [Finset.sum_add_distrib]
      _ ≤ _ := by nlinarith [hC1, hC2, hC3, hC4]
  -- a good triple exists
  have hG3 : ((G ×ˢ G ×ˢ G).card : ℝ) = (G.card : ℝ) ^ 3 := by
    rw [Finset.card_product, Finset.card_product]; push_cast; ring
  have hN3 : 0 < N ^ 3 := by positivity
  have hlt : (bad.card : ℝ) < ((G ×ˢ G ×ˢ G).card : ℝ) := by
    rw [hG3]
    have h1 : (η / 2 * N) ^ 3 ≤ (G.card : ℝ) ^ 3 :=
      pow_le_pow_left₀ (by positivity) hGcard 3
    have h2 : (4 * ρ * Kint + κ + 4 * CR * Kres ^ 2 / Real.sqrt V₀ +
      2 * β * Real.log (4 * Y ^ 2) / Real.log d₀) * N ^ 3 < η ^ 3 / 8 * N ^ 3 :=
      mul_lt_mul_of_pos_right hQ5 hN3
    have h3 : η ^ 3 / 8 * N ^ 3 = (η / 2 * N) ^ 3 := by ring
    linarith
  have hex : ∃ t ∈ G ×ˢ G ×ˢ G, ¬ badQ Y ρ V₀ d₀ t.1 t.2.1 t.2.2 := by
    by_contra hno
    push Not at hno
    have hsub : G ×ˢ G ×ˢ G ⊆ bad := by
      intro t ht
      rw [hbad, Finset.mem_filter]
      refine ⟨?_, hno t ht⟩
      simp only [Finset.mem_product] at ht ⊢
      exact ⟨hGP ht.1, hGP ht.2.1, hGP ht.2.2⟩
    have := Finset.card_le_card hsub
    have : ((G ×ˢ G ×ˢ G).card : ℝ) ≤ bad.card := by exact_mod_cast this
    linarith
  obtain ⟨⟨x, y, z⟩, hmem, hgood⟩ := hex
  simp only [Finset.mem_product] at hmem
  obtain ⟨hxG, hyG, hzG⟩ := hmem
  have hxP := hGP hxG
  have hyP := hGP hyG
  have hzP := hGP hzG
  simp only [badQ, not_or, not_not] at hgood
  obtain ⟨h1, hcop, h3, h4⟩ := hgood
  have h1' : 2 * ρ * Y ≤ |(y : ℝ) - x| := not_lt.mp h1
  have hxY := hQ.mem x hxP
  have hyY := hQ.mem y hyP
  have hzY := hQ.mem z hzP
  set A : ℤ := sqDiff x y with hA
  set B : ℤ := sqDiff x z with hB
  have hAge : 4 * ρ * Y ^ 2 ≤ |(A : ℝ)| := abs_sqDiff_ge hxY hyY hY h1'
  have hApos : 0 < |(A : ℝ)| := lt_of_lt_of_le (by positivity) hAge
  have hA0 : A ≠ 0 := by
    intro h0; rw [h0, Int.cast_zero, abs_zero] at hApos; exact lt_irrefl _ hApos
  have hAle : |(A : ℝ)| ≤ 4 * Y ^ 2 := abs_sqDiff_le hxY hyY hY
  have hBle : |(B : ℝ)| ≤ 4 * Y ^ 2 := abs_sqDiff_le hxY hzY hY
  -- `gcd(A, B) ≤ V₀`
  have hg : Int.gcd A B ≤ V₀ := by
    by_contra hgt
    push Not at hgt
    obtain ⟨d, hdg, hVd', hdd₀⟩ := exists_dvd_Ioc hV₀ hVd (Int.gcd A B) hgt (by
      intro p hp hpg
      by_contra hpd
      push Not at hpd
      have hpA : (p : ℤ) ∣ A := (Int.natCast_dvd_natCast.mpr hpg).trans (Int.gcd_dvd_left A B)
      have hpB : (p : ℤ) ∣ B := (Int.natCast_dvd_natCast.mpr hpg).trans (Int.gcd_dvd_right A B)
      exact h4 ⟨p, mem_bigPF hA0 hp hpd hpA, hpB⟩)
    have hdA : (d : ℤ) ∣ A := (Int.natCast_dvd_natCast.mpr hdg).trans (Int.gcd_dvd_left A B)
    have hdB : (d : ℤ) ∣ B := (Int.natCast_dvd_natCast.mpr hdg).trans (Int.gcd_dvd_right A B)
    exact h3 ⟨d, Finset.mem_Ioc.mpr ⟨hVd', hdd₀⟩, hdA, hdB⟩
  -- Fejér: `‖θ(w² - c)‖ ≤ ε` on `G`
  set ε : ℝ := 1 / (T * Real.sqrt (2 * η)) with hε
  have hεpos : 0 < ε := by positivity
  have hG_near : ∀ w ∈ G, FPD.dnear (θ * (((w : ℤ) ^ 2 - c : ℤ) : ℝ)) ≤ ε := fun w hw =>
    FPD.dnear_le_of_fejer hT1 hη (Finset.mem_filter.mp hw).2
  have hdA : FPD.dnear (θ * (A : ℝ)) ≤ 2 * ε := by
    have e : θ * (A : ℝ) = θ * (((x : ℤ) ^ 2 - c : ℤ) : ℝ) - θ * (((y : ℤ) ^ 2 - c : ℤ) : ℝ) := by
      rw [hA, sqDiff_cast]; push_cast; ring
    rw [e]
    linarith [dnear_sub_le (θ * (((x : ℤ) ^ 2 - c : ℤ) : ℝ)) (θ * (((y : ℤ) ^ 2 - c : ℤ) : ℝ)),
      hG_near x hxG, hG_near y hyG]
  have hdB : FPD.dnear (θ * (B : ℝ)) ≤ 2 * ε := by
    have e : θ * (B : ℝ) = θ * (((x : ℤ) ^ 2 - c : ℤ) : ℝ) - θ * (((z : ℤ) ^ 2 - c : ℤ) : ℝ) := by
      rw [hB, sqDiff_cast]; push_cast; ring
    rw [e]
    linarith [dnear_sub_le (θ * (((x : ℤ) ^ 2 - c : ℤ) : ℝ)) (θ * (((z : ℤ) ^ 2 - c : ℤ) : ℝ)),
      hG_near x hxG, hG_near z hzG]
  have hsmall : 2 * ε * (|(A : ℝ)| + |(B : ℝ)|) < 1 := by
    have h8 : |(A : ℝ)| + |(B : ℝ)| ≤ 8 * Y ^ 2 := by linarith
    calc 2 * ε * (|(A : ℝ)| + |(B : ℝ)|) ≤ 2 * ε * (8 * Y ^ 2) := by gcongr
      _ = 16 * Y ^ 2 / (T * Real.sqrt (2 * η)) := by rw [hε]; field_simp; ring
      _ < 1 := by rw [div_lt_one (by positivity)]; exact hT
  obtain ⟨v, hv0, hvg, hvd⟩ := FPD.near_int_pair hA0 hdA hdB hsmall
  have hvV : v ≤ V₀ := (Nat.le_of_dvd (Int.gcd_pos_of_ne_zero_left B hA0) hvg).trans hg
  refine ⟨v, hv0, hvV, ?_⟩
  have hvR : (v : ℝ) ≤ V₀ := by exact_mod_cast hvV
  calc FPD.dnear (v * θ) ≤ v * (2 * ε) / |(A : ℝ)| := hvd
    _ ≤ V₀ * (2 * ε) / (4 * ρ * Y ^ 2) := by
        apply div_le_div₀ (by positivity) (by gcongr) (by positivity) hAge
    _ = 2 * V₀ / (ρ * Real.sqrt (2 * η)) / (T * (4 * Y ^ 2)) := by
        rw [hε]; field_simp

/-- **Lemma Q in `FPDProp` form.** With `D = 4Y²` (`Y ∈ ℕ`), `S_c = {x² - c : x ∈ P}` satisfies
`FPD(S_c, T, 4Y², η, V₀, 2V₀/(ρ√(2η)))`; see `FPDProp.of_mul` for GS's normalisation `D = Y²`. -/
theorem lemmaQ_FPD {P : Finset ℕ} (hPne : P.Nonempty) {Y : ℕ} (hY : 1 ≤ Y) {d₀ V₀ : ℕ}
    {ρ κ Kres Kint β η : ℝ} (hQ : QHyp P Y d₀ ρ κ Kres Kint β)
    (hη : 0 < η) (hρ : 0 < ρ) (hV₀ : 1 ≤ V₀) (hVd : V₀ ^ 2 ≤ d₀) (hd₀ : 2 ≤ d₀)
    (hQ5 : 4 * ρ * Kint + κ + 4 * CR * Kres ^ 2 / Real.sqrt V₀ +
      2 * β * Real.log (4 * (Y : ℝ) ^ 2) / Real.log d₀ < η ^ 3 / 8)
    (c : ℤ) {T : ℕ} (hT : 16 * (Y : ℝ) ^ 2 < T * Real.sqrt (2 * η)) :
    FPDProp (P.image (fun x : ℕ => (x : ℤ) ^ 2 - c)) T (4 * Y ^ 2) η V₀
      (2 * V₀ / (ρ * Real.sqrt (2 * η))) := by
  intro θ hθ
  have hinj : Set.InjOn (fun x : ℕ => (x : ℤ) ^ 2 - c) (P : Set ℕ) := by
    intro x _ y _ h
    simp only at h
    have h2 : (x : ℤ) ^ 2 = (y : ℤ) ^ 2 := by linarith
    have h3 : x ^ 2 = y ^ 2 := by exact_mod_cast h2
    exact Nat.pow_left_injective (by norm_num) h3
  rw [Finset.card_image_of_injOn hinj, Finset.sum_image hinj] at hθ
  have hN : (0 : ℝ) < P.card := by exact_mod_cast hPne.card_pos
  rw [le_div_iff₀ hN] at hθ
  have hYR : (0 : ℝ) < Y := by exact_mod_cast hY
  obtain ⟨v, hv1, hvV, hvd⟩ := lemmaQ hPne hYR hQ hη hρ hV₀ hVd hd₀ hQ5 c hT (θ := θ) hθ
  refine ⟨v, hv1, by exact_mod_cast hvV, ?_⟩
  push_cast
  exact hvd

/-- **Lemma L for a box** (Lemma C + `FPD.lemmaL`): if `∑ᵢ 1/|P i| < (η/2)²`, the box
`S ⊆ [Y, 2Y]` of pairwise disjoint prime sets satisfies `FPD(S, T, Y, η, 1, (2η)^{-1/2})`
whenever `T √(2η) > 4Y`. -/
theorem lemmaL_box_FPD {ι : Type*} [Fintype ι] [DecidableEq ι] {P : ι → Finset ℕ}
    (hP : ∀ i, ∀ p ∈ P i, p.Prime) (hdisj : ∀ i j, i ≠ j → Disjoint (P i) (P j))
    (hne : (boxProd P).Nonempty) {Y : ℕ} (hY : 1 ≤ Y)
    (hbox : ∀ s ∈ boxProd P, Y ≤ s ∧ s ≤ 2 * Y)
    {η : ℝ} (hη : 0 < η) (hκ : ∑ i, 1 / ((P i).card : ℝ) < (η / 2) ^ 2)
    {T : ℕ} (hTY : 4 * (Y : ℝ) < T * Real.sqrt (2 * η)) :
    FPDProp ((boxProd P).image (fun s : ℕ => (s : ℤ))) T Y η 1 (1 / Real.sqrt (2 * η)) := by
  intro θ hθ
  have hinj : Set.InjOn (fun s : ℕ => (s : ℤ)) ((boxProd P : Finset ℕ) : Set ℕ) :=
    fun a _ b _ h => by simp only at h; exact_mod_cast h
  rw [Finset.card_image_of_injOn hinj, Finset.sum_image hinj] at hθ
  have hN : (0 : ℝ) < (boxProd P).card := by exact_mod_cast hne.card_pos
  rw [le_div_iff₀ hN] at hθ
  have hYR : (0 : ℝ) < Y := by exact_mod_cast hY
  have hT1 : 1 ≤ T := by
    rcases Nat.eq_zero_or_pos T with h | h
    · rw [h, Nat.cast_zero, zero_mul] at hTY; linarith
    · exact h
  have hcoll : ((((boxProd P) ×ˢ (boxProd P)).filter (fun q => ¬ Nat.Coprime q.1 q.2)).card : ℝ) <
      (η / 2) ^ 2 * ((boxProd P).card : ℝ) ^ 2 := by
    calc _ ≤ (∑ i, 1 / ((P i).card : ℝ)) * ((boxProd P).card : ℝ) ^ 2 := lemmaC_coll hP hdisj
      _ < (η / 2) ^ 2 * ((boxProd P).card : ℝ) ^ 2 := mul_lt_mul_of_pos_right hκ (by positivity)
  have hS : ∀ s ∈ boxProd P, (Y : ℝ) ≤ s ∧ (s : ℝ) ≤ 2 * Y := fun s hs => by
    have := hbox s hs
    exact ⟨by exact_mod_cast this.1, by exact_mod_cast this.2⟩
  have h := FPD.lemmaL hYR hS hT1 hη hcoll hTY (θ := θ) (by simpa using hθ)
  refine ⟨1, le_rfl, by norm_num, ?_⟩
  rw [Nat.cast_one, one_mul]
  calc FPD.dnear θ ≤ 1 / (Real.sqrt (2 * η) * T * Y) := h
    _ = 1 / Real.sqrt (2 * η) / (T * Y) := by rw [div_div]; ring

end LemmaQ

section LemmaR

/-- **(BT)** Brun–Titchmarsh for primes in an arithmetic progression inside an interval, in the
form supplied by the Selberg-majorant route: for `1 ≤ u`, `y ≥ y₀`, `1 ≤ d`, `d^{10} ≤ y` and
`gcd(b, d) = 1`, `#{p ∈ [u, u + y) prime, p ≡ b (d)} ≤ C · 4^{ω(d)} · y / (d log y)`.
(It is only satisfiable when `y₀ ≥ 2`.) -/
def BTWith (C : ℝ) (y₀ : ℕ) : Prop :=
  ∀ (u y d b : ℕ), 1 ≤ u → y₀ ≤ y → 1 ≤ d → d ^ 10 ≤ y → Nat.Coprime b d →
    (((Finset.Ico u (u + y)).filter (fun p => p.Prime ∧ p % d = b % d)).card : ℝ) ≤
      C * 4 ^ d.primeFactors.card * y / (d * Real.log y)

lemma BTWith.nonneg {C : ℝ} {y₀ : ℕ} (h : BTWith C y₀) : 0 ≤ C := by
  by_contra hC
  push Not at hC
  set y := max y₀ 2 with hy
  have hy2 : 2 ≤ y := le_max_right _ _
  have h1 := h 1 y 1 0 le_rfl (le_max_left _ _) le_rfl (by simp; omega) (Nat.coprime_zero_left 1 |>.mpr rfl)
  have hyR : (2 : ℝ) ≤ y := by exact_mod_cast hy2
  have hlog : 0 < Real.log y := Real.log_pos (by linarith)
  have hneg : C * 4 ^ (1 : ℕ).primeFactors.card * y / (1 * Real.log y) < 0 := by
    simp only [Nat.primeFactors_one, Finset.card_empty, pow_zero, mul_one, one_mul]
    exact div_neg_of_neg_of_pos (mul_neg_of_neg_of_pos hC (by linarith)) hlog
  have h0 : (0 : ℝ) ≤ (((Finset.Ico 1 (1 + y)).filter (fun p => p.Prime ∧ p % 1 = 0 % 1)).card : ℝ) :=
    Nat.cast_nonneg _
  rw [Nat.cast_one] at h1
  linarith

/-- Integers in `[a, a + y)` in one residue class modulo `q`: at most `y/q + 1`. -/
lemma card_Ico_modEq_le (a y q v : ℕ) (hq : 0 < q) :
    (((Finset.Ico a (a + y)).filter (fun x => x ≡ v [MOD q])).card : ℝ) ≤ y / q + 1 := by
  have h := Nat.Ico_filter_modEq_card a (a + y) hq v
  have hqQ : (0 : ℚ) < q := by exact_mod_cast hq
  set α : ℚ := (((a + y : ℕ) : ℚ) - v) / q with hα
  set β : ℚ := ((a : ℚ) - v) / q with hβ
  have hαβ : α - β = (y : ℚ) / q := by rw [hα, hβ]; push_cast; field_simp; ring
  have hX : ((⌈α⌉ - ⌈β⌉ : ℤ) : ℚ) < (y : ℚ) / q + 1 := by
    have h1 := Int.ceil_lt_add_one α
    have h2 := Int.le_ceil β
    push_cast
    linarith
  have hQ : (((Finset.Ico a (a + y)).filter (fun x => x ≡ v [MOD q])).card : ℚ) ≤ (y : ℚ) / q + 1 := by
    have h' : ((((Finset.Ico a (a + y)).filter (fun x => x ≡ v [MOD q])).card : ℤ) : ℚ) =
        ((max (⌈α⌉ - ⌈β⌉) 0 : ℤ) : ℚ) := by rw [h]
    push_cast at h'
    rw [h']
    rcases le_total (⌈α⌉ - ⌈β⌉ : ℤ) 0 with hle | hle
    · rw [max_eq_right (by exact_mod_cast hle)]; positivity
    · rw [max_eq_left (by exact_mod_cast hle)]; exact_mod_cast hX.le
  have := (Rat.cast_le (K := ℝ)).mpr hQ
  push_cast at this
  exact this

section OneFactor

variable {CBT : ℝ} {y₀ : ℕ} {M y d₀ : ℕ} {ε : ℝ}

/-- (Q2) for one rich factor: `#{p ∈ [M, M+y) prime : pt ≡ b (d)} ≤ (8C/ε) 4^{ω(d)}/d · #P*`. -/
lemma R_res (hBT : BTWith CBT y₀) (hM : 2 ≤ M) (hyM : M ^ 3 ≤ y ^ 4) (hd₀M : d₀ < M)
    (hd₀y : d₀ ^ 10 ≤ y) (hy₀ : y₀ ≤ y) (hε : 0 < ε)
    (hrich : ε * y / (4 * Real.log M) ≤ (primesIn M (M + y)).card)
    {t d b : ℕ} (ht : Nat.Coprime t d) (hd1 : 1 ≤ d) (hdd : d ≤ d₀) :
    (((primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD d])).card : ℝ) ≤
      8 * CBT / ε * 4 ^ d.primeFactors.card / d * (primesIn M (M + y)).card := by
  have hC := hBT.nonneg
  have hMR : (2 : ℝ) ≤ M := by exact_mod_cast hM
  have hlogM : 0 < Real.log M := Real.log_pos (by linarith)
  have hy1 : 1 ≤ y := by
    rcases Nat.eq_zero_or_pos y with h | h
    · rw [h] at hyM; simp at hyM; omega
    · exact h
  have hyR : (1 : ℝ) ≤ y := by exact_mod_cast hy1
  -- `log M ≤ 2 log y`
  have hlogy : Real.log M ≤ 2 * Real.log y := by
    have h1 : ((M : ℝ)) ^ 3 ≤ (y : ℝ) ^ 4 := by exact_mod_cast hyM
    have h2 := Real.log_le_log (by positivity) h1
    rw [Real.log_pow, Real.log_pow] at h2
    push_cast at h2
    linarith
  have hlogy0 : 0 < Real.log y := by linarith
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd1
  have h4 : (0 : ℝ) ≤ 4 ^ d.primeFactors.card := by positivity
  have hP0 : (0 : ℝ) ≤ (primesIn M (M + y)).card := Nat.cast_nonneg _
  rcases ((primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD d])).eq_empty_or_nonempty with he | ⟨p₀, hp₀⟩
  · rw [he, Finset.card_empty, Nat.cast_zero]
    apply mul_nonneg (div_nonneg (mul_nonneg (div_nonneg (by linarith) hε.le) h4) hdR.le) hP0
  obtain ⟨hp₀P, hp₀b⟩ := Finset.mem_filter.mp hp₀
  have hp₀' := Finset.mem_filter.mp hp₀P
  have hp₀M := (Finset.mem_Ico.mp hp₀'.1).1
  have hp₀d : Nat.Coprime p₀ d := by
    rw [Nat.Prime.coprime_iff_not_dvd hp₀'.2]
    intro h
    have := Nat.le_of_dvd (by omega) h
    omega
  have hsub : (primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD d]) ⊆
      (Finset.Ico M (M + y)).filter (fun p => p.Prime ∧ p % d = p₀ % d) := by
    intro p hp
    obtain ⟨hpP, hpb⟩ := Finset.mem_filter.mp hp
    have hp' := Finset.mem_filter.mp hpP
    refine Finset.mem_filter.mpr ⟨hp'.1, hp'.2, ?_⟩
    have : p * t ≡ p₀ * t [MOD d] := hpb.trans hp₀b.symm
    exact Nat.ModEq.cancel_right_of_coprime (Nat.Coprime.symm ht) this
  have hd10 : d ^ 10 ≤ y := (Nat.pow_le_pow_left hdd 10).trans hd₀y
  have hBT' := hBT M y d p₀ (by omega) hy₀ hd1 hd10 hp₀d
  calc (((primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD d])).card : ℝ)
      ≤ (((Finset.Ico M (M + y)).filter (fun p => p.Prime ∧ p % d = p₀ % d)).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ CBT * 4 ^ d.primeFactors.card * y / (d * Real.log y) := hBT'
    _ ≤ CBT * 4 ^ d.primeFactors.card * y / (d * (Real.log M / 2)) := by
        apply div_le_div_of_nonneg_left (by positivity) (by positivity)
        apply mul_le_mul_of_nonneg_left _ hdR.le
        linarith
    _ = 8 * CBT / ε * 4 ^ d.primeFactors.card / d * (ε * y / (4 * Real.log M)) := by
        field_simp
        ring
    _ ≤ 8 * CBT / ε * 4 ^ d.primeFactors.card / d * (primesIn M (M + y)).card := by
        apply mul_le_mul_of_nonneg_left hrich
        exact div_nonneg (mul_nonneg (div_nonneg (by linarith) hε.le) h4) hdR.le

/-- (Q4) for one rich factor: for a prime `q > d₀` with `q ∤ b`,
`#{p ∈ [M, M+y) prime : pt ≡ b (q)} ≤ 8 log M / (ε d₀) · #P*`. -/
lemma R_big (hM : 2 ≤ M) (hd₀ : 1 ≤ d₀) (hd₀y : d₀ ≤ y) (hε : 0 < ε)
    (hrich : ε * y / (4 * Real.log M) ≤ (primesIn M (M + y)).card)
    {t q b : ℕ} (hq : q.Prime) (hqd : d₀ < q) (hb : ¬ q ∣ b) :
    (((primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD q])).card : ℝ) ≤
      8 * Real.log M / (ε * d₀) * (primesIn M (M + y)).card := by
  have hMR : (2 : ℝ) ≤ M := by exact_mod_cast hM
  have hlogM : 0 < Real.log M := Real.log_pos (by linarith)
  have hd₀R : (1 : ℝ) ≤ d₀ := by exact_mod_cast hd₀
  have hP0 : (0 : ℝ) ≤ (primesIn M (M + y)).card := Nat.cast_nonneg _
  have hcoef : 0 ≤ 8 * Real.log M / (ε * d₀) := by positivity
  rcases ((primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD q])).eq_empty_or_nonempty with he | ⟨p₀, hp₀⟩
  · rw [he, Finset.card_empty, Nat.cast_zero]; positivity
  obtain ⟨hp₀P, hp₀b⟩ := Finset.mem_filter.mp hp₀
  -- `q ∤ t`
  have hqt : ¬ q ∣ t := by
    intro h
    have h1 : p₀ * t ≡ 0 [MOD q] := Nat.modEq_zero_iff_dvd.mpr (Dvd.dvd.mul_left h p₀)
    exact hb (Nat.modEq_zero_iff_dvd.mp (hp₀b.symm.trans h1))
  have hqt' : Nat.gcd q t = 1 := (Nat.Prime.coprime_iff_not_dvd hq).mpr hqt
  have hsub : (primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD q]) ⊆
      (Finset.Ico M (M + y)).filter (fun p => p ≡ p₀ [MOD q]) := by
    intro p hp
    obtain ⟨hpP, hpb⟩ := Finset.mem_filter.mp hp
    refine Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hpP).1, ?_⟩
    exact Nat.ModEq.cancel_right_of_coprime hqt' (hpb.trans hp₀b.symm)
  have hqR : (d₀ : ℝ) < q := by exact_mod_cast hqd
  have hyR : (d₀ : ℝ) ≤ y := by exact_mod_cast hd₀y
  calc (((primesIn M (M + y)).filter (fun p => p * t ≡ b [MOD q])).card : ℝ)
      ≤ (((Finset.Ico M (M + y)).filter (fun p => p ≡ p₀ [MOD q])).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ y / q + 1 := card_Ico_modEq_le M y q p₀ hq.pos
    _ ≤ y / d₀ + y / d₀ := by
        have h1 : (y : ℝ) / q ≤ y / d₀ :=
          div_le_div_of_nonneg_left (Nat.cast_nonneg _) (by linarith) hqR.le
        have h2 : (1 : ℝ) ≤ y / d₀ := by rw [le_div_iff₀ (by linarith)]; linarith
        linarith
    _ = 8 * Real.log M / (ε * d₀) * (ε * y / (4 * Real.log M)) := by
        field_simp
        ring
    _ ≤ 8 * Real.log M / (ε * d₀) * (primesIn M (M + y)).card :=
        mul_le_mul_of_nonneg_left hrich hcoef

/-- (Q3) for one rich factor: if `Y ≤ Mt < 2Y` then
`#{p ∈ [M, M+y) prime : |pt - u| < 2ρY} ≤ 4ρ · (64 C k/ε) · #P*`. -/
lemma R_int (hBT : BTWith CBT y₀) (hM : 2 ≤ M) (hε : 0 < ε)
    (hrich : ε * y / (4 * Real.log M) ≤ (primesIn M (M + y)).card)
    {k : ℕ} (hk : M ≤ 8 * k * y) {ρ : ℝ} (hρ : 0 < ρ) (hρM : 1 ≤ ρ ^ 4 * M)
    (hy₀ρ : (y₀ : ℝ) ≤ 2 * ρ * M) {t : ℕ} {Y : ℝ} (hYt : Y ≤ M * t) (hYt' : (M : ℝ) * t < 2 * Y)
    (u : ℝ) :
    (((primesIn M (M + y)).filter (fun p => |((p * t : ℕ) : ℝ) - u| < 2 * ρ * Y)).card : ℝ) ≤
      4 * ρ * (64 * CBT * k / ε) * (primesIn M (M + y)).card := by
  have hC := hBT.nonneg
  have hMR : (2 : ℝ) ≤ M := by exact_mod_cast hM
  have hlogM : 0 < Real.log M := Real.log_pos (by linarith)
  have htpos : 0 < t := by
    rcases Nat.eq_zero_or_pos t with h | h
    · rw [h] at hYt hYt'; simp at hYt hYt'; linarith
    · exact h
  have htR : (0 : ℝ) < t := by exact_mod_cast htpos
  have hYpos : 0 < Y := by nlinarith
  have hk1 : 1 ≤ k := by
    rcases Nat.eq_zero_or_pos k with h | h
    · rw [h] at hk; simp at hk; omega
    · exact h
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk1
  have hkyR : (M : ℝ) ≤ 8 * k * y := by exact_mod_cast hk
  -- `ρM ≥ 1` and `(ρM)^4 ≥ M^3`
  have hρM4 : (M : ℝ) ^ 3 ≤ (ρ * M) ^ 4 := by
    have : (ρ * M) ^ 4 = ρ ^ 4 * M * M ^ 3 := by ring
    rw [this]; nlinarith [pow_pos (by linarith : (0 : ℝ) < M) 3]
  have hρM1 : 1 ≤ ρ * M := by
    by_contra h
    push Not at h
    have h1 : (ρ * M) ^ 4 < 1 := pow_lt_one₀ (by positivity) h (by norm_num)
    have h2 : (1 : ℝ) ≤ (M : ℝ) ^ 3 := one_le_pow₀ (by linarith)
    linarith
  set L : ℝ := 4 * ρ * Y / t with hL
  set a : ℝ := (u - 2 * ρ * Y) / t with ha
  set u' : ℕ := ⌊a⌋₊ + 1 with hu'
  set y' : ℕ := ⌈L⌉₊ with hy'
  have hL0 : 0 ≤ L := by positivity
  have hLM : L ≤ 4 * ρ * M := by
    rw [hL, div_le_iff₀ htR]; nlinarith
  have hLM' : 2 * ρ * M < L := by
    rw [hL, lt_div_iff₀ htR]; nlinarith
  have hy'L : L ≤ y' := Nat.le_ceil L
  have hy'L' : (y' : ℝ) < L + 1 := Nat.ceil_lt_add_one hL0
  have hy'ub : (y' : ℝ) ≤ 5 * ρ * M := by linarith
  have hy'ge : ρ * M ≤ (y' : ℝ) := by nlinarith
  have hy'1 : 1 ≤ y' := by
    have : (1 : ℝ) ≤ y' := by linarith
    exact_mod_cast this
  have hy'₀ : y₀ ≤ y' := by
    have : (y₀ : ℝ) ≤ y' := by linarith
    exact_mod_cast this
  -- `log y' ≥ (3/4) log M`
  have hlogy' : 3 * Real.log M ≤ 4 * Real.log y' := by
    have h1 : Real.log ((M : ℝ) ^ 3) ≤ Real.log ((ρ * M) ^ 4) :=
      Real.log_le_log (by positivity) hρM4
    rw [Real.log_pow, Real.log_pow] at h1
    have h2 : Real.log (ρ * M) ≤ Real.log y' := Real.log_le_log (by positivity) hy'ge
    push_cast at h1
    linarith
  have hlogy'0 : 0 < Real.log y' := by linarith
  -- the covering interval
  have hsub : (primesIn M (M + y)).filter (fun p => |((p * t : ℕ) : ℝ) - u| < 2 * ρ * Y) ⊆
      (Finset.Ico u' (u' + y')).filter (fun p => p.Prime ∧ p % 1 = 0 % 1) := by
    intro p hp
    obtain ⟨hpP, hpu⟩ := Finset.mem_filter.mp hp
    have hpp := (Finset.mem_filter.mp hpP).2
    rw [abs_lt] at hpu
    push_cast at hpu
    have h1 : a < p := by rw [ha, div_lt_iff₀ htR]; linarith
    have h2 : (p : ℝ) < a + L := by
      rw [ha, hL, ← add_div, lt_div_iff₀ htR]; linarith
    refine Finset.mem_filter.mpr ⟨Finset.mem_Ico.mpr ⟨?_, ?_⟩, hpp, by rw [Nat.mod_one, Nat.zero_mod]⟩
    · have := (Nat.floor_lt' hpp.ne_zero).mpr h1
      omega
    · have h3 := Nat.lt_floor_add_one a
      have hu'R : ((u' + y' : ℕ) : ℝ) = (⌊a⌋₊ : ℝ) + 1 + y' := by rw [hu']; push_cast; ring
      have h4 : (p : ℝ) < ((u' + y' : ℕ) : ℝ) := by rw [hu'R]; linarith
      exact_mod_cast h4
  have hBT' := hBT u' y' 1 0 (by omega) hy'₀ le_rfl (by simpa using hy'1)
    (Nat.coprime_zero_left 1 |>.mpr rfl)
  simp only [Nat.primeFactors_one, Finset.card_empty, pow_zero, mul_one, Nat.cast_one,
    one_mul] at hBT'
  have hP : ε * M / (32 * k * Real.log M) ≤ (primesIn M (M + y)).card := by
    refine le_trans ?_ hrich
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have : (0 : ℝ) ≤ ε * Real.log M := by positivity
    nlinarith
  calc (((primesIn M (M + y)).filter (fun p => |((p * t : ℕ) : ℝ) - u| < 2 * ρ * Y)).card : ℝ)
      ≤ (((Finset.Ico u' (u' + y')).filter (fun p => p.Prime ∧ p % 1 = 0 % 1)).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ CBT * y' / Real.log y' := hBT'
    _ ≤ CBT * (5 * ρ * M) / (3 / 4 * Real.log M) := by
        apply div_le_div₀ (by positivity) (by gcongr) (by positivity) (by linarith)
    _ ≤ 4 * ρ * (64 * CBT * k / ε) * (ε * M / (32 * k * Real.log M)) := by
        rw [div_le_iff₀ (by positivity)]
        have e : 4 * ρ * (64 * CBT * k / ε) * (ε * M / (32 * k * Real.log M)) *
            (3 / 4 * Real.log M) = 6 * (CBT * ρ * M) := by
          field_simp; ring
        rw [e]
        have : 0 ≤ CBT * ρ * M := by positivity
        nlinarith
    _ ≤ 4 * ρ * (64 * CBT * k / ε) * (primesIn M (M + y)).card :=
        mul_le_mul_of_nonneg_left hP (by positivity)

end OneFactor

/-- Lifting a per-cofactor bound to the product set `{p t : p ∈ A, t ∈ R}`. -/
lemma card_filter_image_mul_le {A R : Finset ℕ}
    (hinj : Set.InjOn (fun q : ℕ × ℕ => q.1 * q.2) ((A ×ˢ R : Finset (ℕ × ℕ)) : Set (ℕ × ℕ)))
    (cond : ℕ → Prop) [DecidablePred cond] {B : ℝ}
    (hB : ∀ t ∈ R, ((A.filter (fun p => cond (p * t))).card : ℝ) ≤ B * A.card) :
    ((((A ×ˢ R).image (fun q : ℕ × ℕ => q.1 * q.2)).filter cond).card : ℝ) ≤
      B * ((A ×ˢ R).image (fun q : ℕ × ℕ => q.1 * q.2)).card := by
  rw [Finset.filter_image, Finset.card_image_of_injOn (hinj.mono (by
      intro q hq
      exact Finset.mem_coe.mpr (Finset.mem_of_mem_filter q (Finset.mem_coe.mp hq)))),
    Finset.card_image_of_injOn hinj, Finset.card_product]
  have e : ((A ×ˢ R).filter (fun q : ℕ × ℕ => cond (q.1 * q.2))).card =
      ∑ t ∈ R, (A.filter (fun p => cond (p * t))).card := by
    rw [Finset.card_filter, Finset.sum_product, Finset.sum_comm]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [Finset.card_filter]
  rw [e]
  push_cast
  calc ∑ t ∈ R, ((A.filter (fun p => cond (p * t))).card : ℝ) ≤ ∑ t ∈ R, B * A.card :=
        Finset.sum_le_sum hB
    _ = B * (A.card * R.card) := by rw [Finset.sum_const, nsmul_eq_mul]; ring

section LemmaRbox

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The box splits as `{p t : p ∈ P i₀, t ∈ box of the other factors}`. -/
lemma boxProd_eq_image_mul (P : ι → Finset ℕ) (i₀ : ι) :
    boxProd P = ((P i₀) ×ˢ boxProd (fun j : {j // j ≠ i₀} => P j.1)).image
      (fun q : ℕ × ℕ => q.1 * q.2) := by
  ext x
  simp only [boxProd, Finset.mem_image, Finset.mem_product, Fintype.mem_piFinset, Prod.exists]
  constructor
  · rintro ⟨f, hf, rfl⟩
    refine ⟨f i₀, ∏ j : {j // j ≠ i₀}, f j.1, ⟨hf i₀, fun j => f j.1, fun j => hf j.1, rfl⟩, ?_⟩
    rw [Fintype.prod_eq_mul_prod_subtype_ne f i₀]
  · rintro ⟨p, t, ⟨hp, g, hg, rfl⟩, rfl⟩
    refine ⟨fun i => if h : i = i₀ then p else g ⟨i, h⟩, fun i => ?_, ?_⟩
    · by_cases h : i = i₀
      · subst h; simpa using hp
      · simpa [h] using hg ⟨i, h⟩
    · rw [Fintype.prod_eq_mul_prod_subtype_ne _ i₀]
      simp only [dite_true]
      congr 1
      refine Finset.prod_congr rfl fun j _ => ?_
      rw [dif_neg j.2]

lemma exp_quarter_lt_two : Real.exp (1 / 4) < 2 := by
  have h1 : Real.exp (1 / 4) ^ 4 = Real.exp 1 := by
    rw [← Real.exp_nat_mul]; norm_num
  have h2 : Real.exp 1 < 16 := by have := Real.exp_one_lt_d9; linarith
  by_contra h
  push Not at h
  have : (2 : ℝ) ^ 4 ≤ Real.exp (1 / 4) ^ 4 := pow_le_pow_left₀ (by norm_num) h 4
  linarith

/-- `(1 + 1/(4k))^n < 2` for `n ≤ k`. -/
lemma one_add_pow_lt_two {n k : ℕ} (hk : 1 ≤ k) (hn : n ≤ k) :
    (1 + 1 / (4 * (k : ℝ))) ^ n < 2 := by
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  calc (1 + 1 / (4 * (k : ℝ))) ^ n ≤ (1 + 1 / (4 * (k : ℝ))) ^ k :=
        pow_le_pow_right₀ (by have : 0 ≤ 1 / (4 * (k : ℝ)) := by positivity
                              linarith) hn
    _ ≤ Real.exp (1 / (4 * (k : ℝ))) ^ k := by
        apply pow_le_pow_left₀ (by positivity)
        have := Real.add_one_le_exp (1 / (4 * (k : ℝ)))
        linarith
    _ = Real.exp (1 / 4) := by
        rw [← Real.exp_nat_mul]; congr 1; field_simp
    _ < 2 := exp_quarter_lt_two

/-- **Lemma R** (distribution of a box with one `ε`-rich factor, assuming (BT)). Let
`I_i = [lo i, hi i)` (`i ∈ ι`, `|ι| ≤ k`) be pairwise disjoint with `4k(hi i - lo i) ≤ lo i`,
`d₀ < lo i`, and let `P_i` be the primes in `I_i`, `P = {∏ p_i}` and `Y = ∏ lo i`. For the factor
`i₀` put `M = lo i₀`, `y = hi i₀ - lo i₀` and assume `M ≥ 2`, `M ≤ 8ky`, `M³ ≤ y⁴`,
`d₀^{10} ≤ y`, `y₀ ≤ y`, `ρ⁴M ≥ 1`, `y₀ ≤ 2ρM` and the richness `#P_{i₀} ≥ εy/(4 log M)`.
Then `P` satisfies (Q0)–(Q4) with `κ = ∑ 1/|P_i|`, `K_res = 8C/ε`, `K_int = 64Ck/ε`,
`β = 8 log M/(ε d₀)`. -/
theorem lemmaR {lo hi : ι → ℕ} {k : ℕ} (hk : Fintype.card ι ≤ k) (hlohi : ∀ i, lo i ≤ hi i)
    (hwidth : ∀ i, 4 * k * (hi i - lo i) ≤ lo i)
    (hdisj : ∀ i j, i ≠ j → hi i ≤ lo j ∨ hi j ≤ lo i)
    {d₀ : ℕ} (hd₀ : 1 ≤ d₀) (hd₀lo : ∀ i, d₀ < lo i)
    (i₀ : ι) {CBT : ℝ} {y₀ : ℕ} (hBT : BTWith CBT y₀) {ε ρ : ℝ} (hε : 0 < ε) (hρ : 0 < ρ)
    (hM : 2 ≤ lo i₀) (hwide : lo i₀ ≤ 8 * k * (hi i₀ - lo i₀))
    (hyM : lo i₀ ^ 3 ≤ (hi i₀ - lo i₀) ^ 4) (hd₀y : d₀ ^ 10 ≤ hi i₀ - lo i₀)
    (hy₀ : y₀ ≤ hi i₀ - lo i₀) (hρM : 1 ≤ ρ ^ 4 * lo i₀) (hy₀ρ : (y₀ : ℝ) ≤ 2 * ρ * lo i₀)
    (hrich : ε * ((hi i₀ - lo i₀ : ℕ) : ℝ) / (4 * Real.log (lo i₀)) ≤
      (primesIn (lo i₀) (hi i₀)).card) :
    QHyp (boxProd (fun i => primesIn (lo i) (hi i))) (∏ i, (lo i : ℝ)) d₀ ρ
      (∑ i, 1 / ((primesIn (lo i) (hi i)).card : ℝ)) (8 * CBT / ε) (64 * CBT * k / ε)
      (8 * Real.log (lo i₀) / (ε * d₀)) := by
  classical
  have hPprime : ∀ i, ∀ p ∈ primesIn (lo i) (hi i), p.Prime := fun i p hp =>
    (Finset.mem_filter.mp hp).2
  have hPmem : ∀ i, ∀ p ∈ primesIn (lo i) (hi i), lo i ≤ p ∧ p < hi i := fun i p hp =>
    Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1
  have hPdisj : ∀ i j, i ≠ j → Disjoint (primesIn (lo i) (hi i)) (primesIn (lo j) (hi j)) := by
    intro i j hij
    rw [Finset.disjoint_left]
    intro p hpi hpj
    have h1 := hPmem i p hpi
    have h2 := hPmem j p hpj
    rcases hdisj i j hij with h | h <;> omega
  have hk1 : 1 ≤ k := by
    have : 0 < Fintype.card ι := Fintype.card_pos_iff.mpr ⟨i₀⟩
    omega
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk1
  -- `hi i ≤ (1 + 1/(4k)) lo i`
  have hhi : ∀ i, (hi i : ℝ) ≤ (1 + 1 / (4 * (k : ℝ))) * lo i := by
    intro i
    have h := hwidth i
    have h' : (4 * k : ℝ) * ((hi i : ℝ) - lo i) ≤ lo i := by
      have := (Nat.cast_le (α := ℝ)).mpr h
      push_cast [Nat.cast_sub (hlohi i)] at this
      linarith
    have : (hi i : ℝ) - lo i ≤ lo i / (4 * k) := by
      rw [le_div_iff₀ (by positivity)]; linarith
    have e : (1 + 1 / (4 * (k : ℝ))) * lo i = lo i + lo i / (4 * k) := by ring
    rw [e]; linarith
  have hlo0 : ∀ i, (0 : ℝ) ≤ lo i := fun i => Nat.cast_nonneg _
  have hYpos : (0 : ℝ) < ∏ i, (lo i : ℝ) :=
    Finset.prod_pos fun i _ => by have := hd₀lo i; exact_mod_cast (by omega : 0 < lo i)
  have hprod_hi : ∏ i, (hi i : ℝ) < 2 * ∏ i, (lo i : ℝ) := by
    calc ∏ i, (hi i : ℝ) ≤ ∏ i, ((1 + 1 / (4 * (k : ℝ))) * lo i) :=
          Finset.prod_le_prod (fun i _ => Nat.cast_nonneg _) (fun i _ => hhi i)
      _ = (1 + 1 / (4 * (k : ℝ))) ^ Fintype.card ι * ∏ i, (lo i : ℝ) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ]
      _ < 2 * ∏ i, (lo i : ℝ) := by
          apply mul_lt_mul_of_pos_right (one_add_pow_lt_two hk1 hk) hYpos
  -- membership bounds for the box
  have hbox : ∀ x ∈ boxProd (fun i => primesIn (lo i) (hi i)),
      ∏ i, (lo i : ℝ) ≤ x ∧ (x : ℝ) ≤ ∏ i, (hi i : ℝ) := by
    intro x hx
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hx
    have hf' := Fintype.mem_piFinset.mp hf
    push_cast
    constructor
    · exact Finset.prod_le_prod (fun i _ => Nat.cast_nonneg _)
        (fun i _ => by exact_mod_cast (hPmem i _ (hf' i)).1)
    · exact Finset.prod_le_prod (fun i _ => Nat.cast_nonneg _)
        (fun i _ => by exact_mod_cast (hPmem i _ (hf' i)).2.le)
  -- the cofactors
  set R := boxProd (fun j : {j // j ≠ i₀} => primesIn (lo j.1) (hi j.1)) with hRdef
  have hsplit := boxProd_eq_image_mul (fun i => primesIn (lo i) (hi i)) i₀
  have hRprop : ∀ t ∈ R, (∀ q : ℕ, q.Prime → q ∣ t → d₀ < q ∧ q ∉ primesIn (lo i₀) (hi i₀)) ∧
      (∏ i, (lo i : ℝ)) ≤ lo i₀ * t ∧ (lo i₀ : ℝ) * t < 2 * ∏ i, (lo i : ℝ) := by
    intro t ht
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp ht
    have hg' := Fintype.mem_piFinset.mp hg
    refine ⟨fun q hq hqt => ?_, ?_, ?_⟩
    · obtain ⟨j, rfl⟩ := (prime_dvd_prod_iff (P := fun j : {j // j ≠ i₀} => primesIn (lo j.1) (hi j.1))
        (fun j p hp => hPprime j.1 p hp) hg hq).mp hqt
      refine ⟨lt_of_lt_of_le (hd₀lo j.1) (hPmem j.1 _ (hg' j)).1, fun hmem => ?_⟩
      exact j.2 (mem_of_mem_of_disj hPdisj (hg' j) hmem)
    · rw [Fintype.prod_eq_mul_prod_subtype_ne (fun i => (lo i : ℝ)) i₀]
      push_cast
      apply mul_le_mul_of_nonneg_left _ (hlo0 i₀)
      exact Finset.prod_le_prod (fun j _ => Nat.cast_nonneg _)
        (fun j _ => by exact_mod_cast (hPmem j.1 _ (hg' j)).1)
    · calc (lo i₀ : ℝ) * ((∏ j : {j // j ≠ i₀}, g j : ℕ) : ℝ)
          ≤ (hi i₀ : ℝ) * ∏ j : {j // j ≠ i₀}, (hi j.1 : ℝ) := by
            push_cast
            apply mul_le_mul (by exact_mod_cast hlohi i₀) _ (by positivity) (Nat.cast_nonneg _)
            exact Finset.prod_le_prod (fun j _ => Nat.cast_nonneg _)
              (fun j _ => by exact_mod_cast (hPmem j.1 _ (hg' j)).2.le)
        _ = ∏ i, (hi i : ℝ) := (Fintype.prod_eq_mul_prod_subtype_ne (fun i => (hi i : ℝ)) i₀).symm
        _ < 2 * ∏ i, (lo i : ℝ) := hprod_hi
  have hinj : Set.InjOn (fun q : ℕ × ℕ => q.1 * q.2)
      ((primesIn (lo i₀) (hi i₀) ×ˢ R : Finset (ℕ × ℕ)) : Set (ℕ × ℕ)) := by
    rintro ⟨p, t⟩ hpt ⟨p', t'⟩ hpt' h
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at hpt hpt'
    simp only at h
    have hp := hPprime i₀ p hpt.1
    have hp' := hPprime i₀ p' hpt'.1
    have hdvd : p ∣ p' * t' := h ▸ Dvd.intro t rfl
    have hpp' : p = p' := by
      rcases (Nat.Prime.dvd_mul hp).mp hdvd with h1 | h1
      · exact (Nat.prime_dvd_prime_iff_eq hp hp').mp h1
      · exact absurd hpt.1 ((hRprop t' hpt'.2).1 p hp h1).2
    subst hpp'
    have : t = t' := Nat.eq_of_mul_eq_mul_left hp.pos h
    rw [this]
  -- the parameters of the rich factor
  have hhi₀ : hi i₀ = lo i₀ + (hi i₀ - lo i₀) := by have := hlohi i₀; omega
  have hrich' : ε * ((hi i₀ - lo i₀ : ℕ) : ℝ) / (4 * Real.log (lo i₀)) ≤
      (primesIn (lo i₀) (lo i₀ + (hi i₀ - lo i₀))).card := by rw [← hhi₀]; exact hrich
  have hd₀M : d₀ < lo i₀ := hd₀lo i₀
  have hd₀y' : d₀ ≤ hi i₀ - lo i₀ := by
    have h1 : d₀ ≤ d₀ ^ 10 := Nat.le_self_pow (by norm_num) d₀
    omega
  refine ⟨?_, ?_, lemmaC_coll hPprime hPdisj, ?_, ?_, ?_⟩
  · -- `Y ≤ x ≤ 2Y`
    intro x hx
    have := hbox x hx
    exact ⟨this.1, by linarith [this.2]⟩
  · -- prime factors exceed `d₀`
    intro x hx q hq hqx
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨i, rfl⟩ := (prime_dvd_prod_iff hPprime hf hq).mp hqx
    exact lt_of_lt_of_le (hd₀lo i) (hPmem i _ (Fintype.mem_piFinset.mp hf i)).1
  · -- (Q2)
    intro d b hd1 hdd _
    rw [hsplit]
    apply card_filter_image_mul_le hinj (fun x => x ≡ b [MOD d])
    intro t ht
    have htd : Nat.Coprime t d := coprime_of_pf (fun q hq hqt => ((hRprop t ht).1 q hq hqt).1) hd1 hdd
    have := R_res (M := lo i₀) (y := hi i₀ - lo i₀) hBT hM hyM hd₀M hd₀y hy₀ hε hrich' (b := b) htd hd1 hdd
    rw [← hhi₀] at this
    calc _ ≤ _ := this
      _ = 8 * CBT / ε * 4 ^ d.primeFactors.card / d * (primesIn (lo i₀) (hi i₀)).card := rfl
  · -- (Q3)
    intro u
    rw [hsplit]
    apply card_filter_image_mul_le hinj (fun x : ℕ => |(x : ℝ) - u| < 2 * ρ * ∏ i, (lo i : ℝ))
    intro t ht
    have h := hRprop t ht
    have := R_int (M := lo i₀) (y := hi i₀ - lo i₀) hBT hM hε hrich' hwide hρ hρM hy₀ρ
      h.2.1 h.2.2 u
    rw [← hhi₀] at this
    exact this
  · -- (Q4)
    intro q hq hqd b hb
    rw [hsplit]
    apply card_filter_image_mul_le hinj (fun x => x ≡ b [MOD q])
    intro t _
    have := R_big (M := lo i₀) (y := hi i₀ - lo i₀) (t := t) hM hd₀ hd₀y' hε hrich' hq hqd hb
    rw [← hhi₀] at this
    exact this

/-- **Lemma R ⟹ Lemma Q**, in `FPDProp` form: the chain used in the (5.10) analysis. With the
constants of `lemmaR` plugged into (Q5), the squares `{x² - c}` of a box with one `ε`-rich factor
satisfy `FPD(S_c, T, 4Y², η, V₀, 2V₀/(ρ√(2η)))`, `Y = ∏ lo i`. -/
theorem lemmaRQ_FPD {lo hi : ι → ℕ} {k : ℕ} (hk : Fintype.card ι ≤ k)
    (hlohi : ∀ i, lo i ≤ hi i) (hwidth : ∀ i, 4 * k * (hi i - lo i) ≤ lo i)
    (hdisj : ∀ i j, i ≠ j → hi i ≤ lo j ∨ hi j ≤ lo i)
    (hne : ∀ i, (primesIn (lo i) (hi i)).Nonempty)
    {d₀ : ℕ} (hd₀ : 2 ≤ d₀) (hd₀lo : ∀ i, d₀ < lo i)
    (i₀ : ι) {CBT : ℝ} {y₀ : ℕ} (hBT : BTWith CBT y₀) {ε ρ : ℝ} (hε : 0 < ε) (hρ : 0 < ρ)
    (hM : 2 ≤ lo i₀) (hwide : lo i₀ ≤ 8 * k * (hi i₀ - lo i₀))
    (hyM : lo i₀ ^ 3 ≤ (hi i₀ - lo i₀) ^ 4) (hd₀y : d₀ ^ 10 ≤ hi i₀ - lo i₀)
    (hy₀ : y₀ ≤ hi i₀ - lo i₀) (hρM : 1 ≤ ρ ^ 4 * lo i₀) (hy₀ρ : (y₀ : ℝ) ≤ 2 * ρ * lo i₀)
    (hrich : ε * ((hi i₀ - lo i₀ : ℕ) : ℝ) / (4 * Real.log (lo i₀)) ≤
      (primesIn (lo i₀) (hi i₀)).card)
    {V₀ : ℕ} {η : ℝ} (hη : 0 < η) (hV₀ : 1 ≤ V₀) (hVd : V₀ ^ 2 ≤ d₀)
    (hQ5 : 4 * ρ * (64 * CBT * k / ε) + ∑ i, 1 / ((primesIn (lo i) (hi i)).card : ℝ) +
      4 * CR * (8 * CBT / ε) ^ 2 / Real.sqrt V₀ +
      2 * (8 * Real.log (lo i₀) / (ε * d₀)) * Real.log (4 * ((∏ i, lo i : ℕ) : ℝ) ^ 2) /
        Real.log d₀ < η ^ 3 / 8)
    (c : ℤ) {T : ℕ} (hT : 16 * ((∏ i, lo i : ℕ) : ℝ) ^ 2 < T * Real.sqrt (2 * η)) :
    FPDProp ((boxProd (fun i => primesIn (lo i) (hi i))).image (fun x : ℕ => (x : ℤ) ^ 2 - c))
      T (4 * (∏ i, lo i) ^ 2) η V₀ (2 * V₀ / (ρ * Real.sqrt (2 * η))) := by
  have hR := lemmaR hk hlohi hwidth hdisj (by omega) hd₀lo i₀ hBT hε hρ hM hwide hyM hd₀y hy₀
    hρM hy₀ρ hrich
  have hY : ((∏ i, lo i : ℕ) : ℝ) = ∏ i, (lo i : ℝ) := by push_cast; rfl
  rw [← hY] at hR
  have hPne : (boxProd (fun i => primesIn (lo i) (hi i))).Nonempty :=
    (Fintype.piFinset_nonempty.mpr hne).image _
  have hY1 : 1 ≤ ∏ i, lo i := by
    have : 0 < ∏ i, lo i := Finset.prod_pos (fun i _ => by have := hd₀lo i; omega)
    omega
  exact lemmaQ_FPD hPne hY1 hR hη hρ hV₀ hVd hd₀ hQ5 c hT

end LemmaRbox

end LemmaR

section LemmaSel

/-- `primesIn A B ∪ primesIn B C = primesIn A C` for `A ≤ B ≤ C` (disjoint union). -/
lemma sum_primesIn_split (f : ℕ → ℝ) {A B C : ℕ} (hAB : A ≤ B) (hBC : B ≤ C) :
    ∑ p ∈ primesIn A C, f p = ∑ p ∈ primesIn A B, f p + ∑ p ∈ primesIn B C, f p := by
  unfold primesIn
  rw [← Finset.Ico_union_Ico_eq_Ico hAB hBC, Finset.filter_union, Finset.sum_union]
  exact Finset.disjoint_filter_filter (Finset.Ico_disjoint_Ico_consecutive A B C)

lemma mono_of_succ (a : ℕ → ℕ) (m : ℕ) (ha : ∀ i < m, a i ≤ a (i + 1)) :
    ∀ i ≤ m, a 0 ≤ a i := by
  intro i hi
  induction i with
  | zero => exact le_rfl
  | succ n ihn => exact (ihn (by omega)).trans (ha n (by omega))

/-- **Tiling.** For `a` monotone on `[0, m]`, the pieces `[a i, a (i+1))` tile `[a 0, a m)`. -/
lemma sum_pieces (f : ℕ → ℝ) (a : ℕ → ℕ) (m : ℕ) (ha : ∀ i < m, a i ≤ a (i + 1)) :
    ∑ i ∈ Finset.range m, ∑ p ∈ primesIn (a i) (a (i + 1)), f p =
      ∑ p ∈ primesIn (a 0) (a m), f p := by
  induction m with
  | zero => simp [primesIn]
  | succ m ih =>
    have ha' : ∀ i < m, a i ≤ a (i + 1) := fun i hi => ha i (by omega)
    have hmono : a 0 ≤ a m := mono_of_succ a m ha' m le_rfl
    rw [Finset.sum_range_succ, ih ha', sum_primesIn_split f hmono (ha m (by omega))]

/-- `log log` length of the piece `[a i, a (i+1))`. -/
noncomputable def pieceE (a : ℕ → ℕ) (i : ℕ) : ℝ :=
  Real.log (Real.log (a (i + 1))) - Real.log (Real.log (a i))

/-- Mertens mass `∑_{p ∈ [a i, a (i+1))} 1/p` of the piece. -/
noncomputable def pieceM (a : ℕ → ℕ) (i : ℕ) : ℝ := ∑ p ∈ primesIn (a i) (a (i + 1)), (1 : ℝ) / p

lemma loglog_mono {A B : ℕ} (hA : 3 ≤ A) (hAB : A ≤ B) :
    Real.log (Real.log A) ≤ Real.log (Real.log B) := by
  have hAR : (3 : ℝ) ≤ A := by exact_mod_cast hA
  have hABR : (A : ℝ) ≤ B := by exact_mod_cast hAB
  have h1 : 0 < Real.log A := Real.log_pos (by linarith)
  exact Real.log_le_log h1 (Real.log_le_log (by linarith) hABR)

/-- **Lemma Sel (i).** Non-`ε`-rich pieces carry Mertens mass `≤ ε (log log B - log log A)`. -/
theorem lemmaSel_i (a : ℕ → ℕ) (m : ℕ) (ha0 : 3 ≤ a 0) (ha : ∀ i < m, a i ≤ a (i + 1))
    {ε : ℝ} (hε : 0 ≤ ε) :
    ∑ i ∈ (Finset.range m).filter (fun i => pieceM a i < ε * pieceE a i), pieceM a i ≤
      ε * (Real.log (Real.log (a m)) - Real.log (Real.log (a 0))) := by
  have hge3 : ∀ i ≤ m, 3 ≤ a i := by
    intro i hi
    induction i with
    | zero => exact ha0
    | succ n ihn => exact (ihn (by omega)).trans (ha n (by omega))
  have hE0 : ∀ i ∈ Finset.range m, 0 ≤ pieceE a i := by
    intro i hi
    have hi' := Finset.mem_range.mp hi
    unfold pieceE
    linarith [loglog_mono (hge3 i (by omega)) (ha i hi')]
  calc ∑ i ∈ (Finset.range m).filter (fun i => pieceM a i < ε * pieceE a i), pieceM a i
      ≤ ∑ i ∈ (Finset.range m).filter (fun i => pieceM a i < ε * pieceE a i), ε * pieceE a i :=
        Finset.sum_le_sum fun i hi => (Finset.mem_filter.mp hi).2.le
    _ ≤ ∑ i ∈ Finset.range m, ε * pieceE a i := by
        apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        intro i hi _
        exact mul_nonneg hε (hE0 i hi)
    _ = ε * (Real.log (Real.log (a m)) - Real.log (Real.log (a 0))) := by
        rw [← Finset.mul_sum]
        unfold pieceE
        rw [Finset.sum_range_sub (fun i => Real.log (Real.log (a i)))]

/-- **Lemma Sel (ii).** With Mertens' lower bound and `log log B - log log A ≥ 2 C_M`, the
non-`ε`-rich pieces carry at most a proportion `2ε` of the Mertens mass of `[A, B)`. -/
theorem lemmaSel_ii {CM : ℝ} (hM : MertensLowerWith CM) (a : ℕ → ℕ) (m : ℕ) (ha0 : 3 ≤ a 0)
    (ha : ∀ i < m, a i ≤ a (i + 1)) {ε : ℝ} (hε : 0 ≤ ε)
    (hW : 2 * CM ≤ Real.log (Real.log (a m)) - Real.log (Real.log (a 0))) :
    ∑ i ∈ (Finset.range m).filter (fun i => pieceM a i < ε * pieceE a i), pieceM a i ≤
      2 * ε * ∑ p ∈ primesIn (a 0) (a m), (1 : ℝ) / p := by
  have hmono : a 0 ≤ a m := mono_of_succ a m ha m le_rfl
  have hmert := hM (a 0) (a m) ha0 hmono
  have h1 := lemmaSel_i a m ha0 ha hε
  have h2 : ε * (Real.log (Real.log (a m)) - Real.log (Real.log (a 0))) ≤
      2 * ε * ∑ p ∈ primesIn (a 0) (a m), (1 : ℝ) / p := by
    have : Real.log (Real.log (a m)) - Real.log (Real.log (a 0)) ≤
        2 * ∑ p ∈ primesIn (a 0) (a m), (1 : ℝ) / p := by linarith
    nlinarith
  linarith

/-- **Lemma Sel (iii).** If every piece has ratio `≥ 1 + 1/(8k)`, the pieces with fewer than
`N₀` primes carry Mertens mass `≤ N₀ (8k+1) / A`. -/
theorem lemmaSel_iii (a : ℕ → ℕ) (m k N₀ : ℕ) (ha0 : 1 ≤ a 0) (hk : 1 ≤ k)
    (ha : ∀ i < m, (8 * k + 1) * a i ≤ 8 * k * a (i + 1)) :
    ∑ i ∈ (Finset.range m).filter (fun i => (primesIn (a i) (a (i + 1))).card < N₀), pieceM a i ≤
      N₀ * (8 * k + 1) / a 0 := by
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  set r : ℝ := (8 * k : ℝ) / (8 * k + 1) with hr
  have hr0 : 0 ≤ r := by positivity
  have hr1 : r < 1 := by rw [hr, div_lt_one (by positivity)]; linarith
  have ha0R : (1 : ℝ) ≤ a 0 := by exact_mod_cast ha0
  -- `1/a i ≤ r^i / a 0`
  have hgeo : ∀ i ≤ m, (a 0 : ℝ) ≤ r ^ i * a i := by
    intro i hi
    induction i with
    | zero => simp
    | succ n ihn =>
      have h1 := ihn (by omega)
      have h2 : ((8 * k + 1 : ℕ) : ℝ) * a n ≤ ((8 * k : ℕ) : ℝ) * a (n + 1) := by
        exact_mod_cast ha n (by omega)
      push_cast at h2
      have h3 : (a n : ℝ) ≤ r * a (n + 1) := by
        rw [hr, div_mul_eq_mul_div, le_div_iff₀ (by positivity)]; linarith
      calc (a 0 : ℝ) ≤ r ^ n * a n := h1
        _ ≤ r ^ n * (r * a (n + 1)) := mul_le_mul_of_nonneg_left h3 (pow_nonneg hr0 n)
        _ = r ^ (n + 1) * a (n + 1) := by ring
  have hapos : ∀ i ≤ m, (0 : ℝ) < a i := by
    intro i hi
    have := hgeo i hi
    by_contra h
    push Not at h
    have : r ^ i * (a i : ℝ) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (pow_nonneg hr0 i) h
    linarith
  have hpiece : ∀ i ∈ (Finset.range m).filter (fun i => (primesIn (a i) (a (i + 1))).card < N₀),
      pieceM a i ≤ N₀ * r ^ i / a 0 := by
    intro i hi
    obtain ⟨hi', hcard⟩ := Finset.mem_filter.mp hi
    have hi'' := Finset.mem_range.mp hi'
    have hai := hapos i hi''.le
    unfold pieceM
    calc ∑ p ∈ primesIn (a i) (a (i + 1)), (1 : ℝ) / p
        ≤ ∑ p ∈ primesIn (a i) (a (i + 1)), (1 : ℝ) / a i := by
          apply Finset.sum_le_sum
          intro p hp
          have hp' := (Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1).1
          have : (a i : ℝ) ≤ p := by exact_mod_cast hp'
          exact one_div_le_one_div_of_le hai this
      _ = (primesIn (a i) (a (i + 1))).card / a i := by
          rw [Finset.sum_const, nsmul_eq_mul]; ring
      _ ≤ N₀ / a i := by
          apply div_le_div_of_nonneg_right _ hai.le
          exact_mod_cast hcard.le
      _ ≤ N₀ * r ^ i / a 0 := by
          rw [div_le_div_iff₀ hai (by linarith)]
          have := hgeo i hi''.le
          have hN : (0 : ℝ) ≤ N₀ := Nat.cast_nonneg _
          nlinarith
  calc ∑ i ∈ (Finset.range m).filter (fun i => (primesIn (a i) (a (i + 1))).card < N₀), pieceM a i
      ≤ ∑ i ∈ (Finset.range m).filter (fun i => (primesIn (a i) (a (i + 1))).card < N₀),
          N₀ * r ^ i / a 0 := Finset.sum_le_sum hpiece
    _ ≤ ∑ i ∈ Finset.range m, N₀ * r ^ i / a 0 := by
        apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        intro i _ _
        positivity
    _ = N₀ / a 0 * ∑ i ∈ Finset.range m, r ^ i := by
        rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun i _ => by ring
    _ ≤ N₀ / a 0 * (8 * k + 1) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        rw [geom_sum_eq hr1.ne]
        have h1 : (r ^ m - 1) / (r - 1) = (1 - r ^ m) / (1 - r) := by
          rw [← neg_div_neg_eq]; ring_nf
        rw [h1, div_le_iff₀ (by linarith)]
        have h2 : 0 ≤ r ^ m := pow_nonneg hr0 m
        have h3 : (8 * k + 1) * (1 - r) = 1 := by
          rw [hr]; field_simp; ring
        nlinarith
    _ = N₀ * (8 * k + 1) / a 0 := by ring

/-- `x/(1+x) ≤ log(1+x)` for `x ≥ 0`. -/
lemma div_one_add_le_log {x : ℝ} (hx : 0 ≤ x) : x / (1 + x) ≤ Real.log (1 + x) := by
  have h := Real.log_le_sub_one_of_pos (show (0 : ℝ) < (1 + x)⁻¹ by positivity)
  rw [Real.log_inv] at h
  have e : (1 + x)⁻¹ - 1 = -(x / (1 + x)) := by field_simp; ring
  linarith

/-- **Lemma Sel (iv).** An `ε`-rich piece `[A, B)` with `3 ≤ A < B ≤ 2A` contains at least
`ε (B - A) / (4 log A)` primes. -/
theorem lemmaSel_iv {A B : ℕ} (hA : 3 ≤ A) (hAB : A < B) (hB : B ≤ 2 * A) {ε : ℝ} (hε : 0 ≤ ε)
    (hrich : ε * (Real.log (Real.log B) - Real.log (Real.log A)) ≤
      ∑ p ∈ primesIn A B, (1 : ℝ) / p) :
    ε * ((B - A : ℕ) : ℝ) / (4 * Real.log A) ≤ (primesIn A B).card := by
  have hAR : (3 : ℝ) ≤ A := by exact_mod_cast hA
  have hABR : (A : ℝ) < B := by exact_mod_cast hAB
  have hBR : (B : ℝ) ≤ 2 * A := by exact_mod_cast hB
  have hlogA : 0 < Real.log A := Real.log_pos (by linarith)
  have hlogA1 : Real.log 2 ≤ Real.log A := Real.log_le_log (by norm_num) (by linarith)
  have hBA : ((B - A : ℕ) : ℝ) = B - A := by rw [Nat.cast_sub hAB.le]
  set η : ℝ := ((B : ℝ) - A) / A with hη
  have hη0 : 0 ≤ η := by rw [hη]; exact div_nonneg (by linarith) (by linarith)
  have hη1 : η ≤ 1 := by rw [hη, div_le_one (by linarith)]; linarith
  -- `log B - log A ≥ η/2`
  have h1 : η / 2 ≤ Real.log B - Real.log A := by
    have hB' : (B : ℝ) = A * (1 + η) := by rw [hη]; field_simp; ring
    rw [hB', Real.log_mul (by linarith) (by linarith), add_sub_cancel_left]
    have := div_one_add_le_log hη0
    have : η / 2 ≤ η / (1 + η) := div_le_div_of_nonneg_left hη0 (by linarith) (by linarith)
    linarith
  -- `log log B - log log A ≥ (log B - log A)/(2 log A)`
  have h2 : (Real.log B - Real.log A) / (2 * Real.log A) ≤
      Real.log (Real.log B) - Real.log (Real.log A) := by
    set x := (Real.log B - Real.log A) / Real.log A with hx
    have hx0 : 0 ≤ x := by
      rw [hx]; apply div_nonneg _ hlogA.le
      linarith [Real.log_le_log (by linarith) hABR.le]
    have hx1 : x ≤ 1 := by
      rw [hx, div_le_one hlogA]
      have : Real.log B ≤ Real.log (2 * A) := Real.log_le_log (by linarith) hBR
      rw [Real.log_mul (by norm_num) (by linarith)] at this
      linarith
    have hlogB : Real.log B = Real.log A * (1 + x) := by rw [hx]; field_simp; ring
    rw [hlogB, Real.log_mul hlogA.ne' (by linarith), add_sub_cancel_left]
    have := div_one_add_le_log hx0
    have : x / 2 ≤ x / (1 + x) := div_le_div_of_nonneg_left hx0 (by linarith) (by linarith)
    have e : (Real.log A * (1 + x) - Real.log A) / (2 * Real.log A) = x / 2 := by
      field_simp; ring
    rw [e]; linarith
  -- `∑ 1/p ≤ #/A`
  have h3 : ∑ p ∈ primesIn A B, (1 : ℝ) / p ≤ (primesIn A B).card / A := by
    calc ∑ p ∈ primesIn A B, (1 : ℝ) / p ≤ ∑ p ∈ primesIn A B, (1 : ℝ) / A := by
          apply Finset.sum_le_sum
          intro p hp
          have hp' := (Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1).1
          have : (A : ℝ) ≤ p := by exact_mod_cast hp'
          exact one_div_le_one_div_of_le (by linarith) this
      _ = (primesIn A B).card / A := by rw [Finset.sum_const, nsmul_eq_mul]; ring
  have hkey : ε * (η / (4 * Real.log A)) ≤ (primesIn A B).card / A := by
    have h4 : η / (4 * Real.log A) ≤ Real.log (Real.log B) - Real.log (Real.log A) := by
      have : η / (4 * Real.log A) ≤ (Real.log B - Real.log A) / (2 * Real.log A) := by
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
        nlinarith
      linarith
    calc ε * (η / (4 * Real.log A)) ≤ ε * (Real.log (Real.log B) - Real.log (Real.log A)) :=
          mul_le_mul_of_nonneg_left h4 hε
      _ ≤ _ := hrich.trans h3
  rw [hBA]
  have e : ε * ((B : ℝ) - A) / (4 * Real.log A) = A * (ε * (η / (4 * Real.log A))) := by
    rw [hη]; field_simp
  rw [e]
  have := mul_le_mul_of_nonneg_left hkey (by linarith : (0 : ℝ) ≤ A)
  rwa [mul_div_cancel₀ _ (by linarith : (A : ℝ) ≠ 0)] at this

end LemmaSel

section LemmaPH

/-- **Lemma PH** (pigeonhole with exclusion, signed version). -/
theorem lemmaPH {Ω : Type*} (s : Finset Ω) (w F : Ω → ℝ) (hw : ∀ ω ∈ s, 0 ≤ w ω)
    (hw1 : ∑ ω ∈ s, w ω = 1) {MF α : ℝ} (hMF : 0 < MF) (hF : ∀ ω ∈ s, |F ω| ≤ MF)
    (hα : 0 < α) (hE : α ≤ |∑ ω ∈ s, w ω * F ω|) (bad : Ω → Prop) [DecidablePred bad]
    (hbad : ∑ ω ∈ s.filter bad, w ω ≤ α / (2 * MF)) :
    ∃ ω ∈ s, ¬ bad ω ∧ 0 < w ω ∧ α / 2 ≤ |F ω| := by
  by_contra hno
  push Not at hno
  have h1 : |∑ ω ∈ s, w ω * F ω| ≤ ∑ ω ∈ s, w ω * |F ω| := by
    calc _ ≤ ∑ ω ∈ s, |w ω * F ω| := Finset.abs_sum_le_sum_abs _ _
      _ = _ := Finset.sum_congr rfl fun ω hω => by rw [abs_mul, abs_of_nonneg (hw ω hω)]
  have h1' : ∑ ω ∈ s, w ω * |F ω| = ∑ ω ∈ s.filter bad, w ω * |F ω| +
      ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * |F ω| :=
    (Finset.sum_filter_add_sum_filter_not s bad _).symm
  have hbadF : ∑ ω ∈ s.filter bad, w ω * |F ω| ≤ MF * ∑ ω ∈ s.filter bad, w ω := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro ω hω
    have hωs := (Finset.mem_filter.mp hω).1
    rw [mul_comm MF]
    exact mul_le_mul_of_nonneg_left (hF ω hωs) (hw ω hωs)
  have hgoodF : ∀ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * |F ω| ≤ w ω * (α / 2) := by
    intro ω hω
    obtain ⟨hωs, hωb⟩ := Finset.mem_filter.mp hω
    rcases (hw ω hωs).eq_or_lt with h0 | hpos
    · rw [← h0]; simp
    · exact mul_le_mul_of_nonneg_left (hno ω hωs hωb hpos).le (hw ω hωs)
  have hsplit := Finset.sum_filter_add_sum_filter_not s bad w
  rw [hw1] at hsplit
  set g := ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω with hg
  have hMFb : MF * ∑ ω ∈ s.filter bad, w ω ≤ α / 2 := by
    calc MF * ∑ ω ∈ s.filter bad, w ω ≤ MF * (α / (2 * MF)) :=
          mul_le_mul_of_nonneg_left hbad hMF.le
      _ = α / 2 := by field_simp
  have hg0 : 0 ≤ g := Finset.sum_nonneg fun ω hω => hw ω (Finset.mem_filter.mp hω).1
  rcases hg0.eq_or_lt with hg0' | hgpos
  · -- no good weight: everything is bad
    have hgF : ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * |F ω| ≤ 0 := by
      calc _ ≤ ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * (α / 2) := Finset.sum_le_sum hgoodF
        _ = g * (α / 2) := by rw [hg, Finset.sum_mul]
        _ = 0 := by rw [← hg0']; ring
    linarith
  · -- some good `ω` has positive weight: strict inequality
    obtain ⟨ω₀, hω₀, hω₀pos⟩ : ∃ ω ∈ s.filter (fun ω => ¬ bad ω), 0 < w ω := by
      by_contra h
      push Not at h
      have : g ≤ 0 := Finset.sum_nonpos h
      linarith
    have hstrict : ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * |F ω| <
        ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * (α / 2) := by
      apply Finset.sum_lt_sum hgoodF
      refine ⟨ω₀, hω₀, ?_⟩
      obtain ⟨hωs, hωb⟩ := Finset.mem_filter.mp hω₀
      exact mul_lt_mul_of_pos_left (hno ω₀ hωs hωb hω₀pos) hω₀pos
    have hg1 : g ≤ 1 := by
      have : 0 ≤ ∑ ω ∈ s.filter bad, w ω :=
        Finset.sum_nonneg fun ω hω => hw ω (Finset.mem_filter.mp hω).1
      linarith
    have : ∑ ω ∈ s.filter (fun ω => ¬ bad ω), w ω * (α / 2) = g * (α / 2) := by
      rw [hg, Finset.sum_mul]
    nlinarith

/-- **Lemma PH**, non-negative version. -/
theorem lemmaPH_nonneg {Ω : Type*} (s : Finset Ω) (w F : Ω → ℝ) (hw : ∀ ω ∈ s, 0 ≤ w ω)
    (hw1 : ∑ ω ∈ s, w ω = 1) {MF α : ℝ} (hMF : 0 < MF) (hF0 : ∀ ω ∈ s, 0 ≤ F ω)
    (hF : ∀ ω ∈ s, F ω ≤ MF) (hα : 0 < α) (hE : α ≤ ∑ ω ∈ s, w ω * F ω)
    (bad : Ω → Prop) [DecidablePred bad] (hbad : ∑ ω ∈ s.filter bad, w ω ≤ α / (2 * MF)) :
    ∃ ω ∈ s, ¬ bad ω ∧ 0 < w ω ∧ α / 2 ≤ F ω := by
  have hE' : α ≤ |∑ ω ∈ s, w ω * F ω| := hE.trans (le_abs_self _)
  obtain ⟨ω, hωs, hωb, hωw, hωF⟩ := lemmaPH s w F hw hw1 hMF
    (fun ω hω => by rw [abs_of_nonneg (hF0 ω hω)]; exact hF ω hω) hα hE' bad hbad
  exact ⟨ω, hωs, hωb, hωw, by rwa [abs_of_nonneg (hF0 ω hωs)] at hωF⟩

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι]

/-- The product weight has total mass `1`. -/
lemma sum_prod_weight (s : ι → Finset κ) (w : ι → κ → ℝ) (hw1 : ∀ i, ∑ a ∈ s i, w i a = 1) :
    ∑ j ∈ Fintype.piFinset s, ∏ i, w i (j i) = 1 := by
  rw [← Finset.prod_univ_sum]
  simp [hw1]

/-- **Lemma PH**, product-weight union bound: for `w(j) = ∏ᵢ wᵢ(jᵢ)` and "bad" defined
factorwise, `w{j : some jᵢ bad} ≤ ∑ᵢ wᵢ(bad pieces)`. -/
theorem prod_weight_bad (s : ι → Finset κ) (w : ι → κ → ℝ) (hw : ∀ i, ∀ a ∈ s i, 0 ≤ w i a)
    (hw1 : ∀ i, ∑ a ∈ s i, w i a = 1) (bad : ι → κ → Prop) [∀ i, DecidablePred (bad i)] :
    ∑ j ∈ (Fintype.piFinset s).filter (fun j => ∃ i, bad i (j i)), ∏ i, w i (j i) ≤
      ∑ i, ∑ a ∈ (s i).filter (bad i), w i a := by
  classical
  have hW0 : ∀ j ∈ Fintype.piFinset s, 0 ≤ ∏ i, w i (j i) := fun j hj =>
    Finset.prod_nonneg fun i _ => hw i (j i) (Fintype.mem_piFinset.mp hj i)
  -- one factor at a time
  have hone : ∀ i₀ : ι, ∑ j ∈ Fintype.piFinset s, (if bad i₀ (j i₀) then ∏ i, w i (j i) else 0) =
      ∑ a ∈ (s i₀).filter (bad i₀), w i₀ a := by
    intro i₀
    set f : ι → κ → ℝ := fun i a => if i = i₀ ∧ ¬ bad i₀ a then 0 else w i a with hf
    have e1 : ∀ j : ι → κ, (if bad i₀ (j i₀) then ∏ i, w i (j i) else 0) = ∏ i, f i (j i) := by
      intro j
      by_cases hb : bad i₀ (j i₀)
      · rw [if_pos hb]
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [hf]; simp only
        rw [if_neg]
        rintro ⟨rfl, h⟩
        exact h hb
      · rw [if_neg hb]
        symm
        apply Finset.prod_eq_zero (Finset.mem_univ i₀)
        rw [hf]; simp [hb]
    rw [Finset.sum_congr rfl fun j _ => e1 j, ← Finset.prod_univ_sum]
    rw [Finset.prod_eq_single i₀]
    · rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [hf]; simp only [true_and]
      split_ifs <;> simp_all
    · intro i _ hi
      rw [← hw1 i]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [hf]; simp [hi]
    · intro h; exact absurd (Finset.mem_univ i₀) h
  calc ∑ j ∈ (Fintype.piFinset s).filter (fun j => ∃ i, bad i (j i)), ∏ i, w i (j i)
      = ∑ j ∈ Fintype.piFinset s, (if ∃ i, bad i (j i) then ∏ i, w i (j i) else 0) :=
        Finset.sum_filter _ _
    _ ≤ ∑ j ∈ Fintype.piFinset s, ∑ i₀, (if bad i₀ (j i₀) then ∏ i, w i (j i) else 0) := by
        apply Finset.sum_le_sum
        intro j hj
        split_ifs with h
        · obtain ⟨i₀, hi₀⟩ := h
          calc ∏ i, w i (j i) = (if bad i₀ (j i₀) then ∏ i, w i (j i) else 0) := by rw [if_pos hi₀]
            _ ≤ ∑ i₁, (if bad i₁ (j i₁) then ∏ i, w i (j i) else 0) := by
                apply Finset.single_le_sum (f := fun i₁ => if bad i₁ (j i₁) then ∏ i, w i (j i) else 0)
                  _ (Finset.mem_univ i₀)
                intro i₁ _
                split_ifs
                · exact hW0 j hj
                · exact le_rfl
        · apply Finset.sum_nonneg
          intro i₁ _
          split_ifs
          · exact hW0 j hj
          · exact le_rfl
    _ = ∑ i₀, ∑ j ∈ Fintype.piFinset s, (if bad i₀ (j i₀) then ∏ i, w i (j i) else 0) :=
        Finset.sum_comm
    _ = ∑ i, ∑ a ∈ (s i).filter (bad i), w i a := Finset.sum_congr rfl fun i₀ _ => hone i₀

/-- **Lemma PH**, pairs of tuples: `w⊗w{(j, j') : some component of j or j' bad} ≤ 2 ∑ᵢ wᵢ(bad)`. -/
theorem prod_weight_bad_pair (s : ι → Finset κ) (w : ι → κ → ℝ) (hw : ∀ i, ∀ a ∈ s i, 0 ≤ w i a)
    (hw1 : ∀ i, ∑ a ∈ s i, w i a = 1) (bad : ι → κ → Prop) [∀ i, DecidablePred (bad i)] :
    ∑ jj ∈ (Fintype.piFinset s ×ˢ Fintype.piFinset s).filter
        (fun jj => (∃ i, bad i (jj.1 i)) ∨ (∃ i, bad i (jj.2 i))),
      (∏ i, w i (jj.1 i)) * (∏ i, w i (jj.2 i)) ≤ 2 * ∑ i, ∑ a ∈ (s i).filter (bad i), w i a := by
  classical
  set A := Fintype.piFinset s
  set W : (ι → κ) → ℝ := fun j => ∏ i, w i (j i) with hW
  have hW0 : ∀ j ∈ A, 0 ≤ W j := fun j hj =>
    Finset.prod_nonneg fun i _ => hw i (j i) (Fintype.mem_piFinset.mp hj i)
  have hW1 : ∑ j ∈ A, W j = 1 := sum_prod_weight s w hw1
  have hb := prod_weight_bad s w hw hw1 bad
  set b := ∑ j ∈ A.filter (fun j => ∃ i, bad i (j i)), W j
  have hsub : (A ×ˢ A).filter (fun jj => (∃ i, bad i (jj.1 i)) ∨ (∃ i, bad i (jj.2 i))) ⊆
      (A.filter (fun j => ∃ i, bad i (j i))) ×ˢ A ∪ A ×ˢ (A.filter (fun j => ∃ i, bad i (j i))) := by
    rintro ⟨j, j'⟩ h
    simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_union] at h ⊢
    rcases h.2 with h2 | h2
    · exact Or.inl ⟨⟨h.1.1, h2⟩, h.1.2⟩
    · exact Or.inr ⟨h.1.1, h.1.2, h2⟩
  have hnn : ∀ jj ∈ A ×ˢ A, 0 ≤ W jj.1 * W jj.2 := by
    rintro ⟨j, j'⟩ h
    rw [Finset.mem_product] at h
    exact mul_nonneg (hW0 j h.1) (hW0 j' h.2)
  calc ∑ jj ∈ (A ×ˢ A).filter (fun jj => (∃ i, bad i (jj.1 i)) ∨ (∃ i, bad i (jj.2 i))),
        W jj.1 * W jj.2
      ≤ ∑ jj ∈ (A.filter (fun j => ∃ i, bad i (j i))) ×ˢ A ∪
          A ×ˢ (A.filter (fun j => ∃ i, bad i (j i))), W jj.1 * W jj.2 := by
        apply Finset.sum_le_sum_of_subset_of_nonneg hsub
        intro jj hjj _
        simp only [Finset.mem_union, Finset.mem_product, Finset.mem_filter] at hjj
        rcases hjj with h | h
        · exact mul_nonneg (hW0 _ h.1.1) (hW0 _ h.2)
        · exact mul_nonneg (hW0 _ h.1) (hW0 _ h.2.1)
    _ ≤ ∑ jj ∈ (A.filter (fun j => ∃ i, bad i (j i))) ×ˢ A, W jj.1 * W jj.2 +
          ∑ jj ∈ A ×ˢ (A.filter (fun j => ∃ i, bad i (j i))), W jj.1 * W jj.2 := by
        rw [← Finset.sum_union_inter]
        have : 0 ≤ ∑ jj ∈ (A.filter (fun j => ∃ i, bad i (j i))) ×ˢ A ∩
            A ×ˢ (A.filter (fun j => ∃ i, bad i (j i))), W jj.1 * W jj.2 := by
          apply Finset.sum_nonneg
          intro jj hjj
          simp only [Finset.mem_inter, Finset.mem_product, Finset.mem_filter] at hjj
          exact mul_nonneg (hW0 _ hjj.1.1.1) (hW0 _ hjj.1.2)
        linarith
    _ = b * 1 + 1 * b := by
        rw [Finset.sum_product, Finset.sum_product]
        simp only [← Finset.mul_sum, ← Finset.sum_mul]
        rw [hW1]
    _ ≤ 2 * ∑ i, ∑ a ∈ (s i).filter (bad i), w i a := by linarith

end LemmaPH

section LemmaM54

/-- `1/(m+1) ≤ log(m+1) - log m` for `m ≥ 1`. -/
lemma inv_succ_le_log_sub (m : ℕ) (hm : 1 ≤ m) :
    1 / ((m : ℝ) + 1) ≤ Real.log ((m : ℝ) + 1) - Real.log m := by
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have h := div_one_add_le_log (show (0 : ℝ) ≤ 1 / m by positivity)
  have e1 : (1 / (m : ℝ)) / (1 + 1 / m) = 1 / ((m : ℝ) + 1) := by field_simp
  have e2 : Real.log (1 + 1 / (m : ℝ)) = Real.log ((m : ℝ) + 1) - Real.log m := by
    rw [← Real.log_div (by positivity) (by positivity)]; congr 1; field_simp
  rw [e1, e2] at h; exact h

/-- The harmonic sum over `[a, a + n)` is at most `log(a + n) - log a`. -/
lemma sum_inv_succ_le_log (a : ℕ) (ha : 1 ≤ a) (n : ℕ) :
    ∑ i ∈ Finset.Ico a (a + n), 1 / ((i : ℝ) + 1) ≤ Real.log ((a + n : ℕ) : ℝ) - Real.log a := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [← add_assoc, Finset.sum_Ico_succ_top (by omega)]
    have := inv_succ_le_log_sub (a + n) (by omega)
    push_cast at this ih ⊢
    linarith

/-- `p ∈ [2^i, 2^{i+1})` iff `⌊log₂ p⌋ = i` (for `p ≥ 1`). -/
lemma log2_eq_iff {p i : ℕ} (hp : p ≠ 0) : Nat.log 2 p = i ↔ 2 ^ i ≤ p ∧ p < 2 ^ (i + 1) :=
  Nat.log_eq_iff (Or.inr ⟨by norm_num, hp⟩)

/-- **Lemma M54, version B** (replacement for GS step (5.4)). Let `P` be the primes in
`[P₁, P₂)`, `P₁ ≥ 16`, `log log P₂ - log log P₁ ≥ 2C_M + 1` (with Mertens' lower bound
`MertensLowerWith C_M`), `F ≥ 0` on `P` and `E^log_{p∈P} F ≥ α > 0`. Then some dyadic block
`[2^i, 2^{i+1})` meeting `[P₁, P₂)` has `∑_{p ∈ P ∩ [2^i, 2^{i+1})} F(p) ≥ (α/2) 2^i/(i+1)`. -/
theorem lemmaM54B {CM : ℝ} (hM : MertensLowerWith CM) {P₁ P₂ : ℕ} (hP₁ : 16 ≤ P₁) (hP : P₁ ≤ P₂)
    (hW : 2 * CM + 1 ≤ Real.log (Real.log P₂) - Real.log (Real.log P₁))
    (F : ℕ → ℝ) (hF : ∀ p ∈ primesIn P₁ P₂, 0 ≤ F p) {α : ℝ} (hα : 0 < α)
    (hE : α ≤ lavg (primesIn P₁ P₂) F) :
    ∃ i : ℕ, P₁ < 2 ^ (i + 1) ∧ 2 ^ i < P₂ ∧
      α / 2 * (2 ^ i / ((i : ℝ) + 1)) ≤
        ∑ p ∈ (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)), F p := by
  classical
  have hmert := hM P₁ P₂ (by omega) hP
  have hW0 : 0 ≤ Real.log (Real.log P₂) - Real.log (Real.log P₁) := by
    linarith [loglog_mono (show 3 ≤ P₁ by omega) hP]
  set W := Real.log (Real.log P₂) - Real.log (Real.log P₁) with hWdef
  set S := ∑ p ∈ primesIn P₁ P₂, (1 : ℝ) / p with hS
  have hSge : (W + 1) / 2 ≤ S := by linarith
  have hS0 : 0 < S := by linarith
  -- `α S ≤ ∑ F(p)/p`
  have hFS : α * S ≤ ∑ p ∈ primesIn P₁ P₂, 1 / (p : ℝ) * F p := by
    have h := hE
    unfold lavg wavg at h
    rw [le_div_iff₀ hS0] at h
    linarith
  by_contra hno
  push Not at hno
  set i₀ := Nat.log 2 P₁ with hi₀
  set i₁ := Nat.log 2 (P₂ - 1) with hi₁
  have hP₁pos : P₁ ≠ 0 := by omega
  -- every `p ∈ P` has `⌊log₂ p⌋ ∈ [i₀, i₁]`
  have hmaps : ∀ p ∈ primesIn P₁ P₂, Nat.log 2 p ∈ Finset.Icc i₀ i₁ := by
    intro p hp
    have hp' := Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1
    exact Finset.mem_Icc.mpr ⟨Nat.log_mono_right hp'.1, Nat.log_mono_right (by omega)⟩
  have hdecomp : ∑ p ∈ primesIn P₁ P₂, 1 / (p : ℝ) * F p =
      ∑ i ∈ Finset.Icc i₀ i₁, ∑ p ∈ (primesIn P₁ P₂).filter (fun p => Nat.log 2 p = i),
        1 / (p : ℝ) * F p :=
    (Finset.sum_fiberwise_of_maps_to hmaps _).symm
  -- each block contributes `≤ (α/2)/(i+1)`
  have hblock : ∀ i ∈ Finset.Icc i₀ i₁,
      ∑ p ∈ (primesIn P₁ P₂).filter (fun p => Nat.log 2 p = i), 1 / (p : ℝ) * F p ≤
        α / 2 * (1 / ((i : ℝ) + 1)) := by
    intro i hi
    obtain ⟨hi0, hi1⟩ := Finset.mem_Icc.mp hi
    have hfeq : (primesIn P₁ P₂).filter (fun p => Nat.log 2 p = i) =
        (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)) := by
      apply Finset.filter_congr
      intro p hp
      have hp0 : p ≠ 0 := (Finset.mem_filter.mp hp).2.ne_zero
      exact log2_eq_iff hp0
    have hlo : P₁ < 2 ^ (i + 1) :=
      lt_of_lt_of_le (Nat.lt_pow_succ_log_self (by norm_num) P₁)
        (Nat.pow_le_pow_right (by norm_num) (by omega))
    have hhi : 2 ^ i < P₂ := by
      have h1 : 2 ^ i ≤ 2 ^ i₁ := Nat.pow_le_pow_right (by norm_num) hi1
      have h2 : 2 ^ i₁ ≤ P₂ - 1 := Nat.pow_log_le_self 2 (by omega)
      omega
    have hlt := hno i hlo hhi
    rw [hfeq]
    have h2i : (0 : ℝ) < 2 ^ i := by positivity
    calc ∑ p ∈ (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)), 1 / (p : ℝ) * F p
        ≤ ∑ p ∈ (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)),
            1 / (2 : ℝ) ^ i * F p := by
          apply Finset.sum_le_sum
          intro p hp
          obtain ⟨hpP, hp2⟩ := Finset.mem_filter.mp hp
          apply mul_le_mul_of_nonneg_right _ (hF p hpP)
          apply one_div_le_one_div_of_le h2i
          exact_mod_cast hp2.1
      _ = 1 / (2 : ℝ) ^ i *
            ∑ p ∈ (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)), F p := by
          rw [Finset.mul_sum]
      _ ≤ 1 / (2 : ℝ) ^ i * (α / 2 * (2 ^ i / ((i : ℝ) + 1))) :=
          mul_le_mul_of_nonneg_left hlt.le (by positivity)
      _ = α / 2 * (1 / ((i : ℝ) + 1)) := by field_simp
  -- `i₀ ≤ i₁` (the set of primes is nonempty)
  have hne : (primesIn P₁ P₂).Nonempty := by
    by_contra h
    rw [Finset.not_nonempty_iff_eq_empty] at h
    rw [hS, h, Finset.sum_empty] at hS0
    exact lt_irrefl _ hS0
  obtain ⟨p₀, hp₀⟩ := hne
  have hi01 : i₀ ≤ i₁ := (Finset.mem_Icc.mp (hmaps p₀ hp₀)).1.trans (Finset.mem_Icc.mp (hmaps p₀ hp₀)).2
  have hi0pos : 4 ≤ i₀ := by
    rw [hi₀]
    have : 2 ^ 4 ≤ P₁ := by norm_num; omega
    exact (Nat.le_log_iff_pow_le (by norm_num) hP₁pos).mpr this
  -- the harmonic sum
  have hharm : ∑ i ∈ Finset.Icc i₀ i₁, 1 / ((i : ℝ) + 1) ≤ Real.log ((i₁ + 1 : ℕ) : ℝ) - Real.log i₀ := by
    have e : Finset.Icc i₀ i₁ = Finset.Ico i₀ (i₁ + 1) := by
      ext j; simp only [Finset.mem_Icc, Finset.mem_Ico]; omega
    rw [e]
    have := sum_inv_succ_le_log i₀ (by omega) (i₁ + 1 - i₀)
    rwa [show i₀ + (i₁ + 1 - i₀) = i₁ + 1 by omega] at this
  -- compare with `W`
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hP₁R : (16 : ℝ) ≤ P₁ := by exact_mod_cast hP₁
  have hP₂R : (P₁ : ℝ) ≤ P₂ := by exact_mod_cast hP
  have hlogP₁ : 4 * Real.log 2 ≤ Real.log P₁ := by
    rw [← Real.log_rpow (by norm_num)]
    exact Real.log_le_log (by positivity) (by norm_num; linarith)
  have hlogP₂ : Real.log P₁ ≤ Real.log P₂ := Real.log_le_log (by linarith) hP₂R
  have hi₀R : Real.log P₁ < ((i₀ : ℝ) + 1) * Real.log 2 := by
    have h := Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) P₁
    have h' : (P₁ : ℝ) < (2 : ℝ) ^ (i₀ + 1) := by exact_mod_cast h
    have := Real.log_lt_log (by linarith) h'
    rw [Real.log_pow] at this
    push_cast at this
    linarith
  have hi₁R : (i₁ : ℝ) * Real.log 2 ≤ Real.log P₂ := by
    have h : 2 ^ i₁ ≤ P₂ := (Nat.pow_log_le_self 2 (by omega : P₂ - 1 ≠ 0)).trans (by omega)
    have h' : (2 : ℝ) ^ i₁ ≤ P₂ := by exact_mod_cast h
    have := Real.log_le_log (by positivity) h'
    rwa [Real.log_pow] at this
  set L₁ := Real.log P₁ / Real.log 2 with hL₁
  set L₂ := Real.log P₂ / Real.log 2 with hL₂
  have hL₁4 : 4 ≤ L₁ := by rw [hL₁, le_div_iff₀ hlog2]; linarith
  have hL₁₂ : L₁ ≤ L₂ := div_le_div_of_nonneg_right hlogP₂ hlog2.le
  have hi₀L : 3 / 4 * L₁ ≤ i₀ := by
    have : L₁ < (i₀ : ℝ) + 1 := by rw [hL₁, div_lt_iff₀ hlog2]; linarith
    linarith
  have hi₁L : ((i₁ + 1 : ℕ) : ℝ) ≤ 5 / 4 * L₂ := by
    have : (i₁ : ℝ) ≤ L₂ := by rw [hL₂, le_div_iff₀ hlog2]; linarith
    push_cast; linarith
  have hlogdiff : Real.log ((i₁ + 1 : ℕ) : ℝ) - Real.log i₀ ≤ W + 2 / 3 := by
    have hL₁0 : 0 < L₁ := by linarith
    have hL₂0 : 0 < L₂ := by linarith
    have h1 : Real.log ((i₁ + 1 : ℕ) : ℝ) ≤ Real.log (5 / 4 * L₂) :=
      Real.log_le_log (by positivity) hi₁L
    have h2 : Real.log (3 / 4 * L₁) ≤ Real.log i₀ := Real.log_le_log (by linarith) hi₀L
    rw [Real.log_mul (by norm_num) hL₂0.ne'] at h1
    rw [Real.log_mul (by norm_num) hL₁0.ne'] at h2
    have hLL : Real.log L₂ - Real.log L₁ = W := by
      rw [hL₁, hL₂, Real.log_div (by linarith) hlog2.ne', Real.log_div (by linarith) hlog2.ne',
        hWdef]
      ring
    have h53 : Real.log (5 / 4) - Real.log (3 / 4) ≤ 2 / 3 := by
      rw [← Real.log_div (by norm_num) (by norm_num)]
      have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 5 / 4 / (3 / 4) by norm_num)
      norm_num at this ⊢
      linarith
    linarith
  have hupper : ∑ p ∈ primesIn P₁ P₂, 1 / (p : ℝ) * F p ≤ α / 2 * (W + 2 / 3) := by
    rw [hdecomp]
    calc _ ≤ ∑ i ∈ Finset.Icc i₀ i₁, α / 2 * (1 / ((i : ℝ) + 1)) := Finset.sum_le_sum hblock
      _ = α / 2 * ∑ i ∈ Finset.Icc i₀ i₁, 1 / ((i : ℝ) + 1) := by rw [Finset.mul_sum]
      _ ≤ α / 2 * (W + 2 / 3) := by
          apply mul_le_mul_of_nonneg_left _ (by linarith)
          linarith
  nlinarith

/-- `log a ≤ √a / 16` for `a ≥ 2^24`. -/
lemma log_le_sqrt_div (a : ℝ) (ha : 2 ^ 24 ≤ a) : Real.log a ≤ Real.sqrt a / 16 := by
  have ha0 : 0 ≤ a := le_trans (by positivity) ha
  set s := Real.sqrt a with hs
  set r := Real.sqrt s with hr
  have hs0 : 0 ≤ s := Real.sqrt_nonneg _
  have hs2 : s ^ 2 = a := Real.sq_sqrt ha0
  have hr2 : r ^ 2 = s := Real.sq_sqrt hs0
  have hs4096 : 4096 ≤ s := by
    rw [hs, Real.le_sqrt (by norm_num) ha0]; norm_num; linarith
  have hr64 : 64 ≤ r := by
    rw [hr, Real.le_sqrt (by norm_num) hs0]; norm_num; linarith
  have hr0 : 0 < r := by linarith
  have ha4 : a = r ^ 4 := by rw [← hs2, ← hr2]; ring
  have hlog : Real.log a = 4 * Real.log r := by
    rw [ha4, Real.log_pow]; norm_num
  have hlr : Real.log r ≤ r - 1 := Real.log_le_sub_one_of_pos hr0
  rw [hlog]
  have : s = r ^ 2 := hr2.symm
  rw [this]
  nlinarith

/-- **Chebyshev.** `∑_{a ≤ p < 4a} log p ≥ a/2` for `a ≥ 2^24`. -/
lemma sum_log_primesIn_ge (a : ℕ) (ha : 2 ^ 24 ≤ a) :
    (a : ℝ) / 2 ≤ ∑ p ∈ primesIn a (4 * a), Real.log p := by
  have haR : (2 : ℝ) ^ 24 ≤ a := by exact_mod_cast ha
  have ha0 : (0 : ℝ) ≤ a := le_trans (by positivity) haR
  have ha1 : (1 : ℝ) ≤ a := le_trans (by norm_num) haR
  -- `θ(4a) = θ(a) + ∑_{a < p ≤ 4a} log p`
  have hsplit : Chebyshev.theta ((4 * a : ℕ) : ℝ) = Chebyshev.theta (a : ℝ) +
      ∑ p ∈ (Finset.Ioc a (4 * a)).filter Nat.Prime, Real.log p := by
    unfold Chebyshev.theta
    rw [Nat.floor_natCast, Nat.floor_natCast,
      ← Finset.Ioc_union_Ioc_eq_Ioc (Nat.zero_le a) (by omega : a ≤ 4 * a),
      Finset.filter_union, Finset.sum_union]
    exact Finset.disjoint_filter_filter (Finset.Ioc_disjoint_Ioc_of_le le_rfl)
  have hsub : (Finset.Ioc a (4 * a)).filter Nat.Prime ⊆ primesIn a (4 * a) := by
    intro p hp
    obtain ⟨hp1, hpp⟩ := Finset.mem_filter.mp hp
    obtain ⟨hpa, hp4⟩ := Finset.mem_Ioc.mp hp1
    refine Finset.mem_filter.mpr ⟨Finset.mem_Ico.mpr ⟨hpa.le, ?_⟩, hpp⟩
    rcases hp4.lt_or_eq with h | h
    · exact h
    · exfalso
      have h2 : 2 ∣ p := ⟨2 * a, by omega⟩
      have := (Nat.prime_dvd_prime_iff_eq Nat.prime_two hpp).mp h2
      omega
  have hmono : ∑ p ∈ (Finset.Ioc a (4 * a)).filter Nat.Prime, Real.log p ≤
      ∑ p ∈ primesIn a (4 * a), Real.log p := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hsub
    intro p hp _
    have := (Finset.mem_filter.mp hp).2
    exact Real.log_nonneg (by exact_mod_cast this.one_lt.le)
  have hθ4 := Chebyshev.theta_ge (4 * a)
  have hθ1 := Chebyshev.theta_le_log4_mul_x ha0
  push_cast at hθ4 hsplit
  -- the error terms
  have hlog2 : 0.693 < Real.log 2 := by have := Real.log_two_gt_d9; linarith
  have hlog4 : Real.log 4 = 2 * Real.log 2 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
  have hsq4 : Real.sqrt (4 * a) = 2 * Real.sqrt a := by
    rw [Real.sqrt_mul (by norm_num), show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  have hla := log_le_sqrt_div a haR
  have hsa : Real.sqrt a ≤ a := by
    rw [Real.sqrt_le_left ha0]; nlinarith
  have hsa0 : 0 ≤ Real.sqrt a := Real.sqrt_nonneg _
  have hlog4a : Real.log (4 * a) ≤ 2 * Real.log a := by
    rw [← Real.log_rpow (by linarith)]
    apply Real.log_le_log (by positivity)
    rw [show (a : ℝ) ^ (2 : ℝ) = a ^ 2 by norm_cast]
    nlinarith
  have hlog4a1 : Real.log (4 * a + 1) ≤ 2 * Real.log a := by
    rw [← Real.log_rpow (by linarith)]
    apply Real.log_le_log (by positivity)
    rw [show (a : ℝ) ^ (2 : ℝ) = a ^ 2 by norm_cast]
    nlinarith
  have hla0 : 0 ≤ Real.log a := Real.log_nonneg ha1
  have herr : Real.log (4 * a + 1) + 2 * Real.sqrt (4 * a) * Real.log (4 * a) ≤ 5 / 8 * a := by
    rw [hsq4]
    have h1 : 2 * (2 * Real.sqrt a) * Real.log (4 * a) ≤ 8 * Real.sqrt a * Real.log a := by
      nlinarith
    have h2 : 8 * Real.sqrt a * Real.log a ≤ 8 * Real.sqrt a * (Real.sqrt a / 16) :=
      mul_le_mul_of_nonneg_left hla (by positivity)
    have h3 : Real.sqrt a * Real.sqrt a = a := Real.mul_self_sqrt ha0
    nlinarith
  nlinarith

/-- **Chebyshev.** `∑_{a ≤ p < 4a} 1/p ≥ 1/(16 log a)` for `a ≥ 2^24`. -/
lemma sum_inv_primesIn_ge (a : ℕ) (ha : 2 ^ 24 ≤ a) :
    1 / (16 * Real.log a) ≤ ∑ p ∈ primesIn a (4 * a), (1 : ℝ) / p := by
  have haR : (2 : ℝ) ^ 24 ≤ a := by exact_mod_cast ha
  have ha1 : (2 : ℝ) ≤ a := le_trans (by norm_num) haR
  have hlogA : 0 < Real.log a := Real.log_pos (by linarith)
  have hlog4a : Real.log (4 * a) ≤ 2 * Real.log a := by
    rw [← Real.log_rpow (by linarith)]
    apply Real.log_le_log (by positivity)
    rw [show (a : ℝ) ^ (2 : ℝ) = a ^ 2 by norm_cast]
    nlinarith
  have hlog4a0 : 0 < Real.log (4 * a) := Real.log_pos (by linarith)
  have hterm : ∀ p ∈ primesIn a (4 * a), Real.log p / (4 * a * Real.log (4 * a)) ≤ (1 : ℝ) / p := by
    intro p hp
    obtain ⟨hp1, hpp⟩ := Finset.mem_filter.mp hp
    obtain ⟨hpa, hp4⟩ := Finset.mem_Ico.mp hp1
    have hpR : (2 : ℝ) ≤ p := by exact_mod_cast hpp.two_le
    have hp4R : (p : ℝ) ≤ 4 * a := by
      have : p ≤ 4 * a := hp4.le
      exact_mod_cast this
    rw [div_le_div_iff₀ (by positivity) (by linarith)]
    have hlp : Real.log p ≤ Real.log (4 * a) := Real.log_le_log (by linarith) hp4R
    have hlp0 : 0 ≤ Real.log p := Real.log_nonneg (by linarith)
    nlinarith
  have hsum := sum_log_primesIn_ge a ha
  calc 1 / (16 * Real.log a) ≤ 1 / (8 * Real.log (4 * a)) := by
        apply one_div_le_one_div_of_le (by positivity); linarith
    _ = ((a : ℝ) / 2) / (4 * a * Real.log (4 * a)) := by
        field_simp; ring
    _ ≤ (∑ p ∈ primesIn a (4 * a), Real.log p) / (4 * a * Real.log (4 * a)) :=
        div_le_div_of_nonneg_right hsum (by positivity)
    _ = ∑ p ∈ primesIn a (4 * a), Real.log p / (4 * a * Real.log (4 * a)) := by
        rw [Finset.sum_div]
    _ ≤ ∑ p ∈ primesIn a (4 * a), (1 : ℝ) / p := Finset.sum_le_sum hterm

/-- **Lemma M54, version A** (replacement for GS step (5.4) under `P₂ ≥ 4P₁`, the hypothesis
currently in `Prop51With`). Let `P` be the primes in `[P₁, P₂)` with `P₁ ≥ 2^24` and
`P₂ ≥ 4P₁`, `F ≥ 0` on `P` and `E^log_{p∈P} F ≥ α > 0`. Then some dyadic block
`[2^i, 2^{i+1})` meeting `[P₁, P₂)` has `∑_{p ∈ P ∩ [2^i, 2^{i+1})} F(p) ≥ (α/1000) 2^i/(i+1)`.
Uses only Chebyshev's bounds (`Chebyshev.theta_ge`, `Chebyshev.theta_le_log4_mul_x`). -/
theorem lemmaM54A {P₁ P₂ : ℕ} (hP₁ : 2 ^ 24 ≤ P₁) (hP : 4 * P₁ ≤ P₂)
    (F : ℕ → ℝ) (hF : ∀ p ∈ primesIn P₁ P₂, 0 ≤ F p) {α : ℝ} (hα : 0 < α)
    (hE : α ≤ lavg (primesIn P₁ P₂) F) :
    ∃ i : ℕ, P₁ < 2 ^ (i + 1) ∧ 2 ^ i < P₂ ∧
      α / 1000 * (2 ^ i / ((i : ℝ) + 1)) ≤
        ∑ p ∈ (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)), F p := by
  classical
  have hP₁0 : 0 < P₁ := lt_of_lt_of_le (by positivity) hP₁
  have hP₁R : (2 : ℝ) ^ 24 ≤ P₁ := by exact_mod_cast hP₁
  -- `S = ∑ 1/p > 0` and `α S ≤ ∑ F(p)/p`
  have hS0 : 0 < ∑ p ∈ primesIn P₁ P₂, (1 : ℝ) / p := by
    have h := sum_inv_primesIn_ge P₁ hP₁
    have hsub : primesIn P₁ (4 * P₁) ⊆ primesIn P₁ P₂ :=
      Finset.filter_subset_filter _ (Finset.Ico_subset_Ico le_rfl hP)
    have h2 : ∑ p ∈ primesIn P₁ (4 * P₁), (1 : ℝ) / p ≤ ∑ p ∈ primesIn P₁ P₂, (1 : ℝ) / p :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    have hlog : 0 < Real.log P₁ := Real.log_pos (by linarith)
    have : 0 < 1 / (16 * Real.log P₁) := by positivity
    linarith
  have hFS : α * ∑ p ∈ primesIn P₁ P₂, (1 : ℝ) / p ≤ ∑ p ∈ primesIn P₁ P₂, 1 / (p : ℝ) * F p := by
    have h := hE
    unfold lavg wavg at h
    rw [le_div_iff₀ hS0] at h
    linarith
  -- the `4`-adic blocks
  set J := Nat.log 4 (P₂ / P₁) with hJ
  have hq : 4 ≤ P₂ / P₁ := (Nat.le_div_iff_mul_le hP₁0).mpr (by linarith)
  have hq0 : P₂ / P₁ ≠ 0 := by omega
  have hJ1 : 1 ≤ J := (Nat.le_log_iff_pow_le (by norm_num) hq0).mpr (by simpa using hq)
  have hJlo : 4 ^ J * P₁ ≤ P₂ :=
    (Nat.mul_le_mul_right P₁ (Nat.pow_log_le_self 4 hq0)).trans (Nat.div_mul_le_self P₂ P₁)
  have hJhi : P₂ < 4 ^ (J + 1) * P₁ := by
    have h1 := Nat.lt_pow_succ_log_self (by norm_num : 1 < 4) (P₂ / P₁)
    have h2 : P₂ < P₂ / P₁ * P₁ + P₁ := Nat.lt_div_mul_add hP₁0
    have h3 : P₂ / P₁ * P₁ + P₁ ≤ 4 ^ (J + 1) * P₁ := by
      have : P₂ / P₁ + 1 ≤ 4 ^ (J + 1) := h1
      calc P₂ / P₁ * P₁ + P₁ = (P₂ / P₁ + 1) * P₁ := by ring
        _ ≤ 4 ^ (J + 1) * P₁ := Nat.mul_le_mul_right P₁ this
    omega
  set x : ℕ → ℕ := fun j => if j < J then 4 ^ j * P₁ else P₂ with hx
  have hx0 : x 0 = P₁ := by rw [hx]; simp only; rw [if_pos (by omega)]; simp
  have hxJ : x J = P₂ := by rw [hx]; simp
  have hxj : ∀ j < J, x j = 4 ^ j * P₁ := fun j hj => by rw [hx]; simp only; rw [if_pos hj]
  have hx4 : ∀ j < J, 4 * x j ≤ x (j + 1) := by
    intro j hj
    rw [hxj j hj]
    by_cases h : j + 1 < J
    · rw [hxj (j + 1) h, pow_succ]; ring_nf; exact le_rfl
    · have hj' : j + 1 = J := by omega
      rw [hx]; simp only; rw [if_neg h]
      rw [← hj', pow_succ] at hJlo
      linarith
  have hx16 : ∀ j < J, x (j + 1) ≤ 16 * x j := by
    intro j hj
    rw [hxj j hj]
    by_cases h : j + 1 < J
    · rw [hxj (j + 1) h]
      calc 4 ^ (j + 1) * P₁ = 4 * (4 ^ j * P₁) := by ring
        _ ≤ 16 * (4 ^ j * P₁) := Nat.mul_le_mul_right _ (by norm_num)
    · have hj' : j + 1 = J := by omega
      rw [hx]; simp only; rw [if_neg h]
      rw [← hj', pow_succ, pow_succ] at hJhi
      nlinarith
  have hxmono : ∀ j < J, x j ≤ x (j + 1) := fun j hj => by have := hx4 j hj; omega
  have hxP₁ : ∀ j < J, P₁ ≤ x j := by
    intro j hj
    rw [hxj j hj]
    exact Nat.le_mul_of_pos_left P₁ (by positivity)
  have hxP₂ : ∀ j ≤ J, x j ≤ P₂ := by
    intro j hj
    rcases hj.lt_or_eq with h | h
    · rw [hxj j h]
      exact (Nat.mul_le_mul_right P₁ (Nat.pow_le_pow_right (by norm_num) h.le)).trans hJlo
    · rw [h, hxJ]
  -- tiling
  have htile : ∀ g : ℕ → ℝ, ∑ p ∈ primesIn P₁ P₂, g p =
      ∑ j ∈ Finset.range J, ∑ p ∈ primesIn (x j) (x (j + 1)), g p := by
    intro g
    rw [sum_pieces g x J hxmono, hx0, hxJ]
  -- pigeonhole over the blocks
  obtain ⟨j, hjJ, hjF⟩ : ∃ j ∈ Finset.range J, α * ∑ p ∈ primesIn (x j) (x (j + 1)), (1 : ℝ) / p ≤
      ∑ p ∈ primesIn (x j) (x (j + 1)), 1 / (p : ℝ) * F p := by
    by_contra h
    push Not at h
    have hlt := Finset.sum_lt_sum_of_nonempty ⟨0, Finset.mem_range.mpr (by omega)⟩ h
    rw [← Finset.mul_sum, ← htile, ← htile] at hlt
    linarith
  have hj := Finset.mem_range.mp hjJ
  have hxjR : (2 : ℝ) ^ 24 ≤ x j := by
    have := hxP₁ j hj; exact le_trans hP₁R (by exact_mod_cast this)
  have hxj24 : 2 ^ 24 ≤ x j := le_trans hP₁ (hxP₁ j hj)
  have hxj0 : (0 : ℝ) < x j := lt_of_lt_of_le (by positivity) hxjR
  have hlogx : 0 < Real.log (x j) := Real.log_pos (by linarith)
  -- the block has `∑ F ≥ α x_j / (16 log x_j)`
  have hBinv : 1 / (16 * Real.log (x j)) ≤ ∑ p ∈ primesIn (x j) (x (j + 1)), (1 : ℝ) / p := by
    have h := sum_inv_primesIn_ge (x j) hxj24
    have hsub : primesIn (x j) (4 * x j) ⊆ primesIn (x j) (x (j + 1)) :=
      Finset.filter_subset_filter _ (Finset.Ico_subset_Ico le_rfl (hx4 j hj))
    exact h.trans (Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity))
  have hBsub : primesIn (x j) (x (j + 1)) ⊆ primesIn P₁ P₂ :=
    Finset.filter_subset_filter _ (Finset.Ico_subset_Ico (hxP₁ j hj) (hxP₂ (j + 1) hj))
  have hBF : α * x j / (16 * Real.log (x j)) ≤ ∑ p ∈ primesIn (x j) (x (j + 1)), F p := by
    have h1 : (x j : ℝ) * ∑ p ∈ primesIn (x j) (x (j + 1)), 1 / (p : ℝ) * F p ≤
        ∑ p ∈ primesIn (x j) (x (j + 1)), F p := by
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro p hp
      have hpx : (x j : ℝ) ≤ p := by
        exact_mod_cast (Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1).1
      have hF0 := hF p (hBsub hp)
      have hp0 : (0 : ℝ) < p := lt_of_lt_of_le hxj0 hpx
      rw [← mul_assoc, mul_one_div]
      calc (x j : ℝ) / p * F p ≤ 1 * F p :=
            mul_le_mul_of_nonneg_right ((div_le_one hp0).mpr hpx) hF0
        _ = F p := one_mul _
    calc α * x j / (16 * Real.log (x j)) = x j * (α * (1 / (16 * Real.log (x j)))) := by
          field_simp
      _ ≤ x j * (α * ∑ p ∈ primesIn (x j) (x (j + 1)), (1 : ℝ) / p) := by
          apply mul_le_mul_of_nonneg_left _ hxj0.le
          exact mul_le_mul_of_nonneg_left hBinv hα.le
      _ ≤ x j * ∑ p ∈ primesIn (x j) (x (j + 1)), 1 / (p : ℝ) * F p :=
          mul_le_mul_of_nonneg_left hjF hxj0.le
      _ ≤ _ := h1
  -- dyadic pigeonhole inside the block
  set m := Nat.log 2 (x j) with hm
  have hxj0' : x j ≠ 0 := by omega
  have hmaps : ∀ p ∈ primesIn (x j) (x (j + 1)), Nat.log 2 p ∈ Finset.Icc m (m + 4) := by
    intro p hp
    have hp' := Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1
    refine Finset.mem_Icc.mpr ⟨Nat.log_mono_right hp'.1, ?_⟩
    have h1 : p < 2 ^ (m + 5) := by
      have h2 := Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) (x j)
      have h3 := hx16 j hj
      rw [← hm] at h2
      have : 2 ^ (m + 5) = 16 * 2 ^ (m + 1) := by ring
      omega
    have := (Nat.log_lt_iff_lt_pow (by norm_num) (by omega)).mpr h1
    omega
  have hdec : ∑ p ∈ primesIn (x j) (x (j + 1)), F p =
      ∑ i ∈ Finset.Icc m (m + 4), ∑ p ∈ (primesIn (x j) (x (j + 1))).filter
        (fun p => Nat.log 2 p = i), F p :=
    (Finset.sum_fiberwise_of_maps_to hmaps _).symm
  obtain ⟨i, hi, hiF⟩ : ∃ i ∈ Finset.Icc m (m + 4),
      (∑ p ∈ primesIn (x j) (x (j + 1)), F p) / 5 ≤
        ∑ p ∈ (primesIn (x j) (x (j + 1))).filter (fun p => Nat.log 2 p = i), F p := by
    by_contra h
    push Not at h
    have hlt := Finset.sum_lt_sum_of_nonempty ⟨m, Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩⟩ h
    rw [Finset.sum_const, Nat.card_Icc, ← hdec] at hlt
    have : (m + 4 + 1 - m) = 5 := by omega
    rw [this, nsmul_eq_mul] at hlt
    push_cast at hlt
    linarith
  obtain ⟨hi0, hi4⟩ := Finset.mem_Icc.mp hi
  -- size comparison: `2^i ≤ 16 x_j` and `log x_j ≤ (i+1) log 2`
  have h2i : (2 : ℝ) ^ i ≤ 16 * x j := by
    have h1 : 2 ^ i ≤ 2 ^ (m + 4) := Nat.pow_le_pow_right (by norm_num) hi4
    have h2 : 2 ^ m ≤ x j := Nat.pow_log_le_self 2 hxj0'
    have : 2 ^ i ≤ 16 * x j := by
      have : 2 ^ (m + 4) = 16 * 2 ^ m := by ring
      omega
    exact_mod_cast this
  have hlog2 : Real.log 2 < 0.6932 := by have := Real.log_two_lt_d9; linarith
  have hlog20 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogi : Real.log (x j) ≤ ((i : ℝ) + 1) * Real.log 2 := by
    have h1 : x j < 2 ^ (i + 1) :=
      lt_of_lt_of_le (Nat.lt_pow_succ_log_self (by norm_num) (x j))
        (Nat.pow_le_pow_right (by norm_num) (by omega))
    have h1' : (x j : ℝ) < (2 : ℝ) ^ (i + 1) := by exact_mod_cast h1
    have := Real.log_le_log hxj0 h1'.le
    rw [Real.log_pow] at this
    push_cast at this
    linarith
  have hmain : α / 1000 * (2 ^ i / ((i : ℝ) + 1)) ≤
      ∑ p ∈ (primesIn (x j) (x (j + 1))).filter (fun p => Nat.log 2 p = i), F p := by
    refine le_trans ?_ hiF
    have hi1 : (0 : ℝ) < (i : ℝ) + 1 := by positivity
    rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 5)]
    refine le_trans ?_ hBF
    rw [le_div_iff₀ (by positivity)]
    -- `α 2^i/(1000(i+1)) · 5 · 16 log x_j ≤ α x_j`
    have e : α / 1000 * (2 ^ i / ((i : ℝ) + 1)) * 5 * (16 * Real.log (x j)) =
        α * (2 : ℝ) ^ i * (80 * Real.log (x j)) / (1000 * ((i : ℝ) + 1)) := by
      field_simp
      ring
    rw [e, div_le_iff₀ (by positivity)]
    have h3 : 80 * Real.log (x j) ≤ 80 * (((i : ℝ) + 1) * Real.log 2) := by linarith
    have h4 : α * (2 : ℝ) ^ i * (80 * Real.log (x j)) ≤
        α * (16 * x j) * (80 * (((i : ℝ) + 1) * Real.log 2)) := by
      apply mul_le_mul (mul_le_mul_of_nonneg_left h2i hα.le) h3 (by positivity) (by positivity)
    have h5 : α * (16 * x j) * (80 * (((i : ℝ) + 1) * Real.log 2)) ≤
        α * x j * (1000 * ((i : ℝ) + 1)) := by
      have : 16 * 80 * Real.log 2 ≤ 1000 := by linarith
      have hpos : 0 ≤ α * x j * ((i : ℝ) + 1) := by positivity
      nlinarith
    linarith
  -- transfer to `P ∩ [2^i, 2^{i+1})`
  have hsubi : (primesIn (x j) (x (j + 1))).filter (fun p => Nat.log 2 p = i) ⊆
      (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)) := by
    intro p hp
    obtain ⟨hpB, hpi⟩ := Finset.mem_filter.mp hp
    have hp0 : p ≠ 0 := (Finset.mem_filter.mp hpB).2.ne_zero
    exact Finset.mem_filter.mpr ⟨hBsub hpB, (log2_eq_iff hp0).mp hpi⟩
  have hfinal : ∑ p ∈ (primesIn (x j) (x (j + 1))).filter (fun p => Nat.log 2 p = i), F p ≤
      ∑ p ∈ (primesIn P₁ P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)), F p := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hsubi
    intro p hp _
    exact hF p (Finset.mem_filter.mp hp).1
  -- the block is nonempty, hence meets `[P₁, P₂)`
  have hpos : 0 < ∑ p ∈ (primesIn (x j) (x (j + 1))).filter (fun p => Nat.log 2 p = i), F p :=
    lt_of_lt_of_le (by positivity) hmain
  obtain ⟨p, hp⟩ : ((primesIn (x j) (x (j + 1))).filter (fun p => Nat.log 2 p = i)).Nonempty := by
    by_contra h
    rw [Finset.not_nonempty_iff_eq_empty] at h
    rw [h, Finset.sum_empty] at hpos
    exact lt_irrefl _ hpos
  have hpP := Finset.mem_filter.mp (hsubi hp)
  have hpI := Finset.mem_Ico.mp (Finset.mem_filter.mp hpP.1).1
  exact ⟨i, by omega, by omega, hmain.trans hfinal⟩

end LemmaM54

end G22.FPDQ

end

/- ## Section: `Lemma26` -/

section

/-
# GS Lemma 2.6 (two-level FPD form)

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, Lemma 2.6 (pp. 8–9). Notation (GS §1.4, real
valued): `Δ_{(a,b)} ψ (m) = ψ(m + a) ψ(m + b)` (`dl ψ a b m`).

## Main results (namespace `G22.L26`)

* `lemma26`: if `ψ` is 1-bounded and
  `δ ≤ E_{n∈[X,2X)} E_{t₁,t₁'∈[T₁]} E_{t₂,t₂'∈[T₂]} E_{s₁∈S₁,s₂∈S₂}
      ψ(n+t₁s₁+t₂s₂) ψ(n+t₁'s₁+t₂s₂) ψ(n+t₁s₁+t₂'s₂) ψ(n+t₁'s₁+t₂'s₂)`,
  and the sets `S₁, S₂` satisfy the FPD hypotheses of `L24.lemma25_gen` at the levels
  `δ/4` and `δ₂/2` (`δ₂ = δ³/(3200 Q₁²)`), then there are `1 ≤ qᵢ ≤ Qᵢ` with
  `δ₂³/(800 Q₂²) ≤ E_{n∈[2X]} E_{h₁,h₁'∈[H₁]} E_{h₂,h₂'∈[H₂]}
      ψ(n+q₁h₁+q₂h₂) ψ(n+q₁h₁'+q₂h₂) ψ(n+q₁h₁+q₂h₂') ψ(n+q₁h₁'+q₂h₂')`.
* `lemma26_one`: the case `Q₁ = Q₂ = 1` (as supplied by Lemma L, `FPD.lemmaL`).
* `level_step`: one level of the argument — a "linear pigeonhole" version of GS's two averaging
  steps, for an arbitrary finite family of 1-bounded functions.

## Proof

With `τ = (t₂, t₂', s₂)` and `f_τ = Δ_{(t₂s₂, t₂'s₂)} ψ`, the hypothesis reads `δ ≤ E_τ a_τ` with
`a_τ = E_{n∈[X,2X)} A_τ(n)`, `A_τ(n) = E_{t₁,t₁'} E_{s₁} f_τ(n+t₁s₁) f_τ(n+t₁'s₁)
= E_{s₁} (E_{t₁} f_τ(n+t₁s₁))² ∈ [0,1]` (`ident1`, `cA_eq`). For `a_τ ≥ δ/2` the average over
`n ∈ [2X]` is `≥ a_τ/2 ≥ δ/4` (`dAvg_le_two_uavg`), so `L24.lemma25_gen` gives `q ≤ Q₁` with
`δ²/(1600 Q₁) ≤ B_τ(q) := E_{n∈[2X]} (E_{h₁} f_τ(n+qh₁))²`. Pointwise in `τ`,
`δ²/(1600 Q₁) · (a_τ - δ/2) ≤ ∑_{q ≤ Q₁} B_τ(q)` (as `a_τ ≤ 1` and `B ≥ 0`); averaging over `τ`
and pigeonholing in `q` gives `q₁` with `E_τ B_τ(q₁) ≥ δ³/(3200 Q₁²) = δ₂` (`level_step`).
Reordering the averages,
`E_τ B_τ(q₁) = E_{h₁,h₁'} E_{n∈[2X]} E_{t₂,t₂'} E_{s₂} g(n+t₂s₂) g(n+t₂'s₂)`
with `g = Δ_{(q₁h₁, q₁h₁')} ψ` (`ident2`), and the same argument (now with `a = ` the inner
average itself, level `δ₂/2`) gives `q₂` with the final bound `δ₂³/(800 Q₂²)`; a last reordering
(`ident4`) gives the conclusion.
-/

open Finset Real

namespace G22.L26

open L24

/-- The average `E_{n ∈ [X, 2X)} F(n)` over a dyadic interval. -/
noncomputable def dAvg (X : ℕ) (F : ℕ → ℝ) : ℝ := wavg (Finset.Ico X (2 * X)) (fun _ => 1) F

/- ### Generic facts about uniform averages -/

section Generic

variable {α β : Type*}

lemma sum_div_card_eq_wavg (S : Finset α) (F : α → ℝ) :
    (∑ s ∈ S, F s) / S.card = wavg S (fun _ => 1) F := by
  simp [wavg]

lemma sum_sum_div_card_eq (S₁ : Finset α) (S₂ : Finset β) (F : α → β → ℝ) :
    (∑ s₁ ∈ S₁, ∑ s₂ ∈ S₂, F s₁ s₂) / ((S₁.card : ℝ) * S₂.card) =
      wavg S₁ (fun _ => 1) (fun s₁ => wavg S₂ (fun _ => 1) (fun s₂ => F s₁ s₂)) := by
  simp only [← sum_div_card_eq_wavg]
  rw [← Finset.sum_div, div_div, mul_comm (S₂.card : ℝ)]

/-- Fubini for uniform averages over a product. -/
lemma wavg_product_one (s : Finset α) (t : Finset β) (F : α × β → ℝ) :
    wavg (s ×ˢ t) (fun _ => 1) F =
      wavg s (fun _ => 1) (fun a => wavg t (fun _ => 1) (fun b => F (a, b))) := by
  simp only [← sum_div_card_eq_wavg]
  rw [Finset.sum_product, ← Finset.sum_div, div_div, Finset.card_product, Nat.cast_mul,
    mul_comm (t.card : ℝ)]

/-- `(E F)² = E_{x,y} F(x) F(y)`. -/
lemma wavg_sq (s : Finset α) (w : α → ℝ) (F : α → ℝ) :
    (wavg s w F) ^ 2 = wavg s w (fun x => wavg s w (fun y => F x * F y)) := by
  have h : (fun x => wavg s w (fun y => F x * F y)) = fun x => F x * wavg s w F :=
    funext fun x => wavg_smul (F x) F
  rw [h, ← Elem.wavg_mul_const]
  ring

lemma uavg_sq (H : ℕ) (F : ℕ → ℝ) :
    (uavg H F) ^ 2 = uavg H (fun x => uavg H (fun y => F x * F y)) :=
  wavg_sq _ _ _

lemma wavg_one_nonneg (s : Finset α) {F : α → ℝ} (hF : ∀ x ∈ s, 0 ≤ F x) :
    0 ≤ wavg s (fun _ => 1) F := by
  unfold wavg
  exact div_nonneg (Finset.sum_nonneg fun x hx => by simpa using hF x hx)
    (Finset.sum_nonneg fun _ _ => zero_le_one)

lemma wavg_one_le (s : Finset α) {F : α → ℝ} {c : ℝ} (hc : 0 ≤ c) (hF : ∀ x ∈ s, F x ≤ c) :
    wavg s (fun _ => 1) F ≤ c := by
  rcases s.eq_empty_or_nonempty with rfl | hs
  · simp [wavg, hc]
  · exact wavg_le_of_le ⟨fun _ _ => one_pos, hs⟩ hF

lemma abs_uavg_le_one {H : ℕ} {g : ℕ → ℝ} (hg : ∀ h, |g h| ≤ 1) : |uavg H g| ≤ 1 := by
  rcases Nat.eq_zero_or_pos H with rfl | hH
  · simp [uavg, wavg]
  · exact abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun h _ => hg h

end Generic

/- ### Reordering nested averages -/

section Reorder

variable {α₁ α₂ α₃ α₄ α₅ α₆ : Type*}

/-- Move the outermost of three averages to the inside. -/
lemma push12 (A₁ : Finset α₁) (w₁ : α₁ → ℝ) (A₂ : Finset α₂) (w₂ : α₂ → ℝ)
    (A₃ : Finset α₃) (w₃ : α₃ → ℝ) (K : α₁ → α₂ → α₃ → ℝ) :
    wavg A₁ w₁ (fun a => wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => K a b c))) =
      wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => wavg A₁ w₁ (fun a => K a b c))) := by
  rw [Elem.wavg_comm]
  refine wavg_congr fun b _ => ?_
  exact Elem.wavg_comm _ _ _ _ _

/-- Move the innermost of three averages to the outside. -/
lemma pull21 (A₁ : Finset α₁) (w₁ : α₁ → ℝ) (A₂ : Finset α₂) (w₂ : α₂ → ℝ)
    (A₃ : Finset α₃) (w₃ : α₃ → ℝ) (K : α₁ → α₂ → α₃ → ℝ) :
    wavg A₁ w₁ (fun a => wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => K a b c))) =
      wavg A₃ w₃ (fun c => wavg A₁ w₁ (fun a => wavg A₂ w₂ (fun b => K a b c))) :=
  (push12 A₃ w₃ A₁ w₁ A₂ w₂ (fun c a b => K a b c)).symm

/-- Move the outermost of four averages to the inside. -/
lemma push13 (A₁ : Finset α₁) (w₁ : α₁ → ℝ) (A₂ : Finset α₂) (w₂ : α₂ → ℝ)
    (A₃ : Finset α₃) (w₃ : α₃ → ℝ) (A₄ : Finset α₄) (w₄ : α₄ → ℝ)
    (K : α₁ → α₂ → α₃ → α₄ → ℝ) :
    wavg A₁ w₁ (fun a => wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => wavg A₄ w₄ (fun d =>
      K a b c d)))) =
      wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => wavg A₄ w₄ (fun d => wavg A₁ w₁ (fun a =>
        K a b c d)))) := by
  rw [Elem.wavg_comm]
  refine wavg_congr fun b _ => ?_
  exact push12 A₁ w₁ A₃ w₃ A₄ w₄ (fun a c d => K a b c d)

/-- Rotate six nested averages by three: `[a b c d e g] ↦ [d e g a b c]`. -/
lemma rot33 (A₁ : Finset α₁) (w₁ : α₁ → ℝ) (A₂ : Finset α₂) (w₂ : α₂ → ℝ)
    (A₃ : Finset α₃) (w₃ : α₃ → ℝ) (A₄ : Finset α₄) (w₄ : α₄ → ℝ)
    (A₅ : Finset α₅) (w₅ : α₅ → ℝ) (A₆ : Finset α₆) (w₆ : α₆ → ℝ)
    (F : α₁ → α₂ → α₃ → α₄ → α₅ → α₆ → ℝ) :
    wavg A₁ w₁ (fun a => wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => wavg A₄ w₄ (fun d =>
      wavg A₅ w₅ (fun e => wavg A₆ w₆ (fun g => F a b c d e g)))))) =
      wavg A₄ w₄ (fun d => wavg A₅ w₅ (fun e => wavg A₆ w₆ (fun g => wavg A₁ w₁ (fun a =>
        wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => F a b c d e g)))))) := by
  have h1 : ∀ a b, wavg A₃ w₃ (fun c => wavg A₄ w₄ (fun d => wavg A₅ w₅ (fun e =>
      wavg A₆ w₆ (fun g => F a b c d e g)))) =
      wavg A₄ w₄ (fun d => wavg A₅ w₅ (fun e => wavg A₆ w₆ (fun g =>
        wavg A₃ w₃ (fun c => F a b c d e g)))) :=
    fun a b => push13 A₃ w₃ A₄ w₄ A₅ w₅ A₆ w₆ (fun c d e g => F a b c d e g)
  have h2 : ∀ a, wavg A₂ w₂ (fun b => wavg A₄ w₄ (fun d => wavg A₅ w₅ (fun e =>
      wavg A₆ w₆ (fun g => wavg A₃ w₃ (fun c => F a b c d e g))))) =
      wavg A₄ w₄ (fun d => wavg A₅ w₅ (fun e => wavg A₆ w₆ (fun g =>
        wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => F a b c d e g))))) :=
    fun a => push13 A₂ w₂ A₄ w₄ A₅ w₅ A₆ w₆
      (fun b d e g => wavg A₃ w₃ (fun c => F a b c d e g))
  simp only [h1, h2]
  exact push13 A₁ w₁ A₄ w₄ A₅ w₅ A₆ w₆
    (fun a d e g => wavg A₂ w₂ (fun b => wavg A₃ w₃ (fun c => F a b c d e g)))

end Reorder

/- ### Difference operators and the correlation of Lemma 2.5 -/

/-- `Δ_{(a,b)} ψ (m) = ψ(m + a) ψ(m + b)` (GS §1.4, real-valued). -/
def dl (ψ : ℤ → ℝ) (a b m : ℤ) : ℝ := ψ (m + a) * ψ (m + b)

lemma abs_dl_le {ψ : ℤ → ℝ} (hψ : ∀ n, |ψ n| ≤ 1) (a b m : ℤ) : |dl ψ a b m| ≤ 1 :=
  Elem.abs_mul_le_one (hψ _) (hψ _)

lemma dl_swap (ψ : ℤ → ℝ) (m a b c d : ℤ) :
    dl ψ a b (m + c) * dl ψ a b (m + d) = dl ψ c d (m + a) * dl ψ c d (m + b) := by
  unfold dl
  rw [add_right_comm m c a, add_right_comm m c b, add_right_comm m d a, add_right_comm m d b]
  ring

lemma dl_mul_dl (ψ : ℤ → ℝ) (m c d e e' : ℤ) :
    dl ψ c d (m + e) * dl ψ c d (m + e') =
      ψ (m + c + e) * ψ (m + d + e) * ψ (m + c + e') * ψ (m + d + e') := by
  unfold dl
  rw [add_right_comm m e c, add_right_comm m e d, add_right_comm m e' c, add_right_comm m e' d]
  ring

/-- The correlation of GS Lemma 2.5 at the point `n`:
`A(n) = E_{t,t' ∈ [T]} E_{s ∈ S} f(n + ts) f(n + t's)`. -/
noncomputable def cA (T : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) (n : ℤ) : ℝ :=
  uavg T (fun t => uavg T (fun t' => (∑ s ∈ S, f (n + t * s) * f (n + t' * s)) / S.card))

/-- `A(n) = E_{s∈S} (E_{t∈[T]} f(n + ts))²`. -/
lemma cA_eq (T : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) (n : ℤ) :
    cA T S f n = wavg S (fun _ => 1) (fun s => (uavg T (fun t => f (n + t * s))) ^ 2) := by
  unfold cA
  simp only [sum_div_card_eq_wavg, uavg_sq]
  exact pull21 (Icc 1 T) (fun _ => 1) (Icc 1 T) (fun _ => 1) S (fun _ => 1)
    (fun t t' s => f (n + t * s) * f (n + t' * s))

lemma cA_nonneg (T : ℕ) (S : Finset ℤ) (f : ℤ → ℝ) (n : ℤ) : 0 ≤ cA T S f n := by
  rw [cA_eq]
  exact wavg_one_nonneg _ fun s _ => sq_nonneg _

lemma cA_le_one (T : ℕ) (S : Finset ℤ) {f : ℤ → ℝ} (hf : ∀ n, |f n| ≤ 1) (n : ℤ) :
    cA T S f n ≤ 1 := by
  rw [cA_eq]
  refine wavg_one_le _ zero_le_one fun s _ => ?_
  exact (sq_le_one_iff_abs_le_one _).mpr (abs_uavg_le_one fun _ => hf _)

/-- For non-negative `F`, the dyadic average is at most twice the average over `[2X]`. -/
lemma dAvg_le_two_uavg {X : ℕ} (hX : 1 ≤ X) {F : ℕ → ℝ} (hF : ∀ n, 0 ≤ F n) :
    dAvg X F ≤ 2 * uavg (2 * X) F := by
  unfold dAvg
  rw [← sum_div_card_eq_wavg, uavg_eq_sum_div, Nat.card_Ico, show 2 * X - X = X by omega]
  have hsub : Ico X (2 * X) ⊆ Icc 1 (2 * X) := by
    intro n hn
    simp only [Finset.mem_Ico, Finset.mem_Icc] at hn ⊢
    omega
  have hle := Finset.sum_le_sum_of_subset_of_nonneg hsub (fun n _ _ => hF n)
  have hXpos : (0 : ℝ) < X := by exact_mod_cast hX
  have e : 2 * ((∑ n ∈ Icc 1 (2 * X), F n) / ((2 * X : ℕ) : ℝ)) =
      (∑ n ∈ Icc 1 (2 * X), F n) / X := by
    push_cast
    field_simp
  rw [e]
  exact div_le_div_of_nonneg_right hle hXpos.le

/- ### One level of the argument -/

/-- **One level of GS Lemma 2.6.** Let `(f i)_{i ∈ I}` be 1-bounded functions and `a : I → ℝ`
with `a ≤ 1` and `δ ≤ E_{i∈I} a i`. If every `i` with `a i ≥ δ/2` satisfies the correlation
hypothesis of `L24.lemma25_gen` at level `δ'`, then some `1 ≤ q ≤ Q₀` has
`δ δ'²/(200 Q₀²) ≤ E_{i∈I} E_{n∈[X]} (E_{h∈[H]} f_i(n + qh))²`. -/
theorem level_step {ι : Type*} {I : Finset ι} (a : ι → ℝ) (f : ι → ℤ → ℝ)
    (hf : ∀ i n, |f i n| ≤ 1) {S : Finset ℤ} (hS : S.Nonempty) {T D X H : ℕ}
    (hSD : ∀ s ∈ S, |s| ≤ 4 * (D : ℤ)) (hX : 1 ≤ X) (hH : 1 ≤ H)
    {δ δ' Q₀ W : ℝ} (hδ : 0 < δ) (hδ' : 0 < δ')
    (hFPD : FPDProp S T D (δ' / 10) Q₀ W)
    (hTDX : 6400 * Q₀ * (T * D) ≤ δ' ^ 2 * X)
    (hHW : 16 * H * W ≤ T * D) (hHQ : 20 * Q₀ ^ 2 * H ≤ δ' ^ 2 * (T * D))
    (ha1 : ∀ i ∈ I, a i ≤ 1)
    (hgood : ∀ i ∈ I, δ / 2 ≤ a i → δ' ≤ uavg X (fun n => cA T S (f i) n))
    (hcorr : δ ≤ wavg I (fun _ => 1) a) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧
      δ * δ' ^ 2 / (200 * Q₀ ^ 2) ≤
        wavg I (fun _ => 1)
          (fun i => uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2)) := by
  classical
  -- `I` is nonempty
  have hI : I.Nonempty := by
    rcases I.eq_empty_or_nonempty with h | h
    · rw [h] at hcorr
      simp [wavg] at hcorr
      linarith
    · exact h
  have hw : GoodWeights I (fun _ : ι => (1 : ℝ)) := ⟨fun _ _ => one_pos, hI⟩
  -- the conclusion of Lemma 2.5 for good `i`
  have hL25 : ∀ i ∈ I, δ / 2 ≤ a i → ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q₀ ∧
      δ' ^ 2 / (100 * Q₀) ≤ uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2) :=
    fun i hi hai => lemma25_gen hS hSD (hf i) hX hH hδ' (by positivity) le_rfl hFPD hTDX hHW hHQ
      (hgood i hi hai)
  -- a good `i` exists, hence `Q₀ ≥ 1`
  have hex : ∃ i ∈ I, δ / 2 ≤ a i := by
    by_contra hno
    push Not at hno
    have : wavg I (fun _ => 1) a ≤ δ / 2 := wavg_le_of_le hw fun i hi => (hno i hi).le
    linarith
  obtain ⟨i₀, hi₀, hai₀⟩ := hex
  obtain ⟨q₀, hq₀1, hq₀Q, -⟩ := hL25 i₀ hi₀ hai₀
  have hQ₀ : 1 ≤ Q₀ := le_trans (by exact_mod_cast hq₀1) hq₀Q
  set Q : ℕ := ⌊Q₀⌋₊ with hQdef
  have hQ1 : 1 ≤ Q := Nat.le_floor (by exact_mod_cast hQ₀)
  have hQQ₀ : (Q : ℝ) ≤ Q₀ := Nat.floor_le (by linarith)
  set c : ℝ := δ' ^ 2 / (100 * Q₀) with hc
  have hcpos : 0 < c := by positivity
  have hB0 : ∀ i (q : ℕ), 0 ≤ uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2) :=
    fun i q => wavg_one_nonneg _ fun _ _ => sq_nonneg _
  -- pointwise inequality
  have hpt : ∀ i ∈ I, c * (a i - δ / 2) ≤
      ∑ q ∈ Icc 1 Q, uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2) := by
    intro i hi
    by_cases hai : δ / 2 ≤ a i
    · obtain ⟨q, hq1, hqQ, hqB⟩ := hL25 i hi hai
      have hqI : q ∈ Icc 1 Q := Finset.mem_Icc.mpr ⟨hq1, Nat.le_floor hqQ⟩
      calc c * (a i - δ / 2) ≤ c * 1 :=
            mul_le_mul_of_nonneg_left (by linarith [ha1 i hi]) hcpos.le
        _ = c := mul_one c
        _ ≤ uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2) := hqB
        _ ≤ _ := Finset.single_le_sum (f := fun q : ℕ =>
              uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2))
              (fun q _ => hB0 i q) hqI
    · push Not at hai
      have : c * (a i - δ / 2) ≤ 0 := by nlinarith
      exact this.trans (Finset.sum_nonneg fun q _ => hB0 i q)
  -- average over `i`
  have havg : c * (δ / 2) ≤ ∑ q ∈ Icc 1 Q,
      wavg I (fun _ => 1) (fun i => uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2)) := by
    have h1 := wavg_mono hw hpt
    rw [wavg_sum] at h1
    have h2 : wavg I (fun _ => 1) (fun i => c * (a i - δ / 2)) =
        c * (wavg I (fun _ => 1) a - δ / 2) := by
      rw [wavg_smul, wavg_sub, wavg_const hw]
    rw [h2] at h1
    have : c * (δ / 2) ≤ c * (wavg I (fun _ => 1) a - δ / 2) :=
      mul_le_mul_of_nonneg_left (by linarith) hcpos.le
    linarith
  -- pigeonhole in `q`
  have hne : (Icc 1 Q).Nonempty := Finset.nonempty_Icc.mpr hQ1
  have hQpos : (0 : ℝ) < Q := by exact_mod_cast hQ1
  have hconst : ∑ q ∈ Icc 1 Q, c * (δ / 2) / Q ≤ ∑ q ∈ Icc 1 Q,
      wavg I (fun _ => 1) (fun i => uavg X (fun n => (uavg H (fun h => f i (n + q * h))) ^ 2)) := by
    rw [Finset.sum_const, Nat.card_Icc, Nat.add_sub_cancel, nsmul_eq_mul,
      mul_div_cancel₀ _ hQpos.ne']
    exact havg
  obtain ⟨q, hq, hqB⟩ := Finset.exists_le_of_sum_le hne hconst
  have hq' := Finset.mem_Icc.mp hq
  refine ⟨q, hq'.1, ?_, ?_⟩
  · have : (q : ℝ) ≤ Q := by exact_mod_cast hq'.2
    linarith
  · refine le_trans ?_ hqB
    have e : δ * δ' ^ 2 / (200 * Q₀ ^ 2) = c * (δ / 2) / Q₀ := by
      rw [hc]; field_simp; ring
    rw [e]
    exact div_le_div_of_nonneg_left (by positivity) hQpos hQQ₀

/- ### Reordering the averages of Lemma 2.6 -/

/-- The hypothesis of Lemma 2.6 as an average over `τ = (t₂, t₂', s₂)` of the correlations of
`f_τ = Δ_{(t₂s₂, t₂'s₂)} ψ` over `[X, 2X)`. -/
lemma ident1 (ψ : ℤ → ℝ) (S₁ S₂ : Finset ℤ) (T₁ T₂ X : ℕ) :
    dAvg X (fun n => uavg T₁ fun t₁ => uavg T₁ fun t₁' => uavg T₂ fun t₂ =>
      uavg T₂ fun t₂' =>
        (∑ s₁ ∈ S₁, ∑ s₂ ∈ S₂, ψ (n + t₁ * s₁ + t₂ * s₂) * ψ (n + t₁' * s₁ + t₂ * s₂) *
          ψ (n + t₁ * s₁ + t₂' * s₂) * ψ (n + t₁' * s₁ + t₂' * s₂)) / (S₁.card * S₂.card)) =
      wavg (Icc 1 T₂ ×ˢ (Icc 1 T₂ ×ˢ S₂)) (fun _ => 1)
        (fun τ => dAvg X (fun n => cA T₁ S₁ (dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) n)) := by
  simp only [wavg_product_one]
  refine Eq.trans ?_ (rot33 (Ico X (2 * X)) (fun _ => 1) (Icc 1 T₁) (fun _ => 1) (Icc 1 T₁)
    (fun _ => 1) (Icc 1 T₂) (fun _ => 1) (Icc 1 T₂) (fun _ => 1) S₂ (fun _ => 1)
    (fun n t₁ t₁' t₂ t₂' s₂ => (∑ s₁ ∈ S₁, dl ψ (t₂ * s₂) (t₂' * s₂) (n + t₁ * s₁) *
      dl ψ (t₂ * s₂) (t₂' * s₂) (n + t₁' * s₁)) / S₁.card))
  refine wavg_congr fun n _ => wavg_congr fun t₁ _ => wavg_congr fun t₁' _ =>
    wavg_congr fun t₂ _ => wavg_congr fun t₂' _ => ?_
  rw [sum_sum_div_card_eq, Elem.wavg_comm]
  refine wavg_congr fun s₂ _ => ?_
  rw [sum_div_card_eq_wavg]
  refine wavg_congr fun s₁ _ => ?_
  unfold dl
  ring

/-- `E_τ B_τ(q₁) = E_{h₁,h₁'} E_{n} A_{g}(n)` with `g = Δ_{(q₁h₁, q₁h₁')} ψ`. -/
lemma ident2 (ψ : ℤ → ℝ) (S₂ : Finset ℤ) (T₂ H₁ Y q₁ : ℕ) :
    wavg (Icc 1 T₂ ×ˢ (Icc 1 T₂ ×ˢ S₂)) (fun _ => 1)
      (fun τ => uavg Y (fun n =>
        (uavg H₁ (fun h => dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2) (n + q₁ * h))) ^ 2)) =
    wavg (Icc 1 H₁ ×ˢ Icc 1 H₁) (fun _ => 1)
      (fun hh => uavg Y (fun n => cA T₂ S₂ (dl ψ (q₁ * hh.1) (q₁ * hh.2)) n)) := by
  simp only [wavg_product_one, uavg_sq]
  refine (rot33 (Icc 1 T₂) (fun _ => 1) (Icc 1 T₂) (fun _ => 1) S₂ (fun _ => 1) (Icc 1 Y)
    (fun _ => 1) (Icc 1 H₁) (fun _ => 1) (Icc 1 H₁) (fun _ => 1)
    (fun a b c n x y => dl ψ (a * c) (b * c) (n + q₁ * x) *
      dl ψ (a * c) (b * c) (n + q₁ * y))).trans ?_
  refine (push12 (Icc 1 Y) (fun _ => 1) (Icc 1 H₁) (fun _ => 1) (Icc 1 H₁) (fun _ => 1)
    (fun n x y => wavg (Icc 1 T₂) (fun _ => 1) (fun a => wavg (Icc 1 T₂) (fun _ => 1)
      (fun b => wavg S₂ (fun _ => 1) (fun c => dl ψ (a * c) (b * c) (n + q₁ * x) *
        dl ψ (a * c) (b * c) (n + q₁ * y)))))).trans ?_
  refine wavg_congr fun x _ => wavg_congr fun y _ => wavg_congr fun n _ => ?_
  unfold cA
  refine wavg_congr fun a _ => wavg_congr fun b _ => ?_
  rw [sum_div_card_eq_wavg]
  refine wavg_congr fun c _ => ?_
  exact dl_swap ψ _ _ _ _ _

/-- The final reordering. -/
lemma ident4 (ψ : ℤ → ℝ) (H₁ H₂ Y q₁ q₂ : ℕ) :
    wavg (Icc 1 H₁ ×ˢ Icc 1 H₁) (fun _ => 1)
      (fun hh => uavg Y (fun n =>
        (uavg H₂ (fun h => dl ψ (q₁ * hh.1) (q₁ * hh.2) (n + q₂ * h))) ^ 2)) =
    uavg Y (fun n => uavg H₁ fun h₁ => uavg H₁ fun h₁' => uavg H₂ fun h₂ =>
      uavg H₂ fun h₂' =>
        ψ (n + q₁ * h₁ + q₂ * h₂) * ψ (n + q₁ * h₁' + q₂ * h₂) *
          ψ (n + q₁ * h₁ + q₂ * h₂') * ψ (n + q₁ * h₁' + q₂ * h₂')) := by
  simp only [wavg_product_one, uavg_sq]
  refine (pull21 (Icc 1 H₁) (fun _ => 1) (Icc 1 H₁) (fun _ => 1) (Icc 1 Y) (fun _ => 1)
    (fun x y n => uavg H₂ (fun h => uavg H₂ (fun h' =>
      dl ψ (q₁ * x) (q₁ * y) (n + q₂ * h) * dl ψ (q₁ * x) (q₁ * y) (n + q₂ * h'))))).trans ?_
  refine wavg_congr fun n _ => wavg_congr fun x _ => wavg_congr fun y _ =>
    wavg_congr fun h _ => wavg_congr fun h' _ => ?_
  exact dl_mul_dl ψ _ _ _ _ _

/- ### GS Lemma 2.6 -/

/-- **GS Lemma 2.6 (two-level FPD form).** Write `δ₂ = δ³/(3200 Q₁²)`. If `ψ` is 1-bounded,
`S₁, S₂` satisfy the FPD hypotheses of `L24.lemma25_gen` at the levels `δ/4` and `δ₂/2`
(thresholds `δ/40`, `δ₂/20`; `X` replaced by `2X`), and
`δ ≤ E_{n∈[X,2X)} E_{t₁,t₁'∈[T₁]} E_{t₂,t₂'∈[T₂]} E_{s₁∈S₁,s₂∈S₂}
  Δ_{s₁(t₁,t₁')} Δ_{s₂(t₂,t₂')} ψ(n)`,
then there are `1 ≤ qᵢ ≤ Qᵢ` with
`δ₂³/(800 Q₂²) ≤ E_{n∈[2X]} E_{h₁,h₁'∈[H₁]} E_{h₂,h₂'∈[H₂]} Δ_{q₁(h₁,h₁')} Δ_{q₂(h₂,h₂')} ψ(n)`. -/
theorem lemma26 {ψ : ℤ → ℝ} (hψ : ∀ n, |ψ n| ≤ 1)
    {S₁ S₂ : Finset ℤ} (hS₁ : S₁.Nonempty) (hS₂ : S₂.Nonempty)
    {T₁ T₂ D₁ D₂ H₁ H₂ X : ℕ} (hX : 1 ≤ X) (hH₁ : 1 ≤ H₁) (hH₂ : 1 ≤ H₂)
    (hSD₁ : ∀ s ∈ S₁, |s| ≤ 4 * (D₁ : ℤ)) (hSD₂ : ∀ s ∈ S₂, |s| ≤ 4 * (D₂ : ℤ))
    {δ Q₁ Q₂ W₁ W₂ : ℝ} (hδ : 0 < δ)
    (hFPD₁ : L24.FPDProp S₁ T₁ D₁ (δ / 40) Q₁ W₁)
    (hFPD₂ : L24.FPDProp S₂ T₂ D₂ (δ ^ 3 / (3200 * Q₁ ^ 2) / 20) Q₂ W₂)
    (hTDX₁ : 6400 * Q₁ * (T₁ * D₁) ≤ (δ / 4) ^ 2 * (2 * X))
    (hHW₁ : 16 * H₁ * W₁ ≤ T₁ * D₁) (hHQ₁ : 20 * Q₁ ^ 2 * H₁ ≤ (δ / 4) ^ 2 * (T₁ * D₁))
    (hTDX₂ : 6400 * Q₂ * (T₂ * D₂) ≤ (δ ^ 3 / (3200 * Q₁ ^ 2) / 2) ^ 2 * (2 * X))
    (hHW₂ : 16 * H₂ * W₂ ≤ T₂ * D₂)
    (hHQ₂ : 20 * Q₂ ^ 2 * H₂ ≤ (δ ^ 3 / (3200 * Q₁ ^ 2) / 2) ^ 2 * (T₂ * D₂))
    (hcorr : δ ≤ dAvg X (fun n => uavg T₁ fun t₁ => uavg T₁ fun t₁' => uavg T₂ fun t₂ =>
      uavg T₂ fun t₂' =>
        (∑ s₁ ∈ S₁, ∑ s₂ ∈ S₂, ψ (n + t₁ * s₁ + t₂ * s₂) * ψ (n + t₁' * s₁ + t₂ * s₂) *
          ψ (n + t₁ * s₁ + t₂' * s₂) * ψ (n + t₁' * s₁ + t₂' * s₂)) / (S₁.card * S₂.card))) :
    ∃ q₁ q₂ : ℕ, 1 ≤ q₁ ∧ (q₁ : ℝ) ≤ Q₁ ∧ 1 ≤ q₂ ∧ (q₂ : ℝ) ≤ Q₂ ∧
      (δ ^ 3 / (3200 * Q₁ ^ 2)) ^ 3 / (800 * Q₂ ^ 2) ≤
        uavg (2 * X) (fun n => uavg H₁ fun h₁ => uavg H₁ fun h₁' => uavg H₂ fun h₂ =>
          uavg H₂ fun h₂' =>
            ψ (n + q₁ * h₁ + q₂ * h₂) * ψ (n + q₁ * h₁' + q₂ * h₂) *
              ψ (n + q₁ * h₁ + q₂ * h₂') * ψ (n + q₁ * h₁' + q₂ * h₂')) := by
  -- Level 1: `τ = (t₂, t₂', s₂)`, `f_τ = Δ_{(t₂s₂, t₂'s₂)} ψ`
  have hcorr1 := hcorr.trans_eq (ident1 ψ S₁ S₂ T₁ T₂ X)
  have ha1 : ∀ τ ∈ Icc 1 T₂ ×ˢ (Icc 1 T₂ ×ˢ S₂),
      dAvg X (fun n => cA T₁ S₁ (dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) n) ≤ 1 :=
    fun τ _ => wavg_one_le _ zero_le_one fun n _ => cA_le_one _ _ (abs_dl_le hψ _ _) _
  have hgood1 : ∀ τ ∈ Icc 1 T₂ ×ˢ (Icc 1 T₂ ×ˢ S₂),
      δ / 2 ≤ dAvg X (fun n => cA T₁ S₁ (dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) n) →
      δ / 4 ≤ uavg (2 * X) (fun n => cA T₁ S₁ (dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) n) := by
    intro τ _ h
    have := dAvg_le_two_uavg hX (F := fun n => cA T₁ S₁ (dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) n)
      fun n => cA_nonneg _ _ _ _
    linarith
  obtain ⟨q₁, hq₁1, hq₁Q, hlev1⟩ := level_step (I := Icc 1 T₂ ×ˢ (Icc 1 T₂ ×ˢ S₂))
    (fun τ => dAvg X (fun n => cA T₁ S₁ (dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) n))
    (fun τ => dl ψ (τ.1 * τ.2.2) (τ.2.1 * τ.2.2)) (fun τ n => abs_dl_le hψ _ _ _)
    hS₁ hSD₁ (X := 2 * X) (by omega) hH₁ hδ (by positivity : (0 : ℝ) < δ / 4)
    (by rw [show δ / 4 / 10 = δ / 40 by ring]; exact hFPD₁)
    (by push_cast; linarith) hHW₁ hHQ₁ ha1 hgood1 hcorr1
  -- Level 2: `g = Δ_{(q₁h₁, q₁h₁')} ψ`
  have hQ₁ : 1 ≤ Q₁ := le_trans (by exact_mod_cast hq₁1) hq₁Q
  set δ₂ : ℝ := δ ^ 3 / (3200 * Q₁ ^ 2) with hδ₂
  have hδ₂pos : 0 < δ₂ := by positivity
  have hcorr2 : δ₂ ≤ wavg (Icc 1 H₁ ×ˢ Icc 1 H₁) (fun _ => 1)
      (fun hh => uavg (2 * X) (fun n => cA T₂ S₂ (dl ψ (q₁ * hh.1) (q₁ * hh.2)) n)) := by
    calc δ₂ = δ * (δ / 4) ^ 2 / (200 * Q₁ ^ 2) := by rw [hδ₂]; ring
      _ ≤ _ := hlev1.trans_eq (ident2 ψ S₂ T₂ H₁ (2 * X) q₁)
  have ha2 : ∀ hh ∈ Icc 1 H₁ ×ˢ Icc 1 H₁,
      uavg (2 * X) (fun n => cA T₂ S₂ (dl ψ (q₁ * hh.1) (q₁ * hh.2)) n) ≤ 1 :=
    fun hh _ => wavg_one_le _ zero_le_one fun n _ => cA_le_one _ _ (abs_dl_le hψ _ _) _
  obtain ⟨q₂, hq₂1, hq₂Q, hlev2⟩ := level_step (I := Icc 1 H₁ ×ˢ Icc 1 H₁)
    (fun hh => uavg (2 * X) (fun n => cA T₂ S₂ (dl ψ (q₁ * hh.1) (q₁ * hh.2)) n))
    (fun hh => dl ψ (q₁ * hh.1) (q₁ * hh.2)) (fun hh n => abs_dl_le hψ _ _ _)
    hS₂ hSD₂ (X := 2 * X) (by omega) hH₂ hδ₂pos (by positivity : (0 : ℝ) < δ₂ / 2)
    (by rw [show δ₂ / 2 / 10 = δ₂ / 20 by ring]; exact hFPD₂)
    (by push_cast; linarith) hHW₂ hHQ₂ ha2 (fun hh _ h => h) hcorr2
  refine ⟨q₁, q₂, hq₁1, hq₁Q, hq₂1, hq₂Q, ?_⟩
  calc δ₂ ^ 3 / (800 * Q₂ ^ 2) = δ₂ * (δ₂ / 2) ^ 2 / (200 * Q₂ ^ 2) := by ring
    _ ≤ _ := hlev2.trans_eq (ident4 ψ H₁ H₂ (2 * X) q₁ q₂)

/-- **GS Lemma 2.6 with `Q₁ = Q₂ = 1`** (the case supplied by Lemma L, `FPD.lemmaL`):
`(δ³/3200)³/800 ≤ E_{n∈[2X]} E_{h₁,h₁'∈[H₁]} E_{h₂,h₂'∈[H₂]}
  ψ(n+h₁+h₂) ψ(n+h₁'+h₂) ψ(n+h₁+h₂') ψ(n+h₁'+h₂')`. -/
theorem lemma26_one {ψ : ℤ → ℝ} (hψ : ∀ n, |ψ n| ≤ 1)
    {S₁ S₂ : Finset ℤ} (hS₁ : S₁.Nonempty) (hS₂ : S₂.Nonempty)
    {T₁ T₂ D₁ D₂ H₁ H₂ X : ℕ} (hX : 1 ≤ X) (hH₁ : 1 ≤ H₁) (hH₂ : 1 ≤ H₂)
    (hSD₁ : ∀ s ∈ S₁, |s| ≤ 4 * (D₁ : ℤ)) (hSD₂ : ∀ s ∈ S₂, |s| ≤ 4 * (D₂ : ℤ))
    {δ W₁ W₂ : ℝ} (hδ : 0 < δ)
    (hFPD₁ : L24.FPDProp S₁ T₁ D₁ (δ / 40) 1 W₁)
    (hFPD₂ : L24.FPDProp S₂ T₂ D₂ (δ ^ 3 / 64000) 1 W₂)
    (hTDX₁ : 6400 * (T₁ * D₁) ≤ (δ / 4) ^ 2 * (2 * X))
    (hHW₁ : 16 * H₁ * W₁ ≤ T₁ * D₁) (hHQ₁ : 20 * H₁ ≤ (δ / 4) ^ 2 * (T₁ * D₁))
    (hTDX₂ : 6400 * (T₂ * D₂) ≤ (δ ^ 3 / 6400) ^ 2 * (2 * X))
    (hHW₂ : 16 * H₂ * W₂ ≤ T₂ * D₂)
    (hHQ₂ : 20 * H₂ ≤ (δ ^ 3 / 6400) ^ 2 * (T₂ * D₂))
    (hcorr : δ ≤ dAvg X (fun n => uavg T₁ fun t₁ => uavg T₁ fun t₁' => uavg T₂ fun t₂ =>
      uavg T₂ fun t₂' =>
        (∑ s₁ ∈ S₁, ∑ s₂ ∈ S₂, ψ (n + t₁ * s₁ + t₂ * s₂) * ψ (n + t₁' * s₁ + t₂ * s₂) *
          ψ (n + t₁ * s₁ + t₂' * s₂) * ψ (n + t₁' * s₁ + t₂' * s₂)) / (S₁.card * S₂.card))) :
    (δ ^ 3 / 3200) ^ 3 / 800 ≤
      uavg (2 * X) (fun n => uavg H₁ fun h₁ => uavg H₁ fun h₁' => uavg H₂ fun h₂ =>
        uavg H₂ fun h₂' =>
          ψ (n + h₁ + h₂) * ψ (n + h₁' + h₂) * ψ (n + h₁ + h₂') * ψ (n + h₁' + h₂')) := by
  have e1 : δ ^ 3 / (3200 * (1 : ℝ) ^ 2) / 20 = δ ^ 3 / 64000 := by ring
  have e2 : δ ^ 3 / (3200 * (1 : ℝ) ^ 2) / 2 = δ ^ 3 / 6400 := by ring
  obtain ⟨q₁, q₂, hq₁1, hq₁Q, hq₂1, hq₂Q, hmain⟩ := lemma26 (Q₁ := 1) (Q₂ := 1) hψ hS₁ hS₂ hX
    hH₁ hH₂ hSD₁ hSD₂ hδ hFPD₁ (by rw [e1]; exact hFPD₂) (by linarith) hHW₁ (by linarith)
    (by rw [e2]; linarith) hHW₂ (by rw [e2]; linarith) hcorr
  have h1 : q₁ = 1 := le_antisymm (by exact_mod_cast hq₁Q) hq₁1
  have h2 : q₂ = 1 := le_antisymm (by exact_mod_cast hq₂Q) hq₂1
  subst h1 h2
  have e3 : (δ ^ 3 / (3200 * (1 : ℝ) ^ 2)) ^ 3 / (800 * (1 : ℝ) ^ 2) =
      (δ ^ 3 / 3200) ^ 3 / 800 := by
    ring
  rw [e3] at hmain
  simpa using hmain

end G22.L26

end

/- ## Section: `SmallLemmas` -/

section

/-
# GS Appendix A lemmas and GS Lemma 5.2 (explicit constants)

GS = B. Green and M. Sawhney, arXiv:2511.09365v2.

## Main results (namespace `G22.Small`)

All functions are 1-bounded `ℤ → ℝ`, `N ≥ 2`, and all parameters `q, q', b, H, H' ≥ 1`.

* `lemmaA4` (GS Lemma A.4, dilation):
  `|E^log_{n≤N} F(n) - E^log_{m≤N} q 1_{q∣m} F(m/q)| ≤ (1 + log q)/log N`.
* `lemmaA2res` (GS Lemma A.2, residue classes):
  `|E_{a<q} E^log_{n≤N} f(qn + a) - E^log_{n≤N} f(n)| ≤ 3 (1 + log q)/log N`.
* `lemmaA3` (GS Lemma A.3): for coprime `q, b`,
  `|E^log_{n≤N} E_{h∈[H]} f(qn + bh) - E^log_{n≤N} f(n)| ≤ 5((1 + log q + log bH)/log N + q/H)`.
  Ingredient: `uavg_mod_equidist` (`|E_{h∈[H]} G(bh mod q) - E_{a<q} G(a)| ≤ 2q/H`).
* `lemmaA6` (GS Lemma A.6, squared form): if `q ∣ q'` and `q'H' ≤ qH` then
  `‖f‖²_{U¹_log[N;q,H]} ≤ ‖f‖²_{U¹_log[N;q',H']} + 6((1 + log qH)/log N + q'H'/(qH))`
  (GS's extra condition `qH < N/2` is not needed); `lemmaA6_sqrt` is the unsquared form.
* `lemma52` (GS Lemma 5.2): for the almost primes `p₁⋯p_k` with `p_ℓ` prime in disjoint intervals
  `[lo ℓ, hi ℓ)`, `lo ℓ ≥ 3`, `log log lo ℓ + W ≤ log log (hi ℓ - 1)`, `W > C_M`, and
  `MertensLowerWith C_M`: `γ(𝒫') ≤ exp(k/(W - C_M)) - 1`, where
  `γ(𝒫') = gammaP k S = E^log_{a} E^log_{b} (gcd(∏ a, ∏ b) - 1)` (iterated averages as in
  `Prop51With`). Proof: `gcd(∏a, ∏b) = ∏_ℓ gcd(a_ℓ, b_ℓ)`, so `E gcd ≤ ∏_ℓ (1 + 1/∑_{p∈S_ℓ} 1/p)`
  (`iterAvg_gcd_le`), and Mertens gives `∑_{p∈S_ℓ} 1/p ≥ W - C_M` (`sum_primesIn_ge`).
* `lemma52_prop51`: under the hypotheses of `Prop51With` on the intervals (width `k δ^{-5}`) and
  `δ ≤ 1/2`, `2 C_M δ⁵ ≤ 1`: `γ(𝒫') ≤ 4 δ⁵`.
* `lemma52_indicator`: `E^log_{a,b} 1_{gcd(∏a,∏b) ≠ 1} ≤ γ(𝒫')` (used by GS after (5.24)).
* `lemma55` (the switch (5.5)):
  `E^log_{a,b} E^log_{n≤N} (∏a)(∏b) |1_{∏a ∣ n} 1_{∏b ∣ n} - 1_{(∏a)(∏b) ∣ n}| ≤ 2 γ(𝒫')`
  (GS: `8 γ(𝒫')`); pair version `logAvg_switch_le` (`≤ 2 (gcd(a,b) - 1)`).
-/

open Finset Real

namespace G22.Small

open G22.Elem

/- ### Basic facts about logarithmic averages -/

/-- `E^log_{n∈[N]} g(n) = (∑_{n≤N} g(n)/n) / H_N`. -/
lemma logAvg_eq_sum (N : ℕ) (g : ℤ → ℝ) :
    logAvg N g = (∑ n ∈ Icc 1 N, 1 / (n : ℝ) * g n) / hR N := by
  unfold logAvg wavg
  rw [sum_inv_Icc]

lemma abs_logAvg_le_one {N : ℕ} {g : ℤ → ℝ} (hg : ∀ n, |g n| ≤ 1) : |logAvg N g| ≤ 1 := by
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · simp [logAvg, wavg]
  · exact abs_wavg_le_of_abs_le (goodWeights_logAvg hN) fun n _ => hg n

lemma log_nonneg_of_one_le {x : ℕ} (hx : 1 ≤ x) : 0 ≤ Real.log x :=
  Real.log_nonneg (by exact_mod_cast hx)

/- ### GS Lemma A.4 (dilation) -/

/-- **GS Lemma A.4.** For `q ≥ 1`, `N ≥ 2` and 1-bounded `F`,
`|E^log_{n≤N} F(n) - E^log_{m≤N} q 1_{q∣m} F(m/q)| ≤ (1 + log q)/log N`. -/
theorem lemmaA4 {N q : ℕ} (hN : 2 ≤ N) (hq : 1 ≤ q) (F : ℤ → ℝ) (hF : ∀ n, |F n| ≤ 1) :
    |logAvg N F - logAvg N (fun m => if (q : ℤ) ∣ m then (q : ℝ) * F (m / q) else 0)| ≤
      (1 + Real.log q) / Real.log N := by
  have h := Elliott.dilation hN hq (fun m => F (m / q)) (fun m => hF _)
  have hq0 : (q : ℤ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have e1 : logAvg N F = logAvg N (fun n => F (q * n / q)) := by
    unfold logAvg
    refine wavg_congr fun n _ => ?_
    dsimp only
    rw [Int.mul_ediv_cancel_left _ hq0]
  have e2 : logAvg N (fun m => if (q : ℤ) ∣ m then (q : ℝ) * F (m / q) else 0) =
      wavg (Icc 1 N) (fun n => 1 / (n : ℝ)) (fun m => (q : ℝ) * (Elliott.ind q m * F (m / q))) := by
    unfold logAvg
    refine wavg_congr fun m _ => ?_
    unfold Elliott.ind
    by_cases hd : q ∣ m
    · have : (q : ℤ) ∣ (m : ℤ) := Int.natCast_dvd_natCast.mpr hd
      simp [hd, this]
    · have : ¬ (q : ℤ) ∣ (m : ℤ) := fun h => hd (Int.natCast_dvd_natCast.mp h)
      simp [hd, this]
  rw [e1, e2]
  exact h

/- ### GS Lemma A.2 (residue classes) -/

/-- Harmonic sums over `[j+1, k]`: `∑_{j < m ≤ k} 1/m = H_k - H_j`. -/
lemma sum_Ico_inv (j k : ℕ) (hjk : j ≤ k) :
    ∑ m ∈ Ico (j + 1) (k + 1), 1 / (m : ℝ) = hR k - hR j := by
  have h : ∀ n : ℕ, ∑ m ∈ Ico 1 (n + 1), 1 / ((m : ℕ) : ℝ) = hR n := by
    intro n
    rw [Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel]
    unfold hR
    refine Finset.sum_congr rfl fun i _ => ?_
    push_cast
    ring
  have := Finset.sum_Ico_consecutive (fun m : ℕ => 1 / (m : ℝ)) (show 1 ≤ j + 1 by omega)
    (show j + 1 ≤ k + 1 by omega)
  rw [h j, h k] at this
  linarith

/-- `∑_{n ≤ N} (1/(qn) - 1/(q(n+1))) ≤ 1/q` (telescoping). -/
lemma sum_Icc_telescope (q N : ℕ) :
    ∑ n ∈ Icc 1 N, (1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * (n + 1))) ≤ 1 / q := by
  rw [sum_Icc_one_eq_sum_range]
  have key := Finset.sum_range_sub' (fun i : ℕ => 1 / ((q : ℝ) * ((i : ℝ) + 1))) N
  have e : ∀ i ∈ range N, (1 / ((q : ℝ) * ((i + 1 : ℕ) : ℝ)) -
      1 / ((q : ℝ) * (((i + 1 : ℕ) : ℝ) + 1))) =
      (fun i : ℕ => 1 / ((q : ℝ) * ((i : ℝ) + 1))) i -
        (fun i : ℕ => 1 / ((q : ℝ) * ((i : ℝ) + 1))) (i + 1) := by
    intro i _
    push_cast
    ring
  rw [Finset.sum_congr rfl e, key]
  simp only [Nat.cast_zero, zero_add, mul_one]
  have : 0 ≤ 1 / ((q : ℝ) * ((N : ℝ) + 1)) := by positivity
  linarith

/-- Reindexing: `∑_{a < q} ∑_{n ≤ N} G(qn + a) = ∑_{q ≤ m < q(N+1)} G(m)`. -/
lemma sum_blocks (G : ℕ → ℝ) (q N : ℕ) :
    ∑ a ∈ range q, ∑ n ∈ Icc 1 N, G (q * n + a) = ∑ m ∈ Ico q (q * (N + 1)), G m := by
  rw [Finset.sum_comm]
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih]
    have h1 : ∑ a ∈ range q, G (q * (N + 1) + a) =
        ∑ m ∈ Ico (q * (N + 1)) (q * (N + 1 + 1)), G m := by
      rw [Finset.sum_Ico_eq_sum_range, show q * (N + 1 + 1) = q * (N + 1) + q by ring,
        Nat.add_sub_cancel_left]
    have i1 : q ≤ q * (N + 1) := by
      simpa using Nat.mul_le_mul_left q (show 1 ≤ N + 1 by omega)
    have i2 : q * (N + 1) ≤ q * (N + 1 + 1) := Nat.mul_le_mul_left q (by omega)
    rw [h1, Finset.sum_Ico_consecutive _ i1 i2]

lemma abs_sum_div_le (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (s : Finset ℕ) :
    |∑ m ∈ s, f m / (m : ℝ)| ≤ ∑ m ∈ s, 1 / (m : ℝ) := by
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun m _ => ?_)
  rw [abs_div, Nat.abs_cast]
  exact div_le_div_of_nonneg_right (hf _) (Nat.cast_nonneg m)

/-- **GS Lemma A.2** (residue classes), with the constant `3`:
`|E_{a<q} E^log_{n≤N} f(qn + a) - E^log_{n≤N} f(n)| ≤ 3 (1 + log q)/log N`. -/
theorem lemmaA2res {N q : ℕ} (hN : 2 ≤ N) (hq : 1 ≤ q) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    |(∑ a ∈ range q, logAvg N (fun n => f (q * n + a))) / q - logAvg N f| ≤
      3 * (1 + Real.log q) / Real.log N := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hlogN := log_pos_of_two_le hN
  have hL : Real.log N ≤ hR N := log_le_hR N
  have hLpos : 0 < hR N := lt_of_lt_of_le hlogN hL
  have hlogq : 0 ≤ Real.log q := log_nonneg_of_one_le hq
  -- the four sums
  set M1 : ℝ := ∑ a ∈ range q, ∑ n ∈ Icc 1 N, 1 / ((q : ℝ) * n) * f (q * n + a) with hM1
  set M2 : ℝ := ∑ a ∈ range q, ∑ n ∈ Icc 1 N, f ((q * n + a : ℕ) : ℤ) / ((q * n + a : ℕ) : ℝ)
    with hM2
  set M3 : ℝ := ∑ m ∈ Ico q (q * (N + 1)), f m / (m : ℝ) with hM3
  set M4 : ℝ := ∑ m ∈ Ico 1 (N + 1), f m / (m : ℝ) with hM4
  have eL : (∑ a ∈ range q, logAvg N (fun n => f (q * n + a))) / q = M1 / hR N := by
    simp only [logAvg_eq_sum]
    rw [← Finset.sum_div, div_right_comm]
    congr 1
    rw [hM1, Finset.sum_div]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun n hn => ?_
    have : (0 : ℝ) < n := by exact_mod_cast (Finset.mem_Icc.mp hn).1
    field_simp
  have eR : logAvg N f = M4 / hR N := by
    rw [logAvg_eq_sum, hM4, Finset.Ico_add_one_right_eq_Icc]
    congr 1
    refine Finset.sum_congr rfl fun n _ => ?_
    ring
  -- `M1 ≈ M2`: replacing `1/(qn)` by `1/(qn + a)`
  have h12 : |M1 - M2| ≤ 1 := by
    have e : M1 - M2 = ∑ a ∈ range q, ∑ n ∈ Icc 1 N,
        (1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * n + a)) * f (q * n + a) := by
      rw [hM1, hM2, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun n _ => ?_
      push_cast
      ring
    rw [e]
    calc |∑ a ∈ range q, ∑ n ∈ Icc 1 N,
          (1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * n + a)) * f (q * n + a)|
        ≤ ∑ a ∈ range q, ∑ n ∈ Icc 1 N, (1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * (n + 1))) := by
          refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun a ha => ?_)
          refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun n hn => ?_)
          have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast (Finset.mem_Icc.mp hn).1
          have haq : (a : ℝ) ≤ q := by
            have := Finset.mem_range.mp ha
            exact_mod_cast this.le
          have hqn : 0 < (q : ℝ) * n := by positivity
          have hw0 : 0 ≤ 1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * n + a) := by
            rw [sub_nonneg]
            exact one_div_le_one_div_of_le hqn (by linarith [(Nat.cast_nonneg a : (0 : ℝ) ≤ a)])
          have hw1 : 1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * n + a) ≤
              1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * (n + 1)) := by
            have : 1 / ((q : ℝ) * (n + 1)) ≤ 1 / ((q : ℝ) * n + a) :=
              one_div_le_one_div_of_le (by positivity) (by nlinarith)
            linarith
          rw [abs_mul, abs_of_nonneg hw0]
          calc (1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * n + a)) * |f (q * n + a)|
              ≤ (1 / ((q : ℝ) * n) - 1 / ((q : ℝ) * n + a)) * 1 :=
                mul_le_mul_of_nonneg_left (hf _) hw0
            _ ≤ _ := by rw [mul_one]; exact hw1
      _ ≤ ∑ a ∈ range q, 1 / (q : ℝ) := Finset.sum_le_sum fun a _ => sum_Icc_telescope q N
      _ = 1 := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          field_simp
  -- `M2 = M3`: reindexing
  have h23 : M2 = M3 := by
    rw [hM2, hM3]
    exact sum_blocks (fun m => f m / (m : ℝ)) q N
  -- `M3 ≈ M4`: the two ranges differ by `[1, q)` and `[N+1, q(N+1))`
  have hqN : N + 1 ≤ q * (N + 1) := by simpa using Nat.mul_le_mul_right (N + 1) hq
  have h34 : |M3 - M4| ≤ 2 * (1 + Real.log q) := by
    have s1 := Finset.sum_Ico_consecutive (fun m : ℕ => f m / (m : ℝ)) hq
      (show q ≤ q * (N + 1) by simpa using Nat.mul_le_mul_left q (show 1 ≤ N + 1 by omega))
    have s2 := Finset.sum_Ico_consecutive (fun m : ℕ => f m / (m : ℝ)) (show 1 ≤ N + 1 by omega)
      hqN
    have e : M3 - M4 = ∑ m ∈ Ico (N + 1) (q * (N + 1)), f m / (m : ℝ) -
        ∑ m ∈ Ico 1 q, f m / (m : ℝ) := by
      rw [hM3, hM4]
      linarith
    rw [e]
    have b1 : |∑ m ∈ Ico 1 q, f m / (m : ℝ)| ≤ 1 + Real.log q := by
      refine (abs_sum_div_le f hf _).trans ?_
      have := sum_Ico_inv 0 (q - 1) (by omega)
      rw [Nat.sub_add_cancel hq, zero_add] at this
      have h0 : hR 0 = 0 := by simp [hR]
      rw [this, h0, sub_zero]
      exact (hR_mono (Nat.sub_le q 1)).trans (hR_le q)
    have b2 : |∑ m ∈ Ico (N + 1) (q * (N + 1)), f m / (m : ℝ)| ≤ 1 + Real.log q := by
      refine (abs_sum_div_le f hf _).trans ?_
      have h3 : 3 ≤ q * (N + 1) := by nlinarith
      have := sum_Ico_inv N (q * (N + 1) - 1) (by omega)
      rw [Nat.sub_add_cancel (by omega)] at this
      rw [this]
      have i1 := hR_le (q * (N + 1) - 1)
      have i2 : Real.log ((N + 1 : ℕ) : ℝ) ≤ hR N := by
        rw [hR_eq_harmonic]; exact log_add_one_le_harmonic N
      have i3 : Real.log ((q * (N + 1) - 1 : ℕ) : ℝ) ≤ Real.log q + Real.log ((N + 1 : ℕ) : ℝ) := by
        rw [← Real.log_mul (by positivity) (by positivity)]
        have hpos : (0 : ℝ) < ((q * (N + 1) - 1 : ℕ) : ℝ) := by
          have : 0 < q * (N + 1) - 1 := by omega
          exact_mod_cast this
        apply Real.log_le_log hpos
        have : ((q * (N + 1) - 1 : ℕ) : ℝ) ≤ ((q * (N + 1) : ℕ) : ℝ) :=
          Nat.cast_le.mpr (Nat.sub_le _ _)
        push_cast at this ⊢
        exact this
      linarith
    calc |∑ m ∈ Ico (N + 1) (q * (N + 1)), f m / (m : ℝ) - ∑ m ∈ Ico 1 q, f m / (m : ℝ)|
        ≤ |∑ m ∈ Ico (N + 1) (q * (N + 1)), f m / (m : ℝ)| + |∑ m ∈ Ico 1 q, f m / (m : ℝ)| :=
          abs_sub _ _
      _ ≤ 2 * (1 + Real.log q) := by linarith
  -- combine
  rw [eL, eR, ← sub_div, abs_div, abs_of_pos hLpos]
  have hnum : |M1 - M4| ≤ 3 * (1 + Real.log q) := by
    have : |M1 - M4| ≤ |M1 - M2| + |M3 - M4| := by
      rw [← h23]
      calc |M1 - M4| = |(M1 - M2) + (M2 - M4)| := by ring_nf
        _ ≤ |M1 - M2| + |M2 - M4| := abs_add_le _ _
    linarith
  calc |M1 - M4| / hR N ≤ 3 * (1 + Real.log q) / hR N :=
        div_le_div_of_nonneg_right hnum hLpos.le
    _ ≤ 3 * (1 + Real.log q) / Real.log N :=
        div_le_div_of_nonneg_left (by positivity) hlogN hL

/- ### GS Lemma A.3 -/

/-- A full period: for `gcd(b, q) = 1`, `i ↦ b(c + i) mod q` permutes `[0, q)`. -/
lemma sum_range_mod_perm {q b : ℕ} (hq : 1 ≤ q) (hcop : Nat.Coprime b q) (G : ℕ → ℝ) (c : ℕ) :
    ∑ i ∈ range q, G ((b * (c + i)) % q) = ∑ a ∈ range q, G a := by
  have : NeZero q := ⟨by omega⟩
  have hsum : ∀ F : ZMod q → ℝ, ∑ z, F z = ∑ j ∈ range q, F (j : ZMod q) := fun F =>
    Finset.sum_nbij' (fun z => z.val) (fun j => (j : ZMod q))
      (fun z _ => Finset.mem_range.mpr (ZMod.val_lt z)) (fun j _ => Finset.mem_univ _)
      (fun z _ => ZMod.natCast_zmod_val z)
      (fun j hj => ZMod.val_natCast_of_lt (Finset.mem_range.mp hj))
      (fun z _ => by rw [ZMod.natCast_zmod_val])
  have e1 : ∑ i ∈ range q, G ((b * (c + i)) % q) = ∑ i ∈ range q,
      (fun z : ZMod q => G (((b : ZMod q) * ((c : ZMod q) + z)).val)) (i : ZMod q) := by
    refine Finset.sum_congr rfl fun i _ => ?_
    dsimp only
    rw [← Nat.cast_add, ← Nat.cast_mul, ZMod.val_natCast]
  have e2 : ∑ a ∈ range q, G a = ∑ j ∈ range q, (fun z : ZMod q => G z.val) (j : ZMod q) := by
    refine Finset.sum_congr rfl fun j hj => ?_
    dsimp only
    rw [ZMod.val_natCast_of_lt (Finset.mem_range.mp hj)]
  rw [e1, e2, ← hsum (fun z : ZMod q => G (((b : ZMod q) * ((c : ZMod q) + z)).val)),
    ← hsum (fun z : ZMod q => G z.val)]
  have hu : IsUnit (b : ZMod q) := by
    rw [← ZMod.coe_unitOfCoprime b hcop]
    exact Units.isUnit _
  have hinj : Function.Injective (fun z : ZMod q => (b : ZMod q) * ((c : ZMod q) + z)) := by
    intro x y hxy
    exact add_left_cancel (hu.mul_left_cancel hxy)
  exact Fintype.sum_bijective _ (Finite.injective_iff_bijective.mp hinj) _ _ fun z => rfl

/-- `∑_{i < qK} G(b(i+1) mod q) = K ∑_{a<q} G(a)` for `gcd(b, q) = 1`. -/
lemma sum_range_mul_mod {q b : ℕ} (hq : 1 ≤ q) (hcop : Nat.Coprime b q) (G : ℕ → ℝ) (K : ℕ) :
    ∑ i ∈ range (q * K), G ((b * (i + 1)) % q) = K * ∑ a ∈ range q, G a := by
  induction K with
  | zero => simp
  | succ K ih =>
    rw [show q * (K + 1) = q * K + q by ring, Finset.sum_range_add, ih]
    have : ∑ i ∈ range q, G ((b * (q * K + i + 1)) % q) = ∑ a ∈ range q, G a := by
      rw [← sum_range_mod_perm hq hcop G (q * K + 1)]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [show q * K + i + 1 = q * K + 1 + i by ring]
    rw [this]
    push_cast
    ring

/-- Equidistribution of `bh mod q`, `h ∈ [H]`, for `gcd(b, q) = 1`:
`|E_{h∈[H]} G(bh mod q) - E_{a<q} G(a)| ≤ 2q/H` for 1-bounded `G`. -/
lemma uavg_mod_equidist {q b H : ℕ} (hq : 1 ≤ q) (hH : 1 ≤ H) (hcop : Nat.Coprime b q)
    (G : ℕ → ℝ) (hG : ∀ a, |G a| ≤ 1) :
    |uavg H (fun h => G ((b * h) % q)) - (∑ a ∈ range q, G a) / q| ≤ 2 * q / H := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hHR : (0 : ℝ) < H := by exact_mod_cast hH
  set A : ℝ := ∑ a ∈ range q, G a with hA
  have hAq : |A| ≤ q := by
    have := abs_sum_le_card (range q) G (fun a _ => hG a)
    rwa [Finset.card_range] at this
  obtain ⟨K, r, hr, hH'⟩ : ∃ K r : ℕ, r < q ∧ H = q * K + r :=
    ⟨H / q, H % q, Nat.mod_lt H (by omega), (Nat.div_add_mod H q).symm⟩
  set R : ℝ := ∑ i ∈ range r, G ((b * (q * K + i + 1)) % q) with hR'
  have hRr : |R| ≤ r := by
    have := abs_sum_le_card (range r) (fun i => G ((b * (q * K + i + 1)) % q)) (fun i _ => hG _)
    rwa [Finset.card_range] at this
  have hsum : uavg H (fun h => G ((b * h) % q)) = (K * A + R) / H := by
    rw [uavg_eq_range]
    congr 1
    rw [hH', Finset.sum_range_add, sum_range_mul_mod hq hcop G K]
  have hHK : (H : ℝ) = q * K + r := by exact_mod_cast hH'
  have e : (K * A + R) / H - A / q = R / H - (r / H) * (A / q) := by
    field_simp
    rw [hHK]
    ring
  rw [hsum, e]
  have hr' : (r : ℝ) ≤ q := by exact_mod_cast hr.le
  have h1 : |R / H| ≤ r / H := by
    rw [abs_div, abs_of_pos hHR]
    exact div_le_div_of_nonneg_right hRr hHR.le
  have h2 : |(r / H) * (A / q)| ≤ r / H := by
    rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ r / H)]
    have : |A / q| ≤ 1 := by
      rw [abs_div, abs_of_pos hqR, div_le_one hqR]
      exact hAq
    calc r / H * |A / q| ≤ r / H * 1 := mul_le_mul_of_nonneg_left this (by positivity)
      _ = r / H := mul_one _
  calc |R / H - r / H * (A / q)| ≤ |R / H| + |(r / H) * (A / q)| := abs_sub _ _
    _ ≤ r / H + r / H := add_le_add h1 h2
    _ ≤ 2 * q / H := by
        rw [← add_div, ← two_mul]
        exact div_le_div_of_nonneg_right (by linarith) hHR.le

/-- The residue-class averages `Ψ(c) = E^log_{n≤N} f(qn + c)`. -/
noncomputable def resAvg (N q : ℕ) (f : ℤ → ℝ) (c : ℕ) : ℝ := logAvg N (fun n => f (q * n + c))

/-- `Ψ(c) ≈ Ψ(c mod q)` (GS (A.2) for the shift by `⌊c/q⌋`). -/
lemma resAvg_mod {N q : ℕ} (hN : 2 ≤ N) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) (c K : ℕ)
    (hcK : c ≤ K) :
    |resAvg N q f c - resAvg N q f (c % q)| ≤ 2 * (1 + Real.log K) / Real.log N := by
  have hshift := logAvg_shift_le' N hN (fun m => f (q * m + ((c % q : ℕ) : ℤ))) (fun m => hf _)
    ((c / q : ℕ) : ℤ) K (by rw [Int.natAbs_natCast]; exact (Nat.div_le_self _ _).trans hcK)
  have e : resAvg N q f c =
      logAvg N (fun n => f (q * (n + ((c / q : ℕ) : ℤ)) + ((c % q : ℕ) : ℤ))) := by
    unfold resAvg logAvg
    refine wavg_congr fun n _ => ?_
    dsimp only
    have hc : (c : ℤ) = (q : ℤ) * ((c / q : ℕ) : ℤ) + ((c % q : ℕ) : ℤ) := by
      exact_mod_cast (Nat.div_add_mod c q).symm
    rw [hc]
    ring_nf
  rw [e]
  exact hshift

/-- **GS Lemma A.3**, with the constant `5`: for coprime `q, b ≥ 1`, `H ≥ 1`, `N ≥ 2` and
1-bounded `f`,
`|E^log_{n≤N} E_{h∈[H]} f(qn + bh) - E^log_{n≤N} f(n)| ≤ 5((1 + log q + log bH)/log N + q/H)`. -/
theorem lemmaA3 {N q b H : ℕ} (hN : 2 ≤ N) (hq : 1 ≤ q) (hb : 1 ≤ b) (hH : 1 ≤ H)
    (hcop : Nat.Coprime q b) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    |logAvg N (fun n => uavg H (fun h => f (q * n + b * h))) - logAvg N f| ≤
      5 * ((1 + Real.log q + Real.log (b * H)) / Real.log N + q / H) := by
  have hlogN := log_pos_of_two_le hN
  have hlogq : 0 ≤ Real.log q := log_nonneg_of_one_le hq
  have hbH : 1 ≤ b * H := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
  have hlogbH : 0 ≤ Real.log ((b : ℝ) * H) := by
    have := log_nonneg_of_one_le hbH
    push_cast at this
    exact this
  have hHR : (0 : ℝ) < H := by exact_mod_cast hH
  have hΨ1 : ∀ c, |resAvg N q f c| ≤ 1 := fun c => abs_logAvg_le_one fun n => hf _
  -- Fubini
  have e0 : logAvg N (fun n => uavg H (fun h => f (q * n + b * h))) =
      uavg H (fun h => resAvg N q f (b * h)) := by
    rw [logAvg_uavg_comm]
    refine wavg_congr fun h _ => ?_
    unfold resAvg
    push_cast
    rfl
  -- step 1: reduce `bh` mod `q`
  have h1 : |uavg H (fun h => resAvg N q f (b * h)) -
      uavg H (fun h => resAvg N q f ((b * h) % q))| ≤
      2 * (1 + Real.log ((b : ℝ) * H)) / Real.log N := by
    have key : |wavg (Icc 1 H) (fun _ => (1 : ℝ))
        (fun h => resAvg N q f (b * h) - resAvg N q f ((b * h) % q))| ≤
        2 * (1 + Real.log ((b : ℝ) * H)) / Real.log N := by
      refine abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun h hh => ?_
      have hhH : h ≤ H := (Finset.mem_Icc.mp hh).2
      have := resAvg_mod (q := q) hN f hf (b * h) (b * H) (Nat.mul_le_mul_left b hhH)
      push_cast at this
      exact this
    rw [wavg_sub] at key
    exact key
  -- step 2: equidistribution of `bh mod q`
  have h2 := uavg_mod_equidist hq hH hcop.symm (fun a => resAvg N q f a) hΨ1
  -- step 3: Lemma A.2 (residue classes)
  have h3 := lemmaA2res hN hq f hf
  have e3 : (∑ a ∈ range q, logAvg N (fun n => f (q * n + a))) / q =
      (∑ a ∈ range q, resAvg N q f a) / q := rfl
  rw [e3] at h3
  rw [e0]
  have htri : |uavg H (fun h => resAvg N q f (b * h)) - logAvg N f| ≤
      2 * (1 + Real.log ((b : ℝ) * H)) / Real.log N + 2 * q / H +
        3 * (1 + Real.log q) / Real.log N := by
    calc |uavg H (fun h => resAvg N q f (b * h)) - logAvg N f|
        = |(uavg H (fun h => resAvg N q f (b * h)) -
              uavg H (fun h => resAvg N q f ((b * h) % q))) +
            (uavg H (fun h => resAvg N q f ((b * h) % q)) -
              (∑ a ∈ range q, resAvg N q f a) / q) +
            ((∑ a ∈ range q, resAvg N q f a) / q - logAvg N f)| := by ring_nf
      _ ≤ |uavg H (fun h => resAvg N q f (b * h)) -
              uavg H (fun h => resAvg N q f ((b * h) % q))| +
            |uavg H (fun h => resAvg N q f ((b * h) % q)) -
              (∑ a ∈ range q, resAvg N q f a) / q| +
            |(∑ a ∈ range q, resAvg N q f a) / q - logAvg N f| := abs_add_three _ _ _
      _ ≤ _ := add_le_add (add_le_add h1 h2) h3
  have hlogs : 2 * (1 + Real.log ((b : ℝ) * H)) / Real.log N + 3 * (1 + Real.log q) / Real.log N ≤
      5 * ((1 + Real.log q + Real.log ((b : ℝ) * H)) / Real.log N) := by
    rw [← add_div, mul_div_assoc', div_le_div_iff_of_pos_right hlogN]
    nlinarith
  have hqH : 2 * (q : ℝ) / H ≤ 5 * (q / H) := by
    rw [mul_div_assoc]
    have : 0 ≤ (q : ℝ) / H := by positivity
    linarith
  linarith

/- ### GS Lemma A.6 -/

/-- Reflection `h ↦ H' + 1 - h` inside a uniform average. -/
lemma uavg_reflect (H' q' : ℕ) (f : ℤ → ℝ) (n : ℤ) :
    uavg H' (fun h' => f (n + q' * ((H' : ℤ) + 1) - q' * h')) =
      uavg H' (fun h => f (n + q' * h)) := by
  rw [uavg_eq_range, uavg_eq_range]
  congr 1
  refine Eq.trans ?_ (Finset.sum_range_reflect (fun i => f (n + (q' : ℤ) * ((i + 1 : ℕ) : ℤ))) H')
  refine Finset.sum_congr rfl fun j hj => ?_
  have hj' : j < H' := Finset.mem_range.mp hj
  have e : H' - 1 - j + 1 = H' - j := by omega
  rw [e, Nat.cast_sub hj'.le]
  congr 1
  push_cast
  ring

/-- **GS Lemma A.6** (squared form), with the constant `6`: if `q ∣ q'`, `q, q', H, H' ≥ 1` and
`q'H' ≤ qH`, then for `N ≥ 2` and 1-bounded `f`,
`‖f‖²_{U¹_log[N;q,H]} ≤ ‖f‖²_{U¹_log[N;q',H']} + 6((1 + log qH)/log N + q'H'/(qH))`.
(GS's condition `qH < N/2` is not needed.) -/
theorem lemmaA6 {N q q' H H' : ℕ} (hN : 2 ≤ N) (hq : 1 ≤ q) (hqq' : q ∣ q') (hq' : 1 ≤ q')
    (hH : 1 ≤ H) (hH' : 1 ≤ H') (hqH : q' * H' ≤ q * H) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    U1logSq N q H f ≤
      U1logSq N q' H' f + 6 * ((1 + Real.log (q * H)) / Real.log N + (q' * H' : ℝ) / (q * H)) := by
  have hlogN := log_pos_of_two_le hN
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hHR : (0 : ℝ) < H := by exact_mod_cast hH
  have hqH1 : 1 ≤ q * H := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
  have hlogqH : 0 ≤ Real.log ((q : ℝ) * H) := by
    have := log_nonneg_of_one_le hqH1
    push_cast at this
    exact this
  have hN1 : 1 ≤ N := by omega
  -- `G(m) = (E_{h'∈[H']} f(m - q'h'))²`
  set G : ℤ → ℝ := fun m => (uavg H' (fun h' => f (m - q' * h'))) ^ 2 with hG
  have hG0 : ∀ m, 0 ≤ G m := fun m => sq_nonneg _
  have hG1 : ∀ m, |G m| ≤ 1 := by
    intro m
    rw [abs_of_nonneg (hG0 m)]
    exact (sq_le_one_iff_abs_le_one _).mpr
      (abs_wavg_le_of_abs_le (goodWeights_uavg hH') fun _ _ => hf _)
  set ε : ℝ := 2 * ((q' : ℝ) / q) * H' / H with hε
  -- pointwise: `(E_h f(n + qh))² ≤ E_h G(n + qh) + 2ε`
  have hpt : ∀ n : ℤ, (uavg H (fun h => f (n + q * h))) ^ 2 ≤
      uavg H (fun h => G (n + q * h)) + 2 * ε := by
    intro n
    have h1 := uavg_uavg_dvd_le (H := H) hqq' hq hH' f hf n
    have ha : |uavg H (fun h => f (n + q * h))| ≤ 1 :=
      abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun _ _ => hf _
    have hb : |uavg H (fun h => uavg H' (fun h' => f (n + q * h - q' * h')))| ≤ 1 :=
      abs_wavg_le_of_abs_le (goodWeights_uavg hH) fun _ _ =>
        abs_wavg_le_of_abs_le (goodWeights_uavg hH') fun _ _ => hf _
    have h2 := sq_sub_sq_le (d := ε) ha hb (by rw [abs_sub_comm]; exact h1)
    have h3 := wavg_sq_le (goodWeights_uavg hH)
      (fun h => uavg H' (fun h' => f (n + q * h - q' * h')))
    have e : uavg H (fun h => G (n + q * h)) =
        wavg (Icc 1 H) (fun _ => 1) (fun h => (uavg H' (fun h' => f (n + q * h - q' * h'))) ^ 2) :=
      rfl
    rw [e]
    have e2 : uavg H (fun h => uavg H' (fun h' => f (n + q * h - q' * h'))) =
        wavg (Icc 1 H) (fun _ => 1) (fun h => uavg H' (fun h' => f (n + q * h - q' * h'))) := rfl
    rw [e2] at h2
    linarith
  -- average over `n`
  have hstep1 : U1logSq N q H f ≤ logAvg N (fun n => uavg H (fun h => G (n + q * h))) + 2 * ε := by
    unfold U1logSq
    have := wavg_mono (goodWeights_logAvg hN1)
      (f := fun n : ℕ => (uavg H (fun h => f (n + q * h))) ^ 2)
      (g := fun n : ℕ => uavg H (fun h => G (n + q * h)) + 2 * ε) (fun n _ => hpt n)
    rw [wavg_add, wavg_const (goodWeights_logAvg hN1)] at this
    exact this
  -- remove the shift `qh` (GS (A.2))
  have hstep2 : logAvg N (fun n => uavg H (fun h => G (n + q * h))) ≤
      logAvg N G + 2 * (1 + Real.log ((q : ℝ) * H)) / Real.log N := by
    have hsh := logAvg_uavg_shift N hN hH (fun _ m => G m) (fun _ m => hG1 m) (q : ℤ) (q * H)
      (by rw [Int.natAbs_natCast])
    have e : logAvg N (fun n => uavg H (fun _ => G n)) = logAvg N G := by
      unfold logAvg
      exact wavg_congr fun n _ => wavg_const (goodWeights_uavg hH) _
    rw [e] at hsh
    have hle := eA_le hN (q * H)
    push_cast at hle
    have := (abs_le.mp hsh).2
    linarith
  -- shift by `q'(H' + 1)` and reflect
  have hstep3 : logAvg N G ≤ U1logSq N q' H' f + 2 * (1 + Real.log ((q : ℝ) * H)) / Real.log N +
      2 * (1 / Real.log N) := by
    have hsh := logAvg_shift_le' N hN G hG1 ((q' : ℤ) * ((H' : ℤ) + 1)) (q' * (H' + 1))
      (by rw [Int.natAbs_mul, Int.natAbs_natCast]; rfl)
    have e : logAvg N (fun n => G (n + (q' : ℤ) * ((H' : ℤ) + 1))) = U1logSq N q' H' f := by
      unfold U1logSq logAvg
      refine wavg_congr fun n _ => ?_
      simp only [hG]
      rw [← uavg_reflect H' q' f n]
    rw [e] at hsh
    -- `log(q'(H'+1)) ≤ log 2 + log(qH) ≤ 1 + log(qH)`
    have hlog : Real.log (((q' * (H' + 1) : ℕ) : ℝ)) ≤ 1 + Real.log ((q : ℝ) * H) := by
      have h2 : ((q' * (H' + 1) : ℕ) : ℝ) ≤ 2 * ((q : ℝ) * H) := by
        have : q' * (H' + 1) ≤ 2 * (q * H) := by nlinarith
        exact_mod_cast this
      have hpos : (0 : ℝ) < ((q' * (H' + 1) : ℕ) : ℝ) := by
        have : 0 < q' * (H' + 1) := Nat.mul_pos (by omega) (by omega)
        exact_mod_cast this
      calc Real.log (((q' * (H' + 1) : ℕ) : ℝ)) ≤ Real.log (2 * ((q : ℝ) * H)) :=
            Real.log_le_log hpos h2
        _ = Real.log 2 + Real.log ((q : ℝ) * H) := Real.log_mul (by norm_num) (by positivity)
        _ ≤ 1 + Real.log ((q : ℝ) * H) := by
            have := Real.log_two_lt_d9
            linarith
    have hb : 2 * (1 + Real.log (((q' * (H' + 1) : ℕ) : ℝ))) / Real.log N ≤
        2 * (1 + Real.log ((q : ℝ) * H)) / Real.log N + 2 * (1 / Real.log N) := by
      rw [mul_one_div, ← add_div]
      exact div_le_div_of_nonneg_right (by linarith) hlogN.le
    have := (abs_le.mp hsh).1
    linarith
  -- combine
  have hε' : 2 * ε = 4 * ((q' * H' : ℝ) / (q * H)) := by
    rw [hε]
    field_simp
    ring
  have hfin : 2 * (1 + Real.log ((q : ℝ) * H)) / Real.log N +
      (2 * (1 + Real.log ((q : ℝ) * H)) / Real.log N + 2 * (1 / Real.log N)) ≤
      6 * ((1 + Real.log ((q : ℝ) * H)) / Real.log N) := by
    rw [mul_one_div, ← add_div, ← add_div, mul_div_assoc',
      div_le_div_iff_of_pos_right hlogN]
    nlinarith
  have hq'H' : 0 ≤ (q' * H' : ℝ) / (q * H) := by positivity
  linarith

lemma sqrt_add_le_add_sqrt {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    Real.sqrt (x + y) ≤ Real.sqrt x + Real.sqrt y := by
  have h1 := Real.sq_sqrt hx
  have h2 := Real.sq_sqrt hy
  have h3 := Real.sqrt_nonneg x
  have h4 := Real.sqrt_nonneg y
  have key : x + y ≤ (Real.sqrt x + Real.sqrt y) ^ 2 := by nlinarith
  calc Real.sqrt (x + y) ≤ Real.sqrt ((Real.sqrt x + Real.sqrt y) ^ 2) := Real.sqrt_le_sqrt key
    _ = Real.sqrt x + Real.sqrt y := Real.sqrt_sq (by positivity)

/-- **GS Lemma A.6** in GS's (unsquared) form:
`‖f‖_{U¹_log[N;q,H]} ≤ ‖f‖_{U¹_log[N;q',H']} + (6((1 + log qH)/log N + q'H'/(qH)))^{1/2}`. -/
theorem lemmaA6_sqrt {N q q' H H' : ℕ} (hN : 2 ≤ N) (hq : 1 ≤ q) (hqq' : q ∣ q') (hq' : 1 ≤ q')
    (hH : 1 ≤ H) (hH' : 1 ≤ H') (hqH : q' * H' ≤ q * H) (f : ℤ → ℝ) (hf : ∀ n, |f n| ≤ 1) :
    Real.sqrt (U1logSq N q H f) ≤ Real.sqrt (U1logSq N q' H' f) +
      Real.sqrt (6 * ((1 + Real.log (q * H)) / Real.log N + (q' * H' : ℝ) / (q * H))) := by
  have h := lemmaA6 hN hq hqq' hq' hH hH' hqH f hf
  have hU : 0 ≤ U1logSq N q' H' f :=
    wavg_nonneg (goodWeights_logAvg (by omega)) fun _ _ => sq_nonneg _
  have hlogN := log_pos_of_two_le hN
  have hlogqH : 0 ≤ Real.log ((q : ℝ) * H) := by
    have := log_nonneg_of_one_le
      (Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega : q ≠ 0) (by omega : H ≠ 0)))
    push_cast at this
    exact this
  have hE : 0 ≤ 6 * ((1 + Real.log (q * H)) / Real.log N + (q' * H' : ℝ) / (q * H)) := by
    positivity
  exact (Real.sqrt_le_sqrt h).trans (sqrt_add_le_add_sqrt hU hE)

/- ### GS Lemma 5.2 (the almost primes are mostly coprime) -/

/-- GS's `γ(𝒫') = E^log_{n,n'∈𝒫'} (gcd(n, n') - 1)` for the almost primes `𝒫' = {p₁⋯p_k}`,
`p_ℓ ∈ S ℓ`, written (as in `Prop51With`) with iterated averages over the factors. -/
noncomputable def gammaP (k : ℕ) (S : Fin k → Finset ℕ) : ℝ :=
  iterAvg k S (fun a => iterAvg k S (fun b => (Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) : ℝ) - 1))

/-- Monotonicity of iterated averages, only on tuples from the sets. -/
lemma iterAvg_mono' {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S) {F G : (Fin k → ℕ) → ℝ}
    (hFG : ∀ p : Fin k → ℕ, (∀ i, p i ∈ S i) → F p ≤ G p) : iterAvg k S F ≤ iterAvg k S G := by
  induction k with
  | zero => exact hFG _ (fun i => i.elim0)
  | succ k ih =>
    exact wavg_mono (goodWeights_lavg (hS 0).1 (hS 0).2) fun p hp =>
      ih hS.tail fun r hr => hFG _ fun i => by
        obtain rfl | ⟨j, rfl⟩ := Fin.eq_zero_or_eq_succ i
        · simpa using hp
        · simpa using hr j

lemma iterAvg_congr' {k : ℕ} {S : Fin k → Finset ℕ} (hS : GoodSets S) {F G : (Fin k → ℕ) → ℝ}
    (hFG : ∀ p : Fin k → ℕ, (∀ i, p i ∈ S i) → F p = G p) : iterAvg k S F = iterAvg k S G :=
  le_antisymm (iterAvg_mono' hS fun p hp => (hFG p hp).le)
    (iterAvg_mono' hS fun p hp => (hFG p hp).ge)

/-- `gcd(pA, p'B) = gcd(p, p') gcd(A, B)` for primes `p, p'` with `p ∤ B`, `p' ∤ A`. -/
lemma gcd_mul_mul_of_coprime {p p' A B : ℕ} (hp : p.Prime) (hp' : p'.Prime)
    (hpB : Nat.Coprime p B) (hp'A : Nat.Coprime p' A) :
    Nat.gcd (p * A) (p' * B) = Nat.gcd p p' * Nat.gcd A B := by
  by_cases h : p = p'
  · subst h
    rw [Nat.gcd_mul_left, Nat.gcd_self]
  · have hpp' : Nat.Coprime p p' := (Nat.coprime_primes hp hp').mpr h
    rw [hpp'.gcd_eq_one, one_mul,
      Nat.Coprime.gcd_mul_left_cancel A (Nat.Coprime.mul_right hpp' hpB)]
    exact Nat.Coprime.gcd_mul_left_cancel_right B hp'A

/-- One factor: `E^log_{p,p'∈S} gcd(p, p') ≤ 1 + (∑_{p∈S} 1/p)⁻¹` for a set of primes. -/
lemma lavg_gcd_le {S : Finset ℕ} (hS : S.Nonempty) (hprime : ∀ p ∈ S, p.Prime) :
    lavg S (fun p => lavg S (fun p' => (Nat.gcd p p' : ℝ))) ≤ 1 + 1 / ∑ p ∈ S, (1 : ℝ) / p := by
  have h0 : ∀ p ∈ S, 0 < p := fun p hp => (hprime p hp).pos
  have hw := goodWeights_lavg hS h0
  have hmpos : 0 < ∑ p ∈ S, (1 : ℝ) / p := hw.sum_pos
  have hpt : ∀ p ∈ S, lavg S (fun p' => (Nat.gcd p p' : ℝ)) ≤ 1 + 1 / ∑ p ∈ S, (1 : ℝ) / p := by
    intro p hp
    have hpR : (0 : ℝ) < p := by exact_mod_cast h0 p hp
    have h1 : ∀ p' ∈ S, (Nat.gcd p p' : ℝ) ≤ 1 + (p : ℝ) * (if p' = p then 1 else 0) := by
      intro p' hp'
      by_cases h : p' = p
      · subst h
        simp
      · have : Nat.gcd p p' = 1 :=
          (Nat.coprime_primes (hprime p hp) (hprime p' hp')).mpr (Ne.symm h)
        simp [this, h]
    have e : lavg S (fun p' => (if p' = p then (1 : ℝ) else 0)) =
        1 / p / ∑ p ∈ S, (1 : ℝ) / p := by
      unfold lavg wavg
      congr 1
      simp only [mul_ite, mul_one, mul_zero]
      rw [Finset.sum_ite_eq' S p (fun p' => 1 / (p' : ℝ)), if_pos hp]
    calc lavg S (fun p' => (Nat.gcd p p' : ℝ))
        ≤ lavg S (fun p' => 1 + (p : ℝ) * (if p' = p then 1 else 0)) := wavg_mono hw h1
      _ = 1 + (p : ℝ) * lavg S (fun p' => (if p' = p then (1 : ℝ) else 0)) := by
          unfold lavg
          rw [wavg_add, wavg_const hw, wavg_smul]
      _ = 1 + 1 / ∑ p ∈ S, (1 : ℝ) / p := by
          rw [e]
          field_simp
  calc lavg S (fun p => lavg S (fun p' => (Nat.gcd p p' : ℝ)))
      ≤ lavg S (fun _ => 1 + 1 / ∑ p ∈ S, (1 : ℝ) / p) := wavg_mono hw hpt
    _ = 1 + 1 / ∑ p ∈ S, (1 : ℝ) / p := wavg_const hw _

/-- Fubini between an iterated average and a weighted average. -/
lemma iterAvg_wavg_comm {β : Type*} {k : ℕ} (S : Fin k → Finset ℕ) (t : Finset β) (v : β → ℝ)
    (F : (Fin k → ℕ) → β → ℝ) :
    iterAvg k S (fun a => wavg t v (fun y => F a y)) =
      wavg t v (fun y => iterAvg k S (fun a => F a y)) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [iterAvg, lavg]
    rw [show (fun p => iterAvg k (fun i => S i.succ)
        (fun q => wavg t v (fun y => F (Fin.cons p q) y))) =
        fun p => wavg t v (fun y => iterAvg k (fun i => S i.succ) (fun q => F (Fin.cons p q) y))
        from funext fun p => ih _ _]
    exact Elem.wavg_comm _ _ _ _ _

/-- The product formula (as an inequality): for disjoint nonempty sets of primes,
`E^log_{a,b} gcd(∏ a, ∏ b) ≤ ∏_ℓ (1 + (∑_{p∈S_ℓ} 1/p)⁻¹)`. -/
lemma iterAvg_gcd_le {k : ℕ} (S : Fin k → Finset ℕ) (hS : GoodSets S)
    (hprime : ∀ i, ∀ p ∈ S i, p.Prime) (hdisj : ∀ i j, i ≠ j → Disjoint (S i) (S j)) :
    iterAvg k S (fun a => iterAvg k S (fun b => (Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) : ℝ))) ≤
      ∏ ℓ, (1 + 1 / ∑ p ∈ S ℓ, (1 : ℝ) / p) := by
  induction k with
  | zero => simp [iterAvg]
  | succ k ih =>
    have hS' : GoodSets (fun i : Fin k => S i.succ) := hS.tail
    have ih' := ih (fun i => S i.succ) hS' (fun i => hprime i.succ)
      (fun i j hij => hdisj _ _ (fun h => hij (Fin.succ_injective _ h)))
    have hw0 := goodWeights_lavg (hS 0).1 (hS 0).2
    -- coprimality of a prime of `S 0` with a product from the other sets
    have hcop : ∀ p ∈ S 0, ∀ b' : Fin k → ℕ, (∀ i, b' i ∈ S i.succ) →
        Nat.Coprime p (∏ ℓ, b' ℓ) := by
      intro p hp b' hb'
      refine Nat.Coprime.prod_right fun i _ => ?_
      refine (Nat.coprime_primes (hprime 0 p hp) (hprime i.succ _ (hb' i))).mpr ?_
      intro heq
      have := Finset.disjoint_left.mp (hdisj 0 i.succ (Fin.succ_ne_zero i).symm) hp
      rw [heq] at this
      exact this (hb' i)
    set Y : (Fin k → ℕ) → ℝ := fun a' =>
      iterAvg k (fun i => S i.succ) (fun b' => (Nat.gcd (∏ ℓ, a' ℓ) (∏ ℓ, b' ℓ) : ℝ)) with hY
    have hY0 : 0 ≤ iterAvg k (fun i => S i.succ) Y :=
      le_trans (by rw [iterAvg_const hS']) (iterAvg_mono hS' fun a' =>
        le_trans (by rw [iterAvg_const hS']) (iterAvg_mono hS' fun b' => Nat.cast_nonneg _))
    calc iterAvg (k + 1) S (fun a => iterAvg (k + 1) S (fun b =>
          (Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) : ℝ)))
        = lavg (S 0) (fun p => iterAvg k (fun i => S i.succ) (fun a' => lavg (S 0) (fun p' =>
            iterAvg k (fun i => S i.succ) (fun b' =>
              (Nat.gcd (p * ∏ ℓ, a' ℓ) (p' * ∏ ℓ, b' ℓ) : ℝ))))) := by
          simp only [iterAvg, Fin.prod_cons]
      _ = lavg (S 0) (fun p => iterAvg k (fun i => S i.succ) (fun a' => lavg (S 0) (fun p' =>
            (Nat.gcd p p' : ℝ) * Y a'))) := by
          refine wavg_congr fun p hp => iterAvg_congr' hS' fun a' ha' =>
            wavg_congr fun p' hp' => ?_
          rw [hY, ← iterAvg_smul]
          refine iterAvg_congr' hS' fun b' hb' => ?_
          rw [gcd_mul_mul_of_coprime (hprime 0 p hp) (hprime 0 p' hp') (hcop p hp b' hb')
            (hcop p' hp' a' ha')]
          push_cast
          ring
      _ = lavg (S 0) (fun p => lavg (S 0) (fun p' => (Nat.gcd p p' : ℝ)) *
            iterAvg k (fun i => S i.succ) Y) := by
          refine wavg_congr fun p _ => ?_
          rw [← iterAvg_smul]
          congr 1
          funext a'
          exact (Elem.wavg_mul_const _ _ _ _).symm
      _ = lavg (S 0) (fun p => lavg (S 0) (fun p' => (Nat.gcd p p' : ℝ))) *
            iterAvg k (fun i => S i.succ) Y := (Elem.wavg_mul_const _ _ _ _).symm
      _ ≤ (1 + 1 / ∑ p ∈ S 0, (1 : ℝ) / p) *
            ∏ ℓ : Fin k, (1 + 1 / ∑ p ∈ S ℓ.succ, (1 : ℝ) / p) := by
          refine mul_le_mul (lavg_gcd_le (hS 0).1 (hprime 0)) ih' hY0 ?_
          have : 0 < ∑ p ∈ S 0, (1 : ℝ) / p := hw0.sum_pos
          positivity
      _ = ∏ ℓ, (1 + 1 / ∑ p ∈ S ℓ, (1 : ℝ) / p) :=
          (Fin.prod_univ_succ (fun ℓ => 1 + 1 / ∑ p ∈ S ℓ, (1 : ℝ) / p)).symm

/-- `loglog` of a natural number `≥ 3` is positive. -/
lemma loglog_pos {x : ℕ} (hx : 3 ≤ x) : 0 < Real.log (Real.log x) := by
  have hx3 : (3 : ℝ) ≤ x := by exact_mod_cast hx
  have : 1 < Real.log x := by
    rw [Real.lt_log_iff_exp_lt (by linarith)]
    have := Real.exp_one_lt_d9
    linarith
  exact Real.log_pos this

/-- The width condition and Mertens' theorem give `∑_{p∈[lo,hi)} 1/p ≥ W - C_M`. -/
lemma sum_primesIn_ge {C_M W : ℝ} (hM : MertensLowerWith C_M) (hW : 0 < W) {lo hi : ℕ}
    (hlo : 3 ≤ lo)
    (hwidth : Real.log (Real.log lo) + W ≤ Real.log (Real.log ((hi : ℝ) - 1))) :
    W - C_M ≤ ∑ p ∈ primesIn lo hi, (1 : ℝ) / p := by
  have hll := loglog_pos hlo
  have hhi : 3 ≤ hi := by
    by_contra h
    push Not at h
    have : Real.log (Real.log ((hi : ℝ) - 1)) = 0 := by
      interval_cases hi <;> norm_num
    linarith
  have hhiR : (3 : ℝ) ≤ hi := by exact_mod_cast hhi
  have h1 : Real.log (Real.log ((hi : ℝ) - 1)) ≤ Real.log (Real.log hi) := by
    have hpos : 0 < Real.log ((hi : ℝ) - 1) := Real.log_pos (by linarith)
    exact Real.log_le_log hpos (Real.log_le_log (by linarith) (by linarith))
  have hlohi : lo ≤ hi := by
    have h2 : Real.log (Real.log lo) < Real.log (Real.log hi) := by linarith
    have hl0 : 0 < Real.log (lo : ℝ) := Real.log_pos (by
      have : (3 : ℝ) ≤ lo := by exact_mod_cast hlo
      linarith)
    have hlhi : 0 < Real.log (hi : ℝ) := Real.log_pos (by linarith)
    have h3 : Real.log (lo : ℝ) < Real.log hi := (Real.log_lt_log_iff hl0 hlhi).mp h2
    have h4 : (lo : ℝ) < hi := (Real.log_lt_log_iff (by positivity) (by positivity)).mp h3
    exact_mod_cast h4.le
  have := hM lo hi hlo hlohi
  linarith

/-- An iterated average over a family containing an empty set vanishes. -/
lemma iterAvg_eq_zero_of_empty {k : ℕ} (S : Fin k → Finset ℕ) (j : Fin k) (hj : S j = ∅)
    (F : (Fin k → ℕ) → ℝ) : iterAvg k S F = 0 := by
  induction k with
  | zero => exact j.elim0
  | succ k ih =>
    simp only [iterAvg, lavg]
    obtain rfl | ⟨j', rfl⟩ := Fin.eq_zero_or_eq_succ j
    · rw [hj]
      simp [wavg]
    · have : ∀ p, iterAvg k (fun i => S i.succ) (fun q => F (Fin.cons p q)) = 0 :=
        fun p => ih (fun i => S i.succ) j' hj _
      simp only [this]
      simp [wavg]

/-- Mertens' theorem for a nonempty set of primes `[lo, hi)` satisfying the width condition:
`∑_{p∈[lo,hi)} 1/p ≥ W - C_M` (no sign condition on `W`). -/
lemma sum_primesIn_ge' {C_M W : ℝ} (hM : MertensLowerWith C_M) {lo hi : ℕ} (hlo : 3 ≤ lo)
    (hne : (primesIn lo hi).Nonempty)
    (hwidth : Real.log (Real.log lo) + W ≤ Real.log (Real.log ((hi : ℝ) - 1))) :
    W - C_M ≤ ∑ p ∈ primesIn lo hi, (1 : ℝ) / p := by
  obtain ⟨p, hp⟩ := hne
  have hp' := Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1
  have hlohi : lo ≤ hi := by omega
  have hhiR : (4 : ℝ) ≤ hi := by exact_mod_cast (show 4 ≤ hi by omega)
  have h1 : Real.log (Real.log ((hi : ℝ) - 1)) ≤ Real.log (Real.log hi) := by
    have hpos : 0 < Real.log ((hi : ℝ) - 1) := Real.log_pos (by linarith)
    exact Real.log_le_log hpos (Real.log_le_log (by linarith) (by linarith))
  have := hM lo hi hlo hlohi
  linarith

/-- **GS Lemma 5.2** (general form). Let `lo ℓ, hi ℓ` (`ℓ < k`) bound pairwise disjoint intervals
with `lo ℓ ≥ 3` and `log log lo ℓ + W ≤ log log (hi ℓ - 1)`, where `W > C_M` and
`MertensLowerWith C_M`. Then, for `S ℓ` = the primes in `[lo ℓ, hi ℓ)`,
`γ(𝒫') ≤ exp(k/(W - C_M)) - 1`. -/
theorem lemma52 {k : ℕ} {C_M W : ℝ} (hM : MertensLowerWith C_M) (hW : C_M < W)
    (lo hi : Fin k → ℕ) (hlo : ∀ ℓ, 3 ≤ lo ℓ)
    (hdisj : ∀ ℓ ℓ', ℓ ≠ ℓ' → hi ℓ ≤ lo ℓ' ∨ hi ℓ' ≤ lo ℓ)
    (hwidth : ∀ ℓ, Real.log (Real.log (lo ℓ)) + W ≤ Real.log (Real.log ((hi ℓ : ℝ) - 1))) :
    gammaP k (fun ℓ => primesIn (lo ℓ) (hi ℓ)) ≤ Real.exp (k / (W - C_M)) - 1 := by
  set S : Fin k → Finset ℕ := fun ℓ => primesIn (lo ℓ) (hi ℓ) with hSdef
  have hWC : 0 < W - C_M := by linarith
  have hexp0 : 0 ≤ Real.exp (k / (W - C_M)) - 1 := by
    have : 1 ≤ Real.exp (k / (W - C_M)) := Real.one_le_exp (by positivity)
    linarith
  -- if some `S ℓ` is empty, all the averages vanish
  by_cases hne : ∀ ℓ, (S ℓ).Nonempty
  swap
  · push Not at hne
    obtain ⟨j, hj⟩ := hne
    have hj' : S j = ∅ := by simpa [Finset.not_nonempty_iff_eq_empty] using hj
    unfold gammaP
    rw [iterAvg_eq_zero_of_empty S j hj']
    exact hexp0
  have hm : ∀ ℓ, W - C_M ≤ ∑ p ∈ S ℓ, (1 : ℝ) / p := fun ℓ =>
    sum_primesIn_ge' hM (hlo ℓ) (hne ℓ) (hwidth ℓ)
  have hprime : ∀ i, ∀ p ∈ S i, p.Prime := fun i p hp => (Finset.mem_filter.mp hp).2
  have hS : GoodSets S := fun i => ⟨hne i, fun p hp => (hprime i p hp).pos⟩
  have hdisj' : ∀ i j, i ≠ j → Disjoint (S i) (S j) := by
    intro i j hij
    rw [Finset.disjoint_left]
    intro p hpi hpj
    have hi' := Finset.mem_Ico.mp (Finset.mem_filter.mp hpi).1
    have hj' := Finset.mem_Ico.mp (Finset.mem_filter.mp hpj).1
    rcases hdisj i j hij with h | h <;> omega
  -- `γ = E gcd - 1`
  have eγ : gammaP k S =
      iterAvg k S (fun a => iterAvg k S (fun b => (Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) : ℝ))) - 1 := by
    unfold gammaP
    have : ∀ a : Fin k → ℕ, iterAvg k S (fun b => (Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) : ℝ) - 1) =
        iterAvg k S (fun b => (Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) : ℝ)) - 1 := by
      intro a
      rw [iterAvg_sub, iterAvg_const hS]
    simp only [this]
    rw [iterAvg_sub, iterAvg_const hS]
  rw [eγ]
  have hprod := iterAvg_gcd_le S hS hprime hdisj'
  have hbound : ∏ ℓ, (1 + 1 / ∑ p ∈ S ℓ, (1 : ℝ) / p) ≤ (1 + 1 / (W - C_M)) ^ k := by
    calc ∏ ℓ, (1 + 1 / ∑ p ∈ S ℓ, (1 : ℝ) / p) ≤ ∏ _ℓ : Fin k, (1 + 1 / (W - C_M)) := by
          refine Finset.prod_le_prod (fun ℓ _ => ?_) (fun ℓ _ => ?_)
          · have : 0 < ∑ p ∈ S ℓ, (1 : ℝ) / p := lt_of_lt_of_le hWC (hm ℓ)
            positivity
          · have := one_div_le_one_div_of_le hWC (hm ℓ)
            linarith
      _ = (1 + 1 / (W - C_M)) ^ k := by simp
  have hexp : (1 + 1 / (W - C_M)) ^ k ≤ Real.exp (k / (W - C_M)) := by
    calc (1 + 1 / (W - C_M)) ^ k ≤ (Real.exp (1 / (W - C_M))) ^ k := by
          refine pow_le_pow_left₀ (by positivity) ?_ k
          have := Real.add_one_le_exp (1 / (W - C_M))
          linarith
      _ = Real.exp (k / (W - C_M)) := by
          rw [← Real.exp_nat_mul]
          congr 1
          ring
  linarith

/-- The indicator form used by GS in §5 (after (5.24)): the proportion of non-coprime pairs is at
most `γ(𝒫')`. -/
theorem lemma52_indicator {k : ℕ} (S : Fin k → Finset ℕ) (hS : GoodSets S) :
    iterAvg k S (fun a => iterAvg k S (fun b =>
      if Nat.Coprime (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) then (0 : ℝ) else 1)) ≤ gammaP k S := by
  unfold gammaP
  refine iterAvg_mono' hS fun a ha => iterAvg_mono' hS fun b hb => ?_
  have hA : 0 < ∏ ℓ, a ℓ := Finset.prod_pos fun i _ => (hS i).2 _ (ha i)
  have hg : 0 < Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) := Nat.gcd_pos_of_pos_left _ hA
  by_cases h : Nat.Coprime (∏ ℓ, a ℓ) (∏ ℓ, b ℓ)
  · rw [if_pos h, Nat.Coprime.gcd_eq_one h]
    simp
  · rw [if_neg h]
    have : 2 ≤ Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) := by
      have hne : Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) ≠ 1 := h
      omega
    have : (2 : ℝ) ≤ Nat.gcd (∏ ℓ, a ℓ) (∏ ℓ, b ℓ) := by exact_mod_cast this
    linarith

/-- **GS Lemma 5.2 under the hypotheses of `Prop51With`**: width `k δ^{-5}`, `k ≥ 1`,
`3 ≤ P'₁ ≤ lo ℓ`, disjoint intervals; for `δ ≤ 1/2` with `2 C_M δ⁵ ≤ 1` one has
`γ(𝒫') ≤ 4 δ⁵` (GS: `δ^{4 + ε₀/2}`). -/
theorem lemma52_prop51 {k : ℕ} (hk : 1 ≤ k) {C_M : ℝ} (hM : MertensLowerWith C_M)
    {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1 / 2) (hδC : 2 * C_M * δ ^ 5 ≤ 1)
    {P₁' P₂' : ℕ} (lo hi : Fin (k + 1) → ℕ) (hP₁' : 3 ≤ P₁')
    (hI : ∀ ℓ : Fin k, P₁' ≤ lo ℓ.castSucc ∧ lo ℓ.castSucc < hi ℓ.castSucc ∧ hi ℓ.castSucc ≤ P₂')
    (hdisj : ∀ ℓ ℓ' : Fin k, ℓ ≠ ℓ' →
      hi ℓ.castSucc ≤ lo ℓ'.castSucc ∨ hi ℓ'.castSucc ≤ lo ℓ.castSucc)
    (hwidth : ∀ ℓ : Fin k, Real.log (Real.log (lo ℓ.castSucc)) + k * (1 / δ) ^ 5 ≤
      Real.log (Real.log ((hi ℓ.castSucc : ℝ) - 1))) :
    gammaP k (fun ℓ => primesIn (lo ℓ.castSucc) (hi ℓ.castSucc)) ≤ 4 * δ ^ 5 := by
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hδ5 : 0 < δ ^ 5 := by positivity
  set u : ℝ := (1 / δ) ^ 5 with hu
  have hupos : 0 < u := by positivity
  have hδu : δ ^ 5 * u = 1 := by
    rw [hu, one_div, inv_pow, mul_inv_cancel₀ hδ5.ne']
  have hCu : 2 * C_M ≤ u := by nlinarith
  have hW : C_M < k * u := by nlinarith
  have h52 := lemma52 (k := k) (W := k * u) hM hW (fun ℓ => lo ℓ.castSucc)
    (fun ℓ => hi ℓ.castSucc) (fun ℓ => le_trans hP₁' (hI ℓ).1) hdisj hwidth
  have hWC : k * u / 2 ≤ k * u - C_M := by nlinarith
  have hx : (k : ℝ) / (k * u - C_M) ≤ 2 * δ ^ 5 := by
    rw [div_le_iff₀ (by nlinarith)]
    nlinarith
  have hx0 : 0 ≤ (k : ℝ) / (k * u - C_M) := by
    have : 0 < k * u - C_M := by linarith
    positivity
  have hδ5' : δ ^ 5 ≤ 1 / 32 := by
    have : δ ^ 5 ≤ (1 / 2) ^ 5 := pow_le_pow_left₀ hδ.le hδ1 5
    norm_num at this ⊢
    linarith
  have hexp : Real.exp ((k : ℝ) / (k * u - C_M)) - 1 ≤ 2 * ((k : ℝ) / (k * u - C_M)) := by
    have h := Real.abs_exp_sub_one_le (x := (k : ℝ) / (k * u - C_M))
      (by rw [abs_of_nonneg hx0]; linarith)
    rw [abs_of_nonneg hx0] at h
    exact (le_abs_self _).trans h
  linarith

/- ### The coprimality switch (5.5) -/

/-- `E^log_{n≤N} 1_{d∣n} ≤ 1/d`. -/
lemma logAvg_ind_le (N d : ℕ) (hd : 0 < d) :
    logAvg N (fun n => if (d : ℤ) ∣ n then 1 else 0) ≤ 1 / d := by
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · simp only [logAvg, wavg, Finset.Icc_eq_empty_of_lt, zero_lt_one, Finset.sum_empty, div_zero]
    positivity
  rw [logAvg_eq_sum]
  have e : ∑ n ∈ Icc 1 N, 1 / (n : ℝ) * (if (d : ℤ) ∣ (n : ℤ) then 1 else 0) =
      ∑ m ∈ Icc 1 N, 1 / (m : ℝ) * Elliott.ind d m := by
    refine Finset.sum_congr rfl fun m _ => ?_
    unfold Elliott.ind
    simp only [Int.natCast_dvd_natCast]
  rw [e, Elliott.sum_inv_ind N d hd]
  have hLpos : 0 < hR N := by
    have h1 : Real.log ((N + 1 : ℕ) : ℝ) ≤ hR N := by
      rw [hR_eq_harmonic]; exact log_add_one_le_harmonic N
    have h2 : 0 < Real.log ((N + 1 : ℕ) : ℝ) := Real.log_pos (by
      have : (2 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) := by exact_mod_cast (show 2 ≤ N + 1 by omega)
      linarith)
    linarith
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hmono := hR_mono (Nat.div_le_self N d)
  rw [div_div, div_le_div_iff₀ (by positivity) hdR]
  nlinarith

/-- The error in the coprimality switch (5.5), for one pair: for `a, b ≥ 1`,
`E^log_{n≤N} ab |1_{a∣n} 1_{b∣n} - 1_{ab∣n}| ≤ 2 (gcd(a, b) - 1)`
(note `1_{a∣n} 1_{b∣n} = 1_{[a,b]∣n}`). -/
lemma logAvg_switch_le (N a b : ℕ) (ha : 0 < a) (hb : 0 < b) :
    logAvg N (fun n => ((a * b : ℕ) : ℝ) *
      |(if (a : ℤ) ∣ n then 1 else 0) * (if (b : ℤ) ∣ n then 1 else 0) -
        (if ((a * b : ℕ) : ℤ) ∣ n then 1 else 0)|) ≤ 2 * ((Nat.gcd a b : ℝ) - 1) := by
  have hg : 0 < Nat.gcd a b := Nat.gcd_pos_of_pos_left _ ha
  have hL : 0 < Nat.lcm a b := Nat.lcm_pos ha hb
  -- pointwise bound on the integrand, at `n = m ∈ ℕ`
  have hpt : ∀ m : ℕ, ((a * b : ℕ) : ℝ) *
      |(if (a : ℤ) ∣ (m : ℤ) then 1 else 0) * (if (b : ℤ) ∣ (m : ℤ) then 1 else 0) -
        (if ((a * b : ℕ) : ℤ) ∣ (m : ℤ) then 1 else 0)| ≤
      (if Nat.gcd a b = 1 then 0 else ((a * b : ℕ) : ℝ) *
        (if ((Nat.lcm a b : ℕ) : ℤ) ∣ (m : ℤ) then 1 else 0)) := by
    intro m
    simp only [Int.natCast_dvd_natCast]
    have hlcm : Nat.lcm a b ∣ m ↔ a ∣ m ∧ b ∣ m := Nat.lcm_dvd_iff
    have hab : a * b ∣ m → a ∣ m ∧ b ∣ m := fun h =>
      ⟨dvd_trans (dvd_mul_right a b) h, dvd_trans (dvd_mul_left b a) h⟩
    by_cases hc : Nat.gcd a b = 1
    · rw [if_pos hc]
      have hab' : a ∣ m ∧ b ∣ m → a * b ∣ m := fun h => Nat.Coprime.mul_dvd_of_dvd_of_dvd hc h.1 h.2
      by_cases h1 : a ∣ m <;> by_cases h2 : b ∣ m <;> by_cases h3 : a * b ∣ m <;>
        simp_all
    · rw [if_neg hc]
      by_cases h1 : a ∣ m <;> by_cases h2 : b ∣ m <;> by_cases h3 : a * b ∣ m <;>
        simp_all
  have hN : ∀ N : ℕ, logAvg N (fun n => ((a * b : ℕ) : ℝ) *
      |(if (a : ℤ) ∣ n then 1 else 0) * (if (b : ℤ) ∣ n then 1 else 0) -
        (if ((a * b : ℕ) : ℤ) ∣ n then 1 else 0)|) ≤
      (if Nat.gcd a b = 1 then 0 else ((a * b : ℕ) : ℝ) *
        logAvg N (fun n => if ((Nat.lcm a b : ℕ) : ℤ) ∣ n then 1 else 0)) := by
    intro N
    rcases Nat.eq_zero_or_pos N with rfl | hN
    · simp [logAvg, wavg]
    have hw := goodWeights_logAvg hN
    by_cases hc : Nat.gcd a b = 1
    · rw [if_pos hc]
      have := wavg_mono hw (f := fun m : ℕ => ((a * b : ℕ) : ℝ) *
        |(if (a : ℤ) ∣ (m : ℤ) then 1 else 0) * (if (b : ℤ) ∣ (m : ℤ) then 1 else 0) -
          (if ((a * b : ℕ) : ℤ) ∣ (m : ℤ) then 1 else 0)|) (g := fun _ => (0 : ℝ))
        (fun m _ => by have := hpt m; rw [if_pos hc] at this; exact this)
      rw [wavg_const hw] at this
      exact this
    · rw [if_neg hc]
      unfold logAvg
      rw [← wavg_smul]
      exact wavg_mono hw fun m _ => by have := hpt m; rw [if_neg hc] at this; exact this
  refine (hN N).trans ?_
  by_cases hc : Nat.gcd a b = 1
  · rw [if_pos hc, hc]
    simp
  · rw [if_neg hc]
    have h2 : 2 ≤ Nat.gcd a b := by omega
    have hind := logAvg_ind_le N (Nat.lcm a b) hL
    have habL : ((a * b : ℕ) : ℝ) = (Nat.gcd a b : ℝ) * (Nat.lcm a b : ℝ) := by
      rw [← Nat.cast_mul, Nat.gcd_mul_lcm]
    have hLR : (0 : ℝ) < Nat.lcm a b := by exact_mod_cast hL
    have hgR : (2 : ℝ) ≤ Nat.gcd a b := by exact_mod_cast h2
    calc ((a * b : ℕ) : ℝ) * logAvg N (fun n => if ((Nat.lcm a b : ℕ) : ℤ) ∣ n then 1 else 0)
        ≤ ((a * b : ℕ) : ℝ) * (1 / Nat.lcm a b) :=
          mul_le_mul_of_nonneg_left hind (by positivity)
      _ = Nat.gcd a b := by rw [habL]; field_simp
      _ ≤ 2 * ((Nat.gcd a b : ℝ) - 1) := by linarith

/-- **The coprimality switch (5.5)**: for the almost primes `𝒫'` given by disjoint-or-not sets
`S ℓ` of positive integers,
`E^log_{p'₁,p'₂∈𝒫'} E^log_{n≤N} p'₁p'₂ |1_{p'₁∣n} 1_{p'₂∣n} - 1_{p'₁p'₂∣n}| ≤ 2 γ(𝒫')`
(GS obtain `8γ(𝒫')`). -/
theorem lemma55 {k : ℕ} (N : ℕ) (S : Fin k → Finset ℕ) (hS : GoodSets S) :
    iterAvg k S (fun a => iterAvg k S (fun b => logAvg N (fun n =>
      (((∏ ℓ, a ℓ) * (∏ ℓ, b ℓ) : ℕ) : ℝ) *
        |(if ((∏ ℓ, a ℓ : ℕ) : ℤ) ∣ n then 1 else 0) * (if ((∏ ℓ, b ℓ : ℕ) : ℤ) ∣ n then 1 else 0) -
          (if (((∏ ℓ, a ℓ) * (∏ ℓ, b ℓ) : ℕ) : ℤ) ∣ n then 1 else 0)|))) ≤ 2 * gammaP k S := by
  unfold gammaP
  rw [← iterAvg_smul]
  refine iterAvg_mono' hS fun a ha => ?_
  rw [← iterAvg_smul]
  refine iterAvg_mono' hS fun b hb => ?_
  have hA : 0 < ∏ ℓ, a ℓ := Finset.prod_pos fun i _ => (hS i).2 _ (ha i)
  have hB : 0 < ∏ ℓ, b ℓ := Finset.prod_pos fun i _ => (hS i).2 _ (hb i)
  exact logAvg_switch_le N _ _ hA hB

end G22.Small

end

/- ## Section: `Lemma41Aux` -/

section

/-
# GS Lemma 4.1, infrastructure: Ramanujan sums and the Selberg majorant

Auxiliary file for `Green22Lean/Lemma41.lean` (GS = B. Green, M. Sawhney, arXiv:2511.09365v2).

Squarefree moduli are encoded by finite sets of primes `U` (`q_U = ∏_{p∈U} p`, `qU U`).

* **Ramanujan sums.** `cT U n = ∏_{p∈U} c_p(n)` with `c_p(n) = p - 1` if `p ∣ n` and `-1` otherwise;
  `cT_eq_ram`: this is `∑_{e ∣ (q,n)} e μ(q/e)`; **Kluyver's identity** `cT_eq_sum_ee`:
  `c_q(n) = ∑_{0 ≤ a < q, (a,q)=1} e(an/q)`; the product formula `cT_mul_cT`.
* **Ramanujan expansions** `ramExp B C n = ∑_{U∈B} C_U c_{q_U}(n)`:
  - Fourier bound `norm_fourier_ramExp_le`: if all `q_U ≤ M` then
    `|∑_{x∈[k₁,k₂)} f(x) e(θx)| ≤ (k₂-k₁) max|C_U| + M² ∑_U |C_U| q_U`
    (at most one reduced fraction `a/q` is `1/(2M²)`-close to `-θ`);
  - pointwise bound `abs_ramExp_le` and **moment bound** `sum_pow_abs_ramExp_le` (if
    `|C_U| ≤ ∏_{p∈U} A/p` and all primes are `≤ Y`, then `E|f|^m ≪ (∏_{p≤Y}(1+A/p))^m ∏(1+((1+A)^m-1)/p)`),
    with Mertens' bound `prod_one_add_div_le` (`∏_{p≤Y}(1+a/p) ≤ e^{a c}(log Y)^a`, from Mertens' theorem in `MertensLower`);
  - the divisor-type bound `rpow_card_le` (`A^{ω(q)} ≤ A^{A⁴} q^{1/4}`).
* **The Selberg majorant** `selbergMajorant R n = S(n)²/G(R)`, `S(n) = ∑_{r≤R} μ(r)/φ(r) c_r(n)`,
  `G(R) = ∑_{r≤R} μ²(r)/φ(r)`:
  - `selbergMajorant_prime`: `Λ̃(p) = G(R)` for primes `p > R`; `log_le_Gsel`: `G(R) ≥ log(R+1)`;
  - `selbergMajorant_eq_ramExp`: `Λ̃ = ∑_{U∈UR R} C_U c_{q_U}` with `q_U ≤ R²` (`UR_spec`) and
    `abs_CR_le`: `|C_q| ≤ 3^{ω(q)}/φ(q)`;
  - sums over arithmetic progressions `sum_AP_selbergMajorant_le`,
    `sum_interval_AP_selbergMajorant_le`, and the mean `sum_dyadic_selbergMajorant_le`.
* Block estimates for the dyadic decomposition (`block_bounds`, `block_46`, `sum46`, `moment_period`,
  `sup_per`) used in `Lemma41.lean`.
-/

open Finset Real
open scoped ArithmeticFunction.Moebius

namespace G22.L41

open G22.FPD

/- ### Primes, local Ramanujan factors -/

/-- The primes `p ≤ Y`. -/
def primesLE (Y : ℕ) : Finset ℕ := (Finset.Ioc 0 Y).filter Nat.Prime

lemma mem_primesLE {Y p : ℕ} : p ∈ primesLE Y ↔ p.Prime ∧ p ≤ Y := by
  unfold primesLE
  rw [Finset.mem_filter, Finset.mem_Ioc]
  constructor
  · rintro ⟨⟨-, h⟩, hp⟩; exact ⟨hp, h⟩
  · rintro ⟨hp, h⟩; exact ⟨⟨hp.pos, h⟩, hp⟩

/-- The local factor `c_p(n)` of a Ramanujan sum: `p - 1` if `p ∣ n` and `-1` otherwise. -/
noncomputable def cP (p : ℕ) (n : ℤ) : ℝ := if (p : ℤ) ∣ n then (p : ℝ) - 1 else -1

/-- The Ramanujan sum `c_q(n)` for the squarefree modulus `q = ∏_{p ∈ U} p`, in product form. -/
noncomputable def cT (U : Finset ℕ) (n : ℤ) : ℝ := ∏ p ∈ U, cP p n

/-- The modulus `q_U = ∏_{p ∈ U} p`. -/
def qU (U : Finset ℕ) : ℕ := ∏ p ∈ U, p

lemma qU_pos {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) : 0 < qU U :=
  Finset.prod_pos fun p hp => (hU p hp).pos

lemma cT_empty (n : ℤ) : cT ∅ n = 1 := by simp [cT]

lemma cP_add_mul (p : ℕ) (n k : ℤ) : cP p (n + p * k) = cP p n := by
  unfold cP
  have : (p : ℤ) ∣ n + p * k ↔ (p : ℤ) ∣ n := (dvd_add_left (dvd_mul_right _ _))
  simp only [this]

lemma cT_periodic {U : Finset ℕ} {L : ℤ} (hL : ∀ p ∈ U, (p : ℤ) ∣ L) (n : ℤ) :
    cT U (n + L) = cT U n := by
  unfold cT
  refine Finset.prod_congr rfl fun p hp => ?_
  obtain ⟨k, hk⟩ := hL p hp
  rw [hk, cP_add_mul]

lemma abs_cP_le (p : ℕ) (hp : 1 ≤ p) (n : ℤ) : |cP p n| ≤ if (p : ℤ) ∣ n then (p : ℝ) else 1 := by
  have hp' : (1 : ℝ) ≤ p := by exact_mod_cast hp
  unfold cP
  split_ifs
  · rw [abs_of_nonneg (by linarith)]; linarith
  · simp

lemma abs_cP_le' (p : ℕ) (hp : 1 ≤ p) (n : ℤ) : |cP p n| ≤ (p : ℝ) := by
  have hp' : (1 : ℝ) ≤ p := by exact_mod_cast hp
  refine (abs_cP_le p hp n).trans ?_
  split_ifs <;> linarith

lemma abs_cT_le {U : Finset ℕ} (hU : ∀ p ∈ U, 1 ≤ p) (n : ℤ) : |cT U n| ≤ (qU U : ℝ) := by
  unfold cT qU
  rw [Finset.abs_prod]
  push_cast
  exact Finset.prod_le_prod (fun p _ => abs_nonneg _) fun p hp => abs_cP_le' p (hU p hp) n

/-- `c_p(n)^2 = (p - 1) + (p - 2) c_p(n)`. -/
lemma cP_sq (p : ℕ) (n : ℤ) : cP p n ^ 2 = ((p : ℝ) - 1) + ((p : ℝ) - 2) * cP p n := by
  unfold cP
  split_ifs <;> ring

/- ### The Ramanujan sum as an arithmetic function, and Kluyver's identity -/

/-- `d ↦ d · 1_{d ∣ n}` as an arithmetic function. -/
def dvdInd (n : ℤ) : ArithmeticFunction ℤ :=
  ⟨fun d => if (d : ℤ) ∣ n then (d : ℤ) else 0, by simp⟩

lemma dvdInd_apply (n : ℤ) (d : ℕ) : dvdInd n d = if (d : ℤ) ∣ n then (d : ℤ) else 0 := rfl

lemma isMultiplicative_dvdInd (n : ℤ) : (dvdInd n).IsMultiplicative := by
  refine ⟨by simp [dvdInd_apply], fun {a b} hab => ?_⟩
  simp only [dvdInd_apply]
  push_cast
  by_cases ha : (a : ℤ) ∣ n <;> by_cases hb : (b : ℤ) ∣ n
  · rw [if_pos ha, if_pos hb, if_pos]
    exact IsCoprime.mul_dvd (Nat.isCoprime_iff_coprime.mpr hab) ha hb
  · rw [if_neg hb, mul_zero, if_neg]
    exact fun h => hb (dvd_trans (dvd_mul_left _ _) h)
  · rw [if_neg ha, zero_mul, if_neg]
    exact fun h => ha (dvd_trans (dvd_mul_right _ _) h)
  · rw [if_neg ha, zero_mul, if_neg]
    exact fun h => ha (dvd_trans (dvd_mul_right _ _) h)

/-- The Ramanujan sum `c_q(n) = ∑_{d ∣ (q,n)} d μ(q/d)` as a Dirichlet convolution in `q`. -/
def ram (n : ℤ) : ArithmeticFunction ℤ := dvdInd n * (μ : ArithmeticFunction ℤ)

lemma isMultiplicative_ram (n : ℤ) : (ram n).IsMultiplicative :=
  (isMultiplicative_dvdInd n).mul ArithmeticFunction.isMultiplicative_moebius

lemma ram_apply (n : ℤ) (q : ℕ) : ram n q = ∑ e ∈ q.divisors, dvdInd n (q / e) * μ e := by
  unfold ram
  rw [ArithmeticFunction.mul_apply]
  exact Nat.sum_divisorsAntidiagonal' (fun a b => dvdInd n a * μ b)

lemma ram_prime {p : ℕ} (hp : p.Prime) (n : ℤ) : (ram n p : ℝ) = cP p n := by
  rw [ram_apply, Nat.Prime.sum_divisors hp]
  simp only [Nat.div_self hp.pos, Nat.div_one, dvdInd_apply, Nat.cast_one, one_dvd, if_true,
    ArithmeticFunction.moebius_apply_prime hp, ArithmeticFunction.moebius_apply_one]
  unfold cP
  split_ifs <;> push_cast <;> ring

lemma cT_eq_ram {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) (n : ℤ) :
    cT U n = (ram n (qU U) : ℝ) := by
  unfold cT qU
  rw [(isMultiplicative_ram n).map_prod_of_prime U hU]
  push_cast
  exact Finset.prod_congr rfl fun p hp => (ram_prime (hU p hp) n).symm

/-- `∑_{b < m} e(bn/m) = m 1_{m ∣ n}`. -/
lemma sum_range_ee (m : ℕ) (hm : 0 < m) (n : ℤ) :
    ∑ b ∈ range m, ee ((b : ℝ) * n / m) = if (m : ℤ) ∣ n then (m : ℂ) else 0 := by
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hmC : (m : ℂ) ≠ 0 := by exact_mod_cast hm.ne'
  set z : ℂ := ee ((n : ℝ) / m) with hz
  have hpow : ∀ b : ℕ, ee ((b : ℝ) * n / m) = z ^ b := by
    intro b
    rw [hz]; unfold ee
    rw [← Complex.exp_nat_mul]; congr 1; push_cast; ring
  simp_rw [hpow]
  split_ifs with h
  · obtain ⟨k, hk⟩ := h
    have hz1 : z = 1 := by
      rw [hz]; unfold ee
      have : (2 * π * Complex.I * (((n : ℝ) / m : ℝ) : ℂ)) = (k : ℂ) * (2 * π * Complex.I) := by
        rw [hk]; push_cast; field_simp
      rw [this, Complex.exp_int_mul_two_pi_mul_I]
    simp [hz1]
  · have hz1 : z ≠ 1 := by
      intro h1
      rw [hz] at h1; unfold ee at h1
      obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp h1
      apply h
      refine ⟨k, ?_⟩
      have hpi : (2 * π * Complex.I : ℂ) ≠ 0 := by
        simp [Real.pi_ne_zero, Complex.I_ne_zero]
      have h2 : (((n : ℝ) / m : ℝ) : ℂ) = (k : ℂ) := by
        have := hk
        rw [show (2 * π * Complex.I * (((n : ℝ) / m : ℝ) : ℂ)) =
          (((n : ℝ) / m : ℝ) : ℂ) * (2 * π * Complex.I) by ring] at this
        exact mul_right_cancel₀ hpi this
      have h3 : (n : ℝ) / m = k := by exact_mod_cast h2
      have h4 : (n : ℝ) = m * k := by field_simp at h3; linarith
      exact_mod_cast h4
    have hzm : z ^ m = 1 := by
      rw [hz]; unfold ee
      rw [← Complex.exp_nat_mul]
      have : ((m : ℂ) * (2 * π * Complex.I * (((n : ℝ) / m : ℝ) : ℂ))) =
          (n : ℂ) * (2 * π * Complex.I) := by
        push_cast; field_simp
      rw [this, Complex.exp_int_mul_two_pi_mul_I]
    rw [geom_sum_eq hz1, hzm, sub_self, zero_div]

/-- `∑_{e ∣ m} μ(e) = 1_{m = 1}`. -/
lemma sum_moebius_divisors (m : ℕ) : ∑ e ∈ m.divisors, (μ e : ℤ) = if m = 1 then 1 else 0 := by
  have h := congrArg (fun f : ArithmeticFunction ℤ => f m)
    (ArithmeticFunction.coe_moebius_mul_coe_zeta (R := ℤ))
  rw [ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.one_apply] at h
  simpa using h

/-- Möbius inversion over `gcd(a, q)`. -/
lemma sum_coprime_eq (q : ℕ) (hq : 0 < q) (f : ℕ → ℂ) :
    ∑ a ∈ (range q).filter (fun a => Nat.Coprime a q), f a =
      ∑ e ∈ q.divisors, (μ e : ℂ) * ∑ a ∈ (range q).filter (fun a => e ∣ a), f a := by
  have key : ∀ a : ℕ, (if Nat.Coprime a q then f a else 0) =
      ∑ e ∈ q.divisors, if e ∣ a then (μ e : ℂ) * f a else 0 := by
    intro a
    have hdiv : (Nat.gcd a q).divisors = q.divisors.filter (fun e => e ∣ a) := by
      ext e
      simp only [Nat.mem_divisors, Finset.mem_filter, Nat.dvd_gcd_iff]
      constructor
      · rintro ⟨⟨h1, h2⟩, -⟩; exact ⟨⟨h2, hq.ne'⟩, h1⟩
      · rintro ⟨⟨h2, -⟩, h1⟩; exact ⟨⟨h1, h2⟩, (Nat.gcd_pos_of_pos_right _ hq).ne'⟩
    have hmu := sum_moebius_divisors (Nat.gcd a q)
    rw [hdiv, Finset.sum_filter] at hmu
    rw [← Finset.sum_filter, ← Finset.sum_mul]
    have hmu' : ∑ e ∈ q.divisors.filter (fun e => e ∣ a), (μ e : ℂ) =
        if Nat.gcd a q = 1 then 1 else 0 := by
      rw [Finset.sum_filter]
      exact_mod_cast hmu
    rw [hmu']
    unfold Nat.Coprime
    split_ifs <;> simp
  rw [Finset.sum_filter]
  simp_rw [key]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun e _ => ?_
  rw [Finset.sum_filter, Finset.mul_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  split_ifs <;> simp

/-- Reindexing the multiples of `e` in `[0, q)`. -/
lemma sum_range_dvd (q e : ℕ) (he : e ∣ q) (hq : 0 < q) (n : ℤ) :
    ∑ a ∈ (range q).filter (fun a => e ∣ a), ee ((a : ℝ) * n / q) =
      ∑ b ∈ range (q / e), ee ((b : ℝ) * n / ((q / e : ℕ) : ℝ)) := by
  have he0 : 0 < e := Nat.pos_of_dvd_of_pos he hq
  symm
  refine Finset.sum_nbij' (fun b => e * b) (fun a => a / e) ?_ ?_ ?_ ?_ ?_
  · intro b hb
    rw [Finset.mem_range] at hb
    rw [Finset.mem_filter, Finset.mem_range]
    refine ⟨?_, dvd_mul_right _ _⟩
    calc e * b < e * (q / e) := Nat.mul_lt_mul_of_pos_left hb he0
      _ = q := Nat.mul_div_cancel' he
  · intro a ha
    rw [Finset.mem_filter, Finset.mem_range] at ha
    rw [Finset.mem_range]
    exact Nat.div_lt_div_of_lt_of_dvd he ha.1
  · intro b _
    exact Nat.mul_div_cancel_left b he0
  · intro a ha
    rw [Finset.mem_filter] at ha
    exact Nat.mul_div_cancel' ha.2
  · intro b _
    congr 1
    have hq' : ((q / e : ℕ) : ℝ) = (q : ℝ) / e := Nat.cast_div he (by exact_mod_cast he0.ne')
    rw [hq']
    have : (e : ℝ) ≠ 0 := by exact_mod_cast he0.ne'
    have : (q : ℝ) ≠ 0 := by exact_mod_cast hq.ne'
    push_cast
    field_simp

/-- **Kluyver's identity** in product form: for `q = ∏_{p∈U} p`,
`∏_{p ∈ U} c_p(n) = ∑_{0 ≤ a < q, (a,q)=1} e(an/q)`. -/
theorem cT_eq_sum_ee {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) (n : ℤ) :
    ((cT U n : ℝ) : ℂ) = ∑ a ∈ (range (qU U)).filter (fun a => Nat.Coprime a (qU U)),
      ee ((a : ℝ) * n / (qU U : ℝ)) := by
  have hq := qU_pos hU
  set q := qU U with hqdef
  rw [cT_eq_ram hU, ram_apply, sum_coprime_eq q hq]
  simp only [Int.cast_sum, Int.cast_mul, Complex.ofReal_sum, Complex.ofReal_mul,
    Complex.ofReal_intCast]
  refine Finset.sum_congr rfl fun e he => ?_
  have he' : e ∣ q := Nat.dvd_of_mem_divisors he
  have hqe : 0 < q / e := Nat.div_pos (Nat.le_of_dvd hq he') (Nat.pos_of_dvd_of_pos he' hq)
  rw [sum_range_dvd q e he' hq n, sum_range_ee (q / e) hqe n, dvdInd_apply]
  split_ifs
  · rw [Int.cast_natCast]; ring
  · simp

/- ### Exponential sums over intervals -/

lemma ee_add (a b : ℝ) : ee (a + b) = ee a * ee b := by
  unfold ee
  rw [← Complex.exp_add]; congr 1; push_cast; ring

/-- Reindexing an integer interval by `Icc 1 T`. -/
lemma sum_Ico_int_eq {M : Type*} [AddCommMonoid M] (k₁ k₂ : ℤ) (f : ℤ → M) :
    ∑ k ∈ Finset.Ico k₁ k₂, f k = ∑ t ∈ Finset.Icc 1 (k₂ - k₁).toNat, f (k₁ - 1 + t) := by
  symm
  refine Finset.sum_nbij' (fun t : ℕ => k₁ - 1 + t) (fun k => (k - k₁ + 1).toNat) ?_ ?_ ?_ ?_ ?_
  · intro t ht
    rw [Finset.mem_Icc] at ht
    rw [Finset.mem_Ico]
    omega
  · intro k hk
    rw [Finset.mem_Ico] at hk
    rw [Finset.mem_Icc]
    omega
  · intro t ht
    rw [Finset.mem_Icc] at ht
    omega
  · intro k hk
    rw [Finset.mem_Ico] at hk
    omega
  · intro t _; rfl

lemma card_Ico_int (k₁ k₂ : ℤ) : (Finset.Ico k₁ k₂).card = (k₂ - k₁).toNat := Int.card_Ico k₁ k₂

/-- `|∑_{k ∈ [k₁,k₂)} e(βk)| · 2‖β‖ ≤ 1`. -/
lemma norm_sum_Ico_ee_mul_dnear_le (k₁ k₂ : ℤ) (β : ℝ) :
    ‖∑ k ∈ Finset.Ico k₁ k₂, ee (β * k)‖ * (2 * dnear β) ≤ 1 := by
  rw [sum_Ico_int_eq]
  have h : ∀ t : ℕ, ee (β * ((k₁ - 1 + (t : ℤ) : ℤ) : ℝ)) = ee (β * (k₁ - 1 : ℤ)) * ee (β * t) := by
    intro t
    rw [← ee_add]; congr 1; push_cast; ring
  simp_rw [h]
  rw [← Finset.mul_sum, norm_mul, norm_ee, one_mul]
  exact norm_sum_ee_mul_dnear_le _ β

lemma norm_sum_Ico_ee_le_card (k₁ k₂ : ℤ) (β : ℝ) :
    ‖∑ k ∈ Finset.Ico k₁ k₂, ee (β * k)‖ ≤ (Finset.Ico k₁ k₂).card := by
  calc ‖∑ k ∈ Finset.Ico k₁ k₂, ee (β * k)‖ ≤ ∑ k ∈ Finset.Ico k₁ k₂, ‖ee (β * k)‖ :=
        norm_sum_le _ _
    _ = (Finset.Ico k₁ k₂).card := by simp [norm_ee]

/-- If `‖β‖ ≥ δ > 0` then `|∑_{k ∈ [k₁,k₂)} e(βk)| ≤ 1/(2δ)`. -/
lemma norm_sum_Ico_ee_le_of_dnear (k₁ k₂ : ℤ) {β δ : ℝ} (hδ : 0 < δ) (h : δ ≤ dnear β) :
    ‖∑ k ∈ Finset.Ico k₁ k₂, ee (β * k)‖ ≤ 1 / (2 * δ) := by
  have h1 := norm_sum_Ico_ee_mul_dnear_le k₁ k₂ β
  rw [le_div_iff₀ (by positivity)]
  calc ‖∑ k ∈ Finset.Ico k₁ k₂, ee (β * k)‖ * (2 * δ)
      ≤ ‖∑ k ∈ Finset.Ico k₁ k₂, ee (β * k)‖ * (2 * dnear β) := by gcongr
    _ ≤ 1 := h1

/- ### Distance to the nearest integer -/

lemma dnear_add_int (x : ℝ) (m : ℤ) : dnear (x + m) = dnear x := by
  unfold dnear
  rw [round_add_intCast]; push_cast; ring_nf

lemma dnear_sub_le (x y : ℝ) : dnear (x - y) ≤ dnear x + dnear y := by
  calc dnear (x - y) ≤ |x - y - ((round x - round y : ℤ) : ℝ)| := dnear_le _ _
    _ = |(x - round x) - (y - round y)| := by push_cast; ring_nf
    _ ≤ |x - round x| + |y - round y| := abs_sub _ _
    _ = dnear x + dnear y := rfl

/-- A fraction `N/L` with `L ∤ N` is at distance `≥ 1/L` from the integers. -/
lemma one_div_le_dnear {N : ℤ} {L : ℕ} (hL : 0 < L) (h : ¬ (L : ℤ) ∣ N) :
    1 / (L : ℝ) ≤ dnear ((N : ℝ) / L) := by
  have hLR : (0 : ℝ) < L := by exact_mod_cast hL
  unfold dnear
  set r : ℤ := round ((N : ℝ) / L)
  have hne : N - r * L ≠ 0 := by
    intro h0
    apply h
    exact ⟨r, by linarith⟩
  have h1 : (1 : ℝ) ≤ |((N - r * L : ℤ) : ℝ)| := by
    have : (1 : ℤ) ≤ |N - r * L| := Int.one_le_abs hne
    exact_mod_cast this
  have h2 : (N : ℝ) / L - r = ((N - r * L : ℤ) : ℝ) / L := by
    push_cast; field_simp
  rw [h2, abs_div, abs_of_pos hLR]
  exact div_le_div_of_nonneg_right h1 hLR.le

/-- Distinct reduced fractions `a/q`, `a'/q'` are `1/(qq')`-separated modulo 1. -/
lemma frac_eq_of_dnear_lt {a a' q q' : ℕ} (hq : 0 < q) (hq' : 0 < q') (ha : a < q) (ha' : a' < q')
    (hc : Nat.Coprime a q) (hc' : Nat.Coprime a' q')
    (h : dnear ((a : ℝ) / q - (a' : ℝ) / q') < 1 / ((q : ℝ) * q')) : q = q' ∧ a = a' := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hq'R : (0 : ℝ) < q' := by exact_mod_cast hq'
  set N : ℤ := (a : ℤ) * q' - (a' : ℤ) * q with hN
  have hfrac : (a : ℝ) / q - (a' : ℝ) / q' = (N : ℝ) / ((q * q' : ℕ) : ℝ) := by
    rw [hN]; push_cast; field_simp
  rw [hfrac] at h
  have hdvd : ((q * q' : ℕ) : ℤ) ∣ N := by
    by_contra hnd
    have := one_div_le_dnear (Nat.mul_pos hq hq') hnd
    push_cast at this h
    linarith
  push_cast at hdvd
  -- `q ∣ a q'` and `q' ∣ a' q`
  have h1 : (q : ℤ) ∣ (a : ℤ) * q' := by
    have : (q : ℤ) ∣ N := dvd_trans (dvd_mul_right _ _) hdvd
    have h2 : (q : ℤ) ∣ (a' : ℤ) * q := dvd_mul_left _ _
    have := dvd_add this h2
    rwa [hN, sub_add_cancel] at this
  have h1' : (q' : ℤ) ∣ (a' : ℤ) * q := by
    have : (q' : ℤ) ∣ N := dvd_trans (dvd_mul_left _ _) hdvd
    have h2 : (q' : ℤ) ∣ (a : ℤ) * q' := dvd_mul_left _ _
    have := dvd_sub h2 this
    rwa [hN, sub_sub_cancel] at this
  have hqq' : q ∣ q' := by
    have : q ∣ a * q' := by exact_mod_cast h1
    exact (Nat.Coprime.symm hc).dvd_of_dvd_mul_left this
  have hq'q : q' ∣ q := by
    have : q' ∣ a' * q := by exact_mod_cast h1'
    exact (Nat.Coprime.symm hc').dvd_of_dvd_mul_left this
  have heq : q = q' := Nat.dvd_antisymm hqq' hq'q
  refine ⟨heq, ?_⟩
  subst heq
  -- now `q^2 ∣ (a - a') q`, so `q ∣ a - a'`
  have h3 : (q : ℤ) * q ∣ ((a : ℤ) - a') * q := by
    have : N = ((a : ℤ) - a') * q := by rw [hN]; ring
    rwa [this] at hdvd
  have h4 : (q : ℤ) ∣ (a : ℤ) - a' :=
    Int.dvd_of_mul_dvd_mul_right (by exact_mod_cast hq.ne') h3
  have h5 : (a : ℤ) - a' = 0 := by
    apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs h4
    rw [Int.natAbs_natCast]
    omega
  omega

/- ### Ramanujan expansions -/

/-- A Ramanujan expansion `∑_{U∈B} C_U c_{q_U}(n)`. -/
noncomputable def ramExp (B : Finset (Finset ℕ)) (C : Finset ℕ → ℝ) (n : ℤ) : ℝ :=
  ∑ U ∈ B, C U * cT U n

/-- Reduced residues modulo `q_U`. -/
def resid (U : Finset ℕ) : Finset ℕ := (range (qU U)).filter (fun a => Nat.Coprime a (qU U))

lemma card_resid_le (U : Finset ℕ) : (resid U).card ≤ qU U := by
  unfold resid
  exact (Finset.card_filter_le _ _).trans (Finset.card_range _).le

lemma qU_inj {U U' : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) (hU' : ∀ p ∈ U', p.Prime)
    (h : qU U = qU U') : U = U' := by
  rw [← Nat.primeFactors_prod hU, ← Nat.primeFactors_prod hU']
  unfold qU at h
  rw [h]

lemma qU_dvd_iff {V : Finset ℕ} (hV : ∀ p ∈ V, p.Prime) (n : ℤ) :
    ((qU V : ℕ) : ℤ) ∣ n ↔ ∀ p ∈ V, (p : ℤ) ∣ n := by
  constructor
  · intro h p hp
    exact dvd_trans (Int.natCast_dvd_natCast.mpr (Finset.dvd_prod_of_mem _ hp)) h
  · intro h
    rw [Int.natCast_dvd]
    exact Finset.prod_primes_dvd _ (fun p hp => (hV p hp).prime)
      fun p hp => Int.natCast_dvd.mp (h p hp)

lemma cT_eq_sum_resid {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) (n : ℤ) :
    ((cT U n : ℝ) : ℂ) = ∑ a ∈ resid U, ee ((a : ℝ) * n / (qU U : ℝ)) :=
  cT_eq_sum_ee hU n

/-- Exponential sum over an integer interval. -/
noncomputable def expSum (k₁ k₂ : ℤ) (β : ℝ) : ℂ := ∑ x ∈ Ico k₁ k₂, ee (β * x)

lemma sum_ramExp_ee (B : Finset (Finset ℕ)) (hB : ∀ U ∈ B, ∀ p ∈ U, p.Prime)
    (C : Finset ℕ → ℝ) (k₁ k₂ : ℤ) (θ : ℝ) :
    ∑ x ∈ Ico k₁ k₂, ((ramExp B C x : ℝ) : ℂ) * ee (θ * x) =
      ∑ U ∈ B, (C U : ℂ) * ∑ a ∈ resid U, expSum k₁ k₂ (θ + a / qU U) := by
  unfold ramExp expSum
  simp_rw [Complex.ofReal_sum, Complex.ofReal_mul, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun U hU => ?_
  simp_rw [mul_assoc, ← Finset.mul_sum]
  congr 1
  simp_rw [cT_eq_sum_resid (hB U hU), Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun x _ => ?_
  rw [← ee_add]; congr 1; ring

/-- **Fourier bound for Ramanujan expansions.** If all moduli are `≤ M` and the coefficients are
bounded by `Cmax`, then `|∑_{x∈[k₁,k₂)} f(x) e(θx)| ≤ (k₂-k₁) Cmax + M² ∑_U |C_U| q_U`
(at most one fraction `a/q` can be `1/(2M²)`-close to `-θ`). -/
theorem norm_fourier_ramExp_le (B : Finset (Finset ℕ)) (hB : ∀ U ∈ B, ∀ p ∈ U, p.Prime)
    (M : ℕ) (hM1 : 1 ≤ M) (hM : ∀ U ∈ B, qU U ≤ M) (C : Finset ℕ → ℝ) (Cmax : ℝ) (hC0 : 0 ≤ Cmax)
    (hCmax : ∀ U ∈ B, |C U| ≤ Cmax) (k₁ k₂ : ℤ) (θ : ℝ) :
    ‖∑ x ∈ Ico k₁ k₂, ((ramExp B C x : ℝ) : ℂ) * ee (θ * x)‖ ≤
      (Ico k₁ k₂).card * Cmax + (M : ℝ) ^ 2 * ∑ U ∈ B, |C U| * qU U := by
  rw [sum_ramExp_ee B hB C k₁ k₂ θ]
  have hMR : (1 : ℝ) ≤ M := by exact_mod_cast hM1
  set g : (Σ _ : Finset ℕ, ℕ) → ℝ :=
    fun s => |C s.1| * ‖expSum k₁ k₂ (θ + s.2 / qU s.1)‖ with hg
  set F := B.sigma resid with hF
  have h1 : ‖∑ U ∈ B, (C U : ℂ) * ∑ a ∈ resid U, expSum k₁ k₂ (θ + a / qU U)‖ ≤
      ∑ s ∈ F, g s := by
    rw [hF, Finset.sum_sigma]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun U _ => ?_)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc |C U| * ‖∑ a ∈ resid U, expSum k₁ k₂ (θ + a / qU U)‖
        ≤ |C U| * ∑ a ∈ resid U, ‖expSum k₁ k₂ (θ + a / qU U)‖ :=
          mul_le_mul_of_nonneg_left (norm_sum_le _ _) (abs_nonneg _)
      _ = ∑ a ∈ resid U, g ⟨U, a⟩ := by rw [Finset.mul_sum]
  refine h1.trans ?_
  set δ : ℝ := 1 / (2 * (M : ℝ) ^ 2) with hδ
  have hδpos : 0 < δ := by positivity
  set near : (Σ _ : Finset ℕ, ℕ) → Prop := fun s => dnear (θ + s.2 / qU s.1) < δ with hnear
  rw [← Finset.sum_filter_add_sum_filter_not F near]
  -- at most one near fraction
  have hcard : (F.filter near).card ≤ 1 := by
    rw [Finset.card_le_one]
    rintro ⟨U, a⟩ hs ⟨U', a'⟩ ht
    rw [Finset.mem_filter, hF, Finset.mem_sigma] at hs ht
    obtain ⟨⟨hU, ha⟩, hsn⟩ := hs
    obtain ⟨⟨hU', ha'⟩, htn⟩ := ht
    simp only [hnear] at hsn htn
    unfold resid at ha ha'
    rw [Finset.mem_filter, Finset.mem_range] at ha ha'
    have hq := qU_pos (hB U hU)
    have hq' := qU_pos (hB U' hU')
    have hqR : (qU U : ℝ) ≤ M := by exact_mod_cast hM U hU
    have hq'R : (qU U' : ℝ) ≤ M := by exact_mod_cast hM U' hU'
    have hd : dnear ((a : ℝ) / qU U - (a' : ℝ) / qU U') < 1 / ((qU U : ℝ) * qU U') := by
      have e : (a : ℝ) / qU U - (a' : ℝ) / qU U' =
          (θ + (a : ℝ) / qU U) - (θ + (a' : ℝ) / qU U') := by ring
      rw [e]
      calc dnear ((θ + (a : ℝ) / qU U) - (θ + (a' : ℝ) / qU U'))
          ≤ dnear (θ + (a : ℝ) / qU U) + dnear (θ + (a' : ℝ) / qU U') := dnear_sub_le _ _
        _ < δ + δ := add_lt_add hsn htn
        _ = 1 / ((M : ℝ) * M) := by rw [hδ]; field_simp; ring
        _ ≤ 1 / ((qU U : ℝ) * qU U') := by
            apply one_div_le_one_div_of_le
            · have : (0 : ℝ) < qU U := by exact_mod_cast hq
              have : (0 : ℝ) < qU U' := by exact_mod_cast hq'
              positivity
            · exact mul_le_mul hqR hq'R (by positivity) (by positivity)
    obtain ⟨hqq, haa⟩ := frac_eq_of_dnear_lt hq hq' ha.1 ha'.1 ha.2 ha'.2 hd
    have hUU : U = U' := qU_inj (hB U hU) (hB U' hU') hqq
    subst hUU; subst haa; rfl
  have hnearb : ∀ s ∈ F.filter near, g s ≤ (Ico k₁ k₂).card * Cmax := by
    rintro ⟨U, a⟩ hs
    rw [Finset.mem_filter, hF, Finset.mem_sigma] at hs
    simp only [hg]
    rw [mul_comm]
    exact mul_le_mul (norm_sum_Ico_ee_le_card _ _ _) (hCmax U hs.1.1) (abs_nonneg _)
      (by positivity)
  have hfarb : ∀ s ∈ F.filter (fun s => ¬ near s), g s ≤ |C s.1| * (M : ℝ) ^ 2 := by
    rintro ⟨U, a⟩ hs
    rw [Finset.mem_filter] at hs
    simp only [hg]
    apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
    have hle : δ ≤ dnear (θ + (a : ℝ) / qU U) := le_of_not_gt hs.2
    have := norm_sum_Ico_ee_le_of_dnear k₁ k₂ hδpos hle
    unfold expSum
    calc ‖∑ x ∈ Ico k₁ k₂, ee ((θ + (a : ℝ) / qU U) * x)‖ ≤ 1 / (2 * δ) := this
      _ = (M : ℝ) ^ 2 := by rw [hδ]; field_simp
  have hsum_near : ∑ s ∈ F.filter near, g s ≤ (Ico k₁ k₂).card * Cmax := by
    calc ∑ s ∈ F.filter near, g s ≤ ∑ s ∈ F.filter near, ((Ico k₁ k₂).card * Cmax) :=
          Finset.sum_le_sum hnearb
      _ = (F.filter near).card * ((Ico k₁ k₂).card * Cmax) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ 1 * ((Ico k₁ k₂).card * Cmax) := by
          gcongr
          exact_mod_cast hcard
      _ = (Ico k₁ k₂).card * Cmax := one_mul _
  have hsum_far : ∑ s ∈ F.filter (fun s => ¬ near s), g s ≤
      (M : ℝ) ^ 2 * ∑ U ∈ B, |C U| * qU U := by
    calc ∑ s ∈ F.filter (fun s => ¬ near s), g s
        ≤ ∑ s ∈ F.filter (fun s => ¬ near s), |C s.1| * (M : ℝ) ^ 2 := Finset.sum_le_sum hfarb
      _ ≤ ∑ s ∈ F, |C s.1| * (M : ℝ) ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            fun s _ _ => by positivity
      _ = (M : ℝ) ^ 2 * ∑ U ∈ B, |C U| * (resid U).card := by
          rw [hF, Finset.sum_sigma, Finset.mul_sum]
          refine Finset.sum_congr rfl fun U _ => ?_
          dsimp only
          rw [Finset.sum_const, nsmul_eq_mul]; ring
      _ ≤ (M : ℝ) ^ 2 * ∑ U ∈ B, |C U| * qU U := by
          gcongr with U hU
          exact_mod_cast card_resid_le U
  linarith

/- ### Physical-space bounds and moments -/

/-- Pointwise bound: if `|C_U| ≤ ∏_{p∈U} A/p` and all `U ⊆ {p ≤ Y}` then
`|f(n)| ≤ ∏_{p ≤ Y}(1 + A/p) · ∏_{p ≤ Y, p ∣ n} (1 + A)`. -/
theorem abs_ramExp_le (Y : ℕ) (B : Finset (Finset ℕ)) (hB : ∀ U ∈ B, U ⊆ primesLE Y)
    (C : Finset ℕ → ℝ) (A : ℝ) (hA : 0 ≤ A) (hC : ∀ U ∈ B, |C U| ≤ ∏ p ∈ U, A / p) (n : ℤ) :
    |ramExp B C n| ≤ (∏ p ∈ primesLE Y, (1 + A / p)) *
      ∏ p ∈ primesLE Y, (if (p : ℤ) ∣ n then 1 + A else 1) := by
  set b : ℕ → ℝ := fun p => if (p : ℤ) ∣ n then (p : ℝ) else 1 with hb
  have hb0 : ∀ p, 0 ≤ b p := fun p => by simp only [hb]; split_ifs <;> positivity
  have hstep : ∀ U ∈ B, |C U * cT U n| ≤ ∏ p ∈ U, A / p * b p := by
    intro U hU
    rw [abs_mul, Finset.prod_mul_distrib]
    have hp1 : ∀ p ∈ U, 1 ≤ p := fun p hp => (mem_primesLE.mp (hB U hU hp)).1.one_lt.le
    apply mul_le_mul (hC U hU) _ (abs_nonneg _)
      (Finset.prod_nonneg fun p _ => by positivity)
    unfold cT; rw [Finset.abs_prod]
    exact Finset.prod_le_prod (fun p _ => abs_nonneg _) fun p hp => abs_cP_le p (hp1 p hp) n
  calc |ramExp B C n| ≤ ∑ U ∈ B, |C U * cT U n| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ U ∈ B, ∏ p ∈ U, A / p * b p := Finset.sum_le_sum hstep
    _ ≤ ∑ U ∈ (primesLE Y).powerset, ∏ p ∈ U, A / p * b p := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro U hU; exact Finset.mem_powerset.mpr (hB U hU)
        · intro U _ _
          exact Finset.prod_nonneg fun p _ => mul_nonneg (by positivity) (hb0 p)
    _ = ∏ p ∈ primesLE Y, (1 + A / p * b p) := (Finset.prod_one_add _).symm
    _ ≤ ∏ p ∈ primesLE Y, ((1 + A / p) * (if (p : ℤ) ∣ n then 1 + A else 1)) := by
        apply Finset.prod_le_prod
        · intro p _; have := hb0 p; positivity
        · intro p hp
          have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (mem_primesLE.mp hp).1.one_lt.le
          simp only [hb]
          split_ifs
          · rw [div_mul_cancel₀ _ (by positivity)]
            have : 0 ≤ A / p * (1 + A) := by positivity
            nlinarith
          · simp
    _ = _ := Finset.prod_mul_distrib

/-- **Moment bound.** Under the hypotheses of `abs_ramExp_le`, for a finite set `I` of integers
in which `q_V ∣ n` holds for at most `K |I| / q_V` elements (`V ⊆ {p ≤ Y}`),
`∑_{n∈I} |f(n)|^m ≤ K |I| ∏_{p≤Y}(1+A/p)^m ∏_{p≤Y}(1 + ((1+A)^m - 1)/p)`. -/
theorem sum_pow_abs_ramExp_le (Y : ℕ) (B : Finset (Finset ℕ)) (hB : ∀ U ∈ B, U ⊆ primesLE Y)
    (C : Finset ℕ → ℝ) (A : ℝ) (hA : 0 ≤ A) (hC : ∀ U ∈ B, |C U| ≤ ∏ p ∈ U, A / p)
    (I : Finset ℤ) (K : ℝ)
    (hI : ∀ V ⊆ primesLE Y,
      ((I.filter (fun n => ((qU V : ℕ) : ℤ) ∣ n)).card : ℝ) ≤ K * I.card / qU V)
    (m : ℕ) :
    ∑ n ∈ I, |ramExp B C n| ^ m ≤
      K * I.card * (∏ p ∈ primesLE Y, (1 + A / p)) ^ m *
        ∏ p ∈ primesLE Y, (1 + ((1 + A) ^ m - 1) / p) := by
  set P := primesLE Y with hP
  set Pi : ℝ := ∏ p ∈ P, (1 + A / (p : ℝ)) with hPi
  set β : ℝ := (1 + A) ^ m - 1 with hβ
  have hβ0 : 0 ≤ β := by
    have : 1 ≤ (1 + A) ^ m := one_le_pow₀ (by linarith)
    linarith
  have hPi0 : 0 ≤ Pi := Finset.prod_nonneg fun p _ => by positivity
  have hpt : ∀ n, |ramExp B C n| ^ m ≤
      Pi ^ m * ∑ V ∈ P.powerset, β ^ V.card * (if ((qU V : ℕ) : ℤ) ∣ n then 1 else 0) := by
    intro n
    have h1 := abs_ramExp_le Y B hB C A hA hC n
    calc |ramExp B C n| ^ m
        ≤ (Pi * ∏ p ∈ P, (if (p : ℤ) ∣ n then 1 + A else 1)) ^ m :=
          pow_le_pow_left₀ (abs_nonneg _) h1 m
      _ = Pi ^ m * ∏ p ∈ P, (1 + β * (if (p : ℤ) ∣ n then 1 else 0)) := by
          rw [mul_pow]
          congr 1
          rw [← Finset.prod_pow]
          refine Finset.prod_congr rfl fun p _ => ?_
          split_ifs
          · rw [hβ]; ring
          · simp
      _ = Pi ^ m * ∑ V ∈ P.powerset, ∏ p ∈ V, (β * (if (p : ℤ) ∣ n then 1 else 0)) := by
          rw [Finset.prod_one_add]
      _ = Pi ^ m * ∑ V ∈ P.powerset, β ^ V.card * (if ((qU V : ℕ) : ℤ) ∣ n then 1 else 0) := by
          congr 1
          refine Finset.sum_congr rfl fun V hV => ?_
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_boole]
          have hVp : ∀ p ∈ V, p.Prime :=
            fun p hp => (mem_primesLE.mp (Finset.mem_powerset.mp hV hp)).1
          have hiff := qU_dvd_iff hVp n
          by_cases h : ∀ p ∈ V, (p : ℤ) ∣ n
          · rw [if_pos h, if_pos (hiff.mpr h)]
          · rw [if_neg h, if_neg (fun h' => h (hiff.mp h'))]
  calc ∑ n ∈ I, |ramExp B C n| ^ m
      ≤ ∑ n ∈ I, Pi ^ m * ∑ V ∈ P.powerset,
          β ^ V.card * (if ((qU V : ℕ) : ℤ) ∣ n then 1 else 0) :=
        Finset.sum_le_sum fun n _ => hpt n
    _ = Pi ^ m * ∑ V ∈ P.powerset,
          β ^ V.card * ((I.filter (fun n => ((qU V : ℕ) : ℤ) ∣ n)).card : ℝ) := by
        rw [← Finset.mul_sum, Finset.sum_comm]
        congr 1
        refine Finset.sum_congr rfl fun V _ => ?_
        rw [← Finset.mul_sum, Finset.sum_boole]
    _ ≤ Pi ^ m * ∑ V ∈ P.powerset, β ^ V.card * (K * I.card / qU V) := by
        gcongr with V hV
        exact hI V (Finset.mem_powerset.mp hV)
    _ = Pi ^ m * (K * I.card) * ∑ V ∈ P.powerset, ∏ p ∈ V, β / p := by
        rw [mul_assoc]
        congr 1
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun V _ => ?_
        unfold qU
        push_cast
        rw [Finset.prod_div_distrib, Finset.prod_const]
        ring
    _ = K * I.card * Pi ^ m * ∏ p ∈ P, (1 + β / p) := by
        rw [← Finset.prod_one_add]; ring

/- ### Counting multiples in intervals -/

lemma card_filter_dvd_Ico_le (a b : ℤ) (d : ℕ) (hd : 0 < d) :
    (((Ico a b).filter (fun n => (d : ℤ) ∣ n)).card : ℝ) ≤ max (((b : ℝ) - a) / d + 1) 0 := by
  have hdZ : (0 : ℤ) < d := by exact_mod_cast hd
  have h := Int.Ico_filter_dvd_card a b hdZ
  simp only [Int.cast_natCast] at h
  set c : ℤ := ⌈(b : ℚ) / (d : ℚ)⌉ - ⌈(a : ℚ) / (d : ℚ)⌉ with hc
  have hc1 : ((⌈(b : ℚ) / (d : ℚ)⌉ : ℤ) : ℚ) < (b : ℚ) / (d : ℚ) + 1 := Int.ceil_lt_add_one _
  have hc2 : (a : ℚ) / (d : ℚ) ≤ ((⌈(a : ℚ) / (d : ℚ)⌉ : ℤ) : ℚ) := Int.le_ceil _
  have hcQ : (c : ℚ) < ((b : ℚ) - a) / d + 1 := by
    rw [hc]; push_cast; rw [sub_div]; linarith
  have hcR : (c : ℝ) < ((b : ℝ) - a) / d + 1 := by
    have := (Rat.cast_lt (K := ℝ)).mpr hcQ
    push_cast at this
    exact this
  have hcard : (((Ico a b).filter (fun n => (d : ℤ) ∣ n)).card : ℝ) = max (c : ℝ) 0 := by
    have := congrArg (fun z : ℤ => (z : ℝ)) h
    simp only [Int.cast_natCast, Int.cast_max, Int.cast_zero] at this
    exact this
  rw [hcard]
  exact max_le_max hcR.le le_rfl

/-- In `[X, 2X)` at most `3X/d` integers are divisible by `d`. -/
lemma card_filter_dvd_dyadic (X d : ℕ) (hX : 1 ≤ X) (hd : 0 < d) :
    (((Ico (X : ℤ) (2 * X)).filter (fun n => (d : ℤ) ∣ n)).card : ℝ) ≤ 3 * X / d := by
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hXR : (1 : ℝ) ≤ X := by exact_mod_cast hX
  by_cases hbig : 2 * X ≤ d
  · have hempty : (Ico (X : ℤ) (2 * X)).filter (fun n => (d : ℤ) ∣ n) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro n hn hdn
      rw [Finset.mem_Ico] at hn
      have hn0 : 0 < n := by omega
      have := Int.le_of_dvd hn0 hdn
      have : (d : ℤ) ≥ 2 * X := by exact_mod_cast hbig
      omega
    rw [hempty, Finset.card_empty, Nat.cast_zero]
    positivity
  · rw [not_le] at hbig
    have hdle : (d : ℝ) ≤ 2 * X := by exact_mod_cast hbig.le
    refine (card_filter_dvd_Ico_le _ _ d hd).trans ?_
    apply max_le
    · push_cast
      rw [show (2 * (X : ℝ) - X) = X by ring]
      rw [div_add_one hdR.ne', div_le_div_iff_of_pos_right hdR]
      linarith
    · positivity

/-- In an interval of length `L` with `d ∣ L`, exactly `L/d` integers are divisible by `d`. -/
lemma card_filter_dvd_period (a : ℤ) (L d : ℕ) (hd : 0 < d) (hdL : d ∣ L) :
    (((Ico a (a + L)).filter (fun n => (d : ℤ) ∣ n)).card : ℝ) = L / d := by
  have hdZ : (0 : ℤ) < d := by exact_mod_cast hd
  have h := Int.Ico_filter_dvd_card a (a + L) hdZ
  obtain ⟨k, hk⟩ := hdL
  have hdQ : ((d : ℤ) : ℚ) ≠ 0 := by exact_mod_cast hd.ne'
  have e : ((a + L : ℤ) : ℚ) / ((d : ℤ) : ℚ) = (a : ℚ) / ((d : ℤ) : ℚ) + (k : ℕ) := by
    rw [hk]; push_cast; field_simp
  rw [e, Int.ceil_add_natCast, add_sub_cancel_left] at h
  have hk0 : max (k : ℤ) 0 = k := max_eq_left (by positivity)
  rw [hk0] at h
  have hcard : ((Ico a (a + L)).filter (fun n => (d : ℤ) ∣ n)).card = k := by exact_mod_cast h
  rw [hcard, hk]
  have hdR : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  push_cast
  field_simp

/- ### Mertens-type product bound -/

/-- The constant in `∑_{p ≤ Y} 1/p ≤ log log Y + cMert` (Mertens' second theorem, proved
elementarily in `MertensLower.lean`: `cMert = MertensProof.cUp = 3 - log log 2`). -/
noncomputable def cMert : ℝ := MertensProof.cUp

lemma sum_inv_primesLE_le (Y : ℕ) (hY : 2 ≤ Y) :
    ∑ p ∈ primesLE Y, (1 : ℝ) / p ≤ Real.log (Real.log Y) + cMert := by
  have h1 : ∑ p ∈ primesLE Y, (1 : ℝ) / p = ∑ p ∈ Ioc 0 Y with p.Prime, (1 : ℝ) / p := rfl
  rw [h1]
  unfold cMert
  exact MertensProof.sum_inv_primesLE_le' Y hY

/-- `∏_{p ≤ Y} (1 + a/p) ≤ e^{a cMert} (log Y)^a`. -/
lemma prod_one_add_div_le (a : ℕ) (Y : ℕ) (hY : 2 ≤ Y) :
    ∏ p ∈ primesLE Y, (1 + (a : ℝ) / p) ≤ Real.exp (a * cMert) * Real.log Y ^ a := by
  have hlog : 0 < Real.log Y := Real.log_pos (by exact_mod_cast (by omega : 1 < Y))
  calc ∏ p ∈ primesLE Y, (1 + (a : ℝ) / p) ≤ Real.exp (∑ p ∈ primesLE Y, (a : ℝ) / p) :=
        Real.prod_one_add_le_exp_sum _ (fun p => by positivity)
    _ = Real.exp (a * ∑ p ∈ primesLE Y, (1 : ℝ) / p) := by
        rw [Finset.mul_sum]; congr 1
        refine Finset.sum_congr rfl fun p _ => ?_
        ring
    _ ≤ Real.exp (a * (Real.log (Real.log Y) + cMert)) := by
        gcongr; exact sum_inv_primesLE_le Y hY
    _ = Real.exp (a * cMert) * Real.log Y ^ a := by
        rw [mul_add, Real.exp_add, Real.exp_nat_mul, Real.exp_log hlog, mul_comm]

/- ### Divisor-type bound and logarithms versus powers -/

lemma pow_card_le_qU (A : ℕ) (hA : 1 ≤ A) (U : Finset ℕ) (hU : ∀ p ∈ U, 1 ≤ p) :
    (A ^ 4) ^ U.card ≤ (A ^ 4) ^ (A ^ 4) * qU U := by
  classical
  set s := U.filter (fun p => p < A ^ 4) with hs_def
  set t := U.filter (fun p => ¬ p < A ^ 4) with ht_def
  have hs : s.card ≤ A ^ 4 := by
    calc s.card ≤ (range (A ^ 4)).card :=
          Finset.card_le_card fun p hp => Finset.mem_range.mpr (Finset.mem_filter.mp hp).2
      _ = A ^ 4 := Finset.card_range _
  calc (A ^ 4) ^ U.card = ∏ p ∈ U, A ^ 4 := (Finset.prod_const _).symm
    _ = (∏ p ∈ s, A ^ 4) * ∏ p ∈ t, A ^ 4 := (Finset.prod_filter_mul_prod_filter_not _ _ _).symm
    _ ≤ (∏ p ∈ s, A ^ 4 * p) * ∏ p ∈ t, p := by
        apply Nat.mul_le_mul
        · exact Finset.prod_le_prod' fun p hp =>
            Nat.le_mul_of_pos_right _ (hU p (Finset.mem_filter.mp hp).1)
        · exact Finset.prod_le_prod' fun p hp => le_of_not_gt (Finset.mem_filter.mp hp).2
    _ = (A ^ 4) ^ s.card * ((∏ p ∈ s, p) * ∏ p ∈ t, p) := by
        rw [Finset.prod_mul_distrib, Finset.prod_const]; ring
    _ = (A ^ 4) ^ s.card * qU U := by
        rw [hs_def, ht_def, Finset.prod_filter_mul_prod_filter_not]; rfl
    _ ≤ (A ^ 4) ^ (A ^ 4) * qU U :=
        Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by positivity) hs)

/-- `A^{|U|} ≤ A^{A⁴} q_U^{1/4}` (the divisor bound for squarefree numbers). -/
lemma rpow_card_le (A : ℕ) (hA : 1 ≤ A) (U : Finset ℕ) (hU : ∀ p ∈ U, 1 ≤ p) :
    (A : ℝ) ^ U.card ≤ (A : ℝ) ^ (A ^ 4) * (qU U : ℝ) ^ ((1 : ℝ) / 4) := by
  have h := pow_card_le_qU A hA U hU
  have h' : ((A : ℝ) ^ U.card) ^ 4 ≤ ((A : ℝ) ^ (A ^ 4)) ^ 4 * qU U := by
    calc ((A : ℝ) ^ U.card) ^ 4 = (((A ^ 4) ^ U.card : ℕ) : ℝ) := by push_cast; ring
      _ ≤ (((A ^ 4) ^ (A ^ 4) * qU U : ℕ) : ℝ) := by exact_mod_cast h
      _ = ((A : ℝ) ^ (A ^ 4)) ^ 4 * qU U := by push_cast; ring
  have h0 : 0 ≤ (A : ℝ) ^ U.card := by positivity
  calc (A : ℝ) ^ U.card = (((A : ℝ) ^ U.card) ^ 4) ^ ((1 : ℝ) / 4) := by
        rw [← Real.rpow_natCast (((A : ℝ) ^ U.card)) 4, ← Real.rpow_mul h0]; norm_num
    _ ≤ (((A : ℝ) ^ (A ^ 4)) ^ 4 * qU U) ^ ((1 : ℝ) / 4) :=
        Real.rpow_le_rpow (by positivity) h' (by norm_num)
    _ = (A : ℝ) ^ (A ^ 4) * (qU U : ℝ) ^ ((1 : ℝ) / 4) := by
        rw [Real.mul_rpow (by positivity) (by positivity)]
        congr 1
        rw [← Real.rpow_natCast (((A : ℝ) ^ (A ^ 4))) 4, ← Real.rpow_mul (by positivity)]
        norm_num

/-- `(log x)^k ≤ (k/ε)^k x^ε` for `x ≥ 1`. -/
lemma log_pow_le (x : ℝ) (hx : 1 ≤ x) (k : ℕ) (ε : ℝ) (hε : 0 < ε) :
    Real.log x ^ k ≤ ((k : ℝ) / ε) ^ k * x ^ ε := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; simp only [pow_zero, one_mul]; exact Real.one_le_rpow hx hε.le
  have hk' : (0 : ℝ) < k := by exact_mod_cast hk
  have hlog0 : 0 ≤ Real.log x := Real.log_nonneg hx
  have hx0 : 0 < x := by linarith
  have h1 : Real.log x ≤ (k / ε) * x ^ (ε / k) := by
    have h2 : Real.log (x ^ (ε / k)) ≤ x ^ (ε / k) := by
      have := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx0 (ε / k)); linarith
    rw [Real.log_rpow hx0] at h2
    calc Real.log x = (k / ε) * (ε / k * Real.log x) := by field_simp
      _ ≤ (k / ε) * x ^ (ε / k) := by gcongr
  calc Real.log x ^ k ≤ ((k / ε) * x ^ (ε / k)) ^ k := pow_le_pow_left₀ hlog0 h1 k
    _ = (k / ε) ^ k * x ^ ε := by
        rw [mul_pow, ← Real.rpow_natCast (x ^ (ε / k)), ← Real.rpow_mul hx0.le]
        congr 2; field_simp

/- ### The Selberg majorant -/

/-- `𝒮_R`: the sets `T` of primes `≤ R` with `∏_{p∈T} p ≤ R` (= the squarefree `r ≤ R`). -/
def sieveSets (R : ℕ) : Finset (Finset ℕ) := (primesLE R).powerset.filter (fun T => qU T ≤ R)

lemma mem_sieveSets {R : ℕ} {T : Finset ℕ} : T ∈ sieveSets R ↔ T ⊆ primesLE R ∧ qU T ≤ R := by
  unfold sieveSets; rw [Finset.mem_filter, Finset.mem_powerset]

/-- `ν(T) = ∏_{p∈T} 1/(p-1) = 1/φ(q_T)`. -/
noncomputable def nuT (T : Finset ℕ) : ℝ := ∏ p ∈ T, 1 / ((p : ℝ) - 1)

/-- `G(R) = ∑_{r ≤ R} μ²(r)/φ(r)`. -/
noncomputable def Gsel (R : ℕ) : ℝ := ∑ T ∈ sieveSets R, nuT T

/-- `W(T) = μ(q_T)/φ(q_T)`. -/
noncomputable def WT (T : Finset ℕ) : ℝ := ∏ p ∈ T, (-1 / ((p : ℝ) - 1))

/-- `S(n) = ∑_{r ≤ R} (μ(r)/φ(r)) c_r(n)`. -/
noncomputable def Ssel (R : ℕ) (n : ℤ) : ℝ := ∑ T ∈ sieveSets R, WT T * cT T n

/-- **The Selberg majorant** `Λ̃_R(n) = S(n)²/G(R)`, i.e. `G(R) (∑_{d ∣ n} λ_d)²` with Selberg's
optimal weights, written through Ramanujan sums. -/
noncomputable def selbergMajorant (R : ℕ) (n : ℤ) : ℝ := Ssel R n ^ 2 / Gsel R

lemma prime_of_mem_primesLE {Y p : ℕ} (h : p ∈ primesLE Y) : p.Prime := (mem_primesLE.mp h).1

lemma two_le_of_mem_primesLE {Y p : ℕ} (h : p ∈ primesLE Y) : (2 : ℝ) ≤ p := by
  exact_mod_cast (prime_of_mem_primesLE h).two_le

lemma nuT_pos {Y : ℕ} {T : Finset ℕ} (hT : T ⊆ primesLE Y) : 0 < nuT T := by
  unfold nuT
  refine Finset.prod_pos fun p hp => ?_
  have := two_le_of_mem_primesLE (hT hp)
  have : (0 : ℝ) < p - 1 := by linarith
  positivity

lemma Gsel_ge_one {R : ℕ} (hR : 1 ≤ R) : 1 ≤ Gsel R := by
  unfold Gsel
  have hmem : (∅ : Finset ℕ) ∈ sieveSets R := by
    rw [mem_sieveSets]; exact ⟨Finset.empty_subset _, by simp [qU, hR]⟩
  calc (1 : ℝ) = nuT ∅ := by simp [nuT]
    _ ≤ ∑ T ∈ sieveSets R, nuT T :=
        Finset.single_le_sum (fun T hT => (nuT_pos (mem_sieveSets.mp hT).1).le) hmem

lemma Gsel_pos {R : ℕ} (hR : 1 ≤ R) : 0 < Gsel R := by linarith [Gsel_ge_one hR]

lemma selbergMajorant_nonneg (R : ℕ) (hR : 1 ≤ R) (n : ℤ) : 0 ≤ selbergMajorant R n :=
  div_nonneg (sq_nonneg _) (Gsel_pos hR).le

/-- On primes `p > R` the majorant equals `G(R)`. -/
theorem selbergMajorant_prime (R : ℕ) (hR : 1 ≤ R) {p : ℕ} (hp : p.Prime) (hpR : R < p) :
    selbergMajorant R p = Gsel R := by
  have hS : Ssel R p = Gsel R := by
    unfold Ssel Gsel
    refine Finset.sum_congr rfl fun T hT => ?_
    have hTs := (mem_sieveSets.mp hT).1
    unfold WT cT nuT
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun p' hp' => ?_
    have hp'P := mem_primesLE.mp (hTs hp')
    have hndvd : ¬ ((p' : ℤ) ∣ (p : ℤ)) := by
      rw [Int.natCast_dvd_natCast]
      intro h
      rcases (Nat.Prime.eq_one_or_self_of_dvd hp p' h) with h1 | h1
      · exact hp'P.1.one_lt.ne' h1
      · omega
    unfold cP
    rw [if_neg hndvd]
    ring
  unfold selbergMajorant
  rw [hS]
  have := Gsel_pos hR
  field_simp

/- ### `G(R) ≥ log (R+1)` -/

/-- `n ↦ 1/n` as a (multiplicative) arithmetic function. -/
noncomputable def invAF : ArithmeticFunction ℝ := ⟨fun n => 1 / (n : ℝ), by simp⟩

lemma isMultiplicative_invAF : invAF.IsMultiplicative := by
  refine ⟨by simp [invAF], fun {m n} _ => ?_⟩
  simp only [invAF, ArithmeticFunction.coe_mk]
  push_cast
  rw [one_div_mul_one_div]

lemma sum_divisors_inv_prod_pow {T : Finset ℕ} (hT : ∀ p ∈ T, p.Prime) (K : ℕ) :
    ∑ d ∈ (∏ p ∈ T, p ^ K).divisors, (1 : ℝ) / d =
      ∏ p ∈ T, ∑ j ∈ range (K + 1), (1 : ℝ) / (p : ℝ) ^ j := by
  have hmult : (invAF * (ArithmeticFunction.zeta : ArithmeticFunction ℝ)).IsMultiplicative :=
    isMultiplicative_invAF.mul ArithmeticFunction.isMultiplicative_zeta.natCast
  have happly : ∀ n : ℕ, (invAF * (ArithmeticFunction.zeta : ArithmeticFunction ℝ)) n =
      ∑ d ∈ n.divisors, (1 : ℝ) / d := by
    intro n
    rw [ArithmeticFunction.coe_mul_zeta_apply]
    rfl
  rw [← happly, hmult.map_prod (fun p => p ^ K) T]
  · refine Finset.prod_congr rfl fun p hp => ?_
    rw [happly, Nat.sum_divisors_prime_pow (hT p hp)]
    push_cast
    rfl
  · intro p hp q hq hpq
    exact Nat.coprime_pow_primes K K (hT p hp) (hT q hq) hpq

lemma geom_inv_le {p : ℕ} (hp : 2 ≤ p) (K : ℕ) :
    ∑ j ∈ range (K + 1), (1 : ℝ) / (p : ℝ) ^ j ≤ (p : ℝ) / (p - 1) := by
  have hpR : (2 : ℝ) ≤ p := by exact_mod_cast hp
  have h0 : (0 : ℝ) ≤ 1 / p := by positivity
  have h1 : (1 : ℝ) / p < 1 := by rw [div_lt_one (by linarith)]; linarith
  have := geom_sum_Ico_le_of_lt_one (m := 0) (n := K + 1) h0 h1
  rw [Finset.range_eq_Ico]
  simp_rw [one_div_pow] at this ⊢
  calc ∑ j ∈ Ico 0 (K + 1), 1 / (p : ℝ) ^ j ≤ (1 / (p : ℝ)) ^ 0 / (1 - 1 / p) := by
        simpa [one_div] using this
    _ = (p : ℝ) / (p - 1) := by
        have : (p : ℝ) - 1 ≠ 0 := by linarith
        field_simp

/-- For a set of primes `T`, `∑_{m ≤ N, rad(m) = q_T} 1/m ≤ ∏_{p∈T} 1/(p-1)`. -/
lemma sum_fiber_primeFactors_le (N : ℕ) {T : Finset ℕ} (hT : ∀ p ∈ T, p.Prime) :
    ∑ m ∈ (Icc 1 N).filter (fun m => m.primeFactors = T), (1 : ℝ) / m ≤ nuT T := by
  set F := (Icc 1 N).filter (fun m => m.primeFactors = T) with hF
  set q := qU T with hq
  have hqpos : 0 < q := qU_pos hT
  set Q := ∏ p ∈ T, p ^ N with hQ
  have hQ0 : Q ≠ 0 := Finset.prod_ne_zero_iff.mpr fun p hp => pow_ne_zero _ (hT p hp).ne_zero
  have hmem : ∀ m ∈ F, q ∣ m ∧ m ∣ Q ∧ 0 < m := by
    intro m hm
    rw [hF, Finset.mem_filter, Finset.mem_Icc] at hm
    obtain ⟨⟨hm1, hmN⟩, hpf⟩ := hm
    have hm0 : m ≠ 0 := by omega
    refine ⟨?_, ?_, by omega⟩
    · rw [hq]; unfold qU; rw [← hpf]; exact Nat.prod_primeFactors_dvd m
    · have hfac := Nat.prod_factorization_pow_eq_self hm0
      rw [Finsupp.prod, Nat.support_factorization, hpf] at hfac
      conv_lhs => rw [← hfac]
      apply Finset.prod_dvd_prod_of_dvd
      intro p _
      apply pow_dvd_pow
      exact ((Nat.factorization_lt p hm0).trans_le hmN).le
  have hsplit : ∀ m ∈ F, (1 : ℝ) / m = 1 / q * (1 / ((m / q : ℕ) : ℝ)) := by
    intro m hm
    obtain ⟨hqm, -, hm0⟩ := hmem m hm
    rw [Nat.cast_div hqm (by exact_mod_cast hqpos.ne')]
    have : (m : ℝ) ≠ 0 := by exact_mod_cast hm0.ne'
    have : (q : ℝ) ≠ 0 := by exact_mod_cast hqpos.ne'
    field_simp
  have hinj : Set.InjOn (fun m => m / q) (F : Set ℕ) := by
    intro m hm m' hm' h
    simp only at h
    obtain ⟨hqm, -, -⟩ := hmem m hm
    obtain ⟨hqm', -, -⟩ := hmem m' hm'
    rw [← Nat.div_mul_cancel hqm, ← Nat.div_mul_cancel hqm', h]
  calc ∑ m ∈ F, (1 : ℝ) / m = 1 / q * ∑ m ∈ F, 1 / ((m / q : ℕ) : ℝ) := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl hsplit
    _ = 1 / q * ∑ d ∈ F.image (fun m => m / q), 1 / (d : ℝ) := by
        rw [Finset.sum_image hinj]
    _ ≤ 1 / q * ∑ d ∈ Q.divisors, 1 / (d : ℝ) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro d hd
          rw [Finset.mem_image] at hd
          obtain ⟨m, hm, rfl⟩ := hd
          obtain ⟨hqm, hmQ, -⟩ := hmem m hm
          rw [Nat.mem_divisors]
          exact ⟨(Nat.div_dvd_of_dvd hqm).trans hmQ, hQ0⟩
        · intro d _ _; positivity
    _ = 1 / q * ∏ p ∈ T, ∑ j ∈ range (N + 1), (1 : ℝ) / (p : ℝ) ^ j := by
        rw [hQ, sum_divisors_inv_prod_pow hT N]
    _ ≤ 1 / q * ∏ p ∈ T, (p : ℝ) / (p - 1) := by
        gcongr with p hp
        exact geom_inv_le (hT p hp).two_le N
    _ = nuT T := by
        rw [hq]; unfold qU nuT
        push_cast
        rw [one_div, ← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun p hp => ?_
        have : (p : ℝ) ≠ 0 := by exact_mod_cast (hT p hp).ne_zero
        have : (p : ℝ) - 1 ≠ 0 := by
          have := (hT p hp).two_le
          have : (2 : ℝ) ≤ p := by exact_mod_cast this
          linarith
        field_simp

/-- `∑_{m ≤ R} 1/m ≤ G(R)`. -/
lemma harmonic_le_Gsel (R : ℕ) : ∑ m ∈ Icc 1 R, (1 : ℝ) / m ≤ Gsel R := by
  have hmaps : ∀ m ∈ Icc 1 R, m.primeFactors ∈ sieveSets R := by
    intro m hm
    rw [Finset.mem_Icc] at hm
    rw [mem_sieveSets]
    constructor
    · intro p hp
      rw [mem_primesLE]
      exact ⟨Nat.prime_of_mem_primeFactors hp, (Nat.le_of_mem_primeFactors hp).trans hm.2⟩
    · unfold qU
      exact (Nat.le_of_dvd (by omega) (Nat.prod_primeFactors_dvd m)).trans hm.2
  rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  unfold Gsel
  refine Finset.sum_le_sum fun T hT => ?_
  have hTp : ∀ p ∈ T, p.Prime := fun p hp => prime_of_mem_primesLE ((mem_sieveSets.mp hT).1 hp)
  exact sum_fiber_primeFactors_le R hTp

/-- **Lower bound** `G(R) ≥ log(R+1)`. -/
theorem log_le_Gsel (R : ℕ) : Real.log (R + 1) ≤ Gsel R := by
  have h := log_add_one_le_harmonic R
  rw [harmonic_eq_sum_Icc] at h
  push_cast at h
  refine h.trans (le_of_eq_of_le ?_ (harmonic_le_Gsel R))
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [one_div]

/- ### The product formula for Ramanujan sums -/

/-- For squarefree moduli: `c_{r₁} c_{r₂} = ∑_{D ⊆ T₁∩T₂} φ(q_D) J(q_{(T₁∩T₂)∖D}) c_{q_{(T₁∪T₂)∖D}}`
with `J(p) = p - 2`. -/
lemma cT_mul_cT (T₁ T₂ : Finset ℕ) (n : ℤ) :
    cT T₁ n * cT T₂ n = ∑ D ∈ (T₁ ∩ T₂).powerset,
      (∏ p ∈ D, ((p : ℝ) - 1)) * (∏ p ∈ (T₁ ∩ T₂) \ D, ((p : ℝ) - 2)) *
        cT ((T₁ ∪ T₂) \ D) n := by
  classical
  set I := T₁ ∩ T₂ with hI
  have h1 : cT T₁ n = cT (T₁ \ T₂) n * cT I n := by
    unfold cT
    rw [← Finset.prod_union (Finset.disjoint_sdiff_inter T₁ T₂), Finset.sdiff_union_inter]
  have h2 : cT T₂ n = cT (T₂ \ T₁) n * cT I n := by
    unfold cT
    rw [hI, Finset.inter_comm, ← Finset.prod_union (Finset.disjoint_sdiff_inter T₂ T₁),
      Finset.sdiff_union_inter]
  have hI2 : cT I n ^ 2 = ∑ D ∈ I.powerset,
      (∏ p ∈ D, ((p : ℝ) - 1)) * ∏ p ∈ I \ D, (((p : ℝ) - 2) * cP p n) := by
    unfold cT
    rw [← Finset.prod_pow]
    simp_rw [cP_sq]
    rw [Finset.prod_add]
  calc cT T₁ n * cT T₂ n = cT (T₁ \ T₂) n * cT (T₂ \ T₁) n * cT I n ^ 2 := by
        rw [h1, h2]; ring
    _ = ∑ D ∈ I.powerset, cT (T₁ \ T₂) n * cT (T₂ \ T₁) n *
          ((∏ p ∈ D, ((p : ℝ) - 1)) * ∏ p ∈ I \ D, (((p : ℝ) - 2) * cP p n)) := by
        rw [hI2, Finset.mul_sum]
    _ = _ := by
        refine Finset.sum_congr rfl fun D hD => ?_
        have hDI : D ⊆ I := Finset.mem_powerset.mp hD
        rw [Finset.prod_mul_distrib]
        have hU : (T₁ ∪ T₂) \ D = ((T₁ \ T₂) ∪ (T₂ \ T₁)) ∪ (I \ D) := by
          ext x
          have hx := @hDI x
          simp only [hI, Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter] at hx ⊢
          tauto
        have hdisj1 : Disjoint (T₁ \ T₂) (T₂ \ T₁) := by
          rw [Finset.disjoint_left]
          intro x hx1 hx2
          simp only [Finset.mem_sdiff] at hx1 hx2
          tauto
        have hdisj2 : Disjoint ((T₁ \ T₂) ∪ (T₂ \ T₁)) (I \ D) := by
          rw [Finset.disjoint_left]
          intro x hx1 hx2
          simp only [hI, Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter] at hx1 hx2
          tauto
        have hc : cT ((T₁ ∪ T₂) \ D) n =
            cT (T₁ \ T₂) n * cT (T₂ \ T₁) n * ∏ p ∈ I \ D, cP p n := by
          unfold cT
          rw [hU, Finset.prod_union hdisj2, Finset.prod_union hdisj1]
        rw [hc]
        ring

/- ### Ramanujan expansion of the majorant -/

/-- Index set of the expansion of `S(n)²`: triples `((T₁, T₂), D)` with `T₁, T₂ ∈ 𝒮_R` and
`D ⊆ T₁ ∩ T₂`. -/
def Trip (R : ℕ) : Finset ((Finset ℕ × Finset ℕ) × Finset ℕ) :=
  ((sieveSets R ×ˢ sieveSets R) ×ˢ (primesLE R).powerset).filter
    (fun t => t.2 ⊆ t.1.1 ∩ t.1.2)

/-- The modulus `(T₁ ∪ T₂) ∖ D` attached to a triple. -/
def kap (t : (Finset ℕ × Finset ℕ) × Finset ℕ) : Finset ℕ := (t.1.1 ∪ t.1.2) \ t.2

/-- The weight of a triple: `W(T₁) W(T₂) φ(q_D) J(q_{(T₁∩T₂)∖D})`. -/
noncomputable def wt (t : (Finset ℕ × Finset ℕ) × Finset ℕ) : ℝ :=
  WT t.1.1 * WT t.1.2 *
    ((∏ p ∈ t.2, ((p : ℝ) - 1)) * ∏ p ∈ (t.1.1 ∩ t.1.2) \ t.2, ((p : ℝ) - 2))

/-- The moduli (as sets of primes) occurring in the Ramanujan expansion of the majorant. -/
def UR (R : ℕ) : Finset (Finset ℕ) := (Trip R).image kap

/-- The Ramanujan coefficients `C_q` of the majorant (`q = q_U`). -/
noncomputable def CR (R : ℕ) (U : Finset ℕ) : ℝ :=
  (∑ t ∈ (Trip R).filter (fun t => kap t = U), wt t) / Gsel R

lemma mem_Trip {R : ℕ} {t : (Finset ℕ × Finset ℕ) × Finset ℕ} :
    t ∈ Trip R ↔ (t.1.1 ∈ sieveSets R ∧ t.1.2 ∈ sieveSets R) ∧ t.2 ⊆ primesLE R ∧
      t.2 ⊆ t.1.1 ∩ t.1.2 := by
  unfold Trip
  rw [Finset.mem_filter, Finset.mem_product, Finset.mem_product, Finset.mem_powerset]
  tauto

lemma sum_Trip (R : ℕ) (G : (Finset ℕ × Finset ℕ) × Finset ℕ → ℝ) :
    ∑ t ∈ Trip R, G t =
      ∑ P ∈ sieveSets R ×ˢ sieveSets R, ∑ D ∈ (P.1 ∩ P.2).powerset, G (P, D) := by
  unfold Trip
  rw [Finset.sum_filter, Finset.sum_product]
  refine Finset.sum_congr rfl fun P hP => ?_
  rw [← Finset.sum_filter]
  congr 1
  ext D
  simp only [Finset.mem_filter, Finset.mem_powerset]
  constructor
  · rintro ⟨-, h⟩; exact h
  · intro h
    refine ⟨h.trans ?_, h⟩
    exact Finset.inter_subset_left.trans (mem_sieveSets.mp (Finset.mem_product.mp hP).1).1

lemma Ssel_sq (R : ℕ) (n : ℤ) : Ssel R n ^ 2 = ∑ t ∈ Trip R, wt t * cT (kap t) n := by
  rw [sum_Trip, sq, Ssel, Finset.sum_mul_sum, ← Finset.sum_product']
  refine Finset.sum_congr rfl fun P _ => ?_
  rw [show WT P.1 * cT P.1 n * (WT P.2 * cT P.2 n) = WT P.1 * WT P.2 * (cT P.1 n * cT P.2 n) by
    ring, cT_mul_cT, Finset.mul_sum]
  refine Finset.sum_congr rfl fun D _ => ?_
  simp only [wt, kap]
  ring

/-- **Ramanujan expansion of the majorant**: `Λ̃(n) = ∑_{U ∈ UR} C_U c_{q_U}(n)`. -/
theorem selbergMajorant_eq_ramExp (R : ℕ) (n : ℤ) :
    selbergMajorant R n = ramExp (UR R) (CR R) n := by
  unfold selbergMajorant ramExp CR
  rw [Ssel_sq, ← Finset.sum_fiberwise_of_maps_to (g := kap) (t := UR R)
    (fun t ht => Finset.mem_image_of_mem kap ht)]
  rw [Finset.sum_div]
  refine Finset.sum_congr rfl fun U _ => ?_
  rw [Finset.sum_div, Finset.sum_div, Finset.sum_mul]
  refine Finset.sum_congr rfl fun t ht => ?_
  rw [(Finset.mem_filter.mp ht).2]
  ring

/- ### Support of the expansion -/

lemma qU_mono {U V : Finset ℕ} (h : U ⊆ V) (hV : ∀ p ∈ V, 1 ≤ p) : qU U ≤ qU V := by
  unfold qU
  exact Finset.prod_le_prod_of_subset_of_one_le' h fun p hp _ => hV p hp

lemma qU_union_le (A B : Finset ℕ) (hA : ∀ p ∈ A, 1 ≤ p) : qU (A ∪ B) ≤ qU A * qU B := by
  unfold qU
  have h := Finset.prod_union_inter (s₁ := A) (s₂ := B) (f := fun p => p)
  have h1 : 1 ≤ ∏ p ∈ A ∩ B, p :=
    Finset.one_le_prod' fun p hp => hA p (Finset.mem_inter.mp hp).1
  calc ∏ p ∈ A ∪ B, p ≤ (∏ p ∈ A ∪ B, p) * ∏ p ∈ A ∩ B, p := Nat.le_mul_of_pos_right _ h1
    _ = (∏ p ∈ A, p) * ∏ p ∈ B, p := h

lemma UR_spec {R : ℕ} {U : Finset ℕ} (hU : U ∈ UR R) : U ⊆ primesLE R ∧ qU U ≤ R ^ 2 := by
  unfold UR at hU
  rw [Finset.mem_image] at hU
  obtain ⟨t, ht, rfl⟩ := hU
  obtain ⟨⟨h1, h2⟩, -, -⟩ := mem_Trip.mp ht
  have hT₁ := mem_sieveSets.mp h1
  have hT₂ := mem_sieveSets.mp h2
  have hsub : t.1.1 ∪ t.1.2 ⊆ primesLE R := Finset.union_subset hT₁.1 hT₂.1
  have hone : ∀ p ∈ t.1.1 ∪ t.1.2, 1 ≤ p := fun p hp =>
    (prime_of_mem_primesLE (hsub hp)).one_lt.le
  refine ⟨Finset.sdiff_subset.trans hsub, ?_⟩
  calc qU (kap t) ≤ qU (t.1.1 ∪ t.1.2) := qU_mono Finset.sdiff_subset hone
    _ ≤ qU t.1.1 * qU t.1.2 :=
        qU_union_le _ _ fun p hp => hone p (Finset.mem_union_left _ hp)
    _ ≤ R * R := Nat.mul_le_mul hT₁.2 hT₂.2
    _ = R ^ 2 := (sq R).symm

lemma UR_primes {R : ℕ} {U : Finset ℕ} (hU : U ∈ UR R) : ∀ p ∈ U, p.Prime :=
  fun _ hp => prime_of_mem_primesLE ((UR_spec hU).1 hp)

lemma card_UR_le (R : ℕ) : (UR R).card ≤ R ^ 2 := by
  have h : (UR R).card ≤ (Finset.Icc 1 (R ^ 2)).card := by
    apply Finset.card_le_card_of_injOn qU
    · intro U hU
      have := UR_spec (Finset.mem_coe.mp hU)
      rw [Finset.mem_coe, Finset.mem_Icc]
      exact ⟨qU_pos (UR_primes (Finset.mem_coe.mp hU)), this.2⟩
    · intro U hU U' hU' h
      exact qU_inj (UR_primes (Finset.mem_coe.mp hU)) (UR_primes (Finset.mem_coe.mp hU')) h
  simpa using h

/- ### The coefficient bound `|C_q| ≤ 3^{ω(q)}/φ(q)` -/

lemma abs_WT {Y : ℕ} {T : Finset ℕ} (hT : T ⊆ primesLE Y) : |WT T| = nuT T := by
  unfold WT nuT
  rw [Finset.abs_prod]
  refine Finset.prod_congr rfl fun p hp => ?_
  have := two_le_of_mem_primesLE (hT hp)
  rw [abs_div, abs_neg, abs_one, abs_of_pos (by linarith)]

lemma abs_wt_le {R : ℕ} {t : (Finset ℕ × Finset ℕ) × Finset ℕ} (ht : t ∈ Trip R) :
    |wt t| ≤ nuT t.2 * nuT (kap t) := by
  obtain ⟨⟨h1, h2⟩, -, hDI⟩ := mem_Trip.mp ht
  have hT₁ := (mem_sieveSets.mp h1).1
  have hT₂ := (mem_sieveSets.mp h2).1
  set T₁ := t.1.1 with hT₁def
  set T₂ := t.1.2 with hT₂def
  set D := t.2 with hDdef
  have hge : ∀ p ∈ T₁ ∪ T₂, (2 : ℝ) ≤ p := fun p hp =>
    two_le_of_mem_primesLE ((Finset.union_subset hT₁ hT₂) hp)
  have hDsub : D ⊆ T₁ ∪ T₂ := hDI.trans (Finset.inter_subset_left.trans Finset.subset_union_left)
  have hIsub : T₁ ∩ T₂ ⊆ T₁ ∪ T₂ := Finset.inter_subset_left.trans Finset.subset_union_left
  have hnn : 0 ≤ (∏ p ∈ D, ((p : ℝ) - 1)) * ∏ p ∈ (T₁ ∩ T₂) \ D, ((p : ℝ) - 2) := by
    apply mul_nonneg
    · exact Finset.prod_nonneg fun p hp => by linarith [hge p (hDsub hp)]
    · exact Finset.prod_nonneg fun p hp =>
        by linarith [hge p (hIsub (Finset.sdiff_subset hp))]
  have hwt : |wt t| = nuT T₁ * nuT T₂ *
      ((∏ p ∈ D, ((p : ℝ) - 1)) * ∏ p ∈ (T₁ ∩ T₂) \ D, ((p : ℝ) - 2)) := by
    unfold wt
    rw [abs_mul, abs_mul, abs_WT hT₁, abs_WT hT₂, abs_of_nonneg hnn]
  have e1 : nuT T₁ * nuT T₂ = nuT (T₁ ∪ T₂) * nuT (T₁ ∩ T₂) := by
    unfold nuT; rw [Finset.prod_union_inter]
  have e2 : nuT (T₁ ∪ T₂) = nuT ((T₁ ∪ T₂) \ D) * nuT D := by
    unfold nuT; rw [Finset.prod_sdiff hDsub]
  have e3 : nuT (T₁ ∩ T₂) = nuT ((T₁ ∩ T₂) \ D) * nuT D := by
    unfold nuT; rw [Finset.prod_sdiff hDI]
  have e4 : nuT D * ∏ p ∈ D, ((p : ℝ) - 1) = 1 := by
    unfold nuT
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_eq_one fun p hp => ?_
    have : (p : ℝ) - 1 ≠ 0 := by linarith [hge p (hDsub hp)]
    field_simp
  have e5 : nuT ((T₁ ∩ T₂) \ D) * ∏ p ∈ (T₁ ∩ T₂) \ D, ((p : ℝ) - 2) ≤ 1 := by
    unfold nuT
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_le_one
    · intro p hp
      have := hge p (hIsub (Finset.sdiff_subset hp))
      have : (0 : ℝ) < p - 1 := by linarith
      apply mul_nonneg (by positivity) (by linarith)
    · intro p hp
      have := hge p (hIsub (Finset.sdiff_subset hp))
      have hp1 : (0 : ℝ) < p - 1 := by linarith
      rw [one_div_mul_eq_div, div_le_one hp1]
      linarith
  have hnuU : 0 ≤ nuT ((T₁ ∪ T₂) \ D) := Finset.prod_nonneg fun p hp => by
    have := hge p (Finset.sdiff_subset hp); have : (0 : ℝ) < p - 1 := by linarith
    positivity
  have hnuD : 0 ≤ nuT D := Finset.prod_nonneg fun p hp => by
    have := hge p (hDsub hp); have : (0 : ℝ) < p - 1 := by linarith
    positivity
  rw [hwt, e1, e2, e3]
  calc nuT ((T₁ ∪ T₂) \ D) * nuT D * (nuT ((T₁ ∩ T₂) \ D) * nuT D) *
        ((∏ p ∈ D, ((p : ℝ) - 1)) * ∏ p ∈ (T₁ ∩ T₂) \ D, ((p : ℝ) - 2))
      = nuT ((T₁ ∪ T₂) \ D) * nuT D * ((nuT D * ∏ p ∈ D, ((p : ℝ) - 1)) *
          (nuT ((T₁ ∩ T₂) \ D) * ∏ p ∈ (T₁ ∩ T₂) \ D, ((p : ℝ) - 2))) := by ring
    _ ≤ nuT ((T₁ ∪ T₂) \ D) * nuT D * (1 * 1) := by
        rw [e4]
        gcongr
    _ = nuT D * nuT (kap t) := by rw [kap]; ring

lemma card_sigma_powerset (U : Finset ℕ) :
    (U.powerset.sigma fun A => A.powerset).card = 3 ^ U.card := by
  rw [Finset.card_sigma]
  simp_rw [Finset.card_powerset]
  have := Finset.prod_one_add (f := fun _ : ℕ => (2 : ℕ)) U
  simp only [Finset.prod_const] at this
  rw [← this]

lemma T2_recover {T₁ T₂ D : Finset ℕ} (h : D ⊆ T₁ ∩ T₂) :
    T₂ = D ∪ ((T₁ ∩ T₂) \ D) ∪ (((T₁ ∪ T₂) \ D) \ (T₁ \ D)) := by
  ext x
  have hx := @h x
  simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_inter] at hx ⊢
  tauto

/-- The triples with a given modulus `U` inject into `𝒮_R × {(A, B) : B ⊆ A ⊆ U}`. -/
lemma sum_fiber_nuT_le (R : ℕ) (U : Finset ℕ) :
    ∑ t ∈ (Trip R).filter (fun t => kap t = U), nuT t.2 ≤ Gsel R * 3 ^ U.card := by
  classical
  set fib := (Trip R).filter (fun t => kap t = U) with hfib
  let φ : (Finset ℕ × Finset ℕ) × Finset ℕ → Finset ℕ × (Σ _ : Finset ℕ, Finset ℕ) :=
    fun t => (t.2, ⟨t.1.1 \ t.2, (t.1.1 ∩ t.1.2) \ t.2⟩)
  set tgt := sieveSets R ×ˢ (U.powerset.sigma fun A => A.powerset) with htgt
  have hmaps : ∀ t ∈ fib, φ t ∈ tgt := by
    intro t ht
    rw [hfib, Finset.mem_filter] at ht
    obtain ⟨ht, hk⟩ := ht
    obtain ⟨⟨h1, _⟩, hDP, hDI⟩ := mem_Trip.mp ht
    rw [htgt, Finset.mem_product, Finset.mem_sigma, Finset.mem_powerset, Finset.mem_powerset]
    refine ⟨?_, ?_, ?_⟩
    · rw [mem_sieveSets]
      refine ⟨hDP, ?_⟩
      have hT₁ := mem_sieveSets.mp h1
      exact (qU_mono (hDI.trans Finset.inter_subset_left) fun p hp =>
        (prime_of_mem_primesLE (hT₁.1 hp)).one_lt.le).trans hT₁.2
    · show t.1.1 \ t.2 ⊆ U
      rw [← hk]
      intro x hx
      simp only [kap, Finset.mem_sdiff, Finset.mem_union] at hx ⊢
      exact ⟨Or.inl hx.1, hx.2⟩
    · show (t.1.1 ∩ t.1.2) \ t.2 ⊆ t.1.1 \ t.2
      intro x hx
      simp only [Finset.mem_sdiff, Finset.mem_inter] at hx ⊢
      exact ⟨hx.1.1, hx.2⟩
  have hinj : Set.InjOn φ (fib : Set _) := by
    rintro ⟨⟨T₁, T₂⟩, D⟩ ht ⟨⟨T₁', T₂'⟩, D'⟩ ht' h
    rw [Finset.mem_coe, hfib, Finset.mem_filter] at ht ht'
    obtain ⟨ht, hk⟩ := ht
    obtain ⟨ht', hk'⟩ := ht'
    have hDI : D ⊆ T₁ ∩ T₂ := (mem_Trip.mp ht).2.2
    have hDI' : D' ⊆ T₁' ∩ T₂' := (mem_Trip.mp ht').2.2
    have hk2 : (T₁ ∪ T₂) \ D = (T₁' ∪ T₂') \ D' := by
      have e1 : kap ((T₁, T₂), D) = (T₁ ∪ T₂) \ D := rfl
      have e2 : kap ((T₁', T₂'), D') = (T₁' ∪ T₂') \ D' := rfl
      rw [← e1, ← e2, hk, hk']
    simp only [φ, Prod.mk.injEq, Sigma.mk.injEq, heq_eq_eq] at h
    obtain ⟨hD, hA, hB⟩ := h
    subst hD
    have e1 : T₁ = T₁' := by
      rw [← Finset.sdiff_union_of_subset (hDI.trans Finset.inter_subset_left),
        ← Finset.sdiff_union_of_subset (hDI'.trans Finset.inter_subset_left), hA]
    subst e1
    have e2 : T₂ = T₂' := by
      rw [T2_recover hDI, T2_recover hDI', hB, hk2]
    subst e2
    rfl
  calc ∑ t ∈ fib, nuT t.2 = ∑ x ∈ fib.image φ, nuT x.1 := by
        rw [Finset.sum_image hinj]
    _ ≤ ∑ x ∈ tgt, nuT x.1 := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro x hx
          rw [Finset.mem_image] at hx
          obtain ⟨t, ht, rfl⟩ := hx
          exact hmaps t ht
        · intro x hx _
          rw [htgt, Finset.mem_product] at hx
          exact (nuT_pos (mem_sieveSets.mp hx.1).1).le
    _ = Gsel R * 3 ^ U.card := by
        rw [htgt, Finset.sum_product]
        unfold Gsel
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun D _ => ?_
        dsimp only
        rw [Finset.sum_const, card_sigma_powerset, nsmul_eq_mul]
        push_cast
        ring

/-- **Coefficient bound**: `|C_q| ≤ 3^{ω(q)}/φ(q)`. -/
theorem abs_CR_le (R : ℕ) (hR : 1 ≤ R) {U : Finset ℕ} (hU : U ∈ UR R) :
    |CR R U| ≤ ∏ p ∈ U, (3 : ℝ) / ((p : ℝ) - 1) := by
  have hG := Gsel_pos hR
  have hUs := (UR_spec hU).1
  unfold CR
  rw [abs_div, abs_of_pos hG, div_le_iff₀ hG]
  calc |∑ t ∈ (Trip R).filter (fun t => kap t = U), wt t|
      ≤ ∑ t ∈ (Trip R).filter (fun t => kap t = U), |wt t| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ (Trip R).filter (fun t => kap t = U), nuT t.2 * nuT U := by
        refine Finset.sum_le_sum fun t ht => ?_
        rw [Finset.mem_filter] at ht
        have := abs_wt_le ht.1
        rwa [ht.2] at this
    _ = (∑ t ∈ (Trip R).filter (fun t => kap t = U), nuT t.2) * nuT U := by
        rw [Finset.sum_mul]
    _ ≤ (Gsel R * 3 ^ U.card) * nuT U :=
        mul_le_mul_of_nonneg_right (sum_fiber_nuT_le R U) (nuT_pos hUs).le
    _ = (∏ p ∈ U, (3 : ℝ) / ((p : ℝ) - 1)) * Gsel R := by
        have e : ∏ p ∈ U, (3 : ℝ) / ((p : ℝ) - 1) = 3 ^ U.card * nuT U := by
          unfold nuT
          rw [← Finset.prod_const, ← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl fun p _ => ?_
          ring
        rw [e]; ring

lemma three_div_le_six_div {p : ℕ} (hp : 2 ≤ p) : (3 : ℝ) / ((p : ℝ) - 1) ≤ 6 / p := by
  have hpR : (2 : ℝ) ≤ p := by exact_mod_cast hp
  rw [div_le_div_iff₀ (by linarith) (by linarith)]
  linarith

theorem abs_CR_le_six (R : ℕ) (hR : 1 ≤ R) {U : Finset ℕ} (hU : U ∈ UR R) :
    |CR R U| ≤ ∏ p ∈ U, (6 : ℝ) / p := by
  refine (abs_CR_le R hR hU).trans (Finset.prod_le_prod (fun p hp => ?_) fun p hp => ?_)
  · have := two_le_of_mem_primesLE ((UR_spec hU).1 hp)
    have : (0 : ℝ) < p - 1 := by linarith
    positivity
  · exact three_div_le_six_div (UR_primes hU p hp).two_le

lemma abs_CR_le_pow (R : ℕ) (hR : 1 ≤ R) {U : Finset ℕ} (hU : U ∈ UR R) :
    |CR R U| ≤ (qU U : ℝ) ^ 2 := by
  refine (abs_CR_le R hR hU).trans ?_
  have hge : ∀ p ∈ U, (2 : ℝ) ≤ p := fun p hp => two_le_of_mem_primesLE ((UR_spec hU).1 hp)
  calc ∏ p ∈ U, (3 : ℝ) / ((p : ℝ) - 1) ≤ ∏ p ∈ U, (4 : ℝ) := by
        refine Finset.prod_le_prod (fun p hp => ?_) fun p hp => ?_
        · have := hge p hp; have : (0 : ℝ) < p - 1 := by linarith
          positivity
        · have := hge p hp
          rw [div_le_iff₀ (by linarith)]; linarith
    _ = ((2 : ℝ) ^ U.card) ^ 2 := by
        rw [Finset.prod_const, ← pow_mul, mul_comm, pow_mul]; norm_num
    _ ≤ (qU U : ℝ) ^ 2 := by
        gcongr
        unfold qU
        push_cast
        calc (2 : ℝ) ^ U.card = ∏ p ∈ U, (2 : ℝ) := (Finset.prod_const _).symm
          _ ≤ ∏ p ∈ U, (p : ℝ) := Finset.prod_le_prod (fun _ _ => by norm_num) hge

/- ### Sums of the majorant over arithmetic progressions -/

/-- If `q_U ∤ d` then `|∑_{k ∈ [k₁,k₂)} c_{q_U}(kd + b)| ≤ q_U²/2`. -/
lemma abs_sum_AP_cT_le {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) {d : ℕ} (hd : 0 < d)
    (hnot : ¬ U ⊆ d.primeFactors) (b k₁ k₂ : ℤ) :
    |∑ k ∈ Ico k₁ k₂, cT U (k * d + b)| ≤ (qU U : ℝ) ^ 2 / 2 := by
  set q := qU U with hqdef
  have hq : 0 < q := qU_pos hU
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  obtain ⟨p, hpU, hpd⟩ := Finset.not_subset.mp hnot
  have hpd' : ¬ p ∣ d := fun h => hpd (Nat.mem_primeFactors.mpr ⟨hU p hpU, h, hd.ne'⟩)
  have hpq : p ∣ q := Finset.dvd_prod_of_mem _ hpU
  have hC : ((∑ k ∈ Ico k₁ k₂, cT U (k * d + b) : ℝ) : ℂ) =
      ∑ a ∈ resid U, ee ((a : ℝ) * b / q) * expSum k₁ k₂ ((a : ℝ) * d / q) := by
    rw [Complex.ofReal_sum]
    simp_rw [cT_eq_sum_resid hU]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => ?_
    unfold expSum
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [← ee_add]; congr 1; push_cast; ring
  have hbound : ∀ a ∈ resid U, ‖expSum k₁ k₂ ((a : ℝ) * d / q)‖ ≤ q / 2 := by
    intro a ha
    unfold resid at ha
    rw [Finset.mem_filter, Finset.mem_range] at ha
    have hndvd : ¬ ((q : ℕ) : ℤ) ∣ ((a * d : ℕ) : ℤ) := by
      intro h
      have h' : q ∣ a * d := by exact_mod_cast h
      have : p ∣ a * d := hpq.trans h'
      rcases (Nat.Prime.dvd_mul (hU p hpU)).mp this with h1 | h1
      · have hcop := (Nat.Coprime.coprime_dvd_right hpq ha.2).symm
        exact (hU p hpU).one_lt.ne' (hcop.eq_one_of_dvd h1)
      · exact hpd' h1
    have hdn := one_div_le_dnear hq hndvd
    have e : (((a * d : ℕ) : ℤ) : ℝ) / (q : ℝ) = (a : ℝ) * d / q := by push_cast; ring
    rw [e] at hdn
    have := norm_sum_Ico_ee_le_of_dnear k₁ k₂ (by positivity) hdn
    unfold expSum
    calc ‖∑ x ∈ Ico k₁ k₂, ee ((a : ℝ) * d / q * x)‖ ≤ 1 / (2 * (1 / (q : ℝ))) := this
      _ = q / 2 := by field_simp
  rw [← Real.norm_eq_abs, ← Complex.norm_real, hC]
  calc ‖∑ a ∈ resid U, ee ((a : ℝ) * b / q) * expSum k₁ k₂ ((a : ℝ) * d / q)‖
      ≤ ∑ a ∈ resid U, ‖ee ((a : ℝ) * b / q) * expSum k₁ k₂ ((a : ℝ) * d / q)‖ :=
        norm_sum_le _ _
    _ = ∑ a ∈ resid U, ‖expSum k₁ k₂ ((a : ℝ) * d / q)‖ := by
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [norm_mul, norm_ee, one_mul]
    _ ≤ ∑ a ∈ resid U, (q : ℝ) / 2 := Finset.sum_le_sum hbound
    _ = (resid U).card * ((q : ℝ) / 2) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ q * ((q : ℝ) / 2) := by
        gcongr
        exact_mod_cast card_resid_le U
    _ = (q : ℝ) ^ 2 / 2 := by ring

/-- **Sums over arithmetic progressions.** For `(b, d) = 1`,
`∑_{k ∈ [k₁,k₂)} Λ̃(kd + b) ≤ (k₂ - k₁) ∑_{U ∈ UR, q_U ∣ d} |C_U| + ∑_{U∈UR} |C_U| q_U²`. -/
theorem sum_AP_selbergMajorant_le (R : ℕ) (b : ℤ) (d : ℕ) (hd : 0 < d)
    (hbd : IsCoprime b (d : ℤ)) (k₁ k₂ : ℤ) :
    ∑ k ∈ Ico k₁ k₂, selbergMajorant R (k * d + b) ≤
      (Ico k₁ k₂).card * ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), |CR R U| +
        ∑ U ∈ UR R, |CR R U| * (qU U : ℝ) ^ 2 := by
  simp_rw [selbergMajorant_eq_ramExp]
  unfold ramExp
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum]
  rw [← Finset.sum_filter_add_sum_filter_not (UR R) (fun U => U ⊆ d.primeFactors)]
  apply add_le_add
  · rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro U hU
    rw [Finset.mem_filter] at hU
    have hper : ∀ k : ℤ, cT U (k * d + b) = cT U b := by
      intro k
      rw [add_comm]
      apply cT_periodic
      intro p hp
      have : p ∣ d := Nat.dvd_of_mem_primeFactors (hU.2 hp)
      exact Dvd.dvd.mul_left (Int.natCast_dvd_natCast.mpr this) k
    simp_rw [hper]
    rw [Finset.sum_const, nsmul_eq_mul]
    have hcb : |cT U b| ≤ 1 := by
      unfold cT; rw [Finset.abs_prod]
      apply Finset.prod_le_one (fun _ _ => abs_nonneg _)
      intro p hp
      have hpd : (p : ℤ) ∣ d :=
        Int.natCast_dvd_natCast.mpr (Nat.dvd_of_mem_primeFactors (hU.2 hp))
      have hpb : ¬ (p : ℤ) ∣ b := by
        intro hpb
        have := hbd.isUnit_of_dvd' hpb hpd
        rcases Int.isUnit_iff.mp this with h | h
        · have : p = 1 := by exact_mod_cast h
          exact (Nat.prime_of_mem_primeFactors (hU.2 hp)).one_lt.ne' this
        · have : (0 : ℤ) ≤ p := by positivity
          omega
      unfold cP; rw [if_neg hpb]; simp
    have hK : (0 : ℝ) ≤ (Ico k₁ k₂).card := by positivity
    calc CR R U * ((Ico k₁ k₂).card * cT U b)
        ≤ |CR R U * ((Ico k₁ k₂).card * cT U b)| := le_abs_self _
      _ = |CR R U| * ((Ico k₁ k₂).card * |cT U b|) := by
          rw [abs_mul, abs_mul, Nat.abs_cast]
      _ ≤ |CR R U| * ((Ico k₁ k₂).card * 1) := by gcongr
      _ = (Ico k₁ k₂).card * |CR R U| := by ring
  · calc ∑ U ∈ (UR R).filter (fun U => ¬ U ⊆ d.primeFactors),
          CR R U * ∑ k ∈ Ico k₁ k₂, cT U (k * d + b)
        ≤ ∑ U ∈ (UR R).filter (fun U => ¬ U ⊆ d.primeFactors), |CR R U| * (qU U : ℝ) ^ 2 := by
          apply Finset.sum_le_sum
          intro U hU
          rw [Finset.mem_filter] at hU
          have h := abs_sum_AP_cT_le (UR_primes hU.1) hd hU.2 b k₁ k₂
          have hq0 : (0 : ℝ) ≤ (qU U : ℝ) ^ 2 := sq_nonneg _
          calc CR R U * ∑ k ∈ Ico k₁ k₂, cT U (k * d + b)
              ≤ |CR R U| * |∑ k ∈ Ico k₁ k₂, cT U (k * d + b)| := by
                rw [← abs_mul]; exact le_abs_self _
            _ ≤ |CR R U| * ((qU U : ℝ) ^ 2 / 2) := by gcongr
            _ ≤ |CR R U| * (qU U : ℝ) ^ 2 := by gcongr; linarith
      _ ≤ ∑ U ∈ UR R, |CR R U| * (qU U : ℝ) ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => by positivity)

lemma sum_filter_abs_CR_le (R : ℕ) (hR : 1 ≤ R) (d : ℕ) :
    ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), |CR R U| ≤
      ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) := by
  rw [Finset.prod_one_add]
  calc ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), |CR R U|
      ≤ ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), ∏ p ∈ U, 3 / ((p : ℝ) - 1) :=
        Finset.sum_le_sum fun U hU => abs_CR_le R hR (Finset.mem_filter.mp hU).1
    _ ≤ ∑ U ∈ d.primeFactors.powerset, ∏ p ∈ U, 3 / ((p : ℝ) - 1) := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro U hU
          rw [Finset.mem_filter] at hU
          exact Finset.mem_powerset.mpr hU.2
        · intro U hU _
          apply Finset.prod_nonneg
          intro p hp
          have := (Nat.prime_of_mem_primeFactors (Finset.mem_powerset.mp hU hp)).two_le
          have : (2 : ℝ) ≤ p := by exact_mod_cast this
          have : (0 : ℝ) < p - 1 := by linarith
          positivity

lemma qU_le_sq_of_mem_UR {R : ℕ} {U : Finset ℕ} (hU : U ∈ UR R) : (qU U : ℝ) ≤ (R : ℝ) ^ 2 := by
  exact_mod_cast (UR_spec hU).2

lemma sum_abs_CR_le (R : ℕ) (hR : 1 ≤ R) : ∑ U ∈ UR R, |CR R U| ≤ (R : ℝ) ^ 6 := by
  calc ∑ U ∈ UR R, |CR R U| ≤ ∑ U ∈ UR R, (R : ℝ) ^ 4 := by
        refine Finset.sum_le_sum fun U hU => ?_
        refine (abs_CR_le_pow R hR hU).trans ?_
        have h1 := qU_le_sq_of_mem_UR hU
        have h0 : (0 : ℝ) ≤ qU U := by positivity
        calc (qU U : ℝ) ^ 2 ≤ ((R : ℝ) ^ 2) ^ 2 := by gcongr
          _ = (R : ℝ) ^ 4 := by ring
    _ = (UR R).card * (R : ℝ) ^ 4 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (R : ℝ) ^ 2 * (R : ℝ) ^ 4 := by
        gcongr
        exact_mod_cast card_UR_le R
    _ = (R : ℝ) ^ 6 := by ring

lemma sum_abs_CR_qU_sq_le (R : ℕ) (hR : 1 ≤ R) :
    ∑ U ∈ UR R, |CR R U| * (qU U : ℝ) ^ 2 ≤ (R : ℝ) ^ 10 := by
  calc ∑ U ∈ UR R, |CR R U| * (qU U : ℝ) ^ 2 ≤ ∑ U ∈ UR R, (R : ℝ) ^ 8 := by
        refine Finset.sum_le_sum fun U hU => ?_
        have h1 := qU_le_sq_of_mem_UR hU
        have h0 : (0 : ℝ) ≤ qU U := by positivity
        have h2 : (qU U : ℝ) ^ 2 ≤ (R : ℝ) ^ 4 := by
          calc (qU U : ℝ) ^ 2 ≤ ((R : ℝ) ^ 2) ^ 2 := by gcongr
            _ = (R : ℝ) ^ 4 := by ring
        calc |CR R U| * (qU U : ℝ) ^ 2 ≤ (qU U : ℝ) ^ 2 * (qU U : ℝ) ^ 2 := by
              gcongr; exact abs_CR_le_pow R hR hU
          _ ≤ (R : ℝ) ^ 4 * (R : ℝ) ^ 4 := by gcongr
          _ = (R : ℝ) ^ 8 := by ring
    _ = (UR R).card * (R : ℝ) ^ 8 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (R : ℝ) ^ 2 * (R : ℝ) ^ 8 := by
        gcongr
        exact_mod_cast card_UR_le R
    _ = (R : ℝ) ^ 10 := by ring

/-- **Brun–Titchmarsh-type bound for the majorant.** For an interval `[a, a+L)` and a residue
class `b mod d` with `(b, d) = 1`:
`∑_{m ∈ [a,a+L), m ≡ b (d)} Λ̃(m) ≤ (L/d) ∏_{p ∣ d} (1 + 3/(p-1)) + 2R^{10}`. -/
theorem sum_interval_AP_selbergMajorant_le (R : ℕ) (hR : 1 ≤ R) (a : ℤ) (L : ℕ) (b : ℤ) (d : ℕ)
    (hd : 0 < d) (hbd : IsCoprime b (d : ℤ)) :
    ∑ m ∈ (Ico a (a + L)).filter (fun m => m ≡ b [ZMOD d]), selbergMajorant R m ≤
      (L : ℝ) / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + 2 * (R : ℝ) ^ 10 := by
  have hdZ : (0 : ℤ) < d := by exact_mod_cast hd
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  rw [Int.Ico_filter_modEq_eq, Int.Ico_filter_dvd_eq _ _ hdZ, Finset.sum_map, Finset.sum_map]
  simp only [Function.Embedding.coeFn_mk]
  set k₁ := ⌈((a - b : ℤ) : ℚ) / ((d : ℤ) : ℚ)⌉ with hk₁
  set k₂ := ⌈((a + L - b : ℤ) : ℚ) / ((d : ℤ) : ℚ)⌉ with hk₂
  have hK : ((Ico k₁ k₂).card : ℝ) ≤ L / d + 1 := by
    have h1 := card_filter_dvd_Ico_le (a - b) (a + L - b) d hd
    have h2 : ((Ico (a - b) (a + L - b)).filter (fun x => (d : ℤ) ∣ x)).card =
        (Ico k₁ k₂).card := by
      rw [Int.Ico_filter_dvd_eq _ _ hdZ, Finset.card_map]
    rw [h2] at h1
    refine h1.trans (max_le ?_ (by positivity))
    push_cast
    rw [show (a : ℝ) + L - b - (a - b) = L by ring]
  have hmain := sum_AP_selbergMajorant_le R b d hd hbd k₁ k₂
  set M := ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), |CR R U| with hMdef
  have hM := sum_filter_abs_CR_le R hR d
  have hM0 : 0 ≤ M := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hM6 : M ≤ (R : ℝ) ^ 6 :=
    (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      (fun _ _ _ => abs_nonneg _)).trans (sum_abs_CR_le R hR)
  have hE := sum_abs_CR_qU_sq_le R hR
  have hR1 : (1 : ℝ) ≤ R := by exact_mod_cast hR
  have hR6 : (R : ℝ) ^ 6 ≤ (R : ℝ) ^ 10 := pow_le_pow_right₀ hR1 (by norm_num)
  have hP0 : 0 ≤ ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) := by
    apply Finset.prod_nonneg
    intro p hp
    have := (Nat.prime_of_mem_primeFactors hp).two_le
    have : (2 : ℝ) ≤ p := by exact_mod_cast this
    have : (0 : ℝ) < p - 1 := by linarith
    positivity
  have hLd : (0 : ℝ) ≤ L / d := by positivity
  calc ∑ k ∈ Ico k₁ k₂, selbergMajorant R (k * d + b)
      ≤ (Ico k₁ k₂).card * M + ∑ U ∈ UR R, |CR R U| * (qU U : ℝ) ^ 2 := hmain
    _ ≤ (L / d + 1) * M + (R : ℝ) ^ 10 := by gcongr
    _ = L / d * M + M + (R : ℝ) ^ 10 := by ring
    _ ≤ L / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + (R : ℝ) ^ 6 + (R : ℝ) ^ 10 := by
        gcongr
    _ ≤ (L : ℝ) / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + 2 * (R : ℝ) ^ 10 := by
        linarith

/-- **(4.2)**: `∑_{x ∈ [X, 2X)} Λ̃(x) ≤ X + R^{10}`. -/
theorem sum_dyadic_selbergMajorant_le (R X : ℕ) (hR : 1 ≤ R) :
    ∑ x ∈ Ico (X : ℤ) (2 * X), selbergMajorant R x ≤ X + (R : ℝ) ^ 10 := by
  have h := sum_AP_selbergMajorant_le R 0 1 one_pos isCoprime_one_right (X : ℤ) (2 * X)
  simp only [Nat.cast_one, mul_one, add_zero] at h
  have hM := sum_filter_abs_CR_le R hR 1
  simp only [Nat.primeFactors_one, Finset.prod_empty] at hM
  have hE := sum_abs_CR_qU_sq_le R hR
  have hcard : ((Ico (X : ℤ) (2 * X)).card : ℝ) = X := by
    rw [Int.card_Ico]
    have : (2 * (X : ℤ) - X).toNat = X := by omega
    rw [this]
  rw [hcard] at h
  have hX : (0 : ℝ) ≤ X := by positivity
  calc ∑ x ∈ Ico (X : ℤ) (2 * X), selbergMajorant R x
      ≤ X * ∑ U ∈ (UR R).filter (fun U => U ⊆ (1 : ℕ).primeFactors), |CR R U| +
          ∑ U ∈ UR R, |CR R U| * (qU U : ℝ) ^ 2 := h
    _ ≤ X * 1 + (R : ℝ) ^ 10 := by
        gcongr
        simpa using hM
    _ = X + (R : ℝ) ^ 10 := by ring

/- ### Real-variable helpers for the decomposition -/

lemma rpow_add3_le {a b d c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hd : 0 ≤ d) (hc0 : 0 ≤ c)
    (hc1 : c ≤ 1) : (a + b + d) ^ c ≤ a ^ c + b ^ c + d ^ c := by
  calc (a + b + d) ^ c ≤ (a + b) ^ c + d ^ c :=
        Real.rpow_add_le_add_rpow (by positivity) hd hc0 hc1
    _ ≤ a ^ c + b ^ c + d ^ c := by
        gcongr
        exact Real.rpow_add_le_add_rpow ha hb hc0 hc1

/-- Thresholding: `|y - y 1_{|y| ≤ T}| ≤ |y|^m / T^{m-1}`. -/
lemma abs_sub_thresh_le (y T : ℝ) (hT : 0 < T) (m : ℕ) (hm : 1 ≤ m) :
    |y - (if |y| ≤ T then y else 0)| ≤ |y| ^ m / T ^ (m - 1) := by
  split_ifs with h
  · rw [sub_self, abs_zero]; positivity
  · rw [sub_zero]
    have hTy : T ≤ |y| := (lt_of_not_ge h).le
    rw [le_div_iff₀ (by positivity)]
    calc |y| * T ^ (m - 1) ≤ |y| * |y| ^ (m - 1) := by gcongr
      _ = |y| ^ m := by
          rw [← pow_succ']
          congr 1
          omega

/-- The `(4.6)`-contribution of one block. -/
lemma block_46 {u X D G c : ℝ} (hu : 1 ≤ u) (hX : 1 ≤ X) (hD : 1 ≤ D) (hG : 1 ≤ G)
    (hc0 : 0 < c) (hc1 : c < 1) :
    (D * X * u ^ (-(3 / 4 : ℝ)) + X ^ ((3 : ℝ) / 4) + G * X * u⁻¹) ^ c * (u ^ (c / 2)) ^ (1 - c) ≤
      (D + G) * X ^ c * u ^ (-(c / 4)) + X ^ (3 * c / 4) * u ^ ((1 : ℝ) / 2) := by
  have hu0 : 0 < u := by linarith
  have hX0 : 0 < X := by linarith
  set W := (u ^ (c / 2)) ^ (1 - c) with hWdef
  have hW0 : 0 ≤ W := by positivity
  have hW : W ≤ u ^ (c / 2) := by
    rw [hWdef, ← Real.rpow_mul hu0.le]
    exact Real.rpow_le_rpow_of_exponent_le hu (by nlinarith)
  have ha : (D * X * u ^ (-(3 / 4 : ℝ))) ^ c = D ^ c * X ^ c * u ^ (-(3 / 4) * c) := by
    rw [Real.mul_rpow (by positivity) (by positivity),
      Real.mul_rpow (by positivity) (by positivity), ← Real.rpow_mul hu0.le]
  have hb : (X ^ ((3 : ℝ) / 4)) ^ c = X ^ (3 * c / 4) := by
    rw [← Real.rpow_mul hX0.le]; ring_nf
  have hd : (G * X * u⁻¹) ^ c = G ^ c * X ^ c * u ^ (-c) := by
    rw [Real.mul_rpow (by positivity) (by positivity),
      Real.mul_rpow (by positivity) (by positivity), Real.inv_rpow hu0.le, Real.rpow_neg hu0.le]
  have hDc : D ^ c ≤ D := by
    calc D ^ c ≤ D ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hD hc1.le
      _ = D := Real.rpow_one D
  have hGc : G ^ c ≤ G := by
    calc G ^ c ≤ G ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hG hc1.le
      _ = G := Real.rpow_one G
  have key1 : u ^ (-(3 / 4) * c) * u ^ (c / 2) = u ^ (-(c / 4)) := by
    rw [← Real.rpow_add hu0]; ring_nf
  have key2 : u ^ (-c) * u ^ (c / 2) ≤ u ^ (-(c / 4)) := by
    rw [← Real.rpow_add hu0]
    exact Real.rpow_le_rpow_of_exponent_le hu (by linarith)
  have key3 : u ^ (c / 2) ≤ u ^ ((1 : ℝ) / 2) :=
    Real.rpow_le_rpow_of_exponent_le hu (by linarith)
  have hsub := rpow_add3_le (a := D * X * u ^ (-(3 / 4 : ℝ))) (b := X ^ ((3 : ℝ) / 4))
    (d := G * X * u⁻¹) (by positivity) (by positivity) (by positivity) hc0.le hc1.le
  have hXc : 0 ≤ X ^ c := by positivity
  calc (D * X * u ^ (-(3 / 4 : ℝ)) + X ^ ((3 : ℝ) / 4) + G * X * u⁻¹) ^ c * W
      ≤ ((D * X * u ^ (-(3 / 4 : ℝ))) ^ c + (X ^ ((3 : ℝ) / 4)) ^ c + (G * X * u⁻¹) ^ c) * W :=
        mul_le_mul_of_nonneg_right hsub hW0
    _ ≤ ((D * X * u ^ (-(3 / 4 : ℝ))) ^ c + (X ^ ((3 : ℝ) / 4)) ^ c + (G * X * u⁻¹) ^ c) *
          u ^ (c / 2) := by gcongr
    _ = D ^ c * X ^ c * (u ^ (-(3 / 4) * c) * u ^ (c / 2)) + X ^ (3 * c / 4) * u ^ (c / 2) +
          G ^ c * X ^ c * (u ^ (-c) * u ^ (c / 2)) := by rw [ha, hb, hd]; ring
    _ ≤ D * X ^ c * u ^ (-(c / 4)) + X ^ (3 * c / 4) * u ^ ((1 : ℝ) / 2) +
          G * X ^ c * u ^ (-(c / 4)) := by
        rw [key1]
        gcongr
    _ = (D + G) * X ^ c * u ^ (-(c / 4)) + X ^ (3 * c / 4) * u ^ ((1 : ℝ) / 2) := by ring

/- ### Constants -/

/-- `max(cMert, 0)`. -/
noncomputable def cMert' : ℝ := max cMert 0

lemma prod_one_add_div_le' (a : ℕ) (Y : ℕ) (hY : 2 ≤ Y) :
    ∏ p ∈ primesLE Y, (1 + (a : ℝ) / p) ≤ Real.exp (a * cMert') * Real.log Y ^ a := by
  refine (prod_one_add_div_le a Y hY).trans ?_
  have hlog : 0 ≤ Real.log Y := Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ Y))
  gcongr
  exact le_max_left _ _

/-- The exponent `e_m = 6m + 7^m - 1` in the moment bound. -/
def em (m : ℕ) : ℕ := 6 * m + (7 ^ m - 1)

/-- The constant in the moment bound. -/
noncomputable def Cmom (m : ℕ) : ℝ :=
  3 * Real.exp (6 * cMert') ^ m * Real.exp ((7 ^ m - 1 : ℕ) * cMert')

lemma one_le_Cmom (m : ℕ) : 1 ≤ Cmom m := by
  unfold Cmom
  have h1 : 1 ≤ Real.exp (6 * cMert') ^ m :=
    one_le_pow₀ (Real.one_le_exp (by unfold cMert'; positivity))
  have h2 : 1 ≤ Real.exp ((7 ^ m - 1 : ℕ) * cMert') :=
    Real.one_le_exp (by unfold cMert'; positivity)
  nlinarith

/-- `D = 6^{6^4}`, the constant in `|C_q| ≤ D q^{-3/4}`. -/
noncomputable def Dconst : ℝ := (6 : ℝ) ^ (6 ^ 4)

lemma one_le_Dconst : 1 ≤ Dconst := by unfold Dconst; exact one_le_pow₀ (by norm_num)

lemma card_Ico_dyadic (X : ℕ) : (Ico (X : ℤ) (2 * X)).card = X := by
  rw [Int.card_Ico]; omega

/- ### Estimates for blocks of the Ramanujan expansion -/

/-- `m`-th moment of a block over `[X, 2X)`. -/
lemma moment_block (R X Y : ℕ) (hX : 1 ≤ X) (hY : 2 ≤ Y) (hR : 1 ≤ R)
    (B : Finset (Finset ℕ)) (hB : B ⊆ UR R) (hBY : ∀ U ∈ B, U ⊆ primesLE Y) (m : ℕ) :
    ∑ x ∈ Ico (X : ℤ) (2 * X), |ramExp B (CR R) x| ^ m ≤ Cmom m * X * Real.log Y ^ em m := by
  have hI : ∀ V ⊆ primesLE Y, (((Ico (X : ℤ) (2 * X)).filter
      (fun n => ((qU V : ℕ) : ℤ) ∣ n)).card : ℝ) ≤ 3 * (Ico (X : ℤ) (2 * X)).card / qU V := by
    intro V hV
    rw [card_Ico_dyadic]
    exact card_filter_dvd_dyadic X (qU V) hX (qU_pos fun p hp => prime_of_mem_primesLE (hV hp))
  have h := sum_pow_abs_ramExp_le Y B hBY (CR R) 6 (by norm_num)
    (fun U hU => abs_CR_le_six R hR (hB hU)) _ 3 hI m
  rw [card_Ico_dyadic] at h
  have h6 := prod_one_add_div_le' 6 Y hY
  have h7 := prod_one_add_div_le' (7 ^ m - 1) Y hY
  have e7 : ((1 + 6 : ℝ) ^ m - 1) = ((7 ^ m - 1 : ℕ) : ℝ) := by
    rw [Nat.cast_sub (Nat.one_le_pow _ _ (by norm_num))]; push_cast; ring
  rw [e7] at h
  push_cast at h6
  have hlog : 0 ≤ Real.log Y := Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ Y))
  have hP6 : 0 ≤ ∏ p ∈ primesLE Y, (1 + (6 : ℝ) / p) := Finset.prod_nonneg fun p _ => by positivity
  have hP7 : 0 ≤ ∏ p ∈ primesLE Y, (1 + ((7 ^ m - 1 : ℕ) : ℝ) / p) :=
    Finset.prod_nonneg fun p _ => by positivity
  calc ∑ x ∈ Ico (X : ℤ) (2 * X), |ramExp B (CR R) x| ^ m
      ≤ 3 * X * (∏ p ∈ primesLE Y, (1 + (6 : ℝ) / p)) ^ m *
          ∏ p ∈ primesLE Y, (1 + ((7 ^ m - 1 : ℕ) : ℝ) / p) := h
    _ ≤ 3 * X * (Real.exp (6 * cMert') * Real.log Y ^ 6) ^ m *
          (Real.exp ((7 ^ m - 1 : ℕ) * cMert') * Real.log Y ^ (7 ^ m - 1)) := by
        gcongr
    _ = Cmom m * X * Real.log Y ^ em m := by
        unfold Cmom em
        rw [mul_pow, ← pow_mul, pow_add]
        ring

/-- `|C_q| ≤ D q^{-3/4}`. -/
lemma abs_CR_le_rpow (R : ℕ) (hR : 1 ≤ R) {U : Finset ℕ} (hU : U ∈ UR R) :
    |CR R U| ≤ Dconst * (qU U : ℝ) ^ (-(3 / 4 : ℝ)) := by
  have hq : (0 : ℝ) < qU U := by exact_mod_cast qU_pos (UR_primes hU)
  have h1 := abs_CR_le_six R hR hU
  have e : ∏ p ∈ U, (6 : ℝ) / p = (6 : ℝ) ^ U.card / qU U := by
    rw [Finset.prod_div_distrib, Finset.prod_const]; unfold qU; push_cast; rfl
  rw [e] at h1
  have h2 := rpow_card_le 6 (by norm_num) U fun p hp => (UR_primes hU p hp).one_lt.le
  push_cast at h2
  refine h1.trans ?_
  rw [div_le_iff₀ hq]
  calc (6 : ℝ) ^ U.card ≤ (6 : ℝ) ^ (6 ^ 4) * (qU U : ℝ) ^ ((1 : ℝ) / 4) := h2
    _ = Dconst * (qU U : ℝ) ^ (-(3 / 4 : ℝ)) * qU U := by
        unfold Dconst
        have e2 : (qU U : ℝ) ^ (-(3 / 4 : ℝ)) * qU U = (qU U : ℝ) ^ ((1 : ℝ) / 4) := by
          rw [← Real.rpow_add_one hq.ne' (-(3 / 4 : ℝ))]; norm_num
        rw [mul_assoc, e2]

lemma sum_abs_CR_qU_le (R : ℕ) (hR : 1 ≤ R) :
    ∑ U ∈ UR R, |CR R U| * qU U ≤ (R : ℝ) ^ 8 := by
  calc ∑ U ∈ UR R, |CR R U| * qU U ≤ ∑ U ∈ UR R, (R : ℝ) ^ 6 := by
        refine Finset.sum_le_sum fun U hU => ?_
        have h1 := qU_le_sq_of_mem_UR hU
        have h0 : (0 : ℝ) ≤ qU U := by positivity
        calc |CR R U| * qU U ≤ (qU U : ℝ) ^ 2 * qU U := by
              gcongr; exact abs_CR_le_pow R hR hU
          _ = (qU U : ℝ) ^ 3 := by ring
          _ ≤ ((R : ℝ) ^ 2) ^ 3 := by gcongr
          _ = (R : ℝ) ^ 6 := by ring
    _ = (UR R).card * (R : ℝ) ^ 6 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (R : ℝ) ^ 2 * (R : ℝ) ^ 6 := by
        gcongr
        exact_mod_cast card_UR_le R
    _ = (R : ℝ) ^ 8 := by ring

/-- **Estimates for one block** `f = ∑_{U ∈ B} C_U c_{q_U}` with all `q_U > 2^i`, thresholded at
`T = (2^i)^{c/2}`: sup bound, `ℓ¹` bound of the discarded part, and Fourier bound. -/
theorem block_bounds (c : ℝ) (hc0 : 0 < c) (hc1 : c < 1) (m : ℕ) (hm1 : 1 ≤ m)
    (hm : 4 ≤ c * ((m : ℝ) - 1))
    (R X Y i : ℕ) (hR : 1 ≤ R) (hX : 1 ≤ X) (hRX : (R : ℝ) ^ 16 ≤ X) (hY : 2 ≤ Y)
    (B : Finset (Finset ℕ)) (hB : B ⊆ UR R) (hBi : ∀ U ∈ B, 2 ^ i < qU U)
    (hBY : ∀ U ∈ B, U ⊆ primesLE Y) (Cp : ℝ) (hCp : 0 ≤ Cp)
    (hlog : Real.log Y ^ em m ≤ Cp * 2 ^ i) :
    (∀ x, |(if |ramExp B (CR R) x| ≤ ((2 : ℝ) ^ i) ^ (c / 2) then ramExp B (CR R) x else 0)| ≤
        ((2 : ℝ) ^ i) ^ (c / 2)) ∧
    (∑ x ∈ Ico (X : ℤ) (2 * X), |ramExp B (CR R) x -
        (if |ramExp B (CR R) x| ≤ ((2 : ℝ) ^ i) ^ (c / 2) then ramExp B (CR R) x else 0)| ≤
      Cmom m * Cp * X * ((2 : ℝ) ^ i)⁻¹) ∧
    (∀ θ : ℝ, ‖∑ x ∈ Ico (X : ℤ) (2 * X),
        (((if |ramExp B (CR R) x| ≤ ((2 : ℝ) ^ i) ^ (c / 2) then ramExp B (CR R) x else 0) :
          ℝ) : ℂ) * ee (θ * x)‖ ≤
      Dconst * X * ((2 : ℝ) ^ i) ^ (-(3 / 4 : ℝ)) + (X : ℝ) ^ ((3 : ℝ) / 4) +
        Cmom m * Cp * X * ((2 : ℝ) ^ i)⁻¹) := by
  set f : ℤ → ℝ := ramExp B (CR R) with hf
  set u : ℝ := (2 : ℝ) ^ i with hu
  have hu1 : 1 ≤ u := one_le_pow₀ (by norm_num)
  have hu0 : 0 < u := by linarith
  set T : ℝ := u ^ (c / 2) with hT
  have hT0 : 0 < T := by positivity
  set g : ℤ → ℝ := fun x => if |f x| ≤ T then f x else 0 with hg
  have hXR : (1 : ℝ) ≤ X := by exact_mod_cast hX
  -- sup bound
  have hsup : ∀ x, |g x| ≤ T := by
    intro x
    simp only [hg]
    split_ifs with h
    · exact h
    · rw [abs_zero]; exact hT0.le
  -- discarded part
  have hdisc : ∑ x ∈ Ico (X : ℤ) (2 * X), |f x - g x| ≤ Cmom m * Cp * X * u⁻¹ := by
    have hTm : u ^ 2 ≤ T ^ (m - 1) := by
      rw [hT, ← Real.rpow_natCast (u ^ (c / 2)) (m - 1), ← Real.rpow_mul hu0.le,
        ← Real.rpow_natCast u 2]
      apply Real.rpow_le_rpow_of_exponent_le hu1
      rw [Nat.cast_sub hm1]
      push_cast
      nlinarith
    have hmom := moment_block R X Y hX hY hR B hB hBY m
    calc ∑ x ∈ Ico (X : ℤ) (2 * X), |f x - g x|
        ≤ ∑ x ∈ Ico (X : ℤ) (2 * X), |f x| ^ m / T ^ (m - 1) :=
          Finset.sum_le_sum fun x _ => abs_sub_thresh_le (f x) T hT0 m hm1
      _ = (∑ x ∈ Ico (X : ℤ) (2 * X), |f x| ^ m) / T ^ (m - 1) := by rw [Finset.sum_div]
      _ ≤ (Cmom m * X * Real.log Y ^ em m) / T ^ (m - 1) := by gcongr
      _ ≤ (Cmom m * X * (Cp * u)) / u ^ 2 := by
          have hC : 0 ≤ Cmom m * X := by
            have := one_le_Cmom m; positivity
          gcongr
      _ = Cmom m * Cp * X * u⁻¹ := by field_simp
  refine ⟨hsup, hdisc, fun θ => ?_⟩
  -- Fourier bound
  have hRR : 1 ≤ R ^ 2 := Nat.one_le_pow _ _ (by omega)
  have hFf := norm_fourier_ramExp_le B (fun U hU => UR_primes (hB hU)) (R ^ 2) hRR
    (fun U hU => (UR_spec (hB hU)).2) (CR R) (Dconst * u ^ (-(3 / 4 : ℝ)))
    (by have := one_le_Dconst; positivity)
    (fun U hU => by
      refine (abs_CR_le_rpow R hR (hB hU)).trans ?_
      have := one_le_Dconst
      have hlt : (2 : ℝ) ^ i < qU U := by exact_mod_cast hBi U hU
      exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_nonpos hu0 hlt.le (by norm_num))
        (by linarith))
    (X : ℤ) (2 * X) θ
  rw [card_Ico_dyadic] at hFf
  have hfar : ((R ^ 2 : ℕ) : ℝ) ^ 2 * ∑ U ∈ B, |CR R U| * qU U ≤ (X : ℝ) ^ ((3 : ℝ) / 4) := by
    have h1 : ∑ U ∈ B, |CR R U| * qU U ≤ (R : ℝ) ^ 8 :=
      (Finset.sum_le_sum_of_subset_of_nonneg hB (fun _ _ _ => by positivity)).trans
        (sum_abs_CR_qU_le R hR)
    have h2 : ((R : ℝ) ^ 16) ^ ((3 : ℝ) / 4) ≤ (X : ℝ) ^ ((3 : ℝ) / 4) :=
      Real.rpow_le_rpow (by positivity) hRX (by norm_num)
    have h3 : ((R : ℝ) ^ 16) ^ ((3 : ℝ) / 4) = (R : ℝ) ^ 12 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
      norm_num
    calc ((R ^ 2 : ℕ) : ℝ) ^ 2 * ∑ U ∈ B, |CR R U| * qU U ≤ ((R ^ 2 : ℕ) : ℝ) ^ 2 * (R : ℝ) ^ 8 := by
          gcongr
      _ = (R : ℝ) ^ 12 := by push_cast; ring
      _ ≤ (X : ℝ) ^ ((3 : ℝ) / 4) := by rw [← h3]; exact h2
  have hsplit : ∑ x ∈ Ico (X : ℤ) (2 * X), ((g x : ℝ) : ℂ) * ee (θ * x) =
      ∑ x ∈ Ico (X : ℤ) (2 * X), ((f x : ℝ) : ℂ) * ee (θ * x) -
        ∑ x ∈ Ico (X : ℤ) (2 * X), (((f x - g x : ℝ)) : ℂ) * ee (θ * x) := by
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun x _ => ?_
    push_cast; ring
  have hdiscF : ‖∑ x ∈ Ico (X : ℤ) (2 * X), (((f x - g x : ℝ)) : ℂ) * ee (θ * x)‖ ≤
      ∑ x ∈ Ico (X : ℤ) (2 * X), |f x - g x| := by
    refine (norm_sum_le _ _).trans (le_of_eq (Finset.sum_congr rfl fun x _ => ?_))
    rw [norm_mul, norm_ee, mul_one, Complex.norm_real, Real.norm_eq_abs]
  calc ‖∑ x ∈ Ico (X : ℤ) (2 * X), ((g x : ℝ) : ℂ) * ee (θ * x)‖
      ≤ ‖∑ x ∈ Ico (X : ℤ) (2 * X), ((f x : ℝ) : ℂ) * ee (θ * x)‖ +
          ‖∑ x ∈ Ico (X : ℤ) (2 * X), (((f x - g x : ℝ)) : ℂ) * ee (θ * x)‖ := by
        rw [hsplit]; exact norm_sub_le _ _
    _ ≤ (X * (Dconst * u ^ (-(3 / 4 : ℝ))) + (X : ℝ) ^ ((3 : ℝ) / 4)) +
          Cmom m * Cp * X * u⁻¹ := by
        gcongr
        · exact hFf.trans (by linarith)
        · exact hdiscF.trans hdisc
    _ = Dconst * X * u ^ (-(3 / 4 : ℝ)) + (X : ℝ) ^ ((3 : ℝ) / 4) + Cmom m * Cp * X * u⁻¹ := by
        ring

/- ### Partition of the Ramanujan expansion into dyadic blocks -/

/-- Block condition: `2^{i₀+j} < q`, and `q ≤ 2^{i₀+j+1}` unless `j = N` (the last block). -/
def blkCond (i0 N j q : ℕ) : Prop := 2 ^ (i0 + j) < q ∧ (j < N → q ≤ 2 ^ (i0 + j + 1))

instance (i0 N j q : ℕ) : Decidable (blkCond i0 N j q) := by
  unfold blkCond; infer_instance

lemma ind_split {a b q : ℕ} (hab : a < b) :
    (if a < q ∧ q ≤ b then (1 : ℝ) else 0) + (if b < q then (1 : ℝ) else 0) =
      if a < q then 1 else 0 := by
  by_cases h1 : a < q
  · by_cases h2 : q ≤ b
    · rw [if_pos ⟨h1, h2⟩, if_neg (by omega), if_pos h1]; norm_num
    · rw [if_neg (by tauto), if_pos (by omega), if_pos h1]; norm_num
  · rw [if_neg (by tauto), if_neg (by omega), if_neg h1]; norm_num

lemma indicator_dyadic (i0 q N : ℕ) :
    ∑ j ∈ range N, (if 2 ^ (i0 + j) < q ∧ q ≤ 2 ^ (i0 + j + 1) then (1 : ℝ) else 0) +
      (if 2 ^ (i0 + N) < q then (1 : ℝ) else 0) = if 2 ^ i0 < q then 1 else 0 := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, ← ih, add_assoc]
    congr 1
    have hab : 2 ^ (i0 + N) < 2 ^ (i0 + N + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
    rw [show i0 + (N + 1) = i0 + N + 1 by ring]
    exact ind_split hab

lemma indicator_partition (i0 N q : ℕ) :
    (if q ≤ 2 ^ i0 then (1 : ℝ) else 0) +
      ∑ j ∈ range (N + 1), (if blkCond i0 N j q then (1 : ℝ) else 0) = 1 := by
  have h1 : ∑ j ∈ range (N + 1), (if blkCond i0 N j q then (1 : ℝ) else 0) =
      ∑ j ∈ range N, (if 2 ^ (i0 + j) < q ∧ q ≤ 2 ^ (i0 + j + 1) then (1 : ℝ) else 0) +
        (if 2 ^ (i0 + N) < q then (1 : ℝ) else 0) := by
    rw [Finset.sum_range_succ]
    congr 1
    · refine Finset.sum_congr rfl fun j hj => ?_
      have hjN : j < N := Finset.mem_range.mp hj
      have hiff : blkCond i0 N j q ↔ (2 ^ (i0 + j) < q ∧ q ≤ 2 ^ (i0 + j + 1)) :=
        ⟨fun h => ⟨h.1, h.2 hjN⟩, fun h => ⟨h.1, fun _ => h.2⟩⟩
      by_cases h : blkCond i0 N j q
      · rw [if_pos h, if_pos (hiff.mp h)]
      · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
    · have hiff : blkCond i0 N N q ↔ 2 ^ (i0 + N) < q :=
        ⟨fun h => h.1, fun h => ⟨h, fun h' => absurd h' (lt_irrefl N)⟩⟩
      by_cases h : blkCond i0 N N q
      · rw [if_pos h, if_pos (hiff.mp h)]
      · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
  rw [h1, indicator_dyadic]
  by_cases h : q ≤ 2 ^ i0
  · rw [if_pos h, if_neg (by omega)]; norm_num
  · rw [if_neg h, if_pos (by omega)]; norm_num

lemma ramExp_partition (B : Finset (Finset ℕ)) (C : Finset ℕ → ℝ) (i0 N : ℕ) (x : ℤ) :
    ramExp B C x = ramExp (B.filter (fun U => qU U ≤ 2 ^ i0)) C x +
      ∑ j ∈ range (N + 1), ramExp (B.filter (fun U => blkCond i0 N j (qU U))) C x := by
  unfold ramExp
  simp_rw [Finset.sum_filter]
  rw [Finset.sum_comm (s := range (N + 1)), ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun U _ => ?_
  have h := indicator_partition i0 N (qU U)
  calc C U * cT U x = ((if qU U ≤ 2 ^ i0 then (1 : ℝ) else 0) +
        ∑ j ∈ range (N + 1), (if blkCond i0 N j (qU U) then (1 : ℝ) else 0)) * (C U * cT U x) := by
        rw [h, one_mul]
    _ = _ := by
        rw [add_mul, Finset.sum_mul]
        congr 1
        · split_ifs <;> ring
        · refine Finset.sum_congr rfl fun j _ => ?_
          split_ifs <;> ring

/- ### Parameters -/

/-- The sieve level `R(X) = ⌊X^{1/16}⌋`. -/
noncomputable def Rof (X : ℕ) : ℕ := ⌊(X : ℝ) ^ ((1 : ℝ) / 16)⌋₊

lemma Rof_pow_le (X : ℕ) : ((Rof X : ℕ) : ℝ) ^ 16 ≤ X := by
  have h0 : (0 : ℝ) ≤ (X : ℝ) ^ ((1 : ℝ) / 16) := by positivity
  have h1 : ((Rof X : ℕ) : ℝ) ≤ (X : ℝ) ^ ((1 : ℝ) / 16) := Nat.floor_le h0
  calc ((Rof X : ℕ) : ℝ) ^ 16 ≤ ((X : ℝ) ^ ((1 : ℝ) / 16)) ^ 16 := by gcongr
    _ = (X : ℝ) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
        norm_num

lemma log_le_Rof (X : ℕ) (hX : 1 ≤ X) : Real.log X ≤ 16 * Real.log ((Rof X : ℝ) + 1) := by
  have hX0 : (0 : ℝ) < X := by exact_mod_cast hX
  have h1 : (X : ℝ) ^ ((1 : ℝ) / 16) < (Rof X : ℝ) + 1 := Nat.lt_floor_add_one _
  have h2 : Real.log ((X : ℝ) ^ ((1 : ℝ) / 16)) ≤ Real.log ((Rof X : ℝ) + 1) :=
    Real.log_le_log (by positivity) h1.le
  rw [Real.log_rpow hX0] at h2
  linarith

lemma two_le_Rof (X : ℕ) (hX : 2 ^ 16 ≤ X) : 2 ≤ Rof X := by
  unfold Rof
  apply Nat.le_floor
  have hX' : ((2 : ℝ) ^ 16) ≤ X := by exact_mod_cast hX
  calc ((2 : ℕ) : ℝ) = ((2 : ℝ) ^ 16) ^ ((1 : ℝ) / 16) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; norm_num
    _ ≤ (X : ℝ) ^ ((1 : ℝ) / 16) := Real.rpow_le_rpow (by positivity) hX' (by norm_num)

/-- **The majorant** `Λ̃` for the interval `[X, 2X)`: the Selberg majorant of level
`R = ⌊X^{1/16}⌋`. -/
noncomputable def majorant (X : ℕ) (n : ℤ) : ℝ := selbergMajorant (Rof X) n

lemma one_le_log_of_le {X : ℕ} (hX : 2 ^ 16 ≤ X) : 1 ≤ Real.log X := by
  rw [Real.le_log_iff_exp_le (by exact_mod_cast (by omega : 0 < X))]
  have h1 : Real.exp 1 < 3 := by
    have := Real.exp_one_lt_d9; linarith
  have h2 : (3 : ℝ) ≤ X := by exact_mod_cast (by omega : 3 ≤ X)
  linarith

/-- `log X < L + 1` and `L + 1 ≤ 3 log X` for `L = ⌊log₂ X⌋`. -/
lemma log_bounds (X : ℕ) (hX : 2 ^ 16 ≤ X) :
    Real.log X < (Nat.log 2 X : ℝ) + 1 ∧ (Nat.log 2 X : ℝ) + 1 ≤ 3 * Real.log X := by
  have hX0 : 0 < X := by omega
  have hXR : (0 : ℝ) < X := by exact_mod_cast hX0
  have hlog1 := one_le_log_of_le hX
  have hlog2 : (1 : ℝ) / 2 < Real.log 2 := by have := Real.log_two_gt_d9; linarith
  have hlog2' : Real.log 2 < 1 := by have := Real.log_two_lt_d9; linarith
  constructor
  · have h1 : X < 2 ^ (Nat.log 2 X).succ := Nat.lt_pow_succ_log_self (by norm_num) X
    have h2 : (X : ℝ) < (2 : ℝ) ^ (Nat.log 2 X + 1) := by exact_mod_cast h1
    have h3 : Real.log X < Real.log ((2 : ℝ) ^ (Nat.log 2 X + 1)) := Real.log_lt_log hXR h2
    rw [Real.log_pow] at h3
    push_cast at h3
    have : ((Nat.log 2 X : ℝ) + 1) * Real.log 2 ≤ (Nat.log 2 X : ℝ) + 1 := by
      have : (0 : ℝ) ≤ (Nat.log 2 X : ℝ) + 1 := by positivity
      nlinarith
    linarith
  · have h1 : 2 ^ Nat.log 2 X ≤ X := Nat.pow_log_le_self 2 hX0.ne'
    have h2 : (2 : ℝ) ^ Nat.log 2 X ≤ X := by exact_mod_cast h1
    have h3 : Real.log ((2 : ℝ) ^ Nat.log 2 X) ≤ Real.log X := Real.log_le_log (by positivity) h2
    rw [Real.log_pow] at h3
    have : (Nat.log 2 X : ℝ) * (1 / 2) ≤ (Nat.log 2 X : ℝ) * Real.log 2 := by
      have : (0 : ℝ) ≤ Nat.log 2 X := by positivity
      nlinarith
    linarith

/-- With `N = β(ℓ+1)`, `ℓ = ⌊log₂(L+1)⌋`: `(log X)^β ≤ 2^N ≤ (6 log X)^β`. -/
lemma two_pow_N_bounds (X β : ℕ) (hX : 2 ^ 16 ≤ X) :
    Real.log X ^ β ≤ (2 : ℝ) ^ (β * (Nat.log 2 (Nat.log 2 X + 1) + 1)) ∧
      (2 : ℝ) ^ (β * (Nat.log 2 (Nat.log 2 X + 1) + 1)) ≤ (6 * Real.log X) ^ β := by
  obtain ⟨hA, hB⟩ := log_bounds X hX
  set L := Nat.log 2 X
  set ℓ := Nat.log 2 (L + 1)
  have hlog1 := one_le_log_of_le hX
  have e : (2 : ℝ) ^ (β * (ℓ + 1)) = ((2 : ℝ) ^ (ℓ + 1)) ^ β := by rw [← pow_mul, mul_comm]
  rw [e]
  constructor
  · have h1 : L + 1 < 2 ^ (ℓ + 1) := Nat.lt_pow_succ_log_self (by norm_num) (L + 1)
    have h2 : ((L : ℝ) + 1) < (2 : ℝ) ^ (ℓ + 1) := by exact_mod_cast h1
    gcongr
    linarith
  · have h1 : 2 ^ ℓ ≤ L + 1 := Nat.pow_log_le_self 2 (by omega)
    have h2 : (2 : ℝ) ^ ℓ ≤ (L : ℝ) + 1 := by exact_mod_cast h1
    gcongr
    rw [pow_succ]
    linarith

/-- For `i₀ = ⌊log₂ Q⌋`: `2^{i₀} ≤ Q < 2 · 2^{i₀}`. -/
lemma i0_bounds (Q : ℕ) (hQ : 2 ≤ Q) :
    (2 : ℝ) ^ Nat.log 2 Q ≤ Q ∧ (Q : ℝ) < 2 * 2 ^ Nat.log 2 Q ∧ 1 ≤ Nat.log 2 Q := by
  refine ⟨?_, ?_, Nat.log_pos (by norm_num) hQ⟩
  · exact_mod_cast Nat.pow_log_le_self 2 (by omega : Q ≠ 0)
  · have := Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) Q
    rw [pow_succ] at this
    have : (Q : ℝ) < (2 : ℝ) ^ Nat.log 2 Q * 2 := by exact_mod_cast this
    linarith

lemma sum_inv_two_pow_le (i0 n : ℕ) :
    ∑ j ∈ range n, ((2 : ℝ) ^ (i0 + j))⁻¹ ≤ 2 * ((2 : ℝ) ^ i0)⁻¹ := by
  have e : ∀ j, ((2 : ℝ) ^ (i0 + j))⁻¹ = ((2 : ℝ) ^ i0)⁻¹ * (1 / 2) ^ j := by
    intro j; rw [pow_add, mul_inv, one_div, inv_pow]
  simp_rw [e]
  rw [← Finset.mul_sum, mul_comm]
  have hg : ∑ j ∈ range n, ((1 : ℝ) / 2) ^ j ≤ 2 := by
    have := geom_sum_Ico_le_of_lt_one (m := 0) (n := n) (x := (1 : ℝ) / 2) (by norm_num)
      (by norm_num)
    rw [Finset.range_eq_Ico]
    calc ∑ j ∈ Ico 0 n, ((1 : ℝ) / 2) ^ j ≤ ((1 : ℝ) / 2) ^ 0 / (1 - 1 / 2) := this
      _ = 2 := by norm_num
  gcongr

lemma sum_two_pow_le (i0 n : ℕ) : ∑ j ∈ range n, (2 : ℝ) ^ (i0 + j) ≤ 2 ^ i0 * 2 ^ n := by
  have e : ∀ j, (2 : ℝ) ^ (i0 + j) = 2 ^ i0 * 2 ^ j := fun j => pow_add _ _ _
  simp_rw [e]
  rw [← Finset.mul_sum]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  have := geom_sum_eq (x := (2 : ℝ)) (by norm_num) n
  rw [this]
  norm_num

lemma sum_rpow_neg_le (c : ℝ) (hc : 0 < c) (i0 n : ℕ) :
    ∑ j ∈ range n, ((2 : ℝ) ^ (i0 + j)) ^ (-(c / 4)) ≤
      ((2 : ℝ) ^ i0) ^ (-(c / 4)) / (1 - (2 : ℝ) ^ (-(c / 4))) := by
  set r : ℝ := (2 : ℝ) ^ (-(c / 4)) with hr
  have hr0 : 0 ≤ r := by positivity
  have hr1 : r < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have e : ∀ j, ((2 : ℝ) ^ (i0 + j)) ^ (-(c / 4)) = ((2 : ℝ) ^ i0) ^ (-(c / 4)) * r ^ j := by
    intro j
    rw [pow_add, Real.mul_rpow (by positivity) (by positivity), hr]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast,
      ← Real.rpow_mul (by norm_num), mul_comm]
  simp_rw [e]
  rw [← Finset.mul_sum]
  have hg : ∑ j ∈ range n, r ^ j ≤ 1 / (1 - r) := by
    have := geom_sum_Ico_le_of_lt_one (m := 0) (n := n) hr0 hr1
    rw [Finset.range_eq_Ico]; simpa using this
  calc ((2 : ℝ) ^ i0) ^ (-(c / 4)) * ∑ j ∈ range n, r ^ j
      ≤ ((2 : ℝ) ^ i0) ^ (-(c / 4)) * (1 / (1 - r)) :=
        mul_le_mul_of_nonneg_left hg (by positivity)
    _ = ((2 : ℝ) ^ i0) ^ (-(c / 4)) / (1 - r) := by ring

/- ### Auxiliary estimates for the periodic part -/

/-- Distinct primes `≤ Q` have product dividing `Q!`. -/
lemma qU_dvd_factorial {V : Finset ℕ} {Q : ℕ} (hV : ∀ p ∈ V, p.Prime ∧ p ≤ Q) :
    qU V ∣ Q.factorial := by
  unfold qU
  exact Finset.prod_primes_dvd _ (fun p hp => (hV p hp).1.prime)
    fun p hp => Nat.dvd_factorial (hV p hp).1.pos (hV p hp).2

/-- First moment of a Ramanujan expansion with all primes `≤ Y ≤ Q` over a full period `Q!`. -/
lemma moment_period (R Y Q : ℕ) (hR : 1 ≤ R) (hY : 2 ≤ Y) (hYQ : Y ≤ Q)
    (B : Finset (Finset ℕ)) (hB : B ⊆ UR R) (hBY : ∀ U ∈ B, U ⊆ primesLE Y) (a : ℤ) :
    ∑ x ∈ Ico a (a + Q.factorial), |ramExp B (CR R) x| ≤
      Cmom 1 * Q.factorial * Real.log Y ^ 12 := by
  have hI : ∀ V ⊆ primesLE Y, (((Ico a (a + Q.factorial)).filter
      (fun n => ((qU V : ℕ) : ℤ) ∣ n)).card : ℝ) ≤
        1 * (Ico a (a + Q.factorial)).card / qU V := by
    intro V hV
    have hVp : ∀ p ∈ V, p.Prime ∧ p ≤ Q := fun p hp =>
      ⟨(mem_primesLE.mp (hV hp)).1, (mem_primesLE.mp (hV hp)).2.trans hYQ⟩
    have hdvd := qU_dvd_factorial hVp
    have hq := qU_pos fun p hp => (hVp p hp).1
    rw [card_filter_dvd_period a Q.factorial (qU V) hq hdvd, Int.card_Ico]
    have : (a + (Q.factorial : ℤ) - a).toNat = Q.factorial := by omega
    rw [this, one_mul]
  have h := sum_pow_abs_ramExp_le Y B hBY (CR R) 6 (by norm_num)
    (fun U hU => abs_CR_le_six R hR (hB hU)) _ 1 hI 1
  simp only [pow_one] at h
  rw [Int.card_Ico, show (a + (Q.factorial : ℤ) - a).toNat = Q.factorial by omega] at h
  have h6 := prod_one_add_div_le' 6 Y hY
  push_cast at h6
  have hlog : 0 ≤ Real.log Y := Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ Y))
  have hP6 : 0 ≤ ∏ p ∈ primesLE Y, (1 + (6 : ℝ) / p) := Finset.prod_nonneg fun p _ => by positivity
  have e7 : ((1 + 6 : ℝ) - 1) = 6 := by norm_num
  rw [e7] at h
  have hQ0 : (0 : ℝ) ≤ Q.factorial := by positivity
  calc ∑ x ∈ Ico a (a + Q.factorial), |ramExp B (CR R) x|
      ≤ 1 * Q.factorial * (∏ p ∈ primesLE Y, (1 + (6 : ℝ) / p)) *
          ∏ p ∈ primesLE Y, (1 + (6 : ℝ) / p) := h
    _ ≤ 1 * Q.factorial * (Real.exp (6 * cMert') * Real.log Y ^ 6) *
          (Real.exp (6 * cMert') * Real.log Y ^ 6) := by gcongr
    _ ≤ Cmom 1 * Q.factorial * Real.log Y ^ 12 := by
        unfold Cmom
        have hE : 0 ≤ Real.exp (6 * cMert') ^ 2 * Real.log Y ^ 12 * Q.factorial := by positivity
        have e : ((7 ^ 1 - 1 : ℕ) : ℝ) = 6 := by norm_num
        rw [e]
        nlinarith

/-- The constant `(6⁴)^{6⁴}` in the sup bound of the periodic part. -/
irreducible_def Dsup : ℝ := ((6 : ℝ) ^ 4) ^ (6 ^ 4)

lemma Dsup_nonneg : 0 ≤ Dsup := by rw [Dsup_def]; positivity

lemma six_pow_card_le_Dsup (U : Finset ℕ) (hU : ∀ p ∈ U, 1 ≤ p) :
    (6 : ℝ) ^ U.card ≤ Dsup * qU U := by
  have h3 := pow_card_le_qU 6 (by norm_num) U hU
  have h5 : 6 ^ U.card ≤ (6 ^ 4) ^ U.card := Nat.pow_le_pow_left (by norm_num) _
  have h4 := (Nat.cast_le (α := ℝ)).mpr (h5.trans h3)
  rw [Nat.cast_mul, Nat.cast_pow, Nat.cast_pow, Nat.cast_pow] at h4
  rw [Dsup_def]
  simpa using h4

/-- Sup bound for a Ramanujan expansion with all moduli `≤ Q`. -/
lemma sup_per (R Q : ℕ) (hR : 1 ≤ R) (B : Finset (Finset ℕ)) (hB : B ⊆ UR R)
    (hBQ : ∀ U ∈ B, qU U ≤ Q) (x : ℤ) :
    |ramExp B (CR R) x| ≤ Dsup * (Q : ℝ) ^ 2 := by
  have hD := Dsup_nonneg
  have hterm : ∀ U ∈ B, |CR R U * cT U x| ≤ Dsup * Q := by
    intro U hU
    have hUR := hB hU
    have hq : (0 : ℝ) < qU U := by exact_mod_cast qU_pos (UR_primes hUR)
    have h1 := abs_CR_le_six R hR hUR
    have e : ∏ p ∈ U, (6 : ℝ) / p = (6 : ℝ) ^ U.card / qU U := by
      rw [Finset.prod_div_distrib, Finset.prod_const]; unfold qU; push_cast; rfl
    rw [e] at h1
    have h2 : |cT U x| ≤ qU U :=
      abs_cT_le (fun p hp => (UR_primes hUR p hp).one_lt.le) x
    have h3' := six_pow_card_le_Dsup U fun p hp => (UR_primes hUR p hp).one_lt.le
    have hQ : (qU U : ℝ) ≤ Q := by exact_mod_cast hBQ U hU
    rw [abs_mul]
    calc |CR R U| * |cT U x| ≤ (6 : ℝ) ^ U.card / qU U * qU U := by gcongr
      _ = (6 : ℝ) ^ U.card := by field_simp
      _ ≤ Dsup * qU U := h3'
      _ ≤ Dsup * Q := mul_le_mul_of_nonneg_left hQ hD
  have hcard : (B.card : ℝ) ≤ Q := by
    have : B.card ≤ (Finset.Icc 1 Q).card := by
      apply Finset.card_le_card_of_injOn qU
      · intro U hU
        rw [Finset.mem_coe, Finset.mem_Icc]
        exact ⟨qU_pos (UR_primes (hB (Finset.mem_coe.mp hU))), hBQ U (Finset.mem_coe.mp hU)⟩
      · intro U hU U' hU' h
        exact qU_inj (UR_primes (hB (Finset.mem_coe.mp hU)))
          (UR_primes (hB (Finset.mem_coe.mp hU'))) h
    have h' : B.card ≤ Q := by simpa using this
    exact_mod_cast h'
  unfold ramExp
  calc |∑ U ∈ B, CR R U * cT U x| ≤ ∑ U ∈ B, |CR R U * cT U x| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ U ∈ B, Dsup * Q := Finset.sum_le_sum hterm
    _ = B.card * (Dsup * Q) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ Q * (Dsup * Q) := mul_le_mul_of_nonneg_right hcard (mul_nonneg hD (Nat.cast_nonneg Q))
    _ = Dsup * (Q : ℝ) ^ 2 := by ring

/- ### The numerical `(4.6)` summation -/

lemma sum46 (c : ℝ) (hc0 : 0 < c) (hc1 : c < 1) (X Q : ℝ) (hX : 1 ≤ X) (hQ : 2 ≤ Q)
    (hlogX : 1 ≤ Real.log X) (hQX : Q ≤ Real.log X) (i0 n : ℕ)
    (hi0 : Q < 2 * 2 ^ i0) (D G : ℝ) (hD : 1 ≤ D) (hG : 1 ≤ G) (β : ℕ)
    (hsum : ∑ j ∈ range n, (2 : ℝ) ^ (i0 + j) ≤ 2 * 6 ^ β * Real.log X ^ (β + 1)) :
    ∑ j ∈ range n, (D * X * ((2 : ℝ) ^ (i0 + j)) ^ (-(3 / 4 : ℝ)) + X ^ ((3 : ℝ) / 4) +
        G * X * ((2 : ℝ) ^ (i0 + j))⁻¹) ^ c * (((2 : ℝ) ^ (i0 + j)) ^ (c / 2)) ^ (1 - c) ≤
      ((D + G) * 2 * (1 / (1 - (2 : ℝ) ^ (-(c / 4)))) +
        2 * 6 ^ β * (((β + 2 : ℕ) : ℝ) / (c / 4)) ^ (β + 2)) * X ^ c * Q ^ (-(c / 4)) := by
  have hX0 : 0 < X := by linarith
  have hQ0 : 0 < Q := by linarith
  have hr1 : (2 : ℝ) ^ (-(c / 4)) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  set S : ℝ := 1 / (1 - (2 : ℝ) ^ (-(c / 4))) with hS
  have hS0 : 0 < S := by rw [hS]; apply div_pos one_pos; linarith
  set Klog : ℝ := (((β + 2 : ℕ) : ℝ) / (c / 4)) ^ (β + 2) with hKlog
  -- termwise
  have hterm : ∀ j ∈ range n,
      (D * X * ((2 : ℝ) ^ (i0 + j)) ^ (-(3 / 4 : ℝ)) + X ^ ((3 : ℝ) / 4) +
        G * X * ((2 : ℝ) ^ (i0 + j))⁻¹) ^ c * (((2 : ℝ) ^ (i0 + j)) ^ (c / 2)) ^ (1 - c) ≤
      (D + G) * X ^ c * ((2 : ℝ) ^ (i0 + j)) ^ (-(c / 4)) + X ^ (3 * c / 4) * (2 : ℝ) ^ (i0 + j) := by
    intro j _
    have hu : (1 : ℝ) ≤ (2 : ℝ) ^ (i0 + j) := one_le_pow₀ (by norm_num)
    refine (block_46 hu hX hD hG hc0 hc1).trans ?_
    gcongr
    calc ((2 : ℝ) ^ (i0 + j)) ^ ((1 : ℝ) / 2) ≤ ((2 : ℝ) ^ (i0 + j)) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hu (by norm_num)
      _ = (2 : ℝ) ^ (i0 + j) := Real.rpow_one _
  -- the geometric part
  have hgeo := sum_rpow_neg_le c hc0 i0 n
  have hi0' : Q / 2 ≤ (2 : ℝ) ^ i0 := by linarith
  have hpow : ((2 : ℝ) ^ i0) ^ (-(c / 4)) ≤ 2 * Q ^ (-(c / 4)) := by
    calc ((2 : ℝ) ^ i0) ^ (-(c / 4)) ≤ (Q / 2) ^ (-(c / 4)) :=
          Real.rpow_le_rpow_of_nonpos (by positivity) hi0' (by linarith)
      _ = Q ^ (-(c / 4)) * (2 : ℝ) ^ (c / 4) := by
          rw [Real.div_rpow hQ0.le (by norm_num), Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2),
            div_inv_eq_mul]
      _ ≤ Q ^ (-(c / 4)) * 2 := by
          gcongr
          calc (2 : ℝ) ^ (c / 4) ≤ (2 : ℝ) ^ (1 : ℝ) :=
                Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
            _ = 2 := Real.rpow_one 2
      _ = 2 * Q ^ (-(c / 4)) := by ring
  -- the polylogarithmic part
  have hQc : Q ^ (c / 4) ≤ Real.log X := by
    calc Q ^ (c / 4) ≤ Q ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
      _ = Q := Real.rpow_one Q
      _ ≤ Real.log X := hQX
  have hinv : 1 / Real.log X ≤ Q ^ (-(c / 4)) := by
    rw [Real.rpow_neg hQ0.le, ← one_div]
    exact one_div_le_one_div_of_le (by positivity) hQc
  have hlp := log_pow_le X hX (β + 2) (c / 4) (by linarith)
  have hpoly : X ^ (3 * c / 4) * Real.log X ^ (β + 1) ≤ Klog * X ^ c * Q ^ (-(c / 4)) := by
    have e1 : Real.log X ^ (β + 1) = Real.log X ^ (β + 2) * (1 / Real.log X) := by
      field_simp
      ring
    have e2 : X ^ (3 * c / 4) * X ^ (c / 4) = X ^ c := by
      rw [← Real.rpow_add hX0]; ring_nf
    rw [e1]
    have h0 : 0 ≤ X ^ (3 * c / 4) := by positivity
    calc X ^ (3 * c / 4) * (Real.log X ^ (β + 2) * (1 / Real.log X))
        ≤ X ^ (3 * c / 4) * ((((β + 2 : ℕ) : ℝ) / (c / 4)) ^ (β + 2) * X ^ (c / 4) *
            Q ^ (-(c / 4))) := by
          apply mul_le_mul_of_nonneg_left _ h0
          push_cast at hlp ⊢
          exact mul_le_mul hlp hinv (by positivity) (by positivity)
      _ = Klog * (X ^ (3 * c / 4) * X ^ (c / 4)) * Q ^ (-(c / 4)) := by rw [hKlog]; ring
      _ = Klog * X ^ c * Q ^ (-(c / 4)) := by rw [e2]
  have hXc : 0 ≤ X ^ c := by positivity
  have hX34 : 0 ≤ X ^ (3 * c / 4) := by positivity
  calc ∑ j ∈ range n, (D * X * ((2 : ℝ) ^ (i0 + j)) ^ (-(3 / 4 : ℝ)) + X ^ ((3 : ℝ) / 4) +
        G * X * ((2 : ℝ) ^ (i0 + j))⁻¹) ^ c * (((2 : ℝ) ^ (i0 + j)) ^ (c / 2)) ^ (1 - c)
      ≤ ∑ j ∈ range n, ((D + G) * X ^ c * ((2 : ℝ) ^ (i0 + j)) ^ (-(c / 4)) +
          X ^ (3 * c / 4) * (2 : ℝ) ^ (i0 + j)) := Finset.sum_le_sum hterm
    _ = (D + G) * X ^ c * ∑ j ∈ range n, ((2 : ℝ) ^ (i0 + j)) ^ (-(c / 4)) +
          X ^ (3 * c / 4) * ∑ j ∈ range n, (2 : ℝ) ^ (i0 + j) := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ (D + G) * X ^ c * (((2 : ℝ) ^ i0) ^ (-(c / 4)) / (1 - (2 : ℝ) ^ (-(c / 4)))) +
          X ^ (3 * c / 4) * (2 * 6 ^ β * Real.log X ^ (β + 1)) := by
        gcongr
    _ ≤ (D + G) * X ^ c * (2 * Q ^ (-(c / 4)) * S) +
          2 * 6 ^ β * (X ^ (3 * c / 4) * Real.log X ^ (β + 1)) := by
        have : ((2 : ℝ) ^ i0) ^ (-(c / 4)) / (1 - (2 : ℝ) ^ (-(c / 4))) =
            ((2 : ℝ) ^ i0) ^ (-(c / 4)) * S := by rw [hS]; ring
        rw [this]
        have hDG : 0 ≤ (D + G) * X ^ c := by positivity
        nlinarith [mul_le_mul_of_nonneg_right hpow hS0.le]
    _ ≤ (D + G) * X ^ c * (2 * Q ^ (-(c / 4)) * S) +
          2 * 6 ^ β * (Klog * X ^ c * Q ^ (-(c / 4))) := by gcongr
    _ = ((D + G) * 2 * S + 2 * 6 ^ β * Klog) * X ^ c * Q ^ (-(c / 4)) := by ring

end G22.L41

end

/- ## Section: `Lemma41` -/

section

/-
# GS Lemma 4.1: Fourier decomposition of a majorant for the primes

B. Green, M. Sawhney, *Bounds for monochromatic solutions to {x+y, xy}*, arXiv:2511.09365v2,
Lemma 4.1 (cited as GS).

**Statement proved** (`lemma41 : Lemma41Stmt`, with `Λ̃_X = majorant X`):

* `Λ̃_X ≥ 0` everywhere;
* (4.1) `Λ̃_X(p) ≥ (log X)/16` for every prime `p ≥ X` (`X ≥ 2^16`);
* (4.2) `∑_{x∈[X,2X)} Λ̃_X(x) ≤ 2X` (`X ≥ 2^16`);
* for every `c ∈ (0,1)` there are `C > 0`, `E ∈ ℕ` such that for all `X ≥ 2^16` and all `Q ∈ ℕ` with
  `2 ≤ Q ≤ log X` there are a `Q!`-periodic `Λ_per`, `n ∈ ℕ`, functions `g_i, h : ℤ → ℝ` and
  numbers `M_i, F_i ≥ 0` with
  - (4.3) `∑_{x∈[X,2X)} |Λ_per(x)| ≤ C (log Q)^{12} X`, `|Λ_per| ≤ C Q²` everywhere, and (4.17)
    `∑_{x∈[a,a+Q!)} |Λ_per(x)| ≤ C (log Q)^{12} Q!` for every `a ∈ ℤ`;
  - `Λ̃_X - Λ_per = ∑_{i<n} g_i + h` on all of `ℤ`;
  - (4.4) `∑_{x∈[X,2X)} |h(x)| ≤ (C/Q) X`;
  - (4.5) `|g_i| ≤ M_i` everywhere and `∑_{i<n} M_i ≤ C (log X)^E`;
  - (4.6) `|∑_{x∈[X,2X)} g_i(x) e(θx)| ≤ F_i` for all `θ`, and
    `∑_{i<n} F_i^c M_i^{1-c} ≤ C X^c Q^{-c/4}`.

(`M_i`, `F_i` are explicit upper bounds for `‖g_i‖_∞` and `‖ĝ_i‖_∞`; since the claim (5.15) of GS
is monotone in these norms, this is the form in which (4.5), (4.6) are used. All sums over `x` are
over `Finset.Ico (X : ℤ) (2 * X)`, i.e. `E_{x∈[X,2X)} = X⁻¹ ∑`.)

**Construction.** `majorant X = selbergMajorant R` with `R = ⌊X^{1/16}⌋` (`Rof`): the Selberg
majorant `G(R) (∑_{d∣n} λ_d)² = S(n)²/G(R)` written with Ramanujan sums. Its Ramanujan expansion
`∑_{q ≤ R²} C_q c_q(n)` has `|C_q| ≤ 3^{ω(q)}/φ(q)`; `Λ_per` is the part with `q ≤ 2^{i₀}`,
`i₀ = ⌊log₂ Q⌋`, and the dyadic blocks `2^i < q ≤ 2^{i+1}` (`i₀ ≤ i < i₁`) together with one tail
block `q > 2^{i₁}` (`2^{i₁} ≈ (log X)^{O_c(1)}`) are thresholded at `2^{ci/2}`, exactly as in GS
(4.7)–(4.16); the moments are controlled by `sum_pow_abs_ramExp_le` and the Fourier transforms by
`norm_fourier_ramExp_le`.

**Also provided** (for the Brun–Titchmarsh input of the elementary route):
`selbergBeta R = Λ̃_R / G(R)` with `selbergBeta_prime` (`β(p) = 1` for `p > R`),
`sum_interval_AP_selbergMajorant_le_errAP`, `sum_interval_AP_selbergBeta_le` and
`card_primes_AP_le`: for `(b,d) = 1`,
`∑_{m∈[a,a+L), m≡b (d)} β(m) ≤ (L/(d G(R))) ∏_{p∣d}(1 + 3/(p-1)) + 2 errAP(R)/G(R)` with
`errAP R = ∑_{q ∈ UR R} 3^{ω(q)} q ≤ R^8`.
-/

open Finset Real
open scoped ArithmeticFunction.Moebius

namespace G22.L41

open G22.FPD

/- ### GS Lemma 4.1 -/

lemma Gsel_nonneg (R : ℕ) : 0 ≤ Gsel R :=
  Finset.sum_nonneg fun _ hT => (nuT_pos (mem_sieveSets.mp hT).1).le

/-- The majorant is non-negative. -/
theorem majorant_nonneg (X : ℕ) (n : ℤ) : 0 ≤ majorant X n :=
  div_nonneg (sq_nonneg _) (Gsel_nonneg _)

/-- **(4.1)**: `Λ̃(p) ≥ (log X)/16` for primes `p ≥ X`. -/
theorem majorant_prime_ge (X : ℕ) (hX : 2 ^ 16 ≤ X) {p : ℕ} (hp : p.Prime) (hXp : X ≤ p) :
    Real.log X / 16 ≤ majorant X p := by
  have hR2 := two_le_Rof X hX
  have hR1 : 1 ≤ Rof X := by omega
  have hRp : Rof X < p := by
    have h16 := Rof_pow_le X
    have hR2' : (2 : ℝ) ≤ Rof X := by exact_mod_cast hR2
    have : ((Rof X : ℕ) : ℝ) < p := by
      calc ((Rof X : ℕ) : ℝ) < ((Rof X : ℕ) : ℝ) ^ 16 := by
            have := pow_lt_pow_right₀ (by linarith : (1 : ℝ) < Rof X) (by norm_num : 1 < 16)
            simpa using this
        _ ≤ X := h16
        _ ≤ p := by exact_mod_cast hXp
    exact_mod_cast this
  unfold majorant
  rw [selbergMajorant_prime (Rof X) hR1 hp hRp]
  have h1 := log_le_Gsel (Rof X)
  have h2 := log_le_Rof X (by omega)
  linarith

/-- **(4.2)**: `∑_{x ∈ [X, 2X)} Λ̃(x) ≤ 2X`. -/
theorem sum_majorant_le (X : ℕ) (hX : 2 ^ 16 ≤ X) :
    ∑ x ∈ Ico (X : ℤ) (2 * X), majorant X x ≤ 2 * X := by
  have hR1 : 1 ≤ Rof X := by have := two_le_Rof X hX; omega
  have h := sum_dyadic_selbergMajorant_le (Rof X) X hR1
  have h16 := Rof_pow_le X
  have hR : (1 : ℝ) ≤ Rof X := by exact_mod_cast hR1
  have h10 : (Rof X : ℝ) ^ 10 ≤ (Rof X : ℝ) ^ 16 := pow_le_pow_right₀ hR (by norm_num)
  unfold majorant
  linarith

/-- **GS Lemma 4.1, decomposition part.** For each `c ∈ (0,1)` there are `C > 0` and `E ∈ ℕ` such
that for `X ≥ 2^16` and `2 ≤ Q ≤ log X` the majorant decomposes as
`Λ̃ = Λ_per + ∑_{i<n} g_i + h` with `Λ_per` `Q!`-periodic and the bounds (4.3)–(4.6). -/
theorem majorant_decomposition (c : ℝ) (hc0 : 0 < c) (hc1 : c < 1) :
    ∃ C : ℝ, ∃ E : ℕ, 0 < C ∧ ∀ X : ℕ, 2 ^ 16 ≤ X → ∀ Q : ℕ, 2 ≤ Q → (Q : ℝ) ≤ Real.log X →
      ∃ (Λper : ℤ → ℝ) (n : ℕ) (g : ℕ → ℤ → ℝ) (h : ℤ → ℝ) (M F : ℕ → ℝ),
        (∀ x : ℤ, Λper (x + Q.factorial) = Λper x) ∧
        (∑ x ∈ Ico (X : ℤ) (2 * X), |Λper x| ≤ C * Real.log Q ^ 12 * X) ∧
        (∀ a : ℤ, ∑ x ∈ Ico a (a + Q.factorial), |Λper x| ≤
          C * Real.log Q ^ 12 * Q.factorial) ∧
        (∀ x : ℤ, |Λper x| ≤ C * (Q : ℝ) ^ 2) ∧
        (∀ x : ℤ, majorant X x - Λper x = ∑ i ∈ range n, g i x + h x) ∧
        (∑ x ∈ Ico (X : ℤ) (2 * X), |h x| ≤ C / Q * X) ∧
        (∀ i ∈ range n, ∀ x, |g i x| ≤ M i) ∧ (∀ i, 0 ≤ M i) ∧
        (∑ i ∈ range n, M i ≤ C * Real.log X ^ E) ∧
        (∀ i ∈ range n, ∀ θ : ℝ,
          ‖∑ x ∈ Ico (X : ℤ) (2 * X), (g i x : ℂ) * ee (θ * x)‖ ≤ F i) ∧
        (∀ i, 0 ≤ F i) ∧
        (∑ i ∈ range n, F i ^ c * M i ^ (1 - c) ≤ C * (X : ℝ) ^ c * (Q : ℝ) ^ (-(c / 4))) := by
  -- constants depending on `c`
  set m : ℕ := ⌈4 / c⌉₊ + 2 with hm_def
  have hm1 : 1 ≤ m := by omega
  have hm : 4 ≤ c * ((m : ℝ) - 1) := by
    have h1 : 4 / c ≤ (⌈4 / c⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : ((m : ℝ) - 1) = (⌈4 / c⌉₊ : ℝ) + 1 := by rw [hm_def]; push_cast; ring
    rw [h2]
    have h3 : 4 / c * c = 4 := by field_simp
    nlinarith
  set e : ℕ := em m with he
  have he1 : 1 ≤ e := by rw [he]; unfold em; omega
  set Cp : ℝ := 2 * (e : ℝ) ^ e with hCp
  have hCp1 : 1 ≤ Cp := by
    have : (1 : ℝ) ≤ (e : ℝ) ^ e := one_le_pow₀ (by exact_mod_cast he1)
    rw [hCp]; linarith
  set β : ℕ := e + 1 with hβ
  set G : ℝ := Cmom m * Cp with hG
  have hG1 : 1 ≤ G := by have := one_le_Cmom m; rw [hG]; nlinarith
  set D : ℝ := Dconst with hD
  have hD1 : 1 ≤ D := one_le_Dconst
  set C6 : ℝ := (D + G) * 2 * (1 / (1 - (2 : ℝ) ^ (-(c / 4)))) +
    2 * 6 ^ β * (((β + 2 : ℕ) : ℝ) / (c / 4)) ^ (β + 2) with hC6
  have hC6 : 0 ≤ C6 := by
    have hr1 : (2 : ℝ) ^ (-(c / 4)) < 1 :=
      Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
    have : 0 < 1 - (2 : ℝ) ^ (-(c / 4)) := by linarith
    rw [hC6]; positivity
  set D' : ℝ := Dsup with hD'
  have hD'0 : 0 ≤ D' := Dsup_nonneg
  have hCm1 : 0 ≤ Cmom 1 := (zero_le_one.trans (one_le_Cmom 1))
  set C : ℝ := Cmom 1 + D' + 4 * G + 2 * 6 ^ β + C6 + 1 with hC
  have hCpos : 0 < C := by rw [hC]; positivity
  have h6β : (0 : ℝ) ≤ 6 ^ β := by positivity
  have hCm1C : Cmom 1 ≤ C := by rw [hC]; linarith
  have hD'C : D' ≤ C := by rw [hC]; linarith
  have hGC : 4 * G ≤ C := by rw [hC]; linarith
  have h6C : 2 * 6 ^ β ≤ C := by rw [hC]; linarith
  have hC6C : C6 ≤ C := by rw [hC]; linarith
  refine ⟨C, β + 1, hCpos, ?_⟩
  intro X hX Q hQ2 hQX
  -- basic facts
  have hX1 : 1 ≤ X := by omega
  have hXR : (1 : ℝ) ≤ X := by exact_mod_cast hX1
  set R := Rof X with hRdef
  have hR2 : 2 ≤ R := two_le_Rof X hX
  have hR1 : 1 ≤ R := by omega
  have hRX : (R : ℝ) ^ 16 ≤ X := Rof_pow_le X
  have hlogX1 : 1 ≤ Real.log X := one_le_log_of_le hX
  have hQR : (2 : ℝ) ≤ Q := by exact_mod_cast hQ2
  set L := Nat.log 2 X with hL
  set ℓ := Nat.log 2 (L + 1) with hℓ
  set N := β * (ℓ + 1) with hN
  set i0 := Nat.log 2 Q with hi0
  obtain ⟨hi0Q', hQi0', hi01⟩ := i0_bounds Q hQ2
  have hi0Q : (2 : ℝ) ^ i0 ≤ Q := hi0Q'
  have hQi0 : (Q : ℝ) < 2 * 2 ^ i0 := hQi0'
  have hi0QN : 2 ^ i0 ≤ Q := Nat.pow_log_le_self 2 (by omega)
  obtain ⟨hNlow', hNup'⟩ := two_pow_N_bounds X β hX
  have hNlow : Real.log X ^ β ≤ (2 : ℝ) ^ N := hNlow'
  have hNup : (2 : ℝ) ^ N ≤ (6 * Real.log X) ^ β := hNup'
  -- the pieces
  set per : Finset (Finset ℕ) := (UR R).filter (fun U => qU U ≤ 2 ^ i0) with hper
  set blk : ℕ → Finset (Finset ℕ) :=
    fun j => (UR R).filter (fun U => blkCond i0 N j (qU U)) with hblk
  set Λper : ℤ → ℝ := ramExp per (CR R) with hΛper
  set f : ℕ → ℤ → ℝ := fun j => ramExp (blk j) (CR R) with hf
  set u : ℕ → ℝ := fun j => (2 : ℝ) ^ (i0 + j) with hu
  set T : ℕ → ℝ := fun j => (u j) ^ (c / 2) with hT
  set g : ℕ → ℤ → ℝ := fun j x => if |f j x| ≤ T j then f j x else 0 with hg
  set h : ℤ → ℝ := fun x => ∑ j ∈ range (N + 1), (f j x - g j x) with hh
  set F : ℕ → ℝ := fun j => D * X * (u j) ^ (-(3 / 4 : ℝ)) + (X : ℝ) ^ ((3 : ℝ) / 4) +
    G * X * (u j)⁻¹ with hF
  -- primes of the periodic part
  have hperY : ∀ U ∈ per, U ⊆ primesLE (2 ^ i0) := by
    intro U hU
    rw [hper, Finset.mem_filter] at hU
    intro p hp
    rw [mem_primesLE]
    refine ⟨UR_primes hU.1 p hp, ?_⟩
    exact (Nat.le_of_dvd (qU_pos (UR_primes hU.1)) (Finset.dvd_prod_of_mem _ hp)).trans hU.2
  have hi0two : 2 ≤ 2 ^ i0 := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ i0 := Nat.pow_le_pow_right (by norm_num) hi01
  -- the block estimates
  have hblock : ∀ j ∈ range (N + 1),
      (∀ x, |g j x| ≤ T j) ∧
      (∑ x ∈ Ico (X : ℤ) (2 * X), |f j x - g j x| ≤ G * X * (u j)⁻¹) ∧
      (∀ θ : ℝ, ‖∑ x ∈ Ico (X : ℤ) (2 * X), (g j x : ℂ) * ee (θ * x)‖ ≤ F j) := by
    intro j hj
    have hjN : j ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    have hsub : blk j ⊆ UR R := Finset.filter_subset _ _
    have hBi : ∀ U ∈ blk j, 2 ^ (i0 + j) < qU U := fun U hU => (Finset.mem_filter.mp hU).2.1
    by_cases hjlt : j < N
    · -- a dyadic block: all primes are `≤ 2^{i₀+j+1}`
      have hBY : ∀ U ∈ blk j, U ⊆ primesLE (2 ^ (i0 + j + 1)) := by
        intro U hU
        rw [Finset.mem_filter] at hU
        have hq : qU U ≤ 2 ^ (i0 + j + 1) := hU.2.2 hjlt
        intro p hp
        rw [mem_primesLE]
        refine ⟨UR_primes hU.1 p hp, ?_⟩
        exact (Nat.le_of_dvd (qU_pos (UR_primes hU.1)) (Finset.dvd_prod_of_mem _ hp)).trans hq
      have hY : 2 ≤ 2 ^ (i0 + j + 1) := by
        calc 2 = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ (i0 + j + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
      have hlog : Real.log ((2 ^ (i0 + j + 1) : ℕ) : ℝ) ^ em m ≤ Cp * 2 ^ (i0 + j) := by
        have hx : (1 : ℝ) ≤ ((2 ^ (i0 + j + 1) : ℕ) : ℝ) := by
          exact_mod_cast Nat.one_le_two_pow
        have := log_pow_le _ hx e 1 one_pos
        rw [Real.rpow_one] at this
        calc Real.log ((2 ^ (i0 + j + 1) : ℕ) : ℝ) ^ em m
            ≤ ((e : ℝ) / 1) ^ e * ((2 ^ (i0 + j + 1) : ℕ) : ℝ) := this
          _ = Cp * 2 ^ (i0 + j) := by rw [hCp]; push_cast; ring
      exact block_bounds c hc0 hc1 m hm1 hm R X (2 ^ (i0 + j + 1)) (i0 + j) hR1 hX1 hRX hY
        (blk j) hsub hBi hBY Cp (by linarith) hlog
    · -- the last block: all primes are `≤ R`
      have hjeq : j = N := by omega
      have hBY : ∀ U ∈ blk j, U ⊆ primesLE R := fun U hU => (UR_spec (hsub hU)).1
      have hlog : Real.log (R : ℝ) ^ em m ≤ Cp * 2 ^ (i0 + j) := by
        have hRle : (R : ℝ) ≤ X := by
          have hR1' : (1 : ℝ) ≤ R := by exact_mod_cast hR1
          calc (R : ℝ) ≤ (R : ℝ) ^ 16 := by
                have := pow_le_pow_right₀ hR1' (by norm_num : 1 ≤ 16)
                simpa using this
            _ ≤ X := hRX
        have hlogR0 : 0 ≤ Real.log R := Real.log_nonneg (by exact_mod_cast hR1)
        have hlogR : Real.log R ≤ Real.log X :=
          Real.log_le_log (by exact_mod_cast (by omega : 0 < R)) hRle
        calc Real.log (R : ℝ) ^ em m ≤ Real.log X ^ e := by gcongr
          _ ≤ Real.log X ^ β := pow_le_pow_right₀ hlogX1 (by omega)
          _ ≤ (2 : ℝ) ^ N := hNlow
          _ ≤ (2 : ℝ) ^ (i0 + j) := pow_le_pow_right₀ (by norm_num) (by omega)
          _ ≤ Cp * 2 ^ (i0 + j) := le_mul_of_one_le_left (by positivity) hCp1
      exact block_bounds c hc0 hc1 m hm1 hm R X R (i0 + j) hR1 hX1 hRX hR2
        (blk j) hsub hBi hBY Cp (by linarith) hlog
  -- sum of the thresholds
  have hsumu : ∑ j ∈ range (N + 1), u j ≤ 2 * 6 ^ β * Real.log X ^ (β + 1) := by
    have h1 := sum_two_pow_le i0 (N + 1)
    have hlog0 : 0 ≤ Real.log X := by linarith
    calc ∑ j ∈ range (N + 1), u j ≤ (2 : ℝ) ^ i0 * 2 ^ (N + 1) := h1
      _ = (2 : ℝ) ^ i0 * (2 * 2 ^ N) := by ring
      _ ≤ Real.log X * (2 * (6 * Real.log X) ^ β) :=
          mul_le_mul (hi0Q.trans hQX) (by linarith) (by positivity) hlog0
      _ = 2 * 6 ^ β * Real.log X ^ (β + 1) := by ring
  refine ⟨Λper, N + 1, g, h, T, F, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- periodicity
    intro x
    simp only [hΛper]
    unfold ramExp
    refine Finset.sum_congr rfl fun U hU => ?_
    congr 1
    apply cT_periodic
    intro p hp
    have hpY := mem_primesLE.mp (hperY U hU hp)
    exact Int.natCast_dvd_natCast.mpr (Nat.dvd_factorial hpY.1.pos (hpY.2.trans hi0QN))
  · -- (4.3), first moment on `[X, 2X)`
    have hmom := moment_block R X (2 ^ i0) hX1 hi0two hR1 per (Finset.filter_subset _ _) hperY 1
    simp only [pow_one] at hmom
    have he1' : em 1 = 12 := by unfold em; norm_num
    rw [he1'] at hmom
    have hlogY : Real.log ((2 ^ i0 : ℕ) : ℝ) ≤ Real.log Q :=
      Real.log_le_log (by positivity) (by exact_mod_cast hi0QN)
    have hlogY0 : 0 ≤ Real.log ((2 ^ i0 : ℕ) : ℝ) :=
      Real.log_nonneg (by exact_mod_cast Nat.one_le_two_pow)
    calc ∑ x ∈ Ico (X : ℤ) (2 * X), |Λper x| ≤ Cmom 1 * X * Real.log ((2 ^ i0 : ℕ) : ℝ) ^ 12 :=
          hmom
      _ ≤ C * X * Real.log Q ^ 12 := by
          gcongr
      _ = C * Real.log Q ^ 12 * X := by ring
  · -- (4.17): first moment over a full period
    intro a
    have hmom := moment_period R (2 ^ i0) Q hR1 hi0two hi0QN per (Finset.filter_subset _ _)
      hperY a
    have hlogY : Real.log ((2 ^ i0 : ℕ) : ℝ) ≤ Real.log Q :=
      Real.log_le_log (by positivity) (by exact_mod_cast hi0QN)
    have hlogY0 : 0 ≤ Real.log ((2 ^ i0 : ℕ) : ℝ) :=
      Real.log_nonneg (by exact_mod_cast Nat.one_le_two_pow)
    calc ∑ x ∈ Ico a (a + Q.factorial), |Λper x| ≤
          Cmom 1 * Q.factorial * Real.log ((2 ^ i0 : ℕ) : ℝ) ^ 12 := hmom
      _ ≤ C * Q.factorial * Real.log Q ^ 12 := by
          gcongr
      _ = C * Real.log Q ^ 12 * Q.factorial := by ring
  · -- (4.3), sup bound
    intro x
    have hs := sup_per R Q hR1 per (Finset.filter_subset _ _)
      (fun U hU => ((Finset.mem_filter.mp hU).2).trans hi0QN) x
    calc |Λper x| ≤ D' * (Q : ℝ) ^ 2 := hs
      _ ≤ C * (Q : ℝ) ^ 2 := by
          gcongr
  · -- the decomposition identity
    intro x
    have h1 : majorant X x = Λper x + ∑ j ∈ range (N + 1), f j x := by
      unfold majorant
      rw [selbergMajorant_eq_ramExp, ramExp_partition (UR R) (CR R) i0 N x]
    rw [h1]
    simp only [hh]
    rw [← Finset.sum_add_distrib]
    have : ∀ j ∈ range (N + 1), g j x + (f j x - g j x) = f j x := fun j _ => by ring
    rw [Finset.sum_congr rfl this]
    ring
  · -- (4.4)
    have hsum : ∑ x ∈ Ico (X : ℤ) (2 * X), |h x| ≤
        ∑ j ∈ range (N + 1), ∑ x ∈ Ico (X : ℤ) (2 * X), |f j x - g j x| := by
      rw [Finset.sum_comm]
      refine Finset.sum_le_sum fun x _ => ?_
      simp only [hh]
      exact Finset.abs_sum_le_sum_abs _ _
    have hinv := sum_inv_two_pow_le i0 (N + 1)
    have hi0inv : ((2 : ℝ) ^ i0)⁻¹ ≤ 2 / Q := by
      rw [inv_le_comm₀ (by positivity) (by positivity)]
      rw [inv_div]
      linarith
    have hX0 : (0 : ℝ) ≤ X := by positivity
    calc ∑ x ∈ Ico (X : ℤ) (2 * X), |h x|
        ≤ ∑ j ∈ range (N + 1), ∑ x ∈ Ico (X : ℤ) (2 * X), |f j x - g j x| := hsum
      _ ≤ ∑ j ∈ range (N + 1), G * X * (u j)⁻¹ :=
          Finset.sum_le_sum fun j hj => (hblock j hj).2.1
      _ = G * X * ∑ j ∈ range (N + 1), ((2 : ℝ) ^ (i0 + j))⁻¹ := by rw [Finset.mul_sum]
      _ ≤ G * X * (2 * (2 / Q)) := by
          gcongr
          exact hinv.trans (by gcongr)
      _ = 4 * G / Q * X := by ring
      _ ≤ C / Q * X := by
          gcongr
  · -- sup bounds of the `g_i`
    intro j hj x
    exact (hblock j hj).1 x
  · -- `M_i ≥ 0`
    intro j
    simp only [hT, hu]
    positivity
  · -- (4.5)
    have hTu : ∀ j ∈ range (N + 1), T j ≤ u j := by
      intro j _
      have hu1 : (1 : ℝ) ≤ u j := one_le_pow₀ (by norm_num)
      calc T j = (u j) ^ (c / 2) := rfl
        _ ≤ (u j) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hu1 (by linarith)
        _ = u j := Real.rpow_one _
    calc ∑ j ∈ range (N + 1), T j ≤ ∑ j ∈ range (N + 1), u j := Finset.sum_le_sum hTu
      _ ≤ 2 * 6 ^ β * Real.log X ^ (β + 1) := hsumu
      _ ≤ C * Real.log X ^ (β + 1) := by
          gcongr
  · -- Fourier bounds of the `g_i`
    intro j hj θ
    exact (hblock j hj).2.2 θ
  · -- `F_i ≥ 0`
    intro j
    simp only [hF, hu]
    positivity
  · -- (4.6)
    have hsumu' : ∑ j ∈ range (N + 1), (2 : ℝ) ^ (i0 + j) ≤
        2 * 6 ^ β * Real.log X ^ (β + 1) := hsumu
    have h46 := sum46 c hc0 hc1 X Q hXR hQR hlogX1 hQX i0 (N + 1) hQi0 D G hD1 hG1 β hsumu'
    simp only [hF, hT, hu]
    calc ∑ j ∈ range (N + 1), (D * X * ((2 : ℝ) ^ (i0 + j)) ^ (-(3 / 4 : ℝ)) +
          (X : ℝ) ^ ((3 : ℝ) / 4) + G * X * ((2 : ℝ) ^ (i0 + j))⁻¹) ^ c *
          (((2 : ℝ) ^ (i0 + j)) ^ (c / 2)) ^ (1 - c)
        ≤ C6 * (X : ℝ) ^ c * (Q : ℝ) ^ (-(c / 4)) := h46
      _ ≤ C * (X : ℝ) ^ c * (Q : ℝ) ^ (-(c / 4)) := by gcongr

/- ### Arithmetic progressions with the error term `∑_{q ≤ R²} 3^{ω(q)} q` -/

lemma card_resid_eq {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) :
    ((resid U).card : ℝ) = ∏ p ∈ U, ((p : ℝ) - 1) := by
  have h1 : (resid U).card = (qU U).totient := by
    rw [Nat.totient_eq_card_coprime]; unfold resid; simp_rw [Nat.coprime_comm]
  have h2 : ∀ V : Finset ℕ, (∀ p ∈ V, p.Prime) → (qU V).totient = ∏ p ∈ V, (p - 1) := by
    intro V
    induction V using Finset.induction_on with
    | empty => intro _; simp [qU]
    | insert p V hpV ih =>
      intro hV
      have hp : p.Prime := hV p (Finset.mem_insert_self _ _)
      have hV' : ∀ q ∈ V, q.Prime := fun q hq => hV q (Finset.mem_insert_of_mem hq)
      unfold qU at ih ⊢
      rw [Finset.prod_insert hpV, Finset.prod_insert hpV, Nat.totient_mul, Nat.totient_prime hp,
        ih hV']
      exact Nat.Coprime.prod_right fun q hq =>
        (Nat.coprime_primes hp (hV' q hq)).mpr fun h => hpV (h ▸ hq)
  rw [h1, h2 U hU]
  push_cast [Nat.cast_prod]
  refine Finset.prod_congr rfl fun p hp => ?_
  rw [Nat.cast_sub (hU p hp).one_lt.le]
  simp

lemma abs_CR_mul_phi_le (R : ℕ) (hR : 1 ≤ R) {U : Finset ℕ} (hU : U ∈ UR R) :
    |CR R U| * ∏ p ∈ U, ((p : ℝ) - 1) ≤ (3 : ℝ) ^ U.card := by
  have hge : ∀ p ∈ U, (2 : ℝ) ≤ p := fun p hp => two_le_of_mem_primesLE ((UR_spec hU).1 hp)
  have hphi : 0 ≤ ∏ p ∈ U, ((p : ℝ) - 1) :=
    Finset.prod_nonneg fun p hp => by linarith [hge p hp]
  calc |CR R U| * ∏ p ∈ U, ((p : ℝ) - 1) ≤ (∏ p ∈ U, (3 : ℝ) / ((p : ℝ) - 1)) *
        ∏ p ∈ U, ((p : ℝ) - 1) := mul_le_mul_of_nonneg_right (abs_CR_le R hR hU) hphi
    _ = ∏ p ∈ U, (3 : ℝ) := by
        rw [← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun p hp => ?_
        have : (p : ℝ) - 1 ≠ 0 := by linarith [hge p hp]
        field_simp
    _ = (3 : ℝ) ^ U.card := Finset.prod_const _

lemma abs_CR_le_three_pow (R : ℕ) (hR : 1 ≤ R) {U : Finset ℕ} (hU : U ∈ UR R) :
    |CR R U| ≤ (3 : ℝ) ^ U.card := by
  have hge : ∀ p ∈ U, (2 : ℝ) ≤ p := fun p hp => two_le_of_mem_primesLE ((UR_spec hU).1 hp)
  refine (abs_CR_le R hR hU).trans ?_
  rw [← Finset.prod_const]
  refine Finset.prod_le_prod (fun p hp => ?_) fun p hp => ?_
  · have := hge p hp; have : (0 : ℝ) < p - 1 := by linarith
    positivity
  · have := hge p hp
    rw [div_le_iff₀ (by linarith)]; linarith

/-- `|∑_{k ∈ [k₁,k₂)} c_{q_U}(kd + b)| ≤ φ(q_U) q_U / 2` when `q_U ∤ d`. -/
lemma abs_sum_AP_cT_le_phi {U : Finset ℕ} (hU : ∀ p ∈ U, p.Prime) {d : ℕ} (hd : 0 < d)
    (hnot : ¬ U ⊆ d.primeFactors) (b k₁ k₂ : ℤ) :
    |∑ k ∈ Ico k₁ k₂, cT U (k * d + b)| ≤ (∏ p ∈ U, ((p : ℝ) - 1)) * qU U / 2 := by
  set q := qU U with hqdef
  have hq : 0 < q := qU_pos hU
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  obtain ⟨p, hpU, hpd⟩ := Finset.not_subset.mp hnot
  have hpd' : ¬ p ∣ d := fun h => hpd (Nat.mem_primeFactors.mpr ⟨hU p hpU, h, hd.ne'⟩)
  have hpq : p ∣ q := Finset.dvd_prod_of_mem _ hpU
  have hC : ((∑ k ∈ Ico k₁ k₂, cT U (k * d + b) : ℝ) : ℂ) =
      ∑ a ∈ resid U, ee ((a : ℝ) * b / q) * expSum k₁ k₂ ((a : ℝ) * d / q) := by
    rw [Complex.ofReal_sum]
    simp_rw [cT_eq_sum_resid hU]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => ?_
    unfold expSum
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [← ee_add]; congr 1; push_cast; ring
  have hbound : ∀ a ∈ resid U, ‖expSum k₁ k₂ ((a : ℝ) * d / q)‖ ≤ q / 2 := by
    intro a ha
    unfold resid at ha
    rw [Finset.mem_filter, Finset.mem_range] at ha
    have hndvd : ¬ ((q : ℕ) : ℤ) ∣ ((a * d : ℕ) : ℤ) := by
      intro h
      have h' : q ∣ a * d := by exact_mod_cast h
      have : p ∣ a * d := hpq.trans h'
      rcases (Nat.Prime.dvd_mul (hU p hpU)).mp this with h1 | h1
      · have hcop := (Nat.Coprime.coprime_dvd_right hpq ha.2).symm
        exact (hU p hpU).one_lt.ne' (hcop.eq_one_of_dvd h1)
      · exact hpd' h1
    have hdn := one_div_le_dnear hq hndvd
    have e : (((a * d : ℕ) : ℤ) : ℝ) / (q : ℝ) = (a : ℝ) * d / q := by push_cast; ring
    rw [e] at hdn
    have := norm_sum_Ico_ee_le_of_dnear k₁ k₂ (by positivity) hdn
    unfold expSum
    calc ‖∑ x ∈ Ico k₁ k₂, ee ((a : ℝ) * d / q * x)‖ ≤ 1 / (2 * (1 / (q : ℝ))) := this
      _ = q / 2 := by field_simp
  rw [← Real.norm_eq_abs, ← Complex.norm_real, hC]
  calc ‖∑ a ∈ resid U, ee ((a : ℝ) * b / q) * expSum k₁ k₂ ((a : ℝ) * d / q)‖
      ≤ ∑ a ∈ resid U, ‖ee ((a : ℝ) * b / q) * expSum k₁ k₂ ((a : ℝ) * d / q)‖ :=
        norm_sum_le _ _
    _ = ∑ a ∈ resid U, ‖expSum k₁ k₂ ((a : ℝ) * d / q)‖ := by
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [norm_mul, norm_ee, one_mul]
    _ ≤ ∑ a ∈ resid U, (q : ℝ) / 2 := Finset.sum_le_sum hbound
    _ = (resid U).card * ((q : ℝ) / 2) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ = (∏ p ∈ U, ((p : ℝ) - 1)) * q / 2 := by rw [card_resid_eq hU]; ring

/-- The error term `∑_{q ∈ UR} 3^{ω(q)} q` (a sum over squarefree `q ≤ R²`). -/
noncomputable def errAP (R : ℕ) : ℝ := ∑ U ∈ UR R, (3 : ℝ) ^ U.card * qU U

lemma errAP_nonneg (R : ℕ) : 0 ≤ errAP R := Finset.sum_nonneg fun U _ => by positivity

lemma errAP_le (R : ℕ) (hR : 1 ≤ R) : errAP R ≤ (R : ℝ) ^ 8 := by
  unfold errAP
  calc ∑ U ∈ UR R, (3 : ℝ) ^ U.card * qU U ≤ ∑ U ∈ UR R, (R : ℝ) ^ 6 := by
        refine Finset.sum_le_sum fun U hU => ?_
        have hge : ∀ p ∈ U, (2 : ℝ) ≤ p := fun p hp =>
          two_le_of_mem_primesLE ((UR_spec hU).1 hp)
        have h1 := qU_le_sq_of_mem_UR hU
        have h0 : (0 : ℝ) ≤ qU U := by positivity
        have h2 : (2 : ℝ) ^ U.card ≤ qU U := by
          unfold qU; push_cast
          calc (2 : ℝ) ^ U.card = ∏ p ∈ U, (2 : ℝ) := (Finset.prod_const _).symm
            _ ≤ ∏ p ∈ U, (p : ℝ) := Finset.prod_le_prod (fun _ _ => by norm_num) hge
        have h3 : (3 : ℝ) ^ U.card ≤ (qU U : ℝ) ^ 2 := by
          calc (3 : ℝ) ^ U.card ≤ (4 : ℝ) ^ U.card := by gcongr; norm_num
            _ = ((2 : ℝ) ^ U.card) ^ 2 := by
                rw [← pow_mul, mul_comm, pow_mul]; norm_num
            _ ≤ (qU U : ℝ) ^ 2 := by gcongr
        calc (3 : ℝ) ^ U.card * qU U ≤ (qU U : ℝ) ^ 2 * qU U := by gcongr
          _ = (qU U : ℝ) ^ 3 := by ring
          _ ≤ ((R : ℝ) ^ 2) ^ 3 := by gcongr
          _ = (R : ℝ) ^ 6 := by ring
    _ = (UR R).card * (R : ℝ) ^ 6 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (R : ℝ) ^ 2 * (R : ℝ) ^ 6 := by
        gcongr
        exact_mod_cast card_UR_le R
    _ = (R : ℝ) ^ 8 := by ring

/-- Sums of the majorant over an arithmetic progression, with error `errAP R / 2`. -/
theorem sum_AP_selbergMajorant_le_errAP (R : ℕ) (hR : 1 ≤ R) (b : ℤ) (d : ℕ) (hd : 0 < d)
    (hbd : IsCoprime b (d : ℤ)) (k₁ k₂ : ℤ) :
    ∑ k ∈ Ico k₁ k₂, selbergMajorant R (k * d + b) ≤
      (Ico k₁ k₂).card * ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), |CR R U| +
        errAP R / 2 := by
  simp_rw [selbergMajorant_eq_ramExp]
  unfold ramExp
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum]
  rw [← Finset.sum_filter_add_sum_filter_not (UR R) (fun U => U ⊆ d.primeFactors)]
  apply add_le_add
  · rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro U hU
    rw [Finset.mem_filter] at hU
    have hper : ∀ k : ℤ, cT U (k * d + b) = cT U b := by
      intro k
      rw [add_comm]
      apply cT_periodic
      intro p hp
      have : p ∣ d := Nat.dvd_of_mem_primeFactors (hU.2 hp)
      exact Dvd.dvd.mul_left (Int.natCast_dvd_natCast.mpr this) k
    simp_rw [hper]
    rw [Finset.sum_const, nsmul_eq_mul]
    have hcb : |cT U b| ≤ 1 := by
      unfold cT; rw [Finset.abs_prod]
      apply Finset.prod_le_one (fun _ _ => abs_nonneg _)
      intro p hp
      have hpd : (p : ℤ) ∣ d :=
        Int.natCast_dvd_natCast.mpr (Nat.dvd_of_mem_primeFactors (hU.2 hp))
      have hpb : ¬ (p : ℤ) ∣ b := by
        intro hpb
        have := hbd.isUnit_of_dvd' hpb hpd
        rcases Int.isUnit_iff.mp this with h | h
        · have : p = 1 := by exact_mod_cast h
          exact (Nat.prime_of_mem_primeFactors (hU.2 hp)).one_lt.ne' this
        · have : (0 : ℤ) ≤ p := by positivity
          omega
      unfold cP; rw [if_neg hpb]; simp
    have hK : (0 : ℝ) ≤ (Ico k₁ k₂).card := by positivity
    calc CR R U * ((Ico k₁ k₂).card * cT U b)
        ≤ |CR R U * ((Ico k₁ k₂).card * cT U b)| := le_abs_self _
      _ = |CR R U| * ((Ico k₁ k₂).card * |cT U b|) := by
          rw [abs_mul, abs_mul, Nat.abs_cast]
      _ ≤ |CR R U| * ((Ico k₁ k₂).card * 1) := by gcongr
      _ = (Ico k₁ k₂).card * |CR R U| := by ring
  · calc ∑ U ∈ (UR R).filter (fun U => ¬ U ⊆ d.primeFactors),
          CR R U * ∑ k ∈ Ico k₁ k₂, cT U (k * d + b)
        ≤ ∑ U ∈ (UR R).filter (fun U => ¬ U ⊆ d.primeFactors),
            (3 : ℝ) ^ U.card * qU U / 2 := by
          apply Finset.sum_le_sum
          intro U hU
          rw [Finset.mem_filter] at hU
          have h := abs_sum_AP_cT_le_phi (UR_primes hU.1) hd hU.2 b k₁ k₂
          have hphi := abs_CR_mul_phi_le R hR hU.1
          have hq0 : (0 : ℝ) ≤ qU U := by positivity
          calc CR R U * ∑ k ∈ Ico k₁ k₂, cT U (k * d + b)
              ≤ |CR R U| * |∑ k ∈ Ico k₁ k₂, cT U (k * d + b)| := by
                rw [← abs_mul]; exact le_abs_self _
            _ ≤ |CR R U| * ((∏ p ∈ U, ((p : ℝ) - 1)) * qU U / 2) := by gcongr
            _ = (|CR R U| * ∏ p ∈ U, ((p : ℝ) - 1)) * qU U / 2 := by ring
            _ ≤ (3 : ℝ) ^ U.card * qU U / 2 := by gcongr
      _ ≤ ∑ U ∈ UR R, (3 : ℝ) ^ U.card * qU U / 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => by positivity)
      _ = errAP R / 2 := by unfold errAP; rw [Finset.sum_div]

/-- **Arithmetic progressions** (the form requested for Brun–Titchmarsh): for `(b, d) = 1`,
`∑_{m ∈ [a, a+L), m ≡ b (d)} Λ̃(m) ≤ (L/d) ∏_{p ∣ d}(1 + 3/(p-1)) + 2 ∑_{q ∈ UR} 3^{ω(q)} q`. -/
theorem sum_interval_AP_selbergMajorant_le_errAP (R : ℕ) (hR : 1 ≤ R) (a : ℤ) (L : ℕ) (b : ℤ)
    (d : ℕ) (hd : 0 < d) (hbd : IsCoprime b (d : ℤ)) :
    ∑ m ∈ (Ico a (a + L)).filter (fun m => m ≡ b [ZMOD d]), selbergMajorant R m ≤
      (L : ℝ) / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + 2 * errAP R := by
  have hdZ : (0 : ℤ) < d := by exact_mod_cast hd
  rw [Int.Ico_filter_modEq_eq, Int.Ico_filter_dvd_eq _ _ hdZ, Finset.sum_map, Finset.sum_map]
  simp only [Function.Embedding.coeFn_mk]
  set k₁ := ⌈((a - b : ℤ) : ℚ) / ((d : ℤ) : ℚ)⌉ with hk₁
  set k₂ := ⌈((a + L - b : ℤ) : ℚ) / ((d : ℤ) : ℚ)⌉ with hk₂
  have hK : ((Ico k₁ k₂).card : ℝ) ≤ L / d + 1 := by
    have h1 := card_filter_dvd_Ico_le (a - b) (a + L - b) d hd
    have h2 : ((Ico (a - b) (a + L - b)).filter (fun x => (d : ℤ) ∣ x)).card =
        (Ico k₁ k₂).card := by
      rw [Int.Ico_filter_dvd_eq _ _ hdZ, Finset.card_map]
    rw [h2] at h1
    refine h1.trans (max_le ?_ (by positivity))
    push_cast
    rw [show (a : ℝ) + L - b - (a - b) = L by ring]
  have hmain := sum_AP_selbergMajorant_le_errAP R hR b d hd hbd k₁ k₂
  set M := ∑ U ∈ (UR R).filter (fun U => U ⊆ d.primeFactors), |CR R U| with hMdef
  have hM := sum_filter_abs_CR_le R hR d
  have hM0 : 0 ≤ M := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hME : M ≤ errAP R := by
    calc M ≤ ∑ U ∈ UR R, |CR R U| :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => abs_nonneg _)
      _ ≤ errAP R := by
          unfold errAP
          refine Finset.sum_le_sum fun U hU => ?_
          have h1 := abs_CR_le_three_pow R hR hU
          have h2 : (1 : ℝ) ≤ qU U := by exact_mod_cast qU_pos (UR_primes hU)
          calc |CR R U| ≤ (3 : ℝ) ^ U.card := h1
            _ ≤ (3 : ℝ) ^ U.card * qU U := le_mul_of_one_le_right (by positivity) h2
  have hE := errAP_nonneg R
  have hP0 : 0 ≤ ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) := by
    apply Finset.prod_nonneg
    intro p hp
    have := (Nat.prime_of_mem_primeFactors hp).two_le
    have : (2 : ℝ) ≤ p := by exact_mod_cast this
    have : (0 : ℝ) < p - 1 := by linarith
    positivity
  have hLd : (0 : ℝ) ≤ L / d := by positivity
  calc ∑ k ∈ Ico k₁ k₂, selbergMajorant R (k * d + b)
      ≤ (Ico k₁ k₂).card * M + errAP R / 2 := hmain
    _ ≤ (L / d + 1) * M + errAP R / 2 := by gcongr
    _ = L / d * M + M + errAP R / 2 := by ring
    _ ≤ L / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + errAP R + errAP R / 2 := by
        gcongr
    _ ≤ (L : ℝ) / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + 2 * errAP R := by
        linarith

/- ### The normalized sieve weight `β = Λ̃/G` and a Brun–Titchmarsh bound -/

/-- Selberg's sieve weight `β_R(n) = (∑_{d ∣ n, d ≤ R} λ_d)² = Λ̃_R(n)/G(R)`. -/
noncomputable def selbergBeta (R : ℕ) (n : ℤ) : ℝ := selbergMajorant R n / Gsel R

lemma selbergBeta_nonneg (R : ℕ) (n : ℤ) : 0 ≤ selbergBeta R n :=
  div_nonneg (div_nonneg (sq_nonneg _) (Gsel_nonneg _)) (Gsel_nonneg _)

/-- `β_R(p) = 1` for primes `p > R`. -/
theorem selbergBeta_prime (R : ℕ) (hR : 1 ≤ R) {p : ℕ} (hp : p.Prime) (hpR : R < p) :
    selbergBeta R p = 1 := by
  unfold selbergBeta
  rw [selbergMajorant_prime R hR hp hpR]
  exact div_self (Gsel_pos hR).ne'

/-- **Arithmetic progressions for `β`**: for `(b, d) = 1`,
`∑_{m ∈ [a,a+L), m ≡ b (d)} β(m) ≤ (L/(d G)) ∏_{p∣d}(1 + 3/(p-1)) + 2 (∑_{q ∈ UR} 3^{ω(q)} q)/G`. -/
theorem sum_interval_AP_selbergBeta_le (R : ℕ) (hR : 1 ≤ R) (a : ℤ) (L : ℕ) (b : ℤ)
    (d : ℕ) (hd : 0 < d) (hbd : IsCoprime b (d : ℤ)) :
    ∑ m ∈ (Ico a (a + L)).filter (fun m => m ≡ b [ZMOD d]), selbergBeta R m ≤
      (L : ℝ) / (d * Gsel R) * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) +
        2 * errAP R / Gsel R := by
  have hG := Gsel_pos hR
  unfold selbergBeta
  rw [← Finset.sum_div, div_le_iff₀ hG]
  have h := sum_interval_AP_selbergMajorant_le_errAP R hR a L b d hd hbd
  have e : ((L : ℝ) / (d * Gsel R) * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) +
      2 * errAP R / Gsel R) * Gsel R =
      (L : ℝ) / d * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) + 2 * errAP R := by
    have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
    field_simp
  rw [e]
  exact h

/-- **Brun–Titchmarsh-type bound.** If `P` is a set of primes `p > R` lying in `[a, a+L)` and in
the class `b mod d` with `(b, d) = 1`, then
`|P| ≤ (L/(d G(R))) ∏_{p∣d}(1 + 3/(p-1)) + 2 errAP(R)/G(R)`, where `G(R) ≥ log(R+1)`. -/
theorem card_primes_AP_le (R : ℕ) (hR : 1 ≤ R) (a : ℤ) (L : ℕ) (b : ℤ) (d : ℕ) (hd : 0 < d)
    (hbd : IsCoprime b (d : ℤ)) (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime ∧ R < p ∧ a ≤ (p : ℤ) ∧ (p : ℤ) < a + L ∧ (p : ℤ) ≡ b [ZMOD d]) :
    (P.card : ℝ) ≤ (L : ℝ) / (d * Gsel R) * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) +
        2 * errAP R / Gsel R := by
  refine le_trans ?_ (sum_interval_AP_selbergBeta_le R hR a L b d hd hbd)
  have hmap : P.map Nat.castEmbedding ⊆ (Ico a (a + L)).filter (fun m => m ≡ b [ZMOD d]) := by
    intro m hm
    rw [Finset.mem_map] at hm
    obtain ⟨p, hp, rfl⟩ := hm
    obtain ⟨-, -, h1, h2, h3⟩ := hP p hp
    rw [Finset.mem_filter, Finset.mem_Ico]
    exact ⟨⟨h1, h2⟩, h3⟩
  calc (P.card : ℝ) = ∑ p ∈ P, selbergBeta R p := by
        rw [Finset.sum_congr rfl fun p hp => selbergBeta_prime R hR (hP p hp).1 (hP p hp).2.1]
        simp
    _ = ∑ m ∈ P.map Nat.castEmbedding, selbergBeta R m := by
        rw [Finset.sum_map]; rfl
    _ ≤ ∑ m ∈ (Ico a (a + L)).filter (fun m => m ≡ b [ZMOD d]), selbergBeta R m :=
        Finset.sum_le_sum_of_subset_of_nonneg hmap fun m _ _ => selbergBeta_nonneg R m

/- ### GS Lemma 4.1: the packaged statement -/

/-- **GS Lemma 4.1** (Green–Sawhney, arXiv:2511.09365v2), with explicit `X₀ = 2^16` and
constants `a₁ = 1/16`, `a₂ = 2`, `12` in (4.3). -/
def Lemma41Stmt : Prop :=
  ∃ Λt : ℕ → ℤ → ℝ,
    (∀ X x, 0 ≤ Λt X x) ∧
    (∀ X : ℕ, 2 ^ 16 ≤ X → ∀ p : ℕ, p.Prime → X ≤ p → Real.log X / 16 ≤ Λt X p) ∧
    (∀ X : ℕ, 2 ^ 16 ≤ X → ∑ x ∈ Ico (X : ℤ) (2 * X), Λt X x ≤ 2 * X) ∧
    ∀ c : ℝ, 0 < c → c < 1 → ∃ C : ℝ, ∃ E : ℕ, 0 < C ∧
      ∀ X : ℕ, 2 ^ 16 ≤ X → ∀ Q : ℕ, 2 ≤ Q → (Q : ℝ) ≤ Real.log X →
      ∃ (Λper : ℤ → ℝ) (n : ℕ) (g : ℕ → ℤ → ℝ) (h : ℤ → ℝ) (M F : ℕ → ℝ),
        (∀ x : ℤ, Λper (x + Q.factorial) = Λper x) ∧
        (∑ x ∈ Ico (X : ℤ) (2 * X), |Λper x| ≤ C * Real.log Q ^ 12 * X) ∧
        (∀ a : ℤ, ∑ x ∈ Ico a (a + Q.factorial), |Λper x| ≤
          C * Real.log Q ^ 12 * Q.factorial) ∧
        (∀ x : ℤ, |Λper x| ≤ C * (Q : ℝ) ^ 2) ∧
        (∀ x : ℤ, Λt X x - Λper x = ∑ i ∈ range n, g i x + h x) ∧
        (∑ x ∈ Ico (X : ℤ) (2 * X), |h x| ≤ C / Q * X) ∧
        (∀ i ∈ range n, ∀ x, |g i x| ≤ M i) ∧ (∀ i, 0 ≤ M i) ∧
        (∑ i ∈ range n, M i ≤ C * Real.log X ^ E) ∧
        (∀ i ∈ range n, ∀ θ : ℝ,
          ‖∑ x ∈ Ico (X : ℤ) (2 * X), (g i x : ℂ) * ee (θ * x)‖ ≤ F i) ∧
        (∀ i, 0 ≤ F i) ∧
        (∑ i ∈ range n, F i ^ c * M i ^ (1 - c) ≤ C * (X : ℝ) ^ c * (Q : ℝ) ^ (-(c / 4)))

theorem lemma41 : Lemma41Stmt :=
  ⟨majorant, majorant_nonneg, fun X hX _ hp hXp => majorant_prime_ge X hX hp hXp,
    sum_majorant_le, majorant_decomposition⟩

end G22.L41

end

/- ## Section: `BT` -/

section

/-
# Brun–Titchmarsh from the Selberg majorant

`btWith : G22.FPDQ.BTWith 40 2`, i.e. for `1 ≤ u`, `2 ≤ y`, `1 ≤ d`, `d^{10} ≤ y`, `gcd(b,d) = 1`:
`#{p ∈ [u, u+y) prime, p ≡ b (mod d)} ≤ 40 · 4^{ω(d)} · y / (d log y)`.

Proof: `G22.L41.card_primes_AP_le` with sieve level `R = ⌊y^{1/10}⌋` for the primes `p > R`
(`β(p) = 1`, `G(R) ≥ log(R+1) ≥ (log y)/10`, error `2 errAP(R)/G(R) ≤ 2R^8/G(R)`), and the
trivial bound `R` for the primes `p ≤ R`.
-/

open Finset Real

namespace G22.L41

/-- **Brun–Titchmarsh** in the form `G22.FPDQ.BTWith 40 2`: for `1 ≤ u`, `2 ≤ y`, `1 ≤ d`,
`d^{10} ≤ y` and `gcd(b, d) = 1`,
`#{p ∈ [u, u+y) prime, p ≡ b (d)} ≤ 40 · 4^{ω(d)} · y / (d log y)`.
Proof: Selberg's sieve weight `β` of level `R = ⌊y^{1/10}⌋` (`card_primes_AP_le`); the primes
`p ≤ R` are counted trivially. -/
theorem btWith : G22.FPDQ.BTWith 40 2 := by
  intro u y d b hu hy hd hdy hbd
  have hy1 : 1 ≤ y := by omega
  have hyR : (2 : ℝ) ≤ y := by exact_mod_cast hy
  have hy0 : (0 : ℝ) < y := by linarith
  have hdR : (1 : ℝ) ≤ d := by exact_mod_cast hd
  -- `t = y^{1/10}`
  set t : ℝ := (y : ℝ) ^ ((1 : ℝ) / 10) with ht
  have ht0 : 0 < t := by positivity
  have ht10 : t ^ 10 = y := by
    rw [ht, ← Real.rpow_natCast, ← Real.rpow_mul hy0.le]; norm_num
  have ht1 : 1 < t := by
    by_contra h
    push Not at h
    have : t ^ 10 ≤ 1 := pow_le_one₀ ht0.le h
    linarith
  have hlogt : 0 < Real.log t := Real.log_pos ht1
  have hlogy : Real.log y = 10 * Real.log t := by
    rw [← ht10, Real.log_pow]; push_cast; ring
  have hdt : (d : ℝ) ≤ t := by
    have h1 : ((d : ℝ) ^ 10) ≤ y := by exact_mod_cast hdy
    by_contra h
    push Not at h
    have : t ^ 10 < (d : ℝ) ^ 10 := pow_lt_pow_left₀ h ht0.le (by norm_num)
    linarith
  -- the sieve level
  set R : ℕ := ⌊t⌋₊ with hRdef
  have hRt : (R : ℝ) ≤ t := Nat.floor_le ht0.le
  have hR1 : 1 ≤ R := Nat.le_floor (by simpa using ht1.le)
  have htR : t < (R : ℝ) + 1 := Nat.lt_floor_add_one t
  have hG := Gsel_pos hR1
  have hGt : Real.log t ≤ Gsel R := by
    have := log_le_Gsel R
    exact (Real.log_le_log ht0 htR.le).trans this
  -- split into small and large primes
  set S := (Ico u (u + y)).filter (fun p => p.Prime ∧ p % d = b % d) with hS
  have hsplit := Finset.card_filter_add_card_filter_not (s := S) (fun p => p ≤ R)
  have hsmall : ((S.filter (fun p => p ≤ R)).card : ℝ) ≤ R := by
    have : (S.filter (fun p => p ≤ R)).card ≤ (Icc 1 R).card := by
      apply Finset.card_le_card
      intro p hp
      rw [Finset.mem_filter, hS, Finset.mem_filter] at hp
      rw [Finset.mem_Icc]
      exact ⟨hp.1.2.1.one_lt.le, hp.2⟩
    rw [Nat.card_Icc] at this
    exact_mod_cast (show (S.filter (fun p => p ≤ R)).card ≤ R by omega)
  have hbig := card_primes_AP_le R hR1 (u : ℤ) y (b : ℤ) d hd
    (Nat.isCoprime_iff_coprime.mpr hbd) (S.filter (fun p => ¬ p ≤ R)) (by
      intro p hp
      rw [Finset.mem_filter, hS, Finset.mem_filter, Finset.mem_Ico] at hp
      obtain ⟨⟨⟨h1, h2⟩, hpp, hmod⟩, hpR⟩ := hp
      refine ⟨hpp, by omega, by exact_mod_cast h1, by exact_mod_cast h2, ?_⟩
      exact Int.natCast_modEq_iff.mpr hmod)
  -- the product over `p ∣ d` is at most `4^{ω(d)}`
  have hprod : ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) ≤ 4 ^ d.primeFactors.card := by
    rw [← Finset.prod_const]
    refine Finset.prod_le_prod (fun p hp => ?_) fun p hp => ?_
    · have := (Nat.prime_of_mem_primeFactors hp).two_le
      have : (2 : ℝ) ≤ p := by exact_mod_cast this
      have : (0 : ℝ) < p - 1 := by linarith
      positivity
    · have := (Nat.prime_of_mem_primeFactors hp).two_le
      have : (2 : ℝ) ≤ p := by exact_mod_cast this
      have h3 : 3 / ((p : ℝ) - 1) ≤ 3 := by
        rw [div_le_iff₀ (by linarith)]; linarith
      linarith
  have hE := errAP_le R hR1
  have hRt8 : (R : ℝ) ^ 8 ≤ t ^ 8 := by gcongr
  have h4 : (1 : ℝ) ≤ 4 ^ d.primeFactors.card := one_le_pow₀ (by norm_num)
  -- the target, in terms of `t`
  set W : ℝ := 4 ^ d.primeFactors.card * t ^ 10 / (d * Real.log t) with hW
  have hW0 : 0 ≤ W := by positivity
  have hmain : (y : ℝ) / (d * Gsel R) * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) ≤ W := by
    rw [hW, ← ht10]
    have hP0 : 0 ≤ ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1)) := by
      apply Finset.prod_nonneg
      intro p hp
      have := (Nat.prime_of_mem_primeFactors hp).two_le
      have : (2 : ℝ) ≤ p := by exact_mod_cast this
      have : (0 : ℝ) < p - 1 := by linarith
      positivity
    calc t ^ 10 / (d * Gsel R) * ∏ p ∈ d.primeFactors, (1 + 3 / ((p : ℝ) - 1))
        ≤ t ^ 10 / (d * Real.log t) * 4 ^ d.primeFactors.card := by
          gcongr
      _ = 4 ^ d.primeFactors.card * t ^ 10 / (d * Real.log t) := by ring
  have herr : 2 * errAP R / Gsel R ≤ 2 * W := by
    rw [hW]
    have h1 : 2 * errAP R / Gsel R ≤ 2 * t ^ 8 / Real.log t := by
      rw [div_le_div_iff₀ hG hlogt]
      have := errAP_nonneg R
      calc 2 * errAP R * Real.log t ≤ 2 * t ^ 8 * Real.log t := by gcongr; linarith
        _ ≤ 2 * t ^ 8 * Gsel R := by gcongr
    have h2 : t ^ 8 ≤ t ^ 10 / d := by
      rw [le_div_iff₀ (by linarith)]
      calc t ^ 8 * d ≤ t ^ 8 * t ^ 2 := by
            gcongr
            nlinarith
        _ = t ^ 10 := by ring
    calc 2 * errAP R / Gsel R ≤ 2 * t ^ 8 / Real.log t := h1
      _ ≤ 2 * (t ^ 10 / d) / Real.log t := by gcongr
      _ = 2 * (t ^ 10 / (d * Real.log t)) := by field_simp
      _ ≤ 2 * (4 ^ d.primeFactors.card * t ^ 10 / (d * Real.log t)) := by
          gcongr
          exact le_mul_of_one_le_left (by positivity) h4
  have hsm : (R : ℝ) ≤ W := by
    rw [hW]
    have hlt : Real.log t ≤ t := (Real.log_le_sub_one_of_pos ht0).trans (by linarith)
    calc (R : ℝ) ≤ t := hRt
      _ ≤ t ^ 8 := by
          have := pow_le_pow_right₀ ht1.le (by norm_num : 1 ≤ 8)
          simpa using this
      _ = t ^ 10 / (t * t) := by field_simp
      _ ≤ t ^ 10 / (d * Real.log t) := by
          gcongr
      _ ≤ 4 ^ d.primeFactors.card * t ^ 10 / (d * Real.log t) := by
          gcongr
          exact le_mul_of_one_le_left (by positivity) h4
  have htarget : (40 : ℝ) * 4 ^ d.primeFactors.card * y / (d * Real.log y) = 4 * W := by
    rw [hW, hlogy, ← ht10]
    field_simp
    ring
  rw [htarget, ← hsplit]
  push_cast
  linarith

theorem bt_exists : ∃ C : ℝ, ∃ y₀ : ℕ, G22.FPDQ.BTWith C y₀ := ⟨40, 2, btWith⟩

end G22.L41

end

/- ## Section: `Prop51Steps` -/

section

/-
# GS Proposition 5.1 as a pipeline of independently provable steps

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. This file does **not** prove anything
mathematical about Proposition 5.1. It fixes

* step statements `StepP0a … StepP7` covering GS §5 (pp. 14–23), every one a true, self-contained
  claim with explicit quantifiers (see `notes/prop51_steps.md` for the proof sketches);
* `prop51_of_steps`: the assembly, **proved**: the top-level steps `P0a, P0b, P1, P2, P3, P5, P6`
  imply the `Prop51` of `Interface.lean`; GS Lemma 4.1 enters as the proved `L41.lemma41`, and all
  constants `C = 2C₂`, `c = 1`, `C'`, `δ₀`, `N₀` are chosen there;
* `prop51_of_leaves`: the same from the leaf steps, the shared helpers `StepProdAvg`,
  `StepBoxes`, and the three glue implications `GlueP5e`, `GlueP5`, `GlueP6`.

Proven lemmas are used directly instead of being restated: `FPD.lemmaL` (Lemma L),
`L24.lemma24_gen` (Lemma 2.4*), `Elliott.dilation` (A.4), `Elem.logAvg_shift_le'` (A.2),
`Elem.uavg_shift_le` (A.1), `MertensProof.mertensLowerWith` (Mertens), and from `FPDQ.lean`:
`lemmaC_coll`, `lemmaL_box_FPD` (Lemma C + L), `lemmaRQ_FPD` (Lemma R + Q), `lemmaSel_i`–`iv`,
`lemmaPH`, `lemmaPH_nonneg`, `prod_weight_bad_pair`, `lemmaM54A` (Chebyshev form of (5.4));
from `Lemma26.lean`: `L26.lemma26_one` (Lemma 2.6* with `Q₀ = 1`); from `SmallLemmas.lean`:
`Small.lemmaA4`, `lemmaA2res`, `lemmaA3`, `lemmaA6`, `lemma52_prop51` (Lemma 5.2, `γ ≤ 4δ⁵`),
`lemma52_indicator`, `lemma55` (the switch (5.5) with `2γ`).

Conventions. Everything is real-valued. `favg s f` is the uniform average over a finset,
`win X = [X, 2X) ⊂ ℤ`, `expSum X g θ = ∑_{x ∈ [X,2X)} g(x) e(θx)`. The almost primes
`p₁⋯p_k` (`p_ℓ` prime in `[a ℓ, b ℓ)`) form `almostPrimes a b`; `D.Pp` is GS's `𝒫'` and
`D.Pset` is GS's `𝒫`. `Q = ⌊δ^{-C₂}⌋` is `D.Q C₂`.
-/

open Finset Real

namespace G22.P51

/- ## Basic objects -/

/-- Uniform average over a finset (`0` for the empty finset). -/
noncomputable def favg {α : Type*} (s : Finset α) (f : α → ℝ) : ℝ := wavg s (fun _ => 1) f

/-- The window `[X, 2X)` of integers. -/
noncomputable def win (X : ℕ) : Finset ℤ := Finset.Ico (X : ℤ) (2 * (X : ℤ))

/-- `∑_{x ∈ [X, 2X)} g(x) e(θx)` (GS's `ĝ`, up to the sign of `θ`). -/
noncomputable def expSum (X : ℕ) (g : ℤ → ℝ) (θ : ℝ) : ℂ :=
  ∑ x ∈ win X, (g x : ℂ) * FPD.ee (θ * x)

/-- The almost primes `p₁ ⋯ p_k` with `p_ℓ` prime in `[a ℓ, b ℓ)` (FPDQ's `boxProd`). -/
def almostPrimes {k : ℕ} (a b : Fin k → ℕ) : Finset ℕ :=
  FPDQ.boxProd fun ℓ => primesIn (a ℓ) (b ℓ)

/-- GS's `γ(𝒩) = E^log_{n,n' ∈ 𝒩} ((n, n') - 1)` (p. 15). -/
noncomputable def gcdDefect (S : Finset ℕ) : ℝ :=
  lavg S fun a => lavg S fun b => (Nat.gcd a b : ℝ) - 1

/-- Mertens mass `∑_{A ≤ p < B} 1/p`. -/
noncomputable def mass (A B : ℕ) : ℝ := ∑ p ∈ primesIn A B, (1 : ℝ) / p

/-- `log log B - log log A`. -/
noncomputable def ell (A B : ℕ) : ℝ := Real.log (Real.log B) - Real.log (Real.log A)

/- ## The data of Proposition 5.1

`Data` bundles the parameters of `Prop51With` together with all its hypotheses except
`δ ≤ δ₀`, `N₀ ≤ N` and the functions; the field hypotheses are copied verbatim from
`Interface.lean`, so the assembly can build a `Data` from the binders of `Prop51With`. -/

/-- Parameters and hypotheses of GS Proposition 5.1 (`Prop51With`). -/
structure Data where
  δ : ℝ
  N : ℕ
  k : ℕ
  P₁' : ℕ
  P₂' : ℕ
  lo : Fin (k + 1) → ℕ
  hi : Fin (k + 1) → ℕ
  lam : ℕ
  hδ : 0 < δ
  hk : 1 ≤ k
  hkN : (k : ℝ) ≤ Real.log (Real.log N)
  hδN : 1 / δ ≤ Real.log (Real.log N)
  hkδ : (k : ℝ) ≤ (1 / δ) ^ 10
  hP₁' : 3 ≤ P₁'
  hP₁'N : Real.log (Real.log N) ≤ (Real.log (Real.log P₁')) ^ 10
  hP₁'P₂' : P₁' < P₂'
  hP₂'P₁ : P₂' < lo (Fin.last k)
  hP₁P₂ : lo (Fin.last k) < hi (Fin.last k)
  h4 : 4 * lo (Fin.last k) ≤ hi (Fin.last k)
  hP₂N : (Real.log (hi (Fin.last k))) ^ 4 < Real.log N
  hpow : P₂' ^ 10 ≤ lo (Fin.last k)
  hI : ∀ ℓ : Fin k, P₁' ≤ lo ℓ.castSucc ∧ lo ℓ.castSucc < hi ℓ.castSucc ∧ hi ℓ.castSucc ≤ P₂'
  hdisj : ∀ ℓ ℓ' : Fin k, ℓ ≠ ℓ' → hi ℓ.castSucc ≤ lo ℓ'.castSucc ∨ hi ℓ'.castSucc ≤ lo ℓ.castSucc
  hprod : (∏ ℓ : Fin k, hi ℓ.castSucc) ≤ P₂'
  hwidth : ∀ ℓ : Fin k, Real.log (Real.log (lo ℓ.castSucc)) + k * (1 / δ) ^ 5 ≤
    Real.log (Real.log ((hi ℓ.castSucc : ℝ) - 1))
  hlam : 1 ≤ lam
  hlamN : (Real.log lam) ^ 4 ≤ Real.log N
  hlamP : ∀ p : ℕ, p.Prime → p ∣ lam → p < P₁'

namespace Data

variable (D : Data)

/-- `P₁`, the left end of the interval of the prime `p`. -/
def P₁ : ℕ := D.lo (Fin.last D.k)

/-- `P₂`, the right end of the interval of the prime `p`. -/
def P₂ : ℕ := D.hi (Fin.last D.k)

/-- GS's `𝒫`: the primes in `[P₁, P₂)`. -/
def Pset : Finset ℕ := primesIn D.P₁ D.P₂

/-- GS's `𝒫'`: the almost primes `p₁ ⋯ p_k`, `p_ℓ ∈ I_ℓ`. -/
def Pp : Finset ℕ :=
  almostPrimes (fun ℓ : Fin D.k => D.lo ℓ.castSucc) (fun ℓ : Fin D.k => D.hi ℓ.castSucc)

/-- `Q = ⌊δ^{-C₂}⌋` (GS p. 15). -/
noncomputable def Q (C₂ : ℕ) : ℕ := ⌊(1 / D.δ) ^ C₂⌋₊

end Data

/- ## The averages of GS §5 -/

/-- `E^log_{n∈[N]} f₁(n + λpp') f₂(λnpp')`, the summand of (5.1). -/
noncomputable def origInner (D : Data) (f₁ f₂ : ℤ → ℝ) (p p' : ℕ) : ℝ :=
  logAvg D.N fun n =>
    f₁ (n + (D.lam : ℤ) * ((p : ℤ) * p')) * f₂ ((D.lam : ℤ) * n * ((p : ℤ) * p'))

/-- `A_x(n) = E^log_{p'∈𝒫'} p' 1_{p'∣n} f₁(n/p' + λxp')` (GS p. 16; not 1-bounded). -/
noncomputable def Aval (D : Data) (f₁ : ℤ → ℝ) (x n : ℤ) : ℝ :=
  lavg D.Pp fun p' =>
    (p' : ℝ) * (if (p' : ℤ) ∣ n then f₁ (n / p' + (D.lam : ℤ) * x * p') else 0)

/-- `Φ(x) = E^log_{p'₁,p'₂∈𝒫'} E^log_{n∈[N]} f₁(np'₂ + λxp'₁) f₁(np'₁ + λxp'₂)`, the inner
average of (5.7), (5.9), (5.10). -/
noncomputable def Phi (D : Data) (f₁ : ℤ → ℝ) (x : ℤ) : ℝ :=
  lavg D.Pp fun p₁ => lavg D.Pp fun p₂ => logAvg D.N fun n =>
    f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)

/-- The left side of (5.14)/(5.15), with a weight `ρ` absorbing the logarithmic weights of the
`p'_i` (GS p. 18): `E_{p'₁∈B₁,p'₂∈B₂} ρ(p'₁,p'₂) E_{x∈[X,2X)} ψ(x) E_{n∈[u,u+L)}
f₁(np'₂ + λxp'₁) f₁(np'₁ + λxp'₂)`. -/
noncomputable def lhs14 (f₁ ψ : ℤ → ℝ) (lam X : ℕ) (B₁ B₂ : Finset ℕ) (ρ : ℕ → ℕ → ℝ)
    (u : ℤ) (L : ℕ) : ℝ :=
  favg B₁ fun p₁ => favg B₂ fun p₂ => ρ p₁ p₂ * favg (win X) fun x => ψ x *
    favg (Finset.Ico u (u + L)) fun n =>
      f₁ (n * p₂ + (lam : ℤ) * x * p₁) * f₁ (n * p₁ + (lam : ℤ) * x * p₂)

/-- The left side of GS (2.12) (real case), written exactly as the hypothesis of
`L26.lemma26_one`: `E_{n∈[X,2X)} E_{t₁,t'₁∈[T₁], t₂,t'₂∈[T₂]} E_{s₁∈S₁,s₂∈S₂}
Δ_{s₁(t₁,t'₁)} Δ_{s₂(t₂,t'₂)} ψ(n)`. -/
noncomputable def box12 (ψ : ℤ → ℝ) (X : ℕ) (S₁ S₂ : Finset ℤ) (T₁ T₂ : ℕ) : ℝ :=
  L26.dAvg X (fun n => uavg T₁ fun t₁ => uavg T₁ fun t₁' => uavg T₂ fun t₂ =>
    uavg T₂ fun t₂' =>
      (∑ s₁ ∈ S₁, ∑ s₂ ∈ S₂, ψ (n + t₁ * s₁ + t₂ * s₂) * ψ (n + t₁' * s₁ + t₂ * s₂) *
        ψ (n + t₁ * s₁ + t₂' * s₂) * ψ (n + t₁' * s₁ + t₂' * s₂)) / (S₁.card * S₂.card))

/-- The left side of GS (5.20) with `q₁ = q₂ = 1` (the conclusion of `L26.lemma26_one`):
`E_{n∈[2X]} E_{h₁,h'₁∈[H₁], h₂,h'₂∈[H₂]} Δ_{1(h₁,h'₁)} Δ_{1(h₂,h'₂)} ψ(n)`. -/
noncomputable def box20 (ψ : ℤ → ℝ) (X H₁ H₂ : ℕ) : ℝ :=
  uavg (2 * X) fun n => uavg H₁ fun h₁ => uavg H₁ fun h₁' => uavg H₂ fun h₂ =>
    uavg H₂ fun h₂' =>
      ψ (n + h₁ + h₂) * ψ (n + h₁' + h₂) * ψ (n + h₁ + h₂') * ψ (n + h₁' + h₂')

/-- The summand of (5.26): for `T = ⌊P₁^{1/2}⌋`,
`G(p'₁,p'₂) = E_{t,t'∈[T]} E^log_{n∈[N]} f₁(n + λtQ!(p'₁² - p'₂²)) f₁(n + λt'Q!(p'₁² - p'₂²))`. -/
noncomputable def Gfun (D : Data) (f₁ : ℤ → ℝ) (Q : ℕ) (p₁ p₂ : ℕ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' => logAvg D.N fun n =>
    f₁ (n + (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
      f₁ (n + (D.lam : ℤ) * t' * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2))

/-- The expression of GS p. 22 after Cauchy–Schwarz, restricted to coprime pairs:
`E_{h∈[X,2X)} |Λ_per(h)| E_{t,t'} E^log_{p'₁,p'₂} 1_{(p'₁,p'₂)=1}
E^log_n f₁(np'₂ + λhp'₁ + λtQ!(p'₁²-p'₂²)) f₁(np'₂ + λhp'₁ + λt'Q!(p'₁²-p'₂²))`. -/
noncomputable def CS1 (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λper : ℤ → ℝ) : ℝ :=
  favg (win X) fun h => |Λper h| *
    uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
      lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
        (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) * logAvg D.N fun n =>
          f₁ (n * p₂ + (D.lam : ℤ) * h * p₁ +
              (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
            f₁ (n * p₂ + (D.lam : ℤ) * h * p₁ +
              (D.lam : ℤ) * t' * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2))

/-- The left side of (5.12) for two boxes (logarithmic weights):
`E^log_{p'₁∈B₁,p'₂∈B₂} E_{x∈[X,2X)} ψ(x) E^log_{n∈[N]} f₁(np'₂ + λxp'₁) f₁(np'₁ + λxp'₂)`. -/
noncomputable def lhs12 (D : Data) (f₁ ψ : ℤ → ℝ) (X : ℕ) (B₁ B₂ : Finset ℕ) : ℝ :=
  lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg (win X) fun x => ψ x * logAvg D.N fun n =>
    f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)

/-- The left side of (5.24) after the replacements of GS p. 21 (`T = ⌊√P₁⌋`):
`E_{t∈[T]} E^log_{p'₁,p'₂} E_{x∈[X,2X)} Λ_per(x) E^log_{n∈[N]}
f₁(np'₂ + λxp'₁ + λtQ!(p'₁²-p'₂²)) f₁(np'₁ + λxp'₂)`. -/
noncomputable def Z524 (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λper : ℤ → ℝ) : ℝ :=
  uavg (Nat.sqrt D.P₁) fun t => lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
    favg (win X) fun x => Λper x * logAvg D.N fun n =>
      f₁ (n * p₂ + (D.lam : ℤ) * x * p₁ +
          (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
        f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)

/-- The left side of (5.25): as `CS1` but with `np'₂` replaced by `n` (after A.3):
`E_h |Λ_per(h)| E_{t,t'} E^log_{p'₁,p'₂} 1_{(p'₁,p'₂)=1}
E^log_n f₁(n + λhp'₁ + λtQ!(p'₁²-p'₂²)) f₁(n + λhp'₁ + λt'Q!(p'₁²-p'₂²))`. -/
noncomputable def Z525 (D : Data) (f₁ : ℤ → ℝ) (Q X : ℕ) (Λper : ℤ → ℝ) : ℝ :=
  favg (win X) fun h => |Λper h| *
    uavg (Nat.sqrt D.P₁) fun t => uavg (Nat.sqrt D.P₁) fun t' =>
      lavg D.Pp fun p₁ => lavg D.Pp fun p₂ =>
        (if Nat.Coprime p₁ p₂ then (1 : ℝ) else 0) * logAvg D.N fun n =>
          f₁ (n + (D.lam : ℤ) * h * p₁ +
              (D.lam : ℤ) * t * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
            f₁ (n + (D.lam : ℤ) * h * p₁ +
              (D.lam : ℤ) * t' * Q.factorial * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2))

/- ## Subdyadic boxes (GS pp. 17–18 and 22) -/

/-- A box `∏ [a ℓ, b ℓ)` inside `∏ I_ℓ` with ratios `b ℓ / a ℓ ≤ 1 + 1/(4k)` (so the box lies in
`[Y, 2Y)`, `Y = ∏ a ℓ`) and at least `⌊√P'₁⌋` primes in every factor. Used for (5.9). -/
def Good5 (D : Data) (a b : Fin D.k → ℕ) : Prop :=
  ∀ ℓ : Fin D.k, D.lo ℓ.castSucc ≤ a ℓ ∧ a ℓ < b ℓ ∧ b ℓ ≤ D.hi ℓ.castSucc ∧
    4 * D.k * b ℓ ≤ (4 * D.k + 1) * a ℓ ∧ Nat.sqrt D.P₁' ≤ (primesIn (a ℓ) (b ℓ)).card

/-- A `Good5` box whose ratios are also `≥ 1 + 1/(8k)` and whose last factor is `δ⁶`-rich in the
counting form of review §9.2 Sel(iv): `δ⁶ (b - a) ≤ 4 log a · #primes in [a, b)`. Used for (5.10). -/
def Good6 (D : Data) (a b : Fin D.k → ℕ) : Prop :=
  Good5 D a b ∧ (∀ ℓ : Fin D.k, (8 * D.k + 1) * a ℓ ≤ 8 * D.k * b ℓ) ∧
    ∀ ℓ : Fin D.k, ℓ.val + 1 = D.k →
      D.δ ^ 6 * ((b ℓ : ℝ) - a ℓ) ≤ 4 * Real.log (a ℓ) * (primesIn (a ℓ) (b ℓ)).card

/-- The FPD property (review §9.1) of the squares of a box, in both signs:
`{e(x² - c) : x ∈ box}` at threshold `δ⁷`, with `Q₀ = W = δ^{-A'}`, `D = 4Y²`, `Y = ∏ a ℓ`
(the normalisation of `FPDQ.lemmaRQ_FPD`), for all `T` with `16Y² ≤ δ^{A'} T`.
This is what Lemma R + Lemma Q give (step P6c1). -/
def SqFPD (D : Data) (A' : ℕ) (a b : Fin D.k → ℕ) : Prop :=
  ∀ (e c : ℤ), (e = 1 ∨ e = -1) → ∀ T : ℕ,
    16 * ((∏ ℓ, a ℓ : ℕ) : ℝ) ^ 2 ≤ D.δ ^ A' * T →
    L24.FPDProp ((almostPrimes a b).image fun x : ℕ => e * ((x : ℤ) ^ 2 - c)) T
      (4 * (∏ ℓ, a ℓ) ^ 2) (D.δ ^ 7) ((1 / D.δ) ^ A') ((1 / D.δ) ^ A')

/- ## External inputs

All external inputs of the body of Proposition 5.1 are proved and used directly:
* GS Lemma 4.1: `L41.lemma41 : L41.Lemma41Stmt` (Selberg majorant `Λ̃ = Λt X`; (4.1) as
  `log X / 16 ≤ Λ̃(p)` for all primes `p ≥ X ≥ 2¹⁶`, (4.2) as `∑_{[X,2X)} Λ̃ ≤ 2X`, and for each
  `c ∈ (0,1)` constants `C, E` with (4.3)–(4.6) and (4.17) for `2 ≤ Q ≤ log X`);
* Brun–Titchmarsh: `L41.btWith : FPDQ.BTWith 40 2`;
* Lemma 2.4*: `L24.lemma24_gen`; Lemma 2.6*: `L26.lemma26_one` (its correlation hypothesis is
  `box12`, its conclusion `box20`); Lemma L: `FPD.lemmaL`, `FPDQ.lemmaL_box_FPD`;
* the FPD toolkit `FPDQ.*` (Lemma C, Q, R, Sel, PH, M54);
* A.1, A.2: `Elem.uavg_shift_le`, `Elem.logAvg_shift_le'`; A.2 (residues), A.3, A.4, A.6 and
  Lemma 5.2: `Small.lemmaA2res`, `Small.lemmaA3`, `Small.lemmaA4`, `Small.lemmaA6`,
  `Small.lemma52_prop51`, `Small.lemma52_indicator`, `Small.lemma55` (iterated form; convert with
  `StepProdAvg`); Mertens: `MertensProof.mertensLowerWith`. -/

/-- The properties of `Λ_per` supplied by GS Lemma 4.1 (`L41.Lemma41Stmt`, verbatim) at level
`Q = ⌊δ^{-C₂}⌋`: `Q!`-periodicity, (4.3) in `ℓ¹` and `ℓ^∞` form, and (4.17). -/
def PerHyp (D : Data) (C : ℝ) (C₂ X : ℕ) (Λper : ℤ → ℝ) : Prop :=
  (∀ x : ℤ, Λper (x + (D.Q C₂).factorial) = Λper x) ∧
  (∑ x ∈ Finset.Ico (X : ℤ) (2 * X), |Λper x| ≤ C * Real.log (D.Q C₂) ^ 12 * X) ∧
  (∀ a : ℤ, ∑ x ∈ Finset.Ico a (a + (D.Q C₂).factorial), |Λper x| ≤
    C * Real.log (D.Q C₂) ^ 12 * (D.Q C₂).factorial) ∧
  (∀ x : ℤ, |Λper x| ≤ C * (D.Q C₂ : ℝ) ^ 2)

/- ## Steps P0–P3: from (5.1) to (5.7) -/

/-- **Product identity** (shared helper; GS p. 15 / `Interface.lean`: "every element of `𝒫'` has
just one representation"): for pairwise disjoint sets of primes, the iterated logarithmic
average of a function of the product equals the logarithmic average over the box
(`FPDQ.lemmaC_injOn`). Converts `Small.gammaP`, `Small.lemma55` and `Prop51With`'s average to
the set form used below. -/
def StepProdAvg : Prop :=
  ∀ (k : ℕ) (S : Fin k → Finset ℕ), (∀ ℓ, ∀ p ∈ S ℓ, p.Prime) →
    (∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (S ℓ) (S ℓ')) →
    ∀ F : ℕ → ℝ, iterAvg k S (fun a => F (∏ ℓ, a ℓ)) = lavg (FPDQ.boxProd S) F

/-- **P0a** (GS p. 15, and `Interface.lean` on the iterated average): the average in `Prop51With`
equals `E^log_{p∈𝒫} E^log_{p'∈𝒫'} E^log_{n∈[N]} f₁(n + λpp') f₂(λnpp')` (Fubini plus uniqueness
of the factorisation `p' = p₁⋯p_k`, `FPDQ.lemmaC_injOn`). -/
def StepP0a : Prop :=
  ∀ (D : Data) (f₁ f₂ : ℤ → ℝ),
    iterAvg (D.k + 1) (fun ℓ => primesIn (D.lo ℓ) (D.hi ℓ))
        (fun pp => logAvg D.N (fun n =>
          f₁ (n + (D.lam : ℤ) * ∏ ℓ, (pp ℓ : ℤ)) * f₂ ((D.lam : ℤ) * n * ∏ ℓ, (pp ℓ : ℤ)))) =
      lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p'))

/-- **P0b** (GS §5.1, p. 15): `P₁` is large and `δ^{-C₂} ≤ log P₁` (so `Q ≤ log X`). -/
def StepP0b : Prop :=
  ∀ X₀ C₂ : ℕ, ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    X₀ ≤ D.P₁ ∧ (1 / D.δ) ^ C₂ ≤ Real.log D.P₁

/-- **P1** (GS p. 16, removal of `f₂`: A.4 for each `p'`, Cauchy–Schwarz twice):
`E^log_{p∈𝒫} E^log_n A_p(n)² ≥ δ²/2`. -/
def StepP1 : Prop :=
  ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    ∀ f₁ f₂ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → (∀ n, |f₂ n| ≤ 1) →
      D.δ ≤ |lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p'))| →
      D.δ ^ 2 / 2 ≤ lavg D.Pset (fun p => logAvg D.N (fun n => Aval D f₁ p n ^ 2))

/-- **P2** (GS pp. 16–17, passage to a dyadic interval; Chebyshev instead of the PNT, using
`P₂ ≥ 4P₁`): from `FPDQ.lemmaM54A`. -/
def StepP2 : Prop :=
  ∃ c₂ : ℝ, 0 < c₂ ∧ ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    ∀ F : ℕ → ℝ, (∀ p ∈ D.Pset, 0 ≤ F p) → ∀ α : ℝ, α ≤ lavg D.Pset F →
      ∃ X : ℕ, D.P₁ ≤ X ∧ X < D.P₂ ∧
        c₂ * α * X / Real.log X ≤ ∑ p ∈ D.Pset.filter (fun p => X ≤ p ∧ p < 2 * X), F p

/-- **P3** (GS p. 17, (5.4) → (5.5) → (5.6) → (5.7)): pass to the majorant `Λ̃` of Lemma 4.1
(only (4.1), (4.2) are used, in the form of `L41.Lemma41Stmt`), expand the square, replace
`1_{[p'₁,p'₂]∣n}` by `1_{p'₁p'₂∣n}` (`Small.lemma55` + Lemma 5.2) and apply A.4 with
`q = p'₁p'₂`. -/
def StepP3 : Prop :=
  ∀ c₂ : ℝ, 0 < c₂ →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ Λt : ℤ → ℝ, (∀ x, 0 ≤ Λt x) →
        (∀ p : ℕ, p.Prime → X ≤ p → Real.log X / 16 ≤ Λt p) →
        (∑ x ∈ Finset.Ico (X : ℤ) (2 * X), Λt x ≤ 2 * X) →
        c₂ * (D.δ ^ 2 / 2) * X / Real.log X ≤
          ∑ p ∈ D.Pset.filter (fun p => X ≤ p ∧ p < 2 * X),
            logAvg D.N (fun n => Aval D f₁ p n ^ 2) →
        c₂ * D.δ ^ 2 / 64 ≤ favg (win X) (fun x => Λt x * Phi D f₁ x)

/- ## Subdyadic partitions (shared by P5a and P6b) -/

/-- **Boxes** (GS p. 17: `I_ℓ = ⊔_j [Y, (1+η_{ℓ,j})Y)` with `1/(8k) ≤ η ≤ 1/(4k)`), with integer
endpoints: `[A, B)` is cut into `m` consecutive pieces with ratios in `[1+1/(8k), 1+1/(4k)]`. -/
def StepBoxes : Prop :=
  ∀ k A B : ℕ, 1 ≤ k → 1000 * k ^ 2 ≤ A → 2 * A ≤ B →
    ∃ (m : ℕ) (a : ℕ → ℕ), 1 ≤ m ∧ a 0 = A ∧ a m = B ∧
      ∀ i < m, (8 * k + 1) * a i ≤ 8 * k * a (i + 1) ∧ 4 * k * a (i + 1) ≤ (4 * k + 1) * a i

/-- **Growth** (optional shared helper for the "`N` sufficiently large" arguments, GS §5.1):
`P'₁` exceeds every fixed power of `log N` (as `log log P'₁ ≥ (log log N)^{1/10}`), and `log N`
exceeds every fixed power of `log log N` (which bounds `k` and `1/δ`). Not used by the assembly. -/
def StepGrowth : Prop :=
  ∀ B : ℕ, ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    (Real.log D.N) ^ B ≤ D.P₁' ∧ (Real.log (Real.log D.N)) ^ B ≤ Real.log D.N

/- ## Step P5: (5.9) is impossible

Sub-steps: P5a (5.9)→(5.12), P5b (5.12)→(5.14), P5c (5.16)→(2.12), P5d (5.20)→(5.18),
P5e = claim (5.15) in inverse form (`GlueP5e`), P5 = the contradiction (`GlueP5`). -/

/-- **P5a** (GS p. 17, (5.9) → (5.12)): signed pigeonhole over pairs of `Good5` boxes from the
partition `StepBoxes` (boxes with a factor of `< ⌊√P'₁⌋` primes carry negligible mass:
`FPDQ.lemmaSel_iii`, `FPDQ.prod_weight_bad_pair`, `FPDQ.lemmaPH`; total masses `≥ 1` by Mertens).
Only `E|ψ| ≤ 1/δ` is used (GS (5.11)). -/
def StepP5a : Prop :=
  ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
    ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
    ∀ ψ : ℤ → ℝ, favg (win X) (fun x => |ψ x|) ≤ 1 / D.δ →
      D.δ ^ 3 ≤ |favg (win X) (fun x => ψ x * Phi D f₁ x)| →
      ∃ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good5 D a₁ b₁ ∧ Good5 D a₂ b₂ ∧
        D.δ ^ 3 / 2 ≤ |lhs12 D f₁ ψ X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂)|

/-- **P5b** (GS p. 18, (5.12) → (5.13) → (5.14)): drop `n ≤ N' = e^{(log N)^{3/4}}`, pigeonhole
an interval `[u, u+L)`, `e^{(log N)^{1/2}} ≤ L ≤ 2e^{(log N)^{1/2}}`, of `[N', N]`, pass to uniform
weights in `n` (ratio `1 + O(L/N')`) and in `p'_i` (the ratio `Y₁Y₂/(p'₁p'₂) ∈ [1/4, 1]` becomes
`ρ`, losing a factor `4`). -/
def StepP5b : Prop :=
  ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
    ∀ ψ : ℤ → ℝ, favg (win X) (fun x => |ψ x|) ≤ 1 / D.δ →
    ∀ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good5 D a₁ b₁ → Good5 D a₂ b₂ →
      D.δ ^ 3 / 2 ≤ |lhs12 D f₁ ψ X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂)| →
      ∃ ρ : ℕ → ℕ → ℝ, (∀ s t, |ρ s t| ≤ 1) ∧ ∃ (u : ℤ) (L : ℕ),
        Real.log D.N ≤ (Real.log L) ^ 2 ∧
        D.δ ^ 3 / 16 ≤ |lhs14 f₁ ψ D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L|

/-- **P5c** (GS p. 19, (5.16) → (5.19) → (2.12)): the substitution
`n = n' - λ(p'₁t₂ + p'₂t₁)`, `x = x' + p'₁t₁ + p'₂t₂`, A.1 for both shifted ranges, fixing `n'`,
and Cauchy–Schwarz twice. A general statement, no parameters of Prop 5.1. -/
def StepP5c : Prop :=
  ∀ (f₁ ψ : ℤ → ℝ), (∀ n, |f₁ n| ≤ 1) → (∀ n, |ψ n| ≤ 1) →
  ∀ (B₁ B₂ : Finset ℕ), B₁.Nonempty → B₂.Nonempty →
  ∀ (ρ : ℕ → ℕ → ℝ), (∀ s t, |ρ s t| ≤ 1) →
  ∀ (lam X : ℕ) (u : ℤ) (L T₁ T₂ : ℕ), 1 ≤ X → 1 ≤ L → 1 ≤ T₁ → 1 ≤ T₂ →
  ∀ τ : ℝ, 0 < τ →
    (∀ p₁ ∈ B₁, ∀ p₂ ∈ B₂, 8 * ((p₁ * T₁ + p₂ * T₂ : ℕ) : ℝ) ≤ τ * X) →
    (∀ p₁ ∈ B₁, ∀ p₂ ∈ B₂, 8 * ((lam * (p₁ * T₂ + p₂ * T₁) : ℕ) : ℝ) ≤ τ * L) →
    τ ≤ |lhs14 f₁ ψ lam X B₁ B₂ ρ u L| →
    (τ / 2) ^ 4 ≤ box12 ψ X (B₁.image fun s : ℕ => (s : ℤ)) (B₂.image fun s : ℕ => (s : ℤ)) T₁ T₂

/-- **P5d** (GS pp. 20–21, (5.20) → (5.22) → (5.18), done on `ZMod P`): for `ψ` supported on
`[X,2X)`, `2H² · box20 ψ X H H ≤ ‖ψ̂(θ)‖²` for some `θ`. (With `q₁ = q₂ = 1` the kernel is
`|D_H(u)|²|D_H(v)|² ≥ 0` and `∑_u |D_H(u)|² = PH`, which gives this bound directly; it is
stronger than GS's `H³/X` and needs no `L^{4/3}` estimate.) -/
def StepP5d : Prop :=
  ∀ X H : ℕ, 1 ≤ H → 2 * H + 1 ≤ X → ∀ ψ : ℤ → ℝ, (∀ x, |ψ x| ≤ 1) →
    (∀ x : ℤ, x ∉ win X → ψ x = 0) →
    ∃ θ : ℝ, 2 * (H : ℝ) ^ 2 * box20 ψ X H H ≤ ‖expSum X ψ θ‖ ^ 2

/-- **P5e** (claim (5.15) in inverse form, GS pp. 18–21): if the (5.14)-average of a 1-bounded
`ψ` over `Good5` boxes is `≥ τ` with `P'₁^{-1/A} ≤ τ ≤ τ₀`, then `‖ψ̂‖_∞ ≥ τ^A X`.
Proof (`GlueP5e`): P5c with `T_i = ⌊τ^{C₁} X / Y_i⌋`, `L26.lemma26_one` with the FPD of the boxes
from `FPDQ.lemmaL_box_FPD`, and P5d with `H = ⌊τ^{2C₁} X⌋`, applied to `ψ·1_{[X,2X)}`. -/
def StepP5e : Prop :=
  ∃ A : ℕ, 2 ≤ A ∧ ∃ τ₀ : ℝ, 0 < τ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
    ∀ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good5 D a₁ b₁ → Good5 D a₂ b₂ →
    ∀ ρ : ℕ → ℕ → ℝ, (∀ s t, |ρ s t| ≤ 1) →
    ∀ (u : ℤ) (L : ℕ), Real.log D.N ≤ (Real.log L) ^ 2 →
    ∀ ψ : ℤ → ℝ, (∀ x, |ψ x| ≤ 1) →
    ∀ τ : ℝ, 0 < τ → τ ≤ τ₀ → 1 ≤ τ ^ A * D.P₁' →
      τ ≤ |lhs14 f₁ ψ D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L| →
      ∃ θ : ℝ, τ ^ A * X ≤ ‖expSum X ψ θ‖

/-- **P5** (GS pp. 17–21, "(5.9) cannot hold"): for `Q = ⌊δ^{-C₂}⌋`, `C₂ ≥ 16A` and the data of
Lemma 4.1 at exponent `c = 1/A` (hypotheses verbatim from `L41.Lemma41Stmt`),
`|E_{x∈[X,2X)} (Λ̃ - Λ_per)(x) Φ(x)| < c'δ²/2`. Proof (`GlueP5`): P5a and P5b for
`ψ = Λ̃ - Λ_per` (`E|ψ| ≤ 2 + C log^{12} Q ≤ 1/δ`); linearity over `ψ = ∑ gᵢ + h`;
`|lhs14(h)| ≤ E|h| ≤ C/Q`; for each `gᵢ`, P5e and homogeneity give
`|lhs14(gᵢ)| ≤ τ₀⁻¹ X^{-c} Fᵢ^c Mᵢ^{1-c} + P'₁^{-c} Mᵢ`; sum with (4.5), (4.6):
total `≤ τ₀⁻¹ C Q^{-c/4} + P'₁^{-c} C log^E X + C/Q < δ³/16`. -/
def StepP5 : Prop :=
  ∃ A : ℕ, 2 ≤ A ∧ ∀ (c' C : ℝ) (E C₂ : ℕ), 0 < c' → 16 * A ≤ C₂ →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ (Λt Λper : ℤ → ℝ) (n : ℕ) (g : ℕ → ℤ → ℝ) (h : ℤ → ℝ) (M F : ℕ → ℝ),
        (∀ x, 0 ≤ Λt x) →
        (∑ x ∈ Finset.Ico (X : ℤ) (2 * X), Λt x ≤ 2 * X) →
        (∑ x ∈ Finset.Ico (X : ℤ) (2 * X), |Λper x| ≤ C * Real.log (D.Q C₂) ^ 12 * X) →
        (∀ x : ℤ, Λt x - Λper x = ∑ i ∈ range n, g i x + h x) →
        (∑ x ∈ Finset.Ico (X : ℤ) (2 * X), |h x| ≤ C / (D.Q C₂) * X) →
        (∀ i ∈ range n, ∀ x, |g i x| ≤ M i) → (∀ i, 0 ≤ M i) →
        (∑ i ∈ range n, M i ≤ C * Real.log X ^ E) →
        (∀ i ∈ range n, ∀ θ : ℝ,
          ‖∑ x ∈ Finset.Ico (X : ℤ) (2 * X), (g i x : ℂ) * FPD.ee (θ * x)‖ ≤ F i) →
        (∀ i, 0 ≤ F i) →
        (∑ i ∈ range n, F i ^ (1 / (A : ℝ)) * M i ^ (1 - 1 / (A : ℝ)) ≤
          C * (X : ℝ) ^ (1 / (A : ℝ)) * (D.Q C₂ : ℝ) ^ (-(1 / (A : ℝ) / 4))) →
        |favg (win X) (fun x => (Λt x - Λper x) * Phi D f₁ x)| < c' * D.δ ^ 2 / 2

/- ## Step P6: from (5.10) to the conclusion

Sub-steps: P6a (5.10)→(5.24), P6b Cauchy–Schwarz and coprime pairs, P6c (5.25),
P6d (5.26), P6e refoliation, P6f FPD of squares, P6g Lemma 2.4*, P7 Lemma A.6; P6 = `GlueP6`.
All of P6a–P6d assume the properties `PerHyp` of `Λ_per` (verbatim from `L41.Lemma41Stmt`). -/

/-- **P6a** (GS p. 21, (5.10) → (5.24)): for each `t ∈ [⌊√P₁⌋]` substitute `n = n' - Q!λp'₂t`,
`x = x' + Q!p'₁t` (`Λ_per` is `Q!`-periodic), replace the `x'`-range by A.1 and
`‖Λ_per‖_∞ ≤ CQ²` (error `≪ Q²Q!P'₂√P₁/X`), the `n'`-range by A.2 (error
`≪ E|Λ_per| log(Q!λP'₂√P₁)/log N`), and average over `t`. -/
def StepP6a : Prop :=
  ∀ (c' C : ℝ) (C₂ : ℕ), 0 < c' →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ Λper : ℤ → ℝ, PerHyp D C C₂ X Λper →
        c' * D.δ ^ 2 / 2 ≤ favg (win X) (fun x => Λper x * Phi D f₁ x) →
        c' * D.δ ^ 2 / 4 ≤ Z524 D f₁ (D.Q C₂) X Λper

/-- **P6b** (GS pp. 21–22): the triangle inequality (drop `f₁(np'₁ + λxp'₂)`), Cauchy–Schwarz with
weight `|Λ_per|` (the `t`-average squared), and removal of the pairs with `(p'₁,p'₂) ≠ 1`, whose
contribution is `≤ E|Λ_per| · γ(𝒫') ≤ 4δ⁵ E|Λ_per|` (`Small.lemma52_indicator`,
`Small.lemma52_prop51`, `StepProdAvg`); `E|Λ_per| ≤ C log^{12} Q` is polylogarithmic in `1/δ`. -/
def StepP6b : Prop :=
  ∀ (c' C : ℝ) (C₂ : ℕ), 0 < c' →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ Λper : ℤ → ℝ, PerHyp D C C₂ X Λper →
        c' * D.δ ^ 2 / 4 ≤ Z524 D f₁ (D.Q C₂) X Λper →
        (c' * D.δ ^ 2) ^ 2 / 32 ≤ favg (win X) (fun x => |Λper x|) * CS1 D f₁ (D.Q C₂) X Λper

/-- **P6c** (GS p. 22, → (5.25)): add the average over `h' ∈ [⌊δ⁵X/Q!⌋]` by periodicity (edge
effects `≤ 4δ⁵ E|Λ_per|` via (4.17)), then A.3 (`Small.lemmaA3`) with `q = p'₂`, `b = λQ!p'₁`
(coprime: `(p'₁,p'₂) = 1`, the primes of `λ` are `< P'₁`, and `Q < P'₁`). -/
def StepP6c : Prop :=
  ∀ (c' C : ℝ) (C₂ : ℕ), 0 < c' →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ Λper : ℤ → ℝ, PerHyp D C C₂ X Λper →
        (c' * D.δ ^ 2) ^ 2 / 32 ≤ favg (win X) (fun x => |Λper x|) * CS1 D f₁ (D.Q C₂) X Λper →
        (c' * D.δ ^ 2) ^ 2 / 64 ≤ favg (win X) (fun x => |Λper x|) * Z525 D f₁ (D.Q C₂) X Λper

/-- **P6d** (GS p. 22, (5.25) → (5.26)): remove the shift `λhp'₁` by A.2, so the `h`-average
decouples to `E|Λ_per|`; divide by `E|Λ_per| ≤ C log^{12} Q`, and drop the coprimality condition
(the summands `Gfun ≥ 0`). -/
def StepP6d : Prop :=
  ∀ (c' C : ℝ) (C₂ : ℕ), 0 < c' →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ Λper : ℤ → ℝ, PerHyp D C C₂ X Λper →
        (c' * D.δ ^ 2) ^ 2 / 64 ≤ favg (win X) (fun x => |Λper x|) * Z525 D f₁ (D.Q C₂) X Λper →
        D.δ ^ 5 ≤ lavg D.Pp (fun s => lavg D.Pp (fun t => Gfun D f₁ (D.Q C₂) s t))

/-- **P6e** (GS p. 22, refoliation; review §5.2 fix G1): nonnegative pigeonhole over pairs of
`Good6` boxes (`StepBoxes`; the last factor `δ⁶`-rich: `FPDQ.lemmaSel_ii`, `lemmaSel_iv` with
Mertens; `≥ ⌊√P'₁⌋` primes per factor: `lemmaSel_iii`; `FPDQ.lemmaPH_nonneg`,
`prod_weight_bad_pair`), then log → uniform weights (factor `≤ 4` since `G ≥ 0`). -/
def StepP6e : Prop :=
  ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
    ∀ G : ℕ → ℕ → ℝ, (∀ s t, 0 ≤ G s t ∧ G s t ≤ 1) →
      D.δ ^ 5 ≤ lavg D.Pp (fun s => lavg D.Pp (fun t => G s t)) →
      ∃ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good6 D a₁ b₁ ∧ Good6 D a₂ b₂ ∧
        D.δ ^ 6 ≤ favg (almostPrimes a₁ b₁) (fun s => favg (almostPrimes a₂ b₂) (fun t => G s t))

/-- **P6f** (review §9.1 Lemma R + Lemma Q; GS p. 23 uses Lemma 3.2 with `j = 2` instead):
the squares of a `Good6` box have the FPD property `SqFPD`: `FPDQ.lemmaRQ_FPD` with
`L41.btWith`, `ε = δ⁶`, `η = δ⁷`, `ρ, V₀, d₀` as in review §9.4.6 (note `C_R = 2^{28673}`, so
`δ₀` is tiny), plus `fejer` evenness for the sign `e = -1`. -/
def StepP6f : Prop :=
  ∃ A' : ℕ, ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
    ∀ a b : Fin D.k → ℕ, Good6 D a b → SqFPD D A' a b

/-- **P6g** (GS p. 23): pigeonhole the variable of the box with the smaller `Y`, A.2
(`Small.lemmaA2res`) with modulus `λQ!`, Lemma 2.4* (`L24.lemma24_gen`, `T = ⌊√P₁⌋`, `D = 4Y²`,
`H = ⌊P₁^{1/4}⌋`, threshold `δ⁶/40 ≥ δ⁷`) for each good residue `a`, pigeonhole the modulus
`q ≤ δ^{-A'}`, and A.2 again. -/
def StepP6g : Prop :=
  ∀ A' : ℕ, ∃ A'' : ℕ, ∀ C₂ : ℕ, ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ,
    ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
    ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) →
    ∀ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good6 D a₁ b₁ → Good6 D a₂ b₂ →
      SqFPD D A' a₁ b₁ → SqFPD D A' a₂ b₂ →
      D.δ ^ 6 ≤ favg (almostPrimes a₁ b₁)
        (fun s => favg (almostPrimes a₂ b₂) (fun t => Gfun D f₁ (D.Q C₂) s t)) →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (1 / D.δ) ^ A' ∧
        D.δ ^ A'' ≤ U1logSq D.N (D.lam * (D.Q C₂).factorial * q) (Nat.sqrt (Nat.sqrt D.P₁)) f₁

/-- **P7** (GS p. 23, Lemma A.6): since `q ≤ δ^{-A'}` and `C₂ ≥ A' + 1`,
`qQ! ∣ (Q + q)! ∣ V = ⌊δ^{-2C₂}⌋!`; `Small.lemmaA6` moves from `(λqQ!, ⌊P₁^{1/4}⌋)` to `(λV, H)`
for every `H ≤ P₁^{1/8}` (its condition `λVH ≤ λqQ!⌊P₁^{1/4}⌋` holds as `V ≪ P₁^{1/8}`). -/
def StepP7 : Prop :=
  ∀ A' A'' C₂ : ℕ, A' + 1 ≤ C₂ →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
    ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) →
    ∀ q : ℕ, 1 ≤ q → (q : ℝ) ≤ (1 / D.δ) ^ A' →
      D.δ ^ A'' ≤ U1logSq D.N (D.lam * (D.Q C₂).factorial * q) (Nat.sqrt (Nat.sqrt D.P₁)) f₁ →
      ∀ H : ℕ, 1 ≤ H → H ^ 8 ≤ D.P₁ →
        D.δ ^ (A'' + 1) ≤
          Real.sqrt (U1logSq D.N (D.lam * (⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial) H f₁)

/-- **P6** (GS pp. 21–23, "(5.10) implies the conclusion"). Proof (`GlueP6`):
P6a → P6b → P6c → P6d → P6e (with `G = Gfun ∈ [0,1]`) → P6f (both boxes) → P6g → P7,
`A₆ = max(A' + 1, A'' + 1)`. -/
def StepP6 : Prop :=
  ∃ A₆ : ℕ, ∀ (c' C : ℝ) (C₂ : ℕ), 0 < c' → A₆ ≤ C₂ →
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∃ N₀ : ℕ, ∀ D : Data, D.δ ≤ δ₀ → N₀ ≤ D.N →
      ∀ f₁ : ℤ → ℝ, (∀ n, |f₁ n| ≤ 1) → ∀ X : ℕ, D.P₁ ≤ X → X < D.P₂ →
      ∀ Λper : ℤ → ℝ, PerHyp D C C₂ X Λper →
        c' * D.δ ^ 2 / 2 ≤ favg (win X) (fun x => Λper x * Phi D f₁ x) →
        ∀ H : ℕ, 1 ≤ H → H ^ 8 ≤ D.P₁ →
          D.δ ^ A₆ ≤
            Real.sqrt (U1logSq D.N (D.lam * (⌊(1 / D.δ) ^ (2 * C₂)⌋₊).factorial) H f₁)

/- ## Glue implications (each a separate proof task) -/

/-- P5e from P5c and P5d (with `L26.lemma26_one` and `FPDQ.lemmaL_box_FPD`): the parameter
choices `T_i = ⌊τ^{C₁}X/Y_i⌋`, `H = ⌊τ^{2C₁}X⌋`, `σ = (τ/2)⁴` and their verification. -/
def GlueP5e : Prop := StepP5c → StepP5d → StepP5e

/-- P5 from P5a, P5b, P5e (the contradiction with (4.4)–(4.6), GS p. 18). -/
def GlueP5 : Prop := StepP5a → StepP5b → StepP5e → StepP5

/-- P6 from P6a–P6g and P7. -/
def GlueP6 : Prop :=
  StepP6a → StepP6b → StepP6c → StepP6d → StepP6e → StepP6f → StepP6g → StepP7 → StepP6

/- ## The assembly -/

section Assembly

lemma logAvg_sq_nonneg (N : ℕ) (g : ℤ → ℝ) : 0 ≤ logAvg N (fun n => g n ^ 2) := by
  unfold logAvg wavg
  apply div_nonneg
  · exact Finset.sum_nonneg fun n _ => mul_nonneg (by positivity) (sq_nonneg _)
  · exact Finset.sum_nonneg fun n _ => by positivity

lemma favg_add' {α : Type*} (s : Finset α) (f g : α → ℝ) :
    favg s (fun x => f x + g x) = favg s f + favg s g := wavg_add f g

/-- **Assembly of GS Proposition 5.1** from the proved GS Lemma 4.1 (`L41.lemma41`) and the
top-level steps. Constants: `A` from P5, `A₆` from P6, `c = 1/A` in Lemma 4.1 (giving `C, E`),
`c₂` from P2, `c' = c₂/64`, `C₂ = 16A + A₆ + 1`, and for `Prop51With`: `C = 2C₂`, `c = 1`,
`C' = A₆`, `δ₀ = min(δ₀(P3), δ₀(P5), δ₀(P6), 1/2)`, `N₀ = max` of the step thresholds (P0b with
`X₀ = 2¹⁶`). Step P4 (GS p. 17: (5.9) or (5.10)) is the linearity argument below. -/
theorem prop51_of_steps (h0a : StepP0a) (h0b : StepP0b) (h1 : StepP1) (h2 : StepP2)
    (h3 : StepP3) (h5 : StepP5) (h6 : StepP6) : Prop51 := by
  obtain ⟨Λt, hΛnn, hΛpr, hΛsum, hdec⟩ := L41.lemma41
  obtain ⟨A, hA2, h5⟩ := h5
  obtain ⟨A₆, h6⟩ := h6
  have hApos : (0 : ℝ) < A := by exact_mod_cast (show 0 < A by omega)
  have hc0 : (0 : ℝ) < 1 / (A : ℝ) := by positivity
  have hc1 : 1 / (A : ℝ) < 1 := by
    rw [div_lt_one hApos]; exact_mod_cast (show 1 < A by omega)
  obtain ⟨C, E, -, hK⟩ := hdec (1 / (A : ℝ)) hc0 hc1
  obtain ⟨c₂, hc₂, N₂, h2⟩ := h2
  obtain ⟨N₁, h1⟩ := h1
  obtain ⟨δ₃, hδ₃, N₃, h3⟩ := h3 c₂ hc₂
  set C₂ : ℕ := 16 * A + A₆ + 1 with hC₂def
  set c' : ℝ := c₂ / 64 with hc'def
  have hc' : 0 < c' := by positivity
  obtain ⟨δ₅, hδ₅, N₅, h5⟩ := h5 c' C E C₂ hc' (by omega)
  obtain ⟨δ₆, hδ₆, N₆, h6⟩ := h6 c' C C₂ hc' (by omega)
  obtain ⟨N₀', h0b⟩ := h0b (2 ^ 16) C₂
  refine ⟨2 * C₂, by omega, 1, one_pos, A₆, min (min δ₃ δ₅) (min δ₆ (1 / 2)),
    lt_min (lt_min hδ₃ hδ₅) (lt_min hδ₆ (by norm_num)),
    max (max N₁ N₂) (max (max N₃ N₅) (max N₆ N₀')), ?_⟩
  intro δ hδ hδ₀ N k hN hk hkN hδN hkδ P₁' P₂' lo hi hP₁' hP₁'N hP₁'P₂' hP₂'P₁ hP₁P₂ h4 hP₂N
    hpow hI hdisj hprod hwidth lam hlam hlamN hlamP f₁ f₂ hf₁ hf₂ hcorr H hH hH8
  let D : Data :=
    { δ := δ, N := N, k := k, P₁' := P₁', P₂' := P₂', lo := lo, hi := hi, lam := lam,
      hδ := hδ, hk := hk, hkN := hkN, hδN := hδN, hkδ := hkδ, hP₁' := hP₁', hP₁'N := hP₁'N,
      hP₁'P₂' := hP₁'P₂', hP₂'P₁ := hP₂'P₁, hP₁P₂ := hP₁P₂, h4 := h4, hP₂N := hP₂N,
      hpow := hpow, hI := hI, hdisj := hdisj, hprod := hprod, hwidth := hwidth,
      hlam := hlam, hlamN := hlamN, hlamP := hlamP }
  -- the thresholds
  simp only [le_min_iff] at hδ₀
  obtain ⟨⟨hδ3, hδ5⟩, hδ6, hδhalf⟩ := hδ₀
  have hN1 : N₁ ≤ D.N := by show N₁ ≤ N; omega
  have hN2 : N₂ ≤ D.N := by show N₂ ≤ N; omega
  have hN3 : N₃ ≤ D.N := by show N₃ ≤ N; omega
  have hN5 : N₅ ≤ D.N := by show N₅ ≤ N; omega
  have hN6 : N₆ ≤ D.N := by show N₆ ≤ N; omega
  have hN0 : N₀' ≤ D.N := by show N₀' ≤ N; omega
  -- P0a: the average of `Prop51With` in the form `E^log_p E^log_{p'} …`
  have hcorr' :
      D.δ ≤ |lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p'))| := by
    rw [← h0a D f₁ f₂]; exact hcorr
  -- P1 and P2: the dyadic interval `[X, 2X)`
  have hP1 := h1 D hN1 f₁ f₂ hf₁ hf₂ hcorr'
  obtain ⟨X, hX1, hX2, hXsum⟩ := h2 D hN2 (fun p => logAvg D.N (fun n => Aval D f₁ p n ^ 2))
    (fun p _ => logAvg_sq_nonneg _ _) (D.δ ^ 2 / 2) hP1
  -- GS Lemma 4.1 at scale `X ≥ 2¹⁶`, level `Q = ⌊δ^{-C₂}⌋ ∈ [2, log X]`, exponent `1/A`
  obtain ⟨hX₀, hlogP⟩ := h0b D hN0
  have hX16 : 2 ^ 16 ≤ X := hX₀.trans hX1
  have h2δ : (2 : ℝ) ≤ 1 / D.δ := by
    rw [le_div_iff₀ D.hδ]; show 2 * δ ≤ 1; linarith
  have hQ2 : 2 ≤ D.Q C₂ := by
    refine Nat.le_floor ?_
    calc ((2 : ℕ) : ℝ) = 2 := by norm_num
      _ ≤ 1 / D.δ := h2δ
      _ = (1 / D.δ) ^ 1 := (pow_one _).symm
      _ ≤ (1 / D.δ) ^ C₂ := pow_le_pow_right₀ (by linarith) (by omega)
  have hP₁pos : 0 < D.P₁ := by show 0 < lo (Fin.last k); omega
  have hQlog : ((D.Q C₂ : ℕ) : ℝ) ≤ Real.log X :=
    calc ((D.Q C₂ : ℕ) : ℝ) ≤ (1 / D.δ) ^ C₂ := Nat.floor_le (by positivity)
      _ ≤ Real.log D.P₁ := hlogP
      _ ≤ Real.log X := Real.log_le_log (by exact_mod_cast hP₁pos) (by exact_mod_cast hX1)
  obtain ⟨Λper, n, g, h, M, F, hper, hl1, h417, hsup, hdecomp, hh, hg, hM0, hMsum, hF, hF0,
    hminor⟩ := hK X hX16 (D.Q C₂) hQ2 hQlog
  -- P3: (5.7)
  have hP3 := h3 D hδ3 hN3 f₁ hf₁ X hX1 hX2 (Λt X) (hΛnn X) (hΛpr X hX16) (hΛsum X hX16) hXsum
  have hc'eq : c₂ * D.δ ^ 2 / 64 = c' * D.δ ^ 2 := by rw [hc'def]; ring
  rw [hc'eq] at hP3
  -- P4: `Λ̃ = (Λ̃ - Λ_per) + Λ_per`, so (5.9) or (5.10); P5 excludes (5.9)
  have hsplit : favg (win X) (fun x => Λt X x * Phi D f₁ x) =
      favg (win X) (fun x => (Λt X x - Λper x) * Phi D f₁ x) +
        favg (win X) (fun x => Λper x * Phi D f₁ x) := by
    rw [← favg_add']; congr 1; funext x; ring
  have hP5 := h5 D hδ5 hN5 f₁ hf₁ X hX1 hX2 (Λt X) Λper n g h M F (hΛnn X) (hΛsum X hX16) hl1
    hdecomp hh hg hM0 hMsum hF hF0 hminor
  have hP6in : c' * D.δ ^ 2 / 2 ≤ favg (win X) (fun x => Λper x * Phi D f₁ x) := by
    have := (abs_lt.mp hP5).2
    linarith
  -- P6: (5.10) gives the conclusion
  have hP6 := h6 D hδ6 hN6 f₁ hf₁ X hX1 hX2 Λper ⟨hper, hl1, h417, hsup⟩ hP6in H hH hH8
  rw [one_mul]
  exact hP6

/-- The pipeline at the level of leaves: the two shared helpers, the leaf steps (as implications
from the helpers they use) and the three glue implications give `Prop51`. Every hypothesis is a
separate, independently provable task; all external tools are proved lemmas. -/
theorem prop51_of_leaves (hProd : StepProdAvg) (hBoxes : StepBoxes)
    (h0a : StepProdAvg → StepP0a) (h0b : StepP0b) (h1 : StepP1) (h2 : StepP2)
    (h3 : StepProdAvg → StepP3)
    (h5a : StepBoxes → StepP5a) (h5b : StepP5b) (h5c : StepP5c) (h5d : StepP5d)
    (h6a : StepP6a) (h6b : StepProdAvg → StepP6b) (h6c : StepP6c) (h6d : StepP6d)
    (h6e : StepBoxes → StepP6e) (h6f : StepP6f) (h6g : StepP6g) (h7 : StepP7)
    (g5e : GlueP5e) (g5 : GlueP5) (g6 : GlueP6) : Prop51 :=
  prop51_of_steps (h0a hProd) h0b h1 h2 (h3 hProd)
    (g5 (h5a hBoxes) h5b (g5e h5c h5d))
    (g6 h6a (h6b hProd) h6c h6d (h6e hBoxes) h6f h6g h7)

end Assembly

end G22.P51

end

/- ## Section: `P51ProdAvg` -/

section

/-
# The product identity `StepProdAvg` and step P0a of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. Statements in `Prop51Steps.lean`.

Helper lemmas live in `G22.P51.ProdAvg` (to avoid name clashes with other step files):

* `ProdAvg.iterAvg_eq_div`: closed form of the iterated logarithmic average, without hypotheses
  (an empty set gives `0 = 0`, `k = 0` gives `G Fin.elim0`):
  `iterAvg k S G = (∑_{a ∈ ∏ S ℓ} (∏_ℓ 1/a_ℓ) G a) / ∏_ℓ ∑_{p ∈ S ℓ} 1/p`;
* `ProdAvg.iterAvg_split_last` (split off the last coordinate) and `ProdAvg.iterAvg_lavg_comm`
  (Fubini).

Main results:

* `stepProdAvg : StepProdAvg`: from the closed form, the injectivity of the product map
  (`FPDQ.lemmaC_injOn`) and `Finset.prod_univ_sum`;
* `stepP0a : StepP0a`: split off the prime `p ∈ 𝒫` (last coordinate), Fubini, `stepProdAvg`.
-/

open Finset

namespace G22.P51

namespace ProdAvg

/-- Sums over `piFinset` of a `Fin (k + 1)`-indexed family: split off the coordinate `0`. -/
lemma sum_piFinset_succ {k : ℕ} (S : Fin (k + 1) → Finset ℕ) (h : (Fin (k + 1) → ℕ) → ℝ) :
    ∑ a ∈ Fintype.piFinset S, h a =
      ∑ p ∈ S 0, ∑ b ∈ Fintype.piFinset (fun i : Fin k => S i.succ), h (Fin.cons p b) := by
  rw [← Finset.sum_product' (f := fun p b => h (Fin.cons p b))]
  refine Finset.sum_nbij' (fun a => (a 0, Fin.tail a)) (fun x => Fin.cons x.1 x.2)
    ?_ ?_ ?_ ?_ ?_
  · intro a ha
    simp only [Fintype.mem_piFinset, Finset.mem_product] at ha ⊢
    exact ⟨ha 0, fun i => ha i.succ⟩
  · intro x hx
    simp only [Fintype.mem_piFinset, Finset.mem_product] at hx ⊢
    intro i
    cases i using Fin.cases with
    | zero => simpa using hx.1
    | succ j => simpa using hx.2 j
  · intro a _
    exact Fin.cons_self_tail a
  · intro x _
    simp
  · intro a _
    simp only [Fin.cons_self_tail]

/-- **Closed form of the iterated logarithmic average** (no hypotheses on `S`). -/
lemma iterAvg_eq_div (k : ℕ) (S : Fin k → Finset ℕ) (G : (Fin k → ℕ) → ℝ) :
    iterAvg k S G =
      (∑ a ∈ Fintype.piFinset S, (∏ ℓ, (1 / (a ℓ : ℝ))) * G a) /
        ∏ ℓ, ∑ p ∈ S ℓ, (1 / (p : ℝ)) := by
  induction k with
  | zero =>
    have h0 : Fintype.piFinset S = {Fin.elim0} := by
      ext a
      simp only [Fintype.mem_piFinset, IsEmpty.forall_iff, true_iff, Finset.mem_singleton]
      exact Subsingleton.elim _ _
    rw [h0, Finset.sum_singleton]
    simp only [iterAvg, Finset.univ_eq_empty, Finset.prod_empty, one_mul, div_one]
  | succ k ih =>
    have h1 : iterAvg (k + 1) S G =
        lavg (S 0) (fun p => iterAvg k (fun i => S i.succ) (fun q => G (Fin.cons p q))) := rfl
    rw [h1]
    simp_rw [ih]
    rw [sum_piFinset_succ]
    simp only [lavg, wavg, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]
    rw [mul_comm (∑ p ∈ S 0, (1 / (p : ℝ))) _, ← div_div]
    congr 1
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [← mul_div_assoc, Finset.mul_sum]
    simp only [mul_assoc]

/-- Splitting off the last coordinate of an iterated average. -/
lemma iterAvg_split_last (k : ℕ) (S : Fin (k + 1) → Finset ℕ) (F : (Fin (k + 1) → ℕ) → ℝ) :
    iterAvg (k + 1) S F =
      iterAvg k (fun i => S i.castSucc)
        (fun a => lavg (S (Fin.last k)) (fun p => F (Fin.snoc a p))) := by
  induction k with
  | zero =>
    show lavg (S 0) (fun p => F (Fin.cons p Fin.elim0)) =
      lavg (S (Fin.last 0)) (fun p => F (Fin.snoc Fin.elim0 p))
    rw [Fin.last_zero]
    congr 1
    funext p
    congr 1
    funext i
    fin_cases i
    rfl
  | succ k ih =>
    show lavg (S 0) (fun p => iterAvg (k + 1) (fun i => S i.succ) (fun q => F (Fin.cons p q))) =
      lavg (S 0) (fun p => iterAvg k (fun i => S i.succ.castSucc)
        (fun q => lavg (S (Fin.last (k + 1))) (fun r => F (Fin.snoc (Fin.cons p q) r))))
    congr 1
    funext p
    rw [ih]
    simp only [Fin.cons_snoc_eq_snoc_cons]
    rfl

/-- Fubini: an iterated average commutes with a logarithmic average. -/
lemma iterAvg_lavg_comm (k : ℕ) (S : Fin k → Finset ℕ) (T : Finset ℕ)
    (G : (Fin k → ℕ) → ℕ → ℝ) :
    iterAvg k S (fun a => lavg T (fun p => G a p)) =
      lavg T (fun p => iterAvg k S (fun a => G a p)) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    show lavg (S 0) (fun q => iterAvg k (fun i => S i.succ)
        (fun b => lavg T (fun p => G (Fin.cons q b) p))) =
      lavg T (fun p => lavg (S 0) (fun q => iterAvg k (fun i => S i.succ)
        (fun b => G (Fin.cons q b) p)))
    simp_rw [ih]
    exact Elem.wavg_comm _ _ _ _ _

end ProdAvg

/-- **Product identity** (`StepProdAvg`): for pairwise disjoint sets of primes,
`iterAvg k S (F ∘ ∏) = lavg (boxProd S) F`. No nonemptiness is needed. -/
theorem stepProdAvg : StepProdAvg := by
  intro k S hP hdisj F
  rw [ProdAvg.iterAvg_eq_div]
  have hinv : ∀ a : Fin k → ℕ, (1 / ((∏ ℓ, a ℓ : ℕ) : ℝ)) = ∏ ℓ, (1 / (a ℓ : ℝ)) := by
    intro a
    rw [Nat.cast_prod]
    simp only [one_div, Finset.prod_inv_distrib]
  unfold lavg wavg FPDQ.boxProd
  rw [Finset.sum_image (FPDQ.lemmaC_injOn hP hdisj),
    Finset.sum_image (FPDQ.lemmaC_injOn hP hdisj)]
  simp only [hinv]
  rw [Finset.prod_univ_sum]

/-- **P0a** (`StepP0a`): the average of `Prop51With` is
`E^log_{p∈𝒫} E^log_{p'∈𝒫'} origInner D f₁ f₂ p p'`. -/
theorem stepP0a : StepP0a := by
  intro D f₁ f₂
  -- the prime sets of the first `k` coordinates: primes, pairwise disjoint (`D.hdisj`)
  have hP : ∀ ℓ : Fin D.k, ∀ p ∈ primesIn (D.lo ℓ.castSucc) (D.hi ℓ.castSucc), p.Prime :=
    fun ℓ p hp => (Finset.mem_filter.mp hp).2
  have hd : ∀ ℓ ℓ' : Fin D.k, ℓ ≠ ℓ' →
      Disjoint (primesIn (D.lo ℓ.castSucc) (D.hi ℓ.castSucc))
        (primesIn (D.lo ℓ'.castSucc) (D.hi ℓ'.castSucc)) := by
    intro ℓ ℓ' hne
    rw [Finset.disjoint_left]
    intro p hp hp'
    simp only [primesIn, Finset.mem_filter, Finset.mem_Ico] at hp hp'
    rcases D.hdisj ℓ ℓ' hne with h | h <;> omega
  -- split off `p ∈ 𝒫` (the last coordinate) and move its average outside
  rw [ProdAvg.iterAvg_split_last, ProdAvg.iterAvg_lavg_comm]
  show lavg D.Pset _ = _
  congr 1
  funext p
  -- the average over the first `k` coordinates is the average over `𝒫'`
  refine Eq.trans ?_ (stepProdAvg D.k (fun ℓ => primesIn (D.lo ℓ.castSucc) (D.hi ℓ.castSucc))
    hP hd (fun p' => origInner D f₁ f₂ p p'))
  congr 1
  funext a
  unfold origInner
  have hprod : ∏ ℓ, ((Fin.snoc (α := fun _ => ℕ) a p ℓ : ℕ) : ℤ) =
      (p : ℤ) * ((∏ ℓ, a ℓ : ℕ) : ℤ) := by
    rw [Fin.prod_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, Nat.cast_prod]
    ring
  simp only [hprod]

end G22.P51

end

/- ## Section: `P51Boxes` -/

section

/-
# Steps `StepBoxes` and `StepP0b` of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. This file proves two of the step statements
of `Green22Lean/Prop51Steps.lean`:

* `stepBoxes : StepBoxes` (GS p. 17): `[A, B)` with `A ≥ 1000k²`, `B ≥ 2A` is cut into `m ≥ 1`
  consecutive pieces with integer endpoints and ratios in `[1 + 1/(8k), 1 + 1/(4k)]`.
  Construction: `L = log (B/A)`, `m = ⌈6kL⌉`, `t = L/m ∈ [2/(15k), 1/(6k)]`, `r = eᵗ` (so
  `rᵐ = B/A`) and `a i = ⌊A rⁱ⌋`. The rounding errors are `≤ 1` against `A rⁱ ≥ 1000k²`.
* `stepP0b : StepP0b` (GS §5.1, p. 15): `P₁` is large and `δ^{-C₂} ≤ log P₁`, from
  `1/δ ≤ log log N ≤ (log log P'₁)¹⁰` and `P'₁ < P₁`.
-/

open Real

namespace G22.P51

/- ## `StepBoxes` -/

/-- One step of the subdyadic partition: if `x ≥ 1000k²` and `r` is close to `eᵗ` with
`2/(15k) ≤ t ≤ 1/(6k)`, then `⌊x⌋` and `⌊xr⌋` have ratio in `[1 + 1/(8k), 1 + 1/(4k)]`. -/
lemma boxes_step_floor (k : ℕ) (hk : 1 ≤ k) (x r t : ℝ) (hx : 1000 * (k : ℝ) ^ 2 ≤ x)
    (ht1 : 2 ≤ 15 * (k : ℝ) * t) (ht2 : 6 * (k : ℝ) * t ≤ 1) (hr1 : 1 + t ≤ r)
    (hr2 : r ≤ 1 + t + t ^ 2) :
    (8 * k + 1) * ⌊x⌋₊ ≤ 8 * k * ⌊x * r⌋₊ ∧ 4 * k * ⌊x * r⌋₊ ≤ (4 * k + 1) * ⌊x⌋₊ := by
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hk0 : (0 : ℝ) ≤ k := by linarith
  have hx0 : 0 ≤ x := le_trans (by positivity) hx
  have hxk : 120 * (k : ℝ) + 5 ≤ x := by nlinarith
  have ht0 : 0 ≤ t := by
    by_contra h
    have h' : t < 0 := not_le.mp h
    nlinarith
  have hr0 : 0 ≤ r := by linarith
  have hxr0 : 0 ≤ x * r := mul_nonneg hx0 hr0
  have fl1 : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx0
  have fl2 : x - 1 < (⌊x⌋₊ : ℝ) := Nat.sub_one_lt_floor x
  have fl3 : (⌊x * r⌋₊ : ℝ) ≤ x * r := Nat.floor_le hxr0
  have fl4 : x * r - 1 < (⌊x * r⌋₊ : ℝ) := Nat.sub_one_lt_floor (x * r)
  constructor
  · -- `(8k+1)⌊x⌋ ≤ (8k+1)x ≤ 8k(xr - 1) ≤ 8k⌊xr⌋`
    have e1 : 8 * k * x * (1 + t) ≤ 8 * k * x * r :=
      mul_le_mul_of_nonneg_left hr1 (by positivity)
    have e2 : 8 * x * 2 ≤ 8 * x * (15 * k * t) :=
      mul_le_mul_of_nonneg_left ht1 (by positivity)
    have g1 : ((8 * k + 1 : ℕ) : ℝ) * ⌊x⌋₊ ≤ ((8 * k + 1 : ℕ) : ℝ) * x :=
      mul_le_mul_of_nonneg_left fl1 (by positivity)
    have g2 : ((8 * k : ℕ) : ℝ) * (x * r - 1) ≤ ((8 * k : ℕ) : ℝ) * ⌊x * r⌋₊ :=
      mul_le_mul_of_nonneg_left fl4.le (by positivity)
    have key : ((8 * k + 1 : ℕ) : ℝ) * ⌊x⌋₊ ≤ ((8 * k : ℕ) : ℝ) * ⌊x * r⌋₊ := by
      push_cast at g1 g2 ⊢
      nlinarith
    exact_mod_cast key
  · -- `4k⌊xr⌋ ≤ 4kxr ≤ (4k + 7/9)x ≤ (4k+1)(x - 1) ≤ (4k+1)⌊x⌋`
    have f1 : 4 * k * x * r ≤ 4 * k * x * (1 + t + t ^ 2) :=
      mul_le_mul_of_nonneg_left hr2 (by positivity)
    have f2 : 2 * x / 3 * (6 * k * t) ≤ 2 * x / 3 * 1 :=
      mul_le_mul_of_nonneg_left ht2 (by positivity)
    have ht6 : t ≤ 1 / 6 := by nlinarith
    have hkt : (k : ℝ) * t ≤ 1 / 6 := by linarith
    have hktt : (k : ℝ) * t * t ≤ 1 / 36 := by
      have := mul_le_mul hkt ht6 ht0 (by norm_num)
      linarith
    have f3 : 4 * x * ((k : ℝ) * t * t) ≤ 4 * x * (1 / 36) :=
      mul_le_mul_of_nonneg_left hktt (by positivity)
    have g1 : ((4 * k : ℕ) : ℝ) * ⌊x * r⌋₊ ≤ ((4 * k : ℕ) : ℝ) * (x * r) :=
      mul_le_mul_of_nonneg_left fl3 (by positivity)
    have g2 : ((4 * k + 1 : ℕ) : ℝ) * (x - 1) ≤ ((4 * k + 1 : ℕ) : ℝ) * ⌊x⌋₊ :=
      mul_le_mul_of_nonneg_left fl2.le (by positivity)
    have key : ((4 * k : ℕ) : ℝ) * ⌊x * r⌋₊ ≤ ((4 * k + 1 : ℕ) : ℝ) * ⌊x⌋₊ := by
      push_cast at g1 g2 ⊢
      nlinarith
    exact_mod_cast key

/-- The number of pieces: `m = ⌈6kL⌉` with `L = log (B/A) ≥ log 2` gives
`t = L/m ∈ [2/(15k), 1/(6k)]`. -/
lemma boxes_t_bounds (k : ℕ) (hk : 1 ≤ k) (L : ℝ) (hL : 2 / 3 < L) :
    let m := ⌈6 * (k : ℝ) * L⌉₊
    1 ≤ m ∧ 2 ≤ 15 * (k : ℝ) * (L / m) ∧ 6 * (k : ℝ) * (L / m) ≤ 1 := by
  intro m
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hL0 : 0 < L := by linarith
  have hkL : L ≤ k * L := by nlinarith
  have hm1 : 6 * (k : ℝ) * L ≤ m := Nat.le_ceil _
  have hm2 : (m : ℝ) < 6 * k * L + 1 := Nat.ceil_lt_add_one (by positivity)
  have hmpos : (0 : ℝ) < m := by nlinarith
  refine ⟨?_, ?_, ?_⟩
  · have : 0 < m := by exact_mod_cast hmpos
    omega
  · rw [← mul_div_assoc, le_div_iff₀ hmpos]
    nlinarith
  · rw [← mul_div_assoc, div_le_one hmpos]
    exact hm1

/-- **StepBoxes** (GS p. 17): the subdyadic partition of `[A, B)` with integer endpoints. -/
theorem stepBoxes : StepBoxes := by
  intro k A B hk hA hB
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hA1 : (1000 : ℝ) * (k : ℝ) ^ 2 ≤ A := by exact_mod_cast hA
  have hApos : (0 : ℝ) < A := by nlinarith
  have hB2 : (2 : ℝ) * A ≤ B := by exact_mod_cast hB
  have hBpos : (0 : ℝ) < B := by linarith
  have hBA : (0 : ℝ) < (B : ℝ) / A := div_pos hBpos hApos
  -- `L = log (B/A) ≥ log 2 > 2/3`
  set L := Real.log ((B : ℝ) / A) with hLdef
  have hL2 : Real.log 2 ≤ L :=
    Real.log_le_log (by norm_num) (by rw [le_div_iff₀ hApos]; linarith)
  have hL : (2 : ℝ) / 3 < L := by
    have := Real.log_two_gt_d9
    norm_num at this
    linarith
  obtain ⟨hm1, ht1, ht2⟩ := boxes_t_bounds k hk L hL
  set m := ⌈6 * (k : ℝ) * L⌉₊ with hmdef
  have hmpos : (0 : ℝ) < m := by exact_mod_cast hm1
  set t := L / m with htdef
  have ht0 : 0 ≤ t := div_nonneg (by linarith) hmpos.le
  have ht6 : t ≤ 1 := by nlinarith
  -- `r = eᵗ`, `1 + t ≤ r ≤ 1 + t + t²`, `rᵐ = B/A`
  set r := Real.exp t with hrdef
  have hr1 : 1 + t ≤ r := by linarith [Real.add_one_le_exp t]
  have hr2 : r ≤ 1 + t + t ^ 2 := by
    have h := Real.abs_exp_sub_one_sub_id_le (x := t) (by rw [abs_of_nonneg ht0]; exact ht6)
    linarith [le_abs_self (Real.exp t - 1 - t)]
  have hrone : 1 ≤ r := by linarith
  have hrm : r ^ m = (B : ℝ) / A := by
    rw [hrdef, ← Real.exp_nat_mul, htdef, mul_div_cancel₀ _ hmpos.ne', hLdef, Real.exp_log hBA]
  refine ⟨m, fun i => ⌊(A : ℝ) * r ^ i⌋₊, hm1, ?_, ?_, ?_⟩
  · simp
  · show ⌊(A : ℝ) * r ^ m⌋₊ = B
    rw [hrm, mul_div_cancel₀ _ hApos.ne', Nat.floor_natCast]
  · intro i _
    have hx : 1000 * (k : ℝ) ^ 2 ≤ (A : ℝ) * r ^ i := by
      have : (1 : ℝ) ≤ r ^ i := one_le_pow₀ hrone
      nlinarith
    have h := boxes_step_floor k hk ((A : ℝ) * r ^ i) r t hx ht1 ht2 hr1 hr2
    have hpow : (A : ℝ) * r ^ (i + 1) = (A : ℝ) * r ^ i * r := by rw [pow_succ, mul_assoc]
    simp only [hpow]
    exact h

/- ## `StepP0b` -/

/-- `xⁿ ≤ eˣ` once `x ≥ (n+1)!`. -/
lemma pow_le_exp_of_factorial_le (n : ℕ) {x : ℝ} (hx : ((n + 1).factorial : ℝ) ≤ x) :
    x ^ n ≤ Real.exp x := by
  have hfac : (0 : ℝ) < ((n + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have hx0 : 0 ≤ x := le_trans hfac.le hx
  have h := Real.pow_div_factorial_le_exp x hx0 (n + 1)
  have h1 : 1 ≤ x / ((n + 1).factorial : ℝ) := by rw [le_div_iff₀ hfac]; linarith
  calc x ^ n = x ^ n * 1 := by ring
    _ ≤ x ^ n * (x / ((n + 1).factorial : ℝ)) :=
        mul_le_mul_of_nonneg_left h1 (pow_nonneg hx0 n)
    _ = x ^ (n + 1) / ((n + 1).factorial : ℝ) := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h

/-- `1 < log n` for `n ≥ 3`. -/
lemma one_lt_log_of_three_le {n : ℕ} (hn : 3 ≤ n) : 1 < Real.log n := by
  have h3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [Real.lt_log_iff_exp_lt (by linarith)]
  have := Real.exp_one_lt_d9
  norm_num at this
  linarith

/-- **StepP0b** (GS §5.1, p. 15): `P₁ ≥ X₀` and `δ^{-C₂} ≤ log P₁` for `N` large. -/
theorem stepP0b : StepP0b := by
  intro X₀ C₂
  set U : ℝ := max (X₀ : ℝ) ((10 * C₂ + 1).factorial : ℝ) with hU
  refine ⟨⌈Real.exp (Real.exp (U ^ 10))⌉₊, fun D hN => ?_⟩
  have hP₁'P₁ : D.P₁' < D.P₁ := lt_trans D.hP₁'P₂' D.hP₂'P₁
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have : 0 < D.P₁' := by have := D.hP₁'; omega
    exact_mod_cast this
  have hlogP₁' : 1 < Real.log D.P₁' := one_lt_log_of_three_le D.hP₁'
  have hu0 : 0 < Real.log (Real.log D.P₁') := Real.log_pos hlogP₁'
  -- `log log N ≥ U¹⁰`
  have hNr : Real.exp (Real.exp (U ^ 10)) ≤ D.N :=
    le_trans (Nat.le_ceil _) (by exact_mod_cast hN)
  have ht : U ^ 10 ≤ Real.log (Real.log D.N) := by
    have h1 : Real.exp (U ^ 10) ≤ Real.log D.N := by
      rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) hNr)]; exact hNr
    rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) h1)]; exact h1
  -- hence `u = log log P'₁ ≥ U`
  have hU0 : 0 ≤ U := le_trans (Nat.cast_nonneg _) (le_max_left _ _)
  have huU : U ≤ Real.log (Real.log D.P₁') :=
    (pow_le_pow_iff_left₀ hU0 hu0.le (by norm_num)).mp (le_trans ht D.hP₁'N)
  have hX₀u : (X₀ : ℝ) ≤ Real.log (Real.log D.P₁') := le_trans (le_max_left _ _) huU
  have hfacu : ((10 * C₂ + 1).factorial : ℝ) ≤ Real.log (Real.log D.P₁') :=
    le_trans (le_max_right _ _) huU
  have hexpu : Real.exp (Real.log (Real.log D.P₁')) = Real.log D.P₁' :=
    Real.exp_log (by linarith)
  constructor
  · -- `X₀ ≤ u < u + 2 ≤ log P'₁ + 1 ≤ P'₁ < P₁`
    have h1 : Real.log (Real.log D.P₁') + 1 ≤ Real.log D.P₁' := by
      have := Real.add_one_le_exp (Real.log (Real.log D.P₁'))
      rwa [hexpu] at this
    have h2 : Real.log D.P₁' + 1 ≤ D.P₁' := by
      have := Real.add_one_le_exp (Real.log D.P₁')
      rwa [Real.exp_log hP₁'pos] at this
    have h3 : (X₀ : ℝ) < D.P₁' := by linarith
    have h4 : X₀ < D.P₁' := by exact_mod_cast h3
    omega
  · -- `δ^{-C₂} ≤ (log log N)^{C₂} ≤ u^{10C₂} ≤ eᵘ = log P'₁ ≤ log P₁`
    have hδ' : 0 ≤ 1 / D.δ := le_of_lt (one_div_pos.mpr D.hδ)
    have ht0 : 0 ≤ Real.log (Real.log D.N) := le_trans hδ' D.hδN
    calc (1 / D.δ) ^ C₂ ≤ (Real.log (Real.log D.N)) ^ C₂ := pow_le_pow_left₀ hδ' D.hδN C₂
      _ ≤ (Real.log (Real.log D.P₁') ^ 10) ^ C₂ := pow_le_pow_left₀ ht0 D.hP₁'N C₂
      _ = Real.log (Real.log D.P₁') ^ (10 * C₂) := by rw [← pow_mul]
      _ ≤ Real.exp (Real.log (Real.log D.P₁')) := pow_le_exp_of_factorial_le (10 * C₂) hfacu
      _ = Real.log D.P₁' := hexpu
      _ ≤ Real.log D.P₁ :=
          Real.log_le_log hP₁'pos (by exact_mod_cast hP₁'P₁.le)

end G22.P51

end

/- ## Section: `P51P1P2` -/

section

/-
# Steps P1 and P2 of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, §5.2 (pp. 16–17).

* `stepP1 : StepP1` (removal of `f₂`, GS p. 16). For each `(p, p')`, GS Lemma A.4
  (`Small.lemmaA4`, with `q = p'`) turns `origInner D f₁ f₂ p p'` into
  `E^log_m f₂(λpm) p' 1_{p'∣m} f₁(m/p' + λpp')` up to `(1 + log p')/log N`; averaging over
  `p' ∈ 𝒫'` (Fubini) gives `g̃(p) = E^log_m f₂(λpm) A_p(m)` up to `err = (1 + log P'₂)/log N`
  (`P1P2.avg_close`). Cauchy–Schwarz over `m` (with `f₂² ≤ 1`) and Jensen over `p` give
  `(E^log_p g̃(p))² ≤ E^log_p E^log_m A_p(m)²`. For `N ≥ exp(2^20)` the error is `≤ δ/4`
  (`P1P2.err_small`, from `(log P₂)⁴ < log N` and `1/δ ≤ log log N`), so the left side is
  `≥ (3δ/4)² ≥ δ²/2`. Threshold: `N₀ = ⌈exp(2^20)⌉`.
* `stepP2 : StepP2` (dyadic interval, Chebyshev), with `c₂ = 1/4000`: from `FPDQ.lemmaM54A`
  (which needs `P₁ ≥ 2^24`, `P1P2.P_large`, and `P₂ ≥ 4P₁`); `X = 2^i` if `P₁ ≤ 2^i`, and
  `X = P₁` otherwise (or if `α ≤ 0`). Threshold: `N₀ = ⌈exp exp(24^10 + 1)⌉`.
-/

open Finset Real

namespace G22.P51

/- The auxiliary lemmas live in the sub-namespace `G22.P51.P1P2` (to avoid clashes with the
other step files in `G22.P51`); only `stepP1` and `stepP2` are in `G22.P51`. -/

namespace P1P2

/- ## Elementary facts about the data -/

/-- Elements of `𝒫 = D.Pset`: primes in `[P₁, P₂)`. -/
lemma mem_Pset {D : Data} {p : ℕ} (hp : p ∈ D.Pset) : p.Prime ∧ D.P₁ ≤ p ∧ p < D.P₂ := by
  unfold Data.Pset primesIn at hp
  rw [Finset.mem_filter, Finset.mem_Ico] at hp
  exact ⟨hp.2, hp.1.1, hp.1.2⟩

/-- Elements of `𝒫' = D.Pp` satisfy `1 ≤ p' ≤ P'₂` (by `∏ hi ℓ ≤ P'₂`). -/
lemma mem_Pp {D : Data} {q : ℕ} (hq : q ∈ D.Pp) : 1 ≤ q ∧ q ≤ D.P₂' := by
  unfold Data.Pp almostPrimes FPDQ.boxProd at hq
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hq
  rw [Fintype.mem_piFinset] at hf
  have hmem : ∀ ℓ, (f ℓ).Prime ∧ f ℓ < D.hi ℓ.castSucc := fun ℓ => by
    have h := hf ℓ
    unfold primesIn at h
    rw [Finset.mem_filter, Finset.mem_Ico] at h
    exact ⟨h.2, h.1.2⟩
  refine ⟨Nat.one_le_iff_ne_zero.mpr ?_, ?_⟩
  · rw [Finset.prod_ne_zero_iff]
    exact fun ℓ _ => (hmem ℓ).1.ne_zero
  · calc ∏ ℓ, f ℓ ≤ ∏ ℓ : Fin D.k, D.hi ℓ.castSucc :=
          Finset.prod_le_prod (fun _ _ => Nat.zero_le _) (fun ℓ _ => (hmem ℓ).2.le)
      _ ≤ D.P₂' := D.hprod

lemma gw_Pset {D : Data} (hne : D.Pset.Nonempty) :
    GoodWeights D.Pset (fun p : ℕ => 1 / (p : ℝ)) :=
  goodWeights_lavg hne fun _ hp => (mem_Pset hp).1.pos

lemma gw_Pp {D : Data} (hne : D.Pp.Nonempty) :
    GoodWeights D.Pp (fun p : ℕ => 1 / (p : ℝ)) :=
  goodWeights_lavg hne fun _ hq => by have := (mem_Pp hq).1; omega

/- ## The size conditions for `N ≥ N₀` -/

/-- `4(1 + v) log u ≤ u` for `u ≥ 2^20`, `v ≥ 0`, `v⁴ < u`
(via `(1+v)⁴ ≤ 8(1 + v⁴) ≤ 16u` and `(log u)⁴ ≤ 16u²`). -/
lemma four_mul_log_le {u v : ℝ} (hu : 2 ^ 20 ≤ u) (hv : 0 ≤ v) (hvu : v ^ 4 < u) :
    4 * (1 + v) * Real.log u ≤ u := by
  have hu0 : 0 < u := lt_of_lt_of_le (by norm_num) hu
  have hu1 : 1 ≤ u := le_trans (by norm_num) hu
  have hL0 : 0 ≤ Real.log u := Real.log_nonneg hu1
  have hs2 : Real.sqrt u ^ 2 = u := Real.sq_sqrt hu0.le
  have hLs : Real.log u ≤ 2 * Real.sqrt u := by
    have h1 := Real.log_le_sub_one_of_pos (Real.sqrt_pos.mpr hu0)
    rw [Real.log_sqrt hu0.le] at h1
    linarith
  have hL2 : Real.log u ^ 2 ≤ 4 * u :=
    calc Real.log u ^ 2 ≤ (2 * Real.sqrt u) ^ 2 := pow_le_pow_left₀ hL0 hLs 2
      _ = 4 * u := by rw [mul_pow, hs2]; ring
  have hL4 : Real.log u ^ 4 ≤ 16 * u ^ 2 :=
    calc Real.log u ^ 4 = (Real.log u ^ 2) ^ 2 := by ring
      _ ≤ (4 * u) ^ 2 := pow_le_pow_left₀ (sq_nonneg _) hL2 2
      _ = 16 * u ^ 2 := by ring
  have hv4 : (1 + v) ^ 4 ≤ 16 * u := by
    have h8 : (1 + v) ^ 4 ≤ 8 * (1 + v ^ 4) := by
      nlinarith [mul_nonneg (sq_nonneg (v - 1)) (show 0 ≤ 7 * v ^ 2 + 10 * v + 7 by positivity)]
    linarith
  refine le_of_pow_le_pow_left₀ (n := 4) (by norm_num) hu0.le ?_
  calc (4 * (1 + v) * Real.log u) ^ 4 = 256 * (1 + v) ^ 4 * Real.log u ^ 4 := by ring
    _ ≤ 256 * (16 * u) * (16 * u ^ 2) := by gcongr
    _ = 65536 * u ^ 3 := by ring
    _ ≤ u * u ^ 3 := mul_le_mul_of_nonneg_right (le_trans (by norm_num) hu) (by positivity)
    _ = u ^ 4 := by ring

/-- For `N ≥ exp(2^20)`: `N ≥ 2` and the error of the A.4 step is `(1 + log P'₂)/log N ≤ δ/4`. -/
lemma err_small : ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    2 ≤ D.N ∧ (1 + Real.log D.P₂') / Real.log D.N ≤ D.δ / 4 := by
  refine ⟨⌈Real.exp (2 ^ 20)⌉₊, fun D hN => ?_⟩
  have hNR : Real.exp (2 ^ 20) ≤ (D.N : ℝ) :=
    (Nat.le_ceil _).trans (by exact_mod_cast hN)
  have hN0 : (0 : ℝ) < D.N := lt_of_lt_of_le (Real.exp_pos _) hNR
  have hu : (2 : ℝ) ^ 20 ≤ Real.log D.N := (Real.le_log_iff_exp_le hN0).mpr hNR
  have hN2 : 2 ≤ D.N := by
    have h1 : (2 : ℝ) ^ 20 + 1 ≤ D.N := (Real.add_one_le_exp _).trans hNR
    have h2 : (2 : ℝ) ≤ D.N := le_trans (by norm_num) h1
    exact_mod_cast h2
  refine ⟨hN2, ?_⟩
  have hP₂'1 : (1 : ℝ) ≤ D.P₂' := by
    have := D.hP₁'; have := D.hP₁'P₂'
    exact_mod_cast (show 1 ≤ D.P₂' by omega)
  have hv : 0 ≤ Real.log D.P₂' := Real.log_nonneg hP₂'1
  have hvP : Real.log D.P₂' ≤ Real.log (D.hi (Fin.last D.k)) := by
    apply Real.log_le_log (by linarith)
    have h1 := D.hP₂'P₁; have h2 := D.hP₁P₂
    exact_mod_cast (show D.P₂' ≤ D.hi (Fin.last D.k) by omega)
  have hvu : Real.log D.P₂' ^ 4 < Real.log D.N :=
    lt_of_le_of_lt (pow_le_pow_left₀ hv hvP 4) D.hP₂N
  have key := four_mul_log_le hu hv hvu
  have hu0 : 0 < Real.log D.N := lt_of_lt_of_le (by norm_num) hu
  have hδ1 : 1 ≤ Real.log (Real.log D.N) * D.δ := (div_le_iff₀ D.hδ).mp D.hδN
  rw [div_le_div_iff₀ hu0 (by norm_num : (0 : ℝ) < 4)]
  have h1 := mul_le_mul_of_nonneg_left key D.hδ.le
  have h2 := mul_le_mul_of_nonneg_left hδ1 (show 0 ≤ 4 * (1 + Real.log D.P₂') by positivity)
  nlinarith

/-- For `N ≥ exp exp(24^10 + 1)`: `P₁ ≥ 2^24` (since `P₁ > P'₁` and
`log log N ≤ (log log P'₁)^10`). -/
lemma P_large : ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N → 2 ^ 24 ≤ D.P₁ := by
  refine ⟨⌈Real.exp (Real.exp (24 ^ 10 + 1))⌉₊, fun D hN => ?_⟩
  have hNR : Real.exp (Real.exp (24 ^ 10 + 1)) ≤ (D.N : ℝ) :=
    (Nat.le_ceil _).trans (by exact_mod_cast hN)
  have hN0 : (0 : ℝ) < D.N := lt_of_lt_of_le (Real.exp_pos _) hNR
  have hu : Real.exp (24 ^ 10 + 1) ≤ Real.log D.N := (Real.le_log_iff_exp_le hN0).mpr hNR
  have hu0 : 0 < Real.log D.N := lt_of_lt_of_le (Real.exp_pos _) hu
  have hw : (24 : ℝ) ^ 10 + 1 ≤ Real.log (Real.log D.N) := (Real.le_log_iff_exp_le hu0).mpr hu
  have h1 := D.hP₁'N
  by_contra hlt
  push Not at hlt
  have hP₂'P₁ : D.P₂' < D.P₁ := D.hP₂'P₁
  have hP₁'P₂' := D.hP₁'P₂'
  have hP₁'lt : D.P₁' < 2 ^ 24 := by omega
  have hP₁'3 : (3 : ℝ) ≤ D.P₁' := by exact_mod_cast D.hP₁'
  have hlogP : Real.log D.P₁' < 24 := by
    have h2 : (D.P₁' : ℝ) < (2 : ℝ) ^ 24 := by exact_mod_cast hP₁'lt
    have h3 : Real.log D.P₁' < Real.log ((2 : ℝ) ^ 24) := Real.log_lt_log (by linarith) h2
    rw [Real.log_pow] at h3
    have := Real.log_two_lt_d9
    push_cast at h3
    linarith
  have hll0 : 0 < Real.log (Real.log D.P₁') := G22.Small.loglog_pos D.hP₁'
  have hlogP0 : 0 < Real.log D.P₁' := Real.log_pos (by linarith)
  have hll : Real.log (Real.log D.P₁') < 24 := by
    have := Real.log_le_sub_one_of_pos hlogP0
    linarith
  have : Real.log (Real.log D.P₁') ^ 10 < 24 ^ 10 := pow_lt_pow_left₀ hll hll0.le (by norm_num)
  linarith

/- ## Step P1 -/

/-- The dilated summand `p' 1_{p'∣m} f₁(m/p' + λxp')` (so `Aval D f₁ x m` is its `E^log_{p'}`). -/
noncomputable def dilTerm (D : Data) (f₁ : ℤ → ℝ) (x : ℤ) (p' : ℕ) (m : ℤ) : ℝ :=
  (p' : ℝ) * (if (p' : ℤ) ∣ m then f₁ (m / p' + (D.lam : ℤ) * x * p') else 0)

/-- `g̃(p) = E^log_{m∈[N]} f₂(λpm) A_p(m)`. -/
noncomputable def gTilde (D : Data) (f₁ f₂ : ℤ → ℝ) (p : ℕ) : ℝ :=
  logAvg D.N (fun m => f₂ ((D.lam : ℤ) * p * m) * Aval D f₁ p m)

/-- GS Lemma A.4 for one pair `(p, p')`. -/
lemma origInner_sub_dil (D : Data) (f₁ f₂ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1)
    (hf₂ : ∀ n, |f₂ n| ≤ 1) (hN : 2 ≤ D.N) (p p' : ℕ) (hp' : 1 ≤ p') :
    |origInner D f₁ f₂ p p' -
        logAvg D.N (fun m => f₂ ((D.lam : ℤ) * p * m) * dilTerm D f₁ p p' m)| ≤
      (1 + Real.log p') / Real.log D.N := by
  have h := G22.Small.lemmaA4 hN hp'
    (fun n => f₁ (n + (D.lam : ℤ) * ((p : ℤ) * p')) * f₂ ((D.lam : ℤ) * n * ((p : ℤ) * p')))
    (fun n => by
      rw [abs_mul]
      exact mul_le_one₀ (hf₁ _) (abs_nonneg _) (hf₂ _))
  have e : logAvg D.N (fun m => if (p' : ℤ) ∣ m then (p' : ℝ) *
        (f₁ (m / p' + (D.lam : ℤ) * ((p : ℤ) * p')) * f₂ ((D.lam : ℤ) * (m / p') * ((p : ℤ) * p')))
        else 0) =
      logAvg D.N (fun m => f₂ ((D.lam : ℤ) * p * m) * dilTerm D f₁ p p' m) := by
    unfold logAvg
    refine wavg_congr fun n _ => ?_
    dsimp only
    unfold dilTerm
    split_ifs with hd
    · have e1 : (D.lam : ℤ) * ((n : ℤ) / (p' : ℤ)) * ((p : ℤ) * p') = (D.lam : ℤ) * p * n := by
        calc (D.lam : ℤ) * ((n : ℤ) / (p' : ℤ)) * ((p : ℤ) * p')
            = (D.lam : ℤ) * p * ((n : ℤ) / p' * p') := by ring
          _ = (D.lam : ℤ) * p * n := by rw [Int.ediv_mul_cancel hd]
      have e2 : (D.lam : ℤ) * ((p : ℤ) * p') = (D.lam : ℤ) * (p : ℤ) * p' := by ring
      rw [e1, e2]; ring
    · simp
  unfold origInner
  rw [← e]
  exact h

/-- Averaging A.4 over `p' ∈ 𝒫'` (log weights): `|E^log_{p'} origInner(p, p') - g̃(p)| ≤ err`. -/
lemma avg_close (D : Data) (f₁ f₂ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (hf₂ : ∀ n, |f₂ n| ≤ 1)
    (hN : 2 ≤ D.N) (hne : D.Pp.Nonempty) (p : ℕ) :
    |lavg D.Pp (fun p' => origInner D f₁ f₂ p p') - gTilde D f₁ f₂ p| ≤
      (1 + Real.log D.P₂') / Real.log D.N := by
  have hB : gTilde D f₁ f₂ p =
      lavg D.Pp (fun p' => logAvg D.N (fun m => f₂ ((D.lam : ℤ) * p * m) * dilTerm D f₁ p p' m)) := by
    have step1 : gTilde D f₁ f₂ p =
        wavg (Icc 1 D.N) (fun n : ℕ => 1 / (n : ℝ)) (fun n => wavg D.Pp (fun p' : ℕ => 1 / (p' : ℝ))
          (fun p' => f₂ ((D.lam : ℤ) * p * n) * dilTerm D f₁ p p' n)) := by
      unfold gTilde logAvg
      refine wavg_congr fun n _ => ?_
      exact (wavg_smul _ _).symm
    rw [step1, G22.Elem.wavg_comm]
    rfl
  rw [hB]
  refine G22.Elem.abs_wavg_sub_le (gw_Pp hne) fun p' hp' => ?_
  have hp'1 := (mem_Pp hp').1
  have hp'2 := (mem_Pp hp').2
  refine (origInner_sub_dil D f₁ f₂ hf₁ hf₂ hN p p' hp'1).trans ?_
  have hlogN : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
  apply div_le_div_of_nonneg_right _ hlogN.le
  have : Real.log p' ≤ Real.log D.P₂' :=
    Real.log_le_log (by exact_mod_cast (show 0 < p' by omega)) (by exact_mod_cast hp'2)
  linarith

/-- Cauchy–Schwarz over `m` (with `f₂² ≤ 1`): `g̃(p)² ≤ E^log_m A_p(m)²`. -/
lemma gTilde_sq_le (D : Data) (f₁ f₂ : ℤ → ℝ) (hf₂ : ∀ n, |f₂ n| ≤ 1) (hN : 1 ≤ D.N) (p : ℕ) :
    gTilde D f₁ f₂ p ^ 2 ≤ logAvg D.N (fun n => Aval D f₁ p n ^ 2) := by
  have gwN := goodWeights_logAvg hN
  have h := wavg_mul_sq_le gwN (fun n : ℕ => f₂ ((D.lam : ℤ) * p * n))
    (fun n : ℕ => Aval D f₁ p n)
  have hf2 : wavg (Icc 1 D.N) (fun n : ℕ => 1 / (n : ℝ))
      (fun n : ℕ => f₂ ((D.lam : ℤ) * p * n) ^ 2) ≤ 1 :=
    wavg_le_of_le gwN fun n _ => (sq_le_one_iff_abs_le_one _).mpr (hf₂ _)
  have hA : 0 ≤ wavg (Icc 1 D.N) (fun n : ℕ => 1 / (n : ℝ)) (fun n : ℕ => Aval D f₁ p n ^ 2) :=
    wavg_nonneg gwN fun n _ => sq_nonneg _
  calc gTilde D f₁ f₂ p ^ 2
      = (wavg (Icc 1 D.N) (fun n : ℕ => 1 / (n : ℝ))
          (fun n : ℕ => f₂ ((D.lam : ℤ) * p * n) * Aval D f₁ p n)) ^ 2 := rfl
    _ ≤ _ := h
    _ ≤ 1 * wavg (Icc 1 D.N) (fun n : ℕ => 1 / (n : ℝ)) (fun n : ℕ => Aval D f₁ p n ^ 2) :=
        mul_le_mul_of_nonneg_right hf2 hA
    _ = logAvg D.N (fun n => Aval D f₁ p n ^ 2) := by rw [one_mul]; rfl

end P1P2

open P1P2

/-- **Step P1** (GS p. 16, removal of `f₂`). -/
theorem stepP1 : StepP1 := by
  obtain ⟨N₀, hN₀⟩ := err_small
  refine ⟨N₀, fun D hN f₁ f₂ hf₁ hf₂ hδ => ?_⟩
  obtain ⟨hN2, herr⟩ := hN₀ D hN
  have hδ0 := D.hδ
  -- the empty cases contradict `δ > 0`
  have hPset : D.Pset.Nonempty := by
    by_contra h
    rw [Finset.not_nonempty_iff_eq_empty] at h
    have h0 : lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p')) = 0 := by
      rw [h]; simp [lavg, wavg]
    rw [h0, abs_zero] at hδ
    linarith
  have hPp : D.Pp.Nonempty := by
    by_contra h
    rw [Finset.not_nonempty_iff_eq_empty] at h
    have h0 : lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p')) = 0 := by
      rw [h]; simp [lavg, wavg]
    rw [h0, abs_zero] at hδ
    linarith
  have gwP := gw_Pset hPset
  -- replace `E^log_{p'} origInner` by `g̃`
  have hclose : |lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p')) -
      lavg D.Pset (gTilde D f₁ f₂)| ≤ (1 + Real.log D.P₂') / Real.log D.N :=
    G22.Elem.abs_wavg_sub_le gwP fun p _ => avg_close D f₁ f₂ hf₁ hf₂ hN2 hPp p
  have h1 : 3 * D.δ / 4 ≤ |lavg D.Pset (gTilde D f₁ f₂)| := by
    have := abs_sub_abs_le_abs_sub
      (lavg D.Pset (fun p => lavg D.Pp (fun p' => origInner D f₁ f₂ p p')))
      (lavg D.Pset (gTilde D f₁ f₂))
    linarith
  -- Jensen over `p` and Cauchy–Schwarz over `m`
  have h2 : (lavg D.Pset (gTilde D f₁ f₂)) ^ 2 ≤
      lavg D.Pset (fun p => logAvg D.N (fun n => Aval D f₁ p n ^ 2)) :=
    (G22.Elem.wavg_sq_le gwP _).trans
      (wavg_mono gwP fun p _ => gTilde_sq_le D f₁ f₂ hf₂ (by omega) p)
  have h3 : (3 * D.δ / 4) ^ 2 ≤ (lavg D.Pset (gTilde D f₁ f₂)) ^ 2 := by
    rw [← sq_abs (lavg D.Pset (gTilde D f₁ f₂))]
    exact pow_le_pow_left₀ (by positivity) h1 2
  nlinarith [sq_nonneg D.δ]

/- ## Step P2 -/

namespace P1P2

/-- The numerical inequality of P2: if `X ≤ 2^{i+1}`, `log X ≥ i log 2` and `i ≥ 3`, then
`(1/4000) α X / log X ≤ (α/1000) 2^i/(i+1)`. -/
lemma dyadic_ineq {α X : ℝ} (hα : 0 < α) (i : ℕ) (hi : 3 ≤ i) (hX2 : X ≤ 2 * 2 ^ i)
    (hlog : i * Real.log 2 ≤ Real.log X) :
    1 / 4000 * α * X / Real.log X ≤ α / 1000 * (2 ^ i / ((i : ℝ) + 1)) := by
  have hl2 := Real.log_two_gt_d9
  have hiR : (3 : ℝ) ≤ i := by exact_mod_cast hi
  have hi0 : (0 : ℝ) < i := by linarith
  have hlog2 : 0 < Real.log 2 := by linarith
  have hL : 0 < (i : ℝ) * Real.log 2 := mul_pos hi0 hlog2
  have hlogX : 0 < Real.log X := lt_of_lt_of_le hL hlog
  have h2i : (0 : ℝ) < 2 ^ i := by positivity
  have hkey : (i : ℝ) + 1 ≤ 2 * ((i : ℝ) * Real.log 2) := by
    nlinarith [mul_le_mul_of_nonneg_left hl2.le hi0.le]
  have hfrac : 1 / 2 ≤ (i : ℝ) * Real.log 2 / ((i : ℝ) + 1) := by
    rw [le_div_iff₀ (by positivity)]; linarith
  rw [div_le_iff₀ hlogX]
  have hA : 0 ≤ α / 1000 * (2 ^ i / ((i : ℝ) + 1)) := by positivity
  calc 1 / 4000 * α * X ≤ 1 / 4000 * α * (2 * 2 ^ i) := by gcongr
    _ = α * 2 ^ i / 1000 * (1 / 2) := by ring
    _ ≤ α * 2 ^ i / 1000 * ((i : ℝ) * Real.log 2 / ((i : ℝ) + 1)) := by gcongr
    _ = α / 1000 * (2 ^ i / ((i : ℝ) + 1)) * ((i : ℝ) * Real.log 2) := by ring
    _ ≤ α / 1000 * (2 ^ i / ((i : ℝ) + 1)) * Real.log X := mul_le_mul_of_nonneg_left hlog hA

end P1P2

/-- **Step P2** (GS pp. 16–17, dyadic interval; Chebyshev via `FPDQ.lemmaM54A`), `c₂ = 1/4000`. -/
theorem stepP2 : StepP2 := by
  obtain ⟨N₀, hN₀⟩ := P_large
  refine ⟨1 / 4000, by norm_num, N₀, fun D hN F hF α hα => ?_⟩
  have hP1 : 2 ^ 24 ≤ D.P₁ := hN₀ D hN
  have h4 : 4 * D.P₁ ≤ D.P₂ := D.h4
  have hP12 : D.P₁ < D.P₂ := by omega
  have hnonneg : ∀ X : ℕ, 0 ≤ ∑ p ∈ D.Pset.filter (fun p => X ≤ p ∧ p < 2 * X), F p :=
    fun X => Finset.sum_nonneg fun p hp => hF p (Finset.mem_filter.mp hp).1
  have hP₁R : (1 : ℝ) < D.P₁ := by exact_mod_cast (show 1 < D.P₁ by omega)
  have hlogP₁ : 0 < Real.log D.P₁ := Real.log_pos hP₁R
  rcases le_or_gt α 0 with hα0 | hα0
  · -- `α ≤ 0`: take `X = P₁`
    refine ⟨D.P₁, le_rfl, hP12, ?_⟩
    have : 1 / 4000 * α * (D.P₁ : ℝ) / Real.log D.P₁ ≤ 0 := by
      apply div_nonpos_of_nonpos_of_nonneg _ hlogP₁.le
      have : (0 : ℝ) ≤ D.P₁ := by positivity
      nlinarith
    exact this.trans (hnonneg _)
  · obtain ⟨i, hi1, hi2, hsum⟩ := FPDQ.lemmaM54A hP1 h4 F hF hα0 hα
    have hi24 : 24 ≤ i := by
      have h : 2 ^ 24 < 2 ^ (i + 1) := lt_of_le_of_lt hP1 hi1
      have := (Nat.pow_lt_pow_iff_right (by norm_num)).mp h
      omega
    by_cases hcase : D.P₁ ≤ 2 ^ i
    · -- `X = 2^i`
      refine ⟨2 ^ i, hcase, hi2, ?_⟩
      have hsub : (primesIn D.P₁ D.P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)) ⊆
          D.Pset.filter (fun p => 2 ^ i ≤ p ∧ p < 2 * 2 ^ i) := by
        intro p hp
        rw [Finset.mem_filter] at hp ⊢
        refine ⟨hp.1, hp.2.1, ?_⟩
        have := hp.2.2
        rw [pow_succ] at this
        omega
      have hmono := Finset.sum_le_sum_of_subset_of_nonneg hsub
        (fun p hp _ => hF p (Finset.mem_filter.mp hp).1)
      refine le_trans ?_ (hsum.trans hmono)
      have hX2 : (((2 ^ i : ℕ) : ℝ)) ≤ 2 * 2 ^ i := by
        push_cast
        have : (0 : ℝ) ≤ 2 ^ i := by positivity
        linarith
      have hlog : (i : ℝ) * Real.log 2 ≤ Real.log ((2 ^ i : ℕ) : ℝ) := by
        push_cast
        rw [Real.log_pow]
      exact dyadic_ineq hα0 i (by omega) hX2 hlog
    · -- `2^i < P₁ < 2^{i+1}`: `X = P₁`
      push Not at hcase
      refine ⟨D.P₁, le_rfl, hP12, ?_⟩
      have hsub : (primesIn D.P₁ D.P₂).filter (fun p => 2 ^ i ≤ p ∧ p < 2 ^ (i + 1)) ⊆
          D.Pset.filter (fun p => D.P₁ ≤ p ∧ p < 2 * D.P₁) := by
        intro p hp
        rw [Finset.mem_filter] at hp ⊢
        refine ⟨hp.1, (mem_Pset hp.1).2.1, ?_⟩
        have := hp.2.2
        rw [pow_succ] at this
        omega
      have hmono := Finset.sum_le_sum_of_subset_of_nonneg hsub
        (fun p hp _ => hF p (Finset.mem_filter.mp hp).1)
      refine le_trans ?_ (hsum.trans hmono)
      have hX2 : (D.P₁ : ℝ) ≤ 2 * 2 ^ i := by
        have : D.P₁ ≤ 2 * 2 ^ i := by rw [pow_succ] at hi1; omega
        exact_mod_cast this
      have hlog : (i : ℝ) * Real.log 2 ≤ Real.log D.P₁ := by
        have h2iP : (2 : ℝ) ^ i ≤ (D.P₁ : ℝ) := by exact_mod_cast hcase.le
        have := Real.log_le_log (by positivity) h2iP
        rwa [Real.log_pow] at this
      exact dyadic_ineq hα0 i (by omega) hX2 hlog

end G22.P51

end

/- ## Section: `P51P3` -/

section

/-
# Step P3 of GS Proposition 5.1: from (5.4) to (5.7)

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, p. 17. The statement `StepP3` is in
`Prop51Steps.lean`; here we prove `stepP3 : StepProdAvg → StepP3`.

Write `F(x) = E^log_{n∈[N]} A_x(n)²` and `ε_N = (1 + 2 log P₂)/log N`.

* **Lower bound** ((5.4) → (5.5), `P3.sum_lower`). All terms of `∑_{x∈[X,2X)} Λ̃(x) F(x)` are
  `≥ 0`; keeping only the primes `p ∈ 𝒫 ∩ [X, 2X)`, where `Λ̃(p) ≥ log X / 16`, gives
  `∑_{x∈[X,2X)} Λ̃(x) F(x) ≥ c₂ δ² X / 32`.
* **Upper bound** ((5.5) → (5.7), `P3.F_le`): `F(x) ≤ Φ(x) + 2γ(𝒫') + ε_N` for every `x`.
  Expand the square (`P3.wavg_sq_eq`) and use Fubini (`P3.logAvg_lavg_lavg`). For each pair
  `(a, b) = (p'₁, p'₂)`, replace `1_{a∣n} 1_{b∣n}` by `1_{ab∣n}` at the cost of
  `ab |1_{a∣n} 1_{b∣n} - 1_{ab∣n}|` (`P3.swI`, pointwise bound `P3.pair_pointwise`), and apply
  GS Lemma A.4 (`Small.lemmaA4`) with `q = ab` and `G(m) = f₁(mb + λxa) f₁(ma + λxb)`
  (for `n = abm`: `n/a = mb`, `n/b = ma`), which gives the inner average of `Φ` up to
  `(1 + log ab)/log N ≤ ε_N` (`P3.pair_bound`). The switch errors average to at most `2γ(𝒫')`
  (`Small.lemma55`, converted to the `lavg 𝒫'` form by `StepProdAvg`, `P3.sw_avg_le`), and
  `γ(𝒫') ≤ 4δ⁵` (`Small.lemma52_prop51`).
* **Conclusion.** With `E = 8δ⁵ + ε_N`, `Λ̃ ≥ 0` and `∑_{[X,2X)} Λ̃ ≤ 2X`:
  `∑ Λ̃ Φ ≥ ∑ Λ̃ F - E ∑ Λ̃ ≥ c₂δ²X/32 - 2EX ≥ c₂δ²X/64`, since `E ≤ c₂δ²/128`.

**Constants.** `C_M ≥ 0` is the Mertens constant of `MertensProof.mertensLower`;
`δ₀ = min(1/2, c₂/2048, 1/(2C_M + 1))` (so `2C_Mδ⁵ ≤ 1` and `8δ⁵ ≤ c₂δ²/256`);
`N₀ = max(2, ⌈exp(max(L₀, 1))⌉)`, where `K (log L)⁸ ≤ L` for `L ≥ L₀`, `K = 81·256⁴/c₂⁴`
(`isLittleO_pow_log_id_atTop`). Then `ε_N ≤ c₂δ²/256` (`P3.eps_small`), using
`(log P₂)⁴ < log N` and `1/δ ≤ log log N` (`P3.eps_real`: `(1 + 2 log P₂)⁴ ≤ 81 log N`).

**Degenerate cases.** If `𝒫' = ∅` then `A_x ≡ 0` and the hypothesis `c₂(δ²/2)X/log X ≤ 0` fails
(`log X > 0` as `X ≥ P₁ ≥ 3`). If `𝒫' ≠ ∅`, every factor set `S ℓ` is nonempty (`GoodSets`).
-/

open Finset Real

namespace G22.P51

namespace P3

/- ## Generic facts about averages -/

/-- `(E f)² = E_a E_b f(a) f(b)`. -/
lemma wavg_sq_eq {α : Type*} (s : Finset α) (w : α → ℝ) (f : α → ℝ) :
    wavg s w f ^ 2 = wavg s w (fun a => wavg s w (fun b => f a * f b)) := by
  have h1 : ∀ a, wavg s w (fun b => f a * f b) = f a * wavg s w f := fun a => wavg_smul (f a) f
  simp only [h1]
  rw [← Elem.wavg_mul_const, sq]

/-- Fubini: `E^log_n E^log_a E^log_b G = E^log_a E^log_b E^log_n G`. -/
lemma logAvg_lavg_lavg (N : ℕ) (S : Finset ℕ) (G : ℤ → ℕ → ℕ → ℝ) :
    logAvg N (fun n => lavg S (fun a => lavg S (fun b => G n a b))) =
      lavg S (fun a => lavg S (fun b => logAvg N (fun n => G n a b))) := by
  unfold logAvg lavg
  rw [Elem.wavg_comm]
  refine wavg_congr fun a _ => ?_
  exact Elem.wavg_comm _ _ _ _ _

lemma logAvg_add (N : ℕ) (f g : ℤ → ℝ) :
    logAvg N (fun n => f n + g n) = logAvg N f + logAvg N g := by
  unfold logAvg
  exact wavg_add _ _

lemma logAvg_mono {N : ℕ} (hN : 1 ≤ N) {f g : ℤ → ℝ} (h : ∀ n, f n ≤ g n) :
    logAvg N f ≤ logAvg N g :=
  wavg_mono (goodWeights_logAvg hN) fun n _ => h n

lemma lavg_add3 {S : Finset ℕ} (hw : GoodWeights S (fun p : ℕ => 1 / (p : ℝ))) (f g : ℕ → ℝ)
    (c : ℝ) : lavg S (fun p => f p + g p + c) = lavg S f + lavg S g + c := by
  unfold lavg
  rw [wavg_add (fun p => f p + g p) (fun _ => c), wavg_add, wavg_const hw]

lemma card_win (X : ℕ) : (win X).card = X := by
  unfold win
  rw [Int.card_Ico]
  omega

/-- `E_{x∈[X,2X)} g(x) = X⁻¹ ∑_{x∈[X,2X)} g(x)`. -/
lemma favg_win (X : ℕ) (g : ℤ → ℝ) : favg (win X) g = (∑ x ∈ win X, g x) / X := by
  unfold favg wavg
  simp only [one_mul, Finset.sum_const, card_win, nsmul_eq_mul, mul_one]

/- ## Facts about the data -/

/-- The factor sets `S ℓ` (primes in `[lo ℓ, hi ℓ)`, `ℓ < k`) of `𝒫'`. -/
def Sfam (D : Data) : Fin D.k → Finset ℕ := fun ℓ => primesIn (D.lo ℓ.castSucc) (D.hi ℓ.castSucc)

lemma Pp_eq (D : Data) : D.Pp = FPDQ.boxProd (Sfam D) := rfl

lemma Sfam_prime (D : Data) : ∀ ℓ, ∀ p ∈ Sfam D ℓ, p.Prime := fun _ _ hp =>
  (Finset.mem_filter.mp hp).2

lemma Sfam_disj (D : Data) : ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (Sfam D ℓ) (Sfam D ℓ') := by
  intro ℓ ℓ' h
  rw [Finset.disjoint_left]
  intro p hp hp'
  have h1 := Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1
  have h2 := Finset.mem_Ico.mp (Finset.mem_filter.mp hp').1
  rcases D.hdisj ℓ ℓ' h with h3 | h3 <;> omega

lemma three_le_P₁ (D : Data) : 3 ≤ D.P₁ := by
  have h1 := D.hP₁'
  have h2 := D.hP₁'P₂'
  have h3 := D.hP₂'P₁
  show 3 ≤ D.lo (Fin.last D.k)
  omega

lemma P₂'_lt_P₂ (D : Data) : D.P₂' < D.P₂ := by
  have h1 := D.hP₂'P₁
  have h2 := D.hP₁P₂
  show D.P₂' < D.hi (Fin.last D.k)
  omega

/-- Elements of `𝒫' = D.Pp` satisfy `0 < p' ≤ P'₂` (by `∏ hi ℓ ≤ P'₂`). -/
lemma mem_Pp {D : Data} {q : ℕ} (hq : q ∈ D.Pp) : 0 < q ∧ q ≤ D.P₂' := by
  rw [Pp_eq] at hq
  unfold FPDQ.boxProd at hq
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hq
  rw [Fintype.mem_piFinset] at hf
  have hmem : ∀ ℓ, (f ℓ).Prime ∧ f ℓ < D.hi ℓ.castSucc := fun ℓ => by
    have h := hf ℓ
    unfold Sfam primesIn at h
    rw [Finset.mem_filter, Finset.mem_Ico] at h
    exact ⟨h.2, h.1.2⟩
  refine ⟨Nat.pos_of_ne_zero ?_, ?_⟩
  · rw [Finset.prod_ne_zero_iff]
    exact fun ℓ _ => (hmem ℓ).1.ne_zero
  · calc ∏ ℓ, f ℓ ≤ ∏ ℓ : Fin D.k, D.hi ℓ.castSucc :=
          Finset.prod_le_prod (fun _ _ => Nat.zero_le _) (fun ℓ _ => (hmem ℓ).2.le)
      _ ≤ D.P₂' := D.hprod

lemma gw_Pp {D : Data} (hne : D.Pp.Nonempty) : GoodWeights D.Pp (fun p : ℕ => 1 / (p : ℝ)) :=
  goodWeights_lavg hne fun _ hq => (mem_Pp hq).1

/-- If `𝒫' ≠ ∅`, then every factor set is nonempty. -/
lemma goodSets_of_ne {D : Data} (hne : D.Pp.Nonempty) : GoodSets (Sfam D) := by
  obtain ⟨q, hq⟩ := hne
  rw [Pp_eq] at hq
  unfold FPDQ.boxProd at hq
  obtain ⟨f, hf, -⟩ := Finset.mem_image.mp hq
  rw [Fintype.mem_piFinset] at hf
  exact fun ℓ => ⟨⟨f ℓ, hf ℓ⟩, fun p hp => (Sfam_prime D ℓ p hp).pos⟩

/-- If `𝒫' = ∅`, then `A_x ≡ 0`, so every sum of `E^log_n A_p(n)²` vanishes. -/
lemma sum_zero_of_Pp_empty (D : Data) (f₁ : ℤ → ℝ) (h : D.Pp = ∅) (T : Finset ℕ) :
    ∑ p ∈ T, logAvg D.N (fun n => Aval D f₁ p n ^ 2) = 0 := by
  apply Finset.sum_eq_zero
  intro p _
  have h0 : ∀ n, Aval D f₁ p n = 0 := fun n => by
    unfold Aval lavg wavg
    rw [h]
    simp
  simp only [h0]
  unfold logAvg wavg
  simp

/- ## The switch (5.5) and GS Lemma A.4 for one pair -/

/-- The error of the switch (5.5) for a pair: `ab |1_{a∣n} 1_{b∣n} - 1_{ab∣n}|`. -/
noncomputable def swI (a b : ℕ) (n : ℤ) : ℝ :=
  ((a * b : ℕ) : ℝ) * |(if (a : ℤ) ∣ n then 1 else 0) * (if (b : ℤ) ∣ n then 1 else 0) -
    (if ((a * b : ℕ) : ℤ) ∣ n then 1 else 0)|

lemma swI_nonneg (a b : ℕ) (n : ℤ) : 0 ≤ swI a b n := by
  unfold swI
  positivity

/-- Pointwise: `(a 1_{a∣n} f₁(n/a + λxa)) (b 1_{b∣n} f₁(n/b + λxb)) ≤
ab 1_{ab∣n} G(n/(ab)) + swI a b n`, with `G(m) = f₁(mb + λxa) f₁(ma + λxb)`. -/
lemma pair_pointwise (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (lam : ℕ) (x : ℤ) {a b : ℕ}
    (ha : 0 < a) (hb : 0 < b) (n : ℤ) :
    ((a : ℝ) * (if (a : ℤ) ∣ n then f₁ (n / a + (lam : ℤ) * x * a) else 0)) *
        ((b : ℝ) * (if (b : ℤ) ∣ n then f₁ (n / b + (lam : ℤ) * x * b) else 0)) ≤
      (if ((a * b : ℕ) : ℤ) ∣ n then ((a * b : ℕ) : ℝ) *
          (f₁ (n / ((a * b : ℕ) : ℤ) * b + (lam : ℤ) * x * a) *
            f₁ (n / ((a * b : ℕ) : ℤ) * a + (lam : ℤ) * x * b)) else 0) + swI a b n := by
  have haZ : (a : ℤ) ≠ 0 := by exact_mod_cast ha.ne'
  have hbZ : (b : ℤ) ≠ 0 := by exact_mod_cast hb.ne'
  have hF : ∀ u v : ℤ, f₁ u * f₁ v ≤ 1 := fun u v => by
    have h1 := hf₁ u
    have h2 := hf₁ v
    have h3 : |f₁ u * f₁ v| ≤ 1 := by
      rw [abs_mul]
      nlinarith [abs_nonneg (f₁ u), abs_nonneg (f₁ v)]
    exact (le_abs_self _).trans h3
  by_cases hab : ((a * b : ℕ) : ℤ) ∣ n
  · obtain ⟨m, rfl⟩ := hab
    have hdiva : (a : ℤ) ∣ ((a * b : ℕ) : ℤ) * m := ⟨b * m, by push_cast; ring⟩
    have hdivb : (b : ℤ) ∣ ((a * b : ℕ) : ℤ) * m := ⟨a * m, by push_cast; ring⟩
    have e1 : ((a * b : ℕ) : ℤ) * m / a = m * b := by
      rw [show ((a * b : ℕ) : ℤ) * m = (a : ℤ) * (m * b) by push_cast; ring]
      exact Int.mul_ediv_cancel_left _ haZ
    have e2 : ((a * b : ℕ) : ℤ) * m / b = m * a := by
      rw [show ((a * b : ℕ) : ℤ) * m = (b : ℤ) * (m * a) by push_cast; ring]
      exact Int.mul_ediv_cancel_left _ hbZ
    have hab0 : ((a * b : ℕ) : ℤ) ≠ 0 := by
      push_cast
      exact mul_ne_zero haZ hbZ
    have e3 : ((a * b : ℕ) : ℤ) * m / ((a * b : ℕ) : ℤ) = m := Int.mul_ediv_cancel_left _ hab0
    have hsw : swI a b (((a * b : ℕ) : ℤ) * m) = 0 := by
      unfold swI
      rw [if_pos hdiva, if_pos hdivb, if_pos (dvd_mul_right _ _)]
      simp
    rw [if_pos hdiva, if_pos hdivb, if_pos (dvd_mul_right _ _), e1, e2, e3, hsw]
    push_cast
    exact le_of_eq (by ring)
  · rw [if_neg hab, zero_add]
    have hsw0 := swI_nonneg a b n
    by_cases ha' : (a : ℤ) ∣ n
    · by_cases hb' : (b : ℤ) ∣ n
      · have hsw : swI a b n = ((a * b : ℕ) : ℝ) := by
          unfold swI
          rw [if_pos ha', if_pos hb', if_neg hab]
          simp
        rw [if_pos ha', if_pos hb', hsw]
        have h1 := hF (n / a + (lam : ℤ) * x * a) (n / b + (lam : ℤ) * x * b)
        have h2 : (0 : ℝ) ≤ (a : ℝ) * b := by positivity
        push_cast
        nlinarith
      · rw [if_neg hb']
        simpa using hsw0
    · rw [if_neg ha']
      simpa using hsw0

/-- One pair `(a, b)`: the switch and GS Lemma A.4 with `q = ab`. -/
lemma pair_bound {N : ℕ} (hN : 2 ≤ N) (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (lam : ℕ) (x : ℤ)
    {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    logAvg N (fun n => ((a : ℝ) * (if (a : ℤ) ∣ n then f₁ (n / a + (lam : ℤ) * x * a) else 0)) *
        ((b : ℝ) * (if (b : ℤ) ∣ n then f₁ (n / b + (lam : ℤ) * x * b) else 0))) ≤
      logAvg N (fun m => f₁ (m * b + (lam : ℤ) * x * a) * f₁ (m * a + (lam : ℤ) * x * b)) +
        logAvg N (fun n => swI a b n) + (1 + Real.log ((a * b : ℕ) : ℝ)) / Real.log N := by
  have hG1 : ∀ m : ℤ, |f₁ (m * b + (lam : ℤ) * x * a) * f₁ (m * a + (lam : ℤ) * x * b)| ≤ 1 :=
    fun m => by
      rw [abs_mul]
      have h1 := hf₁ (m * b + (lam : ℤ) * x * a)
      have h2 := hf₁ (m * a + (lam : ℤ) * x * b)
      nlinarith [abs_nonneg (f₁ (m * b + (lam : ℤ) * x * a)),
        abs_nonneg (f₁ (m * a + (lam : ℤ) * x * b))]
  have hA4 := Small.lemmaA4 hN (show 1 ≤ a * b from Nat.mul_pos ha hb)
    (fun m => f₁ (m * b + (lam : ℤ) * x * a) * f₁ (m * a + (lam : ℤ) * x * b)) hG1
  have h1 : logAvg N (fun n =>
        ((a : ℝ) * (if (a : ℤ) ∣ n then f₁ (n / a + (lam : ℤ) * x * a) else 0)) *
          ((b : ℝ) * (if (b : ℤ) ∣ n then f₁ (n / b + (lam : ℤ) * x * b) else 0))) ≤
      logAvg N (fun n => (if ((a * b : ℕ) : ℤ) ∣ n then ((a * b : ℕ) : ℝ) *
          (f₁ (n / ((a * b : ℕ) : ℤ) * b + (lam : ℤ) * x * a) *
            f₁ (n / ((a * b : ℕ) : ℤ) * a + (lam : ℤ) * x * b)) else 0) + swI a b n) :=
    logAvg_mono (by omega) fun n => pair_pointwise f₁ hf₁ lam x ha hb n
  rw [logAvg_add] at h1
  have h2 := (abs_le.mp hA4).1
  linarith

/- ## Averaging over the pairs -/

/-- `E^log_{a,b∈𝒫'} E^log_n swI a b n ≤ 2γ(𝒫')`: `Small.lemma55` in the `lavg 𝒫'` form. -/
lemma sw_avg_le (hProd : StepProdAvg) (D : Data) (hS : GoodSets (Sfam D)) :
    lavg D.Pp (fun a => lavg D.Pp (fun b => logAvg D.N (fun n => swI a b n))) ≤
      2 * Small.gammaP D.k (Sfam D) := by
  have hP := hProd D.k (Sfam D) (Sfam_prime D) (Sfam_disj D)
  have e1 : ∀ a, lavg D.Pp (fun b => logAvg D.N (fun n => swI a b n)) =
      iterAvg D.k (Sfam D) (fun b => logAvg D.N (fun n => swI a (∏ ℓ, b ℓ) n)) :=
    fun a => (hP (fun b => logAvg D.N (fun n => swI a b n))).symm
  have e2 : lavg D.Pp (fun a => lavg D.Pp (fun b => logAvg D.N (fun n => swI a b n))) =
      iterAvg D.k (Sfam D)
        (fun a => lavg D.Pp (fun b => logAvg D.N (fun n => swI (∏ ℓ, a ℓ) b n))) :=
    (hP (fun a => lavg D.Pp (fun b => logAvg D.N (fun n => swI a b n)))).symm
  rw [e2]
  simp only [e1]
  exact Small.lemma55 D.N (Sfam D) hS

/-- `(1 + log ab)/log N ≤ ε_N` for `a, b ∈ 𝒫'`. -/
lemma log_pair_le (D : Data) (hN : 2 ≤ D.N) {a b : ℕ} (ha : a ∈ D.Pp) (hb : b ∈ D.Pp) :
    (1 + Real.log ((a * b : ℕ) : ℝ)) / Real.log D.N ≤
      (1 + 2 * Real.log D.P₂) / Real.log D.N := by
  have hlogN : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
  apply div_le_div_of_nonneg_right _ hlogN.le
  have ha1 := mem_Pp ha
  have hb1 := mem_Pp hb
  have hP := P₂'_lt_P₂ D
  have ha2 : (a : ℝ) ≤ D.P₂ := by exact_mod_cast (show a ≤ D.P₂ by omega)
  have hb2 : (b : ℝ) ≤ D.P₂ := by exact_mod_cast (show b ≤ D.P₂ by omega)
  have ha0 : (0 : ℝ) < a := by exact_mod_cast ha1.1
  have hb0 : (0 : ℝ) < b := by exact_mod_cast hb1.1
  push_cast
  rw [Real.log_mul ha0.ne' hb0.ne']
  have h1 := Real.log_le_log ha0 ha2
  have h2 := Real.log_le_log hb0 hb2
  linarith

/-- **(5.5) → (5.7) for one `x`**: `E^log_n A_x(n)² ≤ Φ(x) + 2γ(𝒫') + ε_N`. -/
lemma F_le (hProd : StepProdAvg) (D : Data) (hN : 2 ≤ D.N) (f₁ : ℤ → ℝ)
    (hf₁ : ∀ n, |f₁ n| ≤ 1) (hne : D.Pp.Nonempty) (x : ℤ) :
    logAvg D.N (fun n => Aval D f₁ x n ^ 2) ≤
      Phi D f₁ x + 2 * Small.gammaP D.k (Sfam D) + (1 + 2 * Real.log D.P₂) / Real.log D.N := by
  have hw := gw_Pp hne
  have hS := goodSets_of_ne hne
  have e1 : (fun n : ℤ => Aval D f₁ x n ^ 2) = fun n => lavg D.Pp (fun a => lavg D.Pp (fun b =>
      ((a : ℝ) * (if (a : ℤ) ∣ n then f₁ (n / a + (D.lam : ℤ) * x * a) else 0)) *
        ((b : ℝ) * (if (b : ℤ) ∣ n then f₁ (n / b + (D.lam : ℤ) * x * b) else 0)))) := by
    funext n
    unfold Aval lavg
    exact wavg_sq_eq _ _ _
  rw [e1, logAvg_lavg_lavg]
  have hpair : ∀ a ∈ D.Pp, ∀ b ∈ D.Pp,
      logAvg D.N (fun n =>
          ((a : ℝ) * (if (a : ℤ) ∣ n then f₁ (n / a + (D.lam : ℤ) * x * a) else 0)) *
            ((b : ℝ) * (if (b : ℤ) ∣ n then f₁ (n / b + (D.lam : ℤ) * x * b) else 0))) ≤
        logAvg D.N (fun m => f₁ (m * b + (D.lam : ℤ) * x * a) * f₁ (m * a + (D.lam : ℤ) * x * b)) +
          logAvg D.N (fun n => swI a b n) + (1 + 2 * Real.log D.P₂) / Real.log D.N := by
    intro a ha b hb
    refine (pair_bound hN f₁ hf₁ D.lam x (mem_Pp ha).1 (mem_Pp hb).1).trans ?_
    have := log_pair_le D hN ha hb
    linarith
  calc lavg D.Pp (fun a => lavg D.Pp (fun b => logAvg D.N (fun n =>
          ((a : ℝ) * (if (a : ℤ) ∣ n then f₁ (n / a + (D.lam : ℤ) * x * a) else 0)) *
            ((b : ℝ) * (if (b : ℤ) ∣ n then f₁ (n / b + (D.lam : ℤ) * x * b) else 0)))))
      ≤ lavg D.Pp (fun a => lavg D.Pp (fun b =>
          logAvg D.N (fun m => f₁ (m * b + (D.lam : ℤ) * x * a) *
            f₁ (m * a + (D.lam : ℤ) * x * b)) +
          logAvg D.N (fun n => swI a b n) + (1 + 2 * Real.log D.P₂) / Real.log D.N)) :=
        wavg_mono hw fun a ha => wavg_mono hw fun b hb => hpair a ha b hb
    _ = Phi D f₁ x + lavg D.Pp (fun a => lavg D.Pp (fun b => logAvg D.N (fun n => swI a b n))) +
          (1 + 2 * Real.log D.P₂) / Real.log D.N := by
        simp only [lavg_add3 hw]
        rfl
    _ ≤ Phi D f₁ x + 2 * Small.gammaP D.k (Sfam D) + (1 + 2 * Real.log D.P₂) / Real.log D.N := by
        have := sw_avg_le hProd D hS
        linarith

/- ## The lower bound (5.4) → (5.5) -/

/-- Keeping only the primes of `T ⊂ 𝒫 ∩ [X, 2X)` in `∑_{x∈[X,2X)} Λ̃(x) F(x)`. -/
lemma sum_lower {X : ℕ} (hX : 2 ≤ X) (T : Finset ℕ)
    (hT : ∀ p ∈ T, p.Prime ∧ X ≤ p ∧ p < 2 * X) (Λt F : ℤ → ℝ) (hΛ0 : ∀ x, 0 ≤ Λt x)
    (hF0 : ∀ x, 0 ≤ F x) (hΛp : ∀ p : ℕ, p.Prime → X ≤ p → Real.log X / 16 ≤ Λt p) {c : ℝ}
    (hc : c * X / Real.log X ≤ ∑ p ∈ T, F p) :
    c * X / 16 ≤ ∑ x ∈ win X, Λt x * F x := by
  have hlog : 0 < Real.log X := Real.log_pos (by exact_mod_cast (show 1 < X by omega))
  have hsub : T.image (fun p : ℕ => (p : ℤ)) ⊆ win X := by
    intro y hy
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hy
    have := hT p hp
    unfold win
    rw [Finset.mem_Ico]
    constructor <;> omega
  have h1 : ∑ x ∈ T.image (fun p : ℕ => (p : ℤ)), Λt x * F x ≤ ∑ x ∈ win X, Λt x * F x :=
    Finset.sum_le_sum_of_subset_of_nonneg hsub fun x _ _ => mul_nonneg (hΛ0 x) (hF0 x)
  have h2 : ∑ x ∈ T.image (fun p : ℕ => (p : ℤ)), Λt x * F x = ∑ p ∈ T, Λt p * F p :=
    Finset.sum_image fun p _ q _ h => by exact_mod_cast h
  have h3 : ∑ p ∈ T, Real.log X / 16 * F p ≤ ∑ p ∈ T, Λt p * F p :=
    Finset.sum_le_sum fun p hp => mul_le_mul_of_nonneg_right
      (hΛp p (hT p hp).1 (hT p hp).2.1) (hF0 p)
  have h4 : ∑ p ∈ T, Real.log X / 16 * F p = Real.log X / 16 * ∑ p ∈ T, F p :=
    (Finset.mul_sum _ _ _).symm
  have h5 : Real.log X / 16 * (c * X / Real.log X) = c * X / 16 := by
    field_simp
  have h6 : Real.log X / 16 * (c * X / Real.log X) ≤ Real.log X / 16 * ∑ p ∈ T, F p :=
    mul_le_mul_of_nonneg_left hc (by positivity)
  linarith

/- ## `N` large -/

/-- `K (log L)⁸ ≤ L` for all large `L`. -/
lemma exists_log_pow_le (K : ℝ) (hK : 0 < K) :
    ∃ L₀ : ℝ, ∀ L, L₀ ≤ L → K * Real.log L ^ 8 ≤ L := by
  have h := (isLittleO_pow_log_id_atTop (n := 8)).bound (show (0 : ℝ) < 1 / K by positivity)
  obtain ⟨L₀, hL₀⟩ := Filter.eventually_atTop.mp h
  refine ⟨max L₀ 0, fun L hL => ?_⟩
  have h1 := hL₀ L (le_trans (le_max_left _ _) hL)
  have hL0 : 0 ≤ L := le_trans (le_max_right _ _) hL
  simp only [Real.norm_eq_abs, id_eq] at h1
  rw [abs_of_nonneg hL0, abs_of_nonneg (by positivity : (0 : ℝ) ≤ Real.log L ^ 8)] at h1
  have h2 := mul_le_mul_of_nonneg_left h1 hK.le
  have e : K * (1 / K * L) = L := by field_simp
  linarith

/-- The real inequality behind `ε_N ≤ c₂δ²/256`: with `L = log N`, `ℓ = log log N`,
`t = log P₂`. -/
lemma eps_real {c₂ L ℓ t δ : ℝ} (hc₂ : 0 < c₂) (hL1 : 1 ≤ L)
    (hK : 81 * 256 ^ 4 / c₂ ^ 4 * ℓ ^ 8 ≤ L) (hδ : 0 < δ) (hδℓ : 1 / δ ≤ ℓ) (ht0 : 0 ≤ t)
    (ht4 : t ^ 4 < L) : (1 + 2 * t) / L ≤ c₂ * δ ^ 2 / 256 := by
  have hL0 : 0 < L := by linarith
  have hℓ : 0 < ℓ := lt_of_lt_of_le (by positivity) hδℓ
  have hδℓ' : 1 ≤ δ * ℓ := by
    rw [div_le_iff₀ hδ] at hδℓ
    linarith
  have hu0 : 0 ≤ 1 + 2 * t := by linarith
  -- `(1 + 2t)⁴ ≤ 81 L`
  have hu : (1 + 2 * t) ^ 4 ≤ 81 * L := by
    rcases le_total t 1 with h | h
    · have h3 : (1 + 2 * t) ^ 4 ≤ 3 ^ 4 := pow_le_pow_left₀ hu0 (by linarith) 4
      linarith
    · have h3 : (1 + 2 * t) ^ 4 ≤ (3 * t) ^ 4 := pow_le_pow_left₀ hu0 (by linarith) 4
      have e : (3 * t) ^ 4 = 81 * t ^ 4 := by ring
      linarith
  have hK' : 81 * 256 ^ 4 * ℓ ^ 8 ≤ c₂ ^ 4 * L := by
    have hc4 : 0 < c₂ ^ 4 := by positivity
    have e : 81 * 256 ^ 4 / c₂ ^ 4 * ℓ ^ 8 = (81 * 256 ^ 4 * ℓ ^ 8) / c₂ ^ 4 := by ring
    rw [e, div_le_iff₀ hc4] at hK
    linarith
  have h4 : (256 * ℓ ^ 2 * (1 + 2 * t)) ^ 4 ≤ (c₂ * L) ^ 4 := by
    have e1 : (256 * ℓ ^ 2 * (1 + 2 * t)) ^ 4 = 256 ^ 4 * ℓ ^ 8 * (1 + 2 * t) ^ 4 := by ring
    have e2 : (c₂ * L) ^ 4 = c₂ ^ 4 * L ^ 4 := by ring
    rw [e1, e2]
    have hℓ8 : 0 ≤ 256 ^ 4 * ℓ ^ 8 := by positivity
    have hL24 : L ^ 2 ≤ L ^ 4 := pow_le_pow_right₀ hL1 (by norm_num)
    calc 256 ^ 4 * ℓ ^ 8 * (1 + 2 * t) ^ 4 ≤ 256 ^ 4 * ℓ ^ 8 * (81 * L) :=
          mul_le_mul_of_nonneg_left hu hℓ8
      _ = (81 * 256 ^ 4 * ℓ ^ 8) * L := by ring
      _ ≤ (c₂ ^ 4 * L) * L := mul_le_mul_of_nonneg_right hK' hL0.le
      _ = c₂ ^ 4 * L ^ 2 := by ring
      _ ≤ c₂ ^ 4 * L ^ 4 := mul_le_mul_of_nonneg_left hL24 (by positivity)
  have hmain : 256 * ℓ ^ 2 * (1 + 2 * t) ≤ c₂ * L :=
    (pow_le_pow_iff_left₀ (mul_nonneg (by positivity) hu0) (mul_pos hc₂ hL0).le
      (by norm_num : (4 : ℕ) ≠ 0)).mp h4
  rw [div_le_iff₀ hL0]
  have hδℓ2 : 1 ≤ (δ * ℓ) ^ 2 := by nlinarith
  calc 1 + 2 * t ≤ (δ * ℓ) ^ 2 * (1 + 2 * t) := by nlinarith
    _ = δ ^ 2 * (ℓ ^ 2 * (1 + 2 * t)) := by ring
    _ ≤ δ ^ 2 * (c₂ * L / 256) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        linarith
    _ = c₂ * δ ^ 2 / 256 * L := by ring

/-- **`N` large**: `N ≥ 2` and `ε_N = (1 + 2 log P₂)/log N ≤ c₂δ²/256`. -/
lemma eps_small (c₂ : ℝ) (hc₂ : 0 < c₂) : ∃ N₀ : ℕ, ∀ D : Data, N₀ ≤ D.N →
    2 ≤ D.N ∧ (1 + 2 * Real.log D.P₂) / Real.log D.N ≤ c₂ * D.δ ^ 2 / 256 := by
  obtain ⟨L₀, hL₀⟩ := exists_log_pow_le (81 * 256 ^ 4 / c₂ ^ 4) (by positivity)
  refine ⟨max 2 ⌈Real.exp (max L₀ 1)⌉₊, fun D hN => ?_⟩
  have hN2 : 2 ≤ D.N := le_trans (le_max_left _ _) hN
  refine ⟨hN2, ?_⟩
  have hNpos : (0 : ℝ) < D.N := by exact_mod_cast (show 0 < D.N by omega)
  have hNexp : Real.exp (max L₀ 1) ≤ D.N :=
    le_trans (Nat.le_ceil _) (by exact_mod_cast le_trans (le_max_right _ _) hN)
  have hL : max L₀ 1 ≤ Real.log D.N := (Real.le_log_iff_exp_le hNpos).mpr hNexp
  have hP₂ : (1 : ℝ) ≤ D.P₂ := by
    have := P₂'_lt_P₂ D
    exact_mod_cast (show 1 ≤ D.P₂ by omega)
  exact eps_real hc₂ (le_trans (le_max_right _ _) hL)
    (hL₀ _ (le_trans (le_max_left _ _) hL)) D.hδ D.hδN (Real.log_nonneg hP₂) D.hP₂N

end P3

open P3 in
/-- **Step P3** (GS p. 17, (5.4) → (5.7)), from the product identity `StepProdAvg`. -/
theorem stepP3 (hProd : StepProdAvg) : StepP3 := by
  intro c₂ hc₂
  obtain ⟨C_M, hCM0, hM⟩ := MertensProof.mertensLower
  obtain ⟨N₀, hN₀⟩ := eps_small c₂ hc₂
  have hCM1 : 0 < 2 * C_M + 1 := by linarith
  refine ⟨min (1 / 2) (min (c₂ / 2048) (1 / (2 * C_M + 1))),
    lt_min (by norm_num) (lt_min (by positivity) (by positivity)), N₀, ?_⟩
  intro D hδ₀ hN f₁ hf₁ X hX1 hX2 Λt hΛ0 hΛp hΛsum hsum
  obtain ⟨hN2, heps⟩ := hN₀ D hN
  simp only [le_min_iff] at hδ₀
  obtain ⟨hδh, hδc, hδM⟩ := hδ₀
  have hδ := D.hδ
  have hδ1 : D.δ ≤ 1 := by linarith
  -- `2 C_M δ⁵ ≤ 1`, hence `γ(𝒫') ≤ 4δ⁵` (GS Lemma 5.2)
  have hδ5 : D.δ ^ 5 ≤ D.δ := pow_le_of_le_one hδ.le hδ1 (by norm_num)
  have hδC : 2 * C_M * D.δ ^ 5 ≤ 1 := by
    have h1 : D.δ * (2 * C_M + 1) ≤ 1 := (le_div_iff₀ hCM1).mp hδM
    have h2 : C_M * D.δ ^ 5 ≤ C_M * D.δ := mul_le_mul_of_nonneg_left hδ5 hCM0
    nlinarith
  have hγ : Small.gammaP D.k (Sfam D) ≤ 4 * D.δ ^ 5 :=
    Small.lemma52_prop51 D.hk hM hδ hδh hδC D.lo D.hi D.hP₁' D.hI D.hdisj D.hwidth
  -- `X ≥ 3`
  have hX3 : 3 ≤ X := le_trans (three_le_P₁ D) hX1
  have hXR : (3 : ℝ) ≤ X := by exact_mod_cast hX3
  have hXpos : (0 : ℝ) < X := by linarith
  have hlogX : 0 < Real.log X := Real.log_pos (by linarith)
  -- `𝒫'` is nonempty
  have hne : D.Pp.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hPp
    rw [sum_zero_of_Pp_empty D f₁ hPp] at hsum
    have : 0 < c₂ * (D.δ ^ 2 / 2) * X / Real.log X := by positivity
    linarith
  -- the upper bound `F(x) ≤ Φ(x) + E`
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = 8 * D.δ ^ 5 + (1 + 2 * Real.log D.P₂) / Real.log D.N :=
    ⟨_, rfl⟩
  have hFle : ∀ x : ℤ, logAvg D.N (fun n => Aval D f₁ x n ^ 2) ≤ Phi D f₁ x + E := by
    intro x
    have := F_le hProd D hN2 f₁ hf₁ hne x
    linarith
  have hδ3 : D.δ ^ 3 ≤ c₂ / 2048 :=
    le_trans (pow_le_of_le_one hδ.le hδ1 (by norm_num)) hδc
  have hE' : E ≤ c₂ * D.δ ^ 2 / 128 := by
    have h1 : D.δ ^ 2 * D.δ ^ 3 ≤ D.δ ^ 2 * (c₂ / 2048) :=
      mul_le_mul_of_nonneg_left hδ3 (by positivity)
    have e : D.δ ^ 5 = D.δ ^ 2 * D.δ ^ 3 := by ring
    rw [hE, e]
    linarith
  have hE0 : 0 ≤ E := by
    have hlogN : 0 < Real.log D.N := Real.log_pos (by exact_mod_cast (show 1 < D.N by omega))
    have hP₂ : (1 : ℝ) ≤ D.P₂ := by
      have := P₂'_lt_P₂ D
      exact_mod_cast (show 1 ≤ D.P₂ by omega)
    have := Real.log_nonneg hP₂
    rw [hE]
    positivity
  -- the lower bound
  have hlow : c₂ * (D.δ ^ 2 / 2) * X / 16 ≤
      ∑ x ∈ win X, Λt x * logAvg D.N (fun n => Aval D f₁ x n ^ 2) := by
    refine sum_lower (by omega) (D.Pset.filter (fun p => X ≤ p ∧ p < 2 * X)) ?_ Λt
      (fun x => logAvg D.N (fun n => Aval D f₁ x n ^ 2)) hΛ0
      (fun x => logAvg_sq_nonneg _ _) hΛp hsum
    intro p hp
    have hp' := Finset.mem_filter.mp hp
    exact ⟨(Finset.mem_filter.mp hp'.1).2, hp'.2.1, hp'.2.2⟩
  -- combine
  have hup : ∑ x ∈ win X, Λt x * logAvg D.N (fun n => Aval D f₁ x n ^ 2) ≤
      ∑ x ∈ win X, Λt x * Phi D f₁ x + E * ∑ x ∈ win X, Λt x := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun x _ => ?_
    have := mul_le_mul_of_nonneg_left (hFle x) (hΛ0 x)
    linarith
  have hΛsum' : ∑ x ∈ win X, Λt x ≤ 2 * X := hΛsum
  have hES : E * ∑ x ∈ win X, Λt x ≤ E * (2 * X) := mul_le_mul_of_nonneg_left hΛsum' hE0
  have hEX : E * (2 * X) ≤ c₂ * D.δ ^ 2 / 128 * (2 * X) :=
    mul_le_mul_of_nonneg_right hE' (by positivity)
  rw [favg_win, le_div_iff₀ hXpos]
  linarith

end G22.P51

end

/- ## Section: `P51Pigeon` -/

section

/-
# Steps P5a and P6e of GS Proposition 5.1: pigeonholing over pairs of subdyadic boxes

GS = B. Green and M. Sawhney, arXiv:2511.09365v2. Statements in `Prop51Steps.lean`.

* `stepP5a (hB : StepBoxes) : StepP5a` (GS p. 17, (5.9) → (5.12)): signed pigeonhole over pairs
  of `Good5` boxes.
* `stepP6e (hB : StepBoxes) : StepP6e` (GS p. 22, refoliation; review fix G1): non-negative
  pigeonhole over pairs of `Good6` boxes, then logarithmic → uniform weights.

Shared infrastructure (namespace `G22.P51.Pigeon`):

1. **Decomposition** (`lavg_decomp`, `lavg_lavg_decomp`): if every factor `S ℓ` of a box of
   primes is the disjoint union of pieces `T ℓ i` (`i ∈ I ℓ`), then the logarithmic average over
   `boxProd S` is the average of the logarithmic averages over the sub-boxes
   `boxProd (T ℓ (j ℓ))`, with the product weights `∏_ℓ relW ℓ (j ℓ)`,
   `relW ℓ i = mass (T ℓ i) / mass (S ℓ)`; likewise for double averages over pairs of sub-boxes.
2. **Pigeonhole** (`pigeon_pairs`): `FPDQ.lemmaPH` and `FPDQ.prod_weight_bad_pair` on the pairs
   of sub-boxes.
3. **Log → uniform** (`lavg_le_two_favg`, `box_bounds`): a box with ratios `≤ 1 + 1/(4k)` lies in
   `[Y, 2Y]`, `Y = ∏ a ℓ`, so `E^log h ≤ 2 E h` for `h ≥ 0`.
4. **The data of Prop 5.1** (`growth`, `width_facts`, `regime`, `Part`, `exists_part`): for
   `δ ≤ δ₀ := min(1/16, 1/(2C_M+1))` (`C_M = log 2 + 2K₀/log 2` the Mertens constant of
   `MertensProof.mertensLowerWith`) and `N ≥ N₀ := ⌈exp exp V₀¹⁰⌉`, `V₀ = max(5329, 151!)`:
   `L = log log N ≥ 5329`, `L¹⁵ ≤ P'₁`, `1000k² ≤ lo ℓ`, `2 lo ℓ ≤ hi ℓ`,
   `log log hi ℓ - log log lo ℓ ≥ 1/δ ≥ 2C_M + 1`, the Mertens mass of every `I_ℓ` is `≥ 1`,
   and `8k(8k+1) ≤ δ⁵ ⌊√P'₁⌋`. `StepBoxes` then partitions every `I_ℓ` (`Part`).
5. **Bad pieces** (`few_weight_le`: Sel (iii), relative weight `≤ (8k+1)/⌊√P'₁⌋`;
   `nonrich_weight_le`: Sel (ii), `≤ 2δ⁶`). Pairs: `bad5_weight_le` (`≤ δ⁵/4 ≤ δ⁴/2`) and
   `bad6_weight_le` (`≤ δ⁵/4 + 4δ⁶ ≤ δ⁵/2`).
6. **The steps** (`pigeon5`, `pigeon6`: the steps for an abstract kernel; `favg_psi_Phi`: Fubini
   for `E_x ψ Φ`; `abs_K_le`: GS (5.11)).
-/

open Finset Real

namespace G22.P51

namespace Pigeon

/- ## 1. Weighted averages with non-negative weights (no `GoodWeights` needed) -/

section wavg
variable {α : Type*} {s : Finset α} {w f g : α → ℝ}

lemma wavg_mono_of_nonneg (hw : ∀ x ∈ s, 0 ≤ w x) (hfg : ∀ x ∈ s, f x ≤ g x) :
    wavg s w f ≤ wavg s w g := by
  unfold wavg
  apply div_le_div_of_nonneg_right _ (Finset.sum_nonneg hw)
  exact Finset.sum_le_sum fun x hx => mul_le_mul_of_nonneg_left (hfg x hx) (hw x hx)

lemma wavg_nonneg_of_nonneg (hw : ∀ x ∈ s, 0 ≤ w x) (hf : ∀ x ∈ s, 0 ≤ f x) :
    0 ≤ wavg s w f := by
  unfold wavg
  exact div_nonneg (Finset.sum_nonneg fun x hx => mul_nonneg (hw x hx) (hf x hx))
    (Finset.sum_nonneg hw)

lemma wavg_le_of_le_of_nonneg (hw : ∀ x ∈ s, 0 ≤ w x) {c : ℝ} (hc : 0 ≤ c)
    (hf : ∀ x ∈ s, f x ≤ c) : wavg s w f ≤ c := by
  unfold wavg
  rcases (Finset.sum_nonneg hw).eq_or_lt with h0 | hpos
  · rw [← h0, div_zero]; exact hc
  · rw [div_le_iff₀ hpos, Finset.mul_sum]
    exact Finset.sum_le_sum fun x hx => by
      rw [mul_comm c]; exact mul_le_mul_of_nonneg_left (hf x hx) (hw x hx)

lemma abs_wavg_le_of_nonneg (hw : ∀ x ∈ s, 0 ≤ w x) {c : ℝ} (hc : 0 ≤ c)
    (hf : ∀ x ∈ s, |f x| ≤ c) : |wavg s w f| ≤ c := by
  have h1 : wavg s w f ≤ c :=
    wavg_le_of_le_of_nonneg hw hc fun x hx => (le_abs_self _).trans (hf x hx)
  have h2 : wavg s w (fun x => -f x) ≤ c :=
    wavg_le_of_le_of_nonneg hw hc fun x hx => (neg_le_abs _).trans (hf x hx)
  rw [wavg_neg] at h2
  exact abs_le.mpr ⟨by linarith, h1⟩

/-- `|E (f g)| ≤ E |f|` for `|g| ≤ 1`. -/
lemma abs_wavg_mul_le (hw : ∀ x ∈ s, 0 ≤ w x) (hg : ∀ x ∈ s, |g x| ≤ 1) :
    |wavg s w (fun x => f x * g x)| ≤ wavg s w (fun x => |f x|) := by
  unfold wavg
  rw [abs_div, abs_of_nonneg (Finset.sum_nonneg hw)]
  apply div_le_div_of_nonneg_right _ (Finset.sum_nonneg hw)
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun x hx => ?_)
  rw [abs_mul, abs_of_nonneg (hw x hx), abs_mul]
  exact mul_le_mul_of_nonneg_left (mul_le_of_le_one_right (abs_nonneg _) (hg x hx)) (hw x hx)

end wavg

lemma lavg_weight_nonneg (B : Finset ℕ) : ∀ s ∈ B, (0 : ℝ) ≤ 1 / (s : ℝ) :=
  fun s _ => by positivity

/-- Linearity of `lavg` for finite linear combinations. -/
lemma lavg_sum_smul (B : Finset ℕ) {ι : Type*} (J : Finset ι) (c : ι → ℝ) (h : ι → ℕ → ℝ) :
    lavg B (fun s => ∑ j ∈ J, c j * h j s) = ∑ j ∈ J, c j * lavg B (h j) := by
  unfold lavg
  rw [wavg_sum]
  exact Finset.sum_congr rfl fun j _ => wavg_smul (c j) (h j)

/-- `(∑_{s∈B} 1/s) · E^log_B F = ∑_{s∈B} F(s)/s` (also for `B = ∅`). -/
lemma mass_mul_lavg (B : Finset ℕ) (hB : ∀ s ∈ B, 0 < s) (F : ℕ → ℝ) :
    (∑ s ∈ B, (1 : ℝ) / s) * lavg B F = ∑ s ∈ B, (1 : ℝ) / s * F s := by
  unfold lavg wavg
  rcases B.eq_empty_or_nonempty with h | h
  · subst h; simp
  · have hpos : 0 < ∑ s ∈ B, (1 : ℝ) / s :=
      Finset.sum_pos (fun s hs => by have := hB s hs; positivity) h
    field_simp

/- ## 2. Boxes of primes and their decomposition into sub-boxes -/

section Boxes

variable {k : ℕ}

lemma sum_boxProd (S : Fin k → Finset ℕ) (hP : ∀ ℓ, ∀ p ∈ S ℓ, p.Prime)
    (hdisj : ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (S ℓ) (S ℓ')) (g : ℕ → ℝ) :
    ∑ s ∈ FPDQ.boxProd S, g s = ∑ a ∈ Fintype.piFinset S, g (∏ ℓ, a ℓ) := by
  unfold FPDQ.boxProd
  exact Finset.sum_image (FPDQ.lemmaC_injOn hP hdisj)

/-- The Mertens mass of a box factorises. -/
lemma mass_boxProd (S : Fin k → Finset ℕ) (hP : ∀ ℓ, ∀ p ∈ S ℓ, p.Prime)
    (hdisj : ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (S ℓ) (S ℓ')) :
    ∑ s ∈ FPDQ.boxProd S, (1 : ℝ) / s = ∏ ℓ, ∑ p ∈ S ℓ, (1 : ℝ) / p := by
  rw [sum_boxProd S hP hdisj, Finset.prod_univ_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Nat.cast_prod]
  simp only [one_div, Finset.prod_inv_distrib]

lemma pos_of_mem_boxProd (S : Fin k → Finset ℕ) (hP : ∀ ℓ, ∀ p ∈ S ℓ, p.Prime) {s : ℕ}
    (hs : s ∈ FPDQ.boxProd S) : 0 < s := by
  unfold FPDQ.boxProd at hs
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hs
  exact Finset.prod_pos fun ℓ _ => (hP ℓ (a ℓ) (Fintype.mem_piFinset.mp ha ℓ)).pos

lemma piFinset_biUnion {ι : Type*} [Fintype ι] [DecidableEq ι] (I : ι → Finset ℕ)
    (T : ι → ℕ → Finset ℕ) :
    Fintype.piFinset (fun ℓ => (I ℓ).biUnion (T ℓ)) =
      (Fintype.piFinset I).biUnion (fun j => Fintype.piFinset (fun ℓ => T ℓ (j ℓ))) := by
  ext a
  simp only [Fintype.mem_piFinset, Finset.mem_biUnion]
  constructor
  · intro h
    choose j hj using h
    exact ⟨j, fun ℓ => (hj ℓ).1, fun ℓ => (hj ℓ).2⟩
  · rintro ⟨j, hj, ha⟩ ℓ
    exact ⟨j ℓ, hj ℓ, ha ℓ⟩

/-- Sums over a box of tuples split over the sub-boxes of tuples. -/
lemma sum_piFinset_decomp {ι : Type*} [Fintype ι] [DecidableEq ι] (S : ι → Finset ℕ)
    (I : ι → Finset ℕ) (T : ι → ℕ → Finset ℕ) (hST : ∀ ℓ, (I ℓ).biUnion (T ℓ) = S ℓ)
    (hT : ∀ ℓ, ∀ i ∈ I ℓ, ∀ i' ∈ I ℓ, i ≠ i' → Disjoint (T ℓ i) (T ℓ i'))
    (g : (ι → ℕ) → ℝ) :
    ∑ a ∈ Fintype.piFinset S, g a =
      ∑ j ∈ Fintype.piFinset I, ∑ a ∈ Fintype.piFinset (fun ℓ => T ℓ (j ℓ)), g a := by
  have hS : S = fun ℓ => (I ℓ).biUnion (T ℓ) := funext fun ℓ => (hST ℓ).symm
  subst hS
  rw [piFinset_biUnion, Finset.sum_biUnion]
  intro j hj j' hj' hne
  change Disjoint (Fintype.piFinset fun ℓ => T ℓ (j ℓ)) (Fintype.piFinset fun ℓ => T ℓ (j' ℓ))
  rw [Finset.disjoint_left]
  intro a ha ha'
  have hj1 := Fintype.mem_piFinset.mp (Finset.mem_coe.mp hj)
  have hj2 := Fintype.mem_piFinset.mp (Finset.mem_coe.mp hj')
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, j ℓ ≠ j' ℓ := by
    by_contra h
    push Not at h
    exact hne (funext h)
  exact Finset.disjoint_left.mp (hT ℓ (j ℓ) (hj1 ℓ) (j' ℓ) (hj2 ℓ) hℓ)
    (Fintype.mem_piFinset.mp ha ℓ) (Fintype.mem_piFinset.mp ha' ℓ)

/-- Relative Mertens mass of the piece `T ℓ i` in the factor `S ℓ`. -/
noncomputable def relW (S : Fin k → Finset ℕ) (T : Fin k → ℕ → Finset ℕ) (ℓ : Fin k) (i : ℕ) :
    ℝ :=
  (∑ p ∈ T ℓ i, (1 : ℝ) / p) / ∑ p ∈ S ℓ, (1 : ℝ) / p

lemma relW_nonneg (S : Fin k → Finset ℕ) (T : Fin k → ℕ → Finset ℕ) (ℓ : Fin k) (i : ℕ) :
    0 ≤ relW S T ℓ i :=
  div_nonneg (Finset.sum_nonneg fun p _ => by positivity)
    (Finset.sum_nonneg fun p _ => by positivity)

lemma sum_relW (S : Fin k → Finset ℕ) (I : Fin k → Finset ℕ) (T : Fin k → ℕ → Finset ℕ)
    (hST : ∀ ℓ, (I ℓ).biUnion (T ℓ) = S ℓ)
    (hT : ∀ ℓ, ∀ i ∈ I ℓ, ∀ i' ∈ I ℓ, i ≠ i' → Disjoint (T ℓ i) (T ℓ i'))
    (hpos : ∀ ℓ, 0 < ∑ p ∈ S ℓ, (1 : ℝ) / p) (ℓ : Fin k) :
    ∑ i ∈ I ℓ, relW S T ℓ i = 1 := by
  unfold relW
  rw [← Finset.sum_div, ← Finset.sum_biUnion (fun i hi i' hi' hne => hT ℓ i hi i' hi' hne),
    hST ℓ, div_self (hpos ℓ).ne']

variable (S : Fin k → Finset ℕ) (hP : ∀ ℓ, ∀ p ∈ S ℓ, p.Prime)
  (hdisj : ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (S ℓ) (S ℓ'))
  (I : Fin k → Finset ℕ) (T : Fin k → ℕ → Finset ℕ) (hST : ∀ ℓ, (I ℓ).biUnion (T ℓ) = S ℓ)
  (hT : ∀ ℓ, ∀ i ∈ I ℓ, ∀ i' ∈ I ℓ, i ≠ i' → Disjoint (T ℓ i) (T ℓ i'))

include hST in
lemma piece_subset {j : Fin k → ℕ} (hj : j ∈ Fintype.piFinset I) (ℓ : Fin k) :
    T ℓ (j ℓ) ⊆ S ℓ := by
  rw [← hST ℓ]
  exact Finset.subset_biUnion_of_mem (T ℓ) (Fintype.mem_piFinset.mp hj ℓ)

include hP hST in
lemma piece_prime {j : Fin k → ℕ} (hj : j ∈ Fintype.piFinset I) :
    ∀ ℓ, ∀ p ∈ T ℓ (j ℓ), p.Prime :=
  fun ℓ p hp => hP ℓ p (piece_subset S I T hST hj ℓ hp)

include hdisj hST in
lemma piece_disj {j : Fin k → ℕ} (hj : j ∈ Fintype.piFinset I) :
    ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (T ℓ (j ℓ)) (T ℓ' (j ℓ')) :=
  fun ℓ ℓ' h => (hdisj ℓ ℓ' h).mono (piece_subset S I T hST hj ℓ) (piece_subset S I T hST hj ℓ')

include hP hdisj hST hT in
/-- **Decomposition** of a logarithmic average over a box into the sub-boxes. -/
theorem lavg_decomp (F : ℕ → ℝ) :
    lavg (FPDQ.boxProd S) F = ∑ j ∈ Fintype.piFinset I,
      (∏ ℓ, relW S T ℓ (j ℓ)) * lavg (FPDQ.boxProd fun ℓ => T ℓ (j ℓ)) F := by
  have hnum : ∑ s ∈ FPDQ.boxProd S, (1 : ℝ) / s * F s =
      ∑ j ∈ Fintype.piFinset I, ∑ s ∈ FPDQ.boxProd (fun ℓ => T ℓ (j ℓ)), (1 : ℝ) / s * F s := by
    rw [sum_boxProd S hP hdisj, sum_piFinset_decomp S I T hST hT]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [sum_boxProd _ (piece_prime S hP I T hST hj) (piece_disj S hdisj I T hST hj)]
  have hL : lavg (FPDQ.boxProd S) F =
      (∑ s ∈ FPDQ.boxProd S, (1 : ℝ) / s * F s) / ∑ s ∈ FPDQ.boxProd S, (1 : ℝ) / s := rfl
  rw [hL, hnum, mass_boxProd S hP hdisj, Finset.sum_div]
  refine Finset.sum_congr rfl fun j hj => ?_
  unfold relW
  rw [Finset.prod_div_distrib,
    ← mass_boxProd _ (piece_prime S hP I T hST hj) (piece_disj S hdisj I T hST hj),
    div_mul_eq_mul_div,
    mass_mul_lavg _ (fun s hs => pos_of_mem_boxProd _ (piece_prime S hP I T hST hj) hs)]

include hP hdisj hST hT in
/-- **Decomposition** of a double logarithmic average over pairs of sub-boxes. -/
theorem lavg_lavg_decomp (K : ℕ → ℕ → ℝ) :
    lavg (FPDQ.boxProd S) (fun s => lavg (FPDQ.boxProd S) (fun t => K s t)) =
      ∑ jj ∈ Fintype.piFinset I ×ˢ Fintype.piFinset I,
        ((∏ ℓ, relW S T ℓ (jj.1 ℓ)) * (∏ ℓ, relW S T ℓ (jj.2 ℓ))) *
          lavg (FPDQ.boxProd fun ℓ => T ℓ (jj.1 ℓ))
            (fun s => lavg (FPDQ.boxProd fun ℓ => T ℓ (jj.2 ℓ)) (fun t => K s t)) := by
  have hin : ∀ s, lavg (FPDQ.boxProd S) (fun t => K s t) = ∑ j' ∈ Fintype.piFinset I,
      (∏ ℓ, relW S T ℓ (j' ℓ)) * lavg (FPDQ.boxProd fun ℓ => T ℓ (j' ℓ)) (fun t => K s t) :=
    fun s => lavg_decomp S hP hdisj I T hST hT _
  simp_rw [hin]
  rw [lavg_decomp S hP hdisj I T hST hT, Finset.sum_product]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [lavg_sum_smul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun j' _ => by ring

end Boxes

/- ## 3. Pigeonhole over pairs of sub-boxes -/

section Pigeonhole

variable {k : ℕ} (S : Fin k → Finset ℕ) (hP : ∀ ℓ, ∀ p ∈ S ℓ, p.Prime)
  (hdisj : ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (S ℓ) (S ℓ'))
  (I : Fin k → Finset ℕ) (T : Fin k → ℕ → Finset ℕ) (hST : ∀ ℓ, (I ℓ).biUnion (T ℓ) = S ℓ)
  (hT : ∀ ℓ, ∀ i ∈ I ℓ, ∀ i' ∈ I ℓ, i ≠ i' → Disjoint (T ℓ i) (T ℓ i'))
  (hpos : ∀ ℓ, 0 < ∑ p ∈ S ℓ, (1 : ℝ) / p)

include hP hdisj hST hT hpos in
/-- **Pigeonhole over pairs of sub-boxes** (`FPDQ.lemmaPH` with the product weights of
`lavg_lavg_decomp`, the bad pairs bounded by `FPDQ.prod_weight_bad_pair`). -/
theorem pigeon_pairs (K : ℕ → ℕ → ℝ) {MF α : ℝ} (hMF : 0 < MF) (hα : 0 < α)
    (hK : ∀ j ∈ Fintype.piFinset I, ∀ j' ∈ Fintype.piFinset I,
      |lavg (FPDQ.boxProd fun ℓ => T ℓ (j ℓ))
        (fun s => lavg (FPDQ.boxProd fun ℓ => T ℓ (j' ℓ)) (fun t => K s t))| ≤ MF)
    (hE : α ≤ |lavg (FPDQ.boxProd S) (fun s => lavg (FPDQ.boxProd S) (fun t => K s t))|)
    (bad : Fin k → ℕ → Prop) [∀ ℓ, DecidablePred (bad ℓ)]
    (hbad : 2 * ∑ ℓ, ∑ i ∈ (I ℓ).filter (bad ℓ), relW S T ℓ i ≤ α / (2 * MF)) :
    ∃ j ∈ Fintype.piFinset I, ∃ j' ∈ Fintype.piFinset I,
      (∀ ℓ, ¬ bad ℓ (j ℓ)) ∧ (∀ ℓ, ¬ bad ℓ (j' ℓ)) ∧
      α / 2 ≤ |lavg (FPDQ.boxProd fun ℓ => T ℓ (j ℓ))
        (fun s => lavg (FPDQ.boxProd fun ℓ => T ℓ (j' ℓ)) (fun t => K s t))| := by
  have hw1 : ∀ ℓ, ∑ i ∈ I ℓ, relW S T ℓ i = 1 := sum_relW S I T hST hT hpos
  have hW1 : ∑ j ∈ Fintype.piFinset I, ∏ ℓ, relW S T ℓ (j ℓ) = 1 :=
    FPDQ.sum_prod_weight I (relW S T) hw1
  have hwpair : ∑ jj ∈ Fintype.piFinset I ×ˢ Fintype.piFinset I,
      (∏ ℓ, relW S T ℓ (jj.1 ℓ)) * (∏ ℓ, relW S T ℓ (jj.2 ℓ)) = 1 := by
    rw [Finset.sum_product]
    dsimp only
    rw [← Finset.sum_mul_sum, hW1, one_mul]
  have hw0 : ∀ jj ∈ Fintype.piFinset I ×ˢ Fintype.piFinset I,
      0 ≤ (∏ ℓ, relW S T ℓ (jj.1 ℓ)) * (∏ ℓ, relW S T ℓ (jj.2 ℓ)) := fun jj _ =>
    mul_nonneg (Finset.prod_nonneg fun ℓ _ => relW_nonneg S T ℓ _)
      (Finset.prod_nonneg fun ℓ _ => relW_nonneg S T ℓ _)
  rw [lavg_lavg_decomp S hP hdisj I T hST hT K] at hE
  have hbad' := FPDQ.prod_weight_bad_pair I (relW S T) (fun ℓ i _ => relW_nonneg S T ℓ i) hw1 bad
  have hbad2 : ∑ jj ∈ (Fintype.piFinset I ×ˢ Fintype.piFinset I).filter
      (fun jj => (∃ ℓ, bad ℓ (jj.1 ℓ)) ∨ (∃ ℓ, bad ℓ (jj.2 ℓ))),
      (∏ ℓ, relW S T ℓ (jj.1 ℓ)) * (∏ ℓ, relW S T ℓ (jj.2 ℓ)) ≤ α / (2 * MF) := by
    refine le_trans (le_of_eq ?_) (hbad'.trans hbad)
    congr
  obtain ⟨⟨j, j'⟩, hjj, hnb, -, hF⟩ := FPDQ.lemmaPH (Fintype.piFinset I ×ˢ Fintype.piFinset I)
    (fun jj => (∏ ℓ, relW S T ℓ (jj.1 ℓ)) * (∏ ℓ, relW S T ℓ (jj.2 ℓ)))
    (fun jj => lavg (FPDQ.boxProd fun ℓ => T ℓ (jj.1 ℓ))
      (fun s => lavg (FPDQ.boxProd fun ℓ => T ℓ (jj.2 ℓ)) (fun t => K s t)))
    hw0 hwpair hMF (fun jj hjj => hK jj.1 (Finset.mem_product.mp hjj).1 jj.2
      (Finset.mem_product.mp hjj).2) hα hE
    (fun jj => (∃ ℓ, bad ℓ (jj.1 ℓ)) ∨ (∃ ℓ, bad ℓ (jj.2 ℓ))) hbad2
  obtain ⟨hj, hj'⟩ := Finset.mem_product.mp hjj
  simp only [not_or, not_exists] at hnb
  exact ⟨j, hj, j', hj', hnb.1, hnb.2, hF⟩

end Pigeonhole

/- ## 4. Logarithmic versus uniform averages on a box -/

/-- On a set of integers in `[Y, 2Y]`, `E^log h ≤ 2 E h` for `h ≥ 0`. -/
lemma lavg_le_two_favg {B : Finset ℕ} {Y : ℝ} (hY : 0 < Y)
    (hB : ∀ s ∈ B, Y ≤ (s : ℝ) ∧ (s : ℝ) ≤ 2 * Y) {h : ℕ → ℝ} (hh : ∀ s ∈ B, 0 ≤ h s) :
    lavg B h ≤ 2 * favg B h := by
  unfold lavg favg wavg
  rcases B.eq_empty_or_nonempty with hB0 | hne
  · subst hB0; simp
  have hs0 : ∀ s ∈ B, (0 : ℝ) < s := fun s hs => hY.trans_le (hB s hs).1
  have hZ : (B.card : ℝ) / (2 * Y) ≤ ∑ s ∈ B, (1 : ℝ) / s := by
    have e : ∑ s ∈ B, (1 : ℝ) / (2 * Y) = (B.card : ℝ) / (2 * Y) := by
      rw [Finset.sum_const, nsmul_eq_mul]; ring
    rw [← e]
    exact Finset.sum_le_sum fun s hs => one_div_le_one_div_of_le (hs0 s hs) (hB s hs).2
  have hA : ∑ s ∈ B, (1 : ℝ) / s * h s ≤ (∑ s ∈ B, (1 : ℝ) * h s) / Y := by
    rw [Finset.sum_div]
    refine Finset.sum_le_sum fun s hs => ?_
    rw [one_mul, one_div_mul_eq_div]
    exact div_le_div_of_nonneg_left (hh s hs) hY (hB s hs).1
  have hcard : (0 : ℝ) < B.card := by exact_mod_cast Finset.card_pos.mpr hne
  have hsum1 : ∑ _s ∈ B, (1 : ℝ) = B.card := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
  have hZpos : 0 < ∑ s ∈ B, (1 : ℝ) / s := lt_of_lt_of_le (by positivity) hZ
  have hH : 0 ≤ ∑ s ∈ B, (1 : ℝ) * h s :=
    Finset.sum_nonneg fun s hs => by rw [one_mul]; exact hh s hs
  rw [hsum1, div_le_iff₀ hZpos]
  calc ∑ s ∈ B, (1 : ℝ) / s * h s ≤ (∑ s ∈ B, (1 : ℝ) * h s) / Y := hA
    _ = 2 * ((∑ s ∈ B, (1 : ℝ) * h s) / B.card) * ((B.card : ℝ) / (2 * Y)) := by
        field_simp
    _ ≤ 2 * ((∑ s ∈ B, (1 : ℝ) * h s) / B.card) * ∑ s ∈ B, (1 : ℝ) / s := by
        apply mul_le_mul_of_nonneg_left hZ
        positivity

/-- A box with ratios `b ℓ ≤ (1 + 1/(4k)) a ℓ` lies in `[Y, 2Y]`, `Y = ∏ a ℓ`. -/
lemma box_bounds {k : ℕ} (hk : 1 ≤ k) (a b : Fin k → ℕ)
    (hab : ∀ ℓ, 4 * k * b ℓ ≤ (4 * k + 1) * a ℓ) {s : ℕ} (hs : s ∈ almostPrimes a b) :
    ((∏ ℓ, a ℓ : ℕ) : ℝ) ≤ s ∧ (s : ℝ) ≤ 2 * ((∏ ℓ, a ℓ : ℕ) : ℝ) := by
  unfold almostPrimes FPDQ.boxProd at hs
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hs
  have hf' : ∀ ℓ, a ℓ ≤ f ℓ ∧ f ℓ < b ℓ := fun ℓ => by
    have := Fintype.mem_piFinset.mp hf ℓ
    simp only [primesIn, Finset.mem_filter, Finset.mem_Ico] at this
    exact this.1
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have h4k : (0 : ℝ) < 4 * k := by positivity
  push_cast
  constructor
  · exact Finset.prod_le_prod (fun ℓ _ => by positivity)
      (fun ℓ _ => by exact_mod_cast (hf' ℓ).1)
  · have hb : ∀ ℓ, (b ℓ : ℝ) ≤ (1 + 1 / (4 * (k : ℝ))) * a ℓ := by
      intro ℓ
      have h1 : ((4 * k * b ℓ : ℕ) : ℝ) ≤ (((4 * k + 1) * a ℓ : ℕ) : ℝ) := by
        exact_mod_cast hab ℓ
      push_cast at h1
      have h2 : (b ℓ : ℝ) - a ℓ ≤ a ℓ / (4 * k) := by
        rw [le_div_iff₀ h4k]; linarith
      calc (b ℓ : ℝ) = a ℓ + (b ℓ - a ℓ) := by ring
        _ ≤ a ℓ + a ℓ / (4 * k) := by linarith
        _ = (1 + 1 / (4 * (k : ℝ))) * a ℓ := by ring
    calc ∏ ℓ, (f ℓ : ℝ) ≤ ∏ ℓ, (b ℓ : ℝ) :=
          Finset.prod_le_prod (fun ℓ _ => by positivity)
            (fun ℓ _ => by exact_mod_cast (hf' ℓ).2.le)
      _ ≤ ∏ ℓ, ((1 + 1 / (4 * (k : ℝ))) * a ℓ) :=
          Finset.prod_le_prod (fun ℓ _ => by positivity) (fun ℓ _ => hb ℓ)
      _ = (1 + 1 / (4 * (k : ℝ))) ^ k * ∏ ℓ, (a ℓ : ℝ) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ ≤ 2 * ∏ ℓ, (a ℓ : ℝ) := by
          apply mul_le_mul_of_nonneg_right (FPDQ.one_add_pow_lt_two hk le_rfl).le
          positivity

/-- Logarithmic → uniform weights on two boxes in `[Yᵢ, 2Yᵢ]`, for `G ≥ 0`: factor `≤ 4`. -/
lemma lavg_lavg_le_four_favg {B₁ B₂ : Finset ℕ} {Y₁ Y₂ : ℝ} (hY₁ : 0 < Y₁) (hY₂ : 0 < Y₂)
    (hB₁ : ∀ s ∈ B₁, Y₁ ≤ (s : ℝ) ∧ (s : ℝ) ≤ 2 * Y₁)
    (hB₂ : ∀ s ∈ B₂, Y₂ ≤ (s : ℝ) ∧ (s : ℝ) ≤ 2 * Y₂)
    {G : ℕ → ℕ → ℝ} (hG : ∀ s t, 0 ≤ G s t) :
    lavg B₁ (fun s => lavg B₂ (fun t => G s t)) ≤
      4 * favg B₁ (fun s => favg B₂ (fun t => G s t)) := by
  calc lavg B₁ (fun s => lavg B₂ (fun t => G s t))
      ≤ lavg B₁ (fun s => 2 * favg B₂ (fun t => G s t)) :=
        wavg_mono_of_nonneg (lavg_weight_nonneg B₁) fun s _ =>
          lavg_le_two_favg hY₂ hB₂ fun t _ => hG s t
    _ = 2 * lavg B₁ (fun s => favg B₂ (fun t => G s t)) := wavg_smul 2 _
    _ ≤ 2 * (2 * favg B₁ (fun s => favg B₂ (fun t => G s t))) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        exact lavg_le_two_favg hY₁ hB₁ fun s _ =>
          wavg_nonneg_of_nonneg (fun _ _ => zero_le_one) fun t _ => hG s t
    _ = 4 * favg B₁ (fun s => favg B₂ (fun t => G s t)) := by ring

/- ## 5. The factors of `𝒫'`, constants, and the regime `δ ≤ δ₀`, `N ≥ N₀` -/

/-- The factors `primes ∩ I_ℓ` of `𝒫'`. -/
def Sf (D : Data) : Fin D.k → Finset ℕ := fun ℓ => primesIn (D.lo ℓ.castSucc) (D.hi ℓ.castSucc)

lemma Sf_prime (D : Data) : ∀ ℓ, ∀ p ∈ Sf D ℓ, p.Prime :=
  fun _ _ hp => (Finset.mem_filter.mp hp).2

lemma Sf_disj (D : Data) : ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (Sf D ℓ) (Sf D ℓ') := by
  intro ℓ ℓ' hne
  rw [Finset.disjoint_left]
  intro p hp hp'
  simp only [Sf, primesIn, Finset.mem_filter, Finset.mem_Ico] at hp hp'
  rcases D.hdisj ℓ ℓ' hne with h | h <;> omega

lemma Pp_eq (D : Data) : D.Pp = FPDQ.boxProd (Sf D) := rfl

/-- The Mertens constant of `MertensProof.mertensLowerWith`. -/
noncomputable def CM : ℝ := Real.log 2 + 2 * (MertensProof.K₀ / Real.log 2)

lemma CM_nonneg : 0 ≤ CM := by
  unfold CM
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have := MertensProof.K₀_nonneg
  positivity

lemma mertens : MertensLowerWith CM := MertensProof.mertensLowerWith

/-- The threshold `δ₀ = min(1/16, 1/(2C_M + 1))` of both steps. -/
noncomputable def pδ₀ : ℝ := min (1 / 16) (1 / (2 * CM + 1))

lemma pδ₀_pos : 0 < pδ₀ := lt_min (by norm_num) (by have := CM_nonneg; positivity)

/-- `V₀ = max(5329, 151!)` (`151 = 10·15 + 1`). -/
noncomputable def pV₀ : ℝ := max 5329 ((10 * 15 + 1).factorial : ℝ)

/-- The threshold `N₀ = ⌈exp exp V₀¹⁰⌉` of both steps. -/
noncomputable def pN₀ : ℕ := ⌈Real.exp (Real.exp (pV₀ ^ 10))⌉₊

/-- `N ≥ N₀` gives `L = log log N ≥ 5329` and `L¹⁵ ≤ P'₁` (via `log log P'₁ ≥ L^{1/10}`). -/
lemma growth (D : Data) (hN : pN₀ ≤ D.N) :
    5329 ≤ Real.log (Real.log D.N) ∧ Real.log (Real.log D.N) ^ 15 ≤ D.P₁' := by
  have hV1 : (5329 : ℝ) ≤ pV₀ := le_max_left _ _
  have hVf : ((10 * 15 + 1).factorial : ℝ) ≤ pV₀ := le_max_right _ _
  have hV0 : 0 ≤ pV₀ := by linarith
  have hNr : Real.exp (Real.exp (pV₀ ^ 10)) ≤ D.N :=
    le_trans (Nat.le_ceil _) (by exact_mod_cast hN)
  have h1 : Real.exp (pV₀ ^ 10) ≤ Real.log D.N := by
    rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) hNr)]; exact hNr
  have ht : pV₀ ^ 10 ≤ Real.log (Real.log D.N) := by
    rw [Real.le_log_iff_exp_le (lt_of_lt_of_le (Real.exp_pos _) h1)]; exact h1
  have hVV : pV₀ ≤ pV₀ ^ 10 := le_self_pow₀ (by linarith) (by norm_num)
  have hL0 : 0 ≤ Real.log (Real.log D.N) := le_trans (by positivity) ht
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact_mod_cast (show 0 < D.P₁' by omega)
  have hlog1 := one_lt_log_of_three_le D.hP₁'
  have hu0 : 0 < Real.log (Real.log D.P₁') := Real.log_pos hlog1
  have huV : pV₀ ≤ Real.log (Real.log D.P₁') :=
    (pow_le_pow_iff_left₀ hV0 hu0.le (by norm_num : (10 : ℕ) ≠ 0)).mp (le_trans ht D.hP₁'N)
  refine ⟨by linarith, ?_⟩
  calc Real.log (Real.log D.N) ^ 15 ≤ (Real.log (Real.log D.P₁') ^ 10) ^ 15 :=
        pow_le_pow_left₀ hL0 D.hP₁'N 15
    _ = Real.log (Real.log D.P₁') ^ (10 * 15) := by rw [← pow_mul]
    _ ≤ Real.exp (Real.log (Real.log D.P₁')) :=
        pow_le_exp_of_factorial_le (10 * 15) (le_trans hVf huV)
    _ = Real.log D.P₁' := Real.exp_log (by linarith)
    _ ≤ D.P₁' := Real.log_le_self hP₁'pos.le

/-- From the width condition of `Data` (with `k δ^{-5} ≥ 1/δ ≥ 1`): `2 lo ℓ ≤ hi ℓ` and
`log log hi ℓ - log log lo ℓ ≥ 1/δ`. -/
lemma width_facts (D : Data) (hδ1 : 1 ≤ 1 / D.δ) (ℓ : Fin D.k) :
    2 * D.lo ℓ.castSucc ≤ D.hi ℓ.castSucc ∧
      1 / D.δ ≤ Real.log (Real.log (D.hi ℓ.castSucc)) - Real.log (Real.log (D.lo ℓ.castSucc)) := by
  obtain ⟨hPlo, hlohi, -⟩ := D.hI ℓ
  have hw := D.hwidth ℓ
  have hlo3 : 3 ≤ D.lo ℓ.castSucc := le_trans D.hP₁' hPlo
  have hkd : 1 / D.δ ≤ D.k * (1 / D.δ) ^ 5 := by
    have hk1 : (1 : ℝ) ≤ D.k := by exact_mod_cast D.hk
    have h4 : (1 : ℝ) ≤ (1 / D.δ) ^ 4 := one_le_pow₀ hδ1
    have h0 : (0 : ℝ) ≤ 1 / D.δ := by linarith
    calc 1 / D.δ = 1 * ((1 / D.δ) * 1) := by ring
      _ ≤ D.k * ((1 / D.δ) * (1 / D.δ) ^ 4) :=
          mul_le_mul hk1 (mul_le_mul_of_nonneg_left h4 h0) (by positivity) (by linarith)
      _ = D.k * (1 / D.δ) ^ 5 := by ring
  have hA3 : (3 : ℝ) ≤ (D.lo ℓ.castSucc : ℝ) := by exact_mod_cast hlo3
  have hAH : (D.lo ℓ.castSucc : ℝ) + 1 ≤ (D.hi ℓ.castSucc : ℝ) := by exact_mod_cast hlohi
  have hlogA : 1 < Real.log (D.lo ℓ.castSucc) := one_lt_log_of_three_le hlo3
  have hlogH1 : 0 < Real.log ((D.hi ℓ.castSucc : ℝ) - 1) := Real.log_pos (by linarith)
  have hllH1 : Real.log (Real.log ((D.hi ℓ.castSucc : ℝ) - 1)) ≤
      Real.log (Real.log (D.hi ℓ.castSucc)) :=
    Real.log_le_log hlogH1 (Real.log_le_log (by linarith) (by linarith))
  constructor
  · have hkey : 2 * Real.log (D.lo ℓ.castSucc) ≤ Real.log ((D.hi ℓ.castSucc : ℝ) - 1) := by
      by_contra hlt
      push Not at hlt
      have h1 := Real.log_lt_log hlogH1 hlt
      rw [Real.log_mul (by norm_num) (ne_of_gt (by linarith))] at h1
      have := Real.log_two_lt_d9
      norm_num at this
      linarith
    have hsq : (D.lo ℓ.castSucc : ℝ) ^ 2 ≤ (D.hi ℓ.castSucc : ℝ) - 1 := by
      rw [← Real.log_le_log_iff (pow_pos (by linarith) 2) (by linarith), Real.log_pow]
      push_cast
      linarith
    have h2 : (2 * D.lo ℓ.castSucc : ℝ) ≤ D.hi ℓ.castSucc := by
      nlinarith [mul_le_mul_of_nonneg_left hA3 (by linarith : (0 : ℝ) ≤ D.lo ℓ.castSucc)]
    exact_mod_cast h2
  · linarith

/-- The consequences of `δ ≤ δ₀` and `N ≥ N₀` used for both steps. -/
structure Regime (D : Data) : Prop where
  hδ16 : 16 ≤ 1 / D.δ
  hlo3 : ∀ ℓ : Fin D.k, 3 ≤ D.lo ℓ.castSucc
  hloP : ∀ ℓ : Fin D.k, D.P₁' ≤ D.lo ℓ.castSucc
  hbig : ∀ ℓ : Fin D.k, 1000 * D.k ^ 2 ≤ D.lo ℓ.castSucc
  htwo : ∀ ℓ : Fin D.k, 2 * D.lo ℓ.castSucc ≤ D.hi ℓ.castSucc
  hwide : ∀ ℓ : Fin D.k, 2 * CM ≤
    Real.log (Real.log (D.hi ℓ.castSucc)) - Real.log (Real.log (D.lo ℓ.castSucc))
  hmass : ∀ ℓ : Fin D.k, 1 ≤ ∑ p ∈ Sf D ℓ, (1 : ℝ) / p
  hsq1 : 1 ≤ Nat.sqrt D.P₁'
  hsmall : 8 * (D.k : ℝ) * (8 * D.k + 1) ≤ D.δ ^ 5 * Nat.sqrt D.P₁'

/-- `δ ≤ δ₀` and `N ≥ N₀` imply the `Regime`. -/
lemma regime (D : Data) (hδ : D.δ ≤ pδ₀) (hN : pN₀ ≤ D.N) : Regime D := by
  have hCM := CM_nonneg
  have hδ16 : 16 ≤ 1 / D.δ := by
    rw [le_div_iff₀ D.hδ]
    have : D.δ ≤ 1 / 16 := hδ.trans (min_le_left _ _)
    linarith
  have hδCM : 2 * CM + 1 ≤ 1 / D.δ := by
    rw [le_div_iff₀ D.hδ]
    have h : D.δ ≤ 1 / (2 * CM + 1) := hδ.trans (min_le_right _ _)
    rw [le_div_iff₀ (by linarith)] at h
    linarith
  have hδ1 : 1 ≤ 1 / D.δ := by linarith
  obtain ⟨hL, hLP⟩ := growth D hN
  have hkL : (D.k : ℝ) ≤ Real.log (Real.log D.N) := D.hkN
  have hδL : 1 / D.δ ≤ Real.log (Real.log D.N) := D.hδN
  have hk1 : (1 : ℝ) ≤ D.k := by exact_mod_cast D.hk
  have hP3 : 3 ≤ D.P₁' := D.hP₁'
  have hwf := width_facts D hδ1
  refine ⟨hδ16, fun ℓ => le_trans hP3 (D.hI ℓ).1, fun ℓ => (D.hI ℓ).1, ?_, fun ℓ => (hwf ℓ).1,
    ?_, ?_, Nat.sqrt_pos.mpr (by omega), ?_⟩
  · -- `1000 k² ≤ 1000 L² ≤ L¹⁵ ≤ P'₁ ≤ lo ℓ`
    intro ℓ
    have hL1 : (1 : ℝ) ≤ Real.log (Real.log D.N) := by linarith
    have h13 : (1000 : ℝ) ≤ Real.log (Real.log D.N) ^ 13 :=
      le_trans (by linarith) (le_self_pow₀ hL1 (by norm_num))
    have h1 : 1000 * (D.k : ℝ) ^ 2 ≤ D.lo ℓ.castSucc := by
      calc 1000 * (D.k : ℝ) ^ 2 ≤ 1000 * Real.log (Real.log D.N) ^ 2 := by
            gcongr
        _ ≤ Real.log (Real.log D.N) ^ 13 * Real.log (Real.log D.N) ^ 2 := by
            gcongr
        _ = Real.log (Real.log D.N) ^ 15 := by ring
        _ ≤ D.P₁' := hLP
        _ ≤ D.lo ℓ.castSucc := by exact_mod_cast (D.hI ℓ).1
    exact_mod_cast h1
  · intro ℓ
    linarith [(hwf ℓ).2]
  · intro ℓ
    have hm := mertens (D.lo ℓ.castSucc) (D.hi ℓ.castSucc) (le_trans hP3 (D.hI ℓ).1)
      (D.hI ℓ).2.1.le
    show 1 ≤ ∑ p ∈ primesIn (D.lo ℓ.castSucc) (D.hi ℓ.castSucc), (1 : ℝ) / p
    linarith [(hwf ℓ).2]
  · -- `8k(8k+1) ≤ 72 L² ≤ δ⁵ · 72 L⁷ ≤ δ⁵ ⌊√P'₁⌋`
    set L := Real.log (Real.log D.N) with hLdef
    have hL1 : (1 : ℝ) ≤ L := by linarith
    have hs : 72 * L ^ 7 ≤ (Nat.sqrt D.P₁' : ℝ) := by
      have hL7 : (1 : ℝ) ≤ L ^ 7 := one_le_pow₀ hL1
      have hn1 : (⌈72 * L ^ 7⌉₊ : ℝ) < 72 * L ^ 7 + 1 := Nat.ceil_lt_add_one (by positivity)
      have hn2 : (⌈72 * L ^ 7⌉₊ : ℝ) ≤ 73 * L ^ 7 := by linarith
      have hn0 : (0 : ℝ) ≤ ⌈72 * L ^ 7⌉₊ := Nat.cast_nonneg _
      have hnn : ((⌈72 * L ^ 7⌉₊ * ⌈72 * L ^ 7⌉₊ : ℕ) : ℝ) ≤ D.P₁' := by
        push_cast
        calc (⌈72 * L ^ 7⌉₊ : ℝ) * ⌈72 * L ^ 7⌉₊ ≤ (73 * L ^ 7) * (73 * L ^ 7) :=
              mul_le_mul hn2 hn2 hn0 (by positivity)
          _ = 5329 * L ^ 14 := by ring
          _ ≤ L * L ^ 14 := by gcongr
          _ = L ^ 15 := by ring
          _ ≤ D.P₁' := hLP
      have hle : ⌈72 * L ^ 7⌉₊ ≤ Nat.sqrt D.P₁' := Nat.le_sqrt.mpr (by exact_mod_cast hnn)
      calc 72 * L ^ 7 ≤ (⌈72 * L ^ 7⌉₊ : ℝ) := Nat.le_ceil _
        _ ≤ Nat.sqrt D.P₁' := by exact_mod_cast hle
    have h1 : 8 * (D.k : ℝ) * (8 * D.k + 1) ≤ 72 * L ^ 2 := by
      nlinarith [mul_le_mul hkL hkL (by linarith) (by linarith),
        mul_le_mul_of_nonneg_left hL1 (by linarith : (0 : ℝ) ≤ L)]
    have hδL' : 1 ≤ D.δ * L := by
      have h := hδL
      rw [div_le_iff₀ D.hδ] at h
      linarith
    have h2 : 72 * L ^ 2 ≤ D.δ ^ 5 * (72 * L ^ 7) := by
      have h5 : (1 : ℝ) ≤ (D.δ * L) ^ 5 := one_le_pow₀ hδL'
      calc 72 * L ^ 2 = 72 * L ^ 2 * 1 := by ring
        _ ≤ 72 * L ^ 2 * (D.δ * L) ^ 5 :=
            mul_le_mul_of_nonneg_left h5 (by positivity)
        _ = D.δ ^ 5 * (72 * L ^ 7) := by ring
    calc 8 * (D.k : ℝ) * (8 * D.k + 1) ≤ 72 * L ^ 2 := h1
      _ ≤ D.δ ^ 5 * (72 * L ^ 7) := h2
      _ ≤ D.δ ^ 5 * Nat.sqrt D.P₁' := mul_le_mul_of_nonneg_left hs (pow_nonneg D.hδ.le 5)

lemma Sf_mass_pos {D : Data} (hR : Regime D) : ∀ ℓ, 0 < ∑ p ∈ Sf D ℓ, (1 : ℝ) / p :=
  fun ℓ => lt_of_lt_of_le one_pos (hR.hmass ℓ)

/- ## 6. The subdyadic partition of the intervals `I_ℓ` -/

/-- Monotonicity of a sequence with monotone steps. -/
lemma mono_pieces (c : ℕ → ℕ) (m : ℕ) (hc : ∀ i < m, c i ≤ c (i + 1)) :
    ∀ i j, i ≤ j → j ≤ m → c i ≤ c j := by
  intro i j hij hjm
  induction j with
  | zero => rw [Nat.le_zero.mp hij]
  | succ n ih =>
    rcases Nat.lt_or_ge i (n + 1) with h | h
    · exact (ih (by omega) (by omega)).trans (hc n (by omega))
    · rw [show i = n + 1 by omega]

lemma primesIn_union {A B C : ℕ} (hAB : A ≤ B) (hBC : B ≤ C) :
    primesIn A B ∪ primesIn B C = primesIn A C := by
  unfold primesIn
  rw [← Finset.filter_union, Finset.Ico_union_Ico_eq_Ico hAB hBC]

lemma biUnion_pieces (c : ℕ → ℕ) (m : ℕ) (hc : ∀ i < m, c i ≤ c (i + 1)) :
    (Finset.range m).biUnion (fun i => primesIn (c i) (c (i + 1))) = primesIn (c 0) (c m) := by
  induction m with
  | zero => simp [primesIn]
  | succ m ih =>
    rw [Finset.range_add_one, Finset.biUnion_insert, ih (fun i hi => hc i (by omega)),
      Finset.union_comm,
      primesIn_union (mono_pieces c (m + 1) hc 0 m (by omega) (by omega)) (hc m (by omega))]

lemma disjoint_pieces (c : ℕ → ℕ) (m : ℕ) (hc : ∀ i < m, c i ≤ c (i + 1)) :
    ∀ i ∈ Finset.range m, ∀ i' ∈ Finset.range m, i ≠ i' →
      Disjoint (primesIn (c i) (c (i + 1))) (primesIn (c i') (c (i' + 1))) := by
  intro i hi i' hi' hne
  rw [Finset.disjoint_left]
  intro p hp hp'
  simp only [primesIn, Finset.mem_filter, Finset.mem_Ico] at hp hp'
  have hi := Finset.mem_range.mp hi
  have hi' := Finset.mem_range.mp hi'
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · have := mono_pieces c m hc (i + 1) i' (by omega) (by omega)
    omega
  · have := mono_pieces c m hc (i' + 1) i (by omega) (by omega)
    omega

/-- A subdyadic partition of all the intervals `I_ℓ = [lo ℓ, hi ℓ)`, `ℓ < k` (`StepBoxes`). -/
structure Part (D : Data) where
  m : Fin D.k → ℕ
  c : Fin D.k → ℕ → ℕ
  h0 : ∀ ℓ, c ℓ 0 = D.lo ℓ.castSucc
  hm : ∀ ℓ, c ℓ (m ℓ) = D.hi ℓ.castSucc
  hlow : ∀ ℓ, ∀ i < m ℓ, (8 * D.k + 1) * c ℓ i ≤ 8 * D.k * c ℓ (i + 1)
  hup : ∀ ℓ, ∀ i < m ℓ, 4 * D.k * c ℓ (i + 1) ≤ (4 * D.k + 1) * c ℓ i

lemma exists_part (hB : StepBoxes) (D : Data) (hR : Regime D) : Nonempty (Part D) := by
  have h := fun ℓ : Fin D.k =>
    hB D.k (D.lo ℓ.castSucc) (D.hi ℓ.castSucc) D.hk (hR.hbig ℓ) (hR.htwo ℓ)
  choose m c _ h0 hm hstep using h
  exact ⟨⟨m, c, h0, hm, fun ℓ i hi => (hstep ℓ i hi).1, fun ℓ i hi => (hstep ℓ i hi).2⟩⟩

namespace Part

variable {D : Data} (P : Part D)

/-- The index sets `[0, m ℓ)`. -/
def I : Fin D.k → Finset ℕ := fun ℓ => Finset.range (P.m ℓ)

/-- The pieces `primes ∩ [c ℓ i, c ℓ (i+1))`. -/
def T : Fin D.k → ℕ → Finset ℕ := fun ℓ i => primesIn (P.c ℓ i) (P.c ℓ (i + 1))

lemma mono (ℓ : Fin D.k) : ∀ i < P.m ℓ, P.c ℓ i ≤ P.c ℓ (i + 1) := by
  intro i hi
  have h := P.hlow ℓ i hi
  have hk := D.hk
  have h1 : 8 * D.k * P.c ℓ i ≤ 8 * D.k * P.c ℓ (i + 1) :=
    le_trans (Nat.mul_le_mul_right _ (by omega)) h
  exact Nat.le_of_mul_le_mul_left h1 (by omega)

lemma c_lt (ℓ : Fin D.k) {i : ℕ} (hi : i < P.m ℓ) (h1 : 1 ≤ P.c ℓ i) :
    P.c ℓ i < P.c ℓ (i + 1) := by
  have h := P.hlow ℓ i hi
  have e : (8 * D.k + 1) * P.c ℓ i = 8 * D.k * P.c ℓ i + P.c ℓ i := by ring
  rw [e] at h
  exact Nat.lt_of_mul_lt_mul_left (by omega : 8 * D.k * P.c ℓ i < 8 * D.k * P.c ℓ (i + 1))

lemma hST (ℓ : Fin D.k) : (P.I ℓ).biUnion (P.T ℓ) = Sf D ℓ := by
  unfold I T Sf
  rw [biUnion_pieces (P.c ℓ) (P.m ℓ) (P.mono ℓ), P.h0 ℓ, P.hm ℓ]

lemma hT (ℓ : Fin D.k) :
    ∀ i ∈ P.I ℓ, ∀ i' ∈ P.I ℓ, i ≠ i' → Disjoint (P.T ℓ i) (P.T ℓ i') :=
  disjoint_pieces (P.c ℓ) (P.m ℓ) (P.mono ℓ)

lemma lo_le (ℓ : Fin D.k) {i : ℕ} (hi : i ≤ P.m ℓ) : D.lo ℓ.castSucc ≤ P.c ℓ i := by
  rw [← P.h0 ℓ]; exact mono_pieces (P.c ℓ) (P.m ℓ) (P.mono ℓ) 0 i (Nat.zero_le _) hi

lemma le_hi (ℓ : Fin D.k) {i : ℕ} (hi : i ≤ P.m ℓ) : P.c ℓ i ≤ D.hi ℓ.castSucc := by
  rw [← P.hm ℓ]; exact mono_pieces (P.c ℓ) (P.m ℓ) (P.mono ℓ) i (P.m ℓ) hi le_rfl

/-- A tuple of pieces with `≥ ⌊√P'₁⌋` primes each is a `Good5` box. -/
lemma good5 (hR : Regime D) {j : Fin D.k → ℕ} (hj : j ∈ Fintype.piFinset P.I)
    (hcard : ∀ ℓ, Nat.sqrt D.P₁' ≤ (P.T ℓ (j ℓ)).card) :
    Good5 D (fun ℓ => P.c ℓ (j ℓ)) (fun ℓ => P.c ℓ (j ℓ + 1)) := by
  intro ℓ
  have hjℓ : j ℓ < P.m ℓ := Finset.mem_range.mp (Fintype.mem_piFinset.mp hj ℓ)
  have hlo := P.lo_le ℓ hjℓ.le
  have h3 := hR.hlo3 ℓ
  exact ⟨hlo, P.c_lt ℓ hjℓ (by omega), P.le_hi ℓ hjℓ, P.hup ℓ (j ℓ) hjℓ, hcard ℓ⟩

/-- A `Good5` tuple of pieces whose last factor is `δ⁶`-rich is a `Good6` box (Sel (iv)). -/
lemma good6 (hR : Regime D) {j : Fin D.k → ℕ} (hj : j ∈ Fintype.piFinset P.I)
    (hbad : ∀ ℓ, ¬ ((P.T ℓ (j ℓ)).card < Nat.sqrt D.P₁' ∨
      (ℓ.val + 1 = D.k ∧ FPDQ.pieceM (P.c ℓ) (j ℓ) < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) (j ℓ)))) :
    Good6 D (fun ℓ => P.c ℓ (j ℓ)) (fun ℓ => P.c ℓ (j ℓ + 1)) := by
  have hjℓ : ∀ ℓ, j ℓ < P.m ℓ := fun ℓ => Finset.mem_range.mp (Fintype.mem_piFinset.mp hj ℓ)
  refine ⟨P.good5 hR hj fun ℓ => not_lt.mp (not_or.mp (hbad ℓ)).1,
    fun ℓ => P.hlow ℓ (j ℓ) (hjℓ ℓ), ?_⟩
  intro ℓ hℓ
  have hrich : D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) (j ℓ) ≤ FPDQ.pieceM (P.c ℓ) (j ℓ) := by
    have h := (not_or.mp (hbad ℓ)).2
    exact not_lt.mp fun hlt => h ⟨hℓ, hlt⟩
  have hA3 : 3 ≤ P.c ℓ (j ℓ) := le_trans (hR.hlo3 ℓ) (P.lo_le ℓ (hjℓ ℓ).le)
  have hAB : P.c ℓ (j ℓ) < P.c ℓ (j ℓ + 1) := P.c_lt ℓ (hjℓ ℓ) (by omega)
  have hB2 : P.c ℓ (j ℓ + 1) ≤ 2 * P.c ℓ (j ℓ) := by
    have h := P.hup ℓ (j ℓ) (hjℓ ℓ)
    have hk := D.hk
    have h1 : 4 * D.k * P.c ℓ (j ℓ + 1) ≤ 4 * D.k * (2 * P.c ℓ (j ℓ)) := by
      calc 4 * D.k * P.c ℓ (j ℓ + 1) ≤ (4 * D.k + 1) * P.c ℓ (j ℓ) := h
        _ ≤ (8 * D.k) * P.c ℓ (j ℓ) := Nat.mul_le_mul_right _ (by omega)
        _ = 4 * D.k * (2 * P.c ℓ (j ℓ)) := by ring
    exact Nat.le_of_mul_le_mul_left h1 (by omega)
  have hsel := FPDQ.lemmaSel_iv hA3 hAB hB2 (pow_nonneg D.hδ.le 6) hrich
  have hlogA : 0 < Real.log (P.c ℓ (j ℓ)) :=
    Real.log_pos (by exact_mod_cast (by omega : 1 < P.c ℓ (j ℓ)))
  rw [div_le_iff₀ (by linarith), Nat.cast_sub hAB.le] at hsel
  show D.δ ^ 6 * ((P.c ℓ (j ℓ + 1) : ℝ) - P.c ℓ (j ℓ)) ≤
    4 * Real.log (P.c ℓ (j ℓ)) * (primesIn (P.c ℓ (j ℓ)) (P.c ℓ (j ℓ + 1))).card
  linarith

/-- **Sel (iii)**: the pieces with fewer than `⌊√P'₁⌋` primes carry relative weight
`≤ (8k+1)/⌊√P'₁⌋`. -/
lemma few_weight_le (hR : Regime D) (ℓ : Fin D.k) :
    ∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁'), relW (Sf D) P.T ℓ i ≤
      (8 * D.k + 1) / Nat.sqrt D.P₁' := by
  have hlo3 := hR.hlo3 ℓ
  have hsel := FPDQ.lemmaSel_iii (P.c ℓ) (P.m ℓ) D.k (Nat.sqrt D.P₁')
    (by rw [P.h0 ℓ]; omega) D.hk (P.hlow ℓ)
  rw [P.h0 ℓ] at hsel
  have hmass := hR.hmass ℓ
  have hs1 : (1 : ℝ) ≤ Nat.sqrt D.P₁' := by exact_mod_cast hR.hsq1
  have hsq : ((Nat.sqrt D.P₁' * Nat.sqrt D.P₁' : ℕ) : ℝ) ≤ D.lo ℓ.castSucc := by
    exact_mod_cast le_trans (Nat.sqrt_le D.P₁') (hR.hloP ℓ)
  push_cast at hsq
  have hlo : (0 : ℝ) < D.lo ℓ.castSucc := by exact_mod_cast (show 0 < D.lo ℓ.castSucc by omega)
  unfold relW
  rw [← Finset.sum_div]
  have hnum0 : 0 ≤ ∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁'),
      ∑ p ∈ P.T ℓ i, (1 : ℝ) / p :=
    Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun p _ => by positivity
  calc (∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁'),
        ∑ p ∈ P.T ℓ i, (1 : ℝ) / p) / ∑ p ∈ Sf D ℓ, (1 : ℝ) / p
      ≤ ∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁'),
        ∑ p ∈ P.T ℓ i, (1 : ℝ) / p := div_le_self hnum0 hmass
    _ ≤ (Nat.sqrt D.P₁' : ℝ) * (8 * D.k + 1) / D.lo ℓ.castSucc := hsel
    _ ≤ (8 * D.k + 1) / Nat.sqrt D.P₁' := by
        rw [div_le_div_iff₀ hlo (by linarith)]
        have h8 : (0 : ℝ) ≤ 8 * D.k + 1 := by positivity
        nlinarith [mul_le_mul_of_nonneg_left hsq h8]

/-- **Sel (ii)**: the non-`ε`-rich pieces carry relative weight `≤ 2ε`. -/
lemma nonrich_weight_le (hR : Regime D) (ℓ : Fin D.k) {ε : ℝ} (hε : 0 ≤ ε) :
    ∑ i ∈ (P.I ℓ).filter (fun i => FPDQ.pieceM (P.c ℓ) i < ε * FPDQ.pieceE (P.c ℓ) i),
      relW (Sf D) P.T ℓ i ≤ 2 * ε := by
  have hsel := FPDQ.lemmaSel_ii mertens (P.c ℓ) (P.m ℓ) (by rw [P.h0 ℓ]; exact hR.hlo3 ℓ)
    (P.mono ℓ) hε (by rw [P.h0 ℓ, P.hm ℓ]; exact hR.hwide ℓ)
  rw [P.h0 ℓ, P.hm ℓ] at hsel
  unfold relW
  rw [← Finset.sum_div, div_le_iff₀ (Sf_mass_pos hR ℓ)]
  exact hsel

/-- `2 k (8k+1)/⌊√P'₁⌋ ≤ δ⁵/4`. -/
lemma few_total_le (hR : Regime D) :
    2 * ((D.k : ℝ) * ((8 * D.k + 1) / Nat.sqrt D.P₁')) ≤ D.δ ^ 5 / 4 := by
  have hs : (0 : ℝ) < Nat.sqrt D.P₁' := by exact_mod_cast hR.hsq1
  have hsmall := hR.hsmall
  have e : 2 * ((D.k : ℝ) * ((8 * D.k + 1) / Nat.sqrt D.P₁')) =
      (2 * D.k * (8 * D.k + 1)) / Nat.sqrt D.P₁' := by ring
  rw [e, div_le_iff₀ hs]
  linarith

/-- The bad weight of step P5a: `≤ δ⁴/2 = δ³/(2 · δ⁻¹)`. -/
lemma bad5_weight_le (hR : Regime D) :
    2 * ∑ ℓ, ∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁'),
      relW (Sf D) P.T ℓ i ≤ D.δ ^ 3 / (2 * (1 / D.δ)) := by
  have htot := Finset.sum_le_sum fun ℓ (_ : ℓ ∈ Finset.univ) => P.few_weight_le hR ℓ
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at htot
  have h1 := few_total_le hR
  have hδ16 := hR.hδ16
  have hδle : 16 * D.δ ≤ 1 := by rw [le_div_iff₀ D.hδ] at hδ16; linarith
  have hδ4 : 0 ≤ D.δ ^ 4 := pow_nonneg D.hδ.le 4
  have e : D.δ ^ 3 / (2 * (1 / D.δ)) = D.δ ^ 4 / 2 := by
    have := D.hδ.ne'
    field_simp
  have h3 : D.δ ^ 5 / 4 ≤ D.δ ^ 4 / 2 := by
    have e5 : D.δ ^ 5 = D.δ ^ 4 * D.δ := by ring
    rw [e5]
    nlinarith
  rw [e]
  linarith

end Part

/-- Union bound for a disjunctive filter. -/
lemma sum_filter_or_le {s : Finset ℕ} (p q : ℕ → Prop) [DecidablePred p] [DecidablePred q]
    (f : ℕ → ℝ) (hf : ∀ i ∈ s, 0 ≤ f i) :
    ∑ i ∈ s.filter (fun i => p i ∨ q i), f i ≤
      ∑ i ∈ s.filter p, f i + ∑ i ∈ s.filter q, f i := by
  rw [Finset.filter_or]
  have h := Finset.sum_union_inter (s₁ := s.filter p) (s₂ := s.filter q) (f := f)
  have h0 : 0 ≤ ∑ i ∈ s.filter p ∩ s.filter q, f i :=
    Finset.sum_nonneg fun i hi => hf i (Finset.mem_filter.mp (Finset.mem_inter.mp hi).1).1
  linarith

/-- Only one index `ℓ < k` is the last one. -/
lemma sum_last_le {k : ℕ} (x : ℝ) (hx : 0 ≤ x) :
    ∑ ℓ : Fin k, (if ℓ.val + 1 = k then x else 0) ≤ x := by
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul]
  have hc : (Finset.univ.filter (fun ℓ : Fin k => ℓ.val + 1 = k)).card ≤ 1 := by
    rw [Finset.card_le_one]
    intro a ha b hb
    simp only [Finset.mem_filter] at ha hb
    exact Fin.ext (by omega)
  have hc' : ((Finset.univ.filter (fun ℓ : Fin k => ℓ.val + 1 = k)).card : ℝ) ≤ 1 := by
    exact_mod_cast hc
  nlinarith

namespace Part

variable {D : Data} (P : Part D)

/-- The bad weight of step P6e: `≤ 2k(8k+1)/⌊√P'₁⌋ + 4δ⁶ ≤ δ⁵/2`. -/
lemma bad6_weight_le (hR : Regime D) :
    2 * ∑ ℓ, ∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁' ∨
        (ℓ.val + 1 = D.k ∧ FPDQ.pieceM (P.c ℓ) i < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) i)),
      relW (Sf D) P.T ℓ i ≤ D.δ ^ 5 / (2 * 1) := by
  have hε : (0 : ℝ) ≤ D.δ ^ 6 := pow_nonneg D.hδ.le 6
  have hper : ∀ ℓ : Fin D.k,
      ∑ i ∈ (P.I ℓ).filter (fun i => (P.T ℓ i).card < Nat.sqrt D.P₁' ∨
        (ℓ.val + 1 = D.k ∧ FPDQ.pieceM (P.c ℓ) i < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) i)),
      relW (Sf D) P.T ℓ i ≤
        (8 * D.k + 1) / Nat.sqrt D.P₁' + (if ℓ.val + 1 = D.k then 2 * D.δ ^ 6 else 0) := by
    intro ℓ
    refine (sum_filter_or_le _ _ _ fun i _ => relW_nonneg _ _ _ _).trans
      (add_le_add (P.few_weight_le hR ℓ) ?_)
    split_ifs with hℓ
    · have e : (P.I ℓ).filter (fun i => ℓ.val + 1 = D.k ∧
            FPDQ.pieceM (P.c ℓ) i < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) i) =
          (P.I ℓ).filter (fun i => FPDQ.pieceM (P.c ℓ) i < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) i) :=
        Finset.filter_congr fun i _ => by simp [hℓ]
      rw [e]
      exact P.nonrich_weight_le hR ℓ hε
    · have e : (P.I ℓ).filter (fun i => ℓ.val + 1 = D.k ∧
            FPDQ.pieceM (P.c ℓ) i < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) i) = ∅ :=
        Finset.filter_false_of_mem fun i _ h => hℓ h.1
      rw [e, Finset.sum_empty]
  have htot := Finset.sum_le_sum fun ℓ (_ : ℓ ∈ Finset.univ) => hper ℓ
  rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul] at htot
  have hlast := sum_last_le (k := D.k) (2 * D.δ ^ 6) (by linarith)
  have h1 := few_total_le hR
  have hδ16 := hR.hδ16
  have hδle : 16 * D.δ ≤ 1 := by rw [le_div_iff₀ D.hδ] at hδ16; linarith
  have hδ5 : 0 ≤ D.δ ^ 5 := pow_nonneg D.hδ.le 5
  have h2 : 4 * D.δ ^ 6 ≤ D.δ ^ 5 / 4 := by
    have e6 : D.δ ^ 6 = D.δ ^ 5 * D.δ := by ring
    rw [e6]
    nlinarith
  linarith

end Part

/- ## 7. The two steps -/

/-- `|E^log_{B₁} E^log_{B₂} K| ≤ c` for `|K| ≤ c`. -/
lemma abs_lavg_lavg_le {B₁ B₂ : Finset ℕ} {K : ℕ → ℕ → ℝ} {c : ℝ} (hc : 0 ≤ c)
    (hK : ∀ s t, |K s t| ≤ c) : |lavg B₁ (fun s => lavg B₂ (fun t => K s t))| ≤ c :=
  abs_wavg_le_of_nonneg (lavg_weight_nonneg B₁) hc fun s _ =>
    abs_wavg_le_of_nonneg (lavg_weight_nonneg B₂) hc fun t _ => hK s t

lemma abs_logAvg_le_one (N : ℕ) (g : ℤ → ℝ) (hg : ∀ n, |g n| ≤ 1) : |logAvg N g| ≤ 1 :=
  abs_wavg_le_of_nonneg (fun n _ => by positivity) zero_le_one fun n _ => hg n

/-- The kernel of (5.12) is bounded by `E|ψ|` (GS (5.11)). -/
lemma abs_K_le (D : Data) (f₁ ψ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (X : ℕ) (p₁ p₂ : ℕ) :
    |favg (win X) fun x => ψ x * logAvg D.N fun n =>
      f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂)| ≤
      favg (win X) (fun x => |ψ x|) :=
  abs_wavg_mul_le (fun _ _ => zero_le_one) fun x _ => abs_logAvg_le_one _ _ fun n => by
    rw [abs_mul]; exact mul_le_one₀ (hf₁ _) (abs_nonneg _) (hf₁ _)

/-- Fubini: `E_x ψ(x) Φ(x) = E^log_{p₁} E^log_{p₂} E_x ψ(x) E^log_n …`. -/
lemma favg_psi_Phi (D : Data) (f₁ ψ : ℤ → ℝ) (X : ℕ) :
    favg (win X) (fun x => ψ x * Phi D f₁ x) =
      lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ => favg (win X) fun x => ψ x * logAvg D.N fun n =>
        f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂))) := by
  have h1 : ∀ x : ℤ, ψ x * Phi D f₁ x = lavg D.Pp (fun p₁ => lavg D.Pp (fun p₂ =>
      ψ x * logAvg D.N fun n =>
        f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂))) := by
    intro x
    unfold Phi lavg
    refine (wavg_smul _ _).symm.trans ?_
    exact wavg_congr fun p₁ _ => (wavg_smul _ _).symm
  simp_rw [h1]
  unfold favg lavg
  refine (Elem.wavg_comm _ _ _ _ _).trans ?_
  exact wavg_congr fun p₁ _ => Elem.wavg_comm _ _ _ _ _

/-- **P5a, abstract form**: signed pigeonhole for a kernel bounded by `1/δ`. -/
theorem pigeon5 (hB : StepBoxes) (D : Data) (hδ : D.δ ≤ pδ₀) (hN : pN₀ ≤ D.N)
    (K : ℕ → ℕ → ℝ) (hK : ∀ s t, |K s t| ≤ 1 / D.δ)
    (hE : D.δ ^ 3 ≤ |lavg D.Pp (fun s => lavg D.Pp (fun t => K s t))|) :
    ∃ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good5 D a₁ b₁ ∧ Good5 D a₂ b₂ ∧
      D.δ ^ 3 / 2 ≤
        |lavg (almostPrimes a₁ b₁) (fun s => lavg (almostPrimes a₂ b₂) (fun t => K s t))| := by
  have hR := regime D hδ hN
  obtain ⟨P⟩ := exists_part hB D hR
  have hMF : 0 < 1 / D.δ := one_div_pos.mpr D.hδ
  obtain ⟨j, hj, j', hj', hbj, hbj', hF⟩ := pigeon_pairs (Sf D) (Sf_prime D) (Sf_disj D)
    P.I P.T P.hST P.hT (Sf_mass_pos hR) K hMF (pow_pos D.hδ 3)
    (fun _ _ _ _ => abs_lavg_lavg_le hMF.le hK) hE
    (fun ℓ i => (P.T ℓ i).card < Nat.sqrt D.P₁') (P.bad5_weight_le hR)
  exact ⟨fun ℓ => P.c ℓ (j ℓ), fun ℓ => P.c ℓ (j ℓ + 1), fun ℓ => P.c ℓ (j' ℓ),
    fun ℓ => P.c ℓ (j' ℓ + 1), P.good5 hR hj fun ℓ => not_lt.mp (hbj ℓ),
    P.good5 hR hj' fun ℓ => not_lt.mp (hbj' ℓ), hF⟩

/-- **P6e, abstract form**: non-negative pigeonhole, then logarithmic → uniform weights. -/
theorem pigeon6 (hB : StepBoxes) (D : Data) (hδ : D.δ ≤ pδ₀) (hN : pN₀ ≤ D.N)
    (G : ℕ → ℕ → ℝ) (hG : ∀ s t, 0 ≤ G s t ∧ G s t ≤ 1)
    (hE : D.δ ^ 5 ≤ lavg D.Pp (fun s => lavg D.Pp (fun t => G s t))) :
    ∃ a₁ b₁ a₂ b₂ : Fin D.k → ℕ, Good6 D a₁ b₁ ∧ Good6 D a₂ b₂ ∧
      D.δ ^ 6 ≤ favg (almostPrimes a₁ b₁) (fun s => favg (almostPrimes a₂ b₂) (fun t => G s t)) := by
  have hR := regime D hδ hN
  obtain ⟨P⟩ := exists_part hB D hR
  have hG1 : ∀ s t, |G s t| ≤ 1 := fun s t => abs_le.mpr ⟨by linarith [(hG s t).1], (hG s t).2⟩
  obtain ⟨j, hj, j', hj', hbj, hbj', hF⟩ := pigeon_pairs (Sf D) (Sf_prime D) (Sf_disj D)
    P.I P.T P.hST P.hT (Sf_mass_pos hR) G one_pos (pow_pos D.hδ 5)
    (fun _ _ _ _ => abs_lavg_lavg_le zero_le_one hG1) (hE.trans (le_abs_self _))
    (fun ℓ i => (P.T ℓ i).card < Nat.sqrt D.P₁' ∨
      (ℓ.val + 1 = D.k ∧ FPDQ.pieceM (P.c ℓ) i < D.δ ^ 6 * FPDQ.pieceE (P.c ℓ) i))
    (P.bad6_weight_le hR)
  refine ⟨fun ℓ => P.c ℓ (j ℓ), fun ℓ => P.c ℓ (j ℓ + 1), fun ℓ => P.c ℓ (j' ℓ),
    fun ℓ => P.c ℓ (j' ℓ + 1), P.good6 hR hj hbj, P.good6 hR hj' hbj', ?_⟩
  have h0 : 0 ≤ lavg (FPDQ.boxProd fun ℓ => P.T ℓ (j ℓ))
      (fun s => lavg (FPDQ.boxProd fun ℓ => P.T ℓ (j' ℓ)) (fun t => G s t)) :=
    wavg_nonneg_of_nonneg (lavg_weight_nonneg _) fun s _ =>
      wavg_nonneg_of_nonneg (lavg_weight_nonneg _) fun t _ => (hG s t).1
  rw [abs_of_nonneg h0] at hF
  have hF2 : D.δ ^ 5 / 2 ≤ lavg (almostPrimes (fun ℓ => P.c ℓ (j ℓ)) (fun ℓ => P.c ℓ (j ℓ + 1)))
      (fun s => lavg (almostPrimes (fun ℓ => P.c ℓ (j' ℓ)) (fun ℓ => P.c ℓ (j' ℓ + 1)))
        (fun t => G s t)) := hF
  have hY : ∀ jj ∈ Fintype.piFinset P.I, (0 : ℝ) < ((∏ ℓ, P.c ℓ (jj ℓ) : ℕ) : ℝ) := by
    intro jj hjj
    have hpos : 0 < ∏ ℓ, P.c ℓ (jj ℓ) := Finset.prod_pos fun ℓ _ => by
      have h1 := P.lo_le ℓ (Finset.mem_range.mp (Fintype.mem_piFinset.mp hjj ℓ)).le
      have h2 := hR.hlo3 ℓ
      omega
    exact_mod_cast hpos
  have hup : ∀ jj ∈ Fintype.piFinset P.I, ∀ ℓ,
      4 * D.k * P.c ℓ (jj ℓ + 1) ≤ (4 * D.k + 1) * P.c ℓ (jj ℓ) := fun jj hjj ℓ =>
    P.hup ℓ (jj ℓ) (Finset.mem_range.mp (Fintype.mem_piFinset.mp hjj ℓ))
  have h4 := lavg_lavg_le_four_favg (hY j hj) (hY j' hj')
    (fun s hs => box_bounds D.hk (fun ℓ => P.c ℓ (j ℓ)) (fun ℓ => P.c ℓ (j ℓ + 1)) (hup j hj) hs)
    (fun s hs => box_bounds D.hk (fun ℓ => P.c ℓ (j' ℓ)) (fun ℓ => P.c ℓ (j' ℓ + 1))
      (hup j' hj') hs)
    (fun s t => (hG s t).1)
  have hδ16 := hR.hδ16
  have hδle : 16 * D.δ ≤ 1 := by rw [le_div_iff₀ D.hδ] at hδ16; linarith
  have hδ5 : 0 ≤ D.δ ^ 5 := pow_nonneg D.hδ.le 5
  have h6 : D.δ ^ 6 ≤ D.δ ^ 5 / 8 := by
    have e6 : D.δ ^ 6 = D.δ ^ 5 * D.δ := by ring
    rw [e6]
    nlinarith
  linarith

end Pigeon

open Pigeon in
/-- **Step P5a** (GS p. 17, (5.9) → (5.12)), with `δ₀ = min(1/16, 1/(2C_M+1))` and
`N₀ = ⌈exp exp V₀¹⁰⌉`, `V₀ = max(5329, 151!)`. -/
theorem stepP5a (hB : StepBoxes) : StepP5a := by
  refine ⟨pδ₀, pδ₀_pos, pN₀, ?_⟩
  intro D hδ hN f₁ hf₁ X _ _ ψ hψ hcorr
  rw [favg_psi_Phi] at hcorr
  obtain ⟨a₁, b₁, a₂, b₂, h1, h2, h3⟩ := pigeon5 hB D hδ hN
    (fun p₁ p₂ => favg (win X) fun x => ψ x * logAvg D.N fun n =>
      f₁ (n * p₂ + (D.lam : ℤ) * x * p₁) * f₁ (n * p₁ + (D.lam : ℤ) * x * p₂))
    (fun s t => (abs_K_le D f₁ ψ hf₁ X s t).trans hψ) hcorr
  exact ⟨a₁, b₁, a₂, b₂, h1, h2, h3⟩

open Pigeon in
/-- **Step P6e** (GS p. 22, refoliation), with the same `δ₀` and `N₀` as `stepP5a`. -/
theorem stepP6e (hB : StepBoxes) : StepP6e :=
  ⟨pδ₀, pδ₀_pos, pN₀, fun D hδ hN G hG hE => pigeon6 hB D hδ hN G hG hE⟩

end G22.P51

end

/- ## Section: `P51P5b` -/

section

/-
# Step P5b of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, p. 18, (5.12) → (5.13) → (5.14).

We prove `G22.P51.stepP5b : StepP5b` with `N₀ = ⌈exp(exp(10¹⁰))⌉` (`P5b.N₀`).

## Parameters (`P5b.params`)

For `y = log N`, `s = √y`, `a = ⌈s⌉`: `L = 3^a` and `N' = L²` (no real powers). As `log 3 ≥ 1`,
`(log L)² ≥ a² ≥ y = log N`. For `N ≥ N₀`, `ℓ = log log N ≥ 10¹⁰`, so `s ≥ 96ℓ⁴` (from
`ℓ⁹/9! ≤ e^ℓ = y`), and `1/δ ≤ ℓ` gives `sδ⁴ ≥ 96`.

## Proof

1. (`decomp`, `logAvg_approx`) Cut `[1, N]` into the head `[1, N']`, the blocks `[u_j, u_j + L)`,
   `u_j = N' + jL + 1`, `j < m = ⌊(N - N')/L⌋`, and a tail of length `< L`. On a block
   `|1/n - 1/u_j| ≤ (1/L)(1/n)` since `u_j > L²`. So for every 1-bounded `h`,
   `|E^log_{n∈[N]} h - ∑_j c_j E_{n∈[u_j,u_j+L)} h| ≤ ε = (H_{N'} + H_N/L + 1/L)/H_N ≤ 7/s ≤ δ⁴/8`,
   with `c_j = (L/u_j)/H_N ≥ 0` and `∑_j c_j ≤ 2` (`cc_sum_le`).
2. (`lhs12_split`, `pigeon`) Everything is linear in the `n`-weights, so
   `lhs12 = ∑_j c_j M_j + R` with `M_j` the block version (`Mblk`) and `|R| ≤ ε E|ψ| ≤ δ³/8`.
   Hence `|∑_j c_j M_j| ≥ 3δ³/8` and some `|M_j| ≥ δ³/8`.
3. (`box_facts`, `reweight`) Every `p` in a `Good5` box satisfies
   `Y ≤ p ≤ (1 + 1/(4k))^k Y ≤ e^{1/4} Y ≤ (4/3) Y`, `Y = ∏ a_ℓ`; boxes are nonempty. With
   `r(p) = min(1, Y/p)` (`= Y/p ∈ [3/4, 1]` on the box),
   `E_{B₁} E_{B₂} r₁r₂ G = (E_{B₁} r₁)(E_{B₂} r₂) E^log_{B₁} E^log_{B₂} G`. So for
   `ρ(s, t) = r₁(s) r₂(t)` and `u = u_j`: `|lhs14| ≥ (3/4)² δ³/8 ≥ δ³/16`.
-/

open Finset Real

namespace G22.P51

namespace P5b

open G22.Elem

/- ### Generic facts about weighted averages with nonnegative weights -/

section Generic

variable {α : Type*}

lemma wavg_mono_nn {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) {f g : α → ℝ}
    (hfg : ∀ x ∈ s, f x ≤ g x) : wavg s w f ≤ wavg s w g := by
  unfold wavg
  apply div_le_div_of_nonneg_right _ (Finset.sum_nonneg hw)
  exact Finset.sum_le_sum fun x hx => mul_le_mul_of_nonneg_left (hfg x hx) (hw x hx)

lemma abs_wavg_le_nn {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) (f : α → ℝ) :
    |wavg s w f| ≤ wavg s w (fun x => |f x|) := by
  rw [abs_le]
  refine ⟨?_, wavg_mono_nn hw fun x _ => le_abs_self _⟩
  have h1 := wavg_mono_nn hw (f := fun x => -|f x|) (g := f) (fun x _ => neg_abs_le _)
  rw [wavg_neg] at h1
  linarith

/-- `|E f| ≤ C` if `|f| ≤ C`, for nonnegative weights (no nonemptiness needed). -/
lemma abs_wavg_le_of_nn {s : Finset α} {w : α → ℝ} (hw : ∀ x ∈ s, 0 ≤ w x) {f : α → ℝ}
    {C : ℝ} (hC : 0 ≤ C) (hf : ∀ x ∈ s, |f x| ≤ C) : |wavg s w f| ≤ C := by
  unfold wavg
  have hW : 0 ≤ ∑ x ∈ s, w x := Finset.sum_nonneg hw
  rcases hW.eq_or_lt with h0 | hpos
  · rw [← h0, div_zero, abs_zero]; exact hC
  · rw [abs_div, abs_of_pos hpos, div_le_iff₀ hpos]
    calc |∑ x ∈ s, w x * f x| ≤ ∑ x ∈ s, |w x * f x| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ x ∈ s, C * w x := Finset.sum_le_sum fun x hx => by
          rw [abs_mul, abs_of_nonneg (hw x hx), mul_comm C]
          exact mul_le_mul_of_nonneg_left (hf x hx) (hw x hx)
      _ = C * ∑ x ∈ s, w x := by rw [Finset.mul_sum]

/-- Linearity of a weighted average on a finite linear combination. -/
lemma wavg_lincomb (s : Finset α) (w : α → ℝ) {ι : Type*} (J : Finset ι) (c : ι → ℝ)
    (F : ι → α → ℝ) (E : α → ℝ) :
    wavg s w (fun x => ∑ j ∈ J, c j * F j x + E x) =
      ∑ j ∈ J, c j * wavg s w (F j) + wavg s w E := by
  rw [wavg_add, wavg_sum]
  congr 1
  exact Finset.sum_congr rfl fun j _ => wavg_smul (c j) (F j)

lemma favg_abs_nonneg (s : Finset α) (f : α → ℝ) : 0 ≤ favg s (fun x => |f x|) := by
  unfold favg wavg
  exact div_nonneg (Finset.sum_nonneg fun x _ => by positivity)
    (Finset.sum_nonneg fun _ _ => zero_le_one)

lemma favg_smul' (s : Finset α) (c : ℝ) (f : α → ℝ) :
    favg s (fun x => c * f x) = c * favg s f :=
  wavg_smul c f

end Generic

/-- Linearity of `E^log_{p₁∈B₁} E^log_{p₂∈B₂} E_{x∈W}` on a finite linear combination. -/
lemma triple_lincomb (B₁ B₂ : Finset ℕ) (W : Finset ℤ) (J : Finset ℕ) (c : ℕ → ℝ)
    (F : ℕ → ℕ → ℕ → ℤ → ℝ) (E : ℕ → ℕ → ℤ → ℝ) :
    (lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg W fun x =>
        ∑ j ∈ J, c j * F j p₁ p₂ x + E p₁ p₂ x) =
      ∑ j ∈ J, c j * (lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg W fun x => F j p₁ p₂ x) +
        lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg W fun x => E p₁ p₂ x := by
  have h1 : ∀ p₁ p₂, (favg W fun x => ∑ j ∈ J, c j * F j p₁ p₂ x + E p₁ p₂ x) =
      ∑ j ∈ J, c j * (favg W fun x => F j p₁ p₂ x) + favg W fun x => E p₁ p₂ x :=
    fun p₁ p₂ => wavg_lincomb W _ J c (fun j x => F j p₁ p₂ x) (fun x => E p₁ p₂ x)
  simp only [h1]
  have h2 : ∀ p₁, (lavg B₂ fun p₂ => ∑ j ∈ J, c j * (favg W fun x => F j p₁ p₂ x) +
      favg W fun x => E p₁ p₂ x) =
      ∑ j ∈ J, c j * (lavg B₂ fun p₂ => favg W fun x => F j p₁ p₂ x) +
        lavg B₂ fun p₂ => favg W fun x => E p₁ p₂ x :=
    fun p₁ => wavg_lincomb B₂ _ J c (fun j p₂ => favg W fun x => F j p₁ p₂ x)
      (fun p₂ => favg W fun x => E p₁ p₂ x)
  simp only [h2]
  exact wavg_lincomb B₁ _ J c _ _

/-- Signed pigeonhole: a combination with nonnegative coefficients of total mass `≤ 2` and size
`≥ α` has a term of size `≥ α / 3`. -/
lemma pigeon {J : Finset ℕ} {c M : ℕ → ℝ} (hc : ∀ j ∈ J, 0 ≤ c j) (hsum : ∑ j ∈ J, c j ≤ 2)
    {α : ℝ} (hα : 0 < α) (h : α ≤ |∑ j ∈ J, c j * M j|) : ∃ j ∈ J, α / 3 ≤ |M j| := by
  by_contra hne
  simp only [not_exists, not_and, not_le] at hne
  have : |∑ j ∈ J, c j * M j| ≤ 2 * (α / 3) := by
    calc |∑ j ∈ J, c j * M j| ≤ ∑ j ∈ J, |c j * M j| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j ∈ J, c j * (α / 3) := Finset.sum_le_sum fun j hj => by
          rw [abs_mul, abs_of_nonneg (hc j hj)]
          exact mul_le_mul_of_nonneg_left (hne j hj).le (hc j hj)
      _ = (∑ j ∈ J, c j) * (α / 3) := by rw [Finset.sum_mul]
      _ ≤ 2 * (α / 3) := mul_le_mul_of_nonneg_right hsum (by positivity)
  linarith

/- ### Cutting `[1, N]` into a head, blocks of length `L` and a tail -/

section Decomp

lemma sum_range_mul_blocks (G : ℕ → ℝ) (m L : ℕ) :
    ∑ i ∈ range (m * L), G i = ∑ j ∈ range m, ∑ t ∈ range L, G (j * L + t) := by
  induction m with
  | zero => simp
  | succ m ih => rw [Nat.succ_mul, Finset.sum_range_add, ih, Finset.sum_range_succ]

lemma sum_range_split (G : ℕ → ℝ) (N' m L r : ℕ) :
    ∑ i ∈ range (N' + m * L + r), G i =
      ∑ i ∈ range N', G i + ∑ j ∈ range m, ∑ t ∈ range L, G (N' + j * L + t) +
        ∑ t ∈ range r, G (N' + m * L + t) := by
  rw [Finset.sum_range_add, Finset.sum_range_add, sum_range_mul_blocks]
  simp only [add_assoc]

/-- The left end `u_j = N' + jL + 1` of the `j`-th block. -/
def uu (N' L j : ℕ) : ℕ := N' + j * L + 1

/-- The `j`-th block `[u_j, u_j + L)` as a set of integers. -/
noncomputable def II (N' L j : ℕ) : Finset ℤ := Finset.Ico (uu N' L j : ℤ) ((uu N' L j : ℤ) + L)

lemma div_add_mod_eq {N N' L : ℕ} (hN : N' ≤ N) :
    N' + (N - N') / L * L + (N - N') % L = N := by
  rw [add_assoc, Nat.div_add_mod', Nat.add_sub_cancel' hN]

lemma favg_Ico (u : ℤ) (L : ℕ) (h : ℤ → ℝ) :
    favg (Finset.Ico u (u + L)) h = (∑ t ∈ range L, h (u + t)) / L := by
  unfold favg wavg
  rw [Int.Ico_eq_finset_map, Finset.sum_map, Finset.sum_map]
  simp

/-- One block: `∑_{t<L} h(u+t)/(u+t) = (L/u) E_{[u,u+L)} h + ∑_{t<L} (1/(u+t) - 1/u) h(u+t)`. -/
lemma block_eq (u L : ℕ) (hL : 1 ≤ L) (h : ℤ → ℝ) :
    ∑ t ∈ range L, 1 / ((u : ℝ) + t) * h ((u : ℤ) + t) =
      (L : ℝ) / u * favg (Finset.Ico (u : ℤ) (u + L)) h +
        ∑ t ∈ range L, (1 / ((u : ℝ) + t) - 1 / u) * h ((u : ℤ) + t) := by
  rw [favg_Ico]
  have hL0 : (L : ℝ) ≠ 0 := by
    have : (1 : ℝ) ≤ L := by exact_mod_cast hL
    linarith
  have hmain : (L : ℝ) / u * ((∑ t ∈ range L, h ((u : ℤ) + t)) / L) =
      ∑ t ∈ range L, 1 / (u : ℝ) * h ((u : ℤ) + t) := by
    rw [← Finset.mul_sum]
    field_simp
  rw [hmain, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun t _ => by ring

/-- The error of one block: `|1/(u+t) - 1/u| ≤ (1/L)(1/(u+t))` for `t < L ≤ u/L`. -/
lemma block_err (u L : ℕ) (hLu : L * L ≤ u) (h : ℤ → ℝ) (hh : ∀ n, |h n| ≤ 1) :
    |∑ t ∈ range L, (1 / ((u : ℝ) + t) - 1 / u) * h ((u : ℤ) + t)| ≤
      1 / L * ∑ t ∈ range L, 1 / ((u : ℝ) + t) := by
  rw [Finset.mul_sum]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun t ht => ?_)
  have htL : t < L := Finset.mem_range.mp ht
  have hL1 : 1 ≤ L := by omega
  have hu1 : 1 ≤ u := le_trans (Nat.one_le_iff_ne_zero.mpr (by positivity)) hLu
  have hu : (0 : ℝ) < u := by exact_mod_cast hu1
  have hut : (0 : ℝ) < u + t := by positivity
  have hLr : (0 : ℝ) < L := by exact_mod_cast hL1
  have key : (t : ℝ) * L ≤ u := by
    have : t * L ≤ u := by
      calc t * L ≤ (t + 1) * L := Nat.mul_le_mul_right _ (by omega)
        _ ≤ L * L := Nat.mul_le_mul_right _ htL
        _ ≤ u := hLu
    exact_mod_cast this
  have hdiff : 1 / ((u : ℝ) + t) - 1 / u = -(t / (u * (u + t))) := by
    field_simp; ring
  rw [abs_mul, hdiff, abs_neg, abs_of_nonneg (by positivity)]
  calc (t : ℝ) / (u * (u + t)) * |h ((u : ℤ) + t)| ≤ (t : ℝ) / (u * (u + t)) * 1 :=
        mul_le_mul_of_nonneg_left (hh _) (by positivity)
    _ = (t : ℝ) * L / (u * (u + t)) / L := by field_simp
    _ ≤ (u : ℝ) / (u * (u + t)) / L := by gcongr
    _ = 1 / L * (1 / ((u : ℝ) + t)) := by field_simp

/-- The blocks carry at most the full harmonic mass. -/
lemma blocks_le (N N' L : ℕ) (hN : N' ≤ N) :
    ∑ j ∈ range ((N - N') / L), ∑ t ∈ range L, 1 / ((uu N' L j : ℝ) + t) ≤ hR N := by
  have hs := sum_range_split (fun i => 1 / ((i : ℝ) + 1)) N' ((N - N') / L) L ((N - N') % L)
  rw [div_add_mod_eq hN] at hs
  have hR_eq : hR N = ∑ i ∈ range N, 1 / ((i : ℝ) + 1) := rfl
  have h1 : 0 ≤ ∑ i ∈ range N', 1 / ((i : ℝ) + 1) :=
    Finset.sum_nonneg fun i _ => by positivity
  have h2 : 0 ≤ ∑ t ∈ range ((N - N') % L),
      1 / (((N' + (N - N') / L * L + t : ℕ) : ℝ) + 1) :=
    Finset.sum_nonneg fun i _ => by positivity
  have h3 : ∑ j ∈ range ((N - N') / L), ∑ t ∈ range L, 1 / ((uu N' L j : ℝ) + t) =
      ∑ j ∈ range ((N - N') / L), ∑ t ∈ range L, 1 / (((N' + j * L + t : ℕ) : ℝ) + 1) := by
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun t _ => ?_
    unfold uu; push_cast; ring_nf
  rw [h3, hR_eq, hs]
  linarith

/-- The coefficients `L/u_j` have total mass `≤ 2 H_N`. -/
lemma coef_le (N N' L : ℕ) (hLL : L * L ≤ N') (hN : N' ≤ N) :
    ∑ j ∈ range ((N - N') / L), (L : ℝ) / (uu N' L j : ℝ) ≤ 2 * hR N := by
  calc ∑ j ∈ range ((N - N') / L), (L : ℝ) / (uu N' L j : ℝ)
      ≤ ∑ j ∈ range ((N - N') / L), 2 * ∑ t ∈ range L, 1 / ((uu N' L j : ℝ) + t) := by
        refine Finset.sum_le_sum fun j _ => ?_
        have hu : (0 : ℝ) < (uu N' L j : ℝ) := by unfold uu; positivity
        have hLu : (L : ℝ) / (uu N' L j : ℝ) = ∑ t ∈ range L, 1 / (uu N' L j : ℝ) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; ring
        rw [hLu, Finset.mul_sum]
        refine Finset.sum_le_sum fun t ht => ?_
        have htL : t < L := Finset.mem_range.mp ht
        have htu : (t : ℝ) ≤ (uu N' L j : ℝ) := by
          have : t ≤ uu N' L j := by
            unfold uu
            calc t ≤ L := htL.le
              _ ≤ L * L := Nat.le_mul_self L
              _ ≤ N' := hLL
              _ ≤ N' + j * L + 1 := by omega
          exact_mod_cast this
        rw [mul_one_div, div_le_div_iff₀ hu (by positivity)]
        linarith
    _ = 2 * ∑ j ∈ range ((N - N') / L), ∑ t ∈ range L, 1 / ((uu N' L j : ℝ) + t) := by
        rw [Finset.mul_sum]
    _ ≤ 2 * hR N := by gcongr; exact blocks_le N N' L hN

/-- The decomposition of the log-sum `∑_{n ≤ N} h(n)/n` into blocks. -/
lemma decomp (N N' L : ℕ) (hL : 1 ≤ L) (hLL : L * L ≤ N') (hN : N' ≤ N) (h : ℤ → ℝ)
    (hh : ∀ n, |h n| ≤ 1) :
    |∑ i ∈ range N, 1 / ((i : ℝ) + 1) * h ((i : ℤ) + 1) -
      ∑ j ∈ range ((N - N') / L), (L : ℝ) / (uu N' L j : ℝ) * favg (II N' L j) h| ≤
      hR N' + hR N / L + 1 / L := by
  set m := (N - N') / L with hm
  set r := (N - N') % L with hr
  have hrL : r < L := Nat.mod_lt _ (by omega)
  have hLr : (0 : ℝ) < L := by exact_mod_cast hL
  set G : ℕ → ℝ := fun i => 1 / ((i : ℝ) + 1) * h ((i : ℤ) + 1) with hG
  have hsplit := sum_range_split G N' m L r
  rw [div_add_mod_eq hN] at hsplit
  -- the blocks
  have hblock : ∀ j ∈ range m, ∑ t ∈ range L, G (N' + j * L + t) =
      (L : ℝ) / (uu N' L j : ℝ) * favg (II N' L j) h +
        ∑ t ∈ range L, (1 / ((uu N' L j : ℝ) + t) - 1 / (uu N' L j : ℝ)) *
          h ((uu N' L j : ℤ) + t) := by
    intro j _
    rw [II, ← block_eq (uu N' L j) L hL h]
    refine Finset.sum_congr rfl fun t _ => ?_
    simp only [hG, uu]
    push_cast
    ring_nf
  rw [hsplit, Finset.sum_congr rfl hblock, Finset.sum_add_distrib]
  set E : ℕ → ℝ := fun j => ∑ t ∈ range L, (1 / ((uu N' L j : ℝ) + t) - 1 / (uu N' L j : ℝ)) *
    h ((uu N' L j : ℤ) + t) with hE
  have hre : ∑ i ∈ range N', G i +
      (∑ j ∈ range m, (L : ℝ) / (uu N' L j : ℝ) * favg (II N' L j) h + ∑ j ∈ range m, E j) +
      ∑ t ∈ range r, G (N' + m * L + t) -
      ∑ j ∈ range m, (L : ℝ) / (uu N' L j : ℝ) * favg (II N' L j) h =
      ∑ i ∈ range N', G i + ∑ j ∈ range m, E j + ∑ t ∈ range r, G (N' + m * L + t) := by
    ring
  rw [hre]
  -- the head
  have hhead : |∑ i ∈ range N', G i| ≤ hR N' :=
    abs_sum_weighted_le _ _ (fun i _ => by positivity) _ (fun i _ => hh _)
  -- the blocks
  have hblk : |∑ j ∈ range m, E j| ≤ hR N / L := by
    calc |∑ j ∈ range m, E j| ≤ ∑ j ∈ range m, |E j| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j ∈ range m, 1 / (L : ℝ) * ∑ t ∈ range L, 1 / ((uu N' L j : ℝ) + t) :=
          Finset.sum_le_sum fun j _ => block_err _ _ (by unfold uu; omega) h hh
      _ = 1 / (L : ℝ) * ∑ j ∈ range m, ∑ t ∈ range L, 1 / ((uu N' L j : ℝ) + t) := by
          rw [Finset.mul_sum]
      _ ≤ 1 / (L : ℝ) * hR N := by gcongr; exact blocks_le N N' L hN
      _ = hR N / L := by ring
  -- the tail
  have htail : |∑ t ∈ range r, G (N' + m * L + t)| ≤ 1 / L := by
    have hLL' : (0 : ℝ) < ((L * L : ℕ) : ℝ) := by positivity
    calc |∑ t ∈ range r, G (N' + m * L + t)|
        ≤ ∑ t ∈ range r, 1 / (((N' + m * L + t : ℕ) : ℝ) + 1) :=
          abs_sum_weighted_le _ _ (fun i _ => by positivity) _ (fun i _ => hh _)
      _ ≤ ∑ t ∈ range r, 1 / ((L * L : ℕ) : ℝ) := by
          refine Finset.sum_le_sum fun t _ => ?_
          apply one_div_le_one_div_of_le hLL'
          have : L * L ≤ N' + m * L + t := by omega
          have : ((L * L : ℕ) : ℝ) ≤ ((N' + m * L + t : ℕ) : ℝ) := by exact_mod_cast this
          linarith
      _ = r / ((L * L : ℕ) : ℝ) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; ring
      _ ≤ L / ((L * L : ℕ) : ℝ) := by
          gcongr
      _ = 1 / L := by push_cast; field_simp
  calc |∑ i ∈ range N', G i + ∑ j ∈ range m, E j + ∑ t ∈ range r, G (N' + m * L + t)|
      ≤ |∑ i ∈ range N', G i| + |∑ j ∈ range m, E j| + |∑ t ∈ range r, G (N' + m * L + t)| :=
        abs_add_three _ _ _
    _ ≤ hR N' + hR N / L + 1 / L := by linarith

/-- `E^log_{n∈[N]} h(n) = (∑_{i<N} h(i+1)/(i+1)) / H_N`. -/
lemma logAvg_eq (N : ℕ) (h : ℤ → ℝ) :
    logAvg N h = (∑ i ∈ range N, 1 / ((i : ℝ) + 1) * h ((i : ℤ) + 1)) / hR N := by
  unfold logAvg wavg
  rw [sum_inv_Icc, sum_Icc_one_eq_sum_range]
  push_cast
  rfl

/-- The coefficients `c_j = (L/u_j)/H_N`. -/
noncomputable def cc (N N' L j : ℕ) : ℝ := (L : ℝ) / (uu N' L j : ℝ) / hR N

/-- **Steps 1–2 of P5b**: the logarithmic average over `[1, N]` is, up to
`ε = (H_{N'} + H_N/L + 1/L)/H_N`, a nonnegative combination of the uniform averages over the
blocks `[u_j, u_j + L)`, with total mass `≤ 2`. -/
lemma logAvg_approx (N N' L : ℕ) (hL : 1 ≤ L) (hLL : L * L ≤ N') (hN : N' ≤ N)
    (hH : 0 < hR N) (h : ℤ → ℝ) (hh : ∀ n, |h n| ≤ 1) :
    |logAvg N h - ∑ j ∈ range ((N - N') / L), cc N N' L j * favg (II N' L j) h| ≤
      (hR N' + hR N / L + 1 / L) / hR N := by
  rw [logAvg_eq]
  have hsum : ∑ j ∈ range ((N - N') / L), cc N N' L j * favg (II N' L j) h =
      (∑ j ∈ range ((N - N') / L), (L : ℝ) / (uu N' L j : ℝ) * favg (II N' L j) h) / hR N := by
    rw [Finset.sum_div]
    exact Finset.sum_congr rfl fun j _ => by unfold cc; ring
  rw [hsum, ← sub_div, abs_div, abs_of_pos hH]
  exact div_le_div_of_nonneg_right (decomp N N' L hL hLL hN h hh) hH.le

lemma cc_nonneg (N N' L j : ℕ) : 0 ≤ cc N N' L j := by
  unfold cc
  have := hR_nonneg N
  positivity

lemma cc_sum_le (N N' L : ℕ) (hLL : L * L ≤ N') (hN : N' ≤ N) (hH : 0 < hR N) :
    ∑ j ∈ range ((N - N') / L), cc N N' L j ≤ 2 := by
  have h := coef_le N N' L hLL hN
  unfold cc
  rw [← Finset.sum_div, div_le_iff₀ hH]
  exact h

end Decomp

/- ### The boxes: `Y ≤ p ≤ (4/3) Y` and log → uniform weights -/

section Boxes

lemma pow_le_four_thirds (k : ℕ) : (1 + 1 / (4 * (k : ℝ))) ^ k ≤ 4 / 3 := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · norm_num
  · have hk' : (0 : ℝ) < k := by exact_mod_cast hk
    have hk0 : (k : ℝ) ≠ 0 := hk'.ne'
    have h1 : 1 + 1 / (4 * (k : ℝ)) ≤ Real.exp (1 / (4 * (k : ℝ))) := by
      linarith [Real.add_one_le_exp (1 / (4 * (k : ℝ)))]
    have h2 : (1 + 1 / (4 * (k : ℝ))) ^ k ≤ Real.exp (1 / (4 * (k : ℝ))) ^ k :=
      pow_le_pow_left₀ (by positivity) h1 k
    have h3 : Real.exp (1 / (4 * (k : ℝ))) ^ k = Real.exp (1 / 4) := by
      rw [← Real.exp_nat_mul]
      congr 1
      field_simp
    have h4 : Real.exp (1 / 4 : ℝ) ≤ 4 / 3 := by
      have h5 := Real.add_one_le_exp (-1 / 4 : ℝ)
      have h6 : Real.exp (1 / 4 : ℝ) * Real.exp (-1 / 4) = 1 := by
        rw [← Real.exp_add]; norm_num
      nlinarith [Real.exp_pos (1 / 4 : ℝ), Real.exp_pos (-1 / 4 : ℝ)]
    linarith

/-- The elements of a `Good5` box: the box is nonempty and `Y ≤ p ≤ (4/3) Y` for
`Y = ∏ a_ℓ`. -/
lemma box_facts (D : Data) {a b : Fin D.k → ℕ} (hG : Good5 D a b) :
    (almostPrimes a b).Nonempty ∧ ∀ p ∈ almostPrimes a b,
      0 < p ∧ (∏ ℓ, (a ℓ : ℝ)) ≤ p ∧ 3 * (p : ℝ) ≤ 4 * ∏ ℓ, (a ℓ : ℝ) := by
  have ha3 : ∀ ℓ, 3 ≤ a ℓ := fun ℓ => D.hP₁'.trans ((D.hI ℓ).1.trans (hG ℓ).1)
  refine ⟨?_, ?_⟩
  · unfold almostPrimes FPDQ.boxProd
    refine Finset.Nonempty.image ?_ _
    rw [Fintype.piFinset_nonempty]
    intro ℓ
    apply Finset.card_pos.mp
    have h1 := (hG ℓ).2.2.2.2
    have h2 : 0 < Nat.sqrt D.P₁' := Nat.sqrt_pos.mpr (by have := D.hP₁'; omega)
    omega
  · intro p hp
    unfold almostPrimes FPDQ.boxProd at hp
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hp
    have hf' : ∀ ℓ, a ℓ ≤ f ℓ ∧ f ℓ < b ℓ := by
      intro ℓ
      have := Fintype.mem_piFinset.mp hf ℓ
      unfold primesIn at this
      rw [Finset.mem_filter, Finset.mem_Ico] at this
      exact this.1
    have hk : (0 : ℝ) < D.k := by exact_mod_cast D.hk
    refine ⟨Finset.prod_pos fun ℓ _ => by have := (hf' ℓ).1; have := ha3 ℓ; omega, ?_, ?_⟩
    · push_cast
      exact Finset.prod_le_prod (fun ℓ _ => by positivity) fun ℓ _ => by
        exact_mod_cast (hf' ℓ).1
    · push_cast
      have hb : ∀ ℓ, (b ℓ : ℝ) ≤ (1 + 1 / (4 * (D.k : ℝ))) * a ℓ := by
        intro ℓ
        have h := (hG ℓ).2.2.2.1
        have h' : (4 * D.k * b ℓ : ℝ) ≤ (4 * D.k + 1) * a ℓ := by exact_mod_cast h
        have h'' : (b ℓ : ℝ) - a ℓ ≤ a ℓ / (4 * D.k) := by
          rw [le_div_iff₀ (by positivity)]
          linarith
        calc (b ℓ : ℝ) = a ℓ + (b ℓ - a ℓ) := by ring
          _ ≤ a ℓ + a ℓ / (4 * D.k) := by linarith
          _ = (1 + 1 / (4 * (D.k : ℝ))) * a ℓ := by ring
      calc 3 * ∏ ℓ, (f ℓ : ℝ) ≤ 3 * ∏ ℓ, (b ℓ : ℝ) := by
            gcongr with ℓ
            exact_mod_cast (hf' ℓ).2.le
        _ ≤ 3 * ∏ ℓ, ((1 + 1 / (4 * (D.k : ℝ))) * a ℓ) := by
            gcongr with ℓ
            exact hb ℓ
        _ = 3 * ((1 + 1 / (4 * (D.k : ℝ))) ^ D.k * ∏ ℓ, (a ℓ : ℝ)) := by
            rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        _ ≤ 3 * ((4 / 3) * ∏ ℓ, (a ℓ : ℝ)) := by
            gcongr
            exact pow_le_four_thirds D.k
        _ = 4 * ∏ ℓ, (a ℓ : ℝ) := by ring

/-- Log weights as uniform weights: if `r p = Y/p` on `B`, then `E_B (r F) = (E_B r) E^log_B F`. -/
lemma favg_mul_eq_lavg {B : Finset ℕ} (hB : B.Nonempty) (hpos : ∀ p ∈ B, 0 < p) {r : ℕ → ℝ}
    {Y : ℝ} (hr : ∀ p ∈ B, r p = Y / p) (F : ℕ → ℝ) :
    favg B (fun p => r p * F p) = favg B r * lavg B F := by
  unfold favg lavg wavg
  have hS : 0 < ∑ p ∈ B, 1 / (p : ℝ) :=
    Finset.sum_pos (fun p hp => by have := hpos p hp; positivity) hB
  have hc : (0 : ℝ) < ∑ p ∈ B, (1 : ℝ) := by
    rw [Finset.sum_const, nsmul_eq_mul, mul_one]; exact_mod_cast hB.card_pos
  have e1 : ∑ p ∈ B, 1 * (r p * F p) = Y * ∑ p ∈ B, 1 / (p : ℝ) * F p := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun p hp => by rw [hr p hp]; ring
  have e2 : ∑ p ∈ B, 1 * r p = Y * ∑ p ∈ B, 1 / (p : ℝ) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun p hp => by rw [hr p hp]; ring
  rw [e1, e2]
  field_simp

/-- **Step 3 of P5b**: `E_{B₁} E_{B₂} r₁ r₂ G = (E r₁)(E r₂) E^log_{B₁} E^log_{B₂} G`. -/
lemma reweight {B₁ B₂ : Finset ℕ} (hB₁ : B₁.Nonempty) (hB₂ : B₂.Nonempty)
    (hpos₁ : ∀ p ∈ B₁, 0 < p) (hpos₂ : ∀ p ∈ B₂, 0 < p) {r₁ r₂ : ℕ → ℝ} {Y₁ Y₂ : ℝ}
    (hr₁ : ∀ p ∈ B₁, r₁ p = Y₁ / p) (hr₂ : ∀ p ∈ B₂, r₂ p = Y₂ / p) (G : ℕ → ℕ → ℝ) :
    (favg B₁ fun p₁ => favg B₂ fun p₂ => r₁ p₁ * r₂ p₂ * G p₁ p₂) =
      favg B₁ r₁ * favg B₂ r₂ * lavg B₁ fun p₁ => lavg B₂ fun p₂ => G p₁ p₂ := by
  have step1 : ∀ p₁, (favg B₂ fun p₂ => r₁ p₁ * r₂ p₂ * G p₁ p₂) =
      favg B₂ r₂ * (r₁ p₁ * lavg B₂ fun p₂ => G p₁ p₂) := by
    intro p₁
    have h := favg_mul_eq_lavg hB₂ hpos₂ hr₂ (fun p₂ => G p₁ p₂)
    rw [show (fun p₂ => r₁ p₁ * r₂ p₂ * G p₁ p₂) = fun p₂ => r₁ p₁ * (r₂ p₂ * G p₁ p₂) from
      funext fun p₂ => by ring, favg_smul', h]
    ring
  simp only [step1]
  rw [favg_smul', favg_mul_eq_lavg hB₁ hpos₁ hr₁]
  ring

end Boxes

/- ### The parameters `L = 3^⌈√(log N)⌉`, `N' = L²` -/

section Params

/-- The threshold `N₀ = ⌈exp(exp(10¹⁰))⌉`: then `ℓ = log log N ≥ 10¹⁰`. -/
noncomputable def N₀ : ℕ := ⌈Real.exp (Real.exp (10 ^ 10))⌉₊

lemma growth_exp (ℓ : ℝ) (hℓ : 10 ^ 10 ≤ ℓ) : (96 * ℓ ^ 4) ^ 2 ≤ Real.exp ℓ := by
  have h := Real.pow_div_factorial_le_exp ℓ (by linarith) 9
  have h9 : ((Nat.factorial 9 : ℕ) : ℝ) = 362880 := by norm_num [Nat.factorial]
  rw [h9] at h
  have hℓ8 : 0 ≤ ℓ ^ 8 := by positivity
  have : (96 * ℓ ^ 4) ^ 2 ≤ ℓ ^ 9 / 362880 := by
    rw [le_div_iff₀ (by norm_num)]
    have e : ℓ ^ 9 = ℓ * ℓ ^ 8 := by ring
    rw [e]
    nlinarith
  linarith

/-- **Parameters of P5b.** For `N ≥ N₀` put `y = log N`, `s = √y`, `a = ⌈s⌉`, `L = 3^a`,
`N' = L²`. Then `log N ≤ (log L)²`, `N' ≤ N`, and the error
`(H_{N'} + H_N/L + 1/L)/H_N ≤ 7/s ≤ δ⁴/8`, as `s ≥ 96 (log log N)⁴ ≥ 96 δ⁻⁴`. -/
lemma params (D : Data) (hN : N₀ ≤ D.N) :
    ∃ L N' : ℕ, 1 ≤ L ∧ L * L ≤ N' ∧ N' ≤ D.N ∧ Real.log D.N ≤ (Real.log L) ^ 2 ∧
      0 < hR D.N ∧ (hR N' + hR D.N / L + 1 / L) / hR D.N ≤ D.δ ^ 4 / 8 := by
  have hN' : ⌈Real.exp (Real.exp (10 ^ 10))⌉₊ ≤ D.N := hN
  have hNr : Real.exp (Real.exp (10 ^ 10)) ≤ (D.N : ℝ) :=
    (Nat.le_ceil _).trans (by exact_mod_cast hN')
  have hNpos : (0 : ℝ) < D.N := lt_of_lt_of_le (Real.exp_pos _) hNr
  have hy : Real.exp (10 ^ 10) ≤ Real.log D.N := (Real.le_log_iff_exp_le hNpos).mpr hNr
  have hypos : 0 < Real.log D.N := lt_of_lt_of_le (Real.exp_pos _) hy
  have hℓ : (10 : ℝ) ^ 10 ≤ Real.log (Real.log D.N) := (Real.le_log_iff_exp_le hypos).mpr hy
  have hexp : Real.exp (Real.log (Real.log D.N)) = Real.log D.N := Real.exp_log hypos
  have hδℓ : 1 / D.δ ≤ Real.log (Real.log D.N) := D.hδN
  set y := Real.log D.N with hy_def
  set ℓ := Real.log y with hℓ_def
  have hg : (96 * ℓ ^ 4) ^ 2 ≤ y := by
    calc (96 * ℓ ^ 4) ^ 2 ≤ Real.exp ℓ := growth_exp ℓ hℓ
      _ = y := hexp
  set s := Real.sqrt y with hs_def
  have hs0 : 0 ≤ s := Real.sqrt_nonneg y
  have hs : 96 * ℓ ^ 4 ≤ s := (Real.le_sqrt (by positivity) hypos.le).mpr hg
  have hs2 : s ^ 2 = y := Real.sq_sqrt hypos.le
  have hℓ1 : 1 ≤ ℓ := le_trans (by norm_num) hℓ
  have hℓ4 : 1 ≤ ℓ ^ 4 := one_le_pow₀ hℓ1
  have hs96 : 96 ≤ s := by linarith
  have hs1 : 1 ≤ s := by linarith
  have hss : 96 * s ≤ s ^ 2 := by rw [sq]; exact mul_le_mul_of_nonneg_right hs96 hs0
  set a := ⌈s⌉₊ with ha_def
  have ha1 : s ≤ a := Nat.le_ceil s
  have ha2 : (a : ℝ) < s + 1 := Nat.ceil_lt_add_one hs0
  -- `log 3 ∈ [1, 2]`
  have hlog3 : 1 ≤ Real.log 3 := by
    have : Real.exp 1 < 3 := lt_trans Real.exp_one_lt_d9 (by norm_num)
    exact ((Real.lt_log_iff_exp_lt (by norm_num)).mpr this).le
  have hlog3' : Real.log 3 ≤ 2 := by
    have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 3 by norm_num); linarith
  -- `L = 3^a`, `N' = L²`
  have hLpos : (0 : ℝ) < ((3 ^ a : ℕ) : ℝ) := by positivity
  have hlogL : Real.log ((3 ^ a : ℕ) : ℝ) = a * Real.log 3 := by
    push_cast; rw [Real.log_pow]
  have hlogN' : Real.log ((3 ^ a * 3 ^ a : ℕ) : ℝ) = 2 * (a * Real.log 3) := by
    push_cast; rw [Real.log_mul (by positivity) (by positivity), Real.log_pow]; ring
  have haL : (a : ℝ) ≤ ((3 ^ a : ℕ) : ℝ) := by
    exact_mod_cast (Nat.lt_pow_self (by norm_num : 1 < 3)).le
  -- harmonic numbers
  have hHN : y ≤ hR D.N := log_le_hR D.N
  have hHN' : hR (3 ^ a * 3 ^ a) ≤ 1 + 2 * (a * Real.log 3) := by
    have := hR_le (3 ^ a * 3 ^ a); rwa [hlogN'] at this
  have ha0 : (0 : ℝ) ≤ a := Nat.cast_nonneg a
  have halog : (a : ℝ) * Real.log 3 ≤ 2 * a := by
    have := mul_le_mul_of_nonneg_left hlog3' ha0; linarith
  refine ⟨3 ^ a, 3 ^ a * 3 ^ a, Nat.one_le_pow _ _ (by norm_num), le_rfl, ?_, ?_, ?_, ?_⟩
  · -- `N' ≤ N`
    have h1 : Real.log ((3 ^ a * 3 ^ a : ℕ) : ℝ) ≤ Real.log D.N := by
      rw [hlogN']
      linarith
    have h2 := (Real.log_le_log_iff (by positivity) hNpos).mp h1
    exact_mod_cast h2
  · -- `log N ≤ (log L)²`
    rw [hlogL]
    have h1 : s ≤ a * Real.log 3 := le_trans ha1 (le_mul_of_one_le_right ha0 hlog3)
    have h2 := pow_le_pow_left₀ hs0 h1 2
    linarith
  · -- `0 < H_N`
    linarith
  · -- the error
    set H := hR D.N with hH_def
    set H' := hR (3 ^ a * 3 ^ a) with hH'_def
    set Lr := ((3 ^ a : ℕ) : ℝ) with hLr_def
    have hδ := D.hδ
    have hℓδ : 1 ≤ ℓ * D.δ := by
      rw [div_le_iff₀ hδ] at hδℓ; linarith
    have hsδ : 96 ≤ s * D.δ ^ 4 := by
      have h1 : 1 ≤ (ℓ * D.δ) ^ 4 := one_le_pow₀ hℓδ
      have h2 : 96 * ℓ ^ 4 * D.δ ^ 4 ≤ s * D.δ ^ 4 :=
        mul_le_mul_of_nonneg_right hs (by positivity)
      have h3 : 96 * ℓ ^ 4 * D.δ ^ 4 = 96 * (ℓ * D.δ) ^ 4 := by ring
      linarith
    have hspos : 0 < s := by linarith
    have hHpos : 0 < H := by linarith
    have hsH : s ^ 2 ≤ H := by linarith
    have hH1 : 1 ≤ H := by linarith
    have hH'5 : H' ≤ 5 * s := by linarith
    have hsL : s ≤ Lr := le_trans ha1 haL
    have hLpos' : 0 < Lr := hLpos
    have e : (H' + H / Lr + 1 / Lr) / H = H' / H + 1 / Lr + 1 / (Lr * H) := by
      field_simp
    rw [e]
    have t1 : H' / H ≤ 5 / s := by
      rw [div_le_div_iff₀ hHpos hspos]
      have h1 : H' * s ≤ 5 * s * s := mul_le_mul_of_nonneg_right hH'5 hspos.le
      have h2 : 5 * s * s = 5 * s ^ 2 := by ring
      linarith
    have t2 : 1 / Lr ≤ 1 / s := one_div_le_one_div_of_le hspos hsL
    have t3 : 1 / (Lr * H) ≤ 1 / s :=
      one_div_le_one_div_of_le hspos (le_trans hsL (le_mul_of_one_le_right hLpos'.le hH1))
    have t4 : 5 / s + 1 / s + 1 / s ≤ D.δ ^ 4 / 8 := by
      rw [show 5 / s + 1 / s + 1 / s = 7 / s by ring, div_le_div_iff₀ hspos (by norm_num)]
      linarith
    linarith

end Params

/- ### The main argument -/

/-- The inner function `n ↦ f₁(np₂ + λxp₁) f₁(np₁ + λxp₂)` of (5.12)–(5.14). -/
def nfun (f₁ : ℤ → ℝ) (lam p₁ p₂ : ℕ) (x : ℤ) : ℤ → ℝ := fun n =>
  f₁ (n * p₂ + (lam : ℤ) * x * p₁) * f₁ (n * p₁ + (lam : ℤ) * x * p₂)

/-- (5.12) with the `n`-average replaced by the uniform average over the block `I`. -/
noncomputable def Mblk (f₁ ψ : ℤ → ℝ) (lam X : ℕ) (B₁ B₂ : Finset ℕ) (I : Finset ℤ) : ℝ :=
  lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg (win X) fun x => ψ x * favg I (nfun f₁ lam p₁ p₂ x)

lemma nfun_le (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (lam p₁ p₂ : ℕ) (x n : ℤ) :
    |nfun f₁ lam p₁ p₂ x n| ≤ 1 := by
  unfold nfun
  rw [abs_mul]
  exact mul_le_one₀ (hf₁ _) (abs_nonneg _) (hf₁ _)

/-- **Steps 1–2 of P5b, carried outside**: `lhs12 = ∑_j c_j M_j + R` with `|R| ≤ ε E|ψ|`. -/
lemma lhs12_split (D : Data) (f₁ ψ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (X : ℕ) (B₁ B₂ : Finset ℕ)
    (N' L : ℕ) (hL : 1 ≤ L) (hLL : L * L ≤ N') (hN : N' ≤ D.N) (hH : 0 < hR D.N) :
    ∃ R : ℝ, |R| ≤ (hR N' + hR D.N / L + 1 / L) / hR D.N * favg (win X) (fun x => |ψ x|) ∧
      lhs12 D f₁ ψ X B₁ B₂ = ∑ j ∈ range ((D.N - N') / L),
        cc D.N N' L j * Mblk f₁ ψ D.lam X B₁ B₂ (II N' L j) + R := by
  set m := (D.N - N') / L with hm
  set ε := (hR N' + hR D.N / L + 1 / L) / hR D.N with hε
  have hε0 : 0 ≤ ε := by
    have := hR_nonneg N'; have := hR_nonneg D.N; positivity
  refine ⟨lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg (win X) fun x => ψ x *
      (logAvg D.N (nfun f₁ D.lam p₁ p₂ x) -
        ∑ j ∈ range m, cc D.N N' L j * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x)), ?_, ?_⟩
  · -- the remainder
    have hw1 : ∀ p ∈ B₁, (0 : ℝ) ≤ 1 / (p : ℝ) := fun p _ => by positivity
    have hw2 : ∀ p ∈ B₂, (0 : ℝ) ≤ 1 / (p : ℝ) := fun p _ => by positivity
    have hw3 : ∀ x ∈ win X, (0 : ℝ) ≤ (fun _ => (1 : ℝ)) x := fun _ _ => zero_le_one
    have hC : 0 ≤ ε * favg (win X) (fun x => |ψ x|) :=
      mul_nonneg hε0 (favg_abs_nonneg _ _)
    refine abs_wavg_le_of_nn hw1 hC fun p₁ _ => abs_wavg_le_of_nn hw2 hC fun p₂ _ => ?_
    refine (abs_wavg_le_nn hw3 _).trans ?_
    rw [← favg_smul']
    refine wavg_mono_nn hw3 fun x _ => ?_
    rw [abs_mul, mul_comm ε]
    exact mul_le_mul_of_nonneg_left
      (logAvg_approx D.N N' L hL hLL hN hH _ (nfun_le f₁ hf₁ D.lam p₁ p₂ x)) (abs_nonneg _)
  · -- the identity
    have h1 : lhs12 D f₁ ψ X B₁ B₂ = lavg B₁ fun p₁ => lavg B₂ fun p₂ => favg (win X) fun x =>
        ∑ j ∈ range m, cc D.N N' L j * (ψ x * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x)) +
          ψ x * (logAvg D.N (nfun f₁ D.lam p₁ p₂ x) -
            ∑ j ∈ range m, cc D.N N' L j * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x)) := by
      unfold lhs12
      refine wavg_congr fun p₁ _ => wavg_congr fun p₂ _ => wavg_congr fun x _ => ?_
      show ψ x * logAvg D.N (nfun f₁ D.lam p₁ p₂ x) = _
      have hs : ∑ j ∈ range m, cc D.N N' L j * (ψ x * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x)) =
          ψ x * ∑ j ∈ range m, cc D.N N' L j * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [hs]
      ring
    rw [h1]
    exact triple_lincomb B₁ B₂ (win X) (range m) (cc D.N N' L)
      (fun j p₁ p₂ x => ψ x * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x))
      (fun p₁ p₂ x => ψ x * (logAvg D.N (nfun f₁ D.lam p₁ p₂ x) -
        ∑ j ∈ range m, cc D.N N' L j * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x)))

end P5b

open P5b Elem in
/-- **GS Proposition 5.1, step P5b** ((5.12) → (5.14)), with `N₀ = ⌈exp(exp(10¹⁰))⌉`,
`L = 3^⌈√(log N)⌉`, `N' = L²`, `u = N' + jL + 1` for a pigeonholed block `j`, and
`ρ(s, t) = min(1, Y₁/s) · min(1, Y₂/t)`, `Y_i = ∏ a_i`. -/
theorem stepP5b : StepP5b := by
  refine ⟨N₀, ?_⟩
  intro D hN f₁ hf₁ X hX1 hX2 ψ hψ a₁ b₁ a₂ b₂ hG₁ hG₂ hlhs
  obtain ⟨L, N', hL1, hLL, hN'N, hlogL, hHpos, hε⟩ := params D hN
  obtain ⟨hB₁, hB₁p⟩ := box_facts D hG₁
  obtain ⟨hB₂, hB₂p⟩ := box_facts D hG₂
  set B₁ := almostPrimes a₁ b₁ with hB₁def
  set B₂ := almostPrimes a₂ b₂ with hB₂def
  set Y₁ : ℝ := ∏ ℓ, (a₁ ℓ : ℝ) with hY₁
  set Y₂ : ℝ := ∏ ℓ, (a₂ ℓ : ℝ) with hY₂
  have hY₁0 : 0 ≤ Y₁ := Finset.prod_nonneg fun ℓ _ => Nat.cast_nonneg _
  have hY₂0 : 0 ≤ Y₂ := Finset.prod_nonneg fun ℓ _ => Nat.cast_nonneg _
  set r₁ : ℕ → ℝ := fun s => min 1 (Y₁ / s) with hr₁def
  set r₂ : ℕ → ℝ := fun s => min 1 (Y₂ / s) with hr₂def
  have hr01 : ∀ (Y : ℝ), 0 ≤ Y → ∀ s : ℕ, 0 ≤ min 1 (Y / s) ∧ min 1 (Y / s) ≤ 1 :=
    fun Y hY s => ⟨le_min zero_le_one (by positivity), min_le_left _ _⟩
  have hpos₁ : ∀ p ∈ B₁, 0 < p := fun p hp => (hB₁p p hp).1
  have hpos₂ : ∀ p ∈ B₂, 0 < p := fun p hp => (hB₂p p hp).1
  have hrB : ∀ (B : Finset ℕ) (Y : ℝ), (∀ p ∈ B, 0 < p ∧ Y ≤ p ∧ 3 * (p : ℝ) ≤ 4 * Y) →
      (∀ p ∈ B, min 1 (Y / p) = Y / p) ∧ ∀ p ∈ B, 3 / 4 ≤ min 1 (Y / p) := by
    intro B Y hB
    have e : ∀ p ∈ B, min 1 (Y / p) = Y / p := fun p hp => by
      obtain ⟨hp0, hYp, -⟩ := hB p hp
      have hp0' : (0 : ℝ) < p := by exact_mod_cast hp0
      exact min_eq_right ((div_le_one hp0').mpr hYp)
    refine ⟨e, fun p hp => ?_⟩
    obtain ⟨hp0, -, h3⟩ := hB p hp
    have hp0' : (0 : ℝ) < p := by exact_mod_cast hp0
    rw [e p hp, le_div_iff₀ hp0']
    linarith
  obtain ⟨hr₁B, hr₁34⟩ := hrB B₁ Y₁ hB₁p
  obtain ⟨hr₂B, hr₂34⟩ := hrB B₂ Y₂ hB₂p
  have hZ₁ : 3 / 4 ≤ favg B₁ r₁ := le_wavg_of_le ⟨fun _ _ => one_pos, hB₁⟩ hr₁34
  have hZ₂ : 3 / 4 ≤ favg B₂ r₂ := le_wavg_of_le ⟨fun _ _ => one_pos, hB₂⟩ hr₂34
  refine ⟨fun s t => r₁ s * r₂ t, fun s t => ?_, ?_⟩
  · have h1 := hr01 Y₁ hY₁0 s
    have h2 := hr01 Y₂ hY₂0 t
    rw [abs_of_nonneg (mul_nonneg h1.1 h2.1)]
    exact mul_le_one₀ h1.2 h2.1 h2.2
  -- steps 1–2: blocks
  obtain ⟨R, hRb, hsplit⟩ := lhs12_split D f₁ ψ hf₁ X B₁ B₂ N' L hL1 hLL hN'N hHpos
  have hδ := D.hδ
  have hδ3 : 0 < D.δ ^ 3 := by positivity
  have hRδ : |R| ≤ D.δ ^ 3 / 8 := by
    have hψ0 : 0 ≤ favg (win X) (fun x => |ψ x|) := favg_abs_nonneg _ _
    have hε0 : 0 ≤ (hR N' + hR D.N / L + 1 / L) / hR D.N := by
      have := hR_nonneg N'; have := hR_nonneg D.N; positivity
    calc |R| ≤ (hR N' + hR D.N / L + 1 / L) / hR D.N * favg (win X) (fun x => |ψ x|) := hRb
      _ ≤ D.δ ^ 4 / 8 * (1 / D.δ) := mul_le_mul hε hψ hψ0 (by positivity)
      _ = D.δ ^ 3 / 8 := by field_simp
  have hsum : 3 * D.δ ^ 3 / 8 ≤ |∑ j ∈ range ((D.N - N') / L),
      cc D.N N' L j * Mblk f₁ ψ D.lam X B₁ B₂ (II N' L j)| := by
    rw [hsplit] at hlhs
    have := abs_add_le (∑ j ∈ range ((D.N - N') / L),
      cc D.N N' L j * Mblk f₁ ψ D.lam X B₁ B₂ (II N' L j)) R
    linarith
  obtain ⟨j, -, hj⟩ := pigeon (fun j _ => cc_nonneg D.N N' L j) (cc_sum_le D.N N' L hLL hN'N hHpos)
    (by positivity) hsum
  -- step 3: log → uniform weights on `p'₁, p'₂`
  refine ⟨(uu N' L j : ℤ), L, hlogL, ?_⟩
  have h14 : lhs14 f₁ ψ D.lam X B₁ B₂ (fun s t => r₁ s * r₂ t) (uu N' L j : ℤ) L =
      favg B₁ r₁ * favg B₂ r₂ * Mblk f₁ ψ D.lam X B₁ B₂ (II N' L j) :=
    reweight hB₁ hB₂ hpos₁ hpos₂ hr₁B hr₂B
      (fun p₁ p₂ => favg (win X) fun x => ψ x * favg (II N' L j) (nfun f₁ D.lam p₁ p₂ x))
  have hZ0 : 0 ≤ favg B₁ r₁ * favg B₂ r₂ := mul_nonneg (by linarith) (by linarith)
  rw [h14, abs_mul, abs_of_nonneg hZ0]
  have hM : D.δ ^ 3 / 8 ≤ |Mblk f₁ ψ D.lam X B₁ B₂ (II N' L j)| := by linarith
  calc D.δ ^ 3 / 16 ≤ 3 / 4 * (3 / 4) * (D.δ ^ 3 / 8) := by linarith
    _ ≤ favg B₁ r₁ * favg B₂ r₂ * |Mblk f₁ ψ D.lam X B₁ B₂ (II N' L j)| :=
      mul_le_mul (mul_le_mul hZ₁ hZ₂ (by norm_num) (by linarith)) hM (by positivity) hZ0

end G22.P51

end

/- ## Section: `P51P5c` -/

section

/-
# Step P5c of GS Proposition 5.1

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, p. 19, (5.16) → (5.19) → (2.12).

We prove `G22.P51.stepP5c : StepP5c`: for 1-bounded `f₁`, `ψ`, `ρ`, if `τ ≤ |lhs14|` and the
shifts are small (`8(p₁T₁ + p₂T₂) ≤ τX`, `8λ(p₁T₂ + p₂T₁) ≤ τL` on `B₁ × B₂`), then
`(τ/2)⁴ ≤ box12 ψ X B₁ B₂ T₁ T₂`.

## Proof

1. For `t₁ ∈ [T₁]`, `t₂ ∈ [T₂]` substitute `x ↦ x + t₁p₁ + t₂p₂`, `n ↦ n - λ(p₁t₂ + p₂t₁)`
   (`Ksh_eq`): `np₂ + λxp₁ ↦ np₂ + λxp₁ + λt₁(p₁² - p₂²)` and
   `np₁ + λxp₂ ↦ np₁ + λxp₂ + λt₂(p₂² - p₁²)`. Shifting the two ranges back costs at most
   `2s/X + 2r/L ≤ τ/2` (GS (A.1), `Elem.uavg_shift_le`; `shift2`).
2. Averaging over `t₁, t₂` (`approx_p`) and using `|ρ| ≤ 1` gives `τ/2 ≤ |M|` with
   `M = E_{p₁,p₂} ρ E_{x,n} E_{t₁,t₂} ψ(x + t₁p₁ + t₂p₂) a(t₁) b(t₂)`.
3. Cauchy–Schwarz twice (`cs_two`) bounds `|E_{t₁,t₂} ψ(…) a(t₁) b(t₂)|⁴` by the box
   `E_{t₁,t₁',t₂,t₂'} ψψψψ` (`boxP`, independent of `n`); Jensen for `x ↦ x⁴` handles the outer
   averages.
4. `E_{p₁,p₂} E_x boxP = box12` by Fubini, as `ℕ → ℤ` is injective (`box12_eq`).
-/

open Finset Real

namespace G22.P51

namespace P5c

/- ### Uniform averages -/

section Generic

variable {α β γ δ : Type*}

lemma gw {s : Finset α} (hs : s.Nonempty) : GoodWeights s (fun _ => (1 : ℝ)) :=
  ⟨fun _ _ => one_pos, hs⟩

lemma favg_congr {s : Finset α} {f g : α → ℝ} (h : ∀ x ∈ s, f x = g x) :
    favg s f = favg s g :=
  wavg_congr h

lemma favg_const {s : Finset α} (hs : s.Nonempty) (c : ℝ) : favg s (fun _ => c) = c :=
  wavg_const (gw hs) c

lemma favg_mono {s : Finset α} (hs : s.Nonempty) {f g : α → ℝ} (h : ∀ x ∈ s, f x ≤ g x) :
    favg s f ≤ favg s g :=
  wavg_mono (gw hs) h

lemma favg_smul (s : Finset α) (c : ℝ) (f : α → ℝ) :
    favg s (fun x => c * f x) = c * favg s f :=
  wavg_smul c f

/-- Fubini. -/
lemma favg_comm (s : Finset α) (t : Finset β) (F : α → β → ℝ) :
    (favg s fun x => favg t fun y => F x y) = favg t fun y => favg s fun x => F x y :=
  Elem.wavg_comm s _ t _ F

lemma abs_favg_sub_le {s : Finset α} (hs : s.Nonempty) {f g : α → ℝ} {ε : ℝ}
    (h : ∀ x ∈ s, |f x - g x| ≤ ε) : |favg s f - favg s g| ≤ ε :=
  Elem.abs_wavg_sub_le (gw hs) h

lemma abs_favg_le {s : Finset α} (hs : s.Nonempty) {f : α → ℝ} {c : ℝ}
    (h : ∀ x ∈ s, |f x| ≤ c) : |favg s f| ≤ c :=
  abs_wavg_le_of_abs_le (gw hs) h

/-- Jensen: `(E f)² ≤ E f²`. -/
lemma favg_sq_le {s : Finset α} (hs : s.Nonempty) (f : α → ℝ) :
    (favg s f) ^ 2 ≤ favg s fun x => f x ^ 2 :=
  Elem.wavg_sq_le (gw hs) f

/-- `(E f)² = E_{x,y} f(x) f(y)`. -/
lemma favg_sq (s : Finset α) (f : α → ℝ) :
    (favg s f) ^ 2 = favg s fun x => favg s fun y => f x * f y :=
  L26.wavg_sq s _ f

/-- Jensen for `x ↦ x⁴`. -/
lemma favg_pow4_le {s : Finset α} (hs : s.Nonempty) (f : α → ℝ) :
    (favg s f) ^ 4 ≤ favg s fun x => f x ^ 4 := by
  have h1 := favg_sq_le hs f
  have h2 := favg_sq_le hs fun x => f x ^ 2
  calc (favg s f) ^ 4 = ((favg s f) ^ 2) ^ 2 := by ring
    _ ≤ (favg s fun x => f x ^ 2) ^ 2 := pow_le_pow_left₀ (sq_nonneg _) h1 2
    _ ≤ favg s fun x => (f x ^ 2) ^ 2 := h2
    _ = favg s fun x => f x ^ 4 := favg_congr fun x _ => by ring

lemma pow4_favg_le {s : Finset α} (hs : s.Nonempty) {f g : α → ℝ}
    (h : ∀ x ∈ s, f x ^ 4 ≤ g x) : (favg s f) ^ 4 ≤ favg s g :=
  (favg_pow4_le hs f).trans (favg_mono hs h)

lemma pow4_favg_le_const {s : Finset α} (hs : s.Nonempty) {f : α → ℝ} {c : ℝ}
    (h : ∀ x ∈ s, f x ^ 4 ≤ c) : (favg s f) ^ 4 ≤ c :=
  (favg_pow4_le hs f).trans (wavg_le_of_le (gw hs) h)

/-- Fubini for two double averages. -/
lemma favg22_comm (s₁ : Finset α) (s₂ : Finset β) (t₁ : Finset γ) (t₂ : Finset δ)
    (F : α → β → γ → δ → ℝ) :
    (favg s₁ fun a => favg s₂ fun b => favg t₁ fun c => favg t₂ fun d => F a b c d) =
      favg t₁ fun c => favg t₂ fun d => favg s₁ fun a => favg s₂ fun b => F a b c d := by
  calc (favg s₁ fun a => favg s₂ fun b => favg t₁ fun c => favg t₂ fun d => F a b c d)
      = favg s₁ fun a => favg t₁ fun c => favg t₂ fun d => favg s₂ fun b => F a b c d := by
        refine favg_congr fun a _ => ?_
        rw [favg_comm s₂ t₁]
        refine favg_congr fun c _ => ?_
        rw [favg_comm s₂ t₂]
    _ = favg t₁ fun c => favg s₁ fun a => favg t₂ fun d => favg s₂ fun b => F a b c d :=
        favg_comm s₁ t₁ _
    _ = favg t₁ fun c => favg t₂ fun d => favg s₁ fun a => favg s₂ fun b => F a b c d := by
        refine favg_congr fun c _ => ?_
        rw [favg_comm s₁ t₂]

/-- **Cauchy–Schwarz twice**: for 1-bounded `a`, `b`,
`|E_{i,j} Ψ(i,j) a(i) b(j)|⁴ ≤ E_{i,i',j,j'} Ψ(i,j) Ψ(i',j) Ψ(i,j') Ψ(i',j')`. -/
lemma cs_two {s : Finset α} {t : Finset β} (hs : s.Nonempty) (ht : t.Nonempty)
    (Ψ : α → β → ℝ) (a : α → ℝ) (b : β → ℝ) (ha : ∀ i, |a i| ≤ 1) (hb : ∀ j, |b j| ≤ 1) :
    (favg s fun i => favg t fun j => Ψ i j * (a i * b j)) ^ 4 ≤
      favg s fun i => favg s fun i' => favg t fun j => favg t fun j' =>
        Ψ i j * Ψ i' j * Ψ i j' * Ψ i' j' := by
  have ha2 : ∀ i, a i ^ 2 ≤ 1 := fun i => by
    have := ha i
    rw [← sq_abs]
    nlinarith [abs_nonneg (a i)]
  have hb2 : ∀ j, b j ^ 2 ≤ 1 := fun j => by
    have := hb j
    rw [← sq_abs]
    nlinarith [abs_nonneg (b j)]
  -- first Cauchy–Schwarz (in `i`)
  have hW : (favg s fun i => favg t fun j => Ψ i j * (a i * b j)) =
      favg s fun i => a i * favg t fun j => Ψ i j * b j := by
    refine favg_congr fun i _ => ?_
    rw [← favg_smul]
    exact favg_congr fun j _ => by ring
  have h1 : (favg s fun i => a i * favg t fun j => Ψ i j * b j) ^ 2 ≤
      favg s fun i => (favg t fun j => Ψ i j * b j) ^ 2 := by
    refine (favg_sq_le hs _).trans (favg_mono hs fun i _ => ?_)
    rw [mul_pow]
    have := sq_nonneg (favg t fun j => Ψ i j * b j)
    nlinarith [ha2 i]
  have h2 : (favg s fun i => (favg t fun j => Ψ i j * b j) ^ 2) =
      favg t fun j => favg t fun j' => (b j * b j') * favg s fun i => Ψ i j * Ψ i j' := by
    calc (favg s fun i => (favg t fun j => Ψ i j * b j) ^ 2)
        = favg s fun i => favg t fun j => favg t fun j' => (Ψ i j * b j) * (Ψ i j' * b j') :=
          favg_congr fun i _ => favg_sq t _
      _ = favg t fun j => favg t fun j' => favg s fun i => (Ψ i j * b j) * (Ψ i j' * b j') := by
          rw [favg_comm s t]
          refine favg_congr fun j _ => ?_
          rw [favg_comm s t]
      _ = favg t fun j => favg t fun j' => (b j * b j') * favg s fun i => Ψ i j * Ψ i j' := by
          refine favg_congr fun j _ => favg_congr fun j' _ => ?_
          rw [← favg_smul]
          exact favg_congr fun i _ => by ring
  -- second Cauchy–Schwarz (in `(j, j')`)
  have h3 : (favg t fun j => favg t fun j' => (b j * b j') * favg s fun i => Ψ i j * Ψ i j') ^ 2 ≤
      favg t fun j => favg t fun j' => (favg s fun i => Ψ i j * Ψ i j') ^ 2 := by
    refine (favg_sq_le ht _).trans (favg_mono ht fun j _ => ?_)
    refine (favg_sq_le ht _).trans (favg_mono ht fun j' _ => ?_)
    rw [mul_pow, mul_pow]
    have := sq_nonneg (favg s fun i => Ψ i j * Ψ i j')
    have hbb : b j ^ 2 * b j' ^ 2 ≤ 1 := by
      nlinarith [hb2 j, hb2 j', sq_nonneg (b j), sq_nonneg (b j')]
    nlinarith [sq_nonneg (b j), sq_nonneg (b j')]
  have h4 : (favg t fun j => favg t fun j' => (favg s fun i => Ψ i j * Ψ i j') ^ 2) =
      favg s fun i => favg s fun i' => favg t fun j => favg t fun j' =>
        Ψ i j * Ψ i' j * Ψ i j' * Ψ i' j' := by
    calc (favg t fun j => favg t fun j' => (favg s fun i => Ψ i j * Ψ i j') ^ 2)
        = favg t fun j => favg t fun j' => favg s fun i => favg s fun i' =>
            Ψ i j * Ψ i' j * Ψ i j' * Ψ i' j' := by
          refine favg_congr fun j _ => favg_congr fun j' _ => ?_
          rw [favg_sq]
          exact favg_congr fun i _ => favg_congr fun i' _ => by ring
      _ = _ := favg22_comm t t s s fun j j' i i' => Ψ i j * Ψ i' j * Ψ i j' * Ψ i' j'
  calc (favg s fun i => favg t fun j => Ψ i j * (a i * b j)) ^ 4
      = ((favg s fun i => a i * favg t fun j => Ψ i j * b j) ^ 2) ^ 2 := by rw [hW]; ring
    _ ≤ (favg s fun i => (favg t fun j => Ψ i j * b j) ^ 2) ^ 2 :=
        pow_le_pow_left₀ (sq_nonneg _) h1 2
    _ = (favg t fun j => favg t fun j' => (b j * b j') * favg s fun i => Ψ i j * Ψ i j') ^ 2 := by
        rw [h2]
    _ ≤ _ := h3
    _ = _ := h4

end Generic

/- ### Shifting the ranges: GS (A.1) -/

section Shift

lemma sum_Ico_eq_sum_Icc (a : ℤ) (L : ℕ) (F : ℤ → ℝ) :
    ∑ n ∈ Ico a (a + L), F n = ∑ h ∈ Icc 1 L, F (a - 1 + h) := by
  refine Finset.sum_nbij' (fun n => (n - a + 1).toNat) (fun h => a - 1 + h) ?_ ?_ ?_ ?_ ?_
  · intro n hn
    simp only [mem_Ico] at hn
    simp only [mem_Icc]
    omega
  · intro h hh
    simp only [mem_Icc] at hh
    simp only [mem_Ico]
    omega
  · intro n hn
    simp only [mem_Ico] at hn
    omega
  · intro h hh
    simp only [mem_Icc] at hh
    omega
  · intro n hn
    simp only [mem_Ico] at hn
    congr 1
    omega

lemma favg_Ico_eq_uavg (a : ℤ) (L : ℕ) (F : ℤ → ℝ) :
    favg (Ico a (a + L)) F = uavg L fun h => F (a - 1 + h) := by
  unfold favg uavg wavg
  congr 1
  · exact sum_Ico_eq_sum_Icc a L _
  · exact sum_Ico_eq_sum_Icc a L _

/-- GS (A.1) on an interval `[a, a + L)` of `ℤ`. -/
lemma favg_Ico_shift (a : ℤ) (L : ℕ) (g : ℤ → ℝ) (hg : ∀ n, |g n| ≤ 1) (s : ℤ) :
    |favg (Ico a (a + L)) (fun n => g (n + s)) - favg (Ico a (a + L)) g| ≤
      2 * |(s : ℝ)| / L := by
  rw [favg_Ico_eq_uavg, favg_Ico_eq_uavg]
  have key := Elem.uavg_shift_le L (fun m => g (a - 1 + m)) (fun _ => hg _) s
  simpa only [add_assoc] using key

/-- The average `E_{x ∈ [X, 2X)} E_{n ∈ [u, u + L)} F(x, n)`. -/
noncomputable def XN (X : ℕ) (u : ℤ) (L : ℕ) (F : ℤ → ℤ → ℝ) : ℝ :=
  favg (win X) fun x => favg (Ico u (u + L)) fun n => F x n

lemma win_eq (X : ℕ) : win X = Ico (X : ℤ) ((X : ℤ) + (X : ℕ)) := by
  unfold win
  congr 1
  ring

lemma win_nonempty {X : ℕ} (hX : 1 ≤ X) : (win X).Nonempty := by
  unfold win
  exact nonempty_Ico.mpr (by omega)

lemma Ico_nonempty {u : ℤ} {L : ℕ} (hL : 1 ≤ L) : (Ico u (u + L)).Nonempty :=
  nonempty_Ico.mpr (by omega)

lemma Icc_nonempty {T : ℕ} (hT : 1 ≤ T) : (Icc 1 T).Nonempty := nonempty_Icc.mpr hT

/-- Shifting both ranges of `XN` (GS (A.1) twice). -/
lemma shift2 (H : ℤ → ℤ → ℝ) (hH : ∀ x n, |H x n| ≤ 1) {X L : ℕ} (hX : 1 ≤ X) (hL : 1 ≤ L)
    (u s r : ℤ) :
    |XN X u L (fun x n => H (x + s) (n + r)) - XN X u L H| ≤
      2 * |(s : ℝ)| / X + 2 * |(r : ℝ)| / L := by
  have e1 : |XN X u L (fun x n => H (x + s) (n + r)) - XN X u L (fun x n => H (x + s) n)| ≤
      2 * |(r : ℝ)| / L :=
    abs_favg_sub_le (win_nonempty hX) fun x _ => favg_Ico_shift u L (H (x + s)) (hH _) r
  have e2 : |XN X u L (fun x n => H (x + s) n) - XN X u L H| ≤ 2 * |(s : ℝ)| / X := by
    unfold XN
    rw [win_eq]
    exact favg_Ico_shift X X (fun x => favg (Ico u (u + L)) fun n => H x n)
      (fun x => abs_favg_le (Ico_nonempty hL) fun n _ => hH x n) s
  calc _ ≤ |XN X u L (fun x n => H (x + s) (n + r)) - XN X u L (fun x n => H (x + s) n)| +
        |XN X u L (fun x n => H (x + s) n) - XN X u L H| := abs_sub_le _ _ _
    _ ≤ _ := by linarith

end Shift

/- ### The substitution -/

/-- `ψ(x) f₁(np₂ + λxp₁) f₁(np₁ + λxp₂)`, the integrand of `lhs14`. -/
noncomputable def Hf (f₁ ψ : ℤ → ℝ) (lam p₁ p₂ : ℕ) (x n : ℤ) : ℝ :=
  ψ x * (f₁ (n * p₂ + (lam : ℤ) * x * p₁) * f₁ (n * p₁ + (lam : ℤ) * x * p₂))

/-- The integrand after the substitution `x ↦ x + t₁p₁ + t₂p₂`, `n ↦ n - λ(p₁t₂ + p₂t₁)`. -/
noncomputable def Ksh (f₁ ψ : ℤ → ℝ) (lam p₁ p₂ t₁ t₂ : ℕ) (x n : ℤ) : ℝ :=
  Hf f₁ ψ lam p₁ p₂ (x + ((t₁ : ℤ) * p₁ + (t₂ : ℤ) * p₂))
    (n + -((lam : ℤ) * ((p₁ : ℤ) * t₂ + (p₂ : ℤ) * t₁)))

/-- The substitution (GS (5.19)). -/
lemma Ksh_eq (f₁ ψ : ℤ → ℝ) (lam p₁ p₂ t₁ t₂ : ℕ) (x n : ℤ) :
    Ksh f₁ ψ lam p₁ p₂ t₁ t₂ x n = ψ (x + t₁ * p₁ + t₂ * p₂) *
      (f₁ (n * p₂ + (lam : ℤ) * x * p₁ + (lam : ℤ) * t₁ * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
        f₁ (n * p₁ + (lam : ℤ) * x * p₂ + (lam : ℤ) * t₂ * ((p₂ : ℤ) ^ 2 - (p₁ : ℤ) ^ 2))) := by
  unfold Ksh Hf
  have e1 : (n + -((lam : ℤ) * ((p₁ : ℤ) * t₂ + (p₂ : ℤ) * t₁))) * p₂ +
      (lam : ℤ) * (x + ((t₁ : ℤ) * p₁ + (t₂ : ℤ) * p₂)) * p₁ =
      n * p₂ + (lam : ℤ) * x * p₁ + (lam : ℤ) * t₁ * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2) := by ring
  have e2 : (n + -((lam : ℤ) * ((p₁ : ℤ) * t₂ + (p₂ : ℤ) * t₁))) * p₁ +
      (lam : ℤ) * (x + ((t₁ : ℤ) * p₁ + (t₂ : ℤ) * p₂)) * p₂ =
      n * p₁ + (lam : ℤ) * x * p₂ + (lam : ℤ) * t₂ * ((p₂ : ℤ) ^ 2 - (p₁ : ℤ) ^ 2) := by ring
  have e0 : x + ((t₁ : ℤ) * p₁ + (t₂ : ℤ) * p₂) = x + t₁ * p₁ + t₂ * p₂ := by ring
  rw [e1, e2, e0]

lemma abs_Hf_le (f₁ ψ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (hψ : ∀ n, |ψ n| ≤ 1)
    (lam p₁ p₂ : ℕ) (x n : ℤ) : |Hf f₁ ψ lam p₁ p₂ x n| ≤ 1 :=
  Elem.abs_mul_le_one (hψ _) (Elem.abs_mul_le_one (hf₁ _) (hf₁ _))

/-- The substituted integrand, averaged over `t₁ ∈ [T₁]`, `t₂ ∈ [T₂]`. -/
noncomputable def Vt (f₁ ψ : ℤ → ℝ) (lam T₁ T₂ p₁ p₂ : ℕ) (x n : ℤ) : ℝ :=
  favg (Icc 1 T₁) fun t₁ => favg (Icc 1 T₂) fun t₂ => Ksh f₁ ψ lam p₁ p₂ t₁ t₂ x n

/-- Steps 1–2 for fixed `(p₁, p₂)`: the substitution costs at most `τ/2`. -/
lemma approx_p (f₁ ψ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (hψ : ∀ n, |ψ n| ≤ 1)
    {lam X : ℕ} (u : ℤ) {L T₁ T₂ : ℕ} (hX : 1 ≤ X) (hL : 1 ≤ L) (hT₁ : 1 ≤ T₁) (hT₂ : 1 ≤ T₂)
    {τ : ℝ} {p₁ p₂ : ℕ}
    (hs : 8 * ((p₁ * T₁ + p₂ * T₂ : ℕ) : ℝ) ≤ τ * X)
    (hr : 8 * ((lam * (p₁ * T₂ + p₂ * T₁) : ℕ) : ℝ) ≤ τ * L) :
    |XN X u L (Hf f₁ ψ lam p₁ p₂) - XN X u L (Vt f₁ ψ lam T₁ T₂ p₁ p₂)| ≤ τ / 2 := by
  have hXpos : (0 : ℝ) < X := by exact_mod_cast hX
  have hLpos : (0 : ℝ) < L := by exact_mod_cast hL
  have hF : XN X u L (Vt f₁ ψ lam T₁ T₂ p₁ p₂) =
      favg (Icc 1 T₁) fun t₁ => favg (Icc 1 T₂) fun t₂ => XN X u L (Ksh f₁ ψ lam p₁ p₂ t₁ t₂) :=
    favg22_comm (win X) (Ico u (u + L)) (Icc 1 T₁) (Icc 1 T₂)
      fun x n t₁ t₂ => Ksh f₁ ψ lam p₁ p₂ t₁ t₂ x n
  have hC : XN X u L (Hf f₁ ψ lam p₁ p₂) =
      favg (Icc 1 T₁) fun _ => favg (Icc 1 T₂) fun _ => XN X u L (Hf f₁ ψ lam p₁ p₂) := by
    rw [favg_const (Icc_nonempty hT₂), favg_const (Icc_nonempty hT₁)]
  rw [hF, hC]
  refine abs_favg_sub_le (Icc_nonempty hT₁) fun t₁ ht₁ =>
    abs_favg_sub_le (Icc_nonempty hT₂) fun t₂ ht₂ => ?_
  rw [abs_sub_comm]
  have key := shift2 (Hf f₁ ψ lam p₁ p₂) (abs_Hf_le f₁ ψ hf₁ hψ lam p₁ p₂) hX hL u
    ((t₁ : ℤ) * p₁ + (t₂ : ℤ) * p₂) (-((lam : ℤ) * ((p₁ : ℤ) * t₂ + (p₂ : ℤ) * t₁)))
  refine le_trans key ?_
  have ht₁' : (t₁ : ℝ) ≤ T₁ := by exact_mod_cast (mem_Icc.mp ht₁).2
  have ht₂' : (t₂ : ℝ) ≤ T₂ := by exact_mod_cast (mem_Icc.mp ht₂).2
  have hs' : 8 * ((p₁ : ℝ) * T₁ + p₂ * T₂) ≤ τ * X := by exact_mod_cast hs
  have hr' : 8 * ((lam : ℝ) * (p₁ * T₂ + p₂ * T₁)) ≤ τ * L := by exact_mod_cast hr
  have e1 : |((((t₁ : ℤ) * p₁ + (t₂ : ℤ) * p₂ : ℤ)) : ℝ)| = (t₁ : ℝ) * p₁ + t₂ * p₂ := by
    push_cast
    exact abs_of_nonneg (by positivity)
  have e2 : |((-((lam : ℤ) * ((p₁ : ℤ) * t₂ + (p₂ : ℤ) * t₁)) : ℤ) : ℝ)| =
      (lam : ℝ) * (p₁ * t₂ + p₂ * t₁) := by
    push_cast
    rw [abs_neg]
    exact abs_of_nonneg (by positivity)
  rw [e1, e2]
  have b1 : 2 * ((t₁ : ℝ) * p₁ + t₂ * p₂) / X ≤ τ / 4 := by
    rw [div_le_iff₀ hXpos]
    have : (t₁ : ℝ) * p₁ ≤ T₁ * p₁ := mul_le_mul_of_nonneg_right ht₁' (Nat.cast_nonneg _)
    have : (t₂ : ℝ) * p₂ ≤ T₂ * p₂ := mul_le_mul_of_nonneg_right ht₂' (Nat.cast_nonneg _)
    nlinarith
  have b2 : 2 * ((lam : ℝ) * (p₁ * t₂ + p₂ * t₁)) / L ≤ τ / 4 := by
    rw [div_le_iff₀ hLpos]
    have : (p₁ : ℝ) * t₂ ≤ p₁ * T₂ := mul_le_mul_of_nonneg_left ht₂' (Nat.cast_nonneg _)
    have : (p₂ : ℝ) * t₁ ≤ p₂ * T₁ := mul_le_mul_of_nonneg_left ht₁' (Nat.cast_nonneg _)
    have : (lam : ℝ) * (p₁ * t₂ + p₂ * t₁) ≤ lam * (p₁ * T₂ + p₂ * T₁) :=
      mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg _)
    nlinarith
  linarith

/-- `lhs14` in terms of `XN` and `Hf`. -/
lemma lhs14_eq (f₁ ψ : ℤ → ℝ) (lam X : ℕ) (B₁ B₂ : Finset ℕ) (ρ : ℕ → ℕ → ℝ) (u : ℤ) (L : ℕ) :
    lhs14 f₁ ψ lam X B₁ B₂ ρ u L =
      favg B₁ fun p₁ => favg B₂ fun p₂ => ρ p₁ p₂ * XN X u L (Hf f₁ ψ lam p₁ p₂) := by
  unfold lhs14
  refine favg_congr fun p₁ _ => favg_congr fun p₂ _ => ?_
  congr 1
  unfold XN Hf
  refine favg_congr fun x _ => ?_
  exact (favg_smul _ _ _).symm

/- ### The box -/

/-- `E_{t₁,t₁'∈[T₁], t₂,t₂'∈[T₂]} Δ_{p₁(t₁,t₁')} Δ_{p₂(t₂,t₂')} ψ(x)`. -/
noncomputable def boxP (ψ : ℤ → ℝ) (T₁ T₂ p₁ p₂ : ℕ) (x : ℤ) : ℝ :=
  favg (Icc 1 T₁) fun t₁ => favg (Icc 1 T₁) fun t₁' => favg (Icc 1 T₂) fun t₂ =>
    favg (Icc 1 T₂) fun t₂' =>
      ψ (x + t₁ * p₁ + t₂ * p₂) * ψ (x + t₁' * p₁ + t₂ * p₂) * ψ (x + t₁ * p₁ + t₂' * p₂) *
        ψ (x + t₁' * p₁ + t₂' * p₂)

/-- Step 3 (Cauchy–Schwarz twice) for fixed `p₁, p₂, x, n`. -/
lemma Vt_pow4_le (f₁ ψ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (lam : ℕ) {T₁ T₂ : ℕ} (hT₁ : 1 ≤ T₁)
    (hT₂ : 1 ≤ T₂) (p₁ p₂ : ℕ) (x n : ℤ) :
    (Vt f₁ ψ lam T₁ T₂ p₁ p₂ x n) ^ 4 ≤ boxP ψ T₁ T₂ p₁ p₂ x := by
  have e : Vt f₁ ψ lam T₁ T₂ p₁ p₂ x n = favg (Icc 1 T₁) fun t₁ => favg (Icc 1 T₂) fun t₂ =>
      ψ (x + t₁ * p₁ + t₂ * p₂) *
        (f₁ (n * p₂ + (lam : ℤ) * x * p₁ + (lam : ℤ) * t₁ * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)) *
          f₁ (n * p₁ + (lam : ℤ) * x * p₂ + (lam : ℤ) * t₂ * ((p₂ : ℤ) ^ 2 - (p₁ : ℤ) ^ 2))) := by
    unfold Vt
    refine favg_congr fun t₁ _ => favg_congr fun t₂ _ => ?_
    rw [Ksh_eq]
  rw [e]
  exact cs_two (Icc_nonempty hT₁) (Icc_nonempty hT₂) (fun t₁ t₂ : ℕ => ψ (x + t₁ * p₁ + t₂ * p₂))
    (fun t₁ : ℕ => f₁ (n * p₂ + (lam : ℤ) * x * p₁ + (lam : ℤ) * t₁ * ((p₁ : ℤ) ^ 2 - (p₂ : ℤ) ^ 2)))
    (fun t₂ : ℕ => f₁ (n * p₁ + (lam : ℤ) * x * p₂ + (lam : ℤ) * t₂ * ((p₂ : ℤ) ^ 2 - (p₁ : ℤ) ^ 2)))
    (fun _ => hf₁ _) (fun _ => hf₁ _)

/- ### `box12` -/

lemma uavg_eq_favg (H : ℕ) (f : ℕ → ℝ) : uavg H f = favg (Icc 1 H) f := rfl

lemma dAvg_eq_favg (X : ℕ) (F : ℕ → ℝ) : L26.dAvg X F = favg (Ico X (2 * X)) F := rfl

/-- `E_{p₁∈B₁} E_{p₂∈B₂}` as an operator (for rewriting under binders). -/
noncomputable def EP (B₁ B₂ : Finset ℕ) (F : ℕ → ℕ → ℝ) : ℝ :=
  favg B₁ fun p₁ => favg B₂ fun p₂ => F p₁ p₂

lemma favg_EP {γ : Type*} (s : Finset γ) (B₁ B₂ : Finset ℕ) (F : γ → ℕ → ℕ → ℝ) :
    (favg s fun z => EP B₁ B₂ (F z)) = EP B₁ B₂ fun p₁ p₂ => favg s fun z => F z p₁ p₂ := by
  unfold EP
  rw [favg_comm s B₁]
  refine favg_congr fun p₁ _ => ?_
  rw [favg_comm s B₂]

lemma sum_image_div (B₁ B₂ : Finset ℕ) (F : ℤ → ℤ → ℝ) :
    (∑ s₁ ∈ B₁.image (fun s : ℕ => (s : ℤ)), ∑ s₂ ∈ B₂.image (fun s : ℕ => (s : ℤ)), F s₁ s₂) /
      (((B₁.image fun s : ℕ => (s : ℤ)).card : ℝ) * ((B₂.image fun s : ℕ => (s : ℤ)).card : ℝ)) =
    EP B₁ B₂ fun p₁ p₂ => F p₁ p₂ := by
  have hinj : Function.Injective (fun s : ℕ => (s : ℤ)) := Nat.cast_injective
  rw [Finset.card_image_of_injective _ hinj, Finset.card_image_of_injective _ hinj,
    Finset.sum_image (hinj.injOn)]
  have e : ∀ p₁ : ℕ, ∑ s₂ ∈ B₂.image (fun s : ℕ => (s : ℤ)), F (p₁ : ℤ) s₂ =
      ∑ p₂ ∈ B₂, F p₁ p₂ := fun p₁ => Finset.sum_image hinj.injOn
  simp only [e]
  exact L26.sum_sum_div_card_eq B₁ B₂ _

lemma favg_nat_win (X : ℕ) (Φ : ℤ → ℝ) :
    favg (Ico X (2 * X)) (fun n : ℕ => Φ n) = favg (win X) Φ := by
  unfold favg wavg win
  have key : ∀ G : ℤ → ℝ, ∑ n ∈ Ico X (2 * X), G n = ∑ x ∈ Ico (X : ℤ) (2 * X), G x := by
    intro G
    refine Finset.sum_nbij' (fun n : ℕ => (n : ℤ)) (fun x : ℤ => x.toNat) ?_ ?_ ?_ ?_ ?_
    · intro n hn
      simp only [mem_Ico] at hn ⊢
      omega
    · intro x hx
      simp only [mem_Ico] at hx ⊢
      omega
    · intro n _
      simp
    · intro x hx
      simp only [mem_Ico] at hx
      omega
    · intro n _
      rfl
  congr 1
  · exact key fun x => 1 * Φ x
  · exact key fun _ => 1

/-- Step 4: `box12` is `E_{p₁∈B₁} E_{p₂∈B₂} E_{x∈[X,2X)} boxP`. -/
lemma box12_eq (ψ : ℤ → ℝ) (X : ℕ) (B₁ B₂ : Finset ℕ) (T₁ T₂ : ℕ) :
    box12 ψ X (B₁.image fun s : ℕ => (s : ℤ)) (B₂.image fun s : ℕ => (s : ℤ)) T₁ T₂ =
      favg B₁ fun p₁ => favg B₂ fun p₂ => favg (win X) fun x => boxP ψ T₁ T₂ p₁ p₂ x := by
  unfold box12
  simp only [sum_image_div, uavg_eq_favg, dAvg_eq_favg]
  simp only [favg_EP]
  unfold EP
  refine favg_congr fun p₁ _ => favg_congr fun p₂ _ => ?_
  exact favg_nat_win X fun x => boxP ψ T₁ T₂ p₁ p₂ x

end P5c

/-- **Step P5c** (GS p. 19, (5.16) → (5.19) → (2.12)). -/
theorem stepP5c : StepP5c := by
  intro f₁ ψ hf₁ hψ B₁ B₂ hB₁ hB₂ ρ hρ lam X u L T₁ T₂ hX hL hT₁ hT₂ τ hτ hsX hrL hlhs
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = favg B₁ fun p₁ => favg B₂ fun p₂ =>
      ρ p₁ p₂ * P5c.XN X u L (P5c.Vt f₁ ψ lam T₁ T₂ p₁ p₂) := ⟨_, rfl⟩
  -- steps 1–2
  have hdiff : |lhs14 f₁ ψ lam X B₁ B₂ ρ u L - M| ≤ τ / 2 := by
    rw [P5c.lhs14_eq, hMdef]
    refine P5c.abs_favg_sub_le hB₁ fun p₁ hp₁ => P5c.abs_favg_sub_le hB₂ fun p₂ hp₂ => ?_
    rw [← mul_sub, abs_mul]
    have h1 := P5c.approx_p f₁ ψ hf₁ hψ u hX hL hT₁ hT₂ (hsX p₁ hp₁ p₂ hp₂) (hrL p₁ hp₁ p₂ hp₂)
    calc |ρ p₁ p₂| * |P5c.XN X u L (P5c.Hf f₁ ψ lam p₁ p₂) -
          P5c.XN X u L (P5c.Vt f₁ ψ lam T₁ T₂ p₁ p₂)|
        ≤ 1 * (τ / 2) := mul_le_mul (hρ _ _) h1 (abs_nonneg _) zero_le_one
      _ = τ / 2 := one_mul _
  have hM : τ / 2 ≤ |M| := by
    have := abs_sub_abs_le_abs_sub (lhs14 f₁ ψ lam X B₁ B₂ ρ u L) M
    linarith
  -- step 3
  have h4 : M ^ 4 ≤ favg B₁ fun p₁ => favg B₂ fun p₂ => favg (win X) fun x =>
      P5c.boxP ψ T₁ T₂ p₁ p₂ x := by
    rw [hMdef]
    refine P5c.pow4_favg_le hB₁ fun p₁ _ => P5c.pow4_favg_le hB₂ fun p₂ _ => ?_
    have hXN : (P5c.XN X u L (P5c.Vt f₁ ψ lam T₁ T₂ p₁ p₂)) ^ 4 ≤
        favg (win X) fun x => P5c.boxP ψ T₁ T₂ p₁ p₂ x :=
      P5c.pow4_favg_le (P5c.win_nonempty hX) fun x _ =>
        P5c.pow4_favg_le_const (P5c.Ico_nonempty hL) fun n _ =>
          P5c.Vt_pow4_le f₁ ψ hf₁ lam hT₁ hT₂ p₁ p₂ x n
    have hρ2 : ρ p₁ p₂ ^ 2 ≤ 1 := by
      have := hρ p₁ p₂
      rw [← sq_abs]
      nlinarith [abs_nonneg (ρ p₁ p₂)]
    have hρ4 : ρ p₁ p₂ ^ 4 ≤ 1 := by nlinarith [sq_nonneg (ρ p₁ p₂)]
    have h0 : 0 ≤ (P5c.XN X u L (P5c.Vt f₁ ψ lam T₁ T₂ p₁ p₂)) ^ 4 := by positivity
    have h0' : 0 ≤ ρ p₁ p₂ ^ 4 := by positivity
    rw [mul_pow]
    nlinarith
  -- step 4
  rw [P5c.box12_eq]
  calc (τ / 2) ^ 4 ≤ |M| ^ 4 := pow_le_pow_left₀ (by positivity) hM 4
    _ = M ^ 4 := Even.pow_abs ⟨2, rfl⟩ M
    _ ≤ _ := h4

end G22.P51

end

/- ## Section: `P51P5d` -/

section

/-
# Step `StepP5d` of GS Proposition 5.1 (the Fourier bound (5.20) → (5.18))

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, pp. 20–21. This file proves
`stepP5d : StepP5d`: for `H ≥ 1`, `2H + 1 ≤ X` and a 1-bounded `ψ` supported on
`win X = [X, 2X)`, there is `θ` with `2H² · box20 ψ X H H ≤ ‖expSum X ψ θ‖²`.

## Proof

Put `P = 2X + 1` and `a(z) = ψ(z.val)` on `ZMod P` (`P5d.liftZ`); `â(k) = ∑_z a(z) e(kz/P)`
(`P5d.cdft`), `D(k) = ∑_{h∈[H]} e(-kh/P)` (`P5d.dirK`), `M = max_k |â(k)|²`.

1. (No wrap-around, `P5d.box20_eq`, `P5d.box_numer_eq`.) As `2H < X`, the term `n = 0` vanishes
   and the shifts `n + h + h' < P + X` never wrap onto `[X, 2X)`, so
   `box20 = S/(2XH⁴)`, `S = ∑_{n∈ZMod P} ∑_{h₁,h'₁,h₂,h'₂∈[H]} a(n+h₁+h₂)a(n+h'₁+h₂)a(n+h₁+h'₂)a(n+h'₁+h'₂)`.
2. (`P5d.box_rearrange`) `S = ∑_{h₁,h'₁} ∑_n |∑_{h₂} u_{h₁h'₁}(n+h₂)|²` with
   `u_{hh'}(m) = a(m+h)a(m+h')`.
3. (Parseval for weighted shifts, `P5d.sum_norm_sq_wshift`)
   `∑_n |∑_i c_i f(n+s_i)|² = P⁻¹ ∑_k |∑_i c_i e(-ks_i/P)|² |f̂(k)|²`. Hence
   `S = P⁻¹ ∑_k |D(k)|² ∑_{h₁,h'₁} |û_{h₁h'₁}(k)|²`.
4. (`P5d.cdft_uFun`, `P5d.sum_norm_sq_cdft_uFun_le`, `P5d.sum_norm_sq_wFun_le`)
   `|û_{hh'}(k)| = |W_k(h - h')|` with `W_k(d) = ∑_m a(m)e(km/P)a(d+m)`; each `d` is hit by at most
   `H` pairs, and by 3. (with `c = a·e(k·/P)`) `∑_d |W_k(d)|² = P⁻¹ ∑_j |â(k-j)|²|â(j)|² ≤ M ∑ a²`.
5. (`P5d.sum_norm_sq_dirK`) `∑_k |D(k)|² = PH`. So `S ≤ M H² ∑_z a(z)² ≤ M H² X`
   (`P5d.box_sum_le`, `P5d.sum_sq_liftZ_le`), i.e. `2H² box20 ≤ M`.
6. (`P5d.cdft_liftZ`) `â(k) = expSum X ψ (k.val/P)`; take `θ = k₀.val/P` for a maximising `k₀`.

This is stronger than GS's bound `H³/X` and needs no `L^{4/3}` estimate.
-/

open Finset Real

namespace G22.P51

namespace P5d

section CFourier
variable {P : ℕ} [NeZero P]

/-- Discrete Fourier transform of a complex function on `ZMod P` (sign `e(+kz/P)`). -/
noncomputable def cdft (f : ZMod P → ℂ) (k : ZMod P) : ℂ :=
  ∑ z : ZMod P, f z * ZMod.stdAddChar (k * z)

/-- Parseval's identity on `ZMod P` for complex functions. -/
lemma cparseval (f : ZMod P → ℂ) : ∑ k, ‖cdft f k‖ ^ 2 = P * ∑ z, ‖f z‖ ^ 2 := by
  have h1 : ∀ k, ((‖cdft f k‖ ^ 2 : ℝ) : ℂ) =
      ∑ z, ∑ w, f z * (starRingEnd ℂ) (f w) * ZMod.stdAddChar (k * (z - w)) := by
    intro k
    rw [Complex.ofReal_pow, ← Complex.mul_conj', cdft, map_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun w _ => ?_
    rw [map_mul (starRingEnd ℂ), ← L24.stdAddChar_neg,
      show k * (z - w) = k * z + -(k * w) by ring, AddChar.map_add_eq_mul]
    ring
  have h3 : ∀ z w : ZMod P, ∑ k : ZMod P, f z * (starRingEnd ℂ) (f w) *
      ZMod.stdAddChar (k * (z - w)) = if z = w then ((P * ‖f z‖ ^ 2 : ℝ) : ℂ) else 0 := by
    intro z w
    rw [← Finset.mul_sum, L24.sum_stdAddChar_mul]
    by_cases h : z = w
    · subst h
      simp only [sub_self, if_true, Complex.mul_conj']
      push_cast; ring
    · have h' : z - w ≠ 0 := sub_ne_zero.mpr h
      simp [h, h']
  have h2 : ((∑ k, ‖cdft f k‖ ^ 2 : ℝ) : ℂ) = ((P * ∑ z, ‖f z‖ ^ 2 : ℝ) : ℂ) := by
    rw [Complex.ofReal_sum, Finset.sum_congr rfl fun k _ => h1 k, Finset.sum_comm,
      Finset.sum_congr rfl fun z _ => Finset.sum_comm]
    simp only [h3, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    push_cast
    rw [Finset.mul_sum]
  exact_mod_cast h2

/-- Shifting multiplies the transform by a phase. -/
lemma cdft_shift (f : ZMod P → ℂ) (y k : ZMod P) :
    cdft (fun z => f (z + y)) k = ZMod.stdAddChar (-(k * y)) * cdft f k := by
  unfold cdft
  rw [Finset.mul_sum]
  refine Fintype.sum_equiv (Equiv.addRight y) _ _ fun z => ?_
  simp only [Equiv.coe_addRight]
  rw [show k * z = -(k * y) + k * (z + y) by ring, AddChar.map_add_eq_mul]
  ring

/-- The transform is linear. -/
lemma cdft_wsum {ι : Type*} (I : Finset ι) (c : ι → ℂ) (g : ι → ZMod P → ℂ) (k : ZMod P) :
    cdft (fun z => ∑ i ∈ I, c i * g i z) k = ∑ i ∈ I, c i * cdft (g i) k := by
  unfold cdft
  simp_rw [Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun z _ => by ring

/-- Parseval for a weighted sum of shifts: `∑_n |∑_i c_i f(n + s_i)|² =
P⁻¹ ∑_k |∑_i c_i e(-k s_i/P)|² |f̂(k)|²`. -/
lemma sum_norm_sq_wshift {ι : Type*} (I : Finset ι) (c : ι → ℂ) (s : ι → ZMod P)
    (f : ZMod P → ℂ) :
    ∑ n, ‖∑ i ∈ I, c i * f (n + s i)‖ ^ 2 =
      (1 / P) * ∑ k, ‖∑ i ∈ I, c i * ZMod.stdAddChar (-(k * s i))‖ ^ 2 * ‖cdft f k‖ ^ 2 := by
  have hP : (P : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne P
  have key := cparseval (fun n => ∑ i ∈ I, c i * f (n + s i))
  have e : ∀ k, cdft (fun n => ∑ i ∈ I, c i * f (n + s i)) k =
      (∑ i ∈ I, c i * ZMod.stdAddChar (-(k * s i))) * cdft f k := by
    intro k
    rw [cdft_wsum I c (fun i n => f (n + s i)) k, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [cdft_shift]; ring
  simp only [e, norm_mul, mul_pow] at key
  rw [key]
  field_simp

/-- `|e(x/P)| = 1`. -/
lemma norm_stdAddChar (x : ZMod P) : ‖ZMod.stdAddChar x‖ = 1 := by
  rw [ZMod.stdAddChar_apply]; exact Circle.norm_coe _

end CFourier

section Box
variable {P : ℕ} [NeZero P]

omit [NeZero P] in
/-- `1, …, H` are distinct in `ZMod P` for `H < P`. -/
lemma natCast_injOn {H : ℕ} (hHP : H < P) :
    Set.InjOn (fun h : ℕ => (h : ZMod P)) (Icc 1 H : Set ℕ) := by
  intro h₁ h₁m h₂ h₂m heq
  have h₁H := (Finset.mem_Icc.mp (Finset.mem_coe.mp h₁m)).2
  have h₂H := (Finset.mem_Icc.mp (Finset.mem_coe.mp h₂m)).2
  have := congrArg ZMod.val heq
  simp only at this
  rwa [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at this

/-- For `F ≥ 0` and `H < P`: `∑_{h∈[H]} F(h + y) ≤ ∑_z F(z)`. -/
lemma sum_Icc_shift_le {H : ℕ} (hHP : H < P) (F : ZMod P → ℝ) (hF : ∀ z, 0 ≤ F z)
    (y : ZMod P) : ∑ h ∈ Icc 1 H, F ((h : ZMod P) + y) ≤ ∑ z, F z := by
  classical
  have hinj : Set.InjOn (fun h : ℕ => (h : ZMod P) + y) (Icc 1 H : Set ℕ) := by
    intro h₁ h₁m h₂ h₂m heq
    exact natCast_injOn hHP h₁m h₂m (add_right_cancel heq)
  rw [← Finset.sum_image hinj]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) fun z _ _ => hF z

/-- `D_H(k) = ∑_{h ∈ [H]} e(-kh/P)`. -/
noncomputable def dirK (H : ℕ) (k : ZMod P) : ℂ :=
  ∑ h ∈ Icc 1 H, ZMod.stdAddChar (-(k * (h : ZMod P)))

/-- `∑_k |D_H(k)|² = PH` (Parseval for the indicator of `[H]`). -/
lemma sum_norm_sq_dirK {H : ℕ} (hHP : H < P) : ∑ k : ZMod P, ‖dirK H k‖ ^ 2 = P * H := by
  classical
  set T : Finset (ZMod P) := (Icc 1 H).image (fun h : ℕ => (h : ZMod P)) with hT
  have hinj := natCast_injOn (P := P) hHP
  have hTcard : T.card = H := by
    rw [hT, Finset.card_image_of_injOn hinj, Nat.card_Icc]; omega
  set ind : ZMod P → ℂ := fun z => if z ∈ T then 1 else 0 with hind_def
  have hind : ∀ k, cdft ind k = ∑ h ∈ Icc 1 H, ZMod.stdAddChar (k * (h : ZMod P)) := by
    intro k
    unfold cdft
    simp only [hind_def, ite_mul, one_mul, zero_mul]
    rw [Finset.sum_ite_mem, Finset.univ_inter, hT, Finset.sum_image hinj]
  have hD : ∀ k, dirK H k = cdft ind (-k) := by
    intro k; rw [hind]; unfold dirK; simp only [neg_mul]
  have h1 : ∑ k : ZMod P, ‖dirK H k‖ ^ 2 = ∑ k, ‖cdft ind k‖ ^ 2 := by
    simp only [hD]
    exact Fintype.sum_equiv (Equiv.neg _) _ _ fun k => rfl
  rw [h1, cparseval]
  congr 1
  have : ∀ z, ‖ind z‖ ^ 2 = if z ∈ T then (1 : ℝ) else 0 := by
    intro z; simp only [hind_def]; split_ifs <;> simp
  simp only [this]
  rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, hTcard, nsmul_eq_mul, mul_one]

/-- `u_{h,h'}(m) = a(m+h) a(m+h')`. -/
noncomputable def uFun (a : ZMod P → ℝ) (h h' : ℕ) (m : ZMod P) : ℂ :=
  ((a (m + h) * a (m + h') : ℝ) : ℂ)

/-- `W_k(d) = ∑_m a(m) e(km/P) a(d+m)`. -/
noncomputable def wFun (a : ZMod P → ℝ) (k d : ZMod P) : ℂ :=
  ∑ m : ZMod P, ((a m : ℂ) * ZMod.stdAddChar (k * m)) * (a (d + m) : ℂ)

/-- `S = ∑_{h₁,h'₁} ∑_n |∑_{h₂} u_{h₁h'₁}(n+h₂)|²`. -/
lemma box_rearrange (a : ZMod P → ℝ) (H : ℕ) :
    ∑ n : ZMod P, ∑ h₁ ∈ Icc 1 H, ∑ h₁' ∈ Icc 1 H, ∑ h₂ ∈ Icc 1 H, ∑ h₂' ∈ Icc 1 H,
      a (n + h₁ + h₂) * a (n + h₁' + h₂) * a (n + h₁ + h₂') * a (n + h₁' + h₂') =
    ∑ h₁ ∈ Icc 1 H, ∑ h₁' ∈ Icc 1 H, ∑ n,
      ‖∑ h₂ ∈ Icc 1 H, (1 : ℂ) * uFun a h₁ h₁' (n + h₂)‖ ^ 2 := by
  have e : ∀ (n : ZMod P) (h₁ h₁' : ℕ), ∑ h₂ ∈ Icc 1 H, ∑ h₂' ∈ Icc 1 H,
      a (n + h₁ + h₂) * a (n + h₁' + h₂) * a (n + h₁ + h₂') * a (n + h₁' + h₂') =
      ‖∑ h₂ ∈ Icc 1 H, (1 : ℂ) * uFun a h₁ h₁' (n + h₂)‖ ^ 2 := by
    intro n h₁ h₁'
    have : ∑ h₂ ∈ Icc 1 H, (1 : ℂ) * uFun a h₁ h₁' (n + h₂) =
        ((∑ h₂ ∈ Icc 1 H, a (n + h₂ + h₁) * a (n + h₂ + h₁') : ℝ) : ℂ) := by
      simp only [uFun, one_mul]; push_cast; rfl
    rw [this, Complex.norm_real, Real.norm_eq_abs, sq_abs, sq, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun h₂ _ => Finset.sum_congr rfl fun h₂' _ => ?_
    rw [add_right_comm n (h₂ : ZMod P) (h₁ : ZMod P), add_right_comm n (h₂ : ZMod P) (h₁' : ZMod P),
      add_right_comm n (h₂' : ZMod P) (h₁ : ZMod P), add_right_comm n (h₂' : ZMod P) (h₁' : ZMod P)]
    ring
  simp only [e]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun h₁ _ => Finset.sum_comm

/-- `û_{hh'}(k) = e(-kh'/P) W_k(h - h')`. -/
lemma cdft_uFun (a : ZMod P → ℝ) (h h' : ℕ) (k : ZMod P) :
    cdft (uFun a h h') k =
      ZMod.stdAddChar (-(k * (h' : ZMod P))) * wFun a k ((h : ZMod P) - (h' : ZMod P)) := by
  unfold cdft uFun wFun
  rw [Finset.mul_sum]
  refine Fintype.sum_equiv (Equiv.addRight (h' : ZMod P)) _ _ fun m => ?_
  simp only [Equiv.coe_addRight]
  rw [show ((h : ZMod P) - (h' : ZMod P)) + (m + (h' : ZMod P)) = m + (h : ZMod P) by ring,
    show k * m = -(k * (h' : ZMod P)) + k * (m + (h' : ZMod P)) by ring, AddChar.map_add_eq_mul]
  push_cast
  ring

/-- `∑_{h,h'∈[H]} |û_{hh'}(k)|² ≤ H ∑_d |W_k(d)|²` (each `d` is hit by at most `H` pairs). -/
lemma sum_norm_sq_cdft_uFun_le (a : ZMod P → ℝ) {H : ℕ} (hHP : H < P) (k : ZMod P) :
    ∑ h ∈ Icc 1 H, ∑ h' ∈ Icc 1 H, ‖cdft (uFun a h h') k‖ ^ 2 ≤
      H * ∑ d, ‖wFun a k d‖ ^ 2 := by
  simp only [cdft_uFun, norm_mul, norm_stdAddChar, one_mul]
  rw [Finset.sum_comm]
  calc ∑ h' ∈ Icc 1 H, ∑ h ∈ Icc 1 H, ‖wFun a k ((h : ZMod P) - h')‖ ^ 2
      ≤ ∑ h' ∈ Icc 1 H, ∑ d, ‖wFun a k d‖ ^ 2 := by
        refine Finset.sum_le_sum fun h' _ => ?_
        simp only [sub_eq_add_neg]
        exact sum_Icc_shift_le hHP (fun d => ‖wFun a k d‖ ^ 2) (fun _ => by positivity) _
    _ = H * ∑ d, ‖wFun a k d‖ ^ 2 := by
        rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel]

/-- `∑_d |W_k(d)|² = P⁻¹ ∑_j |â(k-j)|²|â(j)|² ≤ M ∑_z a(z)²`. -/
lemma sum_norm_sq_wFun_le (a : ZMod P → ℝ) (M : ℝ)
    (hM : ∀ k, ‖cdft (fun z => (a z : ℂ)) k‖ ^ 2 ≤ M) (k : ZMod P) :
    ∑ d, ‖wFun a k d‖ ^ 2 ≤ M * ∑ z, a z ^ 2 := by
  have hP : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  have e := sum_norm_sq_wshift (Finset.univ) (fun m => (a m : ℂ) * ZMod.stdAddChar (k * m)) id
    (fun z => (a z : ℂ))
  have hc : ∀ j, ∑ m, (a m : ℂ) * ZMod.stdAddChar (k * m) * ZMod.stdAddChar (-(j * id m)) =
      cdft (fun z => (a z : ℂ)) (k - j) := by
    intro j; unfold cdft
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [mul_assoc, ← AddChar.map_add_eq_mul]; congr 2; simp only [id]; ring
  simp only [hc] at e
  have hw : ∑ d, ‖wFun a k d‖ ^ 2 = ∑ n, ‖∑ i, (a i : ℂ) * ZMod.stdAddChar (k * i) *
      (a (n + id i) : ℂ)‖ ^ 2 := rfl
  rw [hw, e]
  calc (1 / (P : ℝ)) * ∑ j, ‖cdft (fun z => (a z : ℂ)) (k - j)‖ ^ 2 *
        ‖cdft (fun z => (a z : ℂ)) j‖ ^ 2
      ≤ (1 / (P : ℝ)) * ∑ j, M * ‖cdft (fun z => (a z : ℂ)) j‖ ^ 2 := by
        gcongr with j; exact hM _
    _ = (1 / (P : ℝ)) * (M * (P * ∑ z, ‖(a z : ℂ)‖ ^ 2)) := by
        rw [← Finset.mul_sum, cparseval]
    _ = M * ∑ z, a z ^ 2 := by
        simp only [Complex.norm_real, Real.norm_eq_abs, sq_abs]
        field_simp

/-- **The Fourier bound on `ZMod P`:** `S ≤ M H² ∑_z a(z)²` when `|â(k)|² ≤ M` for all `k`. -/
theorem box_sum_le (a : ZMod P → ℝ) {H : ℕ} (hHP : H < P) (M : ℝ)
    (hM : ∀ k, ‖cdft (fun z => (a z : ℂ)) k‖ ^ 2 ≤ M) :
    ∑ n : ZMod P, ∑ h₁ ∈ Icc 1 H, ∑ h₁' ∈ Icc 1 H, ∑ h₂ ∈ Icc 1 H, ∑ h₂' ∈ Icc 1 H,
      a (n + h₁ + h₂) * a (n + h₁' + h₂) * a (n + h₁ + h₂') * a (n + h₁' + h₂') ≤
    M * H ^ 2 * ∑ z, a z ^ 2 := by
  have hP : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  rw [box_rearrange]
  have e2 : ∀ h h' : ℕ, ∑ n, ‖∑ h₂ ∈ Icc 1 H, (1 : ℂ) * uFun a h h' (n + h₂)‖ ^ 2 =
      (1 / P) * ∑ k, ‖dirK H k‖ ^ 2 * ‖cdft (uFun a h h') k‖ ^ 2 := by
    intro h h'
    rw [sum_norm_sq_wshift (Icc 1 H) (fun _ => 1) (fun h₂ : ℕ => (h₂ : ZMod P)) (uFun a h h')]
    simp only [one_mul, dirK]
  simp only [e2]
  have e3 : ∑ h ∈ Icc 1 H, ∑ h' ∈ Icc 1 H,
      (1 / (P : ℝ)) * ∑ k, ‖dirK H k‖ ^ 2 * ‖cdft (uFun a h h') k‖ ^ 2 =
      (1 / (P : ℝ)) * ∑ k, ‖dirK H k‖ ^ 2 *
        ∑ h ∈ Icc 1 H, ∑ h' ∈ Icc 1 H, ‖cdft (uFun a h h') k‖ ^ 2 := by
    symm
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun h _ => ?_
    rw [Finset.sum_comm]
  rw [e3]
  have hS0 : 0 ≤ ∑ z, a z ^ 2 := Finset.sum_nonneg fun z _ => sq_nonneg _
  have hM0 : 0 ≤ M := (sq_nonneg _).trans (hM 0) |>.trans' (by positivity)
  calc (1 / (P : ℝ)) * ∑ k, ‖dirK H k‖ ^ 2 *
        ∑ h ∈ Icc 1 H, ∑ h' ∈ Icc 1 H, ‖cdft (uFun a h h') k‖ ^ 2
      ≤ (1 / (P : ℝ)) * ∑ k, ‖dirK H k‖ ^ 2 * (H * (M * ∑ z, a z ^ 2)) := by
        gcongr with k
        exact (sum_norm_sq_cdft_uFun_le a hHP k).trans
          (mul_le_mul_of_nonneg_left (sum_norm_sq_wFun_le a M hM k) (Nat.cast_nonneg H))
    _ = M * H ^ 2 * ∑ z, a z ^ 2 := by
        rw [← Finset.sum_mul, sum_norm_sq_dirK hHP]
        field_simp

end Box

section Bridge

/-- `ψ` on `[0, P)`, viewed as a function on `ZMod P`. -/
noncomputable def liftZ (ψ : ℤ → ℝ) (P : ℕ) (z : ZMod P) : ℝ := ψ (z.val : ℤ)

/-- No wrap-around: `a(m mod P) = ψ(m)` for `0 ≤ m < P + X`, `P = 2X + 1`. -/
lemma liftZ_natCast {X : ℕ} {ψ : ℤ → ℝ} (hψ : ∀ x ∉ win X, ψ x = 0) {m : ℕ}
    (hm : m < 3 * X + 1) : liftZ ψ (2 * X + 1) (m : ZMod (2 * X + 1)) = ψ m := by
  unfold liftZ
  by_cases h : m < 2 * X + 1
  · rw [ZMod.val_natCast_of_lt h]
  · rw [ZMod.val_natCast, Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega), hψ, hψ]
    · simp only [win, Finset.mem_Ico, not_and, not_lt]; omega
    · simp only [win, Finset.mem_Ico, not_and, not_lt]; omega

/-- `a(n + h + h') = ψ(n + h + h')` for `n ≤ 2X`, `h, h' ≤ H`. -/
lemma liftZ_add {X H : ℕ} (hHX : 2 * H + 1 ≤ X) {ψ : ℤ → ℝ} (hψ : ∀ x ∉ win X, ψ x = 0)
    {n h h' : ℕ} (hn : n ≤ 2 * X) (hh : h ≤ H) (hh' : h' ≤ H) :
    liftZ ψ (2 * X + 1) ((n : ZMod (2 * X + 1)) + h + h') = ψ (n + h + h') := by
  rw [show (n : ZMod (2 * X + 1)) + h + h' = ((n + h + h' : ℕ) : ZMod (2 * X + 1)) by
    push_cast; ring, liftZ_natCast hψ (by omega)]
  push_cast; ring_nf

/-- `box20 ψ X H H = S_ℤ / (2XH⁴)`. -/
lemma box20_eq (ψ : ℤ → ℝ) (X H : ℕ) :
    box20 ψ X H H = (∑ n ∈ Icc 1 (2 * X), ∑ h₁ ∈ Icc 1 H, ∑ h₁' ∈ Icc 1 H, ∑ h₂ ∈ Icc 1 H,
      ∑ h₂' ∈ Icc 1 H, ψ (n + h₁ + h₂) * ψ (n + h₁' + h₂) * ψ (n + h₁ + h₂') *
        ψ (n + h₁' + h₂')) / (2 * X * H ^ 4) := by
  unfold box20
  simp only [L24.uavg_eq_sum_div, Finset.sum_div, div_div]
  refine Finset.sum_congr rfl fun n _ => Finset.sum_congr rfl fun h₁ _ =>
    Finset.sum_congr rfl fun h₁' _ => Finset.sum_congr rfl fun h₂ _ =>
      Finset.sum_congr rfl fun h₂' _ => ?_
  congr 1; push_cast; ring

/-- The box sum over `n ∈ [1, 2X]` equals the box sum over `ZMod (2X + 1)`. -/
lemma box_numer_eq {X H : ℕ} (hHX : 2 * H + 1 ≤ X) {ψ : ℤ → ℝ} (hψ : ∀ x ∉ win X, ψ x = 0) :
    ∑ n ∈ Icc 1 (2 * X), ∑ h₁ ∈ Icc 1 H, ∑ h₁' ∈ Icc 1 H, ∑ h₂ ∈ Icc 1 H, ∑ h₂' ∈ Icc 1 H,
      ψ (n + h₁ + h₂) * ψ (n + h₁' + h₂) * ψ (n + h₁ + h₂') * ψ (n + h₁' + h₂') =
    ∑ n : ZMod (2 * X + 1), ∑ h₁ ∈ Icc 1 H, ∑ h₁' ∈ Icc 1 H, ∑ h₂ ∈ Icc 1 H, ∑ h₂' ∈ Icc 1 H,
      liftZ ψ (2 * X + 1) (n + h₁ + h₂) * liftZ ψ (2 * X + 1) (n + h₁' + h₂) *
        liftZ ψ (2 * X + 1) (n + h₁ + h₂') * liftZ ψ (2 * X + 1) (n + h₁' + h₂') := by
  have hsub : Icc 1 (2 * X) ⊆ range (2 * X + 1) := by
    intro n hn; simp only [Finset.mem_Icc] at hn; simp only [Finset.mem_range]; omega
  rw [L24.sum_zmod_eq_sum_range, ← Finset.sum_subset hsub]
  · refine Finset.sum_congr rfl fun n hn => Finset.sum_congr rfl fun h₁ hh₁ =>
      Finset.sum_congr rfl fun h₁' hh₁' => Finset.sum_congr rfl fun h₂ hh₂ =>
        Finset.sum_congr rfl fun h₂' hh₂' => ?_
    have hn' := (Finset.mem_Icc.mp hn).2
    have h1 := (Finset.mem_Icc.mp hh₁).2
    have h1' := (Finset.mem_Icc.mp hh₁').2
    have h2 := (Finset.mem_Icc.mp hh₂).2
    have h2' := (Finset.mem_Icc.mp hh₂').2
    rw [liftZ_add hHX hψ hn' h1 h2, liftZ_add hHX hψ hn' h1' h2, liftZ_add hHX hψ hn' h1 h2',
      liftZ_add hHX hψ hn' h1' h2']
  · intro n hn hn'
    have hn0 : n = 0 := by
      simp only [Finset.mem_range] at hn; simp only [Finset.mem_Icc] at hn'; omega
    subst hn0
    refine Finset.sum_eq_zero fun h₁ hh₁ => Finset.sum_eq_zero fun h₁' _ =>
      Finset.sum_eq_zero fun h₂ hh₂ => Finset.sum_eq_zero fun h₂' _ => ?_
    have h1 := (Finset.mem_Icc.mp hh₁).2
    have h2 := (Finset.mem_Icc.mp hh₂).2
    rw [liftZ_add hHX hψ (Nat.zero_le _) h1 h2, hψ, zero_mul, zero_mul, zero_mul]
    simp only [win, Finset.mem_Ico, not_and, not_lt]; omega

/-- A function on `ZMod (2X+1)` vanishing off `[X, 2X)` sums to its sum over `win X`. -/
lemma sum_zmod_eq_sum_win {M : Type*} [AddCommMonoid M] (X : ℕ) (F : ZMod (2 * X + 1) → M)
    (hF : ∀ z : ZMod (2 * X + 1), (z.val : ℤ) ∉ win X → F z = 0) :
    ∑ z, F z = ∑ x ∈ win X, F (x : ZMod (2 * X + 1)) := by
  classical
  have hinj : Set.InjOn (fun x : ℤ => (x : ZMod (2 * X + 1))) (win X : Set ℤ) := by
    intro x hx y hy hxy
    have hx' : (X : ℤ) ≤ x ∧ x < 2 * X := Finset.mem_Ico.mp (Finset.mem_coe.mp hx)
    have hy' : (X : ℤ) ≤ y ∧ y < 2 * X := Finset.mem_Ico.mp (Finset.mem_coe.mp hy)
    have h1 := L24.val_intCast_eq (P := 2 * X + 1) (x := x) (by omega) (by push_cast; omega)
    have h2 := L24.val_intCast_eq (P := 2 * X + 1) (x := y) (by omega) (by push_cast; omega)
    have := congrArg (fun z : ZMod (2 * X + 1) => (z.val : ℤ)) hxy
    simp only at this
    rw [h1, h2] at this
    exact this
  rw [← Finset.sum_image hinj]
  symm
  refine Finset.sum_subset (Finset.subset_univ _) fun z _ hz => hF z fun hmem => hz ?_
  rw [Finset.mem_image]
  exact ⟨z.val, hmem, by rw [Int.cast_natCast, ZMod.natCast_zmod_val]⟩

/-- `â(k) = expSum X ψ (k.val / P)`. -/
lemma cdft_liftZ {X : ℕ} {ψ : ℤ → ℝ} (hψ : ∀ x ∉ win X, ψ x = 0) (k : ZMod (2 * X + 1)) :
    cdft (fun z => (liftZ ψ (2 * X + 1) z : ℂ)) k =
      expSum X ψ ((k.val : ℝ) / ((2 * X + 1 : ℕ) : ℝ)) := by
  unfold cdft expSum
  rw [sum_zmod_eq_sum_win X]
  · refine Finset.sum_congr rfl fun x hx => ?_
    have hx' : (X : ℤ) ≤ x ∧ x < 2 * X := Finset.mem_Ico.mp hx
    rw [L24.stdAddChar_mul_intCast]
    simp only [liftZ]
    rw [L24.val_intCast_eq (x := x) (by omega) (by push_cast; omega)]
  · intro z hz
    simp only [liftZ]
    rw [hψ _ hz]; simp

/-- `∑_z a(z)² ≤ X`. -/
lemma sum_sq_liftZ_le {X : ℕ} {ψ : ℤ → ℝ} (hψ1 : ∀ x, |ψ x| ≤ 1)
    (hψ : ∀ x ∉ win X, ψ x = 0) : ∑ z, liftZ ψ (2 * X + 1) z ^ 2 ≤ X := by
  rw [sum_zmod_eq_sum_win X (fun z => liftZ ψ (2 * X + 1) z ^ 2)]
  · calc ∑ x ∈ win X, liftZ ψ (2 * X + 1) (x : ZMod (2 * X + 1)) ^ 2
        ≤ ∑ x ∈ win X, (1 : ℝ) := by
          refine Finset.sum_le_sum fun x _ => ?_
          have h := hψ1 ((((x : ZMod (2 * X + 1))).val : ℤ))
          unfold liftZ
          rw [← sq_abs]
          nlinarith [abs_nonneg (ψ (((x : ZMod (2 * X + 1)).val : ℤ)))]
      _ = X := by
          rw [Finset.sum_const, nsmul_eq_mul, mul_one, win, Int.card_Ico,
            show 2 * (X : ℤ) - X = X by ring, Int.toNat_natCast]
  · intro z hz
    show liftZ ψ (2 * X + 1) z ^ 2 = 0
    unfold liftZ; rw [hψ _ hz]; ring

end Bridge

end P5d

open P5d in
/-- **Step P5d** (GS pp. 20–21, (5.20) → (5.18)): for `ψ` 1-bounded and supported on
`[X, 2X)`, `2H² · box20 ψ X H H ≤ ‖expSum X ψ θ‖²` for some `θ` (of the form `k/(2X+1)`). -/
theorem stepP5d : StepP5d := by
  intro X H hH hHX ψ hψ1 hψ0
  obtain ⟨k₀, hk₀⟩ := Finite.exists_max
    (fun k : ZMod (2 * X + 1) => ‖cdft (fun z => (liftZ ψ (2 * X + 1) z : ℂ)) k‖ ^ 2)
  refine ⟨(k₀.val : ℝ) / ((2 * X + 1 : ℕ) : ℝ), ?_⟩
  rw [← cdft_liftZ hψ0 k₀, box20_eq, box_numer_eq hHX hψ0]
  have hbox := box_sum_le (liftZ ψ (2 * X + 1)) (show H < 2 * X + 1 by omega) _ hk₀
  have hsq := sum_sq_liftZ_le hψ1 hψ0
  have hHR : (1 : ℝ) ≤ H := by exact_mod_cast hH
  have hXR : (1 : ℝ) ≤ X := by exact_mod_cast (show 1 ≤ X by omega)
  have key : ∀ S M : ℝ, 0 ≤ M → S ≤ M * H ^ 2 * ∑ z, liftZ ψ (2 * X + 1) z ^ 2 →
      2 * (H : ℝ) ^ 2 * (S / (2 * X * H ^ 4)) ≤ M := by
    intro S M hM hS
    rw [show 2 * (H : ℝ) ^ 2 * (S / (2 * X * H ^ 4)) = S / (X * H ^ 2) by
      field_simp, div_le_iff₀ (by positivity)]
    calc S ≤ M * H ^ 2 * ∑ z, liftZ ψ (2 * X + 1) z ^ 2 := hS
      _ ≤ M * H ^ 2 * X := by gcongr
      _ = M * (X * H ^ 2) := by ring
  exact key _ _ (by positivity) hbox

end G22.P51

end

/- ## Section: `P51GlueP5e` -/

section

/-
# `GlueP5e`: P5c and P5d imply P5e (GS claim (5.15) in inverse form)

GS = B. Green and M. Sawhney, arXiv:2511.09365v2, pp. 18–21.

We prove `G22.P51.glueP5e : GlueP5e` (`StepP5c → StepP5d → StepP5e`) with the constants

* `A = 100`, `C₁ = 32`, `τ₀ = 1/1024`,
* `N₀ = ⌈exp exp W₀¹⁰⌉₊`, `W₀ = 2²³⁶ · 41!`.

## Proof

Let `Bᵢ = almostPrimes aᵢ bᵢ` (`Good5` boxes) and `Yᵢ = ∏ aᵢ`, so `Bᵢ ⊂ [Yᵢ, 2Yᵢ]`
(`good5_mem`) and `Yᵢ ≤ P'₂` (`good5_Y_le`). Replace `ψ` by `ψ̃ = ψ·1_{[X,2X)}` (`restr`); this
changes neither `lhs14` nor `expSum X` (`lhs14_restr`, `expSum_restr`). Put `σ = (τ/2)⁴`,
`Tᵢ = ⌊τ³²X/Yᵢ⌋` (`Tpar`) and `H = ⌊τ⁶⁴X⌋` (`Hpar`).

0. (Sizes.) `τ¹⁰⁰P'₁ ≥ 1` and `X ≥ P₁ ≥ P'₂¹⁰` give `τⁿX ≥ P'₂⁹` for `n ≤ 100` (`big_x`), hence
   `τ³²X/2 ≤ TᵢYᵢ ≤ τ³²X`, `τ⁶⁴X/2 ≤ H ≤ τ⁶⁴X` and `2H + 1 ≤ X`. From `N ≥ N₀`: `log N ≥ 625` and
   `P'₁ ≥ 2²³⁶k⁴` (`P1'_big`, via `k ≤ log log N ≤ (log log P'₁)¹⁰`).
1. (P5c.) `8(p₁T₁ + p₂T₂) ≤ 32τ³²X ≤ τX`, and `8λ(p₁T₂ + p₂T₁) ≤ 32λP'₂X ≤ τL`, because
   `32λP'₁P'₂X ≤ L` (`key_L`: each factor is `≤ exp(log L/5)`, as `(log λ)⁴, (log P₂)⁴ ≤ log N ≤
   (log L)²` and `log L ≥ 25`) and `τP'₁ ≥ 1`. So `σ ≤ box12 ψ̃ X B₁ B₂ T₁ T₂`.
2. (`L26.lemma26_one` with `δ = σ`, `Dᵢ = Yᵢ`, `H₁ = H₂ = H`.) The FPD hypotheses at the levels
   `η = σ/40` and `η = σ³/64000` come from `FPDQ.lemmaL_box_FPD` (`good5_FPD`): the collision sum
   is `≤ k/⌊√P'₁⌋ < τ²⁴/2⁵⁸ ≤ (η/2)²` (`coll_small`, from `τ⁹⁶P'₁ ≥ 1` and `P'₁ ≥ 2²³⁶k⁴`), and
   `√(2η) ≥ τ⁶/2¹⁴` together with `2¹⁷Yᵢ² < τ³⁸X` gives `4Yᵢ < Tᵢ√(2η)`. The size conditions
   reduce to `c·τᵐ ≤ 1` for explicit `c` and `m ≥ 8` (`num_*`). So
   `(σ³/3200)³/800 ≤ box20 ψ̃ X H H`.
3. (P5d.) `‖expSum X ψ̃ θ‖² ≥ 2H²·box20 ≥ τ¹⁶⁴X²/(1600·13107200³) ≥ (τ¹⁰⁰X)²` (`num_final`).
-/

open Finset Real

namespace G22.P51

namespace GlueP5e

/- ### Constants and growth -/

/-- `W₀ = 2²³⁶ · 41!`. -/
noncomputable def W0 : ℝ := 2 ^ 236 * ((Nat.factorial 41 : ℕ) : ℝ)

/-- The threshold `N₀ = ⌈exp exp W₀¹⁰⌉₊`. -/
noncomputable def N0 : ℕ := ⌈Real.exp (Real.exp (W0 ^ 10))⌉₊

lemma W0_ge : (625 : ℝ) ≤ W0 := by
  unfold W0
  have h1 : (1 : ℝ) ≤ ((Nat.factorial 41 : ℕ) : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
  have h2 : (625 : ℝ) ≤ 2 ^ 236 := by norm_num
  nlinarith

lemma one_lt_log_of_three_le {n : ℕ} (hn : 3 ≤ n) : 1 < Real.log n := by
  have h3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [Real.lt_log_iff_exp_lt (by linarith)]
  have := Real.exp_one_lt_d9
  norm_num at this
  linarith

/-- `c xⁿ ≤ eˣ` once `x ≥ c (n+1)!`. -/
lemma mul_pow_le_exp {c x : ℝ} (n : ℕ) (hx : c * (n + 1).factorial ≤ x) (hx0 : 0 ≤ x) :
    c * x ^ n ≤ Real.exp x := by
  have hfac : (0 : ℝ) < (n + 1).factorial := by exact_mod_cast Nat.factorial_pos _
  have h := Real.pow_div_factorial_le_exp x hx0 (n + 1)
  calc c * x ^ n = c * (n + 1).factorial * x ^ n / (n + 1).factorial := by
        field_simp
    _ ≤ x * x ^ n / (n + 1).factorial := by gcongr
    _ = x ^ (n + 1) / (n + 1).factorial := by rw [pow_succ]; ring
    _ ≤ Real.exp x := h

/-- From `N ≥ N₀`: `log log N ≥ W₀¹⁰` and `log N ≥ 625`. -/
lemma logN_facts (D : Data) (hN : N0 ≤ D.N) :
    W0 ^ 10 ≤ Real.log (Real.log D.N) ∧ 625 ≤ Real.log D.N := by
  have hN' : ((N0 : ℕ) : ℝ) ≤ D.N := by exact_mod_cast hN
  have h1 : Real.exp (Real.exp (W0 ^ 10)) ≤ D.N := (Nat.le_ceil _).trans hN'
  have h2 : Real.exp (W0 ^ 10) ≤ Real.log D.N := by
    have := Real.log_le_log (Real.exp_pos _) h1
    rwa [Real.log_exp] at this
  have h3 : W0 ^ 10 ≤ Real.log (Real.log D.N) := by
    have := Real.log_le_log (Real.exp_pos _) h2
    rwa [Real.log_exp] at this
  refine ⟨h3, ?_⟩
  have hW := W0_ge
  have h4 : W0 ≤ W0 ^ 10 := le_self_pow₀ (by linarith) (by norm_num)
  have h5 := Real.add_one_le_exp (W0 ^ 10)
  linarith

/-- `P'₁ ≥ 2²³⁶ k⁴`, from `k ≤ log log N ≤ (log log P'₁)¹⁰` and `log log N ≥ W₀¹⁰`. -/
lemma P1'_big (D : Data) (hN : N0 ≤ D.N) : 2 ^ 236 * (D.k : ℝ) ^ 4 ≤ D.P₁' := by
  obtain ⟨hV, -⟩ := logN_facts D hN
  have hP₁'pos : (0 : ℝ) < D.P₁' := by
    have := D.hP₁'
    exact_mod_cast (by omega : 0 < D.P₁')
  have hw1 : 1 < Real.log D.P₁' := one_lt_log_of_three_le D.hP₁'
  set w := Real.log D.P₁' with hw
  have hz0 : 0 < Real.log w := Real.log_pos hw1
  have hzw : Real.log w ≤ w := Real.log_le_self (by linarith)
  have hLz : Real.log (Real.log D.N) ≤ (Real.log w) ^ 10 := D.hP₁'N
  have hWz : W0 ≤ Real.log w := by
    have h1 : W0 ^ 10 ≤ (Real.log w) ^ 10 := hV.trans hLz
    exact (pow_le_pow_iff_left₀ (by linarith [W0_ge]) hz0.le (by norm_num)).mp h1
  have hk : (D.k : ℝ) ^ 4 ≤ w ^ 40 := by
    have h1 : (D.k : ℝ) ≤ (Real.log w) ^ 10 := D.hkN.trans hLz
    calc (D.k : ℝ) ^ 4 ≤ ((Real.log w) ^ 10) ^ 4 := pow_le_pow_left₀ (Nat.cast_nonneg _) h1 4
      _ = (Real.log w) ^ 40 := by rw [← pow_mul]
      _ ≤ w ^ 40 := pow_le_pow_left₀ hz0.le hzw 40
  have hW : (2 : ℝ) ^ 236 * ((40 + 1).factorial : ℕ) ≤ w := hWz.trans hzw
  calc 2 ^ 236 * (D.k : ℝ) ^ 4 ≤ 2 ^ 236 * w ^ 40 := by gcongr
    _ ≤ Real.exp w := mul_pow_le_exp 40 hW (by linarith)
    _ = D.P₁' := Real.exp_log hP₁'pos

/- ### `Good5` boxes -/

section Boxes

variable (D : Data) {a b : Fin D.k → ℕ}

lemma mem_primesIn {A B p : ℕ} : p ∈ primesIn A B ↔ (A ≤ p ∧ p < B) ∧ p.Prime := by
  unfold primesIn
  rw [Finset.mem_filter, Finset.mem_Ico]

lemma primes_prime (a b : Fin D.k → ℕ) : ∀ ℓ, ∀ p ∈ primesIn (a ℓ) (b ℓ), p.Prime :=
  fun _ _ hp => (mem_primesIn.mp hp).2

lemma good5_disj (hG : Good5 D a b) :
    ∀ ℓ ℓ', ℓ ≠ ℓ' → Disjoint (primesIn (a ℓ) (b ℓ)) (primesIn (a ℓ') (b ℓ')) := by
  intro ℓ ℓ' hne
  rw [Finset.disjoint_left]
  intro p hp hp'
  obtain ⟨⟨h1, h2⟩, -⟩ := mem_primesIn.mp hp
  obtain ⟨⟨h1', h2'⟩, -⟩ := mem_primesIn.mp hp'
  obtain ⟨g1, -, g3, -, -⟩ := hG ℓ
  obtain ⟨g1', -, g3', -, -⟩ := hG ℓ'
  rcases D.hdisj ℓ ℓ' hne with h | h <;> omega

lemma sqrt_P1'_pos : 0 < Nat.sqrt D.P₁' := Nat.sqrt_pos.mpr (by have := D.hP₁'; omega)

lemma good5_card (hG : Good5 D a b) (ℓ : Fin D.k) : 0 < (primesIn (a ℓ) (b ℓ)).card :=
  (sqrt_P1'_pos D).trans_le (hG ℓ).2.2.2.2

lemma good5_ne (hG : Good5 D a b) : (almostPrimes a b).Nonempty := by
  unfold almostPrimes FPDQ.boxProd
  refine Finset.Nonempty.image ?_ _
  rw [Fintype.piFinset_nonempty]
  exact fun ℓ => Finset.card_pos.mp (good5_card D hG ℓ)

lemma good5_Y_pos (hG : Good5 D a b) : 1 ≤ ∏ ℓ, a ℓ := by
  have : 0 < ∏ ℓ, a ℓ := Finset.prod_pos fun ℓ _ => by
    have h1 := (hG ℓ).1
    have h2 := (D.hI ℓ).1
    have h3 := D.hP₁'
    omega
  omega

lemma good5_Y_le (hG : Good5 D a b) : ∏ ℓ, a ℓ ≤ D.P₂' :=
  calc ∏ ℓ, a ℓ ≤ ∏ ℓ : Fin D.k, D.hi ℓ.castSucc :=
        Finset.prod_le_prod' fun ℓ _ => by
          obtain ⟨h1, h2, h3, -, -⟩ := hG ℓ
          omega
    _ ≤ D.P₂' := D.hprod

/-- A `Good5` box lies in `[Y, 2Y]`, `Y = ∏ a ℓ`, since `(1 + 1/(4k))^k < 2`. -/
lemma good5_mem (hG : Good5 D a b) :
    ∀ s ∈ almostPrimes a b, ∏ ℓ, a ℓ ≤ s ∧ s ≤ 2 * ∏ ℓ, a ℓ := by
  intro s hs
  unfold almostPrimes FPDQ.boxProd at hs
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hs
  show ∏ ℓ, a ℓ ≤ ∏ ℓ, f ℓ ∧ ∏ ℓ, f ℓ ≤ 2 * ∏ ℓ, a ℓ
  have hf' : ∀ ℓ, a ℓ ≤ f ℓ ∧ f ℓ < b ℓ := fun ℓ =>
    (mem_primesIn.mp (Fintype.mem_piFinset.mp hf ℓ)).1
  have hk := D.hk
  have hkR : (1 : ℝ) ≤ D.k := by exact_mod_cast hk
  have h4k : (0 : ℝ) < 4 * D.k := by positivity
  refine ⟨Finset.prod_le_prod' fun ℓ _ => (hf' ℓ).1, ?_⟩
  have hb : ∀ ℓ, (b ℓ : ℝ) ≤ (1 + 1 / (4 * (D.k : ℝ))) * a ℓ := by
    intro ℓ
    have h1 : ((4 * D.k * b ℓ : ℕ) : ℝ) ≤ (((4 * D.k + 1) * a ℓ : ℕ) : ℝ) := by
      exact_mod_cast (hG ℓ).2.2.2.1
    push_cast at h1
    have h2 : (b ℓ : ℝ) - a ℓ ≤ a ℓ / (4 * D.k) := by
      rw [le_div_iff₀ h4k]; linarith
    calc (b ℓ : ℝ) = a ℓ + (b ℓ - a ℓ) := by ring
      _ ≤ a ℓ + a ℓ / (4 * D.k) := by linarith
      _ = (1 + 1 / (4 * (D.k : ℝ))) * a ℓ := by field_simp
  have key : ((∏ ℓ, f ℓ : ℕ) : ℝ) ≤ 2 * ((∏ ℓ, a ℓ : ℕ) : ℝ) := by
    push_cast
    calc ∏ ℓ, (f ℓ : ℝ) ≤ ∏ ℓ, (b ℓ : ℝ) :=
          Finset.prod_le_prod (fun ℓ _ => by positivity)
            (fun ℓ _ => by exact_mod_cast (hf' ℓ).2.le)
      _ ≤ ∏ ℓ, ((1 + 1 / (4 * (D.k : ℝ))) * a ℓ) :=
          Finset.prod_le_prod (fun ℓ _ => by positivity) (fun ℓ _ => hb ℓ)
      _ = (1 + 1 / (4 * (D.k : ℝ))) ^ D.k * ∏ ℓ, (a ℓ : ℝ) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ ≤ 2 * ∏ ℓ, (a ℓ : ℝ) := by
          apply mul_le_mul_of_nonneg_right (FPDQ.one_add_pow_lt_two hk le_rfl).le
          positivity
  exact_mod_cast key

/-- The collision sum of a `Good5` box: `∑ 1/|P_ℓ| ≤ k/⌊√P'₁⌋`. -/
lemma good5_coll (hG : Good5 D a b) :
    ∑ ℓ, 1 / ((primesIn (a ℓ) (b ℓ)).card : ℝ) ≤ (D.k : ℝ) / (Nat.sqrt D.P₁' : ℝ) := by
  have hr : (0 : ℝ) < Nat.sqrt D.P₁' := by exact_mod_cast sqrt_P1'_pos D
  calc ∑ ℓ, 1 / ((primesIn (a ℓ) (b ℓ)).card : ℝ)
      ≤ ∑ _ℓ : Fin D.k, 1 / (Nat.sqrt D.P₁' : ℝ) := by
        apply Finset.sum_le_sum
        intro ℓ _
        apply one_div_le_one_div_of_le hr
        exact_mod_cast (hG ℓ).2.2.2.2
    _ = (D.k : ℝ) / (Nat.sqrt D.P₁' : ℝ) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

/-- **FPD of a `Good5` box** (Lemma C + Lemma L, `FPDQ.lemmaL_box_FPD`). -/
lemma good5_FPD (hG : Good5 D a b) {η : ℝ} (hη : 0 < η)
    (hκ : (D.k : ℝ) / (Nat.sqrt D.P₁' : ℝ) < (η / 2) ^ 2) {T : ℕ}
    (hTY : 4 * ((∏ ℓ, a ℓ : ℕ) : ℝ) < T * Real.sqrt (2 * η)) :
    L24.FPDProp ((almostPrimes a b).image (fun s : ℕ => (s : ℤ))) T (∏ ℓ, a ℓ) η 1
      (1 / Real.sqrt (2 * η)) :=
  FPDQ.lemmaL_box_FPD (P := fun ℓ => primesIn (a ℓ) (b ℓ)) (primes_prime D a b)
    (good5_disj D hG) (good5_ne D hG) (good5_Y_pos D hG) (good5_mem D hG) hη
    ((good5_coll D hG).trans_lt hκ) hTY

/-- The box is in `[-4Y, 4Y]` (hypothesis `hSD` of `L26.lemma26_one`). -/
lemma good5_SD (hG : Good5 D a b) :
    ∀ s ∈ (almostPrimes a b).image (fun s : ℕ => (s : ℤ)), |s| ≤ 4 * ((∏ ℓ, a ℓ : ℕ) : ℤ) := by
  intro s hs
  obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hs
  have h1 := (good5_mem D hG t ht).2
  have h2 : t ≤ 4 * ∏ ℓ, a ℓ := by omega
  rw [abs_of_nonneg (by positivity)]
  exact_mod_cast h2

end Boxes

/- ### Numerical inequalities (`0 < τ ≤ 1/1024`) -/

section Numerics

variable {τ : ℝ}

lemma pw (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) (n : ℕ) : τ ^ n ≤ (1 / 1024) ^ n :=
  pow_le_pow_left₀ hτ0.le hτ n

/-- `c τⁿ ≤ 1` from the numerical check `c 1024⁻ⁿ ≤ 1`. -/
lemma small (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {c : ℝ} (n : ℕ) (hc : 0 ≤ c)
    (h : c * (1 / 1024) ^ n ≤ 1) : c * τ ^ n ≤ 1 :=
  (mul_le_mul_of_nonneg_left (pw hτ0 hτ n) hc).trans h

/-- First shift condition of P5c. -/
lemma c1_real (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x p₁ p₂ T₁ T₂ Y₁ Y₂ : ℝ} (hx : 0 ≤ x)
    (hp₁ : p₁ ≤ 2 * Y₁) (hp₂ : p₂ ≤ 2 * Y₂) (hT₁ : 0 ≤ T₁) (hT₂ : 0 ≤ T₂)
    (hTY₁ : T₁ * Y₁ ≤ τ ^ 32 * x) (hTY₂ : T₂ * Y₂ ≤ τ ^ 32 * x) :
    8 * (p₁ * T₁ + p₂ * T₂) ≤ τ * x := by
  have h1 : p₁ * T₁ ≤ 2 * Y₁ * T₁ := mul_le_mul_of_nonneg_right hp₁ hT₁
  have h2 : p₂ * T₂ ≤ 2 * Y₂ * T₂ := mul_le_mul_of_nonneg_right hp₂ hT₂
  have h3 : 32 * (τ ^ 32 * x) ≤ τ * x := by
    have e : 32 * (τ ^ 32 * x) = (32 * τ ^ 31) * (τ * x) := by ring
    rw [e]
    exact mul_le_of_le_one_left (by positivity) (small hτ0 hτ 31 (by norm_num) (by norm_num))
  nlinarith

/-- Second shift condition of P5c. -/
lemma c2_real (hτ0 : 0 < τ) {x l P1 P2 L p₁ p₂ T₁ T₂ : ℝ} (hl : 0 ≤ l) (hP2 : 0 ≤ P2)
    (hx : 0 ≤ x) (hp₁ : p₁ ≤ 2 * P2) (hp₂ : p₂ ≤ 2 * P2) (hT₁0 : 0 ≤ T₁) (hT₂0 : 0 ≤ T₂)
    (hT₁ : T₁ ≤ x) (hT₂ : T₂ ≤ x) (hτP : 1 ≤ τ * P1) (hL : 32 * l * P1 * P2 * x ≤ L) :
    8 * (l * (p₁ * T₂ + p₂ * T₁)) ≤ τ * L := by
  have h1 : p₁ * T₂ ≤ 2 * P2 * x := mul_le_mul hp₁ hT₂ hT₂0 (by positivity)
  have h2 : p₂ * T₁ ≤ 2 * P2 * x := mul_le_mul hp₂ hT₁ hT₁0 (by positivity)
  have h3 : 8 * (l * (p₁ * T₂ + p₂ * T₁)) ≤ 32 * l * P2 * x := by
    have : l * (p₁ * T₂ + p₂ * T₁) ≤ l * (4 * P2 * x) :=
      mul_le_mul_of_nonneg_left (by linarith) hl
    linarith
  have h4 : 32 * l * P2 * x ≤ τ * L := by
    calc 32 * l * P2 * x ≤ (32 * l * P2 * x) * (τ * P1) :=
          le_mul_of_one_le_right (by positivity) hτP
      _ = τ * (32 * l * P1 * P2 * x) := by ring
      _ ≤ τ * L := mul_le_mul_of_nonneg_left hL hτ0.le
  linarith

/-- `hTDX₁` of `L26.lemma26_one`. -/
lemma num_TDX1 (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x TY : ℝ} (hx : 0 ≤ x)
    (hTY : TY ≤ τ ^ 32 * x) : 6400 * TY ≤ ((τ / 2) ^ 4 / 4) ^ 2 * (2 * x) := by
  calc 6400 * TY ≤ 6400 * (τ ^ 32 * x) := by linarith
    _ = (13107200 * τ ^ 24) * (((τ / 2) ^ 4 / 4) ^ 2 * (2 * x)) := by ring
    _ ≤ ((τ / 2) ^ 4 / 4) ^ 2 * (2 * x) :=
        mul_le_of_le_one_left (by positivity) (small hτ0 hτ 24 (by norm_num) (by norm_num))

/-- `hHQ₁` of `L26.lemma26_one`. -/
lemma num_HQ1 (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x TY H : ℝ} (hx : 0 ≤ x)
    (hH : H ≤ τ ^ 64 * x) (hTY : τ ^ 32 * x / 2 ≤ TY) :
    20 * H ≤ ((τ / 2) ^ 4 / 4) ^ 2 * TY := by
  calc 20 * H ≤ 20 * (τ ^ 64 * x) := by linarith
    _ = (163840 * τ ^ 24) * (((τ / 2) ^ 4 / 4) ^ 2 * (τ ^ 32 * x / 2)) := by ring
    _ ≤ ((τ / 2) ^ 4 / 4) ^ 2 * (τ ^ 32 * x / 2) :=
        mul_le_of_le_one_left (by positivity) (small hτ0 hτ 24 (by norm_num) (by norm_num))
    _ ≤ ((τ / 2) ^ 4 / 4) ^ 2 * TY := by gcongr

/-- `hTDX₂` of `L26.lemma26_one`. -/
lemma num_TDX2 (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x TY : ℝ} (hx : 0 ≤ x)
    (hTY : TY ≤ τ ^ 32 * x) : 6400 * TY ≤ (((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * (2 * x) := by
  calc 6400 * TY ≤ 6400 * (τ ^ 32 * x) := by linarith
    _ = (3200 * 26214400 ^ 2 * τ ^ 8) * ((((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * (2 * x)) := by ring
    _ ≤ (((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * (2 * x) :=
        mul_le_of_le_one_left (by positivity) (small hτ0 hτ 8 (by norm_num) (by norm_num))

/-- `hHQ₂` of `L26.lemma26_one`. -/
lemma num_HQ2 (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x TY H : ℝ} (hx : 0 ≤ x)
    (hH : H ≤ τ ^ 64 * x) (hTY : τ ^ 32 * x / 2 ≤ TY) :
    20 * H ≤ (((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * TY := by
  calc 20 * H ≤ 20 * (τ ^ 64 * x) := by linarith
    _ = (40 * 26214400 ^ 2 * τ ^ 8) * ((((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * (τ ^ 32 * x / 2)) := by
        ring
    _ ≤ (((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * (τ ^ 32 * x / 2) :=
        mul_le_of_le_one_left (by positivity) (small hτ0 hτ 8 (by norm_num) (by norm_num))
    _ ≤ (((τ / 2) ^ 4) ^ 3 / 6400) ^ 2 * TY := by gcongr

/-- `hHWᵢ` of `L26.lemma26_one`, for any `W ≤ 2¹⁴/τ⁶`. -/
lemma num_HW (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x TY H W : ℝ} (hx : 0 ≤ x)
    (hH : H ≤ τ ^ 64 * x) (hW0 : 0 ≤ W) (hW : W * τ ^ 6 ≤ 2 ^ 14)
    (hTY : τ ^ 32 * x / 2 ≤ TY) : 16 * H * W ≤ TY := by
  calc 16 * H * W ≤ 16 * (τ ^ 64 * x) * W := by gcongr
    _ = 16 * (τ ^ 58 * x) * (W * τ ^ 6) := by ring
    _ ≤ 16 * (τ ^ 58 * x) * 2 ^ 14 :=
        mul_le_mul_of_nonneg_left hW
          (mul_nonneg (by norm_num) (mul_nonneg (pow_nonneg hτ0.le _) hx))
    _ = (2 ^ 19 * τ ^ 26) * (τ ^ 32 * x / 2) := by ring
    _ ≤ τ ^ 32 * x / 2 :=
        mul_le_of_le_one_left (by positivity) (small hτ0 hτ 26 (by norm_num) (by norm_num))
    _ ≤ TY := hTY

lemma sqrt_ge (hτ0 : 0 < τ) {η : ℝ} (hη : 0 < η) (h : τ ^ 12 / 2 ^ 28 ≤ 2 * η) :
    τ ^ 6 / 2 ^ 14 ≤ Real.sqrt (2 * η) := by
  rw [Real.le_sqrt (by positivity) (by positivity)]
  calc (τ ^ 6 / 2 ^ 14) ^ 2 = τ ^ 12 / 2 ^ 28 := by ring
    _ ≤ 2 * η := h

/-- `W = (2η)^{-1/2} ≤ 2¹⁴/τ⁶`. -/
lemma W_le (hτ0 : 0 < τ) {η : ℝ} (hη : 0 < η) (h : τ ^ 12 / 2 ^ 28 ≤ 2 * η) :
    1 / Real.sqrt (2 * η) * τ ^ 6 ≤ 2 ^ 14 := by
  have hs := sqrt_ge hτ0 hη h
  have hs0 : 0 < Real.sqrt (2 * η) := Real.sqrt_pos.mpr (by positivity)
  rw [one_div_mul_eq_div, div_le_iff₀ hs0]
  linarith

/-- `hTY` of `FPDQ.lemmaL_box_FPD`: `4Y < T√(2η)`. -/
lemma num_TY (hτ0 : 0 < τ) {x T Y s : ℝ} (hY : 0 < Y) (hT0 : 0 ≤ T)
    (hTY : τ ^ 32 * x / 2 ≤ T * Y) (hs : τ ^ 6 / 2 ^ 14 ≤ s)
    (hYx : 2 ^ 17 * Y ^ 2 < τ ^ 38 * x) : 4 * Y < T * s := by
  have h1 : 4 * Y * Y < T * s * Y := by
    calc 4 * Y * Y = 2 ^ 17 * Y ^ 2 / 2 ^ 15 := by ring
      _ < τ ^ 38 * x / 2 ^ 15 := by gcongr
      _ = (τ ^ 32 * x / 2) * (τ ^ 6 / 2 ^ 14) := by ring
      _ ≤ (T * Y) * s := by gcongr
      _ = T * s * Y := by ring
  exact lt_of_mul_lt_mul_right h1 hY.le

/-- The first FPD level `η₁ = σ/40`, `σ = (τ/2)⁴`. -/
lemma lev1 (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) :
    0 < (τ / 2) ^ 4 / 40 ∧ τ ^ 24 / 2 ^ 58 ≤ ((τ / 2) ^ 4 / 40 / 2) ^ 2 ∧
      τ ^ 12 / 2 ^ 28 ≤ 2 * ((τ / 2) ^ 4 / 40) := by
  refine ⟨by positivity, ?_, ?_⟩
  · calc τ ^ 24 / 2 ^ 58 = (1638400 / 2 ^ 58 * τ ^ 16) * ((τ / 2) ^ 4 / 40 / 2) ^ 2 := by ring
      _ ≤ ((τ / 2) ^ 4 / 40 / 2) ^ 2 :=
          mul_le_of_le_one_left (by positivity) (small hτ0 hτ 16 (by norm_num) (by norm_num))
  · calc τ ^ 12 / 2 ^ 28 = (320 / 2 ^ 28 * τ ^ 8) * (2 * ((τ / 2) ^ 4 / 40)) := by ring
      _ ≤ 2 * ((τ / 2) ^ 4 / 40) :=
          mul_le_of_le_one_left (by positivity) (small hτ0 hτ 8 (by norm_num) (by norm_num))

/-- The second FPD level `η₂ = σ³/64000`, `σ = (τ/2)⁴`. -/
lemma lev2 (hτ0 : 0 < τ) :
    0 < ((τ / 2) ^ 4) ^ 3 / 64000 ∧ τ ^ 24 / 2 ^ 58 ≤ (((τ / 2) ^ 4) ^ 3 / 64000 / 2) ^ 2 ∧
      τ ^ 12 / 2 ^ 28 ≤ 2 * (((τ / 2) ^ 4) ^ 3 / 64000) := by
  refine ⟨by positivity, ?_, ?_⟩
  · calc τ ^ 24 / 2 ^ 58
        = (524288000 ^ 2 / 2 ^ 58) * (((τ / 2) ^ 4) ^ 3 / 64000 / 2) ^ 2 := by ring
      _ ≤ (((τ / 2) ^ 4) ^ 3 / 64000 / 2) ^ 2 :=
          mul_le_of_le_one_left (by positivity) (by norm_num)
  · calc τ ^ 12 / 2 ^ 28 = (131072000 / 2 ^ 28) * (2 * (((τ / 2) ^ 4) ^ 3 / 64000)) := by ring
      _ ≤ 2 * (((τ / 2) ^ 4) ^ 3 / 64000) :=
          mul_le_of_le_one_left (by positivity) (by norm_num)

/-- The final estimate: `2H²·box20 ≤ E²` and `box20 ≥ (σ³/3200)³/800` give `τ¹⁰⁰X ≤ E`. -/
lemma num_final (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) {x H B E : ℝ} (hx : 0 ≤ x) (hE0 : 0 ≤ E)
    (hH : τ ^ 64 * x / 2 ≤ H) (hB : (((τ / 2) ^ 4) ^ 3 / 3200) ^ 3 / 800 ≤ B)
    (hE : 2 * H ^ 2 * B ≤ E ^ 2) : τ ^ 100 * x ≤ E := by
  have h : (τ ^ 100 * x) ^ 2 ≤ E ^ 2 := by
    calc (τ ^ 100 * x) ^ 2
        = (1600 * 13107200 ^ 3 * τ ^ 36) *
          (2 * (τ ^ 64 * x / 2) ^ 2 * ((((τ / 2) ^ 4) ^ 3 / 3200) ^ 3 / 800)) := by ring
      _ ≤ 2 * (τ ^ 64 * x / 2) ^ 2 * ((((τ / 2) ^ 4) ^ 3 / 3200) ^ 3 / 800) :=
          mul_le_of_le_one_left (by positivity) (small hτ0 hτ 36 (by norm_num) (by norm_num))
      _ ≤ 2 * H ^ 2 * ((((τ / 2) ^ 4) ^ 3 / 3200) ^ 3 / 800) := by gcongr
      _ ≤ 2 * H ^ 2 * B := by gcongr
      _ ≤ E ^ 2 := hE
  exact (pow_le_pow_iff_left₀ (by positivity) hE0 (by norm_num)).mp h

/-- `k/⌊√P'₁⌋ < τ²⁴/2⁵⁸` from `P'₁ ≥ 2²³⁶k⁴`, `P'₁ < 4⌊√P'₁⌋²` and `τ⁹⁶P'₁ ≥ 1`. -/
lemma coll_small (hτ0 : 0 < τ) {k P r : ℝ} (hr : 1 ≤ r) (hPr : P < 4 * r ^ 2)
    (hP : 2 ^ 236 * k ^ 4 ≤ P) (hτP : 1 ≤ τ ^ 96 * P) : k / r < τ ^ 24 / 2 ^ 58 := by
  have hτ96 : 0 < τ ^ 96 := by positivity
  have hP0 : 0 < P := by nlinarith
  have h1 : (k * 2 ^ 58) ^ 4 ≤ P / 16 := by
    have e : (k * 2 ^ 58) ^ 4 = 2 ^ 236 * k ^ 4 / 16 := by ring
    rw [e]
    linarith
  have h2 : P / 16 < r ^ 4 / P := by
    rw [div_lt_div_iff₀ (by norm_num) hP0]
    have h := mul_lt_mul'' hPr hPr hP0.le hP0.le
    nlinarith
  have h3 : r ^ 4 / P ≤ (τ ^ 24 * r) ^ 4 := by
    rw [div_le_iff₀ hP0]
    have e : (τ ^ 24 * r) ^ 4 * P = (τ ^ 96 * P) * r ^ 4 := by ring
    rw [e]
    exact le_mul_of_one_le_left (by positivity) hτP
  have h4 : k * 2 ^ 58 < τ ^ 24 * r :=
    lt_of_pow_lt_pow_left₀ 4 (mul_nonneg (by positivity) (by linarith))
      (h1.trans_lt (h2.trans_le h3))
  rw [div_lt_div_iff₀ (by linarith) (by norm_num)]
  linarith

/-- `τⁿX ≥ P'₂⁹` for `n ≤ 100`, from `τ¹⁰⁰P'₁ ≥ 1`, `P'₁ ≤ P'₂` and `X ≥ P'₂¹⁰`. -/
lemma big_x (hτ0 : 0 < τ) (hτ1 : τ ≤ 1) {P1 P2 x : ℝ} (hP1 : 0 < P1) (hP12 : P1 ≤ P2)
    (hx : P2 ^ 10 ≤ x) (hτA : 1 ≤ τ ^ 100 * P1) {n : ℕ} (hn : n ≤ 100) :
    P2 ^ 9 ≤ τ ^ n * x := by
  have hP2 : 0 < P2 := hP1.trans_le hP12
  have hx0 : 0 ≤ x := le_trans (by positivity) hx
  have h1 : τ ^ 100 ≤ τ ^ n := pow_le_pow_of_le_one hτ0.le hτ1 hn
  have h2 : P2 ^ 9 * P2 ≤ τ ^ n * x * P2 := by
    calc P2 ^ 9 * P2 = P2 ^ 10 := by ring
      _ ≤ x := hx
      _ ≤ (τ ^ 100 * P1) * x := le_mul_of_one_le_left hx0 hτA
      _ ≤ (τ ^ n * P2) * x :=
          mul_le_mul_of_nonneg_right (mul_le_mul h1 hP12 hP1.le (by positivity)) hx0
      _ = τ ^ n * x * P2 := by ring
  exact le_of_mul_le_mul_right h2 hP2

/-- Consequences of `τⁿX ≥ P'₂⁹` for a box with `1 ≤ Y ≤ P'₂`, `P'₂ ≥ 8`. -/
lemma Y_facts {P2 x Y : ℝ} (hP2 : 8 ≤ P2) (hY1 : 1 ≤ Y) (hYP : Y ≤ P2)
    (hbig : ∀ n ≤ 100, P2 ^ 9 ≤ τ ^ n * x) :
    2 * Y ≤ τ ^ 32 * x ∧ 2 ^ 17 * Y ^ 2 < τ ^ 38 * x ∧ 1 ≤ τ ^ 64 * x := by
  have hP2pos : 0 < P2 := by linarith
  have h7 : (2 : ℝ) ^ 21 ≤ P2 ^ 7 := by
    calc (2 : ℝ) ^ 21 = 8 ^ 7 := by norm_num
      _ ≤ P2 ^ 7 := pow_le_pow_left₀ (by norm_num) hP2 7
  have hsq : P2 ≤ P2 ^ 2 := by nlinarith
  have h9 : 2 ^ 17 * P2 ^ 2 < P2 ^ 9 := by
    have e : P2 ^ 9 = P2 ^ 7 * P2 ^ 2 := by ring
    rw [e]
    have hp2 : 0 < P2 ^ 2 := by positivity
    nlinarith
  have hY2 : Y ^ 2 ≤ P2 ^ 2 := pow_le_pow_left₀ (by linarith) hYP 2
  refine ⟨?_, ?_, ?_⟩
  · have := hbig 32 (by norm_num)
    nlinarith
  · have := hbig 38 (by norm_num)
    nlinarith
  · have := hbig 64 (by norm_num)
    nlinarith

/-- `⌊y⌋₊ ∈ [y/2, y]` and `⌊y⌋₊ ≥ 1` for `y ≥ 1`. -/
lemma floor_facts {y : ℝ} (hy : 1 ≤ y) : 1 ≤ ⌊y⌋₊ ∧ (⌊y⌋₊ : ℝ) ≤ y ∧ y / 2 ≤ ⌊y⌋₊ := by
  have h0 : 0 ≤ y := by linarith
  have h1 : 1 ≤ ⌊y⌋₊ := Nat.le_floor (by exact_mod_cast hy)
  have h2 : (⌊y⌋₊ : ℝ) ≤ y := Nat.floor_le h0
  have h3 : y < ⌊y⌋₊ + 1 := Nat.lt_floor_add_one y
  have h4 : (1 : ℝ) ≤ ⌊y⌋₊ := by exact_mod_cast h1
  exact ⟨h1, h2, by linarith⟩

/-- `T ≤ x` from `TY ≤ c x`, `Y ≥ 1`, `c ≤ 1`. -/
lemma T_le_x {T Y x c : ℝ} (hT : 0 ≤ T) (hY : 1 ≤ Y) (hx : 0 ≤ x) (hc : c ≤ 1)
    (h : T * Y ≤ c * x) : T ≤ x := by
  nlinarith

/-- `2H + 1 ≤ x` from `H ≤ c x`, `c ≤ 1/4`, `x ≥ 2`. -/
lemma two_H {H x c : ℝ} (hc : c ≤ 1 / 4) (hx : 2 ≤ x) (hH : H ≤ c * x) : 2 * H + 1 ≤ x := by
  nlinarith

end Numerics

/- ### The shift condition in `n` (`log N ≤ (log L)²`) -/

/-- `a ≤ m/5` from `a⁴ ≤ m²`, `a ≥ 0`, `m ≥ 25`. -/
lemma le_fifth {a m : ℝ} (ha : 0 ≤ a) (hm : 25 ≤ m) (h : a ^ 4 ≤ m ^ 2) : a ≤ m / 5 := by
  have h1 : a ^ 2 ≤ m := by
    have h' : (a ^ 2) ^ 2 ≤ m ^ 2 := by rw [← pow_mul]; exact h
    exact (pow_le_pow_iff_left₀ (by positivity) (by linarith) (by norm_num)).mp h'
  nlinarith

lemma one_le_L (D : Data) (hN : N0 ≤ D.N) {L : ℕ} (hL : Real.log D.N ≤ (Real.log L) ^ 2) :
    1 ≤ L := by
  obtain ⟨-, hN625⟩ := logN_facts D hN
  rcases Nat.eq_zero_or_pos L with h | h
  · rw [h, Nat.cast_zero, Real.log_zero] at hL
    nlinarith
  · exact h

/-- `32 λ P'₁ P'₂ X ≤ L`: every factor is `≤ exp(log L / 5)`. -/
lemma key_L (D : Data) (hN : N0 ≤ D.N) {X L : ℕ} (hX1 : D.P₁ ≤ X) (hX2 : X < D.P₂)
    (hL : Real.log D.N ≤ (Real.log L) ^ 2) :
    32 * (D.lam : ℝ) * D.P₁' * D.P₂' * X ≤ L := by
  obtain ⟨-, hN625⟩ := logN_facts D hN
  have hL1 := one_le_L D hN hL
  have hLpos : (0 : ℝ) < L := by exact_mod_cast hL1
  have hm0 : 0 ≤ Real.log L := Real.log_nonneg (by exact_mod_cast hL1)
  have hm25 : 25 ≤ Real.log L := by nlinarith
  have hlam1 : (1 : ℝ) ≤ D.lam := by exact_mod_cast D.hlam
  have ha : Real.log D.lam ≤ Real.log L / 5 :=
    le_fifth (Real.log_nonneg hlam1) hm25 (D.hlamN.trans hL)
  have hXP : X < D.hi (Fin.last D.k) := hX2
  have hP₂1 : (1 : ℝ) ≤ ((D.hi (Fin.last D.k) : ℕ) : ℝ) := by
    exact_mod_cast (show 1 ≤ D.hi (Fin.last D.k) by omega)
  have hb : Real.log ((D.hi (Fin.last D.k) : ℕ) : ℝ) ≤ Real.log L / 5 :=
    le_fifth (Real.log_nonneg hP₂1) hm25 (D.hP₂N.le.trans hL)
  have hE0 : 0 ≤ Real.exp (Real.log L / 5) := (Real.exp_pos _).le
  have hlamE : (D.lam : ℝ) ≤ Real.exp (Real.log L / 5) := by
    calc (D.lam : ℝ) = Real.exp (Real.log D.lam) := (Real.exp_log (by linarith)).symm
      _ ≤ _ := Real.exp_le_exp.mpr ha
  have hP₂E : ((D.hi (Fin.last D.k) : ℕ) : ℝ) ≤ Real.exp (Real.log L / 5) := by
    calc ((D.hi (Fin.last D.k) : ℕ) : ℝ)
        = Real.exp (Real.log ((D.hi (Fin.last D.k) : ℕ) : ℝ)) := (Real.exp_log (by linarith)).symm
      _ ≤ _ := Real.exp_le_exp.mpr hb
  have h32 : (32 : ℝ) ≤ Real.exp (Real.log L / 5) := by
    have h1 : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
    have h5 : Real.exp 5 = Real.exp 1 ^ 5 := by
      rw [← Real.exp_nat_mul]; norm_num
    calc (32 : ℝ) = 2 ^ 5 := by norm_num
      _ ≤ Real.exp 1 ^ 5 := pow_le_pow_left₀ (by norm_num) h1 5
      _ = Real.exp 5 := h5.symm
      _ ≤ _ := Real.exp_le_exp.mpr (by linarith)
  have h1 := D.hP₁'P₂'
  have h2 : D.P₂' < D.P₁ := D.hP₂'P₁
  have hP₁'E : (D.P₁' : ℝ) ≤ Real.exp (Real.log L / 5) := by
    have : (D.P₁' : ℝ) ≤ ((D.hi (Fin.last D.k) : ℕ) : ℝ) := by
      exact_mod_cast (show D.P₁' ≤ D.hi (Fin.last D.k) by omega)
    linarith
  have hP₂'E : (D.P₂' : ℝ) ≤ Real.exp (Real.log L / 5) := by
    have : (D.P₂' : ℝ) ≤ ((D.hi (Fin.last D.k) : ℕ) : ℝ) := by
      exact_mod_cast (show D.P₂' ≤ D.hi (Fin.last D.k) by omega)
    linarith
  have hXE : (X : ℝ) ≤ Real.exp (Real.log L / 5) := by
    have : (X : ℝ) ≤ ((D.hi (Fin.last D.k) : ℕ) : ℝ) := by exact_mod_cast hXP.le
    linarith
  have hLE : Real.exp (Real.log L / 5) ^ 5 = (L : ℝ) := by
    rw [← Real.exp_nat_mul]
    have : ((5 : ℕ) : ℝ) * (Real.log L / 5) = Real.log L := by push_cast; ring
    rw [this, Real.exp_log hLpos]
  set E := Real.exp (Real.log L / 5) with hE
  have hE2 : 0 ≤ E * E := mul_nonneg hE0 hE0
  have hE3 : 0 ≤ E * E * E := mul_nonneg hE2 hE0
  have hE4 : 0 ≤ E * E * E * E := mul_nonneg hE3 hE0
  calc 32 * (D.lam : ℝ) * D.P₁' * D.P₂' * X ≤ E * E * E * E * E :=
        mul_le_mul (mul_le_mul (mul_le_mul (mul_le_mul h32 hlamE (Nat.cast_nonneg _) hE0) hP₁'E
          (Nat.cast_nonneg _) hE2) hP₂'E (Nat.cast_nonneg _) hE3) hXE (Nat.cast_nonneg _) hE4
    _ = E ^ 5 := by ring
    _ = L := hLE

/- ### Parameters and one box -/

/-- `Tᵢ = ⌊τ³²X/Yᵢ⌋`. -/
noncomputable def Tpar (τ : ℝ) (X Y : ℕ) : ℕ := ⌊τ ^ 32 * (X : ℝ) / (Y : ℝ)⌋₊

/-- `H = ⌊τ⁶⁴X⌋`. -/
noncomputable def Hpar (τ : ℝ) (X : ℕ) : ℕ := ⌊τ ^ 64 * (X : ℝ)⌋₊

lemma T_facts {τ x Y : ℝ} (hY : 0 < Y) (h2 : 2 * Y ≤ τ ^ 32 * x) :
    1 ≤ ⌊τ ^ 32 * x / Y⌋₊ ∧ (⌊τ ^ 32 * x / Y⌋₊ : ℝ) * Y ≤ τ ^ 32 * x ∧
      τ ^ 32 * x / 2 ≤ (⌊τ ^ 32 * x / Y⌋₊ : ℝ) * Y := by
  have hy : 2 ≤ τ ^ 32 * x / Y := by rw [le_div_iff₀ hY]; linarith
  obtain ⟨h1, h2', h3⟩ := floor_facts (by linarith : (1 : ℝ) ≤ τ ^ 32 * x / Y)
  refine ⟨h1, ?_, ?_⟩
  · calc (⌊τ ^ 32 * x / Y⌋₊ : ℝ) * Y ≤ (τ ^ 32 * x / Y) * Y :=
          mul_le_mul_of_nonneg_right h2' hY.le
      _ = τ ^ 32 * x := div_mul_cancel₀ _ hY.ne'
  · calc τ ^ 32 * x / 2 = (τ ^ 32 * x / Y * Y) / 2 := by rw [div_mul_cancel₀ _ hY.ne']
      _ = (τ ^ 32 * x / Y / 2) * Y := by ring
      _ ≤ (⌊τ ^ 32 * x / Y⌋₊ : ℝ) * Y := mul_le_mul_of_nonneg_right h3 hY.le

/-- Everything needed about one `Good5` box: the size of `T = ⌊τ³²X/Y⌋` and the FPD property
at every level `η` with `τ²⁴/2⁵⁸ ≤ (η/2)²` and `τ¹²/2²⁸ ≤ 2η`. -/
lemma box_all (D : Data) {a b : Fin D.k → ℕ} (hG : Good5 D a b) {τ : ℝ} (hτ0 : 0 < τ)
    {X : ℕ} (hP2R : (8 : ℝ) ≤ D.P₂') (hbig : ∀ n ≤ 100, (D.P₂' : ℝ) ^ 9 ≤ τ ^ n * X)
    (hκ : (D.k : ℝ) / (Nat.sqrt D.P₁' : ℝ) < τ ^ 24 / 2 ^ 58) :
    1 ≤ Tpar τ X (∏ ℓ, a ℓ) ∧
    (Tpar τ X (∏ ℓ, a ℓ) : ℝ) * ((∏ ℓ, a ℓ : ℕ) : ℝ) ≤ τ ^ 32 * X ∧
    τ ^ 32 * X / 2 ≤ (Tpar τ X (∏ ℓ, a ℓ) : ℝ) * ((∏ ℓ, a ℓ : ℕ) : ℝ) ∧
    ∀ η : ℝ, 0 < η → τ ^ 24 / 2 ^ 58 ≤ (η / 2) ^ 2 → τ ^ 12 / 2 ^ 28 ≤ 2 * η →
      L24.FPDProp ((almostPrimes a b).image (fun s : ℕ => (s : ℤ))) (Tpar τ X (∏ ℓ, a ℓ))
        (∏ ℓ, a ℓ) η 1 (1 / Real.sqrt (2 * η)) := by
  have hY1R : (1 : ℝ) ≤ ((∏ ℓ, a ℓ : ℕ) : ℝ) := by exact_mod_cast good5_Y_pos D hG
  have hYleR : ((∏ ℓ, a ℓ : ℕ) : ℝ) ≤ D.P₂' := by exact_mod_cast good5_Y_le D hG
  obtain ⟨h2Y, hY17, -⟩ := Y_facts hP2R hY1R hYleR hbig
  obtain ⟨hT1, hTu, hTl⟩ := T_facts (by linarith : (0 : ℝ) < ((∏ ℓ, a ℓ : ℕ) : ℝ)) h2Y
  refine ⟨hT1, hTu, hTl, fun η hη hη1 hη2 => ?_⟩
  exact good5_FPD D hG hη (hκ.trans_le hη1)
    (num_TY hτ0 (by linarith) (Nat.cast_nonneg _) hTl (sqrt_ge hτ0 hη hη2) hY17)

/- ### Restricting `ψ` to `[X, 2X)` -/

/-- `ψ̃ = ψ · 1_{[X,2X)}`. -/
noncomputable def restr (ψ : ℤ → ℝ) (X : ℕ) : ℤ → ℝ := fun x => if x ∈ win X then ψ x else 0

lemma restr_abs {ψ : ℤ → ℝ} (hψ : ∀ x, |ψ x| ≤ 1) (X : ℕ) : ∀ x, |restr ψ X x| ≤ 1 := by
  intro x
  unfold restr
  split_ifs
  · exact hψ x
  · simp

lemma restr_supp (ψ : ℤ → ℝ) (X : ℕ) : ∀ x : ℤ, x ∉ win X → restr ψ X x = 0 := by
  intro x hx
  unfold restr
  rw [if_neg hx]

lemma lhs14_restr (f₁ ψ : ℤ → ℝ) (lam X : ℕ) (B₁ B₂ : Finset ℕ) (ρ : ℕ → ℕ → ℝ) (u : ℤ)
    (L : ℕ) : lhs14 f₁ (restr ψ X) lam X B₁ B₂ ρ u L = lhs14 f₁ ψ lam X B₁ B₂ ρ u L := by
  unfold lhs14
  congr 1; funext p₁; congr 1; funext p₂; congr 1
  apply wavg_congr
  intro x hx
  simp only [restr, if_pos hx]

lemma expSum_restr (ψ : ℤ → ℝ) (X : ℕ) (θ : ℝ) : expSum X (restr ψ X) θ = expSum X ψ θ := by
  unfold expSum
  refine Finset.sum_congr rfl fun x hx => ?_
  simp only [restr, if_pos hx]

/- ### The main argument -/

/-- The body of `StepP5e` with `A = 100`, `τ₀ = 1/1024`, `N₀ = N0`. -/
theorem main (h5c : StepP5c) (h5d : StepP5d) (D : Data) (hN : N0 ≤ D.N)
    (f₁ : ℤ → ℝ) (hf₁ : ∀ n, |f₁ n| ≤ 1) (X : ℕ) (hX1 : D.P₁ ≤ X) (hX2 : X < D.P₂)
    (a₁ b₁ a₂ b₂ : Fin D.k → ℕ) (hG₁ : Good5 D a₁ b₁) (hG₂ : Good5 D a₂ b₂)
    (ρ : ℕ → ℕ → ℝ) (hρ : ∀ s t, |ρ s t| ≤ 1) (u : ℤ) (L : ℕ)
    (hL : Real.log D.N ≤ (Real.log L) ^ 2) (ψ : ℤ → ℝ) (hψ : ∀ x, |ψ x| ≤ 1)
    (τ : ℝ) (hτ0 : 0 < τ) (hτ : τ ≤ 1 / 1024) (hτA : 1 ≤ τ ^ 100 * D.P₁')
    (hlhs : τ ≤ |lhs14 f₁ ψ D.lam X (almostPrimes a₁ b₁) (almostPrimes a₂ b₂) ρ u L|) :
    ∃ θ : ℝ, τ ^ 100 * X ≤ ‖expSum X ψ θ‖ := by
  /- Sizes. -/
  have hτ1 : τ ≤ 1 := by linarith
  have hk1 : (1 : ℝ) ≤ D.k := by exact_mod_cast D.hk
  have hP1big := P1'_big D hN
  have hP1R : (2 : ℝ) ^ 236 ≤ D.P₁' := by
    have h1 : (1 : ℝ) ≤ (D.k : ℝ) ^ 4 := one_le_pow₀ hk1
    have h2 : (0 : ℝ) < 2 ^ 236 := by norm_num
    nlinarith
  have hP12 : (D.P₁' : ℝ) ≤ D.P₂' := by exact_mod_cast D.hP₁'P₂'.le
  have hP2R : (8 : ℝ) ≤ D.P₂' := by
    have : (8 : ℝ) ≤ 2 ^ 236 := by norm_num
    linarith
  have hP1pos : (0 : ℝ) < D.P₁' := by
    have : (0 : ℝ) < 2 ^ 236 := by norm_num
    linarith
  have hxR : (D.P₂' : ℝ) ^ 10 ≤ X := by exact_mod_cast D.hpow.trans hX1
  have hx0 : (0 : ℝ) ≤ X := Nat.cast_nonneg _
  have hbig : ∀ n ≤ 100, (D.P₂' : ℝ) ^ 9 ≤ τ ^ n * X := fun n hn =>
    big_x hτ0 hτ1 hP1pos hP12 hxR hτA hn
  have hτP : 1 ≤ τ * D.P₁' := by
    have h1 : τ ^ 100 ≤ τ ^ 1 := pow_le_pow_of_le_one hτ0.le hτ1 (by norm_num)
    rw [pow_one] at h1
