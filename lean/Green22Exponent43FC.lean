    exact coll_small hτ0 hr1 hPr hP1big hτ96
  /- The two boxes. -/
  obtain ⟨hT₁1, hT₁u, hT₁l, hF₁⟩ := box_all D hG₁ hτ0 hP2R hbig hκ
  obtain ⟨hT₂1, hT₂u, hT₂l, hF₂⟩ := box_all D hG₂ hτ0 hP2R hbig hκ
  have hY₁1 : (1 : ℝ) ≤ ((∏ ℓ, a₁ ℓ : ℕ) : ℝ) := by exact_mod_cast good5_Y_pos D hG₁
  have hY₂1 : (1 : ℝ) ≤ ((∏ ℓ, a₂ ℓ : ℕ) : ℝ) := by exact_mod_cast good5_Y_pos D hG₂
  have hY₁P : ((∏ ℓ, a₁ ℓ : ℕ) : ℝ) ≤ D.P₂' := by exact_mod_cast good5_Y_le D hG₁
  have hY₂P : ((∏ ℓ, a₂ ℓ : ℕ) : ℝ) ≤ D.P₂' := by exact_mod_cast good5_Y_le D hG₂
  have hτ32 : τ ^ 32 ≤ 1 := pow_le_one₀ hτ0.le hτ1
  have hT₁x : (Tpar τ X (∏ ℓ, a₁ ℓ) : ℝ) ≤ X :=
